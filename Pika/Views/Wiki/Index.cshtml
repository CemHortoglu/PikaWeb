@model Pika.Models.WikiHomeViewModel
@{
    Layout = "_WikiLayout";
    ViewData["Title"] = "Pika Bilgi Bankası — Müşteri Zekâsı ve Pazarlama Rehberi";
    ViewData["Description"] = "Pika müşteri zekâsı, ürün zekâsı, fırsat tespiti, Journey orkestrasyonu ve analitik ölçümleme bilgi bankası ve kullanım rehberi.";
    ViewData["CanonicalUrl"] = Model.CanonicalUrl;
    ViewData["CurrentSlug"] = "";
    ViewData["Categories"] = Model.Categories;
}

@section Breadcrumb {
    <span class="current"><i class="ri-book-2-line" style="margin-right:4px;"></i>Pika Bilgi Bankası</span>
}

@section StructuredData {
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "CollectionPage",
        "name": "Pika Bilgi Bankası",
        "description": "Pika müşteri zekâsı, ürün zekâsı, fırsat tespiti, Journey orkestrasyonu ve analitik ölçümleme bilgi bankası ve kullanım rehberi.",
        "url": "https://pika.tr/wiki/",
        "inLanguage": "tr",
        "publisher": {
            "@@type": "Organization",
            "name": "Pika",
            "url": "https://pika.tr"
        }
    }
    </script>
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@@type": "ListItem",
                "position": 1,
                "name": "Ana Sayfa",
                "item": "https://pika.tr/"
            },
            {
                "@@type": "ListItem",
                "position": 2,
                "name": "Pika Bilgi Bankası",
                "item": "https://pika.tr/wiki/"
            }
        ]
    }
    </script>
}

<section class="hero hero-intro">
    <div class="hero-copy">
        <div class="hero-kicker">Ürün ve Kullanım Rehberi</div>
        <h1>Pika Bilgi Bankası</h1>
        <p class="hero-lead">Pika; müşteri, ürün, satış ve etkileşim verilerini anlamlandırarak işletmenin hangi müşteride hangi fırsatın oluştuğunu görmesine ve bu fırsatı doğru aksiyona dönüştürmesine yardımcı olan müşteri zekâsı ve pazarlama platformudur.</p>
        <div class="hero-tags">
            <span>Müşteri Zekâsı</span>
            <span>Product Intelligence</span>
            <span>Fırsat Motoru</span>
            <span>Journey Orkestrasyonu</span>
            <span>Pika BI</span>
            <span>Ölçümleme</span>
        </div>
    </div>
    <div class="hero-side">
        <div class="hero-side-card">
            <div class="side-card-kicker">Bilgi Mimarisi</div>
            <p><strong>Müşteri zekâsı · ürün zekâsı · fırsat · Journey · ölçüm</strong></p>
            <p class="muted">10 ana bölüm ve @Model.TotalArticles detaylı rehber makalesi ile Pika'nın veriden aksiyona uzanan karar zincirini keşfedin.</p>
        </div>
    </div>
</section>

<div class="lead-note">
    <span class="eyebrow">Nasıl Kullanılır?</span>
    <p>Bilgi bankasındaki makaleler karar zincirinin sırasını izler: önce veri ve anlama katmanı, ardından analitik zekâ ve fırsat tespiti, son olarak da Journey ve çok kanallı gönderim operasyonları gelir.</p>
</div>

<div class="wiki-categories-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:20px;margin-top:32px;">
    @for (int i = 0; i < Model.Categories.Count; i++)
    {
        var cat = Model.Categories[i];
        <div class="category-card" style="background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px;box-shadow:var(--shadow-sm);">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
                <span style="width:26px;height:26px;border-radius:7px;background:var(--accent-soft);color:var(--accent-dark);display:grid;place-items:center;font-size:11.5px;font-weight:800;">
                    @(i + 1)
                </span>
                <h2 style="font-size:16.5px;font-weight:750;margin:0;letter-spacing:-.01em;">@cat.Title</h2>
            </div>
            <ul style="list-style:none;padding:0;margin:0;">
                @foreach (var p in cat.Pages)
                {
                    <li style="margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid #f1f5f9;">
                        <a href="/wiki/@p.Slug" style="font-weight:600;font-size:13.5px;color:var(--ink);text-decoration:none;display:block;margin-bottom:2px;transition:color .15s;">
                            @p.Title
                        </a>
                        <small style="color:var(--muted);font-size:11.5px;line-height:1.4;display:block;">
                            @p.Summary
                        </small>
                    </li>
                }
            </ul>
        </div>
    }
</div>

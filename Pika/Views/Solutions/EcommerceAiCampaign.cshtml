@{
    var tr = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = tr ? "E-Ticaret İçin AI Destekli Kampanya Yönetimi | Pika" : "AI-Powered Campaign Management for E-Commerce | Pika";
    ViewData["MetaDescription"] = tr ? "Pika ile e-ticaret kampanyalarınızı AI destekli oluşturun. Sepet hatırlatma, pasif müşteri geri kazanımı ve özel gün kampanyalarını tek platformda yönetin." : "Create your e-commerce campaigns with Pika AI. Manage cart reminders, inactive customer win-back and special day campaigns on a single platform.";
    ViewData["MetaKeywords"] = "e-ticaret kampanya,ai kampanya yönetimi,sepet hatırlatma,pasif müşteri,pika e-ticaret";
}

<!-- HERO -->
<section class="pika-sol-hero" data-module="ecommerce">
    <div class="container">
        <nav class="pika-sol-breadcrumb" data-aos="fade-down" data-aos-duration="500">
            <a href="@(tr ? "/" : "/en/")">@(tr ? "Ana Sayfa" : "Home")</a>
            <span class="sep">/</span>
            <span>@(tr ? "E-Ticaret İçin AI Destekli Kampanya Yönetimi" : "AI-Powered Campaign Management for E-Commerce")</span>
        </nav>
        <div class="pika-sol-hero-grid">
            <div data-aos="fade-right" data-aos-duration="700">
                <h1>@(tr ? "E-Ticaret İçin AI Destekli Kampanya Yönetimi" : "AI-Powered Campaign Management for E-Commerce")</h1>
                <p class="pika-sol-hero-desc">@(tr ? "Sepet hatırlatma, pasif müşteri geri kazanımı, özel gün kampanyaları ve tekrar satın alma senaryolarını Pika ile daha hızlı oluşturun. AI destekli kampanya asistanı ile kampanya fikrinden hazır gönderim taslağına geçin." : "Create cart reminders, inactive customer win-back, special day campaigns and repeat purchase scenarios faster with Pika. Go from campaign idea to delivery draft with AI-powered campaign assistant.")</p>
                <div class="pika-sol-hero-actions">
                    <button type="button" class="btn pika-btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i></button>
                    <a href="@Url.RouteUrl("AiCampaignAssistant", new { culture = ViewContext.RouteData.Values["culture"] ?? "tr" })" class="btn pika-btn-ghost px-4 py-2">@(tr ? "AI Kampanya Asistanını İncele" : "Explore AI Campaign Assistant")</a>
                </div>
            </div>
            <div class="pika-sol-hero-scene" data-aos="fade-left" data-aos-duration="700" data-aos-delay="200">
                <div class="pika-sol-scene-main">
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block wide"><i class="ri-shopping-cart-line"></i> @(tr ? "Sepet Hatırlatma" : "Cart Reminder")</div>
                        <div class="pika-sol-scene-block"><i class="ri-user-unfollow-line"></i> @(tr ? "Geri Kazanım" : "Win-back")</div>
                    </div>
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block"><i class="ri-calendar-event-line"></i> @(tr ? "Özel Gün" : "Special Day")</div>
                        <div class="pika-sol-scene-block"><i class="ri-refresh-line"></i> @(tr ? "Tekrar Satın Alma" : "Repeat Purchase")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- NEDEN ÖNEMLİ -->
<section class="pika-sol-section" style="background:var(--pika-bg2)">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h2 class="pika-h2 fw-bold">@(tr ? "E-ticarette kampanya hızı neden önemlidir?" : "Why is campaign speed important in e-commerce?")</h2>
            <p class="ph-muted mx-auto" style="max-width:700px">@(tr ? "E-ticaret ekipleri özel günler, stok hareketleri, sezonluk indirimler ve müşteri davranışlarına hızlı tepki vermek zorundadır. Pika, kampanya oluşturma ve çok kanallı gönderim süreçlerini tek platformda yönetmenize yardımcı olur." : "E-commerce teams need to react quickly to special days, stock movements, seasonal discounts and customer behaviors. Pika helps you manage campaign creation and multi-channel delivery processes on a single platform.")</p>
        </div>
    </div>
</section>

<!-- SENARYOLAR -->
<section class="pika-sol-section">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "Senaryolar" : "Scenarios")</span>
            <h2 class="pika-h2 fw-bold">@(tr ? "E-ticaret için hazır kampanya senaryoları" : "Ready campaign scenarios for e-commerce")</h2>
        </div>
        <div class="row g-4" data-aos="fade-up" data-aos-delay="100">
            @{
                var cards = tr
                    ? new (string t, string d, string i)[] {
                        ("Sepet hatırlatma", "Sepette ürün bırakan müşterilere email, SMS veya WhatsApp ile hatırlatma kampanyaları oluşturun.", "ri-shopping-cart-line"),
                        ("Pasif müşteri geri kazanımı", "Belirli süredir alışveriş yapmayan müşteriler için geri dönüş kampanyaları hazırlayın.", "ri-user-unfollow-line"),
                        ("Tekrar satın alma", "Düzenli tüketilen ürünlerde müşterilere doğru zamanda yeniden satın alma mesajı gönderin.", "ri-refresh-line"),
                        ("Yeni ürün duyurusu", "Yeni ürün veya koleksiyonları ilgili müşteri segmentlerine duyurun.", "ri-megaphone-line"),
                        ("VIP müşteri kampanyaları", "Yüksek değerli müşterilere özel teklif ve sadakat kampanyaları oluşturun.", "ri-vip-crown-line"),
                        ("Özel gün kampanyaları", "Anneler Günü, yılbaşı, doğum günü ve sezonluk kampanyaları hızla hazırlayın.", "ri-calendar-event-line")
                    }
                    : new (string t, string d, string i)[] {
                        ("Cart reminder", "Create reminder campaigns via email, SMS or WhatsApp for customers who left items in their cart.", "ri-shopping-cart-line"),
                        ("Inactive customer win-back", "Prepare comeback campaigns for customers who haven't shopped for a while.", "ri-user-unfollow-line"),
                        ("Repeat purchase", "Send repurchase messages to customers at the right time for regularly consumed products.", "ri-refresh-line"),
                        ("New product announcement", "Announce new products or collections to relevant customer segments.", "ri-megaphone-line"),
                        ("VIP customer campaigns", "Create special offers and loyalty campaigns for high-value customers.", "ri-vip-crown-line"),
                        ("Special day campaigns", "Quickly prepare Mother's Day, New Year, birthday and seasonal campaigns.", "ri-calendar-event-line")
                    };
            }
            @foreach (var c in cards)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="ph-module-card">
                        <div class="ph-module-icon"><i class="@c.i"></i></div>
                        <h6 class="fw-bold mb-2">@c.t</h6>
                        <p class="small ph-muted mb-0">@c.d</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- AI BÖLÜMÜ -->
<section class="pika-sol-section" style="background:var(--pika-bg2)">
    <div class="container">
        <div class="row align-items-center g-5" data-aos="fade-up">
            <div class="col-lg-6">
                <span class="ph-eyebrow">AI</span>
                <h2 class="pika-h2 fw-bold mb-3">@(tr ? "Kampanya fikrini yazın, Pika taslağı oluştursun" : "Write your idea, let Pika create the draft")</h2>
                <p class="ph-muted">@(tr ? "Pika AI Kampanya Asistanı, e-ticaret kampanya fikrinizi alır; kampanya adı, hedef kitle, kanal, mesaj ve email template taslağı oluşturur." : "Pika AI Campaign Assistant takes your e-commerce campaign idea and generates campaign name, audience, channel, message and email template draft.")</p>
                <a href="@Url.RouteUrl("AiCampaignAssistant", new { culture = ViewContext.RouteData.Values["culture"] ?? "tr" })" class="btn pika-btn-primary px-4 py-2 mt-3">@(tr ? "AI Kampanya Asistanını İncele" : "Explore AI Campaign Assistant") <i class="ri-arrow-right-line"></i></a>
            </div>
            <div class="col-lg-6">
                <div class="ph-ai-panel">
                    <div class="ph-ai-panel-header"><i class="ri-robot-line" style="color:var(--pika-primary2)"></i> Pika AI</div>
                    <div class="ph-ai-panel-body">
                        <div class="ph-ai-msg ph-ai-msg--user">@(tr ? "Sepette ürün bırakan müşterilere WhatsApp hatırlatma kampanyası oluştur" : "Create a WhatsApp reminder campaign for cart abandoners")</div>
                        <div class="ph-ai-msg ph-ai-msg--bot">
                            <strong class="d-block mb-1">@(tr ? "Kampanya Taslağı Hazır ✓" : "Campaign Draft Ready ✓")</strong>
                            <span class="d-block mb-1">📋 @(tr ? "Kanal: WhatsApp" : "Channel: WhatsApp")</span>
                            <span class="d-block mb-1">👥 @(tr ? "Segment: Sepet terk edenler" : "Segment: Cart abandoners")</span>
                            <span class="d-block">📝 @(tr ? "Mesaj ve template hazırlandı" : "Message and template ready")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="ph-cta-section">
    <div class="container text-center" data-aos="fade-up">
        <h2 class="ph-cta-title text-white mx-auto" style="max-width:680px">@(tr ? "E-ticaret kampanyalarınızı Pika ile hızlandırın" : "Accelerate your e-commerce campaigns with Pika")</h2>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <button type="button" class="ph-btn-light" data-bs-toggle="modal" data-bs-target="#demoModal"><span>@(tr ? "Demo Talep Et" : "Request a Demo")</span> <i class="ri-arrow-right-up-line"></i></button>
        </div>
    </div>
</section>

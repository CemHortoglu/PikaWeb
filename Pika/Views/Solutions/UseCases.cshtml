@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr = culture == "tr";
    ViewData["Title"] = tr ? "Kullanım Senaryoları | Pika" : "Use Cases | Pika";
    ViewData["MetaDescription"] = tr ? "Tekrar satın alma, pasifleşme, cross-sell, Journey, kanal uygunluğu ve ölçüm gibi gerçek iş sorularının Pika içinde nasıl ele alındığını görün." : "See how Pika addresses real business questions such as repeat purchase, inactivity, cross-sell, Journey automation, channel eligibility and measurement.";
    ViewData["BodyClass"] = "pk-page";
}
<section class="pk-hero">
    <div class="pk-container pk-hero-grid">
        <div><span class="pk-eyebrow">@(tr ? "Kullanım Senaryoları" : "Use Cases")</span><h1>@(tr ? "Modülü değil, iş sorunuzu seçin." : "Start with the business question, not the module.")</h1><p>@(tr ? "Pika'nın değeri bir özellik listesinden değil, gerçek bir iş sorusunu veri → zekâ → fırsat → karar → aksiyon → ölçüm zincirinde çözebilmesinden gelir." : "Pika's value is not a feature list; it is the ability to address a real business question through data → intelligence → opportunity → decision → action → measurement.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Kendi Senaryonuzu Konuşalım" : "Discuss Your Use Case")</button></div></div>
        <figure class="pk-proof"><img src="/wiki/assets/images/img_gunun-firsatlari.png" alt="@(tr ? "Pika Günün Fırsatları ürün ekranı" : "Pika Daily Opportunities product screen")" width="1200" height="760" /><figcaption>@(tr ? "Fırsat önce kanıt ve bağlamla görünür olur; aksiyon daha sonra kullanıcı kontrolünde seçilir." : "An opportunity is surfaced with evidence and context before the user chooses an action.")</figcaption></figure>
    </div>
</section>
<section class="pk-section pk-section-lg"><div class="pk-container">
    <div class="pk-scenario"><div><span class="pk-eyebrow">01 · @(tr ? "Tekrar satın alma" : "Repeat purchase")</span><h3>@(tr ? "Müşterim ne zaman tekrar satın almaya hazır?" : "When is my customer ready to buy again?")</h3><p>@(tr ? "Takvimde sabit bir gün belirlemek yerine müşterinin kendi geçmiş ritmini ve ürün bağlamını değerlendirin." : "Evaluate the customer's own historical rhythm and product context instead of choosing a fixed calendar date.")</p></div><div><div class="pk-scenario-flow"><span class="pk-chip">@(tr ? "Satış geçmişi" : "Sales history")</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr ? "Satın alma ritmi" : "Purchase rhythm")</span><span class="pk-arrow">→</span><span class="pk-chip">Product Intelligence</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr ? "Fırsat" : "Opportunity")</span><span class="pk-arrow">→</span><span class="pk-chip">Campaign / Journey</span></div><p>@(tr ? "Beklenen ihtiyaç penceresi yaklaştığında Pika bunu fırsat bağlamında görünür kılabilir. Kullanıcı kanıtı değerlendirir; izin ve kanal uygunluğu varsa aksiyonu seçer." : "As the expected need window approaches, Pika can surface it as an opportunity. The user reviews the evidence and chooses action only when consent and channel eligibility allow it.")</p><a href="@(tr ? "/platform/gunun-firsatlari" : "/en/platform/opportunities")">@(tr ? "Günün Fırsatları →" : "Daily Opportunities →")</a></div></div>
    <div class="pk-scenario"><div><span class="pk-eyebrow">02 · @(tr ? "Pasifleşme / geri kazanım" : "Inactivity / win-back")</span><h3>@(tr ? "Değerli müşterilerimden hangileri alışveriş ritminden uzaklaşıyor?" : "Which valuable customers are drifting from their purchase rhythm?")</h3><p>@(tr ? "Herkese aynı 'uzun süredir gelmediniz' mesajını göndermek yerine müşterinin kendi davranışına bakın." : "Look at each customer's own behavior rather than sending the same win-back message to everyone.")</p></div><div><div class="pk-scenario-flow"><span class="pk-chip">Customer Intelligence</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr ? "Değer + ritim" : "Value + rhythm")</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr ? "Risk sinyali" : "Risk signal")</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr ? "Geri kazanım fırsatı" : "Win-back opportunity")</span></div><p>@(tr ? "Müşterinin değeri ve davranış değişimi ayrı sinyaller olarak okunur. Bu, geri kazanımın kime ve neden uygulanacağına daha açıklanabilir bir temel verir." : "Customer value and behavioral change are read as separate signals, giving win-back decisions a more explainable basis.")</p><a href="@(tr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")">Customer Intelligence →</a></div></div>
    <div class="pk-scenario"><div><span class="pk-eyebrow">03 · Cross-sell</span><h3>@(tr ? "Bir ürünü alan müşteriye başka ne önerebilirim?" : "What else can I offer a customer who bought this product?")</h3><p>@(tr ? "Önce ürünlerin birlikte satın alınma kanıtını, sonra müşterinin ürün bağlamını değerlendirin." : "Start with evidence that products are purchased together, then add customer and product context.")</p></div><div><div class="pk-scenario-flow"><span class="pk-chip">@(tr ? "Sepet kanıtı" : "Basket evidence")</span><span class="pk-arrow">→</span><span class="pk-chip">Support · Confidence · Lift</span><span class="pk-arrow">→</span><span class="pk-chip">Product Intelligence</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr ? "Müşteri bağlamı" : "Customer context")</span></div><p>@(tr ? "Cross-sell BI ürün ilişkisini kanıtlar; müşteriye özel aksiyon bundan sonraki katmanda müşteri ve Product Intelligence bağlamıyla kurulabilir. Pika ölçülmemiş bir başarı olasılığını varmış gibi göstermez." : "Cross-sell BI establishes product relationship evidence; customer-specific action can then use customer and Product Intelligence context. Pika does not invent an unmeasured success probability.")</p><a href="@(tr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")">Product Intelligence →</a></div></div>
    <div class="pk-scenario"><div><span class="pk-eyebrow">04 · Journey</span><h3>@(tr ? "Tek seferlik kampanyayı sürekli müşteri akışına nasıl dönüştürürüm?" : "How do I turn a one-off campaign into an ongoing customer flow?")</h3><p>@(tr ? "Tekrarlanan manuel adımları tetikleyici, karar, bekleme ve aksiyon adımlarına dönüştürün." : "Turn repeated manual steps into triggers, decisions, waits and actions.")</p></div><div><div class="pk-scenario-flow"><span class="pk-chip">Trigger</span><span class="pk-arrow">→</span><span class="pk-chip">Decision</span><span class="pk-arrow">→</span><span class="pk-chip">Wait</span><span class="pk-arrow">→</span><span class="pk-chip">Action</span></div><p>@(tr ? "Journey Manager müşteri davranışının akış içinde nasıl ilerleyeceğini görsel olarak yönetir. Campaign tanımlı bir gönderimi; Journey ise çok aşamalı ilişki mantığını temsil eder." : "Journey Manager visually manages how customer behavior progresses through a flow. A Campaign represents defined execution; a Journey represents multi-step relationship logic.")</p><a href="@(tr ? "/platform/journey-manager" : "/en/platform/journey-manager")">Journey Manager →</a></div></div>
    <div class="pk-scenario"><div><span class="pk-eyebrow">05 · @(tr ? "Kanal uygunluğu" : "Channel eligibility")</span><h3>@(tr ? "Hangi müşteriye hangi kanaldan ulaşmalıyım?" : "Which channel should I use for this customer?")</h3><p>@(tr ? "Bir kanalın performans göstermesi, her müşteride kullanılabilir olduğu anlamına gelmez." : "A channel performing well does not mean it is eligible for every customer.")</p></div><div><div class="pk-scenario-flow"><span class="pk-chip">@(tr ? "İletişim bilgisi" : "Contact data")</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr ? "İzin / opt-out" : "Consent / opt-out")</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr ? "Uygunluk" : "Eligibility")</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr ? "Kanal kararı" : "Channel decision")</span></div><p>@(tr ? "Pika kanal kararında erişilebilirlik ve izin bağlamını dikkate alır. Uygun kanal yoksa sırf aksiyon üretmek için zorunlu bir kanal seçilmesi gerekmez." : "Pika considers reachability and consent context in channel decisions. If no channel is eligible, the system does not need to force an action.")</p><a href="@(tr ? "/platform/consent-management" : "/en/platform/consent-management")">Consent Management →</a></div></div>
    <div class="pk-scenario"><div><span class="pk-eyebrow">06 · @(tr ? "Ölçüm" : "Measurement")</span><h3>@(tr ? "Yaptığım kampanya veya Journey ne sonuç verdi?" : "What happened after my Campaign or Journey?")</h3><p>@(tr ? "Gönderim durumu, engagement ve desteklenen satış ilişkilerini aynı şeymiş gibi yorumlamayın." : "Do not treat delivery status, engagement and supported sales relationships as if they were the same thing.")</p></div><div><div class="pk-scenario-flow"><span class="pk-chip">@(tr ? "Gönderim" : "Delivery")</span><span class="pk-arrow">→</span><span class="pk-chip">Engagement</span><span class="pk-arrow">→</span><span class="pk-chip">Attribution</span><span class="pk-arrow">→</span><span class="pk-chip">Analytics</span></div><p>@(tr ? "Pika desteklenen sonuçları ölçüm katmanında bir araya getirir. Attribution bir ilişkilendirmedir; tek başına nedensellik kanıtı değildir." : "Pika brings supported outcomes together in the measurement layer. Attribution is an association, not proof of causation by itself.")</p><a href="@(tr ? "/platform/analytics" : "/en/platform/analytics")">Analytics →</a></div></div>
</div></section>
<section class="pk-section pk-section-soft"><div class="pk-container pk-screen-band"><div><span class="pk-eyebrow">@(tr ? "Senaryodan ürüne" : "From use case to product")</span><h2>@(tr ? "Aynı senaryo birden fazla Pika katmanını kullanabilir." : "One use case can span multiple Pika layers.")</h2><p class="pk-lead">@(tr ? "Bu nedenle Pika'yı modül listesinden değil, veriden ölçüme giden karar zinciri üzerinden değerlendirmek daha doğrudur. Kullanım senaryonuzun veri gereksinimini Bilgi Bankasında ayrıntılı inceleyebilirsiniz." : "That is why Pika is better evaluated as a decision chain from data to measurement, rather than as a module list. The Knowledge Base documents data requirements in greater detail.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="/wiki/ozellik-veri-gereksinimleri">@(tr ? "Özellik → Veri Gereksinimi" : "Capability → Data Requirements")</a></div></div><img src="/wiki/assets/images/img_bi-kokpit_5.png" alt="@(tr ? "Pika BI kokpit ekranı" : "Pika BI cockpit screen")" loading="lazy" width="1200" height="760" /></div></section>

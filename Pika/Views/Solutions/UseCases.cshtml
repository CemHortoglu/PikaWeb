@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]=tr?"Kullanım Senaryoları | Pika":"Use Cases | Pika";
    ViewData["MetaDescription"]=tr?"Tekrar satın alma, pasifleşme, cross-sell, Journey otomasyonu, kanal uygunluğu ve ölçüm gibi gerçek iş sorularının Pika'da veri → zekâ → fırsat → aksiyon → ölçüm zincirinde nasıl ele alındığını görün.":"See how Pika addresses repeat purchase, inactivity, cross-sell, Journey automation, channel eligibility and measurement through data → intelligence → opportunity → action → measurement.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">@(tr?"Kullanım Senaryoları":"Use Cases")</span><h1>@(tr?"Modülü değil, çözmek istediğiniz iş sorusunu seçin.":"Start with the business question, not the module.")</h1><p>@(tr?"Pika'nın değeri bir özellik listesinden değil, gerçek bir iş sorusunu veri → Customer/Product Intelligence → fırsat → kullanıcı kararı → Campaign/Journey → ölçüm zincirinde çözebilmesinden gelir. Bu sayfa ürünün hangi yönetici sorularına nasıl bağlandığını gösterir.":"Pika's value is not a feature list. It comes from solving real business questions through data → Customer/Product Intelligence → opportunity → user decision → Campaign/Journey → measurement. This page maps manager questions to the product flow.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Kendi Senaryonuzu Konuşalım":"Discuss Your Use Case")</button><a class="pk-btn pk-btn-ghost" href="/wiki/ornek-kullanim-senaryolari">@(tr?"Senaryo rehberi":"Use-case guide")</a></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_gunun-firsatlari.png" alt="@(tr?"Pika Günün Fırsatları ürün ekranı":"Pika Daily Opportunities product screen")" width="1200" height="760" /><div class="pk-stage-caption"><strong>@(tr?"İş sorusundan aksiyona":"From business question to action")</strong><span>@(tr?"Kanıtı gör → kararı ver → uygula":"See evidence → decide → execute")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-refresh-line"></i><div><strong>@(tr?"Tekrar satın alma":"Repeat purchase")</strong><small>@(tr?"Ne zaman?":"When?")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-user-unfollow-line"></i><div><strong>@(tr?"Geri kazanım":"Win-back")</strong><small>@(tr?"Kime?":"Who?")</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-links-line"></i><div><strong>Cross-sell</strong><small>@(tr?"Ne önerebilirim?":"What might be relevant?")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Senaryo haritası":"Use-case map")</span><h2>@(tr?"Yöneticinin günlük soruları Pika'nın katmanlarını bir araya getirir.":"A manager's daily questions bring Pika layers together.")</h2></div><p class="pk-lead">@(tr?"Aynı senaryo Customer Intelligence, Product Intelligence, Pika 360, Audience, Campaign, Journey ve Analytics'in birden fazlasını kullanabilir. Bu yüzden Pika'yı modül bazında değil, iş sorusundan sonuca giden zincir üzerinden değerlendirmek daha anlamlıdır.":"One use case can involve Customer Intelligence, Product Intelligence, Pika 360, Audience, Campaign, Journey and Analytics together. Pika is therefore better evaluated as a chain from business question to outcome rather than a module checklist.")</p></div><div class="pk-intel-grid"><article class="pk-intel-panel"><span class="pk-intel-number">01</span><div class="pk-intel-icon"><i class="ri-refresh-line"></i></div><h3>@(tr?"Tekrar satın alma":"Repeat purchase")</h3><p>@(tr?"Müşterinin kendi alışveriş ritmini ve ürünün tekrar tüketim bağlamını birlikte değerlendirin." : "Review individual purchase rhythm together with product repeat-consumption context.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">02</span><div class="pk-intel-icon"><i class="ri-user-unfollow-line"></i></div><h3>@(tr?"Pasifleşme / geri kazanım":"Inactivity / win-back")</h3><p>@(tr?"Müşterinin kendi normal davranışından uzaklaşmasını geçmiş değeri ve ilişki bağlamıyla birlikte okuyun." : "Read drift from normal behavior together with historical value and relationship context.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">03</span><div class="pk-intel-icon"><i class="ri-links-line"></i></div><h3>Cross-sell</h3><p>@(tr?"Ürün birlikteliği kanıtını müşteri bağlamıyla birleştirin; ölçülmemiş başarı olasılığı varmış gibi davranmayın." : "Combine product co-purchase evidence with customer context without inventing an unmeasured success probability.")</p></article></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-scenario"><div><span class="pk-eyebrow">01 · @(tr?"Tekrar satın alma":"Repeat purchase")</span><h3>@(tr?"Müşterim ne zaman tekrar satın almaya hazır?":"When is my customer ready to buy again?")</h3><p>@(tr?"Sabit bir '30 gün geçti' kuralı yerine müşterinin kendi alışveriş ritmi ve ürünün tekrar tüketim bağlamını birlikte değerlendirin." : "Use the customer's own purchase rhythm and product repeat-consumption context rather than a fixed '30 days passed' rule.")></p></div><div><div class="pk-scenario-flow"><span class="pk-chip">@(tr?"Satış geçmişi":"Sales history")</span><span class="pk-arrow">→</span><span class="pk-chip">Customer Intelligence</span><span class="pk-arrow">→</span><span class="pk-chip">Product Intelligence</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr?"Fırsat":"Opportunity")</span><span class="pk-arrow">→</span><span class="pk-chip">Campaign / Journey</span></div><p>@(tr?"Beklenen ihtiyaç penceresi yaklaştığında Pika bunu fırsat bağlamında görünür kılabilir. Kullanıcı müşterinin ve ürünün kanıtını inceler; iletişim gerekiyorsa izin ve kanal uygunluğunu ayrıca değerlendirir." : "As the expected need window approaches, Pika can surface an opportunity. The user reviews customer and product evidence, then evaluates consent and channel eligibility if communication is appropriate.")</p><a class="pk-text-link" href="@(tr?"/platform/gunun-firsatlari":"/en/platform/opportunities")">@(tr?"Günün Fırsatları'nı inceleyin":"Explore Daily Opportunities") <i class="ri-arrow-right-line"></i></a></div></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_tekrar-satin-alma-analizi_6.png" alt="@(tr?"Pika tekrar satın alma analizi":"Pika repeat purchase analysis")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Customer Intelligence</small><h3>@(tr?"Müşterinin kendi ritmini görün":"See the customer's own rhythm")</h3><p>@(tr?"Tekrar satın alma sinyalini genel müşteri ortalaması yerine mümkün olduğunda kişisel geçmişle açıklayın." : "Explain repeat-purchase signals through individual history where possible rather than broad averages.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_aksiyon-calisma-alani_9.png" alt="@(tr?"Pika fırsattan aksiyona çalışma alanı":"Pika opportunity-to-action workspace")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Fırsattan aksiyona":"From opportunity to action")</small><h3>@(tr?"Kanıtı kaybetmeden Campaign veya Journey'e geçin":"Move to Campaign or Journey without losing context")</h3><p>@(tr?"Fırsatın nedeni sonraki aksiyon hazırlığında görünür kalır." : "The reason behind the opportunity remains visible during action preparation.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-scenario"><div><span class="pk-eyebrow">02 · @(tr?"Pasifleşme / geri kazanım":"Inactivity / win-back")</span><h3>@(tr?"Değerli müşterilerimden hangileri alışveriş ritminden uzaklaşıyor?":"Which valuable customers are drifting from their purchase rhythm?")</h3><p>@(tr?"Herkese aynı 'uzun süredir gelmediniz' mesajı yerine müşterinin kendi davranış değişimini, geçmiş ticari değerini ve mevcut ilişki bağlamını birlikte okuyun." : "Instead of sending the same win-back message to everyone, review the customer's own behavioral change, historical commercial value and current relationship context.")></p></div><div><div class="pk-scenario-flow"><span class="pk-chip">Customer Intelligence</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr?"Değer":"Value")</span><span class="pk-arrow">+</span><span class="pk-chip">@(tr?"Ritim":"Rhythm")</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr?"Risk":"Risk")</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr?"Geri kazanım":"Win-back")</span></div><p>@(tr?"Yüksek değerli olmak müşterinin sağlıklı ilişki içinde olduğu anlamına gelmez. Normal ritminden uzaklaşan değerli müşteri, daha düşük değerli ama aktif bir müşteriden farklı öncelik gerektirebilir." : "High historical value does not necessarily mean a healthy current relationship. A valuable customer drifting from normal rhythm may deserve different attention from a lower-value but active customer.")</p><a class="pk-text-link" href="@(tr?"/platform/customer-intelligence":"/en/platform/customer-intelligence")">Customer Intelligence <i class="ri-arrow-right-line"></i></a></div></div><div class="pk-screen-band"><img src="/wiki/assets/images/img_pika-360_7.png" alt="@(tr?"Pika 360 müşteri risk ve fırsat bağlamı":"Pika 360 customer risk and opportunity context")" loading="lazy" width="1200" height="760" /><div><span class="pk-eyebrow">Pika 360</span><h2>@(tr?"Risk sinyalini müşteri geçmişinden koparmayın.":"Do not separate risk signals from customer history.")</h2><p class="pk-lead">@(tr?"Pika 360 tek müşteride profil, işlem, segment, davranış ve fırsat bağlamını birlikte değerlendirmeyi kolaylaştırır. Böylece geri kazanım yalnız zaman geçmişine dayanan genel mesaj olmaz." : "Pika 360 helps review profile, transaction, segment, behavior and opportunity context around one customer, making win-back more than a generic elapsed-time message.")</p></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-scenario"><div><span class="pk-eyebrow">03 · Cross-sell</span><h3>@(tr?"Bir ürünü alan müşteriye başka ne önerebilirim?":"What else can I offer a customer who bought this product?")</h3><p>@(tr?"Önce hangi ürünlerin gerçekten birlikte satın alındığını, sonra ürünün Need Group/Product Role bağlamını ve müşterinin mevcut ilişkisini değerlendirin." : "Start by identifying which products are actually purchased together, then review Need Group/Product Role context and the customer's current relationship.")></p></div><div><div class="pk-scenario-flow"><span class="pk-chip">@(tr?"Sepet kanıtı":"Basket evidence")</span><span class="pk-arrow">→</span><span class="pk-chip">Support · Confidence · Lift</span><span class="pk-arrow">→</span><span class="pk-chip">Product Intelligence</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr?"Müşteri bağlamı":"Customer context")</span></div><p>@(tr?"Cross-sell BI ürün çiftleri arasındaki sepet ilişkisini kanıtlayabilir; bu doğrudan 'bu müşteri kesin alır' anlamına gelmez. Müşteriye özel aksiyon Customer Intelligence, Product Intelligence ve iş kurallarıyla sonraki katmanda kurulmalıdır." : "Cross-sell BI can establish basket relationships between products; it does not mean a specific customer will definitely buy. Customer-specific action should add Customer Intelligence, Product Intelligence and business rules in the next layer.")</p><a class="pk-text-link" href="@(tr?"/platform/product-intelligence":"/en/platform/product-intelligence")">Product Intelligence <i class="ri-arrow-right-line"></i></a></div></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_need-group-product-role_11.png" alt="@(tr?"Pika Need Group Product Role ekranı":"Pika Need Group Product Role screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Product Intelligence</small><h3>@(tr?"Ürün ilişkisine ticari anlam ekleyin":"Add commercial meaning to product relationships")</h3><p>@(tr?"Ürünün ihtiyacı ve rolü, cross-sell/upsell gibi ilişkilerin hangi iş bağlamında anlamlı olabileceğini açıklar." : "Product need and role help explain when cross-sell/upsell relationships may make business sense.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_review-resolution-readiness_14.png" alt="@(tr?"Pika ürün review resolution readiness":"Pika product review resolution readiness")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Veri güvenilirliği":"Data reliability")</small><h3>@(tr?"Eşleşmeyen ürünü fırsat kanıtı saymayın":"Do not treat unresolved products as trusted opportunity evidence")</h3><p>@(tr?"Ürün çözümleme ve sınıflandırma kalitesi, ürün zekâsının karar değerini doğrudan etkiler." : "Product resolution and classification quality directly affect decision value.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">04 · Journey</span><h2>@(tr?"Tek seferlik kampanyayı sürekli müşteri akışına nasıl dönüştürürüm?":"How do I turn a one-off campaign into an ongoing customer flow?")</h2></div><p class="pk-lead">@(tr?"Tekrarlanan manuel adımları trigger, decision, wait ve action adımlarına dönüştürün. Journey bir 'daha gelişmiş kampanya' değil; müşteri olay ve koşullarının zaman içinde ilerlediği farklı bir yürütme modelidir." : "Turn recurring manual steps into trigger, decision, wait and action stages. Journey is not merely an advanced Campaign; it is a different execution model where customer events and conditions progress over time.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-play-circle-line"></i><strong>Trigger</strong><span>@(tr?"Müşteri akışa girer":"Customer enters the flow")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-git-branch-line"></i><strong>Decision</strong><span>@(tr?"Bağlama göre yol seçilir":"Choose path by context")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-timer-line"></i><strong>Wait</strong><span>@(tr?"Doğru zamanı bekle":"Wait for the right time")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-shield-check-line"></i><strong>@(tr?"Uygunluk":"Eligibility")</strong><span>@(tr?"İzin ve kanal":"Consent and channel")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-flashlight-line"></i><strong>Action</strong><span>@(tr?"Email · SMS · WhatsApp · Push":"Email · SMS · WhatsApp · Push")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>Measure</strong><span>@(tr?"Akış sonucunu değerlendir":"Review flow outcome")</span></div></div><div class="pk-gallery" style="margin-top:28px"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_journey-tasarim-tuvali_18.png" alt="@(tr?"Pika Journey tasarım tuvali":"Pika Journey design canvas")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Journey Manager</small><h3>@(tr?"Akışı görsel olarak yönetin":"Manage the flow visually")</h3><p>@(tr?"Müşterinin hangi koşulda hangi adıma ilerlediğini ekip için anlaşılır hale getirin." : "Make customer progression by condition understandable for the team.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_journey-karar-kurallari_19.png" alt="@(tr?"Pika Journey karar kuralları":"Pika Journey decision rules")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Decision Rules</small><h3>@(tr?"Her müşteri aynı yolu izlemez":"Not every customer follows the same path")</h3><p>@(tr?"Segment, profil, izin ve desteklenen davranış koşulları akışın yönünü değiştirebilir." : "Segment, profile, consent and supported behavior conditions can alter the path.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-scenario"><div><span class="pk-eyebrow">05 · @(tr?"Kanal uygunluğu":"Channel eligibility")</span><h3>@(tr?"Hangi müşteriye hangi kanaldan ulaşmalıyım?":"Which channel should I use for this customer?")</h3><p>@(tr?"Bir kanalın genel performansı, her müşteri için kullanılabilir olduğu anlamına gelmez. İletişim adresi, izin, opt-out ve ilgili kanal koşulları ayrı değerlendirilir." : "A channel's overall performance does not make it eligible for every customer. Contact address, consent, opt-out and channel conditions are evaluated separately.")></p></div><div><div class="pk-scenario-flow"><span class="pk-chip">@(tr?"İletişim bilgisi":"Contact data")</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr?"İzin / opt-out":"Consent / opt-out")</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr?"Kanal uygunluğu":"Channel eligibility")</span><span class="pk-arrow">→</span><span class="pk-chip">@(tr?"Aksiyon / gönderme":"Action / no send")</span></div><p>@(tr?"Uygun kanal yoksa sırf fırsat var diye zorunlu bir kanal seçilmesi gerekmez. Pika'nın doğru davranışı aksiyon üretmemek olabilir." : "If no channel is eligible, Pika does not need to force a channel simply because an opportunity exists. Taking no communication action may be correct.")</p><a class="pk-text-link" href="@(tr?"/platform/consent-management":"/en/platform/consent-management")">Consent Management <i class="ri-arrow-right-line"></i></a></div></div><div class="pk-screen-band"><img src="/wiki/assets/images/img_izin-kanal-zamanlama_25.png" alt="@(tr?"Pika izin kanal zamanlama ekranı":"Pika consent channel timing screen")" loading="lazy" width="1200" height="760" /><div><span class="pk-eyebrow">Consent Management</span><h2>@(tr?"Doğru fırsat ile uygun iletişim kanalını ayrı kararlar olarak yönetin.":"Treat the right opportunity and eligible communication channel as separate decisions.")</h2><p class="pk-lead">@(tr?"Kişi kaydı, adres, izin, opt-out, kanal ve zamanlama bağlamı iletişimden önce ayrı ayrı değerlendirilir." : "Contact record, address, consent, opt-out, channel and timing context are evaluated separately before communication.")</p></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-scenario"><div><span class="pk-eyebrow">06 · @(tr?"Ölçüm":"Measurement")</span><h3>@(tr?"Yaptığım Campaign veya Journey ne sonuç verdi?":"What happened after my Campaign or Journey?")</h3><p>@(tr?"Gönderim durumu, engagement, satış attribution ve gerçek nedensellik farklı kavramlardır. Sonuçları aynı sepete atmak yerine doğru anlamla değerlendirin." : "Delivery status, engagement, sales attribution and causality are different concepts. Review each with the correct meaning.")></p></div><div><div class="pk-scenario-flow"><span class="pk-chip">@(tr?"Gönderim":"Delivery")</span><span class="pk-arrow">→</span><span class="pk-chip">Engagement</span><span class="pk-arrow">→</span><span class="pk-chip">Attribution</span><span class="pk-arrow">≠</span><span class="pk-chip">Causation</span></div><p>@(tr?"Pika desteklenen sonuçları Analytics katmanında bir araya getirir. Attribution kampanya sonrası davranışla ilişki kurabilir; tek başına kampanyanın sonucu yarattığını kanıtlamaz." : "Pika brings supported outcomes together in Analytics. Attribution can associate later behavior with a campaign; it does not prove by itself that the campaign caused the outcome.")</p><a class="pk-text-link" href="@(tr?"/platform/analytics":"/en/platform/analytics")">Analytics <i class="ri-arrow-right-line"></i></a></div></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_bi-kokpit_5.png" alt="@(tr?"Pika BI Analytics ekranı":"Pika BI Analytics screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Analytics</small><h3>@(tr?"Aksiyondan sonra ne olduğunu görün":"See what happened after action")</h3><p>@(tr?"Satış, müşteri, ürün ve kampanya sonuçlarını desteklenen metriklerle değerlendirin." : "Review sales, customer, product and campaign outcomes using supported metrics.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_gonderim-operasyonu-izleme_28.png" alt="@(tr?"Pika gönderim sonuç izleme ekranı":"Pika delivery outcome monitoring")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Delivery</small><h3>@(tr?"Operasyonel durum ile ticari sonucu ayırın":"Separate operational status from commercial outcome")</h3><p>@(tr?"Gönderim teknik sonucu, müşteri davranışı ve satış etkisi farklı ölçüm katmanlarıdır." : "Delivery status, customer behavior and sales impact are different measurement layers.")</p></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-cta-panel"><span class="pk-eyebrow" style="color:#d7ed87">@(tr?"Kendi senaryonuz":"Your use case")</span><h2>@(tr?"Hangi modülü alacağınızdan önce hangi kararı iyileştirmek istediğinizi konuşalım.":"Before choosing a module, let's identify which decision you want to improve.")</h2><p>@(tr?"Mevcut müşteri, ürün ve satış verinizle hangi senaryoların gerçekten desteklenebileceğini; eksik veri varsa pilotu nasıl sınırlayacağımızı ve sonucu hangi ölçümle değerlendireceğimizi birlikte netleştirelim." : "Let's determine which use cases your current customer, product and sales data can genuinely support, how to scope a pilot if data is incomplete and how success should be measured.")</p><div class="pk-actions"><button class="pk-btn pk-btn-light" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Senaryonuzu Konuşalım":"Discuss Your Use Case")</button><a class="pk-btn pk-btn-ghost" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.25)" href="/wiki/ozellik-veri-gereksinimleri">@(tr?"Veri Gereksinimlerini Görün":"See Data Requirements")</a></div></div></div></section>

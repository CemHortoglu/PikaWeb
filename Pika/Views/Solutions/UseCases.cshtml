@{
    var culture = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr = culture == "tr";
    ViewData["Title"] = tr ? "Kullanım Senaryoları | Pika ile Gerçek İş Problemlerine Çözümler" : "Use Cases | Solving Real Business Problems with Pika";
    ViewData["MetaDescription"] = tr
        ? "Müşteri pasifleşmesi, tekrar satın alma ritmi, sepet tamamlama, çapraz satış ve izinli kanal yönetimi gibi gerçek iş sorularını Pika ile nasıl çözeceğinizi keşfedin."
        : "Discover how to solve real business questions like customer churn, repeat purchase timing, cart recovery, cross-selling, and compliant channel routing with Pika.";
    ViewData["CanonicalUrl"] = tr ? "https://pika.tr/kullanim-senaryolari" : "https://pika.tr/en/use-cases";
}

@section Styles {
    <link href="~/css/usecases.css" rel="stylesheet" />
}

<!-- ═══════════════════════════ HERO ═══════════════════════════ -->
@await Html.PartialAsync("_MarketingHero")

<!-- ═══════════════════════════ SCENARIOS LIST ═══════════════════════════ -->
<section class="uc-section">
    <div class="container">
        <div class="uc-scenarios-container">

            <!-- SCENARIO 1 -->
            <div class="uc-scenario-card">
                <div class="uc-scenario-header">
                    <div class="uc-q-tag">@(tr ? "İŞ SORUSU 01" : "BUSINESS QUESTION 01")</div>
                    <h2 class="uc-scenario-q">@(tr ? "“Müşterim ne zaman tekrar satın almaya hazır?”" : "“When is my customer ready to repurchase?”")</h2>
                </div>

                <div class="uc-flow-grid">
                    <div class="uc-flow-col">
                        <div class="uc-step-badge">1. @(tr ? "Pika Anlar" : "Pika Understands")</div>
                        <h5>Product Intelligence &amp; Tüketim Ritmi</h5>
                        <p>@(tr ? "Satın alınan ürünün ortalama tüketim süresini (ör. 30 günlük kahve veya 45 günlük bakım kremi) ve müşterinin geçmiş sipariş periyodunu hesaplar." : "Calculates product consumption duration (e.g. 30-day coffee, 45-day skincare) and individual order frequency.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--opp">2. @(tr ? "Pika Bulur" : "Pika Finds")</div>
                        <h5>Günün Fırsatları: Tekrar Satın Alma Sinyali</h5>
                        <p>@(tr ? "Tüketim süresi dolmak üzere olan müşterileri otomatik olarak 'Tekrar Satın Alma' fırsat listesine ekler." : "Flags customers whose product supply is running low as active 'Repurchase' opportunities.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--ctrl">3. @(tr ? "Yönetici Kontrolü" : "Manager Controls")</div>
                        <h5>Kanal ve Teklif Onayı</h5>
                        <p>@(tr ? "Pazarlama yöneticisi hazırlanan mesaj şablonunu, indirim kodunu veya hatırlatma metnini inceler ve onaylar." : "Marketing manager reviews and approves the replenishment copy, dynamic discount code, and send schedule.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--act">4. @(tr ? "Pika Uygular & Ölçer" : "Pika Acts & Measures")</div>
                        <h5>Zamanlanmış İletişim ve Satış Etkisi</h5>
                        <p>@(tr ? "WhatsApp veya SMS ile kişiye özel hatırlatma gönderilir. Sipariş tamamlandığında sepet tutarı ve dönüşüm raporlanır." : "Personalized notification is triggered via WhatsApp/SMS. Conversion rate and basket value are tracked in real-time.")</p>
                    </div>
                </div>

                <div class="uc-scenario-footer">
                    <span class="small text-muted">@(tr ? "İlgili Çözümler:" : "Related Solutions:")</span>
                    <a href="@(tr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")" class="uc-tag-link">Product Intelligence</a>
                    <a href="@(tr ? "/platform/firsatlar" : "/en/platform/opportunities")" class="uc-tag-link">@(tr ? "Günün Fırsatları" : "Daily Opportunities")</a>
                    <a href="/wiki/gunun-firsatlari-ve-karar-motoru" class="uc-tag-link uc-tag-wiki"><i class="ri-book-2-line me-1"></i>Wiki Kılavuzu</a>
                </div>
            </div>

            <!-- SCENARIO 2 -->
            <div class="uc-scenario-card">
                <div class="uc-scenario-header">
                    <div class="uc-q-tag">@(tr ? "İŞ SORUSU 02" : "BUSINESS QUESTION 02")</div>
                    <h2 class="uc-scenario-q">@(tr ? "“Değerli müşterilerimden hangileri pasifleşiyor?”" : "“Which high-value customers are drifting into churn?”")</h2>
                </div>

                <div class="uc-flow-grid">
                    <div class="uc-flow-col">
                        <div class="uc-step-badge">1. @(tr ? "Pika Anlar" : "Pika Understands")</div>
                        <h5>Customer Intelligence &amp; RFM Sapması</h5>
                        <p>@(tr ? "Müşterinin geçmiş harcama düzeyini (Monetary) ve son siparişinden bu yana geçen süreyi (Recency) analiz ederek alışılmış aralığın açıldığını fark eder." : "Analyzes customer historical monetary value and recency gap to identify deviations from normal purchasing rhythms.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--opp">2. @(tr ? "Pika Bulur" : "Pika Finds")</div>
                        <h5>Risk Sinyali &amp; Geri Kazanım Fırsatı</h5>
                        <p>@(tr ? "Eski sadık müşteriler 'Pasifleşme Riski' altında listelenir ve kayıp yaşanmadan önce müdahale fırsatı oluşturulur." : "Surfaces at-risk loyal accounts in the opportunity feed before customer relationships lapse entirely.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--ctrl">3. @(tr ? "Yönetici Kontrolü" : "Manager Controls")</div>
                        <h5>Geri Kazanım Kurgusu &amp; Segment Seçimi</h5>
                        <p>@(tr ? "Yönetici, bu kitleye özel 'Seni Özledik' teklifi ve uygun iletişim kanalını (Email veya WhatsApp) belirler." : "Manager selects tailored win-back incentives and chooses optimal channel delivery.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--act">4. @(tr ? "Pika Uygular & Ölçer" : "Pika Acts & Measures")</div>
                        <h5>Otomatik Akış &amp; Geri Dönüş Raporu</h5>
                        <p>@(tr ? "Kampanya başlatılır; geri dönen müşterilerin tekrar aktifleşme oranı ve kazandırılan ciro ölçülür." : "Outreach triggers; reactivation rate and recovered customer revenue are clearly measured.")</p>
                    </div>
                </div>

                <div class="uc-scenario-footer">
                    <span class="small text-muted">@(tr ? "İlgili Çözümler:" : "Related Solutions:")</span>
                    <a href="@(tr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")" class="uc-tag-link">Customer Intelligence</a>
                    <a href="@(tr ? "/cozumler/audience-manager" : "/en/solutions/audience-manager")" class="uc-tag-link">Audience Manager</a>
                    <a href="/wiki/customer-intelligence-nedir" class="uc-tag-link uc-tag-wiki"><i class="ri-book-2-line me-1"></i>Wiki Kılavuzu</a>
                </div>
            </div>

            <!-- SCENARIO 3 -->
            <div class="uc-scenario-card">
                <div class="uc-scenario-header">
                    <div class="uc-q-tag">@(tr ? "İŞ SORUSU 03" : "BUSINESS QUESTION 03")</div>
                    <h2 class="uc-scenario-q">@(tr ? "“Bir ürünü alan müşteriye tamamlayıcı olarak ne önerebilirim?”" : "“What complementary product should I recommend?”")</h2>
                </div>

                <div class="uc-flow-grid">
                    <div class="uc-flow-col">
                        <div class="uc-step-badge">1. @(tr ? "Pika Anlar" : "Pika Understands")</div>
                        <h5>Product Roles &amp; Sepet Birlikteliği</h5>
                        <p>@(tr ? "Katalogdaki ürünlerin Need Group ilişkilerini ve geçmiş sepetlerde hangi ürünlerin birlikte alındığını haritalandırır." : "Maps Need Group product hierarchies and co-purchase affinities from transaction history.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--opp">2. @(tr ? "Pika Bulur" : "Pika Finds")</div>
                        <h5>Çapraz Satış (Cross-sell) Önerisi</h5>
                        <p>@(tr ? "Ana ürünü satın alan fakat tamamlayıcı aksesuar/yedek ürünü almayan müşteriler için çapraz satış fırsatı oluşturur." : "Generates cross-sell opportunities for buyers who have not yet added recommended companion items.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--ctrl">3. @(tr ? "Yönetici Kontrolü" : "Manager Controls")</div>
                        <h5>Journey Kuralı ve Şablon Belirleme</h5>
                        <p>@(tr ? "Sipariş teslimatından 3 gün sonra tetiklenecek öneri e-postasını veya WhatsApp şablonunu yönetici seçer." : "Manager configures a post-delivery 3-day delay rule with dynamic product recommendation content.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--act">4. @(tr ? "Pika Uygular & Ölçer" : "Pika Acts & Measures")</div>
                        <h5>Tetikleyici Gönderim ve Ek Sepet Cirosu</h5>
                        <p>@(tr ? "Müşteriye tam zamanında öneri iletilir; tamamlayıcı ürün siparişleri ve ortalama sepet büyümesi ölçümlenir." : "Automated trigger fires; incremental add-on orders and average order value (AOV) growth are tracked.")</p>
                    </div>
                </div>

                <div class="uc-scenario-footer">
                    <span class="small text-muted">@(tr ? "İlgili Çözümler:" : "Related Solutions:")</span>
                    <a href="@(tr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")" class="uc-tag-link">Product Intelligence</a>
                    <a href="@(tr ? "/cozumler/journey-manager" : "/en/solutions/journey-manager")" class="uc-tag-link">Journey Manager</a>
                    <a href="/wiki/product-intelligence-nedir" class="uc-tag-link uc-tag-wiki"><i class="ri-book-2-line me-1"></i>Wiki Kılavuzu</a>
                </div>
            </div>

            <!-- SCENARIO 4 -->
            <div class="uc-scenario-card">
                <div class="uc-scenario-header">
                    <div class="uc-q-tag">@(tr ? "İŞ SORUSU 04" : "BUSINESS QUESTION 04")</div>
                    <h2 class="uc-scenario-q">@(tr ? "“Tek seferlik kampanyayı otomatik müşteri akışına nasıl dönüştürürüm?”" : "“How do I convert one-off campaigns into automated journeys?”")</h2>
                </div>

                <div class="uc-flow-grid">
                    <div class="uc-flow-col">
                        <div class="uc-step-badge">1. @(tr ? "Pika Anlar" : "Pika Understands")</div>
                        <h5>Müşteri Olayları ve Etkileşimler</h5>
                        <p>@(tr ? "Kayıt olma, ilk sipariş verme, sepet terk etme gibi olayları (events) anlık olarak dinler." : "Listens to customer lifecycle triggers including sign-ups, first purchases, and abandoned carts in real-time.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--opp">2. @(tr ? "Pika Bulur" : "Pika Finds")</div>
                        <h5>Otomasyon Fırsatı &amp; Dallanma Noktaları</h5>
                        <p>@(tr ? "Müşterinin mesajı açıp açmamasına veya 24 saat içinde işlem yapıp yapmamasına göre yol ayrımı sunar." : "Defines conditional decision branches based on email opens, link clicks, or purchase actions within 24h.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--ctrl">3. @(tr ? "Yönetici Kontrolü" : "Manager Controls")</div>
                        <h5>Journey Kurulumu ve Gecikme Ayarları</h5>
                        <p>@(tr ? "Yönetici akışı görsel editörde adımlar (bekleme süreleri, kanal tercihleri, mesaj içerikleri) halinde tasarlar." : "Manager visualizes and customizes multi-step workflow logic, delay nodes, and channel rules.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--act">4. @(tr ? "Pika Uygular & Ölçer" : "Pika Acts & Measures")</div>
                        <h5>Sürekli Çalışan Akış &amp; Adım Analitiği</h5>
                        <p>@(tr ? "Journey 7/24 kesintisiz çalışır; her adımda düşen veya aksiyon alan kullanıcı sayıları canlı izlenir." : "Journey executes continuously; drop-offs, conversions, and node-level throughput are audited.")</p>
                    </div>
                </div>

                <div class="uc-scenario-footer">
                    <span class="small text-muted">@(tr ? "İlgili Çözümler:" : "Related Solutions:")</span>
                    <a href="@(tr ? "/cozumler/journey-manager" : "/en/solutions/journey-manager")" class="uc-tag-link">Journey Manager</a>
                    <a href="@(tr ? "/cozumler/campaign-manager" : "/en/solutions/campaign-manager")" class="uc-tag-link">Campaign Manager</a>
                    <a href="/wiki/kampanya-journey-orkestrasyonu" class="uc-tag-link uc-tag-wiki"><i class="ri-book-2-line me-1"></i>Wiki Kılavuzu</a>
                </div>
            </div>

            <!-- SCENARIO 5 -->
            <div class="uc-scenario-card">
                <div class="uc-scenario-header">
                    <div class="uc-q-tag">@(tr ? "İŞ SORUSU 05" : "BUSINESS QUESTION 05")</div>
                    <h2 class="uc-scenario-q">@(tr ? "“Hangi müşteriye hangi kanaldan ulaşmalıyım?”" : "“Which channel should I use to reach each customer?”")</h2>
                </div>

                <div class="uc-flow-grid">
                    <div class="uc-flow-col">
                        <div class="uc-step-badge">1. @(tr ? "Pika Anlar" : "Pika Understands")</div>
                        <h5>İzin (IYS/KVKK) ve Tercih Durumu</h5>
                        <p>@(tr ? "Müşterinin E-posta, SMS, WhatsApp ve Push kanallarındaki güncel ticari izinlerini ve ret (opt-out) geçmişini sorgular." : "Audits verified commercial consent records (IYS/KVKK) and opt-out history across SMS, WhatsApp, and Email.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--opp">2. @(tr ? "Pika Bulur" : "Pika Finds")</div>
                        <h5>Kanal Uygunluk Doğrulaması</h5>
                        <p>@(tr ? "İzni olmayan veya ret bildiriminde bulunmuş kanalları otomatik eleyerek yalnızca yasal ve uygun kanalları işaretler." : "Automatically filters out unconsented or opted-out destinations to guarantee 100% compliant delivery.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--ctrl">3. @(tr ? "Yönetici Kontrolü" : "Manager Controls")</div>
                        <h5>Kanal Öncelik Sıralaması</h5>
                        <p>@(tr ? "Yönetici birincil ve ikincil kanal kurallarını belirler (ör. önce WhatsApp, ulaşılamazsa SMS)." : "Manager sets fallback rules (e.g., attempt WhatsApp first; fallback to SMS if delivery fails).")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--act">4. @(tr ? "Pika Uygular & Ölçer" : "Pika Acts & Measures")</div>
                        <h5>Güvenli Gönderim ve Teslimat Raporu</h5>
                        <p>@(tr ? "Mesajlar onaylı kanallardan gönderilir; iletim raporları ve opt-out hareketleri anında sisteme işlenir." : "Messages dispatch through verified gateways; delivery receipts and opt-out events update instantly.")</p>
                    </div>
                </div>

                <div class="uc-scenario-footer">
                    <span class="small text-muted">@(tr ? "İlgili Çözümler:" : "Related Solutions:")</span>
                    <a href="@(tr ? "/cozumler/consent-management" : "/en/solutions/consent-management")" class="uc-tag-link">Consent Management</a>
                    <a href="@(tr ? "/guvenlik-ve-gizlilik" : "/en/security-and-privacy")" class="uc-tag-link">@(tr ? "Güvenlik & Gizlilik" : "Security & Privacy")</a>
                    <a href="/wiki/izin-optout-iys" class="uc-tag-link uc-tag-wiki"><i class="ri-book-2-line me-1"></i>Wiki Kılavuzu</a>
                </div>
            </div>

            <!-- SCENARIO 6 -->
            <div class="uc-scenario-card">
                <div class="uc-scenario-header">
                    <div class="uc-q-tag">@(tr ? "İŞ SORUSU 06" : "BUSINESS QUESTION 06")</div>
                    <h2 class="uc-scenario-q">@(tr ? "“Kampanya performansını ve satış etkisini nasıl takip ederim?”" : "“How do I evaluate campaign performance and revenue impact?”")</h2>
                </div>

                <div class="uc-flow-grid">
                    <div class="uc-flow-col">
                        <div class="uc-step-badge">1. @(tr ? "Pika Anlar" : "Pika Understands")</div>
                        <h5>Uçtan Uca Etkileşim ve Sipariş Verisi</h5>
                        <p>@(tr ? "Gönderilen mesajların iletim, açılma ve tıklama hareketleri ile ardından gelen siparişleri ilişkilendirir." : "Connects send logs, open/click interactions, and subsequent store or web purchases.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--opp">2. @(tr ? "Pika Bulur" : "Pika Finds")</div>
                        <h5>Net Gelir ve Sepet Katkısı</h5>
                        <p>@(tr ? "Hangi fırsat türünün (tekrar satın alma vs çapraz satış) işletmeye ne kadar ek ciro sağladığını hesaplar." : "Attributes incremental revenue and basket lift across opportunity types and specific campaigns.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--ctrl">3. @(tr ? "Yönetici Kontrolü" : "Manager Controls")</div>
                        <h5>Özelleştirilebilir Rapor Görünümleri</h5>
                        <p>@(tr ? "Yönetici kampanya, kanal, mağaza veya ürün kategorisi bazında detaylı analizleri filtreler ve dışa aktarır." : "Manager filters multidimensional reports by campaign, channel, retail store, or product line.")</p>
                    </div>

                    <div class="uc-flow-col">
                        <div class="uc-step-badge uc-step-badge--act">4. @(tr ? "Pika Uygular & Ölçer" : "Pika Acts & Measures")</div>
                        <h5>Analytics &amp; Karar İyileştirme</h5>
                        <p>@(tr ? "Elde edilen sonuçlar bir sonraki kampanya ve fırsat planlaması için güvenilir içgörüler sunar." : "Clear analytics provide verified baseline metrics for continuous optimization of marketing strategy.")</p>
                    </div>
                </div>

                <div class="uc-scenario-footer">
                    <span class="small text-muted">@(tr ? "İlgili Çözümler:" : "Related Solutions:")</span>
                    <a href="@(tr ? "/cozumler/analytics-reporting" : "/en/solutions/analytics-reporting")" class="uc-tag-link">Analytics &amp; Reporting</a>
                    <a href="@(tr ? "/platform/pika-360" : "/en/platform/pika-360")" class="uc-tag-link">Pika 360</a>
                    <a href="/wiki/raporlama-ve-analitik" class="uc-tag-link uc-tag-wiki"><i class="ri-book-2-line me-1"></i>Wiki Kılavuzu</a>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ═══════════════════════════ BOTTOM CTA ═══════════════════════════ -->
<section class="uc-cta-section">
    <div class="container">
        <div class="uc-cta-box text-center p-5 rounded-4 bg-light border">
            <h3 class="mb-3">@(tr ? "Kendi İş Senaryonuzu Pika'da Deneyimleyin" : "Test Your Own Business Scenario in Pika")</h3>
            <p class="text-muted mx-auto mb-4" style="max-width:600px">
                @(tr 
                    ? "İşletmenizin satış dinamiklerine uygun senaryoları canlı demo ortamında uzman ekibimizle birlikte kuralım." 
                    : "Work with our solution engineers to map and configure your unique business scenarios in a live demo.")
            </p>
            <div class="d-flex justify-content-center gap-3">
                <button type="button" class="btn pika-btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#demoModal">
                    @(tr ? "Demo Talep Edin" : "Request a Demo") <i class="ri-arrow-right-line ms-1"></i>
                </button>
                <a href="/wiki/" class="btn pika-btn-ghost px-4 py-2">
                    @(tr ? "Pika Bilgi Bankası (Wiki)" : "Pika Knowledge Base (Wiki)")
                </a>
            </div>
        </div>
    </div>
</section>

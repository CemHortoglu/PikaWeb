@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]="Analytics | "+(tr?"Ölçüm ve Raporlama":"Measurement & Reporting"); ViewData["MetaDescription"]=tr?"Müşteri, ürün, kanal, Campaign ve Journey sonuçlarını desteklenen BI ve attribution bağlamıyla değerlendirin; ilişkilendirmeyi nedensellikle karıştırmayın.":"Review customer, product, channel, Campaign and Journey outcomes with supported BI and attribution context without confusing association with causation."; ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">Platform · Analytics</span><h1>@(tr?"Aksiyondan sonra ne olduğunu aynı karar diliyle okuyun.":"Read what happened after action in the same decision language.")</h1><p>@(tr?"Pika Analytics ve BI; satış, müşteri, ürün, kampanya ve kanal sonuçlarını desteklenen metriklerle birlikte değerlendirir. Amaç daha fazla grafik değil, kararın sonucunu kanıtın izin verdiği ölçüde anlamaktır.":"Pika Analytics and BI bring supported sales, customer, product, campaign and channel metrics together. The goal is not more charts, but understanding outcomes as far as the evidence allows.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/bi-kokpit">@(tr?"BI Dokümantasyonu":"BI Documentation")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_bi-kokpit_5.png" alt="Pika BI kokpit" width="1200" height="760" /><figcaption>@(tr?"Satış, müşteri ve desteklenen analitik sonuçlarını karar odaklı özetleyin.":"Summarize sales, customer and supported analytical outcomes for decision-making.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-columns"><div class="pk-feature"><h3>@(tr?"Müşteri ve satış":"Customer & sales")</h3><p>@(tr?"Gerçekleşmiş satış, müşteri ve belge bağlamını seçilen dönem ve desteklenen kırılımlarla okuyun.":"Review observed sales, customer and document context across supported periods and dimensions.")</p></div><div class="pk-feature"><h3>@(tr?"Ürün ve kategori":"Product & category")</h3><p>@(tr?"Ciro, adet, belge, müşteri ve sınıflandırma kapsamı gibi desteklenen ürün/kategori metriklerini değerlendirin.":"Review supported product/category metrics such as revenue, quantity, documents, customers and classification coverage.")</p></div><div class="pk-feature"><h3>@(tr?"Campaign / Journey / kanal":"Campaign / Journey / channel")</h3><p>@(tr?"Gönderim, engagement ve desteklenen satış ilişkilendirmelerini aynı şeymiş gibi değil, ayrı sonuç katmanları olarak okuyun.":"Treat delivery, engagement and supported sales attribution as distinct outcome layers.")</p></div></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">Attribution ≠ Causation</span><h2>@(tr?"İlişkilendirme, tek başına neden-sonuç kanıtı değildir.":"Attribution alone is not proof of causation.")</h2></div><p class="pk-lead">@(tr?"Bir kampanya gönderimi ile sonraki satın alma arasında tanımlı pencere içinde ilişki kurulabilir. Bu bilgi operasyonel ve ticari değerlendirme için yararlıdır; ancak ölçülmemiş nedensellik iddiasına dönüştürülmemelidir.":"A campaign send and later purchase can be associated within a defined window. This is useful for operational and commercial review, but should not be overstated as unmeasured causal proof.")</p></div></section>
<section class="pk-section"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">@(tr?"Karar döngüsünü kapatın":"Close the decision loop")</span><h2>@(tr?"Veri → karar → aksiyon → sonuç.":"Data → decision → action → outcome.")</h2></div><div><p class="pk-lead">@(tr?"Analytics, Pika'nın başlangıç noktası değil son katmanlarından biridir. Sonuçlar müşteriyi ve ürünü yeniden anlamaya yardımcı olacak kanıt üretir; AI bu kanıtı açıklarken ölçülmemiş sonuçlar eklememelidir.":"Analytics is one of the final layers in Pika's flow, not the starting point. Outcomes provide evidence that can inform future understanding, while AI should not add conclusions the evidence does not support.")</p><a class="pk-btn pk-btn-ghost" href="@(tr?"/pika":"/en/pika")">@(tr?"Pika'nın Çalışma Modeli":"How Pika Works")</a></div></div></section>

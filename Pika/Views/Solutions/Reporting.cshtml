@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]="Analytics | "+(tr?"Ölçüm ve Raporlama":"Measurement & Reporting");
    ViewData["MetaDescription"]=tr?"Pika Analytics ile müşteri, ürün, satış, Campaign, Journey ve kanal sonuçlarını desteklenen BI ve attribution bağlamıyla birlikte değerlendirin; ilişkilendirmeyi nedensellikle karıştırmayın.":"Use Pika Analytics to review customer, product, sales, Campaign, Journey and channel outcomes with supported BI and attribution context without confusing association with causation.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">Platform · Analytics</span><h1>@(tr?"Aksiyondan sonra ne olduğunu aynı karar diliyle okuyun.":"Read what happened after action in the same decision language.")</h1><p>@(tr?"Pika Analytics ve BI; satış, müşteri, ürün, Campaign, Journey ve kanal sonuçlarını desteklenen metriklerle birlikte değerlendirir. Amaç daha fazla grafik üretmek değil; hangi kararın ardından ne olduğunu, kanıtın izin verdiği ölçüde anlaşılır hale getirmektir.":"Pika Analytics and BI bring supported sales, customer, product, Campaign, Journey and channel metrics together. The goal is not more charts, but making outcomes understandable as far as the evidence allows.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Analytics'i Canlı Görün":"See Analytics Live")</button><a class="pk-btn pk-btn-ghost" href="/wiki/bi-kokpit">@(tr?"BI dokümantasyonu":"BI documentation")</a></div><div class="pk-hero-note"><i class="ri-scales-3-line"></i><span>@(tr?"Attribution ilişki kurabilir; tek başına nedenselliği kanıtlamaz." : "Attribution can establish association; it does not by itself prove causality.")</span></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_bi-kokpit_5.png" alt="@(tr?"Pika BI ve Analytics kokpit ekranı":"Pika BI and Analytics cockpit")" width="1200" height="760" /><div class="pk-stage-caption"><strong>Analytics</strong><span>@(tr?"Satış · Müşteri · Ürün · Kampanya · Kanal":"Sales · Customer · Product · Campaign · Channel")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-bar-chart-box-line"></i><div><strong>@(tr?"Gerçek sonuç":"Observed result")</strong><small>@(tr?"Gönderim ve etkileşim":"Delivery and engagement")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-links-line"></i><div><strong>Attribution</strong><small>@(tr?"İlişkilendirme bağlamı":"Association context")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Tanım":"Definition")</span><h2>@(tr?"Pika Analytics nedir?":"What is Pika Analytics?")</h2></div><p class="pk-lead">@(tr?"Pika Analytics; Pika'nın müşteri ve ürün zekâsından çıkan aksiyonların ve işletme verisinin desteklenen ölçüm katmanlarını bir arada değerlendiren raporlama/BI alanıdır. Gerçekleşmiş satış ve etkileşim verisini görünür kılar; ölçülmemiş başarı veya nedensellik iddiası üretmemelidir.":"Pika Analytics is the reporting and BI layer used to review supported measurement dimensions across business data and actions arising from customer/product intelligence. It surfaces observed sales and engagement without inventing unmeasured success or causal claims.")</p></div><div class="pk-intel-grid"><article class="pk-intel-panel"><span class="pk-intel-number">01</span><div class="pk-intel-icon"><i class="ri-user-3-line"></i></div><h3>@(tr?"Müşteri ve satış":"Customer and sales")</h3><p>@(tr?"Gerçekleşmiş satış, müşteri, sipariş/fatura ve dönem bağlamını desteklenen kırılımlarda okuyun. Metriklerin dayandığı veri kapsamını sonucu yorumlarken göz önünde bulundurun." : "Review observed sales, customer, order/invoice and period context across supported dimensions, keeping data coverage in mind when interpreting metrics.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">02</span><div class="pk-intel-icon"><i class="ri-shopping-bag-3-line"></i></div><h3>@(tr?"Ürün ve kategori":"Product and category")</h3><p>@(tr?"Ciro, adet, belge, müşteri ve desteklenen ürün/kategori kırılımlarını Product Intelligence bağlamıyla birlikte değerlendirin." : "Review revenue, quantity, document, customer and supported product/category dimensions alongside Product Intelligence context.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">03</span><div class="pk-intel-icon"><i class="ri-megaphone-line"></i></div><h3>Campaign · Journey · Channel</h3><p>@(tr?"Gönderim, açılma/tıklama gibi desteklenen engagement sonuçlarını ve uygun olduğunda satış ilişkilendirmesini ayrı sonuç katmanları olarak okuyun." : "Review delivery, supported engagement such as opens/clicks, and sales attribution where available as distinct outcome layers.")</p></article></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Tek bir dashboard değil":"More than one dashboard")</span><h2>@(tr?"İş sorusuna göre doğru ölçüm bağlamını seçin.":"Choose the right measurement context for the business question.")</h2></div><p class="pk-lead">@(tr?"'Satış ne oldu?', 'hangi müşteri grubu değişti?', 'hangi ürün/kategori büyüyor?', 'kampanya nasıl performans gösterdi?' ve 'hangi kanal daha çok etkileşim aldı?' aynı sorular değildir. Analytics bunları tek toplam skorla gizlemek yerine uygun metrik aileleriyle ayırmalıdır.":"Sales performance, customer change, product/category growth, campaign performance and channel engagement are different questions. Analytics should keep them distinguishable rather than hiding everything behind one universal score.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_bi-kokpit_5.png" alt="@(tr?"Pika BI kokpit ekranı":"Pika BI cockpit")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>BI Cockpit</small><h3>@(tr?"Genel resmi karar odaklı özetleyin":"Summarize the big picture for decision-making")</h3><p>@(tr?"Satış ve müşteri sonuçlarını desteklenen dönem/kırılım bağlamıyla birlikte okuyun." : "Read sales and customer outcomes across supported periods and dimensions.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_gonderim-operasyonu-izleme_28.png" alt="@(tr?"Pika gönderim ve sonuç izleme ekranı":"Pika delivery and outcome monitoring")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Gönderim ve sonuç":"Delivery and outcome")</small><h3>@(tr?"Aksiyonun operasyonel sonucunu ayrı görün":"Keep operational outcomes distinct")</h3><p>@(tr?"Kampanya veya Journey başarı değerlendirmesinde gönderim durumu ile satış sonucunu aynı metrikmiş gibi ele almayın." : "Do not treat delivery status and sales outcomes as the same metric when reviewing Campaign or Journey performance.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">Attribution ≠ Causation</span><h2>@(tr?"İlişkilendirme, tek başına neden-sonuç kanıtı değildir.":"Attribution alone is not proof of causation.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Bir kampanya veya iletişim ile sonraki satın alma arasında tanımlı bir pencere içinde ilişki kurulabilir. Bu, ticari değerlendirme için yararlı bir attribution bilgisidir. Fakat müşterinin o satın almayı yalnızca kampanya nedeniyle yaptığını göstermek için deney/kontrol tasarımı gibi ek kanıt gerekir.":"A campaign or communication can be associated with a later purchase within a defined window. That is useful attribution context. Demonstrating that the purchase happened because of the campaign requires additional evidence such as an appropriate experiment or control design.")</p></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-mail-check-line"></i><div><strong>@(tr?"Gönderim":"Delivery")</strong><span>@(tr?"Mesajın ilgili sağlayıcı/kanal akışında ne durumda olduğunu anlatır." : "Describes the message status in the relevant provider/channel flow.")</span></div></div><div class="pk-control-step"><i class="ri-cursor-line"></i><div><strong>Engagement</strong><span>@(tr?"Kanalın desteklediği açılma, tıklama veya benzeri etkileşim olayları." : "Opens, clicks or other engagement events supported by the channel.")</span></div></div><div class="pk-control-step"><i class="ri-links-line"></i><div><strong>Attribution</strong><span>@(tr?"Tanımlı pencere içinde iletişim ile sonraki ticari davranışı ilişkilendirme." : "Associating communication with later commercial behavior within a defined window.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-flask-line"></i><div><strong>@(tr?"Nedensellik":"Causality")</strong><span>@(tr?"Attribution'dan farklıdır; uygun deney/kontrol tasarımı olmadan otomatik olarak varsayılmaz." : "Different from attribution; it is not automatically assumed without appropriate experimental/control design.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Karar döngüsünü kapatın":"Close the decision loop")</span><h2>@(tr?"Veri → karar → aksiyon → sonuç → yeni kanıt.":"Data → decision → action → outcome → new evidence.")</h2></div><p class="pk-lead">@(tr?"Analytics, Pika'nın başlangıç noktası değil son katmanlarından biridir. Sonuçlar daha sonraki müşteri/ürün kararlarında kullanılabilecek yeni kanıt üretir. Bu, modelin her kampanyadan otomatik olarak kendi kendine öğrendiği anlamına gelmez; model tabanlı öğrenme varsa ayrıca tanımlanmalıdır.":"Analytics is one of Pika's later layers, not the starting point. Outcomes produce new evidence that can inform later customer/product decisions. This does not imply that a model automatically self-learns from every campaign; model-based learning must be explicitly implemented and described when present.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-database-2-line"></i><strong>@(tr?"Veri":"Data")</strong><span>@(tr?"Gerçekleşmiş müşteri ve satış bağlamı":"Observed customer and sales context")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-radar-line"></i><strong>Intelligence</strong><span>@(tr?"Müşteri ve ürün sinyalleri":"Customer and product signals")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Fırsat":"Opportunity")</strong><span>@(tr?"Aksiyon adayı":"Candidate for action")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-route-line"></i><strong>@(tr?"Aksiyon":"Action")</strong><span>Campaign · Journey · Channel</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-bar-chart-box-line"></i><strong>@(tr?"Sonuç":"Outcome")</strong><span>@(tr?"Gönderim · Etkileşim · Satış bağlamı":"Delivery · Engagement · Sales context")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-loop-right-line"></i><strong>@(tr?"Yeni kanıt":"New evidence")</strong><span>@(tr?"Sonraki kararları besleyen gözlem":"Observation informing later decisions")</span></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Hangi soruyu cevaplar?":"Which questions can it answer?")</span><h2>@(tr?"Grafikten önce soruyu doğru kurun.":"Define the question before choosing the chart.")</h2></div><p class="pk-lead">@(tr?"Pika Analytics'in değeri her şeyi tek ekrana sıkıştırmak değil, farklı iş sorularını aynı veri diliyle tutarlı biçimde yanıtlayabilmektir." : "Pika Analytics is valuable not because everything fits one screen, but because different business questions can be answered consistently from the same data language.")</p></div><div class="pk-columns"><div class="pk-feature"><i class="ri-line-chart-line"></i><h3>@(tr?"Satış ve müşteri":"Sales and customer")</h3><p>@(tr?"Seçili dönemde gerçekleşmiş satış ve müşteri hareketini desteklenen kırılımlarla değerlendirin." : "Review observed sales and customer movement across supported dimensions.")</p></div><div class="pk-feature"><i class="ri-shopping-bag-line"></i><h3>@(tr?"Ürün ve kategori":"Product and category")</h3><p>@(tr?"Hangi ürün ve kategorilerin ticari hareket yarattığını, veri eşleştirme kapsamını göz önünde bulundurarak okuyun." : "Read which products and categories drive commercial movement while considering resolution coverage.")</p></div><div class="pk-feature"><i class="ri-megaphone-line"></i><h3>@(tr?"Campaign ve Journey":"Campaign and Journey")</h3><p>@(tr?"Yürütme ve etkileşim sonuçlarını desteklenen ölçüm/attribution bağlamında karşılaştırın." : "Compare execution and engagement outcomes within supported measurement and attribution context.")</p></div></div><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/pika":"/en/pika")">@(tr?"Pika'nın çalışma modelini görün":"See how Pika works")</a><a class="pk-btn pk-btn-ghost" href="/wiki/kampanya-performansi-ve-olcumleme">@(tr?"Ölçüm rehberini okuyun":"Read measurement guide")</a></div></div></section>

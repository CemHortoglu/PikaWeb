                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between flex-wrap gap-3 pt-2">
                <a href="@(tr ? "/cozumler/campaign-manager" : "/en/solutions/campaign-manager")" class="small fw-bold" style="color:var(--pika-primary)">
                    @(tr ? "Campaign Manager →" : "Campaign Manager →")
                </a>
                <a href="@(tr ? "/cozumler/journey-manager" : "/en/solutions/journey-manager")" class="small fw-bold" style="color:var(--pika-primary)">
                    @(tr ? "Journey Manager →" : "Journey Manager →")

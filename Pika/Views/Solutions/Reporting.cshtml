@{
    var tr = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = tr ? "Analytics & Reporting | Pika ile Kampanya Performansını Ölçün" : "Analytics & Reporting | Measure Campaign Performance with Pika";
    ViewData["MetaDescription"] = tr ? "Pika Analytics & Reporting ile kampanya, kanal, segment ve journey sonuçlarını izleyin. Performansı görünür hale getirin ve daha doğru kararlar alın." : "Monitor campaign, channel, segment and journey results with Pika Analytics & Reporting. Make performance visible and make better decisions.";
    ViewData["MetaKeywords"] = "analytics,reporting,kampanya performansı,kanal raporlama,segment analizi,journey analiz,pika";
}

<!-- HERO: Executive Dashboard -->
<section class="pika-sol-hero" data-module="analytics">
    <div class="container">
        <nav class="pika-sol-breadcrumb" data-aos="fade-down" data-aos-duration="500">
            <a href="@(tr ? "/" : "/en/")">@(tr ? "Ana Sayfa" : "Home")</a>
            <span class="sep">/</span>
            <a href="@(tr ? "/" : "/en/")">@(tr ? "Çözümler" : "Solutions")</a>
            <span class="sep">/</span>
            <span>Analytics &amp; Reporting</span>
        </nav>
        <div class="pika-sol-hero-grid">
            <div data-aos="fade-right" data-aos-duration="700">
                <h1>Analytics &amp; Reporting — @(tr ? "Kampanya performansını görünür hale getirin" : "Make campaign performance visible")</h1>
                <p class="pika-sol-hero-desc">@(tr ? "Pika Analytics & Reporting; çok kanallı kampanya sonuçlarını, segment performansını ve journey etkisini tek merkezde ölçerek ekiplerin daha doğru kararlar almasını sağlar." : "Pika Analytics & Reporting enables teams to make better decisions by measuring multi-channel campaign results, segment performance and journey impact in one place.")</p>
                <div class="pika-sol-hero-actions">
                    <button type="button" class="btn pika-btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i></button>
                    <a href="#features" class="btn pika-btn-ghost px-4 py-2">@(tr ? "Analytics'i İncele" : "Explore Analytics")</a>
                </div>
                <div class="pika-sol-hero-tags">
                    <span class="pika-sol-tag"><i class="ri-bar-chart-grouped-line"></i> @(tr ? "Kanal raporlama" : "Channel reporting")</span>
                    <span class="pika-sol-tag"><i class="ri-focus-3-line"></i> @(tr ? "Segment performansı" : "Segment performance")</span>
                    <span class="pika-sol-tag"><i class="ri-route-line"></i> @(tr ? "Journey görünürlüğü" : "Journey visibility")</span>
                    <span class="pika-sol-tag"><i class="ri-dashboard-line"></i> @(tr ? "Merkezi ölçüm" : "Centralized measurement")</span>
                </div>
            </div>
            <div class="pika-sol-hero-scene" data-aos="fade-left" data-aos-duration="700" data-aos-delay="200">
                <div class="pika-sol-scene-main">
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block wide"><i class="ri-line-chart-line"></i> @(tr ? "Dashboard" : "Dashboard")</div>
                        <div class="pika-sol-scene-block"><i class="ri-bar-chart-2-line"></i> KPI</div>
                    </div>
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block"><i class="ri-pie-chart-line"></i> @(tr ? "Kanal" : "Channel")</div>
                        <div class="pika-sol-scene-block"><i class="ri-group-line"></i> @(tr ? "Segment" : "Segment")</div>
                    </div>
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block wide"><i class="ri-route-line"></i> @(tr ? "Journey Etkisi" : "Journey Impact")</div>
                    </div>
                </div>
                <div class="pika-sol-scene-back">
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block"><i class="ri-funds-line"></i> Trend</div>
                        <div class="pika-sol-scene-block"><i class="ri-percent-line"></i> Rate</div>
                    </div>
                </div>
                <div class="pika-sol-scene-float" style="bottom:15%;left:-10%"><i class="ri-bar-chart-2-line"></i> %96.4 @(tr ? "iletim" : "delivery")</div>
                <div class="pika-sol-scene-float" style="top:8%;right:-6%"><i class="ri-line-chart-line"></i> +12% @(tr ? "artış" : "increase")</div>
                <div class="pika-sol-scene-float" style="bottom:3%;right:10%"><i class="ri-pie-chart-line"></i> 4 @(tr ? "kanal" : "channels")</div>
            </div>
        </div>
    </div>
</section>

<!-- STICKY SUBNAV -->
<div class="pika-sol-subnav-wrap">
    <div class="container">
        <nav class="pika-sol-subnav">
            <a href="#metrics">@(tr ? "Metrikler" : "Metrics")</a>
            <a href="#features">@(tr ? "Özellikler" : "Features")</a>
            <a href="#dashboard">@(tr ? "Dashboard" : "Dashboard")</a>
            <a href="#usecases">@(tr ? "Kullanım Senaryoları" : "Use Cases")</a>
            <a href="#platform">@(tr ? "Entegrasyon" : "Integration")</a>
            <a href="#faq">SSS / FAQ</a>
        </nav>
    </div>
</div>

<!-- METRICS (light pills) -->
<section class="pika-sol-section pika-sol-channel-strip" id="metrics">
    <div class="container">
        <h2 class="pika-sol-section-title text-center" data-aos="fade-up">@(tr ? "Ölçüm boyutları" : "Measurement dimensions")</h2>
        <div class="pika-sol-channel-pills" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-channel-pill"><i class="ri-megaphone-line"></i> @(tr ? "Kampanya" : "Campaign")</div>
            <div class="pika-sol-channel-pill"><i class="ri-signal-tower-line"></i> @(tr ? "Kanal" : "Channel")</div>
            <div class="pika-sol-channel-pill"><i class="ri-group-line"></i> @(tr ? "Segment" : "Segment")</div>
            <div class="pika-sol-channel-pill"><i class="ri-route-line"></i> Journey</div>
        </div>
    </div>
</section>

<!-- TRUST STRIP -->
<section class="pika-sol-section">
    <div class="container">
        <div class="pika-sol-trust-strip" data-aos="fade-up">
            <div class="pika-sol-trust-item"><i class="ri-dashboard-line"></i><span>@(tr ? "Merkezi dashboard" : "Central dashboard")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-bar-chart-grouped-line"></i><span>@(tr ? "Kanal karşılaştırma" : "Channel comparison")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-line-chart-line"></i><span>@(tr ? "Trend analizi" : "Trend analysis")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-download-2-line"></i><span>@(tr ? "Rapor dışa aktarma" : "Report export")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-timer-line"></i><span>@(tr ? "Anlık veri" : "Real-time data")</span></div>
        </div>
    </div>
</section>

<!-- SHOWCASE: Dashboard -->
<section class="pika-sol-section pika-sol-section-alt" id="dashboard">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Performans dashboard'u" : "Performance dashboard")</h2>
        <div class="pika-sol-showcase" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-showcase-screen">
                <div class="pika-sol-showcase-panel">
                    <div class="pika-sol-showcase-panel-title"><i class="ri-line-chart-line"></i> @(tr ? "Kampanya Performansı" : "Campaign Performance")</div>
                    <div class="pika-sol-showcase-mock-bar w80"></div>
                    <div class="pika-sol-showcase-mock-bar w60"></div>
                    <div class="pika-sol-showcase-mock-bar w70"></div>
                    <div class="pika-sol-showcase-mock-bar w45"></div>
                </div>
                <div class="pika-sol-showcase-panel">
                    <div class="pika-sol-showcase-panel-title"><i class="ri-pie-chart-line"></i> @(tr ? "Kanal Dağılımı" : "Channel Distribution")</div>
                    <div class="pika-sol-showcase-mock-bar w70"></div>
                    <div class="pika-sol-showcase-mock-bar w80"></div>
                    <div class="pika-sol-showcase-mock-bar w60"></div>
                </div>
            </div>
            <div class="pika-sol-showcase-annotations">
                <div class="pika-sol-annotation"><i class="ri-bar-chart-2-line"></i> @(tr ? "İletim oranı" : "Delivery rate")</div>
                <div class="pika-sol-annotation"><i class="ri-eye-line"></i> @(tr ? "Açılma oranı" : "Open rate")</div>
                <div class="pika-sol-annotation"><i class="ri-cursor-line"></i> @(tr ? "Tıklama oranı" : "Click rate")</div>
                <div class="pika-sol-annotation"><i class="ri-funds-line"></i> @(tr ? "Trend karşılaştırma" : "Trend comparison")</div>
                <div class="pika-sol-annotation"><i class="ri-download-2-line"></i> @(tr ? "Rapor dışa aktar" : "Export report")</div>
            </div>
        </div>
    </div>
</section>

<!-- CORE CAPABILITIES -->
<section class="pika-sol-section" id="features">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Raporlama için temel yetenekler" : "Core capabilities for reporting")</h2>
        <div class="pika-sol-card-grid">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-bar-chart-grouped-line"></i></div>
                <h4>@(tr ? "Kanal bazlı performans" : "Channel-based performance")</h4>
                <p>@(tr ? "SMS, WhatsApp, Email ve Push sonuçlarını ayrı ayrı ölçün." : "Measure SMS, WhatsApp, Email and Push results separately.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-megaphone-line"></i></div>
                <h4>@(tr ? "Kampanya performansı" : "Campaign performance")</h4>
                <p>@(tr ? "Her kampanyanın iletim, açılma ve tıklama oranlarını izleyin." : "Monitor delivery, open and click rates of each campaign.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-group-line"></i></div>
                <h4>@(tr ? "Segment analizi" : "Segment analysis")</h4>
                <p>@(tr ? "Hangi segmentin en iyi performans gösterdiğini belirleyin." : "Determine which segment performs best.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-route-line"></i></div>
                <h4>@(tr ? "Journey performansı" : "Journey performance")</h4>
                <p>@(tr ? "Otomatik akışların her adımını ölçün." : "Measure each step of automated flows.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-funds-line"></i></div>
                <h4>@(tr ? "Trend ve karşılaştırma" : "Trends & comparison")</h4>
                <p>@(tr ? "Dönemsel karşılaştırmalarla trendleri izleyin." : "Track trends with periodic comparisons.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-download-2-line"></i></div>
                <h4>@(tr ? "Rapor dışa aktarma" : "Report export")</h4>
                <p>@(tr ? "Raporları dışa aktararak paylaşın ve arşivleyin." : "Export, share and archive reports.")</p>
            </div>
        </div>
    </div>
</section>

<!-- USE CASES -->
<section class="pika-sol-section pika-sol-section-alt" id="usecases">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Analytics & Reporting ile neler yapabilirsiniz?" : "What can you do with Analytics & Reporting?")</h2>
        <div class="pika-sol-usecase-cards">
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="50">
                <div class="pika-sol-usecase-card-icon"><i class="ri-dashboard-line"></i></div>
                <span class="usecase-industry">@(tr ? "Yönetim" : "Management")</span>
                <h5>@(tr ? "Yönetici Dashboard'u" : "Executive Dashboard")</h5>
                <p>@(tr ? "Tüm kampanya performansını tek ekranda görüntüleyin." : "View all campaign performance on a single screen.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-usecase-card-icon"><i class="ri-bar-chart-grouped-line"></i></div>
                <span class="usecase-industry">@(tr ? "Pazarlama" : "Marketing")</span>
                <h5>@(tr ? "Kanal Karşılaştırma" : "Channel Comparison")</h5>
                <p>@(tr ? "Hangi kanalın en etkili olduğunu belirleyin." : "Determine which channel is most effective.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="150">
                <div class="pika-sol-usecase-card-icon"><i class="ri-group-line"></i></div>
                <span class="usecase-industry">@(tr ? "CRM" : "CRM")</span>
                <h5>@(tr ? "Segment Performans Analizi" : "Segment Performance Analysis")</h5>
                <p>@(tr ? "Segment bazlı dönüşüm ve etkileşim ölçümü." : "Segment-based conversion and engagement measurement.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-usecase-card-icon"><i class="ri-route-line"></i></div>
                <span class="usecase-industry">@(tr ? "Otomasyon" : "Automation")</span>
                <h5>@(tr ? "Journey Etki Ölçümü" : "Journey Impact Measurement")</h5>
                <p>@(tr ? "Otomatik akışların her adımının etkisini ölçün." : "Measure the impact of each automated flow step.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="250">
                <div class="pika-sol-usecase-card-icon"><i class="ri-funds-line"></i></div>
                <span class="usecase-industry">@(tr ? "Strateji" : "Strategy")</span>
                <h5>@(tr ? "Dönemsel Trend Analizi" : "Periodic Trend Analysis")</h5>
                <p>@(tr ? "Haftalık ve aylık performans trendlerini karşılaştırın." : "Compare weekly and monthly performance trends.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-usecase-card-icon"><i class="ri-download-2-line"></i></div>
                <span class="usecase-industry">@(tr ? "Kurumsal" : "Enterprise")</span>
                <h5>@(tr ? "Rapor Paylaşımı" : "Report Sharing")</h5>
                <p>@(tr ? "Raporları dışa aktararak ekip ve yönetimle paylaşın." : "Export and share reports with team and management.")</p>
            </div>
        </div>
    </div>
</section>

<!-- BUSINESS IMPACT -->
<section class="pika-sol-section pika-sol-section-impact">
    <div class="container">
        <h2 class="pika-sol-section-title text-center" data-aos="fade-up">@(tr ? "İş etkisi" : "Business Impact")</h2>
        <div class="pika-sol-impact-grid pika-sol-impact-grid--light" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-impact-card pika-sol-impact-card--light">
                <div class="pika-sol-impact-icon"><i class="ri-eye-line"></i></div>
                <h5>@(tr ? "Performans görünürlüğü sağlar" : "Provides performance visibility")</h5>
                <p>@(tr ? "Tüm kampanya sonuçlarını tek merkezde görün." : "View all campaign results in one place.")</p>
            </div>
            <div class="pika-sol-impact-card pika-sol-impact-card--light">
                <div class="pika-sol-impact-icon"><i class="ri-lightbulb-line"></i></div>
                <h5>@(tr ? "Karar kalitesini artırır" : "Improves decision quality")</h5>
                <p>@(tr ? "Veriye dayalı stratejik kararlar alın." : "Make data-driven strategic decisions.")</p>
            </div>
            <div class="pika-sol-impact-card pika-sol-impact-card--light">
                <div class="pika-sol-impact-icon"><i class="ri-loop-left-line"></i></div>
                <h5>@(tr ? "Optimizasyonu hızlandırır" : "Accelerates optimization")</h5>
                <p>@(tr ? "Anlık verilerle kampanyaları optimize edin." : "Optimize campaigns with real-time data.")</p>
            </div>
        </div>
    </div>
</section>

<!-- PLATFORM MAP -->
<section class="pika-sol-section" id="platform">
    <div class="container">
        <h2 class="pika-sol-section-title text-center" data-aos="fade-up">@(tr ? "Analytics, Pika platformunda nasıl konumlanır?" : "How does Analytics fit in the Pika platform?")</h2>
        <div class="pika-sol-platform-map" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-platform-satellites">
                <a class="pika-sol-platform-node" href="@Url.Action("CampaignManager", "Solutions")"><i class="ri-megaphone-line"></i> Campaign Manager</a>
                <a class="pika-sol-platform-node" href="@Url.Action("JourneyManager", "Solutions")"><i class="ri-route-line"></i> Journey Manager</a>
                <a class="pika-sol-platform-node" href="@Url.Action("AudienceManager", "Solutions")"><i class="ri-focus-3-line"></i> Audience Manager</a>
            </div>
            <div class="pika-sol-platform-connector"></div>
            <div class="pika-sol-platform-center"><i class="ri-bar-chart-box-line"></i> Analytics</div>
            <div class="pika-sol-platform-connector"></div>
            <div class="pika-sol-platform-satellites">
                <a class="pika-sol-platform-node" href="@Url.Action("ContentStudio", "Solutions")"><i class="ri-edit-line"></i> Content Studio</a>
            </div>
        </div>
    </div>
</section>

<!-- FAQ -->
<section class="pika-sol-section pika-sol-section-alt" id="faq">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Analytics & Reporting hakkında sık sorulan sorular" : "Analytics & Reporting FAQs")</h2>
        <div class="accordion faq-pro-accordion" id="reportingFaq">
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#reportingFaq1" aria-expanded="true" aria-controls="reportingFaq1">@(tr ? "Hangi metrikler ölçülür?" : "Which metrics are measured?")</button></h2>
                <div id="reportingFaq1" class="accordion-collapse collapse show" data-bs-parent="#reportingFaq"><div class="accordion-body">@(tr ? "İletim oranı, açılma oranı, tıklama oranı, dönüşüm ve segment bazlı performans gibi metrikler ölçülür." : "Metrics such as delivery rate, open rate, click rate, conversion and segment-based performance are measured.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#reportingFaq2" aria-expanded="false" aria-controls="reportingFaq2">@(tr ? "Kanal bazlı raporlama mümkün mü?" : "Is channel-based reporting possible?")</button></h2>
                <div id="reportingFaq2" class="accordion-collapse collapse" data-bs-parent="#reportingFaq"><div class="accordion-body">@(tr ? "Evet. SMS, WhatsApp, Email ve Push kanallarının performansını ayrı ayrı veya karşılaştırmalı izleyebilirsiniz." : "Yes. You can monitor SMS, WhatsApp, Email and Push channel performance separately or comparatively.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#reportingFaq3" aria-expanded="false" aria-controls="reportingFaq3">@(tr ? "Journey performansı ölçülebilir mi?" : "Can journey performance be measured?")</button></h2>
                <div id="reportingFaq3" class="accordion-collapse collapse" data-bs-parent="#reportingFaq"><div class="accordion-body">@(tr ? "Evet. Otomatik akışların her adımının performansını detaylı olarak izleyebilirsiniz." : "Yes. You can monitor each step's performance in automated flows in detail.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#reportingFaq4" aria-expanded="false" aria-controls="reportingFaq4">@(tr ? "Raporlar dışa aktarılabilir mi?" : "Can reports be exported?")</button></h2>
                <div id="reportingFaq4" class="accordion-collapse collapse" data-bs-parent="#reportingFaq"><div class="accordion-body">@(tr ? "Evet. Raporlarınızı dışa aktararak paylaşabilir ve arşivleyebilirsiniz." : "Yes. You can export, share and archive your reports.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#reportingFaq5" aria-expanded="false" aria-controls="reportingFaq5">@(tr ? "Dönemsel karşılaştırma yapılabilir mi?" : "Can periodic comparisons be made?")</button></h2>
                <div id="reportingFaq5" class="accordion-collapse collapse" data-bs-parent="#reportingFaq"><div class="accordion-body">@(tr ? "Evet. Haftalık, aylık ve özel tarih aralıklarında performans karşılaştırması yapabilirsiniz." : "Yes. You can compare performance across weekly, monthly and custom date ranges.")</div></div>
            </div>
        </div>
    </div>
</section>

<!-- RELATED -->
<section class="pika-sol-section">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Birlikte en çok kullanılan modüller" : "Most commonly used together")</h2>
        <div class="pika-sol-related" data-aos="fade-up" data-aos-delay="100">
            <a class="pika-sol-related-card" href="@Url.Action("CampaignManager", "Solutions")">
                <div class="pika-sol-related-icon"><i class="ri-megaphone-line"></i></div>
                <div><h5>Campaign Manager</h5><p>@(tr ? "Kampanya performansını ölçün." : "Measure campaign performance.")</p></div>
            </a>
            <a class="pika-sol-related-card" href="@Url.Action("JourneyManager", "Solutions")">
                <div class="pika-sol-related-icon"><i class="ri-route-line"></i></div>
                <div><h5>Journey Manager</h5><p>@(tr ? "Akış etkisini izleyin." : "Monitor flow impact.")</p></div>
            </a>

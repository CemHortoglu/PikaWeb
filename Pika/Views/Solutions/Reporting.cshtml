                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-3 h-100" style="background:#f4f8ec;border:1px solid #c8deb0">
                        <small class="fw-bold text-uppercase d-block mb-1" style="color:#688151;letter-spacing:1px">
                            Journey Manager:
                        </small>
                        <div class="small fw-bold" style="color:#23413b">
                            @(tr ? "“Hangi sıra ve koşullarla ilerleyelim?”" : "“Through which sequence and conditions should the flow progress?”")
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-3 h-100" style="background:#f4f8ec;border:1px solid #c8deb0">
                        <small class="fw-bold text-uppercase d-block mb-1" style="color:#688151;letter-spacing:1px">
                            Analytics &amp; Reporting:
                        </small>
                        <div class="small fw-bold" style="color:var(--pika-primary)">
                            @(tr ? "“Uygulanan aksiyondan sonra ne oldu?”" : "“What happened after the action was executed?”")

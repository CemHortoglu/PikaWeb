@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-platform-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-reporting-page.css" asp-append-version="true" />
}

@* ── 01 HERO ─────────────────────────────────────────────────── *@
<section class="inner-hero inner-hero--report">
    <div class="inner-hero-grid-overlay" aria-hidden="true"></div>
    <div class="inner-hero-orbit" aria-hidden="true"></div>
    <div class="inner-hero-grid-overlay" aria-hidden="true"></div>
    <div class="inner-hero-orbit" aria-hidden="true"></div>
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span>/</span>
                <span>Analytics &amp; Reporting</span>
            </nav>
            <div class="inner-eyebrow"><span></span>ANALYTICS &amp; REPORTING</div>
            @if (tr)
            {
                <h1>
                    Gönderimin ötesini görün.<br />
                    Kampanya sonucunu bağlamıyla ölçün.
                </h1>
                <p>
                    Pika Analytics &amp; Reporting; kampanya, kanal, hedef kitle, teslimat ve etkileşim sonuçlarını aynı ölçüm bağlamında değerlendirmenize, ilişkilendirilebilen satış veya ciro sonuçlarını attribution kuralları içinde incelemenize yardımcı olur.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.78);font-size:14px;line-height:1.6;margin-bottom:30px">
                    Amaç yalnızca kaç mesaj gönderildiğini görmek değil; hangi kampanya, kanal ve kitle bağlamında ne olduğunu ölçülebilir sonuçlarla değerlendirmektir.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Demo Talep Et ↗
                    </button>
                    <a class="inner-secondary" href="/cozumler/campaign-manager">
                        Campaign Manager'ı Keşfedin →
                    </a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="İçeriğe atla">
                        <i class="ri-arrow-down-line" aria-hidden="true"></i>
                    </a>
                </div>
            }
            else
            {
                <h1>
                    See beyond delivery.<br />
                    Measure campaign outcomes in context.
                </h1>
                <p>
                    Pika Analytics &amp; Reporting helps evaluate campaign, channel, audience, delivery and engagement results within the same measurement context, together with sales or revenue outcomes that can be associated under attribution rules.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.78);font-size:14px;line-height:1.6;margin-bottom:30px">
                    The objective is not only to see how many messages were sent, but to evaluate what happened across campaign, channel and audience context through measurable outcomes.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Request a Demo ↗
                    </button>
                    <a class="inner-secondary" href="/en/solutions/campaign-manager">
                        Explore Campaign Manager →
                    </a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="Skip to content">
                        <i class="ri-arrow-down-line" aria-hidden="true"></i>
                    </a>
                </div>
            }
        </div>
<div class="inner-scene reporting-chart-scene"><div class="pw2-telemetry-stage measurement-report"><div class="report-heading"><div><span class="studio-kicker">PIKA ANALYTICS</span><h3>@(tr ? "İletişimden alışverişe" : "From communication to purchase")</h3></div><small>@(tr ? "Örnek rapor · 30 gün" : "Sample report · 30 days")</small></div><div class="report-summary"><div><small>@(tr ? "İlişkilendirilen ciro" : "Attributed revenue")</small><strong>₺84.250</strong></div><span>@(tr ? "Temaslarla ilişkili siparişler" : "Orders associated with touchpoints")</span></div>
 <div class="report-chart" role="img" aria-label="@(tr ? "Örnek ilişkilendirilen ciro grafiği, gün 1 ile gün 30 arası. Gerçek müşteri sonucu değildir." : "Sample attributed revenue chart for days 1 to 30. Not an actual customer result.")"><div class="chart-scale"><span>30k</span><span>20k</span><span>10k</span><span>0</span></div><svg viewBox="0 0 600 200" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="measurementFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#829e45" stop-opacity=".3"/><stop offset="100%" stop-color="#829e45" stop-opacity="0"/></linearGradient></defs><path d="M0 20H600 M0 75H600 M0 130H600 M0 185H600" stroke="#e3e8dc" stroke-width="1"/><path d="M0 164 C35 164 45 124 80 132 S135 170 170 118 S220 150 265 96 S320 125 355 78 S425 112 465 52 S550 82 600 25 V200 H0Z" fill="url(#measurementFill)"/><path d="M0 164 C35 164 45 124 80 132 S135 170 170 118 S220 150 265 96 S320 125 355 78 S425 112 465 52 S550 82 600 25" fill="none" stroke="#68863c" stroke-width="3"/></svg><div class="chart-days"><span>01</span><span>10</span><span>20</span><span>30</span></div></div>
 <div class="report-channels"><div><span class="channel-dot"></span>WhatsApp<strong>₺42.100</strong></div><div><span class="channel-dot dot-email"></span>E-mail<strong>₺28.750</strong></div><div><span class="channel-dot dot-sms"></span>SMS<strong>₺13.400</strong></div></div><p class="report-note">@(tr ? "Gösterim amaçlı veriler. İlişkilendirme, satışın yalnızca kampanyadan kaynaklandığını göstermez." : "Illustrative data. Attribution does not establish that a campaign alone caused a sale.")</p></div></div></div></section>

<div class="inner-trust-ribbon">
    <div class="container">
        <div class="inner-trust-ribbon__items">
            <div class="inner-trust-ribbon__item">
                <i class="ri-whatsapp-line" aria-hidden="true"></i>
                <div>
                    <strong>WhatsApp Business API</strong>
                    <span>@(tr ? "Resmi Meta API" : "Official Meta API")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-mail-send-line" aria-hidden="true"></i>
                <div>
                    <strong>Email &amp; SMS</strong>
                    <span>@(tr ? "Doğrulanmış Kanallar" : "Verified Channels")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-focus-3-line" aria-hidden="true"></i>
                <div>
                    <strong>Pika Opportunity Engine</strong>
                    <span>@(tr ? "Günlük Algoritmik Tespit" : "Daily Discovery")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-shield-check-line" aria-hidden="true"></i>
                <div>
                    <strong>İYS &amp; KVKK</strong>
                    <span>@(tr ? "İzin Denetimi" : "Consent Verification")</span>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="inner-content" class="inner-anchor"></div>

@* ── STICKY SUBNAV ───────────────────────────────────────────── *@
<div class="pika-sol-subnav-wrap">
    <div class="container">
        <nav class="pika-sol-subnav" aria-label="@(tr ? "Sayfa içi gezinti" : "In-page navigation")">
            <a href="#overview">@(tr ? "Genel Bakış" : "Overview")</a>
            <a href="#measurement">@(tr ? "Ölçüm" : "Measurement")</a>
            <a href="#channels">@(tr ? "Kanallar" : "Channels")</a>
            <a href="#audiences">@(tr ? "Kitleler" : "Audiences")</a>
            <a href="#attribution">@(tr ? "Atıf" : "Attribution")</a>
            <a href="#platform">@(tr ? "Platform İlişkisi" : "Platform Relationships")</a>
            <a href="#faq">@(tr ? "SSS" : "FAQ")</a>
        </nav>
    </div>
</div>

@* ── TRUST STRIP ─────────────────────────────────────────────── *@
<section class="pika-sol-section">
    <div class="container">
        <div class="pika-sol-trust-strip" data-aos="fade-up">
            <div class="pika-sol-trust-item"><i class="ri-megaphone-line"></i><span>@(tr ? "Kampanya Sonuçları" : "Campaign Results")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-mail-check-line"></i><span>@(tr ? "Teslimat Telemetrisi" : "Delivery Telemetry")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-bar-chart-grouped-line"></i><span>@(tr ? "Kanal Karşılaştırma" : "Channel Comparison")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-group-line"></i><span>@(tr ? "Kitle / Segment Bağlamı" : "Audience / Segment Context")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-line-chart-line"></i><span>@(tr ? "Ciro Atfı" : "Revenue Attribution")</span></div>
        </div>
    </div>
</section>

@* ── 02 DIRECT ANSWER ────────────────────────────────────────── *@
<section class="ph-section ph-section-alt" id="overview">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Analytics & Reporting nedir?" : "What is Analytics & Reporting?")
            </h2>
            <p class="lead ph-muted" style="line-height:1.65">
                @(tr ? "Analytics & Reporting, Pika'da kampanya ve iletişim icrasından sonra oluşan teslimat, etkileşim, kanal, hedef kitle ve ilişkilendirilebilir ticari sonuçları değerlendirmek için kullanılan ölçüm ve raporlama katmanıdır." : "Analytics & Reporting is Pika's measurement and reporting layer for evaluating delivery, engagement, channel, audience and attributable commercial outcomes produced after campaign and communication execution.")
            </p>
        </div>

        <div class="p-4 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Campaign Manager ve Journey Manager aksiyonu yürütür." : "Campaign Manager and Journey Manager manage action.")
            </p>
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Email, SMS ve WhatsApp iletişim kanalları gönderim sonuçlarını oluşturur." : "Email, SMS and WhatsApp produce delivery outcomes.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Analytics & Reporting ise bu sonuçları ölçüm bağlamında bir araya getirir." : "Analytics & Reporting brings those outcomes together within measurement context.")
            </p>

            <p class="mb-2 ph-muted" style="line-height:1.65">
                @(tr ? "Analytics & Reporting'in temel sorusu şudur:" : "Analytics & Reporting answers one central question:")
            </p>
            <div class="p-4 rounded-3 text-center my-4" style="background:#f4f8ec;border:1px solid #c8deb0">
                <div class="h3 fw-bold" style="color:var(--pika-primary);letter-spacing:-0.5px">
                    @(tr ? "“Ne oldu ve bu sonuç hangi kampanya bağlamında oluştu?”" : "“What happened, and within which campaign context did this result occur?”")
                </div>
            </div>

            <p class="mb-2 ph-muted" style="line-height:1.65">
                @(tr ? "Bu katman yeni bir ticari fırsat oluşturmaz veya kampanya başlatmaz." : "This layer does not create a new commercial opportunity or launch a campaign.")
            </p>
            <p class="mb-0 fw-bold" style="color:#23413b;line-height:1.65">
                @(tr ? "Gerçekleşen sonuçların değerlendirilmesine yardımcı olur." : "It helps evaluate outcomes that have already occurred.")
            </p>
        </div>
    </div>
</section>

@* ── PAGE ART ─────────────────────────────────────────────────── *@
<figure class="pika-page-art">
    <img src="~/images/pages/Pika/measurement-and-learning.png" asp-append-version="true" loading="lazy" decoding="async" width="1536" height="1024"
         alt="@(tr ? "Pika Analytics & Reporting — kampanya ölçümü ve öğrenme döngüsü" : "Pika Analytics & Reporting — campaign measurement and learning loop")" />
    <figcaption>@(tr ? "Kavramsal gösterim; değerler ve arayüz örnek amaçlıdır." : "Conceptual illustration; values and interface are illustrative.")</figcaption>
</figure>

@* ── 03 FROM SEND COUNTS TO DECISION CONTEXT ──────────────────── *@
<section class="ph-section ph-section-plain">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "SAYIDAN BAĞLAMA" : "FROM COUNT TO CONTEXT")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Gönderim sayısı, tek başına kampanya performansı değildir." : "Send volume alone is not campaign performance.")
            </h2>
        </div>

        <div class="p-4 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Bir kampanyada kaç ileti gönderildiğini bilmek operasyonel bir başlangıç noktasıdır." : "Knowing how many communications were sent is an operational starting point.")
            </p>
            <p class="mb-3 ph-muted" style="line-height:1.65">
                @(tr ? "Ancak gönderim sayısı tek başına kampanyanın nasıl sonuçlandığını açıklamaz." : "But send volume alone does not explain how the campaign performed.")
            </p>
            <p class="mb-3 ph-muted" style="line-height:1.65">
                @(tr ? "Teslimat sonucu, etkileşim, kanal yapısı, hedef kitle ve kampanyayla ilişkilendirilebilen ticari sonuçlar birlikte değerlendirildiğinde daha anlamlı bir performans bağlamı oluşur." : "A more meaningful performance context emerges when delivery outcomes, engagement, channel structure, audience and commercial results that can be associated with the campaign are evaluated together.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Aynı toplam gönderim sayısı, farklı kanallarda veya farklı kitlelerde farklı sonuç bağlamları üretebilir." : "The same total send volume can produce different outcome contexts across different channels or audiences.")
            </p>

            <div class="p-4 rounded-3 text-center my-4" style="background:#f4f8ec;border:1px solid #c8deb0">
                <div class="small fw-bold text-uppercase mb-2" style="color:#688151;letter-spacing:1px">
                    @(tr ? "Sadece:" : "Not only:")
                </div>
                <div class="fs-5 fw-bold mb-2 text-decoration-line-through text-muted">
                    @(tr ? "“Kaç mesaj gönderdik?”" : "“How many messages did we send?”")
                </div>
                <div class="small fw-bold text-uppercase mb-2" style="color:#688151;letter-spacing:1px">
                    @(tr ? "Aynı zamanda:" : "But also:")
                </div>
                <div class="h4 fw-bold mb-0" style="color:var(--pika-primary)">
                    @(tr ? "“Ne oldu, hangi bağlamda oldu ve neyle ilişkilendirilebiliyor?”" : "“What happened, in which context, and what can it be associated with?”")
                </div>
            </div>

            <p class="mb-0 text-center fw-bold" style="color:#23413b;line-height:1.65">
                @(tr ? "Analytics & Reporting, gönderim kaydını karar bağlamına taşır." : "Analytics & Reporting turns delivery records into decision context.")
            </p>
        </div>
    </div>
</section>

@* ── 04 WHAT CAN BE MEASURED ─────────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="measurement">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "ÖLÇÜM BOYUTLARI" : "MEASUREMENT DIMENSIONS")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Sonucu, tek bir metriğe indirgemeyin." : "Do not reduce the outcome to a single metric.")
            </h2>
            <p class="ph-muted mx-auto" style="max-width:760px;line-height:1.65">
                @(tr ? "Analytics & Reporting farklı ölçüm boyutlarını aynı değerlendirme çerçevesinde bir araya getirir." : "Analytics & Reporting brings different measurement dimensions into the same evaluation framework.")
            </p>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="50">
                <div class="ph-trust-card h-100 p-4">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-megaphone-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Kampanya" : "Campaign")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Tanımlı kampanyanın gönderim ve etkileşim sonuçlarını kampanya bağlamında değerlendirin." : "Evaluate delivery and engagement outcomes of a defined campaign within campaign context.")
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="ph-trust-card h-100 p-4">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-signal-tower-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Kanal" : "Channel")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Email, SMS ve WhatsApp gibi doğrulanmış iletişim kanallarındaki uygun sonuçları kanal bağlamında inceleyin." : "Review appropriate outcomes across confirmed communication channels such as Email, SMS and WhatsApp within channel context.")
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="150">
                <div class="ph-trust-card h-100 p-4">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-group-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Hedef Kitle / Segment" : "Audience / Segment")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Kampanya sonucunu yalnız toplam seviyede değil, kullanılan hedef kitle veya segment bağlamıyla birlikte değerlendirin." : "Evaluate campaign outcomes not only at total level, but also together with the audience or segment context used.")
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                <div class="ph-trust-card h-100 p-4">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-mail-check-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Teslimat" : "Delivery")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Gönderim sonucuna ilişkin mevcut delivery telemetrisini kampanya değerlendirmesinin bir parçası olarak kullanın." : "Use available delivery telemetry as part of campaign evaluation.")
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="250">
                <div class="ph-trust-card h-100 p-4">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-cursor-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Etkileşim" : "Engagement")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Kanalın desteklediği uygun etkileşim sinyallerini kampanya sonucuyla birlikte değerlendirin." : "Evaluate relevant engagement signals supported by the channel together with campaign outcomes.")
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
                <div class="ph-trust-card h-100 p-4">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-line-chart-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Atıf" : "Attribution")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Tanımlı attribution yaklaşımı içinde kampanyayla ilişkilendirilebilen satış veya ciro sonuçlarını inceleyin." : "Review sales or revenue outcomes that can be associated with the campaign under a defined attribution approach.")
                    </p>
                </div>
            </div>
        </div>

        @* ── CONCEPTUAL MEASUREMENT MAP (SHOWCASE) ─────────────── *@
        <div class="pika-sol-showcase p-4 p-md-5 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
            <div class="text-center mb-4">
                <div class="small fw-bold text-uppercase" style="color:#688151;letter-spacing:1px">
                    @(tr ? "KAVRAMSAL ÖLÇÜM HARİTASI" : "CONCEPTUAL MEASUREMENT MAP")
                </div>
                <h4 class="fw-bold mt-1 text-dark">
                    @(tr ? "Ölçüm boyutları bir arada değerlendirilir." : "Measurement dimensions evaluated together.")
                </h4>
            </div>

            <div class="report-map-grid" aria-hidden="true">
                <div class="report-map-card">
                    <i class="ri-megaphone-line"></i>
                    <strong>@(tr ? "KAMPANYA SONUÇLARI" : "CAMPAIGN RESULTS")</strong>
                </div>
                <div class="report-map-card">
                    <i class="ri-mail-check-line"></i>
                    <strong>@(tr ? "TESLİMAT" : "DELIVERY")</strong>
                </div>
                <div class="report-map-card">
                    <i class="ri-cursor-line"></i>
                    <strong>@(tr ? "ETKİLEŞİM" : "ENGAGEMENT")</strong>
                </div>
                <div class="report-map-card">
                    <i class="ri-signal-tower-line"></i>
                    <strong>@(tr ? "KANAL" : "CHANNEL")</strong>
                </div>
                <div class="report-map-card">
                    <i class="ri-group-line"></i>
                    <strong>@(tr ? "KİTLE / SEGMENT" : "AUDIENCE / SEGMENT")</strong>
                </div>
                <div class="report-map-card">
                    <i class="ri-line-chart-line"></i>
                    <strong>@(tr ? "ATIF" : "ATTRIBUTION")</strong>
                </div>
            </div>

            <p class="small ph-muted text-center mt-4 mb-0" style="line-height:1.6">
                @(tr ? "Her metrik her kanalda aynı anlama gelmez. Analytics & Reporting'in rolü ölçümü kanal ve kampanya bağlamıyla birlikte değerlendirmektir." : "Not every metric means the same thing on every channel. The role of Analytics & Reporting is to evaluate measurement together with channel and campaign context.")
            </p>
        </div>
    </div>
</section>

@* ── 05 DELIVERY TELEMETRY ───────────────────────────────────── *@
<section class="ph-section ph-section-plain">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "TESLİMAT TELEMETRİSİ" : "DELIVERY TELEMETRY")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "İletişimin gönderim sonucunu görün." : "See the outcome of communication delivery.")
            </h2>
        </div>

        <div class="p-4 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Kampanya değerlendirmesi mesajın hazırlanmasıyla veya gönderim kuyruğuna alınmasıyla bitmez." : "Campaign evaluation does not end when content is prepared or placed into the delivery process.")
            </p>
            <p class="mb-3 ph-muted" style="line-height:1.65">
                @(tr ? "Gönderim sürecinin sonucuna ilişkin mevcut telemetri de ölçümün bir parçasıdır." : "Available telemetry describing the result of delivery is also part of measurement.")
            </p>
            <p class="mb-3 ph-muted" style="line-height:1.65">
                @(tr ? "Kullanılabilir delivery verileri; gönderimin başarılı, başarısız veya ilgili kanal durumuyla sonuçlanmasına ilişkin operasyonel bağlam sağlayabilir." : "Available delivery data can provide operational context about successful, failed or other relevant channel outcomes.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Bu veriler kampanyanın içerik veya ticari etkisini tek başına göstermez. Ancak iletişim sürecinde ne olduğunu anlamak için temel ölçüm katmanlarından biridir." : "That data does not by itself explain content impact or commercial impact. But it is one of the foundational measurement layers for understanding what happened during communication execution.")
            </p>

            <div class="p-4 rounded-3 text-center my-4" style="background:#f4f8ec;border:1px solid #c8deb0">
                <div class="mb-2">
                    <span class="small fw-bold text-uppercase text-muted d-block mb-1">@(tr ? "Önemli ayrım:" : "Important distinction:")</span>
                    <strong style="color:var(--pika-primary);font-size:16px">
                        @(tr ? "Teslimat: “İletişim sürecinde ne oldu?” sorusuna yardımcı olur." : "Delivery helps answer: “What happened in the communication process?”")
                    </strong>
                </div>
                <div class="text-muted small">
                    @(tr ? "Teslimat: “Müşteri neden satın aldı?” sorusunun cevabı değildir." : "It does not answer: “Why did the customer purchase?”")
                </div>
            </div>

            <p class="mb-2 text-center" style="color:#23413b;line-height:1.65">
                @(tr ? "Önce gönderim sonucunu doğru okuyun." : "Read delivery outcomes first.")
            </p>
            <p class="mb-0 text-center fw-bold" style="color:#23413b;line-height:1.65">
                @(tr ? "Sonra etkileşim ve ticari sonuçlarla birlikte değerlendirin." : "Then evaluate them together with engagement and commercial outcomes.")
            </p>
        </div>
    </div>
</section>

@* ── 06 ENGAGEMENT CONTEXT ───────────────────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "ETKİLEŞİM" : "ENGAGEMENT")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Teslim edildi mi? Peki sonra ne oldu?" : "Was it delivered? What happened next?")
            </h2>
        </div>

        <div class="p-4 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Teslimat iletişimin teknik sonucunu gösterir; müşterinin iletişimle nasıl etkileştiğine ilişkin sinyaller ise ayrı bir değerlendirme katmanıdır." : "Delivery describes the technical outcome of communication; signals about how the customer interacted with that communication form a separate evaluation layer.")
            </p>
            <p class="mb-3 ph-muted" style="line-height:1.65">
                @(tr ? "Email gibi kanallarda açılma ve tıklama gibi uygun etkileşim verileri kampanya sonucunu yorumlamaya yardımcı olabilir." : "On channels such as Email, relevant engagement data such as opens and clicks can help interpret campaign outcomes.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Diğer kanalların sağladığı etkileşim ve durum sinyalleri kanal yapısına göre farklı olabilir." : "Interaction and status signals available on other channels can differ according to channel structure.")
            </p>

            <div class="p-4 rounded-3 text-center my-4" style="background:#f4f8ec;border:1px solid #c8deb0">
                <div class="small fw-bold text-uppercase mb-2" style="color:#688151;letter-spacing:1px">
                    @(tr ? "Etkileşim metriği:" : "Engagement metrics:")
                </div>
                <div class="h5 fw-bold mb-2" style="color:var(--pika-primary)">
                    @(tr ? "kanal bağlamında yorumlanır." : "are interpreted within channel context.")
                </div>
                <div class="small text-muted">
                    @(tr ? "Bütün kanallara: aynı open / click metriği zorla uygulanmaz." : "The same: open / click metric is not forced onto every channel.")
                </div>
            </div>

            <p class="mb-0 text-center fw-bold" style="color:#23413b;line-height:1.65">
                @(tr ? "Amaç farklı kanal telemetrisini tek bir sahte ortak KPI'a dönüştürmek değil, her sonucu kendi iletişim bağlamında değerlendirmektir." : "The objective is not to turn different channel telemetry into one artificial universal KPI, but to evaluate each result in its own communication context.")
            </p>
        </div>
    </div>
</section>

@* ── 07 CHANNEL COMPARISON ───────────────────────────────────── *@
<section class="ph-section ph-section-plain" id="channels">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "KANAL BAĞLAMI" : "CHANNEL CONTEXT")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Kanalları karşılaştırın. Ama farklı sinyalleri aynı şey sanmayın." : "Compare channels. Do not assume different signals mean the same thing.")
            </h2>
        </div>

        <div class="p-4 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Email, SMS ve WhatsApp aynı iletişim biçimine veya aynı telemetri yapısına sahip değildir." : "Email, SMS and WhatsApp do not share identical communication or telemetry structures.")
            </p>
            <p class="mb-3 ph-muted" style="line-height:1.65">
                @(tr ? "Analytics & Reporting kanal sonuçlarını karşılaştırmalı değerlendirmeye yardımcı olabilir; ancak karşılaştırmanın kullanılan metriklerin anlamını dikkate alması gerekir." : "Analytics & Reporting can help compare channel outcomes, but the comparison must respect what the underlying metrics actually mean.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Örneğin teslimat sonucu farklı kanallarda ortak bir operasyonel perspektif sağlayabilirken, etkileşim sinyalleri kanal yapısına göre değişebilir." : "For example, delivery outcomes may provide a shared operational perspective across channels, while engagement signals can differ by channel structure.")
            </p>

            <div class="p-4 rounded-3 text-center my-4" style="background:#f4f8ec;border:1px solid #c8deb0">
                <div class="small fw-bold text-uppercase mb-2" style="color:#688151;letter-spacing:1px">
                    @(tr ? "Kanal karşılaştırması:" : "Channel comparison supports:")
                </div>
                <div class="h5 fw-bold mb-2" style="color:var(--pika-primary)">
                    @(tr ? "“hangi sonuçlar oluştu?” sorusunu destekler." : "“What outcomes were observed?”")
                </div>
                <div class="small text-muted">
                    @(tr ? "Şunu otomatik olarak ilan etmez: “Bu kanal her durumda en iyidir.”" : "It does not automatically declare: “This channel is always the best.”")
                </div>
            </div>

            <p class="mb-0 text-center fw-bold" style="color:#23413b;line-height:1.65">
                @(tr ? "En iyi kanal diye evrensel bir sonuç üretmek yerine, kampanya bağlamında gözlenen sonuçları karşılaştırın." : "Instead of producing a universal “best channel,” compare observed results within campaign context.")
            </p>
        </div>
    </div>
</section>

@* ── 08 AUDIENCE & SEGMENT CONTEXT ───────────────────────────── *@
<section class="ph-section ph-section-alt" id="audiences">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "KİTLE BAĞLAMI" : "AUDIENCE CONTEXT")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Toplam sonucu değil, hangi kitle bağlamında oluştuğunu da görün." : "See not only the total outcome, but the audience context in which it occurred.")
            </h2>
        </div>

        <div class="p-4 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Bir kampanyanın toplam sonucu, farklı müşteri gruplarının aynı davranışı gösterdiği anlamına gelmez." : "The total outcome of a campaign does not mean every customer group behaved the same way.")
            </p>
            <p class="mb-3 ph-muted" style="line-height:1.65">
                @(tr ? "Analytics & Reporting kampanya sonucunu kullanılan audience veya segment bağlamıyla birlikte değerlendirmeye yardımcı olabilir." : "Analytics & Reporting can help evaluate campaign outcomes together with the audience or segment context used.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Bu karşılaştırma belirli bir segmentin gözlenen kampanya sonucunu görünür hale getirebilir." : "This comparison can make the observed campaign result for a particular segment visible.")
            </p>

            <div class="p-4 rounded-3 text-center my-4" style="background:#f4f8ec;border:1px solid #c8deb0">
                <div class="small fw-bold text-uppercase mb-2" style="color:#688151;letter-spacing:1px">
                    @(tr ? "Segment analizi:" : "Segment analysis:")
                </div>
                <div class="h5 fw-bold mb-2" style="color:var(--pika-primary)">
                    @(tr ? "gözlenen sonucu karşılaştırır." : "compares observed outcomes.")
                </div>
                <div class="small text-muted">
                    @(tr ? "Şunu garanti etmez: “Bu segment gelecekte her kampanyada en iyi performansı gösterecek.”" : "It does not guarantee: “This segment will perform best in every future campaign.”")
                </div>
            </div>

            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Audience Manager hedef kitleyi tanımlar." : "Audience Manager defines the audience.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Analytics & Reporting ise kullanılan kitle bağlamında oluşan sonucu değerlendirir." : "Analytics & Reporting evaluates the outcome produced within that audience context.")
            </p>

            <div class="text-end">
                <a href="@(tr ? "/cozumler/audience-manager" : "/en/solutions/audience-manager")" class="small fw-bold" style="color:var(--pika-primary)">
                    @(tr ? "Audience Manager'ı Keşfedin →" : "Explore Audience Manager →")
                </a>
            </div>
        </div>
    </div>
</section>

@* ── 09 CAMPAIGN & JOURNEY CONTEXT ───────────────────────────── *@

@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]="Push | "+(tr?"Pika Kanalları":"Pika Channels");
    ViewData["MetaDescription"]=tr?"Pika'da Push bildirimlerini desteklenen hedef kitle, izin ve Journey/Campaign bağlamında kullanın; gerçek zaman iddiasını doğrulanmış tetikleyicilerle sınırlayın ve sonucu ölçün.":"Use Push notifications in Pika within supported audience, consent and Journey/Campaign context, limiting real-time claims to verified triggers and measuring supported outcomes.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">@(tr?"Kanallar · Push":"Channels · Push")</span><h1>@(tr?"Push bildirimini doğru müşteri akışının bir adımı olarak kullanın.":"Use Push as a step in the right customer flow.")</h1><p>@(tr?"Push, Pika'nın desteklenen Campaign ve Journey senaryolarında kullanılabilen iletişim kanallarından biridir. Hedef kitle ve akış mantığı önce gelir; bildirim ancak müşteri için kanal kullanılabilir ve uygun olduğunda aksiyona dönüşür.":"Push is one of the communication channels available in supported Pika Campaign and Journey scenarios. Audience and flow logic come first; notification becomes an action only when the channel is available and eligible for the customer.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Push Akışını Canlı Görün":"See Push Flow Live")</button><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/journey-manager":"/en/platform/journey-manager")">Journey Manager</a></div><div class="pk-hero-note"><i class="ri-information-line"></i><span>@(tr?"Bu sayfa yalnız uygulamada doğrulanmış Push/Campaign/Journey kapsamını anlatır; desteklenmeyen cihaz veya event kabiliyeti varsaymaz." : "This page describes only verified Push/Campaign/Journey scope and does not assume unsupported device or event capabilities.")</span></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_journey-tasarim-tuvali_18.png" alt="@(tr?"Pika Journey içinde Push aksiyon bağlamı":"Pika Journey with Push action context")" width="1200" height="760" /><div class="pk-stage-caption"><strong>Push</strong><span>Trigger · Decision · Wait · Action</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-play-circle-line"></i><div><strong>Trigger</strong><small>@(tr?"Desteklenen olay/koşul":"Supported event/condition")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-notification-3-line"></i><div><strong>Push</strong><small>@(tr?"Uygun akış adımı":"Eligible flow step")</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-bar-chart-box-line"></i><div><strong>Analytics</strong><small>@(tr?"Desteklenen sonuç":"Supported outcome")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Push'ın Pika'daki rolü":"Push's role in Pika")</span><h2>@(tr?"Bildirim göndermek değil, doğru akış adımını çalıştırmak.":"The goal is not notification volume; it is the right flow step.")</h2></div><p class="pk-lead">@(tr?"Pika Push'ı müşteri karar zincirinden bağımsız bir bildirim motoru olarak konumlandırmaz. Campaign veya Journey içindeki iş amacı, hedef kitle, mevcut kanal kimliği/uygunluğu ve zamanlama Push aksiyonunun anlamlı olup olmadığını belirler.":"Pika does not position Push as a standalone notification engine. Campaign/Journey purpose, audience, available channel identity/eligibility and timing determine whether a Push action is meaningful.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-play-circle-line"></i><strong>Trigger</strong><span>@(tr?"Desteklenen olay veya koşul":"Supported event or condition")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-git-branch-line"></i><strong>Decision</strong><span>@(tr?"Müşteri ve kural bağlamı":"Customer and rule context")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-timer-line"></i><strong>Wait</strong><span>@(tr?"Zamanlama":"Timing")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-shield-check-line"></i><strong>@(tr?"Uygunluk":"Eligibility")</strong><span>@(tr?"Kanal kullanılabilir mi?":"Is the channel available?")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-notification-3-line"></i><strong>Push</strong><span>@(tr?"Uygunsa bildirim":"Notify if eligible")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>Measure</strong><span>@(tr?"Desteklenen sonucu değerlendir":"Review supported outcomes")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">Push + Journey</span><h2>@(tr?"Push'ı tek seferlik uyarıdan sürekli müşteri akışına bağlayın.":"Connect Push to an ongoing customer flow rather than treating it as an isolated alert.")</h2></div><p class="pk-lead">@(tr?"Journey'de Push, tetikleyici ve kararların ardından gelen aksiyonlardan biri olabilir. Müşterinin durumu değişirse, bekleme süresi dolmazsa veya kanal uygun değilse farklı bir yol izlenebilir. Bu yaklaşım kanal merkezli değil müşteri durumu merkezli otomasyon sağlar.":"In Journey, Push can be one of the actions after triggers and decisions. If customer context changes, a wait condition is not met or the channel is ineligible, a different path can be followed. This keeps automation customer-context-driven rather than channel-driven.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_journey-tasarim-tuvali_18.png" alt="@(tr?"Pika Journey tasarım tuvali ve Push aksiyonu":"Pika Journey design canvas and Push action")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Journey Manager</small><h3>Trigger → Decision → Wait → Push</h3><p>@(tr?"Push'ı akıştaki doğru koşul ve zamanlama sonucunda çalışan aksiyon olarak konumlandırın." : "Position Push as an action reached through the right condition and timing in the flow.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_journey-karar-kurallari_19.png" alt="@(tr?"Pika Journey karar kuralları":"Pika Journey decision rules")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Decision Rules</small><h3>@(tr?"Her müşteri aynı adımı görmez":"Not every customer follows the same step")</h3><p>@(tr?"Segment, profil veya desteklenen davranış koşulları Push adımına ulaşılıp ulaşılmayacağını belirleyebilir." : "Segment, profile or supported behavior conditions can determine whether the Push step is reached.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">@(tr?"Uygunluk ve hedefleme":"Eligibility and targeting")</span><h2>@(tr?"Her müşterinin Push kanalı kullanılabilir varsayılmamalıdır.":"Do not assume Push is available for every customer.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Push aksiyonu için gerekli uygulama/kanal kimliğinin ve ilgili izin bağlamının mevcut olması gerekir. Audience Manager müşteriyi hedef kitleye dahil edebilir; bu tek başına Push kanalının kullanılabilir olduğu anlamına gelmez.":"The required app/channel identity and relevant permission context need to be available for a Push action. Audience Manager may include a customer in an audience, but that alone does not make Push available.")</p></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-filter-3-line"></i><div><strong>Audience</strong><span>@(tr?"İş kuralı açısından hedef kitlede mi?":"Is the customer in the business audience?")</span></div></div><div class="pk-control-step"><i class="ri-smartphone-line"></i><div><strong>@(tr?"Kanal kimliği":"Channel identity")</strong><span>@(tr?"Desteklenen Push uygulama/cihaz bağlamı mevcut mu?":"Is supported Push app/device context available?")</span></div></div><div class="pk-control-step"><i class="ri-shield-check-line"></i><div><strong>@(tr?"İzin":"Permission")</strong><span>@(tr?"İlgili kanal için uygunluk koşulları karşılanıyor mu?":"Are relevant channel-eligibility conditions met?")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-route-line"></i><div><strong>@(tr?"Akış kararı":"Flow decision")</strong><span>@(tr?"Uygun değilse Journey farklı bir yola devam edebilir." : "If ineligible, the Journey may follow a different path.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Gerçek zaman iddiası":"Real-time claims")</span><h2>@(tr?"'Anlık' demeden önce tetikleyicinin gerçekten anlık olduğunu doğrulayın.":"Before saying 'real-time,' verify that the trigger is actually real-time.")</h2></div><p class="pk-lead">@(tr?"Push sayfası uygulamada doğrulanmayan event kaynakları, cihaz özellikleri, rich media veya gerçek zaman altyapısı varmış gibi davranmamalıdır. Kullanılabilir fonksiyonlar mevcut Campaign/Journey, entegrasyon ve kanal altyapısının doğrulanmış kapsamıyla sınırlıdır.":"This page must not imply unverified event sources, device capabilities, rich media or real-time infrastructure. Available functions are limited to the verified Campaign/Journey, integration and channel scope.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-plug-line"></i><strong>@(tr?"Kaynak":"Source")</strong><span>@(tr?"Doğrulanmış event/veri kaynağı":"Verified event/data source")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-time-line"></i><strong>@(tr?"Gecikme":"Latency")</strong><span>@(tr?"Gerçek veri akışının davranışı":"Actual data-flow behavior")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-git-branch-line"></i><strong>@(tr?"Kural":"Rule")</strong><span>@(tr?"Journey karar mantığı":"Journey decision logic")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-notification-3-line"></i><strong>Push</strong><span>@(tr?"Desteklenen kanal aksiyonu":"Supported channel action")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-check-double-line"></i><strong>@(tr?"Sonuç":"Outcome")</strong><span>@(tr?"Desteklenen delivery/event":"Supported delivery/event")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>Analytics</strong><span>@(tr?"Yalnız doğrulanmış metriği göster":"Show only verified metrics")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">Push → Measure</span><h2>@(tr?"Desteklenen kanal sonucunu Campaign ve Journey bağlamında ölçün.":"Measure supported channel outcomes in Campaign and Journey context.")</h2></div><p class="pk-lead">@(tr?"Push için mevcut altyapının sağladığı delivery/engagement olayları Analytics içinde ilgili kampanya veya Journey bağlamında okunabilir. Desteklenmeyen cihaz davranışı, event veya nedensellik metriği varmış gibi rapor üretilmemelidir.":"Delivery/engagement events provided by the current Push infrastructure can be reviewed in the relevant Campaign or Journey context. Unsupported device behavior, events or causal metrics should not be implied.")</p></div><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/analytics":"/en/platform/analytics")">Analytics</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/journey-manager":"/en/platform/journey-manager")">Journey Manager</a></div></div></section>

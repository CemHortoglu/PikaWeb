@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]="Push | "+(tr?"Pika Kanalları":"Pika Channels"); ViewData["MetaDescription"]=tr?"Pika'da Push bildirimlerini desteklenen hedef kitle ve Journey/Campaign bağlamında kullanın; kanal uygunluğu ve ölçüm sonuçlarını ayrı değerlendirin.":"Use Push notifications in Pika within supported audience and Journey/Campaign context while keeping channel eligibility and measurement explicit."; ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">@(tr?"Kanallar · Push":"Channels · Push")</span><h1>@(tr?"Push bildirimini doğru müşteri akışının bir adımı olarak kullanın.":"Use Push as a step in the right customer flow.")</h1><p>@(tr?"Push, Pika'nın desteklenen Campaign ve Journey senaryolarında kullanılabilen iletişim kanallarından biridir. Hedef kitle ve akış mantığı önce gelir; kanal ancak ilgili müşteri için kullanılabilir olduğunda aksiyona dönüşür.":"Push is one of the communication channels available in supported Pika Campaign and Journey scenarios. Audience and flow logic come first, and the channel becomes an action only when it is available for the customer.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/journey-manager":"/en/platform/journey-manager")">Journey Manager</a></div></div><div class="pk-proof" style="padding:30px"><span class="pk-eyebrow">Push</span><h2 style="font-size:32px">@(tr?"Akış bağlamında kısa aksiyon.":"A concise action inside the flow.")</h2><div class="pk-flow" style="grid-template-columns:repeat(3,1fr);margin-top:28px"><div class="pk-flow-item"><small>01</small><strong>Trigger</strong><span>@(tr?"Desteklenen olay/koşul":"Supported event/condition")</span></div><div class="pk-flow-item"><small>02</small><strong>Decision</strong><span>@(tr?"Müşteri ve kural bağlamı":"Customer/rule context")</span></div><div class="pk-flow-item"><small>03</small><strong>Push</strong><span>@(tr?"Uygunsa bildirim":"Notification if eligible")</span></div></div></div></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-columns"><div class="pk-feature"><h3>@(tr?"Journey adımı":"Journey step")</h3><p>@(tr?"Push bildirimini tetikleyici, karar ve bekleme adımlarının ardından akışın uygun noktasında kullanın.":"Use Push at the appropriate point after trigger, decision and wait steps in a Journey.")</p></div><div class="pk-feature"><h3>@(tr?"Hedef kitle":"Audience")</h3><p>@(tr?"Segment veya Campaign bağlamında ilgili müşteri kümesini seçin; her müşterinin kanalı kullanılabilir varsayılmamalıdır.":"Select the relevant customer group through audience or Campaign context; do not assume channel availability for every customer.")</p></div><div class="pk-feature"><h3>@(tr?"Ölçüm":"Measurement")</h3><p>@(tr?"Kanalın desteklenen delivery/engagement sonuçlarını Campaign/Journey ve Analytics bağlamında değerlendirin.":"Review supported delivery/engagement outcomes in Campaign/Journey and Analytics context.")</p></div></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">Push + Decision</span><h2>@(tr?"Gerçek zamanlı olma iddiasını yalnız desteklenen tetikleyicilerle sınırlayın.":"Limit real-time claims to triggers the product actually supports.")</h2></div><p class="pk-lead">@(tr?"Push sayfası, uygulamada doğrulanmayan event kaynakları, cihaz özellikleri veya zengin medya kabiliyetleri varmış gibi davranmaz. Kullanılabilir fonksiyonlar mevcut Campaign/Journey ve kanal altyapısının doğrulanmış kapsamıyla sınırlıdır.":"This page does not imply unverified event sources, device features or rich-media capabilities. Available functions are limited to the verified Campaign/Journey and channel infrastructure.")</p></div></section>

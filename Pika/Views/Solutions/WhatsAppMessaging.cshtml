@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]="WhatsApp | "+(tr?"Pika Kanalları":"Pika Channels"); ViewData["MetaDescription"]=tr?"Pika'da WhatsApp kanalını uygun izin, opt-out, şablon ve Campaign/Journey bağlamıyla yönetin; müşteri fırsatını kontrollü mesajlaşma aksiyonuna dönüştürün.":"Use WhatsApp in Pika with appropriate consent, opt-out, template and Campaign/Journey context to turn customer opportunities into controlled messaging actions."; ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">@(tr?"Kanallar · WhatsApp":"Channels · WhatsApp")</span><h1>@(tr?"WhatsApp'ı fırsatın ardından gelen kontrollü mesajlaşma kanalı olarak yönetin.":"Use WhatsApp as a controlled messaging channel after the opportunity is understood.")</h1><p>@(tr?"Pika'da WhatsApp; hedef kitle, müşteri bağlamı, izin/opt-out ve şablon koşulları değerlendirildikten sonra Campaign veya Journey içinde kullanılabilen aksiyon kanallarından biridir. Kanalın varlığı tek başına gönderim gerekçesi değildir.":"In Pika, WhatsApp is an execution channel used in Campaign or Journey after audience, customer context, consent/opt-out and template conditions are considered. Channel availability alone is not a reason to send.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/izin-optout-iys">@(tr?"İzin ve Opt-out":"Consent & Opt-out")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_izin-kanal-zamanlama_25.png" alt="@(tr?"Pika izin kanal ve zamanlama ekranı":"Pika consent channel and timing screen")" width="1200" height="760" /><figcaption>@(tr?"WhatsApp uygunluğu; iletişim bilgisi, izin ve opt-out bağlamıyla birlikte değerlendirilir.":"WhatsApp eligibility is evaluated together with contact data, consent and opt-out context.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-columns"><div class="pk-feature"><i class="ri-whatsapp-line"></i><h3>@(tr?"Şablon ve içerik bağlamı":"Template & content context")</h3><p>@(tr?"Kullanılabilir WhatsApp şablonunu ilgili Campaign/Journey aksiyonuyla ilişkilendirin; desteklenmeyen mesaj tiplerini varsaymayın.":"Connect available WhatsApp templates to the relevant Campaign/Journey action without assuming unsupported message types.")</p></div><div class="pk-feature"><i class="ri-shield-user-line"></i><h3>@(tr?"İzin ve opt-out":"Consent & opt-out")</h3><p>@(tr?"WhatsApp numarasının bulunması pazarlama izni anlamına gelmez. Opt-in/opt-out semantiğini kanal kararının parçası olarak okuyun.":"Having a WhatsApp number does not imply marketing consent. Treat opt-in/opt-out semantics as part of the channel decision.")</p></div><div class="pk-feature"><i class="ri-route-line"></i><h3>Campaign & Journey</h3><p>@(tr?"WhatsApp'ı tek başına yönetilen liste gönderimi yerine fırsat, hedef kitle ve akış bağlamına bağlayın.":"Connect WhatsApp to opportunity, audience and flow context rather than treating it as a standalone list blast.")</p></div></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">Opportunity → WhatsApp</span><h2>@(tr?"Önce neden, sonra kanal.":"Reason first, channel second.")</h2></div><div><p class="pk-lead">@(tr?"Tekrar satın alma veya geri kazanım gibi bir fırsat oluştuğunda kullanıcı fırsatın nedenini ve müşterinin bağlamını değerlendirir. WhatsApp ancak uygun kanal olarak değerlendirildikten sonra seçilecek aksiyonlardan biri olabilir.":"When a repeat-purchase or win-back opportunity appears, the user reviews why it exists and the customer's context. WhatsApp becomes one possible action only after channel eligibility is established.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/gunun-firsatlari":"/en/platform/opportunities")">@(tr?"Günün Fırsatları":"Daily Opportunities")</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/consent-management":"/en/platform/consent-management")">Consent Management</a></div></div></div></section>

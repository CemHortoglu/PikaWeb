@{
    var tr = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-solutions-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-whatsapp-page.css" asp-append-version="true" />
}

@* ── 01 HERO ─────────────────────────────────────────────────── *@
<section class="inner-hero inner-hero-solution">
    <div class="inner-atmosphere"></div>
    <div class="container position-relative">
        <div class="inner-hero-grid">
            <div class="inner-intro">
                <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                    <a href="@(tr ? "/" : "/en/")">Pika</a>
                    <span>/</span>
                    <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                    <span>/</span>
                    <span>WhatsApp</span>
                </nav>
                <div class="inner-eyebrow" aria-label="WhatsApp Messaging"><span></span>WHATSAPP · WhatsApp Marketing</div>
                @if (tr)
                {
                    <h1>
                        Onaylı WhatsApp iletişimini,<br />
                        Pika'nın kontrollü aksiyon zincirinde<br />
                        doğru müşteri bağlamına taşıyın.
                    </h1>
                    <p>
                        Pika WhatsApp; onaylı WhatsApp Business API şablonlarının Audience Manager'da tanımlanan hedef kitle bağlamında, Campaign Manager veya Journey Manager içindeki kontrollü iletişim aksiyonlarında kullanılmasını sağlayan doğrulanmış Pika iletişim kanallarından biridir.
                    </p>
                    <p class="text-muted small">
                        WhatsApp iletişimi mevcut opt-in bağlamı ve onaylı template gereksiniminden bağımsız değildir; kanal bu kontrolleri bypass eden serbest mesaj veya chatbot katmanı olarak çalışmaz.
                    </p>
                    <div class="inner-actions">
                        <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">Demo Talep Et ↗</button>
                        <a class="inner-secondary" href="/cozumler/campaign-manager">Campaign Manager'ı Keşfedin →</a>
                        <a class="inner-hero-anchor" href="#inner-content" aria-label="İçeriğe atla"><i class="ri-arrow-down-line" aria-hidden="true"></i></a>
                    </div>
                }
                else
                {
                    <h1>
                        Bring approved WhatsApp communication<br />
                        to the right customer context<br />
                        inside Pika's controlled action chain.
                    </h1>
                    <p>
                        Pika WhatsApp is one of Pika's confirmed communication channels for using approved WhatsApp Business API templates with audience context defined in Audience Manager inside controlled actions managed through Campaign Manager or Journey Manager.
                    </p>
                    <p class="text-muted small">
                        WhatsApp communication is not independent from available opt-in context and approved-template requirements; the channel is not a free-form messaging or chatbot layer that bypasses those controls.
                    </p>
                    <div class="inner-actions">
                        <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">Request a Demo ↗</button>
                        <a class="inner-secondary" href="/en/solutions/campaign-manager">Explore Campaign Manager →</a>
                        <a class="inner-hero-anchor" href="#inner-content" aria-label="Skip to content"><i class="ri-arrow-down-line" aria-hidden="true"></i></a>
                    </div>
                }
            </div>

            <div class="inner-scene" aria-hidden="true">
                <div class="inner-scene-orbit"></div>
                <div class="inner-scene-window">
                    <div class="inner-window-bar">
                        <strong>pika<span>✳</span></strong>
                        <span>WhatsApp</span>
                        <small>@(tr ? "Örnek görünüm" : "Illustration")</small>
                    </div>
                    <div class="wa-hero-pills">
                        @if (tr)
                        {
                            <span class="wa-hero-pill">HEDEF KİTLE <span>01</span></span>
                            <span class="wa-hero-pill">OPT-IN <span>02</span></span>
                            <span class="wa-hero-pill">ONAYLI ŞABLON <span>03</span></span>
                            <span class="wa-hero-pill">KAMPANYA / JOURNEY <span>04</span></span>
                            <span class="wa-hero-pill">WHATSAPP <span>05</span></span>
                            <span class="wa-hero-pill">TESLİMAT <span>06</span></span>
                        }
                        else
                        {
                            <span class="wa-hero-pill">AUDIENCE <span>01</span></span>
                            <span class="wa-hero-pill">OPT-IN <span>02</span></span>
                            <span class="wa-hero-pill">APPROVED TEMPLATE <span>03</span></span>
                            <span class="wa-hero-pill">CAMPAIGN / JOURNEY <span>04</span></span>
                            <span class="wa-hero-pill">WHATSAPP <span>05</span></span>
                            <span class="wa-hero-pill">DELIVERY <span>06</span></span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="inner-content" class="inner-anchor"></div>

@* ── STICKY SUBNAV ─────────────────────────────────────────────── *@
<nav class="pika-sol-subnav d-none d-md-block" aria-label="@(tr ? "Sayfa içi menü" : "In-page menu")">
    <div class="container">
        <ul class="nav">
            <li class="nav-item"><a class="nav-link" href="#genel-bakis">@(tr ? "Genel Bakış" : "Overview")</a></li>
            <li class="nav-item"><a class="nav-link" href="#business-api">@(tr ? "Business API" : "Business API")</a></li>
            <li class="nav-item"><a class="nav-link" href="#sablonlar">@(tr ? "Şablonlar" : "Templates")</a></li>
            <li class="nav-item"><a class="nav-link" href="#hedef-kitle">@(tr ? "Hedef Kitle" : "Audience")</a></li>
            <li class="nav-item"><a class="nav-link" href="#kampanya">@(tr ? "Kampanya" : "Campaign")</a></li>
            <li class="nav-item"><a class="nav-link" href="#izin-olcum">@(tr ? "İzin & Ölçüm" : "Consent & Measurement")</a></li>
            <li class="nav-item"><a class="nav-link" href="#sss">@(tr ? "SSS" : "FAQ")</a></li>
        </ul>
    </div>
</nav>

@* ── TRUST / VALUE STRIP ───────────────────────────────────────── *@
<section class="border-bottom py-3 bg-white">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 text-muted small fw-semibold">
            @if (tr)
            {
                <span><i class="ri-checkbox-circle-fill text-success me-1"></i> WhatsApp Business API</span>
                <span><i class="ri-checkbox-circle-fill text-success me-1"></i> Onaylı Şablon</span>
                <span><i class="ri-checkbox-circle-fill text-success me-1"></i> Audience Bağlamı</span>
                <span><i class="ri-checkbox-circle-fill text-success me-1"></i> Campaign / Journey</span>
                <span><i class="ri-checkbox-circle-fill text-success me-1"></i> Opt-In Kontrolü</span>
            }
            else
            {
                <span><i class="ri-checkbox-circle-fill text-success me-1"></i> WhatsApp Business API</span>
                <span><i class="ri-checkbox-circle-fill text-success me-1"></i> Approved Template</span>
                <span><i class="ri-checkbox-circle-fill text-success me-1"></i> Audience Context</span>
                <span><i class="ri-checkbox-circle-fill text-success me-1"></i> Campaign / Journey</span>
                <span><i class="ri-checkbox-circle-fill text-success me-1"></i> Opt-In Control</span>
            }
        </div>
    </div>
</section>

@* ── 02 DIRECT ANSWER ──────────────────────────────────────────── *@
<section class="pika-sol-section" id="genel-bakis">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <span class="pika-sol-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
                <h2 class="pika-sol-section-title text-start mb-4">@(tr ? "Pika WhatsApp nedir?" : "What is Pika WhatsApp?")</h2>

                <p class="lead">
                    @(tr
                        ? "Pika WhatsApp, onaylı WhatsApp Business API template iletişiminin kontrollü kampanya veya journey bağlamında kullanılabildiği Pika iletişim kanallarından biridir."
                        : "Pika WhatsApp is one of Pika's communication channels for using approved WhatsApp Business API template communication within controlled campaign or journey context.")
                </p>

                <p>
                    @(tr
                        ? "WhatsApp kanalının görevi hedef kitleyi kendi başına seçmek, müşteriyle serbest iki yönlü konuşma yürütmek veya AI chatbot olarak yanıt üretmek değildir."
                        : "The role of the WhatsApp channel is not to independently select the audience, conduct unrestricted two-way customer conversations or generate replies as an AI chatbot.")
                </p>
                <p class="fw-semibold">
                    @(tr ? "Bu görevler Pika WhatsApp ürün rolünün parçası değildir." : "Those capabilities are not part of the Pika WhatsApp product role.")
                </p>

                <p>
                    @(tr ? "WhatsApp'ın temel sorusu şudur:" : "WhatsApp answers one central question:")
                </p>

                <div class="wa-callout my-4">
                    <p class="h4 mb-0 fw-bold" style="color:var(--pika-primary)">
                        @(tr
                            ? "“Onaylı bu WhatsApp iletişimi, mevcut opt-in ve aksiyon bağlamında nasıl yürütülecek?”"
                            : "“How is this approved WhatsApp communication executed under available opt-in and action context?”")
                    </p>
                </div>

                <p>
                    @(tr
                        ? "Audience, Campaign ve Journey kararları Pika'nın ilgili ürün katmanlarında oluşturulur; WhatsApp uygun iletişimin execution kanalıdır."
                        : "Audience, Campaign and Journey decisions are created in Pika's relevant product layers; WhatsApp is the execution channel for eligible communication.")
                </p>

                <div class="p-3 bg-white rounded border border-light-subtle mt-4">
                    @if (tr)
                    {
                        <p class="mb-1"><strong>WhatsApp:</strong> onaylı template tabanlı iletişim kanalıdır.</p>
                        <p class="mb-0"><strong>Pika:</strong> kanalın etrafındaki anlama, karar, izin ve ölçüm zinciridir.</p>
                    }
                    else
                    {
                        <p class="mb-1"><strong>WhatsApp:</strong> is an approved-template communication channel.</p>
                        <p class="mb-0"><strong>Pika:</strong> is the surrounding chain of understanding, decision, permission and measurement.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 03 WHATSAPP'S PLACE IN PIKA ───────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container" data-aos="fade-up">
        <span class="pika-sol-eyebrow">@(tr ? "KANAL, PLATFORMUN TAMAMI DEĞİL" : "A CHANNEL, NOT THE WHOLE PLATFORM")</span>
        <h2 class="pika-sol-section-title">@(tr ? "WhatsApp'ı, Pika'nın karar zincirindeki doğru yere koyun." : "Put WhatsApp in the right place inside Pika's decision chain.")</h2>

        <div class="row justify-content-center mb-4">
            <div class="col-lg-10">
                <p>
                    @(tr
                        ? "Pika bir WhatsApp Marketing veya chatbot ürününden ibaret değildir. WhatsApp, platformun müşteri zekâsı ve omnichannel aksiyon zincirindeki doğrulanmış iletişim kanallarından biridir."
                        : "Pika is more than a WhatsApp Marketing or chatbot product. WhatsApp is one of the confirmed communication channels inside the platform's customer-intelligence and omnichannel-action chain.")
                </p>
                <p>
                    @if (tr)
                    {
                        <text><a href="/platform/customer-intelligence">Customer Intelligence</a> müşteri davranışı ve değer bağlamını, <a href="/platform/product-intelligence">Product Intelligence</a> ürün bağlamını, <a href="/platform/gunun-firsatlari">Günün Fırsatları</a> ise değerlendirilebilir ticari fırsat bağlamını görünür hale getirir.</text>
                    }
                    else
                    {
                        <text><a href="/en/platform/customer-intelligence">Customer Intelligence</a> calculates customer behavior and value context, <a href="/en/platform/product-intelligence">Product Intelligence</a> establishes product context and <a href="/en/platform/opportunities">Daily Opportunities</a> makes evaluable commercial opportunity context visible.</text>
                    }
                </p>
                <p>
                    @(tr
                        ? "Audience Manager kimin dahil olduğunu, Campaign Manager veya Journey Manager ise iletişim aksiyonunun nasıl yürütüleceğini yönetir. WhatsApp bu kontrollü aksiyonun execution kanallarından biridir."
                        : "Audience Manager manages who belongs, while Campaign Manager or Journey Manager manage how communication action is executed. WhatsApp is one execution channel for that controlled action.")
                </p>

                <div class="wa-flow-chain my-4" aria-label="@(tr ? "Karar ve icra zinciri" : "Decision and execution chain")">
                    <span>DATA</span>
                    <span class="wa-flow-arrow">→</span>
                    <span>CUSTOMER &amp; PRODUCT INTELLIGENCE</span>
                    <span class="wa-flow-arrow">→</span>
                    <span>OPPORTUNITY / DECISION</span>
                    <span class="wa-flow-arrow">→</span>
                    <span>AUDIENCE</span>
                    <span class="wa-flow-arrow">→</span>
                    <span>CAMPAIGN / JOURNEY</span>
                    <span class="wa-flow-arrow">→</span>
                    <span>OPT-IN / TEMPLATE ELIGIBILITY</span>
                    <span class="wa-flow-arrow">→</span>
                    <span>WHATSAPP</span>
                    <span class="wa-flow-arrow">→</span>
                    <span>MEASUREMENT</span>
                </div>
            </div>
        </div>

        @* Current four-card area *@
        <div class="pika-sol-value-grid">
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500">
                <div class="pika-sol-value-icon"><i class="ri-file-list-3-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Onaylı Template İletişimi" : "Approved Template Communication")</h4>
                <p>@(tr ? "Uygun WhatsApp Business template yapısını kontrollü kampanya veya journey aksiyonunda kullanın." : "Use eligible WhatsApp Business template structures within controlled campaign or journey actions.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="100">
                <div class="pika-sol-value-icon"><i class="ri-focus-3-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Audience Bağlamı" : "Audience Context")</h4>
                <p>@(tr ? "Audience Manager'da tanımlanan gerçek hedef kitleyi WhatsApp aksiyonunun upstream müşteri bağlamı olarak kullanın." : "Use the actual audience defined in Audience Manager as upstream customer context for WhatsApp action.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="200">
                <div class="pika-sol-value-icon"><i class="ri-shield-check-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Opt-In Kontrolü" : "Opt-In Control")</h4>
                <p>@(tr ? "WhatsApp iletişimini mevcut explicit opt-in bağlamından bağımsız yürütmeyin." : "Do not execute WhatsApp communication independently from available explicit opt-in context.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="300">
                <div class="pika-sol-value-icon"><i class="ri-dashboard-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Ölçülebilir Delivery Sonucu" : "Measurable Delivery Outcome")</h4>
                <p>@(tr ? "Kullanılabilir WhatsApp delivery outcome veya status bağlamını Analytics & Reporting içinde değerlendirin." : "Evaluate available WhatsApp delivery-outcome or status context within Analytics & Reporting.")</p>
            </div>
        </div>

        <div class="row justify-content-center mt-4">
            <div class="col-lg-10">
                <div class="p-3 bg-white rounded border border-light-subtle text-center">
                    @if (tr)
                    {
                        <p class="mb-0"><strong>WhatsApp kararı üretmez.</strong> Tanımlanmış kararın iletişim kanalıdır.</p>
                    }
                    else
                    {
                        <p class="mb-0"><strong>WhatsApp does not create the decision.</strong> It is the communication channel for a defined decision.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 04 OFFICIAL WHATSAPP BUSINESS API CONTEXT ─────────────────── *@
<section class="pika-sol-section" id="business-api">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <span class="pika-sol-eyebrow">WHATSAPP BUSINESS API</span>
                <h2 class="pika-sol-section-title text-start mb-4">
                    @(tr ? "WhatsApp iletişimini, resmî Business API bağlamında yürütün." : "Execute WhatsApp communication within official Business API context.")
                </h2>

                <p class="lead">
                    @(tr
                        ? "Pika'nın WhatsApp iletişim kanalı WhatsApp Business API üzerinden template tabanlı outbound iletişim bağlamında kullanılır."
                        : "Pika's WhatsApp communication channel is used for template-based outbound communication through WhatsApp Business API context.")
                </p>

                <p>
                    @(tr
                        ? "Bu yapı WhatsApp'ı kontrolsüz serbest mesaj gönderim kanalı veya bağımsız canlı destek inbox'ı haline getirmez."
                        : "This does not turn WhatsApp into an unrestricted free-form messaging channel or an independent live-support inbox.")
                </p>

                <p>
                    @(tr
                        ? "Pika, WhatsApp Business platformunun dış politika, hesap uygunluğu veya template onay kararlarını kendi başına belirlemez."
                        : "Pika does not independently control external WhatsApp Business platform policies, account eligibility or template-approval decisions.")
                </p>

                <div class="wa-callout my-4">
                    @if (tr)
                    {
                        <p class="mb-1"><strong>Pika:</strong> onaylı template iletişimini kampanya veya journey aksiyonunda kullanır.</p>
                        <p class="mb-0"><strong>WhatsApp Business platformu:</strong> template ve hesap uygunluğu için dış platform bağlamını belirler.</p>
                    }
                    else
                    {
                        <p class="mb-1"><strong>Pika:</strong> uses approved template communication inside campaign or journey actions.</p>
                        <p class="mb-0"><strong>The WhatsApp Business platform:</strong> defines external platform context for template and account eligibility.</p>
                    }
                </div>

                <div class="p-3 bg-white rounded border border-light-subtle">
                    <p class="mb-0 fw-semibold text-center">
                        @(tr ? "API bağlantısı, platform yönetişimini ortadan kaldırmaz." : "API connectivity does not remove platform governance.")
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 05 APPROVED TEMPLATE COMMUNICATION ────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="sablonlar">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <span class="pika-sol-eyebrow">@(tr ? "ONAYLI ŞABLON" : "APPROVED TEMPLATE")</span>
                <h2 class="pika-sol-section-title text-start mb-4">
                    @(tr ? "WhatsApp kampanya iletişimini, uygun template bağlamıyla hazırlayın." : "Prepare WhatsApp campaign communication within eligible template context.")
                </h2>

                <p class="lead">
                    @(tr
                        ? "Pika WhatsApp outbound iletişiminde onaylı WhatsApp Business template yapısını kullanır."
                        : "Pika WhatsApp uses approved WhatsApp Business template structures for outbound communication.")
                </p>

                <p>
                    @(tr
                        ? "Template içeriği kampanya veya journey aksiyonunda kullanılmadan önce ilgili WhatsApp Business approval bağlamına uygun olmalıdır."
                        : "Before template content is used inside a campaign or journey action, it must be eligible within the relevant WhatsApp Business approval context.")
                </p>

                <p>
                    @(tr
                        ? "Pika'nın kampanya katmanında bir mesaj hazırlamak, template'in dış platform tarafından otomatik olarak onaylanacağı anlamına gelmez."
                        : "Preparing a message inside Pika's campaign layer does not mean the template will automatically be approved by the external platform.")
                </p>

                <div class="wa-callout my-4">
                    @if (tr)
                    {
                        <p class="mb-1"><strong>Pika:</strong> onaylı template'i kontrollü aksiyonda kullanır.</p>
                        <p class="mb-0"><strong>Pika şunu garanti etmez:</strong> “Hazırlanan her template otomatik olarak onaylanır.”</p>
                    }
                    else
                    {
                        <p class="mb-1"><strong>Pika:</strong> uses an approved template inside controlled action.</p>
                        <p class="mb-0"><strong>Pika does not guarantee:</strong> “Every prepared template will be approved automatically.”</p>
                    }
                </div>

                <div class="p-3 bg-white rounded border border-light-subtle text-center">
                    <p class="mb-0 fw-semibold">
                        @(tr ? "Template hazırlığı ve template approval aynı karar değildir." : "Template preparation and template approval are different decisions.")
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 06 AUDIENCE → WHATSAPP ────────────────────────────────────── *@
<section class="pika-sol-section" id="hedef-kitle">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <span class="pika-sol-eyebrow">@(tr ? "“KİM?”DEN WHATSAPP'A" : "FROM “WHO?” TO WHATSAPP")</span>
                <h2 class="pika-sol-section-title text-start mb-4">
                    @(tr ? "WhatsApp hedef kitleyi seçmez. Audience bağlamını kullanır." : "WhatsApp does not choose the audience. It uses audience context.")
                </h2>

                <p class="lead">
                    @(tr
                        ? "Audience Manager gerçek hedef kitleyi müşteri verisi ve açık kurallar üzerinden tanımlar."
                        : "Audience Manager defines the actual target audience through customer data and explicit rules.")
                </p>

                <p>
                    @(tr
                        ? "WhatsApp kanalının görevi müşterileri kendi başına segmente etmek veya “en uygun” kullanıcıları seçmek değildir."
                        : "The role of the WhatsApp channel is not to independently segment customers or select the “best” users.")
                </p>

                <p>
                    @(tr
                        ? "Campaign Manager veya Journey Manager içindeki WhatsApp aksiyonu ilgili audience bağlamını kontrollü iletişim sürecinde kullanabilir."
                        : "A WhatsApp action inside Campaign Manager or Journey Manager can use the relevant audience context within controlled communication.")
                </p>

                <div class="wa-callout my-4">
                    @if (tr)
                    {
                        <p class="mb-2"><strong>Audience Manager:</strong> “Kim bu hedef kitleye dahil?”</p>
                        <p class="mb-0"><strong>WhatsApp:</strong> “Bu tanımlı kitleye uygun WhatsApp iletişimi hangi aksiyon bağlamında yürütülecek?”</p>
                    }
                    else
                    {
                        <p class="mb-2"><strong>Audience Manager:</strong> “Who belongs in this audience?”</p>
                        <p class="mb-0"><strong>WhatsApp:</strong> “Within which action context will eligible WhatsApp communication reach this defined audience?”</p>
                    }
                </div>

                <div class="p-3 bg-white rounded border border-light-subtle mb-4">
                    <p class="mb-0 fw-semibold text-center">
                        @(tr ? "Audience gerçeği, WhatsApp kanalı tarafından üretilmez." : "Audience truth is not created by the WhatsApp channel.")
                    </p>
                </div>

                <div class="mb-5">
                    <a href="@(tr ? "/cozumler/audience-manager" : "/en/solutions/audience-manager")" class="btn pika-btn-outline">
                        @(tr ? "Audience Manager'ı Keşfedin →" : "Explore Audience Manager →")
                    </a>
                </div>
            </div>
        </div>

        @* Current three-card area *@
        <div class="pika-sol-card-grid">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-megaphone-line" aria-hidden="true"></i></div>
                <h4>Campaign WhatsApp</h4>
                <p>
                    @(tr

@{
    var tr = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = tr ? "WhatsApp Business Messaging Platformu ile Kampanya ve Otomasyon - Pika" : "WhatsApp Business Messaging Platform for Campaigns & Automation - Pika";
    ViewData["MetaDescription"] = tr ? "Pika WhatsApp Messaging ile şablon yönetimi, segment bazlı kampanyalar, kişiselleştirme ve operasyonel kontrolü tek platformda yönetin." : "Manage template governance, segmented campaigns, personalization, and operational control in one place with Pika WhatsApp Messaging.";
    ViewData["MetaKeywords"] = "whatsapp messaging, whatsapp business, whatsapp kampanya, şablon yönetimi, segmentasyon, otomasyon";
}

<!-- Hero -->
@await Html.PartialAsync("_MarketingHero")

<!-- Değer Kutuları -->
<section class="pika-sol-section">
    <div class="container">
        <div class="pika-sol-value-grid">
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500">
                <div class="pika-sol-value-icon"><i class="ri-file-list-3-line"></i></div>
                <h4>@(tr ? "Şablon Yönetimi" : "Template Management")</h4>
                <p>@(tr ? "Onaylı mesaj yapılarınızı güvenli şekilde yönetin." : "Manage approved message structures with control.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="100">
                <div class="pika-sol-value-icon"><i class="ri-focus-3-line"></i></div>
                <h4>@(tr ? "Segment Bazlı Kullanım" : "Segment-Based Usage")</h4>
                <p>@(tr ? "Doğru kullanıcıya doğru içerikle ulaşın." : "Reach the right user with the right content.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="200">
                <div class="pika-sol-value-icon"><i class="ri-dashboard-line"></i></div>
                <h4>@(tr ? "Operasyonel Görünürlük" : "Operational Visibility")</h4>
                <p>@(tr ? "Gönderim akışlarını ve süreçleri merkezi yönetin." : "Manage delivery flows and processes centrally.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="300">
                <div class="pika-sol-value-icon"><i class="ri-links-line"></i></div>
                <h4>@(tr ? "Çok Kanallı Entegrasyon" : "Multi-Channel Integration")</h4>
                <p>@(tr ? "WhatsApp'i daha büyük müşteri yolculuğunun parçası yapın." : "Make WhatsApp part of a larger customer journey.")</p>
            </div>
        </div>
    </div>
</section>

<!-- Ne Yapabilirsiniz? -->
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "WhatsApp'i daha planlı ve ölçülebilir kullanın" : "Use WhatsApp in a more planned and measurable way")</h2>
        <p class="pika-sol-section-desc" data-aos="fade-up" data-aos-delay="100">@(tr ? "Pika ile WhatsApp mesajlaşmasını kampanya, akış ve segment bazlı iletişimlerde merkezi olarak yönetin." : "Centrally manage WhatsApp messaging for campaigns, flows, and segment-based communications with Pika.")</p>
        <div class="pika-sol-card-grid">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-megaphone-line"></i></div>
                <h4>@(tr ? "Kampanya Gönderimleri" : "Campaign Sends")</h4>
                <p>@(tr ? "Belirli segmentlere kişiselleştirilmiş WhatsApp kampanyaları." : "Personalized WhatsApp campaigns to specific segments.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-route-line"></i></div>
                <h4>@(tr ? "Journey İçi Kullanım" : "In-Journey Usage")</h4>
                <p>@(tr ? "Belirli olaylara göre tetiklenen WhatsApp adımları." : "WhatsApp steps triggered by specific events.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-settings-3-line"></i></div>
                <h4>@(tr ? "Operasyonel Yönetim" : "Operational Management")</h4>
                <p>@(tr ? "Şablon, süreç ve gönderim kontrollerini merkezi görün." : "Centrally view template, process, and delivery controls.")</p>
            </div>
        </div>
    </div>
</section>

<!-- Özellikler / Capability Grid -->
<section class="pika-sol-section" id="features">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "WhatsApp iletişimini yüzeysel değil, ürünleşmiş şekilde yönetin" : "Manage WhatsApp communication as a productized solution")</h2>
        <div class="pika-sol-card-grid">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-file-list-3-line"></i></div>
                <h4>@(tr ? "Şablon Yönetimi" : "Template Management")</h4>
                <p>@(tr ? "Hazır mesaj şablonlarını yönetin." : "Manage ready-made message templates.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-user-settings-line"></i></div>
                <h4>@(tr ? "Kişiselleştirilmiş Mesaj İçeriği" : "Personalized Message Content")</h4>
                <p>@(tr ? "Kullanıcı bazlı verilerle daha ilgili iletişim kurun." : "Communicate more relevantly with user-based data.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-focus-3-line"></i></div>
                <h4>@(tr ? "Segment Bazlı Kampanyalar" : "Segment-Based Campaigns")</h4>
                <p>@(tr ? "Transaction ve davranış verilerini WhatsApp kampanyalarında kullanın." : "Use transaction and behavior data in WhatsApp campaigns.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-time-line"></i></div>
                <h4>@(tr ? "Zamanlı ve Tetiklenmiş Gönderim" : "Scheduled & Triggered Delivery")</h4>
                <p>@(tr ? "Planlı ya da olay bazlı süreçler oluşturun." : "Create scheduled or event-based processes.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-route-line"></i></div>
                <h4>@(tr ? "Journey Entegrasyonu" : "Journey Integration")</h4>
                <p>@(tr ? "WhatsApp'i email, SMS ve Push ile aynı yolculuk içinde kullanın." : "Use WhatsApp within the same journey as email, SMS, and Push.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-line-chart-line"></i></div>
                <h4>@(tr ? "Raporlama ve Süreç Kontrolü" : "Reporting & Process Control")</h4>
                <p>@(tr ? "Kampanya ve gönderim yönetimini görünür hale getirin." : "Make campaign and delivery management visible.")</p>
            </div>
        </div>
    </div>
</section>

<!-- Kullanım Senaryoları -->
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Pika WhatsApp Messaging ile örnek kullanım senaryoları" : "Example use cases with Pika WhatsApp Messaging")</h2>
        <div class="pika-sol-usecase-grid">
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="50"><i class="ri-check-line"></i> @(tr ? "Dönemsel kampanyalar" : "Seasonal campaigns")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="100"><i class="ri-check-line"></i> @(tr ? "Özel gün teklifleri" : "Special occasion offers")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="150"><i class="ri-check-line"></i> @(tr ? "Davranış bazlı hatırlatmalar" : "Behavior-based reminders")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="200"><i class="ri-check-line"></i> @(tr ? "Segment bazlı kişiselleştirilmiş kampanyalar" : "Segment-based personalized campaigns")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="250"><i class="ri-check-line"></i> @(tr ? "Müşteri yolculuğundaki önemli temas anları" : "Key touchpoints in the customer journey")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="300"><i class="ri-check-line"></i> @(tr ? "Sadakat / tekrar satın alma iletişimleri" : "Loyalty / repeat purchase communications")</div>
        </div>
    </div>
</section>

<!-- Nasıl Çalışır? -->
<section class="pika-sol-section">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "WhatsApp iletişim sürecini tek panelden yönetin" : "Manage the WhatsApp communication process from one panel")</h2>
        <div class="pika-sol-steps">
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="100"><div class="pika-sol-step-num"></div><p>@(tr ? "Şablon veya içerik yapısını belirleyin" : "Define the template or content structure")</p></div>
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="200"><div class="pika-sol-step-num"></div><p>@(tr ? "Segment seçin" : "Select a segment")</p></div>
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="300"><div class="pika-sol-step-num"></div><p>@(tr ? "Kampanyayı planlayın ya da akışa bağlayın" : "Plan the campaign or link to a flow")</p></div>
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="400"><div class="pika-sol-step-num"></div><p>@(tr ? "Sonuçları ve operasyonu izleyin" : "Monitor results and operations")</p></div>
        </div>
    </div>
</section>

<!-- Neden Pika WhatsApp Messaging? -->
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container" data-aos="fade-up">
        <div class="pika-sol-highlight">
            <h3>@(tr ? "Sadece gönderim değil, süreç yönetimi de sağlayın" : "Provide process management, not just delivery")</h3>
            <p>@(tr ? "Pika, WhatsApp kullanımını basit kanal desteğinden çıkarır; kontrol, hedefleme ve otomasyonla ürünleşmiş hale getirir." : "Pika takes WhatsApp usage beyond simple channel support, making it a productized solution with control, targeting, and automation.")</p>
        </div>
    </div>
</section>

<!-- Omnichannel -->
<section class="pika-sol-section">
    <div class="container" data-aos="fade-up">
        <div class="pika-sol-omni">
            <h2 class="pika-sol-section-title">@(tr ? "WhatsApp'i diğer kanallarla birlikte yönetin" : "Manage WhatsApp alongside other channels")</h2>
            <p class="pika-sol-section-desc" style="margin-left:auto;margin-right:auto">@(tr ? "Tek bir müşteri deneyimini SMS, Email, Push ve WhatsApp boyunca tutarlı şekilde kurgulayın." : "Build a consistent customer experience across SMS, Email, Push, and WhatsApp.")</p>
            <div class="pika-sol-omni-icons">
                <div class="pika-sol-omni-icon" style="background:#dcf8c6;color:#25d366"><i class="ri-whatsapp-line"></i></div>
                <div class="pika-sol-omni-icon" style="background:#fff3e0;color:#f57c00"><i class="ri-mail-line"></i></div>
                <div class="pika-sol-omni-icon" style="background:#e3f2fd;color:#1976d2"><i class="ri-message-2-line"></i></div>
                <div class="pika-sol-omni-icon" style="background:#fce4ec;color:#e91e63"><i class="ri-notification-3-line"></i></div>
            </div>
        </div>
    </div>
</section>

<!-- Kapanış CTA -->
<section class="pika-sol-cta-section">
    <div class="container" data-aos="fade-up">
        <h2>@(tr ? "WhatsApp iletişimini daha kontrollü, daha hedefli ve daha güçlü hale getirin" : "Make WhatsApp communication more controlled, more targeted, and more powerful")</h2>
        <p>@(tr ? "Pika WhatsApp Messaging ile kampanya ve süreç bazlı iletişimi tek merkezden yönetin." : "Manage campaign and process-based communication from one center with Pika WhatsApp Messaging.")</p>
        <div class="pika-sol-cta-actions">
            <button type="button" class="btn pika-btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i></button>
            <a href="@Url.Action("Contact", "Home")" class="btn pika-btn-ghost px-4 py-2">@(tr ? "Bizimle İletişime Geçin" : "Contact Us")</a>
        </div>
    </div>
</section>

@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]="WhatsApp | "+(tr?"Pika Kanalları":"Pika Channels");
    ViewData["MetaDescription"]=tr?"Pika'da WhatsApp kanalını uygun izin, opt-out, şablon, müşteri bağlamı ve Campaign/Journey akışıyla yönetin; fırsatı kontrollü mesajlaşma aksiyonuna dönüştürün.":"Use WhatsApp in Pika with appropriate consent, opt-out, template, customer context and Campaign/Journey flow to turn opportunities into controlled messaging actions.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">@(tr?"Kanallar · WhatsApp":"Channels · WhatsApp")</span><h1>@(tr?"WhatsApp'ı fırsatın ardından gelen kontrollü mesajlaşma kanalı olarak yönetin.":"Use WhatsApp as a controlled messaging channel after the opportunity is understood.")</h1><p>@(tr?"Pika'da WhatsApp; hedef kitle, müşteri bağlamı, izin/opt-out ve desteklenen şablon koşulları değerlendirildikten sonra Campaign veya Journey içinde kullanılabilen aksiyon kanallarından biridir. WhatsApp adresinin bulunması veya kanalın yüksek görünürlüğü tek başına gönderim gerekçesi değildir.":"In Pika, WhatsApp is an execution channel used in Campaign or Journey after audience, customer context, consent/opt-out and supported template conditions are considered. Channel availability or high visibility is not by itself a reason to send.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"WhatsApp Akışını Canlı Görün":"See WhatsApp Flow Live")</button><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/consent-management":"/en/platform/consent-management")">Consent Management</a></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_izin-kanal-zamanlama_25.png" alt="@(tr?"Pika WhatsApp için izin kanal ve zamanlama ekranı":"Pika consent channel and timing screen for WhatsApp")" width="1200" height="760" /><div class="pk-stage-caption"><strong>WhatsApp</strong><span>@(tr?"Fırsat · İzin · Şablon · Campaign/Journey":"Opportunity · Consent · Template · Campaign/Journey")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-whatsapp-line"></i><div><strong>WhatsApp</strong><small>@(tr?"Mesajlaşma aksiyonu":"Messaging action")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-shield-check-line"></i><div><strong>@(tr?"İzin":"Consent")</strong><small>Opt-in · Opt-out</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-file-copy-2-line"></i><div><strong>@(tr?"Şablon":"Template")</strong><small>@(tr?"Desteklenen mesaj bağlamı":"Supported messaging context")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"WhatsApp'ın Pika'daki rolü":"WhatsApp's role in Pika")</span><h2>@(tr?"Önce neden, sonra müşteri, sonra kanal.":"Reason first, customer second, channel third.")</h2></div><p class="pk-lead">@(tr?"Pika WhatsApp'ı bağımsız bir toplu mesaj listesi olarak konumlandırmaz. Önce fırsat veya kampanya amacı, sonra hedef kitle ve müşteri bağlamı belirlenir. İletişim gerekiyorsa WhatsApp'ın kullanılabilirliği, izin/opt-out ve desteklenen şablon koşulları ayrıca değerlendirilir.":"Pika does not position WhatsApp as a standalone bulk-message list. Opportunity or campaign purpose comes first, followed by audience and customer context. If communication is appropriate, WhatsApp availability, consent/opt-out and supported template conditions are evaluated separately.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Neden":"Reason")</strong><span>@(tr?"Fırsat veya iş amacı":"Opportunity or business purpose")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-user-search-line"></i><strong>@(tr?"Müşteri":"Customer")</strong><span>@(tr?"Bağlamı incele":"Review context")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-shield-check-line"></i><strong>@(tr?"İzin":"Consent")</strong><span>Opt-in · Opt-out</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-file-copy-2-line"></i><strong>@(tr?"Şablon":"Template")</strong><span>@(tr?"Desteklenen mesaj biçimi":"Supported message format")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-whatsapp-line"></i><strong>WhatsApp</strong><span>@(tr?"Campaign / Journey aksiyonu":"Campaign / Journey action")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>Analytics</strong><span>@(tr?"Desteklenen sonucu izle":"Review supported outcomes")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Fırsattan WhatsApp'a":"From opportunity to WhatsApp")</span><h2>@(tr?"Bir müşteriye ulaşabiliyor olmak, ulaşmanız gerektiği anlamına gelmez.":"Being able to reach a customer does not mean you should.")</h2></div><p class="pk-lead">@(tr?"Tekrar satın alma, geri kazanım veya başka doğrulanmış bir fırsat oluştuğunda kullanıcı önce fırsatın nedenini değerlendirir. İletişim gerçekten anlamlıysa kanal seçilir. WhatsApp ancak müşteri için uygun ve desteklenen iletişim seçeneği olduğunda kullanılmalıdır.":"When a repeat-purchase, win-back or other verified opportunity appears, the user first evaluates why it exists. If communication is genuinely useful, a channel is chosen. WhatsApp should be used only when it is an eligible and supported option for the customer.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_gunun-firsatlari.png" alt="@(tr?"Pika Günün Fırsatları ekranı":"Pika Daily Opportunities screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Günün Fırsatları":"Daily Opportunities")</small><h3>@(tr?"Kanal seçmeden önce fırsatın nedenini görün":"See why the opportunity exists before choosing the channel")</h3><p>@(tr?"Müşteri, ürün ve zamanlama bağlamı doğru iletişim kararının başlangıç noktasıdır." : "Customer, product and timing context should come before the channel decision.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_aksiyon-calisma-alani_9.png" alt="@(tr?"Pika aksiyon çalışma alanı":"Pika action workspace")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Aksiyon hazırlığı":"Action preparation")</small><h3>@(tr?"Fırsat bağlamını mesajlaşma hazırlığına taşıyın":"Carry opportunity context into messaging preparation")</h3><p>@(tr?"WhatsApp, Campaign veya Journey içindeki kontrollü aksiyonlardan biri olabilir; fırsatın kendisi kanal seçimini otomatikleştirmez." : "WhatsApp can be one controlled action inside Campaign or Journey; the opportunity itself does not automatically choose the channel.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">@(tr?"Şablon ve içerik":"Template and content")</span><h2>@(tr?"WhatsApp mesajını kanalın desteklenen operasyon kuralları içinde hazırlayın.":"Prepare WhatsApp messages within supported channel operations.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"WhatsApp iletişiminde şablon ve mesaj türü, kullanılan sağlayıcı/hesap yapısı ve güncel kanal koşullarına bağlı olabilir. Pika yalnız uygulamada doğrulanmış akışları sunmalı; desteklenmeyen mesaj tipi, medya veya platform özelliği varmış gibi pazarlama iddiası üretmemelidir.":"WhatsApp template/message types can depend on provider/account setup and current channel rules. Pika should expose only verified flows and should not claim unsupported message types, media or platform features.")</p></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-file-copy-2-line"></i><div><strong>@(tr?"Şablon seçimi":"Template selection")</strong><span>@(tr?"Desteklenen ve ilgili kampanya/Journey senaryosuna uygun şablonu kullanın." : "Use a supported template appropriate for the Campaign/Journey scenario.")</span></div></div><div class="pk-control-step"><i class="ri-message-3-line"></i><div><strong>@(tr?"Mesaj bağlamı":"Message context")</strong><span>@(tr?"Müşteri/fırsat nedenini mesaj diline taşırken marka ve teklif doğruluğunu koruyun." : "Preserve brand and offer accuracy when translating customer/opportunity context into copy.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-user-follow-line"></i><div><strong>@(tr?"Kullanıcı kontrolü":"User review")</strong><span>@(tr?"AI taslağı varsa kullanıcı gözden geçirir; şablon ve yayınlama kararı kontrollü kalır." : "If AI assists with drafting, the user reviews it; template and publishing decisions remain controlled.")</span></div></div><div class="pk-control-step"><i class="ri-route-line"></i><div><strong>Campaign / Journey</strong><span>@(tr?"Mesaj doğru aksiyon adımında yürütülür." : "The message executes at the appropriate action step.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">WhatsApp + Journey</span><h2>@(tr?"Mesajlaşmayı müşteri akışının doğru anına yerleştirin.":"Place messaging at the right moment in the customer flow.")</h2></div><p class="pk-lead">@(tr?"Journey içinde WhatsApp adımı, tetikleyici, karar ve bekleme mantığının sonucudur. Müşteri kanal için uygun değilse veya farklı bir koşula sahipse başka bir yol izlenebilir. Böylece Journey kanala değil, müşteri durumuna göre ilerler.":"A WhatsApp step in Journey is the result of trigger, decision and wait logic. If the customer is not eligible for the channel or meets different conditions, another path can be followed. The Journey follows customer context, not the channel.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_journey-tasarim-tuvali_18.png" alt="@(tr?"Pika Journey tasarım tuvali ve WhatsApp aksiyonu":"Pika Journey canvas with WhatsApp action context")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Journey Manager</small><h3>Trigger → Decision → Wait → WhatsApp</h3><p>@(tr?"WhatsApp'ı doğru koşul ve zamanlama sonucunda çalışan Journey adımı olarak kullanın." : "Use WhatsApp as a Journey step reached through the right conditions and timing.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_izin-kanal-zamanlama_25.png" alt="@(tr?"Pika WhatsApp izin ve kanal uygunluğu":"Pika WhatsApp consent and eligibility")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Consent Management</small><h3>@(tr?"Kanal uygunluğunu akıştan bağımsız varsaymayın":"Do not assume channel eligibility")</h3><p>@(tr?"İzin, opt-out ve ulaşılabilirlik mesajlaşma aksiyonunun ayrı kontrol katmanıdır." : "Consent, opt-out and reachability remain separate controls for messaging.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">WhatsApp → Measure</span><h2>@(tr?"Mesaj gönderildi mi sorusunu, sonuç ne oldu sorusundan ayırın.":"Separate 'was it sent?' from 'what happened?'")</h2></div><p class="pk-lead">@(tr?"WhatsApp için uygulamada desteklenen gönderim/teslim/etkileşim sinyalleri ilgili provider ve kanal kabiliyetine göre değişebilir. Analytics yalnız doğrulanmış sonuçları göstermeli; desteklenmeyen event veya satış nedenselliği varmış gibi davranmamalıdır.":"Supported WhatsApp delivery and engagement signals can vary by provider and channel capabilities. Analytics should show only verified outcomes and should not imply unsupported events or sales causality.")</p></div><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/analytics":"/en/platform/analytics")">Analytics</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/gunun-firsatlari":"/en/platform/opportunities")">@(tr?"Günün Fırsatları":"Daily Opportunities")</a></div></div></section>

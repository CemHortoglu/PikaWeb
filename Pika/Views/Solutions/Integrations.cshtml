@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]=(tr?"Entegrasyonlar":"Integrations")+" | Pika";
    ViewData["MetaDescription"]=tr?"Pika Entegrasyonlar ile Excel/CSV kontrollü başlangıçtan düzenli API akışına; müşteri, ürün ve satış verisini eşleyin, doğrulayın ve analitiğe hazırlayın.":"Use Pika Integrations to move from controlled Excel/CSV onboarding to regular API flows, mapping, validating and preparing customer, product and sales data for analytics.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">Platform · @(tr?"Entegrasyonlar":"Integrations")</span><h1>@(tr?"Mevcut verinizden başlayın; altyapıyı bir gecede değiştirmeyin.":"Start with the data you have; do not replace your stack overnight.")</h1><p>@(tr?"Pika'nın veri entegrasyonu yaklaşımı, uygun senaryolarda kontrollü Excel/CSV aktarımıyla başlayıp ihtiyaç doğrulandığında düzenli API veya sistem entegrasyonuna genişleyebilir. Veri alma, alan eşleme, doğrulama ve analitiğe hazırlama birbirinden ayrı adımlardır; ham veriyi doğrudan 'müşteri zekâsı' saymaz.":"Pika can start with controlled Excel/CSV onboarding where appropriate and expand to regular API or system integrations once the use case is validated. Ingestion, field mapping, validation and analytical preparation are separate steps; raw data is not automatically treated as customer intelligence.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Entegrasyonunuzu Konuşalım":"Discuss Your Integration")</button><a class="pk-btn pk-btn-ghost" href="/wiki/veri-entegrasyon-genel">@(tr?"Entegrasyon rehberi":"Integration guide")</a></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_excel-csv-aktarimi_1.png" alt="@(tr?"Pika Excel CSV aktarım ekranı":"Pika Excel CSV import screen")" width="1200" height="760" /><div class="pk-stage-caption"><strong>@(tr?"Kontrollü veri alımı":"Controlled onboarding")</strong><span>@(tr?"Dosya · Eşleme · Doğrulama":"File · Mapping · Validation")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-file-excel-2-line"></i><div><strong>Excel / CSV</strong><small>@(tr?"Hızlı kontrollü başlangıç":"Fast controlled start")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-code-box-line"></i><div><strong>API</strong><small>@(tr?"Düzenli veri akışı":"Regular data flow")</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-checkbox-circle-line"></i><div><strong>@(tr?"Doğrulama":"Validation")</strong><small>@(tr?"Kaliteyi görünür kıl":"Make quality visible")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Entegrasyon modeli":"Integration model")</span><h2>@(tr?"Veriyi almakla veriyi anlamak aynı iş değildir.":"Receiving data and understanding it are different jobs.")</h2></div><p class="pk-lead">@(tr?"Pika önce veriyi güvenilir biçimde alır, kaynak alanları Pika'nın kavramsal alanlarına eşler, satır ve ilişki kontrollerini yapar; ardından müşteri ve ürün bağlamını çözümler ve ilgili analitik için hazırlar. Bu ayrım, hatalı verinin sessizce doğruymuş gibi analitiğe girmesini azaltır.":"Pika first receives data reliably, maps source fields into Pika concepts, validates rows and relationships, resolves customer/product context and then prepares data for relevant analytics. This separation helps prevent bad input from silently becoming trusted analysis.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-download-cloud-2-line"></i><strong>@(tr?"Kaynağı al":"Receive source")</strong><span>Excel · CSV · API</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-arrow-left-right-line"></i><strong>@(tr?"Alanları eşleştir":"Map fields")</strong><span>@(tr?"Kaynak alan → Pika alanı":"Source field → Pika field")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-checkbox-circle-line"></i><strong>@(tr?"Doğrula":"Validate")</strong><span>@(tr?"Format · zorunlu alan · ilişki":"Format · required field · relationship")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-node-tree"></i><strong>@(tr?"Çözümle":"Resolve")</strong><span>@(tr?"Müşteri ve ürün eşleşmesi":"Customer and product resolution")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-radar-line"></i><strong>@(tr?"Analitiğe hazırla":"Prepare")</strong><span>@(tr?"İlgili intelligence bağlamı":"Relevant intelligence context")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-loop-right-line"></i><strong>@(tr?"Süreklilik":"Operationalize")</strong><span>@(tr?"Düzenli ve izlenebilir akış":"Regular, observable flow")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Hangi veri?":"Which data?")</span><h2>@(tr?"'Çok veri' değil, doğru ilişkiler gerekir.":"The goal is not more data, but the right relationships.")</h2></div><p class="pk-lead">@(tr?"Birçok Pika senaryosunun başlangıcı müşteriyi ayırt eden kimlik, ürün/hizmet kimliği ve gerçekleşmiş satış/fatura/sipariş geçmişidir. Mağaza, kanal, kampanya ve etkileşim verileri ilgili analitiği güçlendirebilir. Minimum gereksinim kullanılan kabiliyete göre değişir; her modül için aynı veri seti zorunlu değildir.":"Many Pika scenarios start with customer identity, product/service identity and observed sales/invoice/order history. Store, channel, campaign and engagement data can strengthen relevant analytics. Minimum requirements vary by capability; one universal dataset is not required for everything.")</p></div><div class="pk-intel-grid"><article class="pk-intel-panel"><span class="pk-intel-number">01</span><div class="pk-intel-icon"><i class="ri-user-3-line"></i></div><h3>@(tr?"Müşteri":"Customer")</h3><p>@(tr?"Müşteriyi güvenilir biçimde ayırt etmek için gerekli kimlik ve desteklenen iletişim alanları. Aynı kişi farklı kaynaklarda geliyorsa eşleme yaklaşımı önem kazanır." : "Identity and supported contact fields required to distinguish customers reliably. Resolution becomes important when the same person appears across sources.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">02</span><div class="pk-intel-icon"><i class="ri-shopping-bag-3-line"></i></div><h3>@(tr?"Ürün":"Product")</h3><p>@(tr?"Ürün kodu/kimliği, ad, kategori ve varsa master ürün ilişkisi Product Intelligence için temel bağlamdır. Eşleşmeyen ürünler güvenilir ilişki kanıtını zayıflatabilir." : "Product identity/code, name, category and master-product context support Product Intelligence. Unresolved products can weaken reliable relationship evidence.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">03</span><div class="pk-intel-icon"><i class="ri-receipt-line"></i></div><h3>@(tr?"Satış / sipariş":"Sales / order")</h3><p>@(tr?"Tarih, müşteri, ürün, miktar/tutar ve ilgili belge/sepet ilişkisi tekrar satın alma, değer ve cross-sell gibi senaryoların temel kanıtını oluşturabilir." : "Date, customer, product, quantity/value and document/basket relationships can provide evidence for repeat purchase, value and cross-sell scenarios.")</p></article></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">Excel / CSV → API</span><h2>@(tr?"İlk değeri görmek için aylarca entegrasyon beklemeyin.":"Do not wait months for integration before validating value.")</h2></div><p class="pk-lead">@(tr?"Uygun senaryoda örnek müşteri, ürün ve satış verisini kontrollü Excel/CSV aktarımıyla Pika'ya taşıyıp analitik/fırsat yaklaşımını doğrulamak mümkündür. Süreklilik ve ölçek gerektiğinde aynı kavramsal veri modeli düzenli API veya sistem entegrasyonuyla beslenir.":"Where appropriate, sample customer, product and sales data can be imported through controlled Excel/CSV onboarding to validate analytical and opportunity use cases. Once continuity and scale matter, the same conceptual data model can be fed by regular API or system integrations.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_excel-csv-aktarimi_1.png" alt="@(tr?"Pika Excel CSV veri aktarım ekranı":"Pika Excel CSV data import screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Excel / CSV</small><h3>@(tr?"Kontrollü başlangıç":"Controlled start")</h3><p>@(tr?"Dosyayı seçin, alanları eşleyin ve doğrulama sonuçlarını kontrol edin. Dosya yüklenmesi otomatik olarak verinin analitiğe uygun olduğu anlamına gelmez." : "Select the file, map fields and review validation results. Uploading a file does not automatically mean the data is analytically ready.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_satis-veri-operasyonlari_2.png" alt="@(tr?"Pika satış veri operasyonları ekranı":"Pika sales data operations screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Düzenli veri operasyonu":"Ongoing data operations")</small><h3>@(tr?"Sürekliliği görünür kılın":"Make continuity observable")</h3><p>@(tr?"Düzenli akışta veri sadece gelmemeli; eşleme ve kalite sorunları da operasyon ekibinin takip edebileceği şekilde görünür olmalıdır." : "In ongoing flows, data should not merely arrive; resolution and quality issues should remain visible to operations.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Veri kalitesi":"Data quality")</span><h2>@(tr?"Eşleşmeyen kayıtları güvenilir analizmiş gibi göstermeyin.":"Do not present unresolved records as reliable analysis.")</h2></div><p class="pk-lead">@(tr?"Müşteri veya ürün eşleşmesi eksik olduğunda ilgili metriğin kapsaması ve karar değeri düşebilir. Pika'nın veri operasyonları bu belirsizliği mümkün olduğunda görünür kılmalı; eksik kayıtlar otomatik olarak doğru müşteri veya ürün davranışı sayılmamalıdır.":"When customer or product resolution is incomplete, metric coverage and decision value can drop. Pika's data operations should make that uncertainty visible where possible; unresolved records should not automatically be treated as trustworthy customer or product behavior.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-file-list-3-line"></i><strong>@(tr?"Ham veri":"Raw data")</strong><span>@(tr?"Kaynak sistemden geldi":"Received from source")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-error-warning-line"></i><strong>@(tr?"Kalite kontrolü":"Quality checks")</strong><span>@(tr?"Eksik / format / ilişki":"Missing / format / relationship")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-node-tree"></i><strong>@(tr?"Eşleme":"Resolution")</strong><span>@(tr?"Gerçek müşteri / ürün bağlamı":"Real customer / product context")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-eye-line"></i><strong>@(tr?"İnceleme":"Review")</strong><span>@(tr?"Belirsizliği görünür kıl":"Make uncertainty visible")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-radar-line"></i><strong>Intelligence</strong><span>@(tr?"Yeterli kanıt varsa hesapla":"Calculate when evidence is sufficient")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Fırsat":"Opportunity")</strong><span>@(tr?"Güvenilir bağlamdan aksiyon adayı":"Action candidate from reliable context")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">@(tr?"Entegrasyon kapsamı":"Integration scope")</span><h2>@(tr?"Her müşteriye aynı entegrasyon reçetesini uygulamayın.":"Do not force the same integration recipe on every customer.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Başlangıç senaryosu, mevcut veri kalitesi, sistem mimarisi ve hedeflenen Pika kabiliyeti entegrasyonun kapsamını belirler. Yalnız Customer Intelligence pilotu ile tam omnichannel operasyonun veri gereksinimleri aynı olmayabilir.":"The initial use case, current data quality, system architecture and target Pika capability should define integration scope. A Customer Intelligence pilot may not require the same data as a full omnichannel operation.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="/wiki/ozellik-veri-gereksinimleri">@(tr?"Özellik → Veri Gereksinimleri":"Capability → Data Requirements")</a></div></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-focus-3-line"></i><div><strong>@(tr?"Senaryoyu seçin":"Choose the scenario")</strong><span>@(tr?"İlk hangi iş sorusunu çözmek istediğinizi belirleyin." : "Define the first business question you want to solve.")</span></div></div><div class="pk-control-step"><i class="ri-database-line"></i><div><strong>@(tr?"Mevcut veriyi görün":"Assess available data")</strong><span>@(tr?"Hangi alanların hazır, hangilerinin eksik olduğunu belirleyin." : "Identify which fields are available and which are missing.")</span></div></div><div class="pk-control-step"><i class="ri-file-excel-2-line"></i><div><strong>@(tr?"Kontrollü doğrulayın":"Validate quickly")</strong><span>@(tr?"Uygunsa dosya aktarımıyla kavramı ve veri kalitesini test edin." : "Where appropriate, use file onboarding to test the concept and data quality.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-code-box-line"></i><div><strong>@(tr?"Sürekliliği tasarlayın":"Design continuity")</strong><span>@(tr?"Değer doğrulandığında düzenli API/sistem akışını ihtiyaca göre kurun." : "Once value is validated, build the regular API/system flow according to need.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Veriden değere":"From data to value")</span><h2>@(tr?"Entegrasyon hedef değil, intelligence ve aksiyon için zemin.":"Integration is not the goal; it is the foundation for intelligence and action.")</h2></div><p class="pk-lead">@(tr?"Pika entegrasyonunun başarısı 'kaç endpoint bağlandı?' sorusuyla değil, güvenilir müşteri/ürün bağlamının hangi iş kararlarını desteklediğiyle değerlendirilmelidir.":"Pika integration success should not be judged by how many endpoints are connected, but by which business decisions reliable customer/product context can support.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-plug-line"></i><strong>@(tr?"Entegrasyon":"Integration")</strong><span>@(tr?"Veriyi güvenilir al":"Receive data reliably")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-checkbox-circle-line"></i><strong>@(tr?"Kalite":"Quality")</strong><span>@(tr?"Eşle ve doğrula":"Map and validate")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-radar-line"></i><strong>Intelligence</strong><span>@(tr?"Müşteri ve ürünü anla":"Understand customers and products")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Fırsat":"Opportunity")</strong><span>@(tr?"Aksiyon adayını gör":"See actionable situations")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-route-line"></i><strong>Campaign / Journey</strong><span>@(tr?"Kontrollü yürüt":"Execute with control")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>Analytics</strong><span>@(tr?"Sonucu değerlendir":"Review outcomes")</span></div></div><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/customer-intelligence":"/en/platform/customer-intelligence")">Customer Intelligence</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/product-intelligence":"/en/platform/product-intelligence")">Product Intelligence</a></div></div></section>

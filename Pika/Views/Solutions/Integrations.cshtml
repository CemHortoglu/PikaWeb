@{
    var tr = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = tr ? "Entegrasyonlar | Pika Entegrasyon ve Veri Akışı Yaklaşımı" : "Integrations | Pika Integration and Data Flow Approach";
    ViewData["MetaDescription"] = tr ? "Pika'nın veri kaynakları, olay bazlı akışlar ve kurumsal sistemlerle entegrasyon yaklaşımını keşfedin." : "Discover Pika's integration approach with data sources, event-based flows, and enterprise systems.";
    ViewData["MetaKeywords"] = "integrations,api,event,data flow,modular,crm,automation";
}

<!-- Hero -->
@await Html.PartialAsync("_MarketingHero")

<!-- Yaklaşım -->
<section class="pika-sol-section text-center text-muted fs-5">
    <div class="container pb-4">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Entegrasyonu sonradan eklenen özellik değil, platform katmanı olarak ele alıyoruz" : "We treat integration as a platform layer, not an afterthought")</h2>
        <p data-aos="fade-up" data-aos-delay="100" style="max-width: 800px; margin: 0 auto;">
            @(tr ? "Pika, yalnızca arayüzde çalışan bir kampanya aracı değil; veriyle beslenen, olaylarla tetiklenen ve kurumsal süreçlerle birlikte çalışabilen bir platform yaklaşımıyla geliştirilmiştir." : "Pika is not just a campaign tool that runs on the UI; it is built with a platform approach that is fed by data, triggered by events, and works alongside enterprise processes.")
        </p>
    </div>
    <div class="container pt-4 border-top">
        <h2 class="pika-sol-section-title mt-4" data-aos="fade-up">@(tr ? "Entegrasyon, platform değerini büyütür" : "Integration amplifies platform value")</h2>
        <p data-aos="fade-up" data-aos-delay="100" style="max-width: 800px; margin: 0 auto;">
            @(tr ? "Veri içeri girmiyorsa segmentasyon zayıflar. Olaylar sisteme ulaşmıyorsa otomasyon sınırlanır. Entegrasyon, Pika'nın kampanya ve müşteri yolculuğu gücünü gerçek iş akışlarına bağlayan katmandır." : "If data doesn't come in, segmentation weakens. If events don't reach the system, automation is limited. Integration is the layer that connects Pika's campaign and customer journey power to real business workflows.")
        </p>
    </div>
</section>

<!-- İhtiyaçlar -->
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Pika hangi entegrasyon ihtiyaçlarına uyum sağlar?" : "What integration needs does Pika accommodate?")</h2>
        <div class="pika-sol-card-grid mt-4">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-database-2-line"></i></div>
                <h4>@(tr ? "Veri kaynakları" : "Data sources")</h4>
                <p>@(tr ? "Müşteri, işlem ve davranış verilerinin taşınması." : "Transporting customer, transaction, and behavioral data.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-flashlight-line"></i></div>
                <h4>@(tr ? "Olay bazlı akışlar" : "Event-based flows")</h4>
                <p>@(tr ? "Gerçek zamanlı tetikleyiciler ve iş süreçleri." : "Real-time triggers and business processes.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-building-line"></i></div>
                <h4>@(tr ? "Kurumsal sistemler" : "Enterprise systems")</h4>
                <p>@(tr ? "CRM, pazarlama ve operasyonel sistemlerle bütünlük." : "Continuity with CRM, marketing, and operational systems.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-code-s-slash-line"></i></div>
                <h4>@(tr ? "API odaklı yaklaşım" : "API-centric approach")</h4>
                <p>@(tr ? "Esnek veri alışverişi için uygun mimari." : "Suitable architecture for flexible data exchange.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-group-line"></i></div>
                <h4>@(tr ? "Segmentasyon besleme" : "Segmentation enrichment")</h4>
                <p>@(tr ? "Kitlelerin dış veriyle zenginleşmesi." : "Enriching audiences with external data.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-send-plane-line"></i></div>
                <h4>@(tr ? "Çok kanallı aksiyon" : "Multi-channel actions")</h4>
                <p>@(tr ? "Kampanya ve journey süreçlerine bağlantı." : "Connection to campaign and journey processes.")</p>
            </div>
        </div>
    </div>
</section>

<!-- Şema/Mimari -->
<section class="pika-sol-section">
    <div class="container text-center">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Entegrasyonlar Pika platformunu nasıl besler?" : "How do integrations feed the Pika platform?")</h2>
        <p class="text-muted fs-5 mb-5" data-aos="fade-up" data-aos-delay="100" style="max-width: 800px; margin: 0 auto;">
            @(tr ? "Pika, tüm müşterilerin aynı veri yapısına sahip olmadığı gerçeğiyle tasarlanır. Entegrasyon yaklaşımı modüler ve büyümeye açıktır." : "Pika is designed with the understanding that not all customers have the same data structure. The integration approach is modular and scalable.")
        </p>

        <div class="row align-items-center justify-content-center" data-aos="fade-up" data-aos-delay="200">
            <div class="col-md-3">
                <div class="pika-sol-card text-center p-4 border-0" style="background:#f8f9fa;">
                    <i class="ri-database-2-line fs-1 text-primary d-block mb-2"></i>
                    <h5 class="mb-0">@(tr ? "Veri Kaynakları" : "Data Sources")</h5>
                    <small class="text-muted">CRM, POS, Web, App</small>
                </div>
            </div>
            <div class="col-md-1 d-none d-md-block"><i class="ri-arrow-right-fill fs-2 text-muted"></i></div>
            <div class="col-md-4">
                <div class="pika-sol-card text-center p-4" style="border: 2px solid var(--bs-primary); background: #f0f7ff;">
                    <h5 class="mb-1">Pika Platform</h5>
                    <p class="mb-0 small text-muted">Campaign · Audience<br/>Journey · Analytics · Consent</p>
                </div>
            </div>
            <div class="col-md-1 d-none d-md-block"><i class="ri-arrow-right-fill fs-2 text-muted"></i></div>
            <div class="col-md-3">
                <div class="pika-sol-card text-center p-4 border-0" style="background:#f8f9fa;">
                    <i class="ri-send-plane-line fs-1 text-primary d-block mb-2"></i>
                    <h5 class="mb-0">@(tr ? "Kanallar" : "Channels")</h5>
                    <small class="text-muted">SMS, Email, WhatsApp, Push</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Kullanım Senaryoları -->
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Örnek entegrasyon senaryoları" : "Example integration scenarios")</h2>
        <div class="pika-sol-usecase-grid mt-4">
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="50"><i class="ri-check-line text-primary"></i> @(tr ? "İşlem verisinden segment üretimi" : "Segment generation from transaction data")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="100"><i class="ri-check-line text-primary"></i> @(tr ? "Müşteri davranışına göre journey başlatma" : "Start journey based on customer behavior")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="150"><i class="ri-check-line text-primary"></i> @(tr ? "Harici sistemden gelen olayla kampanya tetikleme" : "Trigger campaign from external system event")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="200"><i class="ri-check-line text-primary"></i> @(tr ? "Kanal izinlerini merkezde yönetme" : "Centrally manage channel consents")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="250"><i class="ri-check-line text-primary"></i> @(tr ? "Kampanya sonuçlarını raporlama süreçlerine bağlama" : "Connect campaign results to reporting processes")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="300"><i class="ri-check-line text-primary"></i> @(tr ? "Veri akışını modüller arasında kullanma" : "Use data flow across modules")</div>
        </div>
    </div>
</section>

<!-- SSS -->
<section class="pika-sol-section">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Sıkça Sorulan Sorular" : "Frequently Asked Questions")</h2>
        <div class="row justify-content-center">
            <div class="col-lg-8" data-aos="fade-up" data-aos-delay="100">
                <div class="accordion" id="intFaq">
                    @{
                        var intFaqs = tr
                            ? new[] {
                                ("Pika farklı veri kaynaklarıyla çalışabilir mi?", "Evet. Pika, farklı veri kaynaklarından gelen müşteri, işlem ve davranış verilerini platforma entegre edebilecek şekilde tasarlanmıştır."),
                                ("Olay bazlı entegrasyon mantığı var mı?", "Evet. Gerçek zamanlı tetikleyiciler ve olay bazlı akışlar, platform mimarisinin temel parçalarındandır."),
                                ("Platform farklı modülleri aynı veriyle besleyebilir mi?", "Evet. Entegrasyon katmanı üzerinden gelen veriler; kampanya, segmentasyon, journey ve raporlama modüllerinde kullanılabilir."),
                                ("Kampanya süreçleri entegrasyonlarla desteklenebilir mi?", "Evet. Dış sistemlerden gelen olaylar ve veriler, kampanya tetikleme ve kişiselleştirme süreçlerini doğrudan besleyebilir."),
                                ("Entegrasyon yaklaşımı modüler midir?", "Evet. Her müşterinin farklı veri yapısına sahip olabileceği göz önünde bulundurularak modüler ve esnek bir entegrasyon mimarisi benimsenmiştir.")
                            }
                            : new[] {
                                ("Can Pika work with different data sources?", "Yes. Pika is designed to integrate customer, transaction, and behavioral data from various data sources into the platform."),
                                ("Is there an event-based integration model?", "Yes. Real-time triggers and event-based flows are fundamental parts of the platform architecture."),
                                ("Can the platform feed different modules with the same data?", "Yes. Data coming through the integration layer can be used in campaign, segmentation, journey, and reporting modules."),
                                ("Can campaign processes be supported by integrations?", "Yes. Events and data from external systems can directly feed campaign triggering and personalization processes."),
                                ("Is the integration approach modular?", "Yes. A modular and flexible integration architecture is adopted, considering that each customer may have a different data structure.")
                            };
                    }
                    @for (var i = 0; i < intFaqs.Length; i++)
                    {
                        <div class="accordion-item">
                            <h3 class="accordion-header"><button class="accordion-button @(i > 0 ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#intFaq@(i)">@intFaqs[i].Item1</button></h3>
                            <div id="intFaq@(i)" class="accordion-collapse collapse @(i == 0 ? "show" : "")" data-bs-parent="#intFaq"><div class="accordion-body text-muted">@intFaqs[i].Item2</div></div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container text-center">
        <h2 style="margin-bottom: 0.5rem;" data-aos="fade-up">@(tr ? "Pika'yı mevcut yapınıza nasıl konumlayacağımızı birlikte değerlendirelim" : "Let's evaluate together how to position Pika in your existing infrastructure")</h2>
        <p class="fs-5 text-muted mb-4" data-aos="fade-up" data-aos-delay="100">@(tr ? "Entegrasyon ihtiyaçlarınızı konuşmak ve uygun yapıyı planlamak için bizimle iletişime geçin." : "Contact us to discuss your integration needs and plan the right architecture.")</p>
        <div class="d-flex gap-3 justify-content-center" data-aos="fade-up" data-aos-delay="200">
            <a href="@Url.Action("Contact", "Home")" class="btn pika-btn-primary px-4 py-2">@(tr ? "İletişime Geçin" : "Contact Us") <i class="ri-arrow-right-up-line"></i></a>
            <a href="@Url.Action("SecurityPrivacy", "Solutions")" class="btn pika-btn-outline px-4 py-2">@(tr ? "Güvenlik Yaklaşımını İncele" : "Explore Security Approach")</a>
        </div>
    </div>
</section>
                    </div>
                </div>

                <p class="fw-bold mb-0">
                    @(tr
                        ? "Entegrasyon, aksiyonun veri temelidir. Aksiyonun kendisi değildir."
                        : "Integration is the data foundation for action. It is not the action itself.")
                </p>
            </div>
        </div>
    </div>
</section>


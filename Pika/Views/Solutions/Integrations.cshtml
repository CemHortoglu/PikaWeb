@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-platform-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-integrations-page.css" asp-append-version="true" />
}

@* ── 01 HERO ─────────────────────────────────────────────────── *@
<section class="inner-hero inner-hero--data">
    <div class="inner-hero-grid-overlay" aria-hidden="true"></div>
    <div class="inner-hero-orbit" aria-hidden="true"></div>
    <div class="inner-hero-grid-overlay" aria-hidden="true"></div>
    <div class="inner-hero-orbit" aria-hidden="true"></div>
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span>/</span>
                <span>@(tr ? "Entegrasyonlar" : "Integrations")</span>
            </nav>
            <div class="inner-eyebrow"><span></span>@(tr ? "ENTEGRASYONLAR" : "INTEGRATIONS") · Data &amp; Ingestion</div>
            @if (tr)
            {
                <h1>
                    Müşteri, ürün ve işlem verisini<br />
                    Pika'nın karar zincirine bağlayın.
                </h1>
                <p>
                    Pika Entegrasyonlar; müşteri, ürün ve işlem verilerini asenkron REST Ingestion API ve Excel/CSV içe aktarma akışlarıyla platforma taşıyarak Customer Intelligence, Product Intelligence ve sonraki karar katmanlarının kullanabileceği veri temelini oluşturur.
                </p>
                <p class="text-muted small">
                    Amaç her kaynak sistem için hazır bir native connector varmış gibi davranmak değil; Pika'nın doğrulanmış veri kontratları ve aktarım yolları üzerinden kontrollü bir veri girişi sağlamaktır.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">Demo Talep Et ↗</button>
                    <a class="inner-secondary" href="/platform/customer-intelligence">Customer Intelligence'ı Keşfedin →</a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="İçeriğe atla"><i class="ri-arrow-down-line" aria-hidden="true"></i></a>
                </div>
            }
            else
            {
                <h1>
                    Connect customer, product<br />
                    and transaction data<br />
                    to Pika's decision chain.
                </h1>
                <p>
                    Pika Integrations brings customer, product and transaction data into the platform through an asynchronous REST Ingestion API and Excel/CSV import flows, creating the data foundation used by Customer Intelligence, Product Intelligence and downstream decision layers.
                </p>
                <p class="text-muted small">
                    The objective is not to imply that every source system has a ready-made native connector. It is to provide controlled data intake through Pika's documented data contracts and ingestion paths.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">Request a Demo ↗</button>
                    <a class="inner-secondary" href="/en/platform/customer-intelligence">Explore Customer Intelligence →</a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="Skip to content"><i class="ri-arrow-down-line" aria-hidden="true"></i></a>
                </div>
            }
        </div>

        <div class="inner-scene" aria-label="@(tr ? "Platformun çalışma biçimini anlatan örnek görünüm" : "Illustrative view of how the platform works")">
            <div class="inner-scene-orbit" aria-hidden="true"></div>
            <div class="inner-scene-window">
                <div class="inner-window-bar">
                    <strong>pika<span>✳</span></strong>
                    <span>@(tr ? "Entegrasyonlar" : "Integrations")</span>
                    <small>@(tr ? "Örnek görünüm" : "Illustration")</small>
                </div>
                <div class="intg-hero-pills" aria-hidden="true">
                    @if (tr)
                    {
                        <span class="intg-hero-pill">KAYNAK VERİ</span>
                        <span class="intg-hero-pill">API / DOSYA</span>
                        <span class="intg-hero-pill">MÜŞTERİ</span>
                        <span class="intg-hero-pill">ÜRÜN</span>
                        <span class="intg-hero-pill">İŞLEM</span>
                        <span class="intg-hero-pill">PIKA</span>
                    }
                    else
                    {
                        <span class="intg-hero-pill">SOURCE DATA</span>
                        <span class="intg-hero-pill">API / FILE</span>
                        <span class="intg-hero-pill">CUSTOMER</span>
                        <span class="intg-hero-pill">PRODUCT</span>
                        <span class="intg-hero-pill">TRANSACTION</span>
                        <span class="intg-hero-pill">PIKA</span>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<div class="inner-trust-ribbon">
    <div class="container">
        <div class="inner-trust-ribbon__items">
            <div class="inner-trust-ribbon__item">
                <i class="ri-whatsapp-line" aria-hidden="true"></i>
                <div>
                    <strong>WhatsApp Business API</strong>
                    <span>@(tr ? "Resmi Meta API" : "Official Meta API")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-mail-send-line" aria-hidden="true"></i>
                <div>
                    <strong>Email &amp; SMS</strong>
                    <span>@(tr ? "Doğrulanmış Kanallar" : "Verified Channels")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-focus-3-line" aria-hidden="true"></i>
                <div>
                    <strong>Pika Opportunity Engine</strong>
                    <span>@(tr ? "Günlük Algoritmik Tespit" : "Daily Discovery")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-shield-check-line" aria-hidden="true"></i>
                <div>
                    <strong>İYS &amp; KVKK</strong>
                    <span>@(tr ? "İzin Denetimi" : "Consent Verification")</span>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="inner-content" class="inner-anchor"></div>

@* ── STICKY SUBNAV ────────────────────────────────────────────── *@
<div class="pika-sol-subnav-wrap">
    <div class="container">
        <nav class="pika-sol-subnav" aria-label="@(tr ? "Sayfa içi gezinti" : "In-page navigation")">
            <a href="#overview">@(tr ? "Genel Bakış" : "Overview")</a>
            <a href="#data">@(tr ? "Veri" : "Data")</a>
            <a href="#file-import">@(tr ? "Dosya Aktarımı" : "File Import")</a>
            <a href="#rest-api">REST API</a>
            <a href="#processing">@(tr ? "İşleme" : "Processing")</a>
            <a href="#platform-relationship">@(tr ? "Platform İlişkisi" : "Platform Relationships")</a>
            <a href="#faq">@(tr ? "SSS" : "FAQ")</a>
        </nav>
    </div>
</div>

@* ── TRUST STRIP ──────────────────────────────────────────────── *@
<section class="pika-sol-section py-4">
    <div class="container">
        <div class="pika-sol-trust-strip" data-aos="fade-up">
            <div class="pika-sol-trust-item"><i class="ri-user-line"></i><span>@(tr ? "Müşteri Verisi" : "Customer Data")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-shopping-bag-3-line"></i><span>@(tr ? "Ürün Verisi" : "Product Data")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-exchange-dollar-line"></i><span>@(tr ? "İşlem Verisi" : "Transaction Data")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-code-s-slash-line"></i><span>REST API</span></div>
            <div class="pika-sol-trust-item"><i class="ri-file-excel-2-line"></i><span>Excel / CSV</span></div>
        </div>
    </div>
</section>

@* ── 02 DIRECT ANSWER ─────────────────────────────────────────── *@
<section class="pika-sol-section" id="overview">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="pika-sol-eyebrow text-uppercase mb-2">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</div>
                <h2 class="pika-h2 fw-bold mb-4">@(tr ? "Pika Entegrasyonlar nedir?" : "What are Pika Integrations?")</h2>

                <p class="lead mb-4">
                    @(tr
                        ? "Entegrasyonlar, müşteri, ürün ve işlem verilerinin Pika'ya taşınmasını sağlayan veri ve ingestion katmanıdır."
                        : "Integrations is Pika's data and ingestion layer for bringing customer, product and transaction data into the platform.")
                </p>

                <p class="mb-4">
                    @(tr
                        ? "Doğrulanmış aktarım yolları arasında Excel/CSV batch import akışları ve /api/v1/ingest/ altında çalışan asenkron REST Ingestion API bulunur."
                        : "Confirmed ingestion paths include Excel/CSV batch-import flows and the asynchronous REST Ingestion API under /api/v1/ingest/.")
                </p>

                <p class="mb-2">
                    @(tr
                        ? "Entegrasyonların temel sorusu şudur:"
                        : "Integrations answers one central question:")
                </p>

                <div class="intg-question-box">
                    <h3 class="mb-0">
                        @(tr
                            ? "“Veri Pika'ya nasıl girer ve hangi karar bağlamını besler?”"
                            : "“How does data enter Pika, and which decision context does it feed?”")
                    </h3>
                </div>

                <p class="mb-4">
                    @(tr
                        ? "Entegrasyon katmanı müşteriyi analiz etmez, ticari fırsatı üretmez ve kampanya göndermez."
                        : "The integration layer does not analyze the customer, create the commercial opportunity or send the campaign.")
                </p>

                <p class="fw-semibold mb-0">
                    @(tr
                        ? "Bu katman, sonraki intelligence ve aksiyon ürünlerinin kullanacağı veriyi platforma taşır."
                        : "It brings data into the platform for downstream intelligence and action products.")
                </p>
            </div>
        </div>
    </div>
</section>

@* ── 03 WHY DATA COMES FIRST ──────────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="pika-sol-eyebrow text-uppercase mb-2">@(tr ? "ÖNCE VERİ" : "DATA FIRST")</div>
                <h2 class="pika-h2 fw-bold mb-4">
                    @(tr
                        ? "Pika'nın başlangıç noktası mesaj göndermek değil, anlamaktır."
                        : "Pika's starting point is not sending messages. It is understanding.")
                </h2>

                <p class="mb-4">
                    @(tr
                        ? "Customer Intelligence, Product Intelligence ve Günün Fırsatları gibi karar katmanları kullanılabilir müşteri, ürün ve işlem bağlamına ihtiyaç duyar."
                        : "Decision layers such as Customer Intelligence, Product Intelligence and Daily Opportunities require usable customer, product and transaction context.")
                </p>

                <p class="mb-4">
                    @(tr
                        ? "Bu nedenle entegrasyon yalnızca teknik bir bağlantı konusu değildir. Pika'nın müşteriyi ve ürünü anlayabilmesi için gerekli verinin platforma nasıl girdiğini tanımlar."
                        : "Integration is therefore more than a technical connection problem. It defines how the data required for Pika to understand customers and products enters the platform.")
                </p>

                <p class="mb-4">
                    @(tr
                        ? "Veri platforma girdikten sonra ilgili doğrulama, çözümleme ve analitik süreçlerden geçerek sonraki karar katmanlarını besleyebilir."
                        : "After data enters the platform, relevant validation, resolution and analytical processes can feed downstream decision layers.")
                </p>

                <div class="row g-3 my-4">
                    <div class="col-md-3">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-dark mb-2">@(tr ? "Önce" : "First")</span>
                            <p class="fw-bold mb-0">@(tr ? "VERİ" : "DATA")</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-dark mb-2">@(tr ? "Sonra" : "Then")</span>
                            <p class="fw-bold mb-0">@(tr ? "ANLAMA" : "UNDERSTANDING")</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-dark mb-2">@(tr ? "Sonra" : "Then")</span>
                            <p class="fw-bold mb-0">@(tr ? "FIRSAT / KARAR" : "OPPORTUNITY / DECISION")</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-dark mb-2">@(tr ? "En son" : "Finally")</span>
                            <p class="fw-bold mb-0">@(tr ? "KONTROLLÜ AKSİYON" : "CONTROLLED ACTION")</p>
                        </div>
                    </div>
                </div>

                <p class="fw-bold mb-0">
                    @(tr
                        ? "Entegrasyon, Pika'nın karar zincirinin giriş kapısıdır."
                        : "Integration is the entry point to Pika's decision chain.")
                </p>
            </div>
        </div>
    </div>
</section>

@* ── 04 CANONICAL DATA ENTITIES ───────────────────────────────── *@
<section class="pika-sol-section" id="data">
    <div class="container">
        <div class="row justify-content-center mb-4">
            <div class="col-lg-10 text-center">
                <div class="pika-sol-eyebrow text-uppercase mb-2">@(tr ? "ÜÇ TEMEL VERİ ALANI" : "THREE CORE DATA DOMAINS")</div>
                <h2 class="pika-h2 fw-bold mb-3">
                    @(tr
                        ? "Pika'nın veri temelini müşteri, ürün ve işlem bağlamıyla kurun."
                        : "Build Pika's data foundation with customer, product and transaction context.")
                </h2>
            </div>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="pika-sol-card h-100">
                    <div class="pika-sol-card-icon"><i class="ri-user-line"></i></div>
                    <h4>@(tr ? "Müşteri" : "Customer")</h4>
                    <p>
                        @(tr
                            ? "Müşteri kayıtları, ilgili kimlik ve iletişim alanlarıyla platformdaki müşteri bağlamının temel girdisini oluşturur."
                            : "Customer records, with relevant identity and communication fields, provide foundational input for customer context in the platform.")
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="pika-sol-card h-100">
                    <div class="pika-sol-card-icon"><i class="ri-shopping-bag-3-line"></i></div>
                    <h4>@(tr ? "Ürün" : "Product")</h4>
                    <p>
                        @(tr
                            ? "Ürün veya katalog kayıtları, Product Intelligence ve işlem bağlamının ürün tarafını besleyen temel veri alanıdır."
                            : "Product or catalog records provide the product-side foundation used by Product Intelligence and transaction context.")
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="pika-sol-card h-100">
                    <div class="pika-sol-card-icon"><i class="ri-exchange-dollar-line"></i></div>
                    <h4>@(tr ? "İşlem" : "Transaction")</h4>
                    <p>
                        @(tr
                            ? "Sipariş, satış veya işlem kayıtları müşterinin ne zaman ve ne satın aldığına ilişkin tarihsel bağlamı oluşturur."
                            : "Order, sales or transaction records provide historical context for what the customer purchased and when.")
                    </p>
                </div>
            </div>
        </div>

        <div class="row justify-content-center mt-4">
            <div class="col-lg-10">
                <p class="mb-3">
                    @(tr
                        ? "Davranış, değer, satın alma ritmi veya ticari fırsat bu kayıtların ham hali değildir. Bunlar Pika'nın sonraki intelligence ve decision katmanlarında hesaplanan bağlamlardır."
                        : "Behavior, value, purchase rhythm and commercial opportunity are not simply raw fields from those records. They are context calculated in Pika's downstream intelligence and decision layers.")
                </p>
                <div class="p-3 bg-white border rounded-3">
                    <p class="fw-bold mb-0">
                        @(tr
                            ? "Entegrasyon veriyi taşır. Intelligence, veriden anlam üretir."
                            : "Integration moves the data. Intelligence creates meaning from it.")
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 05 EXCEL / CSV IMPORT ────────────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="file-import">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="pika-sol-eyebrow text-uppercase mb-2">@(tr ? "DOSYA İLE AKTARIM" : "FILE IMPORT")</div>
                <h2 class="pika-h2 fw-bold mb-4">
                    @(tr
                        ? "API entegrasyonu gerekmeyen durumda, veriyi Excel veya CSV ile içe alın."
                        : "When API integration is not required, bring data in through Excel or CSV.")
                </h2>

                <p class="mb-3">
                    @(tr
                        ? "Pika müşteri, ürün ve sipariş / işlem kayıtlarının batch olarak aktarılabilmesi için Excel (.xlsx) ve CSV import akışlarını destekler."
                        : "Pika supports Excel (.xlsx) and CSV import flows for batch ingestion of customer, product and order / transaction records.")
                </p>

                <p class="mb-3">
                    @(tr
                        ? "Dosya aktarımı özellikle başlangıç veri yükü veya dosya tabanlı veri alışverişi kullanan süreçlerde Pika'ya veri giriş yollarından biridir."
                        : "File import is one way to bring data into Pika, particularly for initial data loads or processes that exchange data through files.")
                </p>

                <p class="mb-4">
                    @(tr
                        ? "Dosyanın bulunması tek başına verinin analize hazır olduğu anlamına gelmez. Alanların beklenen veri kontratına uygun olması ve ilgili doğrulama / eşleştirme süreçlerinden geçmesi gerekebilir."
                        : "Having a file does not by itself mean the data is analytically ready. Fields may need to follow the expected data contract and pass relevant validation or mapping processes.")
                </p>

                <div class="p-4 bg-white border rounded-3 mb-4">
                    <h5 class="fw-bold mb-2">Excel / CSV import:</h5>
                    <p class="mb-2">@(tr ? "veriyi Pika'ya taşır." : "moves data into Pika.")</p>
                    <h6 class="fw-bold text-danger mb-1">@(tr ? "Şunu garanti etmez:" : "It does not guarantee:")</h6>
                    <p class="mb-0 text-muted">
                        @(tr
                            ? "“Her dosya yapısı hiç eşleştirme yapılmadan otomatik olarak anlaşılır.”"
                            : "“Every file structure is understood automatically without mapping.”")
                    </p>
                </div>

                <p class="fw-bold mb-0">
                    @(tr
                        ? "Dosya aktarımı, entegrasyonun basit ama kontrollü yollarından biridir."
                        : "File import is a simple but controlled integration path.")
                </p>
            </div>
        </div>
    </div>
</section>

@* ── 06 REST INGESTION API ────────────────────────────────────── *@
<section class="pika-sol-section" id="rest-api">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="pika-sol-eyebrow text-uppercase mb-2">REST INGESTION API</div>
                <h2 class="pika-h2 fw-bold mb-4">
                    @(tr
                        ? "Uygulamalarınızdan Pika'ya, dokümante edilmiş veri kontratı üzerinden veri gönderin."
                        : "Send data from your applications to Pika through documented data contracts.")
                </h2>

                <p class="lead mb-4">
                    @(tr
                        ? "Pika'nın dokümante edilmiş ingestion API kökü:"
                        : "Pika's documented ingestion API root is:")
                    <code>/api/v1/ingest/</code>
                </p>

                <p class="mb-4">
                    @(tr
                        ? "Bu API müşteri, işlem ve ürün veri alanları için asenkron REST ingestion yaklaşımı sunar."
                        : "The API provides an asynchronous REST-ingestion approach for customer, transaction and product data domains.")
                </p>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-primary mb-2">POST /api/v1/ingest/customers</span>
                            <h5 class="fw-bold">Customers</h5>
                            <p class="mb-0 small text-muted">
                                @(tr
                                    ? "Müşteri kayıtlarının ingestion akışına gönderilmesi."
                                    : "Send customer records into the ingestion flow.")
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-primary mb-2">POST /api/v1/ingest/transactions</span>
                            <h5 class="fw-bold">Transactions</h5>
                            <p class="mb-0 small text-muted">
                                @(tr
                                    ? "Sipariş veya işlem kayıtlarının ingestion akışına gönderilmesi."
                                    : "Send order or transaction records into the ingestion flow.")
                            </p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-primary mb-2">POST /api/v1/ingest/products</span>
                            <h5 class="fw-bold">Products</h5>
                            <p class="mb-0 small text-muted">
                                @(tr
                                    ? "Ürün veya katalog kayıtlarının ingestion akışına gönderilmesi."
                                    : "Send product or catalog records into the ingestion flow.")
                            </p>
                        </div>
                    </div>
                </div>

                <div class="p-3 bg-white border rounded-3 mb-4">
                    <p class="mb-1">
                        @(tr
                            ? "API erişimi dokümante edilmiş API-key tabanlı kimlik doğrulama yaklaşımını kullanır."
                            : "API access uses the documented API-key based authentication approach.")
                    </p>
                    <code>X-API-Key</code>
                </div>

                <p class="mb-4">
                    @(tr
                        ? "API endpoint'inin bulunması, her kaynak sistem için hazır native connector bulunduğu anlamına gelmez. Kaynak sistemin Pika veri kontratına uygun entegrasyon üretmesi gerekir."
                        : "The existence of an API endpoint does not mean a ready-made native connector exists for every source system. The source system must integrate with Pika's relevant data contract.")
                </p>

                <p class="fw-bold mb-0">
                    @(tr
                        ? "REST API, kaynak sistem ile Pika arasında programatik veri giriş yoludur."
                        : "The REST API is the programmatic data-ingestion path between source systems and Pika.")
                </p>
            </div>
        </div>
    </div>
</section>

@* ── 07 ASYNCHRONOUS PROCESSING & IDEMPOTENCY ─────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="processing">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">

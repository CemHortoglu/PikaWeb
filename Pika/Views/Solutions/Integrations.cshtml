@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]=(tr?"Entegrasyonlar":"Integrations")+" | Pika"; ViewData["MetaDescription"]=tr?"Excel/CSV ile kontrollü başlangıçtan düzenli API akışına; müşteri, ürün ve satış verisini eşleme, doğrulama ve analitiğe hazırlama yaklaşımını inceleyin.":"Explore Pika's integration approach from controlled Excel/CSV onboarding to regular API data flows, mapping and validating customer, product and sales data."; ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">Platform · @(tr?"Entegrasyonlar":"Integrations")</span><h1>@(tr?"Mevcut verinizden başlayın; altyapıyı bir gecede değiştirmeyin.":"Start with the data you have; do not replace your stack overnight.")</h1><p>@(tr?"Pika'nın veri entegrasyonu yaklaşımı kontrollü dosya aktarımıyla başlayabilir ve ihtiyaç doğrulandığında düzenli API akışına genişleyebilir. Veri alma, alan eşleme ve doğrulama analitik işlem üretiminden ayrı adımlardır.":"Pika can start with controlled file onboarding and expand to regular API flows when the use case is validated. Ingestion, field mapping and validation are separate from analytical processing.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Entegrasyonunuzu Konuşalım":"Discuss Integration")</button><a class="pk-btn pk-btn-ghost" href="/wiki/veri-entegrasyon-genel">@(tr?"Entegrasyon Rehberi":"Integration Guide")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_excel-csv-aktarimi_1.png" alt="@(tr?"Pika Excel CSV aktarım ekranı":"Pika Excel CSV import screen")" width="1200" height="760" /><figcaption>@(tr?"Kontrollü başlangıç: dosya seçimi, alan eşleme ve doğrulama birbirinden ayrılır.":"Controlled onboarding separates file selection, field mapping and validation.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-flow"><div class="pk-flow-item"><small>01</small><strong>@(tr?"Kaynağı al":"Receive source")</strong><span>Excel · CSV · API</span></div><div class="pk-flow-item"><small>02</small><strong>@(tr?"Alanları eşleştir":"Map fields")</strong><span>@(tr?"Kaynak alan → Pika alanı":"Source field → Pika field")</span></div><div class="pk-flow-item"><small>03</small><strong>@(tr?"Doğrula":"Validate")</strong><span>@(tr?"Satır ve ilişki kontrolleri":"Row and relationship checks")</span></div><div class="pk-flow-item"><small>04</small><strong>@(tr?"Çözümle":"Resolve")</strong><span>@(tr?"Müşteri ve ürün bağlamı":"Customer and product context")</span></div><div class="pk-flow-item"><small>05</small><strong>@(tr?"Analitiğe hazırla":"Prepare")</strong><span>@(tr?"Coverage ve veri kalitesi":"Coverage and data quality")</span></div><div class="pk-flow-item"><small>06</small><strong>@(tr?"Sürekliliği kur":"Operationalize")</strong><span>@(tr?"Düzenli akış":"Regular flow")</span></div></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">@(tr?"Hangi veri?":"Which data?")</span><h2>@(tr?"'Çok veri' değil, doğru ilişki gerekir.":"The goal is not more data, but the right relationships.")</h2></div><div><p class="pk-lead">@(tr?"Müşteriyi ayırt eden kimlik, ürün/hizmet kimliği ve gerçek satış/fatura/sipariş geçmişi birçok Pika senaryosunun başlangıç bağlamıdır. Mağaza, kanal, kampanya ve etkileşim verileri ilgili analitiği güçlendirebilir. Gereksinim her capability için farklıdır.":"Customer identity, product/service identity and observed sales/invoice/order history form the starting context for many Pika scenarios. Store, channel, campaign and engagement data can strengthen relevant analytics. Requirements differ by capability.")</p><a class="pk-btn pk-btn-ghost" href="/wiki/ozellik-veri-gereksinimleri">@(tr?"Özellik → Veri Gereksinimi Matrisi":"Capability → Data Requirements")</a></div></div></section>
<section class="pk-section"><div class="pk-container pk-screen-band"><img src="/wiki/assets/images/img_satis-veri-operasyonlari_2.png" alt="@(tr?"Pika satış veri operasyonları ekranı":"Pika sales data operations screen")" loading="lazy" width="1200" height="760" /><div><span class="pk-eyebrow">@(tr?"Veri kalitesi görünür olmalı":"Data quality should be visible")</span><h2>@(tr?"Eşleşmeyen kayıtları güvenilir analizmiş gibi göstermeyin.":"Do not present unresolved records as reliable analysis.")</h2><p class="pk-lead">@(tr?"Müşteri veya ürün eşleşmesi eksik olduğunda ilgili metriğin coverage'ı ve karar değeri düşebilir. Pika'nın veri operasyonu bu tür sorunları çözümleme ve inceleme akışına taşıyabilir.":"When customer or product resolution is incomplete, coverage and decision value can drop. Pika's data operations can make those issues visible for resolution and review.")</p></div></div></section>

@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]="Audience Manager | "+(tr?"Segmentasyon":"Segmentation");
    ViewData["MetaDescription"]=tr?"Pika Audience Manager ile Customer Intelligence, işlem verisi ve iş kurallarını yönetilebilir, yeniden kullanılabilir hedef kitlelere dönüştürün.":"Use Pika Audience Manager to turn Customer Intelligence, transaction data and business rules into manageable, reusable audiences.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">Platform · Audience Manager</span><h1>@(tr?"Müşteriyi anladıktan sonra doğru kitleyi seçin.":"After understanding customers, choose the right audience.")</h1><p>@(tr?"Audience Manager, Pika'daki müşteri ve işlem bağlamını iş kurallarıyla birleştirerek yönetilebilir hedef kitlelere dönüştüren segmentasyon katmanıdır. Customer Intelligence 'müşteri ne anlatıyor?' sorusuna; Audience Manager ise 'bu aksiyona kimler girmeli?' sorusuna cevap verir.":"Audience Manager combines customer and transaction context with business rules to create manageable audiences. Customer Intelligence asks what the customer context means; Audience Manager asks who should enter this action.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Audience Manager'ı Canlı Görün":"See Audience Manager Live")</button><a class="pk-btn pk-btn-ghost" href="/wiki/segment-yonetimi-ve-filtreler">@(tr?"Segmentasyon rehberi":"Segmentation guide")</a></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_kisi-listesi-ve-segmentler_3.png" alt="@(tr?"Pika kişi listesi ve segmentasyon ekranı":"Pika customer list and segmentation screen")" width="1200" height="760" /><div class="pk-stage-caption"><strong>Audience Manager</strong><span>@(tr?"Filtrele · Kaydet · Yeniden kullan":"Filter · Save · Reuse")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-filter-3-line"></i><div><strong>@(tr?"Dinamik filtreler":"Dynamic filters")</strong><small>@(tr?"İşlem + müşteri bağlamı":"Transaction + customer context")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-group-line"></i><div><strong>@(tr?"Hedef kitle":"Audience")</strong><small>@(tr?"Aksiyona hazır seçim":"Action-ready selection")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">Understand → Select</span><h2>Customer Intelligence ≠ Audience Manager</h2></div><p class="pk-lead">@(tr?"Müşteri değeri, alışveriş ritmi, risk veya fırsat sinyali bir insight'tır. Audience Manager bu insight'ları gerçekleşmiş işlem alanları ve iş kurallarıyla birleştirerek seçilebilir hedef kitleye dönüştürür. Segmentasyon böylece anlama katmanından kopuk, rastgele bir filtre listesi olmaz.":"Customer value, purchase rhythm, risk and opportunity signals are insights. Audience Manager combines those insights with observed transaction fields and business rules to produce selectable audiences, keeping segmentation connected to customer understanding.")</p></div><div class="pk-intel-grid"><article class="pk-intel-panel"><span class="pk-intel-number">01</span><div class="pk-intel-icon"><i class="ri-database-2-line"></i></div><h3>@(tr?"Gerçek veriyle filtreleyin":"Filter with observed data")</h3><p>@(tr?"Müşteri, işlem, ürün ve desteklenen ticari alanları kurallara dönüştürün; kampanya hedefini tahmine değil mevcut veriye dayandırın." : "Turn customer, transaction, product and supported commercial fields into rules, grounding campaign targeting in available data.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">02</span><div class="pk-intel-icon"><i class="ri-radar-line"></i></div><h3>@(tr?"Intelligence bağlamını kullanın":"Use intelligence context")</h3><p>@(tr?"Müşteri değeri, ritim, risk ve diğer hesaplanmış bağlamları desteklendiği ölçüde segment kararında kullanın." : "Use customer value, rhythm, risk and other calculated context in audience decisions where supported.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">03</span><div class="pk-intel-icon"><i class="ri-save-3-line"></i></div><h3>@(tr?"Yeniden kullanılabilir kitleler":"Reusable audiences")</h3><p>@(tr?"Tekrarlanan hedefleme mantığını kaydedilebilir segmentler ve şablon yaklaşımıyla ekip içinde daha tutarlı hale getirin." : "Make recurring targeting logic more consistent across teams through reusable segments and templates.")</p></article></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Segment oluşturma":"Building an audience")</span><h2>@(tr?"Kitleyi tek bir demografik alana sıkıştırmayın.":"Do not reduce audiences to one demographic field.")</h2></div><p class="pk-lead">@(tr?"İyi hedefleme, müşterinin kim olduğunu ve ne yaptığını birlikte okuyabilir. Kullanılabilir alanlar müşterinin Pika'ya aktardığı veri kapsamına bağlıdır; eksik veri varsa segment de yalnız mevcut kanıta göre çalışır.":"Good targeting can combine who the customer is with what they have done. Available fields depend on data connected to Pika; incomplete data means the audience can only use available evidence.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_kisi-listesi-ve-segmentler_3.png" alt="@(tr?"Pika hedef kitle ve kişi listesi ekranı":"Pika audience and customer list screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Audience Manager</small><h3>@(tr?"Kişi listesinden yönetilebilir hedef kitleye":"From customer list to manageable audience")</h3><p>@(tr?"Filtre sonucu oluşan kitleyi kontrol edin; hedeflemenin hangi alan ve kurallara dayandığını görünür tutun." : "Review the resulting audience and keep the fields and rules behind targeting visible.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_segment-sablonlari_22.png" alt="@(tr?"Pika segment şablonları":"Pika segment templates")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Segment şablonları":"Segment templates")</small><h3>@(tr?"Sık kullanılan hedefleme mantığını standartlaştırın":"Standardize recurring targeting logic")</h3><p>@(tr?"Aynı kural setini her kampanyada yeniden kurmak yerine tekrarlanabilir hedefleme yaklaşımı oluşturun." : "Build repeatable targeting instead of reconstructing the same rule set for every campaign.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">@(tr?"Örnek karar":"Example decision")</span><h2>@(tr?"'Son 30 günde alışveriş yapan herkes' yerine bağlamlı kitleler oluşturun.":"Move beyond audiences like 'everyone who purchased in the last 30 days.'")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Örneğin tekrar satın alma senaryosunda yalnız geçen gün sayısına bakmak yerine müşterinin kendi satın alma ritmi, ilgili ürün bağlamı, mevcut izin durumu ve ek iş kuralları birlikte değerlendirilebilir. Audience Manager bu koşulları aksiyona girecek kitleyi tanımlamak için kullanır.":"For a repeat-purchase scenario, audience selection can consider the customer's own purchase rhythm, relevant product context, consent status and additional business rules rather than elapsed time alone.")</p></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-user-search-line"></i><div><strong>Customer Intelligence</strong><span>@(tr?"Müşterinin ritmi, değeri ve davranış bağlamı." : "Customer rhythm, value and behavioral context.")</span></div></div><div class="pk-control-step"><i class="ri-shopping-bag-3-line"></i><div><strong>Product Intelligence</strong><span>@(tr?"İlgili ürün, kategori veya Product Role bağlamı." : "Relevant product, category or Product Role context.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-filter-3-line"></i><div><strong>Audience Manager</strong><span>@(tr?"Bu bağlamı iş kurallarıyla seçilebilir hedef kitleye dönüştürür." : "Turns this context and business rules into a selectable audience.")</span></div></div><div class="pk-control-step"><i class="ri-route-line"></i><div><strong>Campaign / Journey</strong><span>@(tr?"Kitle, içerik ve yürütme katmanına kontrollü biçimde aktarılır." : "The audience moves into controlled content and execution.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">Audience → Action</span><h2>@(tr?"Segment oluşturmak gönderim yapmak değildir.":"Creating an audience is not the same as sending.")</h2></div><p class="pk-lead">@(tr?"Audience Manager kime aksiyon uygulanacağını seçer. İçerik, kanal, zamanlama, izin ve yayınlama kontrolleri Campaign veya Journey katmanında devreye girer. Bu ayrım hedefleme ile yürütmenin sorumluluklarını açık tutar.":"Audience Manager selects who should enter an action. Content, channel, timing, consent and publishing controls are applied in Campaign or Journey. This keeps targeting and execution responsibilities clear.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-radar-line"></i><strong>@(tr?"Insight":"Insight")</strong><span>@(tr?"Müşteri ve ürün bağlamı":"Customer and product context")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-filter-3-line"></i><strong>Audience</strong><span>@(tr?"Kim dahil?":"Who is included?")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-magic-line"></i><strong>Content</strong><span>@(tr?"Ne söyleyeceğiz?":"What will we say?")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-shield-check-line"></i><strong>@(tr?"Uygunluk":"Eligibility")</strong><span>@(tr?"İzin · Opt-out · Kanal":"Consent · Opt-out · Channel")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-route-line"></i><strong>Campaign / Journey</strong><span>@(tr?"Kontrollü yürütme":"Controlled execution")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>Analytics</strong><span>@(tr?"Sonucu değerlendir":"Review outcomes")</span></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Nerede kullanılır?":"Where is it used?")</span><h2>@(tr?"Fırsattan kampanyaya, manuel seçimden sürekli akışa.":"From opportunity to campaign, manual selection to ongoing flow.")</h2></div><p class="pk-lead">@(tr?"Audience Manager hem planlı kampanyalarda hem de Journey giriş/karar noktalarında kullanılabilecek hedefleme mantığını yönetir. Uygun senaryoda Günün Fırsatları'ndan gelen müşteri bağlamı da kitle seçimini besleyebilir.":"Audience Manager manages targeting logic used in planned campaigns and Journey entry/decision points. Where appropriate, customer context from Daily Opportunities can also inform audience selection.")</p></div><div class="pk-columns"><div class="pk-feature"><i class="ri-megaphone-line"></i><h3>Campaign Manager</h3><p>@(tr?"Tanımlı hedef kitleyi içerik, kanal ve zamanlama ile tek kampanyaya bağlayın." : "Connect a defined audience to content, channel and timing in a campaign.")</p></div><div class="pk-feature"><i class="ri-route-line"></i><h3>Journey Manager</h3><p>@(tr?"Müşterinin akışa girmesi veya farklı yola ayrılması için segment ve kural bağlamını kullanın." : "Use segment and rule context for Journey entry or branching.")</p></div><div class="pk-feature"><i class="ri-sparkling-2-line"></i><h3>@(tr?"Günün Fırsatları":"Daily Opportunities")</h3><p>@(tr?"Fırsatın müşteri bağlamını ilgili aksiyon için yönetilebilir kitleye dönüştürün." : "Turn opportunity context into a manageable audience for the relevant action.")</p></div></div><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/campaign-manager":"/en/platform/campaign-manager")">Campaign Manager</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/journey-manager":"/en/platform/journey-manager")">Journey Manager</a></div></div></section>

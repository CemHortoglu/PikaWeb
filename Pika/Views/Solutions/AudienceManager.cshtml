</section>

<!-- CTA -->
<section class="pika-sol-cta-section">
    <div class="container" data-aos="fade-up">
        <h2>@(tr ? "Hedef kitlenizi veriye dayalı olarak tanımlayın ve kampanya etkisini artırın" : "Define your audience with data and increase campaign impact")</h2>
        <p>@(tr ? "Pika Audience Manager ile segmentasyonu kampanyalarınızın gücüne dönüştürün." : "Turn segmentation into campaign power with Pika Audience Manager.")</p>
        <div class="pika-sol-cta-actions">
            <button type="button" class="btn pika-btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i></button>
            <a href="@Url.Action("Contact", "Home")" class="btn pika-btn-ghost px-4 py-2">@(tr ? "Bizimle İletişime Geçin" : "Contact Us")</a>
        </div>
    </div>
</section>

@{
    var tr = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = tr ? "Audience Manager | Pika ile Hedef Kitle ve Segmentasyon Yönetimi" : "Audience Manager | Audience Targeting & Segmentation with Pika";
    ViewData["MetaDescription"] = tr ? "Pika Audience Manager ile transaction ve davranış verilerine dayalı segmentler oluşturun, kampanyalarınızı doğru kitleyle eşleştirin." : "Create segments based on transaction and behavioral data with Pika Audience Manager and match campaigns to the right audience.";
    ViewData["MetaKeywords"] = "audience manager,segmentasyon,hedef kitle,transaction segmentasyon,davranış segmentasyon,pika";
}

<!-- HERO: Targeting Intelligence -->
@await Html.PartialAsync("_MarketingHero")

<!-- STICKY SUBNAV -->
<div class="pika-sol-subnav-wrap">
    <div class="container">
        <nav class="pika-sol-subnav">
            <a href="#overview">@(tr ? "Genel Bakış" : "Overview")</a>
            <a href="#features">@(tr ? "Özellikler" : "Features")</a>
            <a href="#showcase">@(tr ? "Segment Builder" : "Segment Builder")</a>
            <a href="#usecases">@(tr ? "Kullanım Senaryoları" : "Use Cases")</a>
            <a href="#platform">@(tr ? "Entegrasyon" : "Integration")</a>
            <a href="#faq">SSS / FAQ</a>
        </nav>
    </div>
</div>

<!-- TRUST STRIP -->
<section class="pika-sol-section" id="overview">
    <div class="container">
        <div class="pika-sol-trust-strip" data-aos="fade-up">
            <div class="pika-sol-trust-item"><i class="ri-database-2-line"></i><span>@(tr ? "Veri tabanlı" : "Data-driven")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-filter-3-line"></i><span>@(tr ? "Kural motoru" : "Rule engine")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-loop-left-line"></i><span>@(tr ? "Yeniden kullanılabilir" : "Reusable")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-link"></i><span>@(tr ? "Kampanya entegrasyonu" : "Campaign integration")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-shield-check-line"></i><span>@(tr ? "KVKK uyumlu" : "KVKK compliant")</span></div>
        </div>
    </div>
</section>

<!-- SHOWCASE: Segment Builder -->
<section class="pika-sol-section pika-sol-section-alt" id="showcase">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Segment builder: hedeflemeyi görselleştirin" : "Segment builder: visualize your targeting")</h2>
        <div class="pika-sol-showcase" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-showcase-screen">
                <div class="pika-sol-showcase-panel">
                    <div class="pika-sol-showcase-panel-title"><i class="ri-filter-3-line"></i> @(tr ? "Filtre Kuralları" : "Filter Rules")</div>
                    <div class="pika-sol-showcase-mock-bar w80"></div>
                    <div class="pika-sol-showcase-mock-bar w60"></div>
                    <div class="pika-sol-showcase-mock-bar w45"></div>
                    <div class="pika-sol-showcase-mock-bar w70"></div>
                </div>
                <div class="pika-sol-showcase-panel">
                    <div class="pika-sol-showcase-panel-title"><i class="ri-group-line"></i> @(tr ? "Segment Önizleme" : "Segment Preview")</div>
                    <div class="pika-sol-showcase-mock-bar w70"></div>
                    <div class="pika-sol-showcase-mock-bar w80"></div>
                    <div class="pika-sol-showcase-mock-bar w60"></div>
                </div>
            </div>
            <div class="pika-sol-showcase-annotations">
                <div class="pika-sol-annotation"><i class="ri-shopping-cart-line"></i> @(tr ? "Transaction verisi" : "Transaction data")</div>
                <div class="pika-sol-annotation"><i class="ri-focus-3-line"></i> @(tr ? "Davranış filtresi" : "Behavior filter")</div>
                <div class="pika-sol-annotation"><i class="ri-git-branch-line"></i> @(tr ? "VE/VEYA koşullar" : "AND/OR conditions")</div>
                <div class="pika-sol-annotation"><i class="ri-eye-line"></i> @(tr ? "Anlık önizleme" : "Real-time preview")</div>
            </div>
        </div>
    </div>
</section>

<!-- PROBLEM/SOLUTION -->
<section class="pika-sol-section">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Hedefleme kalitesini artırın" : "Improve targeting quality")</h2>
        <div class="pika-sol-problem-grid" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-problem-card pika-sol-problem-card--problem"><i class="ri-error-warning-line"></i> @(tr ? "Genel gönderimlerle düşük etkileşim" : "Low engagement with generic sends")</div>
            <div class="pika-sol-problem-card pika-sol-problem-card--solution"><i class="ri-check-double-line"></i> @(tr ? "Veri tabanlı doğru segmentasyon" : "Data-driven accurate segmentation")</div>
            <div class="pika-sol-problem-card pika-sol-problem-card--problem"><i class="ri-error-warning-line"></i> @(tr ? "Tekrar eden manuel segment oluşturma" : "Repetitive manual segment creation")</div>
            <div class="pika-sol-problem-card pika-sol-problem-card--solution"><i class="ri-check-double-line"></i> @(tr ? "Yeniden kullanılabilir segment şablonları" : "Reusable segment templates")</div>
        </div>
    </div>
</section>

<!-- CORE CAPABILITIES -->
<section class="pika-sol-section pika-sol-section-alt" id="features">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Segmentasyon için temel yetenekler" : "Core capabilities for segmentation")</h2>
        <div class="pika-sol-card-grid">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-shopping-cart-line"></i></div>
                <h4>@(tr ? "Transaction bazlı segmentasyon" : "Transaction-based segmentation")</h4>
                <p>@(tr ? "Satın alma verilerine göre segment oluşturun." : "Create segments based on purchase data.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-pulse-line"></i></div>
                <h4>@(tr ? "Davranış bazlı segmentasyon" : "Behavior-based segmentation")</h4>
                <p>@(tr ? "Kullanıcı etkileşimlerine göre hedefleme yapın." : "Target based on user interactions.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-git-branch-line"></i></div>
                <h4>@(tr ? "Kural tabanlı filtreler" : "Rule-based filters")</h4>
                <p>@(tr ? "VE/VEYA mantığıyla esnek koşullar tanımlayın." : "Define flexible conditions with AND/OR logic.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-loop-left-line"></i></div>
                <h4>@(tr ? "Yeniden kullanılabilir segmentler" : "Reusable segments")</h4>
                <p>@(tr ? "Segmentleri kaydedin, kampanyalarda tekrar kullanın." : "Save segments and reuse them in campaigns.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-eye-line"></i></div>
                <h4>@(tr ? "Anlık segment önizleme" : "Real-time segment preview")</h4>
                <p>@(tr ? "Segment boyutunu ve profilini kaydetmeden görün." : "View segment size and profile before saving.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-link"></i></div>
                <h4>@(tr ? "Kampanya ve journey entegrasyonu" : "Campaign & journey integration")</h4>
                <p>@(tr ? "Segmentleri kampanya ve akışlara doğrudan bağlayın." : "Connect segments directly to campaigns and flows.")</p>
            </div>
        </div>
    </div>
</section>

<!-- WORKFLOW -->
<section class="pika-sol-section">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Segmentasyon sürecini 4 adımda tamamlayın" : "Complete the segmentation process in 4 steps")</h2>
        <div class="pika-sol-workflow-steps" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-workflow-step">
                <div class="pika-sol-workflow-num">1</div>
                <h5>@(tr ? "Veri Kaynağını Seçin" : "Select Data Source")</h5>
                <p>@(tr ? "Transaction veya davranış verisini belirleyin." : "Choose transaction or behavior data.")</p>
            </div>
            <div class="pika-sol-workflow-step">
                <div class="pika-sol-workflow-num">2</div>
                <h5>@(tr ? "Koşulları Tanımlayın" : "Define Conditions")</h5>
                <p>@(tr ? "Filtre kurallarını VE/VEYA mantığıyla oluşturun." : "Build filter rules with AND/OR logic.")</p>
            </div>
            <div class="pika-sol-workflow-step">
                <div class="pika-sol-workflow-num">3</div>
                <h5>@(tr ? "Önizleyin" : "Preview")</h5>
                <p>@(tr ? "Segment boyutu ve profilini kontrol edin." : "Check segment size and profile.")</p>
            </div>
            <div class="pika-sol-workflow-step">
                <div class="pika-sol-workflow-num">4</div>
                <h5>@(tr ? "Kaydedin ve Kullanın" : "Save & Use")</h5>
                <p>@(tr ? "Segmenti kampanya veya journey'e bağlayın." : "Connect the segment to a campaign or journey.")</p>
            </div>
        </div>
    </div>
</section>

<!-- USE CASES -->
<section class="pika-sol-section pika-sol-section-alt" id="usecases">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Audience Manager ile neler yapabilirsiniz?" : "What can you do with Audience Manager?")</h2>
        <div class="pika-sol-usecase-cards">
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="50">
                <div class="pika-sol-usecase-card-icon"><i class="ri-vip-crown-line"></i></div>
                <span class="usecase-industry">@(tr ? "E-ticaret" : "E-commerce")</span>
                <h5>@(tr ? "VIP Müşteri Segmenti" : "VIP Customer Segment")</h5>
                <p>@(tr ? "Yüksek harcama yapan müşterileri otomatik segmentleyin." : "Automatically segment high-spending customers.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-usecase-card-icon"><i class="ri-user-unfollow-line"></i></div>
                <span class="usecase-industry">@(tr ? "Perakende" : "Retail")</span>
                <h5>@(tr ? "Churn Riski Yüksek Kitle" : "High Churn Risk Audience")</h5>
                <p>@(tr ? "Uzun süredir etkileşim kurmayanları hedefleyin." : "Target users who haven't engaged in a long time.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="150">
                <div class="pika-sol-usecase-card-icon"><i class="ri-map-pin-line"></i></div>
                <span class="usecase-industry">@(tr ? "Tüm Sektörler" : "All Industries")</span>
                <h5>@(tr ? "Lokasyon Bazlı Hedefleme" : "Location-Based Targeting")</h5>
                <p>@(tr ? "Bölge ve şehir bazlı segmentler oluşturun." : "Create region and city-based segments.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-usecase-card-icon"><i class="ri-shopping-bag-line"></i></div>
                <span class="usecase-industry">@(tr ? "E-ticaret" : "E-commerce")</span>
                <h5>@(tr ? "Kategori Bazlı Segment" : "Category-Based Segment")</h5>
                <p>@(tr ? "Belirli kategorilerde alışveriş yapanları hedefleyin." : "Target shoppers in specific categories.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="250">
                <div class="pika-sol-usecase-card-icon"><i class="ri-user-add-line"></i></div>
                <span class="usecase-industry">@(tr ? "SaaS / Finans" : "SaaS / Finance")</span>
                <h5>@(tr ? "Yeni Müşteri Onboarding" : "New Customer Onboarding")</h5>
                <p>@(tr ? "Son 30 günde katılan müşterileri segmentleyin." : "Segment customers who joined in the last 30 days.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-usecase-card-icon"><i class="ri-refresh-line"></i></div>
                <span class="usecase-industry">@(tr ? "Perakende" : "Retail")</span>
                <h5>@(tr ? "Tekrar Satın Alma Hedeflemesi" : "Repeat Purchase Targeting")</h5>
                <p>@(tr ? "Düzenli alışveriş yapan müşterilere özel kampanyalar." : "Special campaigns for regularly purchasing customers.")</p>
            </div>
        </div>
    </div>
</section>

<!-- PLATFORM MAP -->
<section class="pika-sol-section" id="platform">
    <div class="container">
        <h2 class="pika-sol-section-title text-center" data-aos="fade-up">@(tr ? "Audience Manager, Pika platformunda nasıl konumlanır?" : "How does Audience Manager fit in the Pika platform?")</h2>
        <div class="pika-sol-platform-map" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-platform-satellites">
                <a class="pika-sol-platform-node" href="@Url.Action("CampaignManager", "Solutions")"><i class="ri-megaphone-line"></i> Campaign Manager</a>
                <a class="pika-sol-platform-node" href="@Url.Action("JourneyManager", "Solutions")"><i class="ri-route-line"></i> Journey Manager</a>
            </div>
            <div class="pika-sol-platform-connector"></div>
            <div class="pika-sol-platform-center"><i class="ri-focus-3-line"></i> Audience Manager</div>
            <div class="pika-sol-platform-connector"></div>
            <div class="pika-sol-platform-satellites">
                <a class="pika-sol-platform-node" href="@Url.Action("Reporting", "Solutions")"><i class="ri-bar-chart-box-line"></i> Analytics &amp; Reporting</a>
                <a class="pika-sol-platform-node" href="@Url.Action("ConsentManagement", "Solutions")"><i class="ri-shield-check-line"></i> Consent Management</a>
            </div>
        </div>
    </div>
</section>

<!-- BUSINESS IMPACT -->
<section class="pika-sol-section pika-sol-section-impact">
    <div class="container">
        <h2 class="pika-sol-section-title text-center" data-aos="fade-up">@(tr ? "İş etkisi" : "Business Impact")</h2>
        <div class="pika-sol-impact-grid pika-sol-impact-grid--light" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-impact-card pika-sol-impact-card--light">
                <div class="pika-sol-impact-icon"><i class="ri-focus-3-line"></i></div>
                <h5>@(tr ? "Hedefleme kalitesini artırır" : "Improves targeting quality")</h5>
                <p>@(tr ? "Doğru kişilere doğru mesajı gönderin." : "Send the right message to the right people.")</p>
            </div>
            <div class="pika-sol-impact-card pika-sol-impact-card--light">
                <div class="pika-sol-impact-icon"><i class="ri-speed-line"></i></div>
                <h5>@(tr ? "Operasyon hızını artırır" : "Increases operational speed")</h5>
                <p>@(tr ? "Segment oluşturma süresini kısaltın." : "Reduce segment creation time.")</p>
            </div>
            <div class="pika-sol-impact-card pika-sol-impact-card--light">
                <div class="pika-sol-impact-icon"><i class="ri-bar-chart-grouped-line"></i></div>
                <h5>@(tr ? "Kampanya ROI'sini yükseltir" : "Boosts campaign ROI")</h5>
                <p>@(tr ? "Daha doğru hedeflemeyle daha yüksek dönüşüm." : "Higher conversions with more accurate targeting.")</p>
            </div>
        </div>
    </div>
</section>

<!-- FAQ -->
<section class="pika-sol-section" id="faq">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Audience Manager hakkında sık sorulan sorular" : "Audience Manager FAQs")</h2>
        <div class="accordion faq-pro-accordion" id="audienceFaq">
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#audienceFaq1" aria-expanded="true" aria-controls="audienceFaq1">@(tr ? "Hangi veri kaynaklarıyla segment oluşturulabilir?" : "Which data sources can be used for segmentation?")</button></h2>
                <div id="audienceFaq1" class="accordion-collapse collapse show" data-bs-parent="#audienceFaq"><div class="accordion-body">@(tr ? "Transaction verileri, kullanıcı davranışları, demografik bilgiler ve özel alanlarla segment oluşturabilirsiniz." : "You can create segments using transaction data, user behavior, demographics and custom fields.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#audienceFaq2" aria-expanded="false" aria-controls="audienceFaq2">@(tr ? "Segmentler kampanyalarda kullanılabilir mi?" : "Can segments be used in campaigns?")</button></h2>
                <div id="audienceFaq2" class="accordion-collapse collapse" data-bs-parent="#audienceFaq"><div class="accordion-body">@(tr ? "Evet. Oluşturduğunuz segmentleri doğrudan Campaign Manager ve Journey Manager'da kullanabilirsiniz." : "Yes. You can use created segments directly in Campaign Manager and Journey Manager.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#audienceFaq3" aria-expanded="false" aria-controls="audienceFaq3">@(tr ? "Segmentler yeniden kullanılabilir mi?" : "Are segments reusable?")</button></h2>
                <div id="audienceFaq3" class="accordion-collapse collapse" data-bs-parent="#audienceFaq"><div class="accordion-body">@(tr ? "Evet. Segmentleri kaydedebilir ve birden fazla kampanyada tekrar kullanabilirsiniz." : "Yes. You can save segments and reuse them across multiple campaigns.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#audienceFaq4" aria-expanded="false" aria-controls="audienceFaq4">@(tr ? "VE/VEYA mantığı destekleniyor mu?" : "Is AND/OR logic supported?")</button></h2>
                <div id="audienceFaq4" class="accordion-collapse collapse" data-bs-parent="#audienceFaq"><div class="accordion-body">@(tr ? "Evet. Birden fazla koşulu VE/VEYA mantığıyla birleştirerek detaylı segmentler tanımlayabilirsiniz." : "Yes. You can combine multiple conditions with AND/OR logic to define detailed segments.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#audienceFaq5" aria-expanded="false" aria-controls="audienceFaq5">@(tr ? "Segment boyutunu önceden görebilir miyim?" : "Can I preview segment size beforehand?")</button></h2>
                <div id="audienceFaq5" class="accordion-collapse collapse" data-bs-parent="#audienceFaq"><div class="accordion-body">@(tr ? "Evet. Segment oluşturma sırasında anlık önizleme ile tahmini kitle boyutunu görebilirsiniz." : "Yes. You can see the estimated audience size with real-time preview during segment creation.")</div></div>
            </div>
        </div>
    </div>
</section>

<!-- RELATED PRODUCTS -->

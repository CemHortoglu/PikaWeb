                </div>
            </div>

            <div class="col-lg-2 col-md-4 col-6">
                <div class="p-3 rounded text-center bg-white border h-100">
                    <div class="fw-bold mb-1" style="font-size:0.75rem;color:var(--pika-primary)">05</div>
                    <div class="fw-bold small mb-1" style="color:#23413b">CONTENT STUDIO</div>
                    <p class="small ph-muted mb-0" style="font-size:0.75rem">

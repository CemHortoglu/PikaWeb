    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Birlikte en çok kullanılan modüller" : "Most commonly used together")</h2>
        <div class="pika-sol-related" data-aos="fade-up" data-aos-delay="100">

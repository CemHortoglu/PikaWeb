@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-solutions-page audience-editorial";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-audience-manager-page.css" asp-append-version="true" />
}


@* ── 01 HERO ─────────────────────────────────────────────────── *@
<section class="inner-hero inner-hero--audience">
    <div class="inner-hero-grid-overlay" aria-hidden="true"></div>
    <div class="inner-hero-orbit" aria-hidden="true"></div>
    <div class="inner-hero-grid-overlay" aria-hidden="true"></div>
    <div class="inner-hero-orbit" aria-hidden="true"></div>
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span>/</span>
                <span>Audience Manager</span>
            </nav>
            <div class="inner-eyebrow"><span></span>AUDIENCE MANAGER</div>
            @if (tr)
            {
                <h1>
                    Doğru kitleyi,<br />
                    müşteri bağlamından oluşturun.
                </h1>
                <p>
                    Pika Audience Manager; müşteri özelliklerini, işlem geçmişini, davranış sinyallerini ve kural mantığını bir araya getirerek kampanya ve journey'ler için yeniden kullanılabilir hedef kitleler oluşturmanıza yardımcı olur.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.72);font-size:15px;margin-bottom:30px">
                    Amaç yalnızca bir müşteri listesi çıkarmak değil, hangi müşterilerin belirli bir karar bağlamına neden dahil olduğunu açık kurallarla tanımlayabilmektir.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Demo Talep Et ↗
                    </button>
                    <a class="inner-secondary" href="/platform/customer-intelligence">
                        Customer Intelligence'ı Keşfedin →
                    </a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="İçeriğe atla">
                        <i class="ri-arrow-down-line" aria-hidden="true"></i>
                    </a>
                </div>
            }
            else
            {
                <h1>
                    Build the right audience<br />
                    from customer context.
                </h1>
                <p>
                    Pika Audience Manager brings customer attributes, transaction history, behavioral signals and rule logic together to help create reusable audiences for campaigns and journeys.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.72);font-size:15px;margin-bottom:30px">
                    The objective is not simply to produce a customer list. It is to define, through explicit rules, which customers belong in a specific decision context and why.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Request a Demo ↗
                    </button>
                    <a class="inner-secondary" href="/en/platform/customer-intelligence">
                        Explore Customer Intelligence →
                    </a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="Skip to content">
                        <i class="ri-arrow-down-line" aria-hidden="true"></i>
                    </a>
                </div>
            }
        </div>
        <div class="inner-scene" aria-label="@(tr ? "Platformun çalışma biçimini anlatan örnek görünüm" : "Illustrative view of how the platform works")">
            <div class="inner-scene-orbit" aria-hidden="true"></div>
            <div class="inner-scene-window">
                <div class="inner-window-bar">
                    <strong>pika<span>✳</span></strong>
                    <span>Audience Manager</span>
                    <small>@(tr ? "Örnek görünüm" : "Illustration")</small>
                </div>
                <div class="inner-flow" style="padding:24px 20px">
                    <div>
                        <i class="ri-filter-3-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "KURAL GRUBU" : "RULE GROUP")</strong>
                        </span>
                        <b>01</b>
                    </div>
                    <span class="inner-flow-link" style="height:18px"></span>
                    <div style="padding:6px 16px;justify-content:center;background:#f0f5e8;border:1px dashed #c9dca9;border-radius:6px;width:fit-content;margin:0 auto">
                        <strong style="margin:0;font-size:11px;letter-spacing:1px;color:#527233">@(tr ? "VE / VEYA" : "AND / OR")</strong>
                    </div>
                    <span class="inner-flow-link" style="height:18px"></span>
                    <div>
                        <i class="ri-user-shared-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "MÜŞTERİ BAĞLAMI" : "CUSTOMER CONTEXT")</strong>
                        </span>
                        <b>02</b>
                    </div>
                    <span class="inner-flow-link" style="height:20px"></span>
                    <div class="inner-flow-final">
                        <i class="ri-group-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "KİTLE ÖNİZLEMESİ" : "AUDIENCE PREVIEW")</strong>
                        </span>
                        <b>03</b>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<div class="inner-trust-ribbon">
    <div class="container">
        <div class="inner-trust-ribbon__items">
            <div class="inner-trust-ribbon__item">
                <i class="ri-whatsapp-line" aria-hidden="true"></i>
                <div>
                    <strong>WhatsApp Business API</strong>
                    <span>@(tr ? "Resmi Meta API" : "Official Meta API")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-mail-send-line" aria-hidden="true"></i>
                <div>
                    <strong>Email &amp; SMS</strong>
                    <span>@(tr ? "Doğrulanmış Kanallar" : "Verified Channels")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-focus-3-line" aria-hidden="true"></i>
                <div>
                    <strong>Pika Opportunity Engine</strong>
                    <span>@(tr ? "Günlük Algoritmik Tespit" : "Daily Discovery")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-shield-check-line" aria-hidden="true"></i>
                <div>
                    <strong>İYS &amp; KVKK</strong>
                    <span>@(tr ? "İzin Denetimi" : "Consent Verification")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="inner-content" class="inner-anchor"></div>

@* ── STICKY SUBNAV ───────────────────────────────────────────── *@
<div class="pika-sol-subnav-wrap">
    <div class="container">
        <nav class="pika-sol-subnav">
            <a href="#overview">@(tr ? "Genel Bakış" : "Overview")</a>
            <a href="#audience-context">@(tr ? "Kitle Bağlamı" : "Audience Context")</a>
            <a href="#rule-logic">@(tr ? "Kural Mantığı" : "Rule Logic")</a>
            <a href="#dynamic-audiences">@(tr ? "Dinamik Kitleler" : "Dynamic Audiences")</a>
            <a href="#platform-relationships">@(tr ? "Platform İlişkisi" : "Platform Relationships")</a>
            <a href="#faq">@(tr ? "SSS" : "FAQ")</a>
        </nav>
    </div>
</div>

@* ── TRUST STRIP ─────────────────────────────────────────────── *@
<section class="pika-sol-section" id="overview">
    <div class="container">
        <div class="pika-sol-trust-strip" data-aos="fade-up">
            <div class="pika-sol-trust-item"><i class="ri-filter-3-line"></i><span>@(tr ? "Kural Tabanlı" : "Rule-Based")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-shopping-cart-line"></i><span>@(tr ? "Transaction Bağlamı" : "Transaction Context")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-pulse-line"></i><span>@(tr ? "Davranış Bağlamı" : "Behavioral Context")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-loop-left-line"></i><span>@(tr ? "Yeniden Kullanılabilir" : "Reusable")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-route-line"></i><span>@(tr ? "Campaign & Journey" : "Campaign & Journey")</span></div>
        </div>
    </div>
</section>

@* ── 02 DIRECT ANSWER ────────────────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container aud-overview-layout"><figure class="aud-overview-art">
    <img src="~/images/pages/communication-accessibility.png" asp-append-version="true" loading="lazy" decoding="async" width="1536" height="1024"
         alt="@(tr ? "Pika Audience Manager — iletişim erişilebilirliği ve kitle bağlamı" : "Pika Audience Manager — communication accessibility and audience context")" />
    <figcaption>@(tr ? "Kavramsal gösterim; kişi, değerler ve arayüz örnek amaçlıdır." : "Conceptual illustration; people, values and interface are illustrative.")</figcaption>
</figure><div class="aud-overview-copy">
        <span class="pika-sol-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
        <h2 class="pika-sol-section-title mb-3">@(tr ? "Audience Manager nedir?" : "What is Audience Manager?")</h2>
        @if (tr)
        {
            <p class="ph-lead mb-3">
                Audience Manager, Pika'da hangi müşterilerin belirli bir pazarlama kararı veya kontrollü aksiyon için hedef kitleye dahil edilmesi gerektiğini kural tabanlı olarak tanımlayan segmentasyon katmanıdır.
            </p>
            <p class="ph-muted">
                Audience Manager; müşteri özelliklerini, işlem ve davranış bağlamını, Customer Intelligence tarafından üretilen sinyalleri ve kullanılabilir diğer müşteri kurallarını birlikte değerlendirebilir.
            </p>
            <p class="ph-muted">
                Audience Manager'ın temel sorusu şudur:
            </p>
            <div class="p-4 rounded my-4 text-center bg-white border" style="border:1px solid rgba(128,148,139,.24)">
                <div class="fw-bold" style="font-size:1.25rem;color:#23413b;line-height:1.5">
                    “Bu karar için<br />
                    hangi müşteriler<br />
                    hedef kitleye dahil olmalı?”
                </div>
            </div>
            <p class="ph-muted mb-0">
                Audience Manager müşteri davranışını hesaplayan analitik motor değildir ve kampanyayı gönderen katman da değildir. Hesaplanmış müşteri bağlamını açık kitle kurallarına dönüştürerek karar ile aksiyon arasındaki “KİM?” sorusunu cevaplar.
            </p>
        }
        else
        {
            <p class="ph-lead mb-3">
                Audience Manager is Pika's rule-based segmentation layer for defining which customers should belong in the audience for a specific marketing decision or controlled action.
            </p>
            <p class="ph-muted">
                Audience Manager can evaluate customer attributes, transaction and behavioral context, signals produced by Customer Intelligence and other available customer rules together.
            </p>
            <p class="ph-muted">
                Audience Manager answers one central question:
            </p>
            <div class="p-4 rounded my-4 text-center bg-white border" style="border:1px solid rgba(128,148,139,.24)">
                <div class="fw-bold" style="font-size:1.25rem;color:#23413b;line-height:1.5">
                    “Which customers<br />
                    should belong in the audience<br />
                    for this decision?”
                </div>
            </div>
            <p class="ph-muted mb-0">
                Audience Manager is not the analytical engine that calculates customer behavior, and it is not the layer that sends the campaign. It turns calculated customer context into explicit audience rules and answers the “WHO?” between decision and action.
            </p>
        }
    </div>
</div></section>

@* ── PAGE ART ─────────────────────────────────────────────────── *@


@* ── 03 WHY STATIC LISTS ARE NOT ENOUGH ──────────────────────── *@
<section class="pika-sol-section">
    <div class="container" style="max-width:860px">
        <span class="pika-sol-eyebrow">@(tr ? "LİSTEDEN KURALA" : "FROM LIST TO RULE")</span>
        <h2 class="pika-sol-section-title mb-3">
            @(tr ? "Müşteri listesi bir anı gösterir. Kural ise bağlamı tanımlar." : "A customer list captures a moment. A rule defines the context.")
        </h2>
        @if (tr)
        {
            <p class="ph-muted">
                Bir müşteri listesini dışa aktardığınız anda o liste belirli bir zamanın görüntüsüdür.
            </p>
            <p class="ph-muted">
                Müşteri yeni bir alışveriş yaptığında, davranışı değiştiğinde veya başka bir koşul artık geçerli olmadığında statik liste bunu kendi başına açıklayamaz.
            </p>
            <p class="ph-muted">
                Pazarlama açısından daha önemli olan soru yalnızca:
            </p>
            <div class="p-3 my-2 rounded bg-white border">
                <span class="ph-muted">“Listede kim var?” değildir.</span>
            </div>
            <div class="p-3 my-3 rounded bg-white border pika-editorial-note" style="border:1px solid rgba(128,148,139,.24)">
                <strong style="color:#23413b;font-size:1.05rem">
                    Asıl soru: “Bu müşteriyi bu hedef kitleye dahil eden hangi koşullar geçerli?”
                </strong>
            </div>
            <p class="ph-muted">
                Audience Manager hedef kitleyi kişilerden önce kurallarla tanımlar.
            </p>
            <p class="ph-muted">
                Böylece hedef kitle, tek seferlik bir dosyadan çok yeniden değerlendirilebilir bir müşteri tanımına dönüşür.
            </p>
            <div class="p-3 rounded mt-3 text-center" style="background:#f8faf4;border:1px dashed #dce5d3">
                <p class="small mb-1 text-muted">Statik liste sonucu saklar.</p>
                <strong style="color:#23413b">Kural tabanlı audience, sonucun neden oluştuğunu da tanımlar.</strong>
            </div>
        }
        else
        {
            <p class="ph-muted">
                The moment a customer list is exported, it becomes a snapshot of a specific point in time.
            </p>
            <p class="ph-muted">
                When a customer makes another purchase, their behavior changes or a condition no longer applies, the static list cannot explain that change by itself.
            </p>
            <p class="ph-muted">
                For marketing, the more important question is not only:
            </p>
            <div class="p-3 my-2 rounded bg-white border">
                <span class="ph-muted">“Who is on the list?”</span>
            </div>
            <div class="p-3 my-3 rounded bg-white border pika-editorial-note" style="border:1px solid rgba(128,148,139,.24)">
                <strong style="color:#23413b;font-size:1.05rem">
                    The more important question is: “Which conditions make this customer belong in this audience?”
                </strong>
            </div>
            <p class="ph-muted">
                Audience Manager defines the audience through rules before defining it through individual people.
            </p>
            <p class="ph-muted">
                This turns the audience from a one-time file into a customer definition that can be evaluated again.
            </p>
            <div class="p-3 rounded mt-3 text-center" style="background:#f8faf4;border:1px dashed #dce5d3">
                <p class="small mb-1 text-muted">A static list stores the result.</p>
                <strong style="color:#23413b">A rule-based audience also defines why that result exists.</strong>
            </div>
        }
    </div>
</section>

@* ── 04 WHAT CAN DEFINE AN AUDIENCE ─────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="audience-context">
    <div class="container">
        <div class="text-center mb-5">
            <span class="pika-sol-eyebrow">@(tr ? "KİTLE BAĞLAMI" : "AUDIENCE CONTEXT")</span>
            <h2 class="pika-sol-section-title mb-3">
                @(tr ? "Bir hedef kitleyi tek bir özellik tanımlamak zorunda değildir." : "An audience does not have to be defined by one attribute.")
            </h2>
            <p class="ph-muted mx-auto" style="max-width:680px">
                @(tr ? "Audience Manager farklı müşteri bağlamlarını aynı kural tanımında bir araya getirebilir. Kullanılabilecek bağlam, Pika'da mevcut ve ilgili müşteri verisine bağlıdır." : "Audience Manager can bring different customer contexts together within the same rule definition. Available context depends on relevant customer data present in Pika.")
            </p>
        </div>

        <div class="pika-sol-card-grid">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="50">
                <div class="pika-sol-card-icon"><i class="ri-user-settings-line"></i></div>
                <h4>@(tr ? "Müşteri Özellikleri" : "Customer Attributes")</h4>
                <p>@(tr ? "Müşteriye ait kullanılabilir profil ve tanımlayıcı özellikler hedef kitle koşullarının bir parçası olabilir." : "Available customer profile and descriptive attributes can form part of audience conditions.")</p>
            </div>

            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-shopping-cart-line"></i></div>
                <h4>@(tr ? "Transaction Geçmişi" : "Transaction History")</h4>
                <p>@(tr ? "Satın alma geçmişi, işlem sıklığı veya belirli ürün ve kategori alışverişleri hedef kitle tanımında kullanılabilir." : "Purchase history, transaction frequency or purchases from particular products and categories can be used in audience definitions.")</p>
            </div>

            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="150">
                <div class="pika-sol-card-icon"><i class="ri-pulse-line"></i></div>
                <h4>@(tr ? "Davranış Bağlamı" : "Behavioral Context")</h4>
                <p>@(tr ? "Müşterinin işlem geçmişinden oluşan davranış değişimleri ve alışveriş bağlamı kitle kurallarını zenginleştirebilir." : "Behavioral change and purchasing context derived from transaction history can enrich audience rules.")</p>
            </div>

            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-brain-line"></i></div>
                <h4>@(tr ? "Customer Intelligence Sinyalleri" : "Customer Intelligence Signals")</h4>
                <p>@(tr ? "Customer Intelligence tarafından hesaplanan değer, ritim veya diğer uygun müşteri sinyalleri hedef kitle kararına bağlam sağlayabilir." : "Calculated value, rhythm or other relevant customer signals from Customer Intelligence can provide context for audience decisions.")</p>
            </div>

            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="250">
                <div class="pika-sol-card-icon"><i class="ri-store-2-line"></i></div>
                <h4>@(tr ? "Ürün / Kategori Bağlamı" : "Product / Category Context")</h4>
                <p>@(tr ? "Müşterinin satın aldığı ürün veya kategori bilgisi, belirli ihtiyaç veya ürün davranışına yönelik kitlelerin tanımlanmasına yardımcı olabilir." : "Products or categories purchased by the customer can help define audiences around relevant needs or product behavior.")</p>
            </div>

            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-shield-check-line"></i></div>
                <h4>@(tr ? "İzin / Erişilebilirlik Bağlamı" : "Permission / Reachability Context")</h4>
                <p>@(tr ? "Mevcut izin veya iletişim erişilebilirliği bilgisi uygun olduğunda kitle kuralının veya sonraki aksiyon değerlendirmesinin bir parçası olabilir." : "Available permission or communication-reachability context can form part of an audience rule or downstream action evaluation where appropriate.")</p>
            </div>
        </div>

        <div class="p-4 rounded text-center mx-auto mt-4" style="background:#f8faf4;border:1px dashed #dce5d3;max-width:760px">
            <p class="ph-muted mb-1">
                @(tr ? "Bu bağlamların hiçbiri tek başına “doğru hedef kitle” değildir." : "None of these contexts alone defines the “right audience.”")
            </p>
            <p class="fw-bold mb-0" style="color:#23413b">
                @(tr ? "Audience Manager'ın görevi, gerekli bağlamları açık kurallarla bir araya getirmektir." : "The role of Audience Manager is to combine the required context through explicit rules.")
            </p>
        </div>
    </div>
</section>

@* ── 05 RULE LOGIC — AND / OR ────────────────────────────────── *@
<section class="pika-sol-section" id="rule-logic">
    <div class="container" style="max-width:860px">
        <span class="pika-sol-eyebrow">@(tr ? "KURAL MANTIĞI" : "RULE LOGIC")</span>
        <h2 class="pika-sol-section-title mb-3">
            @(tr ? "Hedef kitleyi açık koşullarla tanımlayın." : "Define the audience through explicit conditions.")
        </h2>
        @if (tr)
        {
            <p class="ph-muted">
                Gerçek hedefleme ihtiyacı çoğu zaman tek bir koşuldan oluşmaz.
            </p>
            <p class="ph-muted">
                Bir müşterinin bir özelliğe sahip olması yeterli olabilirken başka bir audience tanımında birden fazla koşulun aynı anda sağlanması gerekebilir.
            </p>
            <p class="ph-muted">
                Audience Manager kural gruplarında VE / VEYA mantığını kullanarak bu koşulların nasıl birleşeceğini tanımlamanıza yardımcı olur.
            </p>

            <div class="row g-3 my-3">
                <div class="col-md-6">
                    <div class="aud-rule-box h-100">
                        <span class="aud-rule-badge">VE / AND</span>
                        <p class="small ph-muted mb-0">
                            Müşterinin tanımlanan koşulların birlikte sağlanması gereken bölümüne uymasını ifade eder.
                        </p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="aud-rule-box h-100">
                        <span class="aud-rule-badge">VEYA / OR</span>
                        <p class="small ph-muted mb-0">
                            Tanımlanan alternatif koşullardan uygun olanlardan birini karşılayan müşterilerin değerlendirilmesini sağlar.
                        </p>
                    </div>
                </div>
            </div>

            <p class="ph-muted">
                Örneğin bir kitle tanımı şu bağlamları birlikte değerlendirebilir:
            </p>
            <div class="p-3 my-3 rounded bg-white border pika-editorial-note">
                <div class="mb-2" style="color:#23413b">Belirli bir ürün veya kategori davranışı</div>
                <div class="badge bg-light text-dark border my-1">VE</div>
                <div class="my-2" style="color:#23413b">uygun bir müşteri davranış sinyali</div>
                <div class="badge bg-light text-dark border my-1">VE</div>
                <div class="mt-2" style="color:#23413b">aksiyon açısından dikkate alınması gereken izin / erişilebilirlik bağlamı.</div>
            </div>

            <p class="ph-muted">
                Bu örnek sabit bir Pika segmenti değildir.
            </p>
            <p class="ph-muted">
                Audience Manager'ın değerini oluşturan şey, kullanıcının kendi iş kuralını açık biçimde tanımlayabilmesidir.
            </p>
            <div class="p-3 rounded mt-3 text-center" style="background:#f8faf4;border:1px dashed #dce5d3">
                <strong style="color:#23413b">Kitleyi bir isimle değil, onu oluşturan kurallarla tanımlayın.</strong>
            </div>
        }
        else
        {
            <p class="ph-muted">
                Real targeting requirements rarely consist of one condition.
            </p>
            <p class="ph-muted">
                One customer attribute may be enough for one audience, while another audience may require several conditions to be true at the same time.
            </p>
            <p class="ph-muted">
                Audience Manager helps define how those conditions combine through AND / OR logic inside rule groups.
            </p>

            <div class="row g-3 my-3">
                <div class="col-md-6">
                    <div class="aud-rule-box h-100">
                        <span class="aud-rule-badge">AND</span>
                        <p class="small ph-muted mb-0">
                            Represents the part of the definition where the customer must satisfy conditions that are required together.
                        </p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="aud-rule-box h-100">
                        <span class="aud-rule-badge">OR</span>
                        <p class="small ph-muted mb-0">
                            Allows customers to be evaluated when they satisfy one of the relevant alternative conditions.
                        </p>
                    </div>
                </div>
            </div>

            <p class="ph-muted">
                For example, an audience definition may evaluate:
            </p>
            <div class="p-3 my-3 rounded bg-white border pika-editorial-note">
                <div class="mb-2" style="color:#23413b">A relevant product or category behavior</div>
                <div class="badge bg-light text-dark border my-1">AND</div>
                <div class="my-2" style="color:#23413b">an appropriate customer behavioral signal</div>
                <div class="badge bg-light text-dark border my-1">AND</div>
                <div class="mt-2" style="color:#23413b">permission / reachability context that should be considered for action.</div>
            </div>

            <p class="ph-muted">
                This example is not a fixed Pika segment.
            </p>
            <p class="ph-muted">
                The value of Audience Manager is that users can define their own business rules explicitly.
            </p>
            <div class="p-3 rounded mt-3 text-center" style="background:#f8faf4;border:1px dashed #dce5d3">
                <strong style="color:#23413b">Define the audience not only by its name, but by the rules that create it.</strong>
            </div>
        }
    </div>
</section>

@* ── 06 DYNAMIC & REUSABLE AUDIENCES ─────────────────────────── *@

@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]="Audience Manager | "+(tr?"Segmentasyon":"Segmentation"); ViewData["MetaDescription"]=tr?"Customer Intelligence çıktıları ve doğrulanmış işlem/davranış kurallarıyla yönetilebilir hedef kitleler oluşturun.":"Build manageable audiences from Customer Intelligence context and verified transaction/behavior rules."; ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">Platform · Audience Manager</span><h1>@(tr?"Müşteriyi anladıktan sonra doğru kitleyi seçin.":"After understanding customers, choose the right audience.")</h1><p>@(tr?"Audience Manager, müşteri zekâsını ve iş kurallarını yönetilebilir segmentlere dönüştüren hedefleme katmanıdır. Customer Intelligence müşteriyi anlamaya; Audience Manager bu anlayıştan kime aksiyon uygulanacağını seçmeye odaklanır.":"Audience Manager turns customer intelligence and business rules into manageable segments. Customer Intelligence is about understanding; Audience Manager is about selecting who should enter an action.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/kisi-listesi-segmentler">@(tr?"Segmentasyon Rehberi":"Segmentation Guide")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_kisi-listesi-ve-segmentler_3.png" alt="@(tr?"Pika kişi listesi ve segmentasyon ekranı":"Pika customer list and segmentation screen")" width="1200" height="760" /><figcaption>@(tr?"Gerçek ürün görünümü: kişi listesi, filtreleme ve segment bağlamı.":"Product view: customer list, filtering and audience context.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">Understand → Select</span><h2>Customer Intelligence ≠ Audience Manager</h2></div><div><p class="pk-lead">@(tr?"Müşteri değeri, alışveriş ritmi veya fırsat sinyali bir insight'tır. Audience Manager bu insight'ları ve ek iş kurallarını hedef kitle seçimine dönüştürür. Böylece segmentasyon hesaplama katmanından kopmaz.":"Customer value, purchase rhythm and opportunity signals are insights. Audience Manager combines them with business rules for audience selection, keeping segmentation connected to calculated context.")</p><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/customer-intelligence":"/en/platform/customer-intelligence")">Customer Intelligence</a></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container"><div class="pk-columns"><div class="pk-feature"><h3>@(tr?"İşlem bazlı filtreler":"Transaction-based filters")</h3><p>@(tr?"Gerçekleşmiş alışveriş ve desteklenen ticari alanlardan hedef kitle kuralları üretin.":"Build audience rules from observed purchases and supported commercial fields.")</p></div><div class="pk-feature"><h3>@(tr?"Davranış ve intelligence":"Behavior & intelligence")</h3><p>@(tr?"Müşteri değeri, ritim, risk ve diğer hesaplanmış bağlamları uygun olduğu yerde segment kararında kullanın.":"Use customer value, rhythm, risk and other calculated context in audience decisions where supported.")</p></div><div class="pk-feature"><h3>@(tr?"Yeniden kullanılabilir hedefleme":"Reusable targeting")</h3><p>@(tr?"Tekrarlanan hedefleme mantığını segment/şablon yaklaşımıyla ekip içinde daha tutarlı hale getirin.":"Make recurring targeting logic more consistent across teams through reusable segment/template approaches.")</p></div></div></div></section>
<section class="pk-section"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">Audience → Action</span><h2>@(tr?"Hedef kitle, Campaign ve Journey'nin girdisidir.":"Audiences feed Campaign and Journey execution.")</h2></div><div><p class="pk-lead">@(tr?"Segment oluşturmak başlı başına gönderim değildir. Hedef kitle Campaign veya Journey'ye bağlandığında içerik, kanal, zamanlama, izin ve diğer yürütme kontrolleri ayrıca devreye girer.":"Creating a segment is not the same as sending. When an audience is used by Campaign or Journey, content, channel, timing, consent and other execution controls apply separately.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/campaign-manager":"/en/platform/campaign-manager")">Campaign Manager</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/journey-manager":"/en/platform/journey-manager")">Journey Manager</a></div></div></div></section>

                <div class="pika-sol-related-icon"><i class="ri-megaphone-line"></i></div>
                <div><h5>Campaign Manager</h5><p>@(tr ? "Segmentleri kampanyalara bağlayın." : "Connect segments to campaigns.")</p></div>
            </a>
            <a class="pika-sol-related-card" href="@Url.Action("JourneyManager", "Solutions")">
                <div class="pika-sol-related-icon"><i class="ri-route-line"></i></div>

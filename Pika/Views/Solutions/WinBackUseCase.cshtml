@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var isTr = culture == "tr";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-growth-usecases.css" asp-append-version="true" />
}

<!-- ═══════════════════════════ 01 HERO ═══════════════════════════ -->
<section class="inner-hero">
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(isTr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(isTr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <a href="@(isTr ? "/kullanim-senaryolari" : "/en/use-cases")">@(isTr ? "Kullanım Senaryoları" : "Use Cases")</a>
                <span>/</span>
                <span>@(isTr ? "Geri Kazanım" : "Win-back")</span>
            </nav>
            <div class="inner-eyebrow">
                <span></span>
                @(isTr ? "KULLANIM SENARYOSU — GERİ KAZANIM" : "USE CASE — WIN-BACK")
            </div>
            <h1>
                @(isTr
                    ? "Müşterinin sessizleşmesini, kendi geçmiş satın alma ritmine göre değerlendirin."
                    : "Evaluate customer inactivity against each customer's own purchase rhythm.")
            </h1>
            <p>
                @(isTr
                    ? "Pika, müşterinin hareketsizlik süresini kendi geçmiş satın alma ritmiyle karşılaştırarak pasifleşme ve win-back fırsatlarını Günün Fırsatları içinde görünür hale getirebilir."
                    : "Pika can compare customer inactivity with individual historical purchase rhythm to surface dormancy and win-back opportunities inside Daily Opportunities.")
            </p>
            <p class="text-secondary" style="font-size:15px;line-height:1.75;margin-top:-10px;margin-bottom:28px;">
                @(isTr
                    ? "Amaç herkese aynı hareketsizlik eşiğini uygulamak değil; müşterinin normal davranışından anlamlı sapmayı ticari değerlendirme bağlamına taşımaktır."
                    : "The objective is not to apply one inactivity threshold to every customer, but to turn meaningful deviation from normal customer behavior into commercial-evaluation context.")
            </p>
            <div class="inner-actions">
                <a class="inner-primary" href="@(isTr ? "/demo-talebi" : "/en/demo-request")">
                    @(isTr ? "Demo Talep Et" : "Request a Demo") ↗
                </a>
                <a class="inner-secondary" href="@(isTr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")">
                    @(isTr ? "Customer Intelligence'ı Keşfedin" : "Explore Customer Intelligence") →
                </a>
            </div>
        </div>

        <div class="inner-scene" aria-hidden="true">
            <div class="growth-uc-hero-visual">
                <div class="growth-uc-pipeline">
                    <div class="growth-uc-node">
                        <span>@(isTr ? "MÜŞTERİ GEÇMİŞİ" : "CUSTOMER HISTORY")</span>
                        <i class="ri-user-search-line"></i>
                    </div>
                    <div class="growth-uc-arrow">↓</div>
                    <div class="growth-uc-node">
                        <span>@(isTr ? "BİREYSEL RİTİM" : "INDIVIDUAL RHYTHM")</span>
                        <i class="ri-pulse-line"></i>
                    </div>
                    <div class="growth-uc-arrow">↓</div>
                    <div class="growth-uc-node growth-uc-node--accent">
                        <span>@(isTr ? "HAREKETSİZLİK" : "INACTIVITY")</span>
                        <i class="ri-time-line"></i>
                    </div>
                    <div class="growth-uc-arrow">↓</div>
                    <div class="growth-uc-node">
                        <span>@(isTr ? "RİSK SİNYALİ" : "RISK SIGNAL")</span>
                        <i class="ri-alarm-warning-line"></i>
                    </div>
                    <div class="growth-uc-arrow">↓</div>
                    <div class="growth-uc-node">
                        <span>@(isTr ? "WIN-BACK FIRSATI" : "WIN-BACK OPPORTUNITY")</span>
                        <i class="ri-arrow-go-back-line"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ 02 DIRECT ANSWER ═══════════════════════════ -->
<section class="pika-section" style="background:#f4f7ed;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="growth-uc-direct-answer">
                    <span class="pika-eyebrow">@(isTr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
                    <h2 class="pika-h2 mt-2 mb-3">
                        @(isTr ? "Pika'da win-back fırsatı nedir?" : "What is a win-back opportunity in Pika?")
                    </h2>
                    <p class="text-secondary mb-3" style="font-size:16px;line-height:1.8;">
                        @(isTr
                            ? "Win-back fırsatı, müşterinin son işleminden bu yana geçen süreyi kendi geçmiş satın alma ritmiyle karşılaştırarak olağan davranıştan anlamlı uzaklaşmanın değerlendirilmesidir."
                            : "A win-back opportunity evaluates the time since a customer's latest transaction against that customer's own historical purchase rhythm to identify meaningful deviation from normal behavior.")
                    </p>
                    <p class="text-secondary mb-3" style="font-size:16px;line-height:1.8;">
                        @(isTr
                            ? "Pika'nın dokümante edilmiş Churn & Dormancy Risk Engine'i hareketsizliği bireysel müşteri ritmi bağlamında değerlendirir."
                            : "Pika's documented Churn & Dormancy Risk Engine evaluates inactivity within individual customer-rhythm context.")
                    </p>
                    <div class="p-3 mb-3" style="background:#edf4e0;border-left:4px solid #7a9845;border-radius:4px;">
                        <strong class="d-block text-dark" style="font-size:14px;">
                            @(isTr
                                ? "Risk sinyali, müşterinin kesin olarak churn olduğu veya kaybedildiği anlamına gelmez."
                                : "A risk signal does not mean the customer has definitely churned or is definitively lost.")
                        </strong>
                    </div>
                    <p class="small text-muted mb-0 font-monospace">
                        @(isTr
                            ? "Bireysel ritim → sapma → risk sinyali → win-back fırsatı → kullanıcı kararı."
                            : "Individual rhythm → deviation → risk signal → win-back opportunity → user decision.")
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ 03 HOW PIKA IDENTIFIES THE OPPORTUNITY ═══════════════════════════ -->
<section class="pika-section" style="background:#fff;">
    <div class="container">
        <div class="text-center mb-5">
            <span class="pika-eyebrow">@(isTr ? "RİSK NASIL GÖRÜLÜR?" : "HOW THE RISK BECOMES VISIBLE")</span>
            <h2 class="pika-h2 mx-auto" style="max-width:820px;">
                @(isTr
                    ? "Evrensel bir gün sayısı yerine, müşterinin kendi normalini değerlendirin."
                    : "Evaluate each customer's normal, not one universal day count.")
            </h2>
        </div>

        <div class="growth-uc-step-grid mb-5">
            <div class="growth-uc-step-card">
                <span class="growth-uc-step-badge">01</span>
                <h3 class="h5 fw-bold mb-2">@(isTr ? "Müşteri Geçmişi" : "Customer History")</h3>
                <p class="text-secondary mb-0" style="font-size:14px;line-height:1.75;">
                    @(isTr
                        ? "Customer Intelligence müşterinin satın alma ve davranış bağlamını değerlendirmeye taşır."
                        : "Customer Intelligence brings customer purchase and behavioral context into the evaluation.")
                </p>
            </div>
            <div class="growth-uc-step-card">
                <span class="growth-uc-step-badge">02</span>
                <h3 class="h5 fw-bold mb-2">@(isTr ? "Bireysel Ritim" : "Individual Rhythm")</h3>
                <p class="text-secondary mb-0" style="font-size:14px;line-height:1.75;">
                    @(isTr
                        ? "Geçmiş işlem aralıkları müşterinin olağan satın alma ritmini anlamak için kullanılır."
                        : "Historical transaction intervals are used to understand the customer's normal purchase rhythm.")
                </p>
            </div>
            <div class="growth-uc-step-card">
                <span class="growth-uc-step-badge">03</span>
                <h3 class="h5 fw-bold mb-2">@(isTr ? "Hareketsizlik Sapması" : "Inactivity Deviation")</h3>
                <p class="text-secondary mb-0" style="font-size:14px;line-height:1.75;">
                    @(isTr
                        ? "Son işlemden bu yana geçen süre, müşterinin kendi geçmiş ritmiyle karşılaştırılır."
                        : "Time since the latest transaction is compared with the customer's own historical rhythm.")
                </p>
            </div>
            <div class="growth-uc-step-card">
                <span class="growth-uc-step-badge">04</span>
                <h3 class="h5 fw-bold mb-2">@(isTr ? "Win-back Fırsatı" : "Win-back Opportunity")</h3>
                <p class="text-secondary mb-0" style="font-size:14px;line-height:1.75;">
                    @(isTr
                        ? "Anlamlı sapma, kullanıcının değerlendirebileceği pasifleşme veya geri kazanım fırsatı olarak görünür hale gelebilir."
                        : "A meaningful deviation can become visible as a dormancy or win-back opportunity for user evaluation.")
                </p>
            </div>
        </div>

        <div class="text-center mx-auto" style="max-width:700px;">
            <p class="text-muted fst-italic mb-0" style="font-size:15px;line-height:1.8;">
                @(isTr
                    ? "Aynı sessizlik süresi, iki farklı müşteri için aynı ticari anlamı taşımak zorunda değildir."
                    : "The same period of inactivity does not have to mean the same commercial thing for two different customers.")
            </p>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ 04 FROM RISK TO ACTION ═══════════════════════════ -->
<section class="pika-section" style="background:#f9fbf6;">
    <div class="container">
        <div class="text-center mb-5">
            <span class="pika-eyebrow">@(isTr ? "RİSKTEN AKSİYONA" : "FROM RISK TO ACTION")</span>
            <h2 class="pika-h2 mx-auto" style="max-width:820px;">
                @(isTr ? "Risk sinyali, otomatik geri kazanım kampanyası değildir." : "A risk signal is not an automatic win-back campaign.")
            </h2>
        </div>

        <div class="growth-uc-flow-wrap mb-4">
            <div class="growth-uc-flow">
                <span class="growth-uc-flow-node">@(isTr ? "HAREKETSİZLİK SİNYALİ" : "INACTIVITY SIGNAL")</span>
                <span class="growth-uc-flow-arrow">→</span>
                <span class="growth-uc-flow-node">WIN-BACK OPPORTUNITY</span>
                <span class="growth-uc-flow-arrow">→</span>
                <span class="growth-uc-flow-node">@(isTr ? "KULLANICI DEĞERLENDİRMESİ" : "USER EVALUATION")</span>
                <span class="growth-uc-flow-arrow">→</span>
                <span class="growth-uc-flow-node">AUDIENCE</span>
                <span class="growth-uc-flow-arrow">→</span>
                <span class="growth-uc-flow-node">CAMPAIGN / JOURNEY</span>
                <span class="growth-uc-flow-arrow">→</span>
                <span class="growth-uc-flow-node">CONSENT</span>
                <span class="growth-uc-flow-arrow">→</span>
                <span class="growth-uc-flow-node">EMAIL / SMS / WHATSAPP</span>
                <span class="growth-uc-flow-arrow">→</span>
                <span class="growth-uc-flow-node">@(isTr ? "ÖLÇÜM" : "MEASUREMENT")</span>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-10">
                <p class="text-secondary text-center mb-3" style="font-size:15px;line-height:1.8;">
                    @(isTr
                        ? "Günün Fırsatları win-back fırsatını görünür hale getirebilir. Audience Manager gerçek hedef kitleyi tanımlar; Campaign Manager veya Journey Manager iletişim aksiyonunu yönetir; izin kontrollerinin ardından uygun kanal execution için kullanılabilir."
                        : "Daily Opportunities can surface the win-back opportunity. Audience Manager defines the actual audience; Campaign Manager or Journey Manager manages communication action; and after permission controls an eligible channel can be used for execution.")
                </p>
                <p class="text-center text-muted small mb-0">
                    @(isTr
                        ? "Risk tespiti, mesaj içeriğini, teklifi, kanalı ve gönderim kararını kendi başına belirlemez."
                        : "Risk detection does not independently decide message content, offer, channel or delivery.")
                </p>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ 05 WHAT THIS USE CASE IS / IS NOT ═══════════════════════════ -->
<section class="pika-section" style="background:#fff;">
    <div class="container">
        <div class="text-center mb-5">
            <span class="pika-eyebrow">@(isTr ? "ÜRÜN SINIRI" : "PRODUCT BOUNDARY")</span>
            <h2 class="pika-h2 mx-auto" style="max-width:820px;">
                @(isTr
                    ? "Win-back sinyalini, kesin churn sonucu gibi yorumlamayın."
                    : "Do not treat a win-back signal as definitive churn.")
            </h2>
        </div>

        <div class="growth-uc-boundary-grid mb-5">
            <div class="growth-uc-boundary-card">
                <i class="ri-close-circle-line"></i>
                <span>@(isTr ? "Win-back ≠ kesin churn tahmini" : "Win-back ≠ definitive churn prediction")</span>
            </div>
            <div class="growth-uc-boundary-card">
                <i class="ri-close-circle-line"></i>
                <span>@(isTr ? "Win-back ≠ herkese uygulanan sabit hareketsizlik eşiği" : "Win-back ≠ one fixed inactivity threshold for everyone")</span>
            </div>
            <div class="growth-uc-boundary-card">
                <i class="ri-close-circle-line"></i>
                <span>@(isTr ? "Win-back ≠ otomatik “seni özledik” mesajı" : "Win-back ≠ automatic “we miss you” message")</span>
            </div>
            <div class="growth-uc-boundary-card">
                <i class="ri-close-circle-line"></i>
                <span>@(isTr ? "Win-back ≠ otomatik teklif veya indirim" : "Win-back ≠ automatic offer or discount")</span>
            </div>
            <div class="growth-uc-boundary-card">
                <i class="ri-close-circle-line"></i>
                <span>@(isTr ? "Win-back ≠ iletişim izni" : "Win-back ≠ communication permission")</span>
            </div>
            <div class="growth-uc-boundary-card">
                <i class="ri-close-circle-line"></i>
                <span>@(isTr ? "Win-back ≠ geri dönüş veya ciro garantisi" : "Win-back ≠ reactivation or revenue guarantee")</span>
            </div>
        </div>

        <div class="text-center mx-auto" style="max-width:700px;">
            <p class="text-muted fst-italic mb-0" style="font-size:15px;line-height:1.8;">
                @(isTr
                    ? "Pika, müşteriyi “kaybedildi” diye kesin etiketlemek yerine, değerlendirilmeye değer davranış değişimini görünür kılar."
                    : "Rather than definitively labeling a customer as “lost,” Pika makes behavioral change worth evaluating visible.")
            </p>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ 06 RELATED PIKA LAYERS & USE CASES ═══════════════════════════ -->
<section class="pika-section" style="background:#f4f7ed;">
    <div class="container">
        <div class="text-center mb-5">
            <span class="pika-eyebrow">@(isTr ? "İLGİLİ PIKA KATMANLARI" : "RELATED PIKA LAYERS")</span>
            <h2 class="pika-h2 mx-auto" style="max-width:820px;">
                @(isTr
                    ? "Geri kazanım fırsatı tek bir modülün işi değildir."
                    : "A win-back opportunity is not the work of a single module.")
            </h2>
        </div>

        <div class="growth-uc-related-pills justify-content-center mb-5">
            <a href="@(isTr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")" class="growth-uc-pill">
                <i class="ri-parent-line"></i> Customer Intelligence
            </a>
            <a href="@(isTr ? "/platform/pika-360" : "/en/platform/pika-360")" class="growth-uc-pill">
                <i class="ri-user-star-line"></i> Pika 360
            </a>
            <a href="@(isTr ? "/platform/gunun-firsatlari" : "/en/platform/opportunities")" class="growth-uc-pill">
                <i class="ri-flashlight-line"></i> @(isTr ? "Günün Fırsatları" : "Daily Opportunities")
            </a>
            <a href="@(isTr ? "/cozumler/audience-manager" : "/en/solutions/audience-manager")" class="growth-uc-pill">
                <i class="ri-group-line"></i> Audience Manager
            </a>
            <a href="@(isTr ? "/cozumler/campaign-manager" : "/en/solutions/campaign-manager")" class="growth-uc-pill">
                <i class="ri-megaphone-line"></i> Campaign Manager
            </a>
            <a href="@(isTr ? "/cozumler/journey-manager" : "/en/solutions/journey-manager")" class="growth-uc-pill">
                <i class="ri-route-line"></i> Journey Manager
            </a>
            <a href="@(isTr ? "/cozumler/consent-management" : "/en/solutions/consent-management")" class="growth-uc-pill">
                <i class="ri-shield-check-line"></i> Consent Management
            </a>
            <a href="@(isTr ? "/cozumler/analytics-reporting" : "/en/solutions/analytics-reporting")" class="growth-uc-pill">
                <i class="ri-bar-chart-2-line"></i> Analytics &amp; Reporting
            </a>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <a href="@(isTr ? "/kullanim-senaryolari/tekrar-satin-alma" : "/en/use-cases/repeat-purchase")" class="growth-uc-card-link">
                    <span class="badge mb-2" style="background:#edf4e2;color:#64863e;border:1px solid #dce8cb;">@(isTr ? "KULLANIM SENARYOSU" : "USE CASE")</span>
                    <h3 class="h5 fw-bold mb-2">@(isTr ? "Tekrar Satın Alma" : "Repeat Purchase")</h3>
                    <p class="text-secondary small mb-0">
                        @(isTr
                            ? "Müşteri işlem geçmişi ve ürün tüketim ritmini değerlendirerek tekrar satın alma fırsatlarını görünür hale getirin."
                            : "Evaluate customer transaction history and product consumption rhythm to surface repeat-purchase opportunities.")
                    </p>
                </a>
            </div>
            <div class="col-md-4">
                <a href="@(isTr ? "/kullanim-senaryolari/capraz-satis" : "/en/use-cases/cross-sell")" class="growth-uc-card-link">
                    <span class="badge mb-2" style="background:#edf4e2;color:#64863e;border:1px solid #dce8cb;">@(isTr ? "KULLANIM SENARYOSU" : "USE CASE")</span>
                    <h3 class="h5 fw-bold mb-2">@(isTr ? "Çapraz Satış" : "Cross-sell")</h3>
                    <p class="text-secondary small mb-0">
                        @(isTr
                            ? "Geçmiş sepet birlikteliklerinden anlamlı ürün ilişkilerini istatistiksel association mining ile belirleyin."
                            : "Identify meaningful product relationships from historical baskets with statistical association mining.")
                    </p>
                </a>
            </div>
            <div class="col-md-4">
                <a href="@(isTr ? "/kullanim-senaryolari" : "/en/use-cases")" class="growth-uc-card-link">
                    <span class="badge mb-2" style="background:#edf4e2;color:#64863e;border:1px solid #dce8cb;">@(isTr ? "TÜM SENARYOLAR" : "ALL USE CASES")</span>
                    <h3 class="h5 fw-bold mb-2">@(isTr ? "Tüm Kullanım Senaryoları" : "All Use Cases")</h3>
                    <p class="text-secondary small mb-0">
                        @(isTr
                            ? "Müşteri zekâsı ve kontrollü omnichannel pazarlama için tüm kullanım senaryolarını keşfedin."
                            : "Explore all use cases for customer intelligence and controlled omnichannel marketing.")
                    </p>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ 07 FAQ ═══════════════════════════ -->
<section class="pika-section" style="background:#fff;">
    <div class="container">
        <div class="text-center mb-5">
            <span class="pika-eyebrow">@(isTr ? "SIKÇA SORULAN SORULAR" : "FREQUENTLY ASKED QUESTIONS")</span>
            <h2 class="pika-h2">@(isTr ? "Geri Kazanım Hakkında Sorular" : "Questions About Win-back")</h2>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="growth-uc-faq-list">
                    <details class="growth-uc-faq-details">
                        <summary class="growth-uc-faq-summary">
                            @(isTr ? "Pika win-back fırsatını nasıl belirler?" : "How does Pika identify a win-back opportunity?")
                        </summary>
                        <p class="growth-uc-faq-content">
                            @(isTr
                                ? "Pika müşterinin son işleminden bu yana geçen süreyi kendi geçmiş satın alma ritmiyle karşılaştırarak olağan davranıştan anlamlı sapmayı değerlendirebilir."
                                : "Pika can compare time since the customer's latest transaction with the customer's own historical purchase rhythm to evaluate meaningful deviation from normal behavior.")
                        </p>
                    </details>

                    <details class="growth-uc-faq-details">
                        <summary class="growth-uc-faq-summary">
                            @(isTr ? "Pika herkese aynı hareketsizlik eşiğini mi uygular?" : "Does Pika apply the same inactivity threshold to every customer?")
                        </summary>
                        <p class="growth-uc-faq-content">
                            @(isTr
                                ? "Hayır. Dokümante edilmiş Churn & Dormancy Risk yaklaşımı hareketsizliği bireysel müşteri ritmi bağlamında değerlendirir."
                                : "No. The documented Churn & Dormancy Risk approach evaluates inactivity within individual customer-rhythm context.")
                        </p>
                    </details>

                    <details class="growth-uc-faq-details">
                        <summary class="growth-uc-faq-summary">
                            @(isTr ? "Risk sinyali müşterinin kesin churn olduğu anlamına gelir mi?" : "Does a risk signal mean the customer has definitely churned?")
                        </summary>
                        <p class="growth-uc-faq-content">
                            @(isTr
                                ? "Hayır. Risk sinyali değerlendirme bağlamıdır; müşterinin kesin olarak kaybedildiği anlamına gelmez."
                                : "No. A risk signal is evaluation context; it does not mean the customer is definitively lost.")
                        </p>
                    </details>

                    <details class="growth-uc-faq-details">
                        <summary class="growth-uc-faq-summary">
                            @(isTr ? "Win-back fırsatı otomatik kampanya başlatır mı?" : "Does a win-back opportunity automatically start a campaign?")
                        </summary>
                        <p class="growth-uc-faq-content">
                            @(isTr
                                ? "Hayır. Fırsat kullanıcı değerlendirmesine sunulur; Audience, Campaign veya Journey ve consent kontrolleri ayrı katmanlarda yönetilir."
                                : "No. The opportunity is presented for user evaluation; Audience, Campaign or Journey and consent controls remain separate product layers.")
                        </p>
                    </details>

                    <details class="growth-uc-faq-details">
                        <summary class="growth-uc-faq-summary">
                            @(isTr ? "Pika win-back teklifini veya indirimi kendi başına belirler mi?" : "Does Pika independently decide the win-back offer or discount?")
                        </summary>
                        <p class="growth-uc-faq-content">
                            @(isTr
                                ? "C27 böyle bir otonom teklif veya indirim kararı iddia etmez. Ticari aksiyon kullanıcı kontrolünde kalır."
                                : "C27 makes no autonomous offer or discount-decision claim. Commercial action remains under user control.")
                        </p>
                    </details>

                    <details class="growth-uc-faq-details">
                        <summary class="growth-uc-faq-summary">
                            @(isTr ? "Win-back analizi müşterinin geri döneceğini garanti eder mi?" : "Does win-back analysis guarantee customer reactivation?")
                        </summary>
                        <p class="growth-uc-faq-content">
                            @(isTr
                                ? "Hayır. Risk veya fırsat sinyali reactivation, conversion, satış veya revenue garantisi değildir."
                                : "No. A risk or opportunity signal is not a guarantee of reactivation, conversion, sales or revenue.")
                        </p>
                    </details>
                </div>
            </div>
        </div>
    </div>
</section>


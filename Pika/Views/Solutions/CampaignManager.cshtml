@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    var wikiBase = "/wiki/";
    ViewData["Title"] = tr ? "Campaign Manager | Çok Kanallı Kampanya Yönetimi" : "Campaign Manager | Multi-Channel Campaign Execution";
    ViewData["MetaDescription"] = tr ? "Pika Campaign Manager; hedef kitle seçimi, içerik şablonları, kanal izin kontrolü, zamanlama ve gelir atıfını tek kontrollü akışta birleştiren kampanya yönetim modülüdür." : "Pika Campaign Manager unifies audience selection, content templates, consent verification, scheduling, and revenue attribution in one controlled workflow.";
    ViewData["BodyClass"] = "pika-platform-page";
}

@* ── CHAPTER 1: HERO ────────────────────────────────────────── *@
@await Html.PartialAsync("_MarketingHero")

@* ── CHAPTER 2: LLM DEFINITION & BUSINESS PROBLEM ───────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        @* Plain LLM Definition Box *@
        <div class="p-4 rounded-4 mb-5" style="background:#ffffff;border:1px solid #dcebc7" data-aos="fade-up">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="ri-information-line text-success fw-bold"></i>
                <span class="fw-bold text-dark text-uppercase small" style="letter-spacing:0.06em">@(tr ? "Campaign Manager Nedir?" : "What is Campaign Manager?")</span>
            </div>
            <p class="mb-0 text-secondary" style="font-size:1.02rem;line-height:1.6">
                @(tr ? "Campaign Manager; Pika platformunda oluşturulan hedef kitle segmentlerini, onaylı içerik şablonlarını ve ticari iletişim izinlerini (İYS/KVKK) tek merkezde birleştirerek WhatsApp, SMS, E-posta ve Mobil Push kanallarından kontrollü, zamanlanmış veya anlık gönderim gerçekleştiren ve oluşan ciroyu kampanyaya atfeden merkezi kampanya orkestrasyon modülüdür." : "Campaign Manager is Pika's central campaign orchestration engine that combines audience cohorts, verified message templates, and opt-in consent records (IYS/GDPR) to execute scheduled or real-time dispatches across WhatsApp, SMS, Email, and Push notifications while attributing direct revenue.")
            </p>
        </div>

        <div class="row align-items-center g-5 ph-split-row">
            <div class="col-lg-6" data-aos="fade-right">
                <span class="ph-eyebrow">@(tr ? "Operasyonel Verimlilik" : "Operational Efficiency")</span>
                <h2 class="pika-h2 fw-bold mb-3">@(tr ? "Kampanya Süreçlerindeki Dağınıklığı Bitirin" : "Eliminate Campaign Operational Chaos")</h2>
                <p class="ph-muted mb-3" style="font-size:1.05rem">
                    @(tr ? "Farklı araçlar arasında kitle listesi taşımak, izinleri manuel denetlemek ve geri dönüşleri tahmin etmek yerine uçtan uca tek platform:" : "Replace disparate tools, manual list exports, and guesswork with a single audited pipeline:")
                </p>
                <div class="p-3 rounded-3 bg-white border mb-3">
                    <div class="fw-bold text-dark small mb-1"><i class="ri-shield-keyhole-line text-success me-1"></i> <strong>Sıfır Hata ve Otomatik İYS Koruması</strong></div>
                    <div class="small ph-muted">Her gönderim anında izinler canlı sorgulanır; ceza veya şikayet riski ortadan kalkar.</div>
                </div>
                <div class="p-3 rounded-3 bg-white border">
                    <div class="fw-bold text-dark small mb-1"><i class="ri-money-dollar-circle-line text-primary me-1"></i> <strong>Net Gelir ve Ciro Ölçümü</strong></div>
                    <div class="small ph-muted">Sadece açılma ve tıklama değil, kampanyanın kasaya kazandırdığı gerçek TL tutarını izleyin.</div>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <div class="d-flex flex-column gap-3 p-4 rounded-4 bg-white border">
                    <div class="fw-bold small text-uppercase" style="color:var(--pika-color-brand-primary-dark);letter-spacing:0.06em">
                        @(tr ? "Campaign Manager 4 Adımlı Gönderim Hattı" : "Campaign Manager 4-Stage Pipeline")
                    </div>
                    <div class="d-flex align-items-start gap-3 p-2 rounded-2 bg-light">
                        <div class="ph-unboxed-icon flex-shrink-0" style="width:30px;height:30px;font-size:0.8rem;font-weight:800;margin-bottom:0">1</div>
                        <div>
                            <div class="fw-bold text-dark small">@(tr ? "Kitleyi Seçin (Audience Manager)" : "Select Cohort (Audience Manager)")</div>
                            <div class="small ph-muted">RFM, davranışsal veya demografik kurallara göre dinamik listeyi belirleyin.</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3 p-2 rounded-2 bg-light">
                        <div class="ph-unboxed-icon flex-shrink-0" style="width:30px;height:30px;font-size:0.8rem;font-weight:800;margin-bottom:0">2</div>
                        <div>
                            <div class="fw-bold text-dark small">@(tr ? "Şablonu & Kanalı Belirleyin" : "Select Verified Template & Channel")</div>
                            <div class="small ph-muted">WhatsApp, SMS, E-posta veya Push formatında onaylı şablonu eşleştirin.</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3 p-2 rounded-2 bg-light">
                        <div class="ph-unboxed-icon flex-shrink-0" style="width:30px;height:30px;font-size:0.8rem;font-weight:800;margin-bottom:0">3</div>
                        <div>
                            <div class="fw-bold text-dark small">@(tr ? "Canlı İzin & İYS Filtreleme" : "Real-Time Consent & Opt-In Filter")</div>
                            <div class="small ph-muted">Yalnızca aktif izni olan alıcılar gönderim sırasına alınır.</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3 p-2 rounded-2" style="background:#f0fdf4;border:1px solid #bbf7d0">
                        <div class="ph-unboxed-icon flex-shrink-0" style="width:30px;height:30px;font-size:0.8rem;font-weight:800;margin-bottom:0"><i class="ri-check-line"></i></div>
                        <div>
                            <div class="fw-bold text-dark small">@(tr ? "4. Güvenli Yayına Alma & Ciro Takibi" : "4. Dispatch & Revenue Attribution")</div>
                            <div class="small ph-muted">Tetiklenen mesajların teslimat, tıklama ve sipariş dönüşümleri canlı akar.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── CHAPTER 3: PRODUCT PROOF (Real Software UI) ─────────────── *@
<section class="ph-section ph-section-plain">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "Ürün Kanıtı" : "Product Proof")</span>
            <h2 class="pika-h2 fw-bold">@(tr ? "Gerçek Kampanya Konsolu ve Yayına Alma Akışı" : "Live Campaign Operations & Dispatch Cockpit")</h2>
            <p class="ph-muted mx-auto" style="max-width:620px">
                @(tr ? "Pika Campaign Manager ekranında hedef kitle seçimi, kanal önizlemesi ve gönderim onay tuvali." : "Real-world view of cohort selection, multi-channel template binding, and dispatch control in Pika.")
            </p>
        </div>

        <div class="row justify-content-center" data-aos="fade-up" data-aos-delay="100">
            <div class="col-lg-10">
                <div class="ph-cockpit p-2 shadow-lg">
                    <img src="/wiki/assets/images/img_kampanya-yonetimi_0.png"
                         alt="@(tr ? "Pika Campaign Manager Operasyon Konsolu" : "Pika Campaign Manager Live Interface")"
                         class="img-fluid rounded-3 w-100"
                         loading="lazy" />
                </div>
                <div class="text-center mt-3 small text-muted">
                    <i class="ri-checkbox-circle-line text-success me-1"></i>
                    @(tr ? "Pika canlı yazılım arayüzü: Çok kanallı kampanya oluşturma, izin kontrolü ve yayına alma akışı." : "Live Pika interface: Multi-channel campaign builder, opt-in verification, and execution workflow.")
                </div>
            </div>
        </div>
    </div>
</section>

@* ── CHAPTER 4: 6 CORE VERIFIED CAPABILITIES ─────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "Yetenekler" : "Capabilities")</span>
            <h2 class="pika-h2 fw-bold">@(tr ? "Campaign Manager Ne Sunar?" : "What Does Campaign Manager Deliver?")</h2>
        </div>

        <div class="row g-4" data-aos="fade-up" data-aos-delay="100">
            <div class="col-lg-4 col-md-6">
                <div class="ph-trust-card h-100 p-4 d-flex flex-column">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-whatsapp-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Çok Kanallı Tek Akış" : "Unified Multi-Channel")</h5>
                    <p class="small ph-muted mb-3">
                        @(tr ? "SMS, WhatsApp Business API, E-posta ve Push mesajlarını aynı arayüzden tek tıkla yönetin." : "Deploy SMS, WhatsApp, Email, and Push dispatches from a single unified operational dashboard.")
                    </p>
                    <a href="@(wikiBase)kampanya-yonetimi" class="small fw-bold text-decoration-none mt-auto" style="color:var(--pika-color-brand-primary-dark)">
                        @(tr ? "Wiki'de İncele →" : "Read in Wiki →")
                    </a>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="ph-trust-card h-100 p-4 d-flex flex-column">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-group-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Dinamik Segment Bağlantısı" : "Dynamic Cohort Binding")</h5>
                    <p class="small ph-muted mb-3">
                        @(tr ? "Audience Manager'da hazırlanan segmentleri anlık bağlayın; liste yükleme zahmetini unutun." : "Bind cohorts directly from Audience Manager without manual CSV exports or static lists.")
                    </p>
                    <a href="@(wikiBase)segment-sablonlari" class="small fw-bold text-decoration-none mt-auto" style="color:var(--pika-color-brand-primary-dark)">
                        @(tr ? "Wiki'de İncele →" : "Read in Wiki →")
                    </a>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="ph-trust-card h-100 p-4 d-flex flex-column">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-time-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Gelişmiş Zamanlama ve Hız Limiti" : "Scheduling & Throttle Control")</h5>
                    <p class="small ph-muted mb-3">
                        @(tr ? "Kampanyaları ileri tarihe planlayın, alıcı başına gönderim hızını (throttling) belirleyin." : "Schedule future batches and regulate delivery rates per second to protect server capacity.")
                    </p>
                    <a href="@(wikiBase)izin-kanal-zamanlama" class="small fw-bold text-decoration-none mt-auto" style="color:var(--pika-color-brand-primary-dark)">
                        @(tr ? "Wiki'de İncele →" : "Read in Wiki →")
                    </a>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="ph-trust-card h-100 p-4 d-flex flex-column">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-user-heart-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Dinamik Kişiselleştirme" : "Dynamic Personalization")</h5>
                    <p class="small ph-muted mb-3">
                        @(tr ? "İsim, son alınan ürün, özel sepet linki ve mağaza koordinatlarını dinamik token'larla mesaja gömün." : "Embed recipient names, last purchased items, and dynamic cart links seamlessly.")
                    </p>
                    <a href="@(wikiBase)content-studio" class="small fw-bold text-decoration-none mt-auto" style="color:var(--pika-color-brand-primary-dark)">
                        @(tr ? "Wiki'de İncele →" : "Read in Wiki →")
                    </a>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="ph-trust-card h-100 p-4 d-flex flex-column">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-shield-check-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Yasal İzin ve İYS Uyumu" : "Consent & IYS Compliance")</h5>
                    <p class="small ph-muted mb-3">
                        @(tr ? "Gönderim listesini anlık olarak ticari izin veritabanıyla filtreleyerek ceza riskini sıfırlayın." : "Audit recipient lists against opt-in records prior to send to maintain legal compliance.")
                    </p>
                    <a href="@(wikiBase)izin-kanal-zamanlama" class="small fw-bold text-decoration-none mt-auto" style="color:var(--pika-color-brand-primary-dark)">
                        @(tr ? "Wiki'de İncele →" : "Read in Wiki →")
                    </a>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="ph-trust-card h-100 p-4 d-flex flex-column">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-line-chart-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Doğrudan Ciro Atfı" : "Revenue Attribution")</h5>
                    <p class="small ph-muted mb-3">
                        @(tr ? "Hangi kampanyanın kaç TL satış ve sipariş getirdiğini doğrudan fatura kayıtlarıyla eşleştirin." : "Attribute resulting orders and monetary revenue directly back to each campaign message.")
                    </p>
                    <a href="@(wikiBase)bi-kokpit" class="small fw-bold text-decoration-none mt-auto" style="color:var(--pika-color-brand-primary-dark)">
                        @(tr ? "Wiki'de İncele →" : "Read in Wiki →")
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── CHAPTER 5: PLATFORM VALUE CHAIN ─────────────────────────── *@

@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]="Campaign Manager | "+(tr?"Kampanya Yönetimi":"Campaign Management");
    ViewData["MetaDescription"]=tr?"Pika Campaign Manager ile hedef kitle, içerik, kanal, zamanlama, uygunluk ve yayınlama adımlarını kontrollü bir kampanya operasyonunda birleştirin; sonucu Analytics ile değerlendirin.":"Use Pika Campaign Manager to bring audience, content, channel, timing, eligibility and publishing into a controlled campaign operation and review outcomes in Analytics.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">Platform · Campaign Manager</span><h1>@(tr?"Fırsatı kontrollü, ölçülebilir bir kampanyaya dönüştürün.":"Turn an opportunity into a controlled, measurable campaign.")</h1><p>@(tr?"Campaign Manager; hedef kitle, içerik, iletişim kanalı, zamanlama ve yayınlama kararlarını tek kampanya operasyonunda birleştirir. Pika'nın tamamı değildir; Customer Intelligence, Günün Fırsatları ve Audience Manager gibi katmanlardan sonra gelen kontrollü aksiyon motorlarından biridir.":"Campaign Manager combines audience, content, communication channel, timing and publishing into one campaign operation. It is not the whole of Pika, but one controlled execution engine after Customer Intelligence, Daily Opportunities and Audience Manager.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Campaign Manager'ı Canlı Görün":"See Campaign Manager Live")</button><a class="pk-btn pk-btn-ghost" href="/wiki/kampanya-yoneticisi-ve-kurgular">@(tr?"Kampanya rehberi":"Campaign guide")</a></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_yayinlama-sablon-ve-yonetim_27.png" alt="@(tr?"Pika kampanya yayınlama ve yönetim ekranı":"Pika campaign publishing and management screen")" width="1200" height="760" /><div class="pk-stage-caption"><strong>Campaign Manager</strong><span>@(tr?"Taslak · Kontrol · Yayın · Ölçüm":"Draft · Review · Publish · Measure")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-group-line"></i><div><strong>Audience</strong><small>@(tr?"Kime?":"Who?")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-send-plane-line"></i><div><strong>@(tr?"Yayınlama":"Publishing")</strong><small>@(tr?"Kontrollü yürütme":"Controlled execution")</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-bar-chart-box-line"></i><div><strong>Analytics</strong><small>@(tr?"Ne oldu?":"What happened?")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Tanım":"Definition")</span><h2>@(tr?"Campaign Manager nedir?":"What is Campaign Manager?")</h2></div><p class="pk-lead">@(tr?"Campaign Manager, belirli bir hedef kitleye belirli içerik ve kanal üzerinden, belirli zamanlama ve yayınlama kontrolleriyle aksiyon uygulamak için kullanılan kampanya yürütme katmanıdır. Hedef kitleyi neden seçtiğiniz Customer Intelligence veya fırsat bağlamından gelebilir; Campaign Manager bu kararı operasyon haline getirir.":"Campaign Manager is the execution layer used to act on a defined audience with defined content, channel, timing and publishing controls. The reason for choosing the audience may come from Customer Intelligence or opportunity context; Campaign Manager turns that decision into an operation.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-group-line"></i><strong>Audience</strong><span>@(tr?"Kime ulaşacağız?":"Who will we reach?")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-file-edit-line"></i><strong>Content</strong><span>@(tr?"Ne söyleyeceğiz?":"What will we say?")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-message-3-line"></i><strong>Channel</strong><span>@(tr?"Hangi uygun kanaldan?":"Through which eligible channel?")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-calendar-schedule-line"></i><strong>Schedule</strong><span>@(tr?"Ne zaman?":"When?")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-shield-check-line"></i><strong>Control</strong><span>@(tr?"İzin ve yayın kontrolü":"Consent and publishing control")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>Measure</strong><span>Analytics</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Fırsattan kampanyaya":"From opportunity to campaign")</span><h2>@(tr?"Boş sayfadan başlamayın; neden aksiyon aldığınızı koruyun.":"Do not start from a blank page; preserve why you are acting.")</h2></div><p class="pk-lead">@(tr?"Günün Fırsatları veya Customer Intelligence belirli bir müşteri/kitle bağlamını görünür kıldığında, Campaign Manager bu bağlamı hedef kitle, içerik ve kanal kararına taşır. Böylece kampanya yalnız 'gönderilecek mesaj' değil, açıklanabilir bir iş kararının yürütülmesi olur.":"When Daily Opportunities or Customer Intelligence surfaces relevant context, Campaign Manager carries it into audience, content and channel decisions. A campaign becomes execution of an explainable business decision rather than merely a message to send.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_aksiyon-calisma-alani_9.png" alt="@(tr?"Pika aksiyon çalışma alanı":"Pika action workspace")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Opportunity → Action</small><h3>@(tr?"Fırsat bağlamından kampanya hazırlığına":"From opportunity context to campaign preparation")</h3><p>@(tr?"Müşteri/fırsat bağlamı, sonraki içerik ve hedefleme kararında neden aksiyon alındığını görünür tutmaya yardımcı olur." : "Customer and opportunity context helps preserve why action was considered when preparing content and targeting.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_yayinlama-sablon-ve-yonetim_27.png" alt="@(tr?"Pika kampanya yayınlama ve şablon yönetimi":"Pika campaign publishing and template management")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Yayınlama ve yeniden kullanım":"Publishing and reuse")</small><h3>@(tr?"Taslak, kontrol ve yayın durumunu yönetin":"Manage draft, review and publish states")</h3><p>@(tr?"Kampanya operasyonunu yalnız son gönderim anına indirgemeden yaşam döngüsü boyunca görünür tutun." : "Keep the campaign operation visible throughout its lifecycle, not only at the moment of sending.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">@(tr?"Yürütme kontrolü":"Execution control")</span><h2>@(tr?"Kime, neyi, hangi kanaldan ve ne zaman göndereceğinizi ayrı kararlar olarak yönetin.":"Manage who, what, channel and timing as separate decisions.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"İyi kampanya yönetimi yalnız içerik editörü değildir. Hedef kitle, kanal uygunluğu, zamanlama ve yayınlama sorumlulukları birbirinden ayrıldığında ekip hem daha hızlı hem daha kontrollü çalışabilir.":"Good campaign management is more than a content editor. Separating audience, channel eligibility, timing and publishing responsibilities supports faster and more controlled execution.")</p></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-filter-3-line"></i><div><strong>@(tr?"Hedef kitle":"Audience")</strong><span>@(tr?"Audience Manager veya fırsat bağlamından gelen seçilebilir müşteri kümesi." : "A selectable customer set from Audience Manager or opportunity context.")</span></div></div><div class="pk-control-step"><i class="ri-file-edit-line"></i><div><strong>@(tr?"İçerik":"Content")</strong><span>@(tr?"Content Studio, şablon veya AI destekli taslakla hazırlanan mesaj içeriği." : "Message content prepared through Content Studio, templates or AI-assisted drafting.")</span></div></div><div class="pk-control-step"><i class="ri-shield-check-line"></i><div><strong>@(tr?"Kanal ve uygunluk":"Channel and eligibility")</strong><span>@(tr?"İzin, opt-out, adres ve desteklenen kanal koşulları iletişimden önce değerlendirilir." : "Consent, opt-out, address and supported channel conditions are considered before communication.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-user-follow-line"></i><div><strong>@(tr?"Yayın kararı":"Publish decision")</strong><span>@(tr?"AI veya fırsat motoru kampanyayı kendi başına yayınlamaz; yayınlama kontrollü bir kullanıcı/operasyon adımıdır." : "AI or opportunity logic does not independently publish a campaign; publishing remains a controlled user/operations step.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">Campaign vs Journey</span><h2>@(tr?"Tanımlı kampanya mı, zaman içinde ilerleyen müşteri akışı mı?":"A defined campaign, or a customer flow that progresses over time?")</h2></div><p class="pk-lead">@(tr?"Campaign Manager belirli hedef kitle, içerik, kanal ve zamanla yürütülen kampanyalar için uygundur. Journey Manager ise müşterinin tetikleyici, koşul, bekleme ve aksiyon adımları boyunca ilerlediği sürekli senaryoları yönetir. Aynı intelligence ve fırsat bağlamından beslenebilirler fakat yürütme modeli farklıdır.":"Campaign Manager is for defined audience/content/channel/time execution. Journey Manager handles ongoing customer progression through triggers, conditions, waits and actions. Both may use the same intelligence and opportunity context, but their execution model differs.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>Campaign 01</small><i class="ri-group-line"></i><strong>@(tr?"Tanımlı kitle":"Defined audience")</strong><span>@(tr?"Kampanya kapsamı baştan bellidir":"Campaign scope is defined")</span></div><div class="pk-workflow-step"><small>Campaign 02</small><i class="ri-calendar-event-line"></i><strong>@(tr?"Tanımlı zaman":"Defined timing")</strong><span>@(tr?"Planlanan gönderim/yayın":"Planned execution")</span></div><div class="pk-workflow-step"><small>Campaign 03</small><i class="ri-send-plane-line"></i><strong>@(tr?"Yayınla":"Publish")</strong><span>@(tr?"Kontrollü kampanya yürütme":"Controlled campaign execution")</span></div><div class="pk-workflow-step"><small>Journey 01</small><i class="ri-play-circle-line"></i><strong>Trigger</strong><span>@(tr?"Müşteri akışa girer":"Customer enters the flow")</span></div><div class="pk-workflow-step"><small>Journey 02</small><i class="ri-git-branch-line"></i><strong>Condition / Wait</strong><span>@(tr?"Duruma göre ilerler":"Progresses by context")</span></div><div class="pk-workflow-step"><small>Journey 03</small><i class="ri-route-line"></i><strong>Action</strong><span>@(tr?"Zaman içindeki uygun adım":"Appropriate step over time")</span></div></div><div class="pk-decision-note"><p>@(tr?"İkisi de Pika'nın aksiyon katmanıdır; biri diğerinin 'gelişmiş sürümü' değildir. Doğru araç senaryonun yürütme modeline göre seçilir." : "Both are execution layers in Pika; one is not simply an advanced version of the other. The correct tool depends on the execution model.")</p><a class="pk-btn pk-btn-light" href="@(tr?"/platform/journey-manager":"/en/platform/journey-manager")">Journey Manager</a></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">Content + Channels</span><h2>@(tr?"İçeriği üretin, uygun kanalı seçin, marka dilini koruyun.":"Create content, choose an eligible channel and preserve brand language.")</h2></div><p class="pk-lead">@(tr?"Campaign Manager içerik üretmenin kendisi değildir. Content Studio ve Pika AI hazırlığı destekleyebilir; Email, SMS, WhatsApp ve Push ise uygun senaryolarda yürütme kanallarıdır. Kanal seçimi izin ve müşteri bağlamından bağımsız düşünülmemelidir.":"Campaign Manager is not itself the content-authoring layer. Content Studio and Pika AI can assist preparation, while Email, SMS, WhatsApp and Push are execution channels where appropriate. Channel choice should not be separated from consent and customer context.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_email-template-editor_17.png" alt="@(tr?"Pika email içerik editörü":"Pika email content editor")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Content Studio</small><h3>@(tr?"İçeriği kampanya operasyonundan koparmayın":"Keep content connected to campaign operations")</h3><p>@(tr?"Şablon ve içerik hazırlığını hedef kitle ve kanal bağlamıyla birlikte değerlendirin." : "Review templates and content together with audience and channel context.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_izin-kanal-zamanlama_25.png" alt="@(tr?"Pika izin kanal ve zamanlama ekranı":"Pika consent channel and timing screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Kanal uygunluğu":"Channel eligibility")</small><h3>@(tr?"Gönderilebilir olmak hedef kitlede olmaktan farklıdır":"Being in the audience is different from being eligible to send")</h3><p>@(tr?"İzin, opt-out ve kanal koşulları yürütme öncesinde ayrıca değerlendirilir." : "Consent, opt-out and channel conditions are evaluated separately before execution.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Ölçüm":"Measurement")</span><h2>@(tr?"Kampanya yayınlandıktan sonra asıl soru başlar: ne oldu?":"After publishing, the real question begins: what happened?")</h2></div><p class="pk-lead">@(tr?"Campaign Manager kampanyayı yürütür; Analytics desteklenen gönderim ve etkileşim sonuçlarını, uygun olduğunda attribution bağlamını değerlendirmeye yardımcı olur. Attribution kampanya sonrası davranışla ilişki kurabilir; tek başına nedensellik kanıtı değildir.":"Campaign Manager executes the campaign; Analytics helps review supported delivery and engagement outcomes and attribution context where available. Attribution can associate later behavior with a campaign, but it does not by itself prove causality.")</p></div><div class="pk-insight-split"><article class="pk-insight-card"><div class="pk-insight-card-copy"><span class="pk-eyebrow">Analytics</span><h3>@(tr?"Gönderimden sonuca":"From delivery to outcome")</h3><p>@(tr?"Kampanya ve kanal performansını tek gönderim sayısına indirgemeden, desteklenen etkileşim ve sonuç bağlamıyla birlikte okuyun." : "Read campaign and channel performance through supported engagement and outcome context rather than send count alone.")</p><a class="pk-text-link" href="@(tr?"/platform/analytics":"/en/platform/analytics")">@(tr?"Analytics'i inceleyin":"Explore Analytics") <i class="ri-arrow-right-line"></i></a></div><div class="pk-insight-card-visual"><img src="/wiki/assets/images/img_bi-kokpit_5.png" alt="@(tr?"Pika analitik görünümü":"Pika analytics view")" loading="lazy" width="1200" height="760" /></div></article><article class="pk-insight-card pk-ai"><div class="pk-insight-card-copy"><span class="pk-eyebrow" style="color:#cfc9ff">Pika AI</span><h3>@(tr?"Taslağı hızlandırın, kontrolü bırakmayın":"Accelerate drafting without giving up control")</h3><p>@(tr?"AI Campaign Assistant içerik ve açıklama desteği sunabilir. Hedef kitle, izin, kampanya ayarları ve yayınlama kararı ayrı sistem/kullanıcı kontrollerinde kalır." : "AI Campaign Assistant can assist content and explanations. Audience, consent, campaign settings and publishing decisions remain separate system/user controls.")</p><a class="pk-text-link" href="@(tr?"/platform/ai-kampanya-asistani":"/en/platform/ai-campaign-assistant")">@(tr?"Pika AI'ı inceleyin":"Explore Pika AI") <i class="ri-arrow-right-line"></i></a></div><div class="pk-insight-card-visual"><img src="/wiki/assets/images/img_pika-pilot-ai-kampanya-asistani_16.png" alt="Pika AI Campaign Assistant" loading="lazy" width="1200" height="760" /></div></article></div></div></section>

</section>

@* ── CHAPTER 7: FREQUENTLY ASKED QUESTIONS (FAQ) ─────────────── *@
<section class="ph-section ph-section-plain">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">FAQ</span>
            <h2 class="pika-h2 fw-bold">@(tr ? "Sıkça Sorulan Sorular" : "Frequently Asked Questions")</h2>
        </div>

        <div class="row justify-content-center" data-aos="fade-up" data-aos-delay="100">
            <div class="col-lg-8">
                <div class="accordion" id="cmFaqAccordion">
                    <div class="accordion-item border rounded-3 mb-3">
                        <h2 class="accordion-header" id="cmHeadOne">
                            <button class="accordion-button fw-bold text-dark collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cmCollapseOne" aria-expanded="false" aria-controls="cmCollapseOne">
                                @(tr ? "Campaign Manager ile Journey Manager arasındaki fark nedir?" : "What is the difference between Campaign Manager and Journey Manager?")
                            </button>
                        </h2>
                        <div id="cmCollapseOne" class="accordion-collapse collapse" aria-labelledby="cmHeadOne" data-bs-parent="#cmFaqAccordion">
                            <div class="accordion-body small text-secondary">
                                @(tr ? "Campaign Manager belirli bir hedef kitleye, belirli bir zamanda veya tetikleyiciyle yapılan tek seferlik ya da planlı kampanya gönderimleridir. Journey Manager ise müşterinin davranışına göre 7/24 kesintisiz çalışan, gecikmeler ve dallanmalar içeren otomatik yaşam döngüsü akışlarıdır." : "Campaign Manager executes defined, scheduled, or trigger-based multi-channel batch/blast campaigns. Journey Manager runs continuous 24/7 event-driven lifecycle workflows with wait delays and conditional branching.")
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border rounded-3 mb-3">
                        <h2 class="accordion-header" id="cmHeadTwo">
                            <button class="accordion-button fw-bold text-dark collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cmCollapseTwo" aria-expanded="false" aria-controls="cmCollapseTwo">
                                @(tr ? "Hangi iletişim kanalları Campaign Manager üzerinden yönetilebilir?" : "Which communication channels can be managed in Campaign Manager?")
                            </button>
                        </h2>
                        <div id="cmCollapseTwo" class="accordion-collapse collapse" aria-labelledby="cmHeadTwo" data-bs-parent="#cmFaqAccordion">
                            <div class="accordion-body small text-secondary">
                                @(tr ? "WhatsApp Business API, SMS, E-posta ve Mobil Push bildirimleri tek bir kampanya akışından ayrı ayrı veya birlikte yönetilebilir." : "WhatsApp Business API, SMS, Email, and Mobile Push notifications can be managed individually or coordinated within one unified flow.")
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border rounded-3 mb-3">
                        <h2 class="accordion-header" id="cmHeadThree">
                            <button class="accordion-button fw-bold text-dark collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cmCollapseThree" aria-expanded="false" aria-controls="cmCollapseThree">
                                @(tr ? "İYS ve KVKK izin kontrolü nasıl sağlanır?" : "How is consent verified before dispatching?")
                            </button>
                        </h2>
                        <div id="cmCollapseThree" class="accordion-collapse collapse" aria-labelledby="cmHeadThree" data-bs-parent="#cmFaqAccordion">
                            <div class="accordion-body small text-secondary">
                                @(tr ? "Pika, kampanya gönderim anında her alıcının İYS ve ticari izin durumunu otomatik doğrular; izni olmayan alıcıları listeden sessizce çıkararak işletmeyi ceza riskinden korur." : "Pika checks recipient opt-in and IYS compliance in real time before dispatch, automatically filtering out non-consenting contacts.")
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item border rounded-3 mb-3">
                        <h2 class="accordion-header" id="cmHeadFour">
                            <button class="accordion-button fw-bold text-dark collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#cmCollapseFour" aria-expanded="false" aria-controls="cmCollapseFour">
                                @(tr ? "Kampanya cirosu ve gelir atfı (attribution) nasıl ölçülür?" : "How is campaign revenue and attribution measured?")
                            </button>

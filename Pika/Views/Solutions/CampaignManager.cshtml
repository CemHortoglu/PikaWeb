@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-platform-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-campaign-manager-page.css" asp-append-version="true" />
}

@* ── 01 HERO ─────────────────────────────────────────────────── *@
<section class="inner-hero inner-hero--campaign">
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span>/</span>
                <span>Campaign Manager</span>
            </nav>
            <div class="inner-eyebrow"><span></span>CAMPAIGN MANAGER</div>
            @if (tr)
            {
                <h1>
                    Kampanyayı tek yerde hazırlayın.<br />
                    Gönderimi kontrol altında tutun.
                </h1>
                <p>
                    Pika Campaign Manager; hedef kitleyi, iletişim içeriğini, Email, SMS veya WhatsApp kanalını, zamanlamayı ve gönderim öncesi kontrolleri tek kampanya bağlamında bir araya getirir.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.72);font-size:15px;margin-bottom:30px">
                    Amaç yalnızca mesajı göndermek değil; kime, hangi içerikle, hangi kanaldan ve hangi kontrol adımlarından sonra ulaşılacağını aynı kampanya sürecinde yönetmektir.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Demo Talep Et ↗
                    </button>
                    <a class="inner-secondary" href="/cozumler/audience-manager">
                        Audience Manager'ı Keşfedin →
                    </a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="İçeriğe atla">
                        <i class="ri-arrow-down-line" aria-hidden="true"></i>
                    </a>
                </div>
            }
            else
            {
                <h1>
                    Prepare the campaign in one place.<br />
                    Keep delivery under control.
                </h1>
                <p>
                    Pika Campaign Manager brings the audience, communication content, Email, SMS or WhatsApp channel, timing and pre-send controls together within one campaign context.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.72);font-size:15px;margin-bottom:30px">
                    The objective is not simply to send a message. It is to manage who should receive it, which content should be used, which channel should carry it and which control steps should happen before delivery.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Request a Demo ↗
                    </button>
                    <a class="inner-secondary" href="/en/solutions/audience-manager">
                        Explore Audience Manager →
                    </a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="Skip to content">
                        <i class="ri-arrow-down-line" aria-hidden="true"></i>
                    </a>
                </div>
            }
        </div>
        <div class="inner-scene" aria-label="@(tr ? "Platformun çalışma biçimini anlatan örnek görünüm" : "Illustrative view of how the platform works")">
            <div class="inner-scene-orbit" aria-hidden="true"></div>
            <div class="inner-scene-window">
                <div class="inner-window-bar">
                    <strong>pika<span>✳</span></strong>
                    <span>Campaign Manager</span>
                    <small>@(tr ? "Örnek görünüm" : "Illustration")</small>
                </div>
                <div class="inner-flow" style="padding:22px 18px">
                    <div>
                        <i class="ri-group-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "HEDEF KİTLE" : "AUDIENCE")</strong>
                        </span>
                        <b>01</b>
                    </div>
                    <span class="inner-flow-link" style="height:14px"></span>
                    <div>
                        <i class="ri-megaphone-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "KAMPANYA" : "CAMPAIGN")</strong>
                        </span>
                        <b>02</b>
                    </div>
                    <span class="inner-flow-link" style="height:14px"></span>
                    <div>
                        <i class="ri-shield-check-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "KONTROL" : "CONTROL")</strong>
                        </span>
                        <b>03</b>
                    </div>
                    <span class="inner-flow-link" style="height:14px"></span>
                    <div class="inner-flow-final">
                        <i class="ri-send-plane-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "GÖNDERİM" : "DELIVERY")</strong>
                        </span>
                        <b>04</b>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div id="inner-content" class="inner-anchor"></div>

@* ── 02 DIRECT ANSWER ────────────────────────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        <div class="p-4 rounded-4 mb-4 bg-white border" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
            <h2 class="pika-h2 fw-bold mb-3">@(tr ? "Campaign Manager nedir?" : "What is Campaign Manager?")</h2>
            <p class="mb-3" style="font-size:1.05rem;line-height:1.65;color:#23413b">
                @(tr ? "Campaign Manager, Pika'da belirlenmiş bir hedef kitle için kampanya içeriğini, iletişim kanalını, zamanlamayı ve kontrollü gönderim sürecini bir araya getiren kampanya orkestrasyon katmanıdır." : "Campaign Manager is Pika's campaign-orchestration layer that brings campaign content, communication channel, timing and controlled delivery together for a defined audience.")
            </p>
            <p class="ph-muted mb-3" style="font-size:0.95rem;line-height:1.6">
                @if (tr)
                {
                    <text>Audience Manager “KİM?” sorusunu cevaplar.<br />Content Studio iletişim içeriğinin hazırlanmasını destekler.<br />Campaign Manager ise bu parçaları kampanya düzeyinde bir araya getirerek şu soruya odaklanır:</text>
                }
                else
                {
                    <text>Audience Manager answers “WHO?”<br />Content Studio supports preparation of communication content.<br />Campaign Manager brings those pieces together at campaign level and focuses on:</text>
                }
            </p>
            <div class="p-4 rounded-3 text-center my-4" style="background:#f8faf4;border:1px dashed #c9dca9">
                <span class="d-block small text-uppercase fw-bold mb-1" style="letter-spacing:1px;color:#7c984c">
                    @(tr ? "TEMEL ODAK SORUSU" : "CENTRAL FOCUS QUESTION")
                </span>
                <div class="fw-bold" style="font-size:1.35rem;color:#23413b">
                    @(tr ? "“Bu hedef kitle için hangi kampanya nasıl kontrollü biçimde gönderilmeli?”" : "“For this audience, which campaign should be executed, and how should delivery be controlled?”")
                </div>
            </div>
            <p class="ph-muted mb-2" style="font-size:0.95rem;line-height:1.6">
                @(tr ? "Campaign Manager müşteri zekâsını hesaplayan katman değildir, hedef kitleyi tanımlayan Audience Manager değildir ve çok adımlı müşteri yolculuğunu yöneten Journey Manager değildir." : "Campaign Manager is not the layer that calculates customer intelligence, it is not Audience Manager, and it is not Journey Manager for multi-step customer flows.")
            </p>
            <p class="ph-muted mb-0" style="font-size:0.95rem;line-height:1.6">
                @(tr ? "Campaign Manager'ın ürün rolü, karar verilmiş bir kampanyayı kontrollü gönderim sürecine dönüştürmektir." : "The product role of Campaign Manager is to turn an approved campaign decision into a controlled delivery process.")
            </p>
        </div>
    </div>
</section>

@* ── 03 WHY CAMPAIGN OPERATIONS BECOME FRAGMENTED ─────────────── *@
<section class="ph-section ph-section-plain">
    <div class="container">
        <div class="row align-items-center g-5 ph-split-row">
            <div class="col-lg-6" data-aos="fade-right">
                <span class="ph-eyebrow">@(tr ? "DAĞINIKLIKTAN KONTROLE" : "FROM FRAGMENTATION TO CONTROL")</span>
                <h2 class="pika-h2 fw-bold mb-3">
                    @(tr ? "Kampanya yalnızca “mesajı gönder” adımı değildir." : "A campaign is more than the “send message” step.")
                </h2>
                <p class="ph-muted mb-3" style="font-size:1.02rem;line-height:1.65">
                    @(tr ? "Bir kampanyanın arkasında hedef kitle, içerik, kanal, zamanlama, izin bağlamı ve gönderim kontrolü gibi birden fazla karar bulunur." : "Behind a campaign are multiple decisions: audience, content, channel, timing, permission context and delivery control.")
                </p>
                <p class="ph-muted mb-3" style="font-size:1.02rem;line-height:1.65">
                    @(tr ? "Bu kararlar birbirinden kopuk araçlarda yönetildiğinde kampanya operasyonu liste taşıma, içerik eşleştirme ve kanal bazında ayrı süreçleri takip etme işine dönüşebilir." : "When those decisions are managed across disconnected tools, campaign operations can turn into moving lists, matching content manually and following separate channel processes.")
                </p>
                <p class="ph-muted mb-0" style="font-size:1.02rem;line-height:1.65">
                    @(tr ? "Üstelik aynı müşteriye farklı kampanyaların aynı anda veya uygunsuz koşullarda ulaşması, kampanya kararlarının birbirinden bağımsız yürütülmesi halinde yönetilmesi gereken ayrı bir operasyonel risk oluşturur." : "Different campaigns reaching the same customer at the same time or under inappropriate conditions also becomes an operational risk that must be managed when campaign decisions are handled independently.")
                </p>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <div class="p-4 rounded-4 bg-white border">
                    <div class="p-3 rounded-3 mb-3 text-center" style="background:#f8faf4;border:1px dashed #c9dca9">
                        <small class="text-uppercase fw-bold d-block mb-1" style="font-size:11px;letter-spacing:1px;color:#7c984c">
                            @(tr ? "Campaign Manager'ın amacı:" : "The purpose of Campaign Manager is not:")
                        </small>
                        <div class="fw-bold mb-2" style="font-size:1.05rem;color:#23413b">
                            @(tr ? "Daha fazla mesaj göndermek değil," : "To send more messages.")
                        </div>
                        <small class="text-uppercase fw-bold d-block mb-1" style="font-size:11px;letter-spacing:1px;color:#7c984c">
                            @(tr ? "Amacı:" : "It is:")
                        </small>
                        <div class="fw-bold" style="font-size:1.05rem;color:var(--pika-primary)">
                            @(tr ? "kampanyanın parçalarını aynı kontrollü süreç içinde bir araya getirmektir." : "To bring campaign components into the same controlled process.")
                        </div>
                    </div>
                    <p class="small ph-muted mb-0 text-center">
                        @(tr ? "Böylece hedef kitle seçiminden gönderim planına kadar kampanya tek bir operasyonel bağlam içinde yönetilebilir." : "This allows campaign operations from audience selection through delivery planning to be managed within one campaign context.")
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 04 WHAT DEFINES A CAMPAIGN & CONCEPTUAL FLOW ─────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "KAMPANYA BAĞLAMI" : "CAMPAIGN CONTEXT")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Bir kampanyayı, gönderim düğmesinden önce tanımlayın." : "Define the campaign before the send button.")
            </h2>
            <p class="ph-muted mx-auto" style="max-width:680px">
                @(tr ? "Campaign Manager bir kampanyanın yürütülebilmesi için gerekli temel karar parçalarını aynı bağlamda toplar." : "Campaign Manager brings the core decision components required to execute a campaign into the same context.")
            </p>
        </div>

        @* Conceptual Campaign Flow (replaces legacy visual cockpit) *@
        <div class="ph-cockpit p-4 shadow-sm bg-white rounded-4 border mb-5" aria-hidden="true" data-aos="fade-up">
            <div class="camp-cockpit-flow">
                <div class="camp-cockpit-step">
                    <i class="ri-group-line"></i>
                    <span>@(tr ? "HEDEF KİTLE" : "AUDIENCE")</span>
                </div>
                <div class="camp-cockpit-step">
                    <i class="ri-file-text-line"></i>
                    <span>@(tr ? "İÇERİK" : "CONTENT")</span>
                </div>
                <div class="camp-cockpit-step">
                    <i class="ri-chat-3-line"></i>
                    <span>@(tr ? "KANAL" : "CHANNEL")</span>
                </div>
                <div class="camp-cockpit-step">
                    <i class="ri-time-line"></i>
                    <span>@(tr ? "ZAMANLAMA" : "TIMING")</span>
                </div>
                <div class="camp-cockpit-step">
                    <i class="ri-shield-check-line"></i>
                    <span>@(tr ? "KONTROL" : "CONTROL")</span>
                </div>
                <div class="camp-cockpit-step">
                    <i class="ri-send-plane-line"></i>
                    <span>@(tr ? "GÖNDERİM" : "DELIVERY")</span>
                </div>
            </div>
        </div>

        <div class="row g-4" data-aos="fade-up" data-aos-delay="100">
            <div class="col-lg-4 col-md-6">
                <div class="ph-trust-card h-100 p-4 d-flex flex-column">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-group-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Hedef Kitle" : "Audience")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Audience Manager'da tanımlanan veya kampanya için belirlenen müşteri grubu, kampanyanın “KİM?” bağlamını oluşturur." : "The customer group defined in Audience Manager or selected for the campaign provides the “WHO?” context.")
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="ph-trust-card h-100 p-4 d-flex flex-column">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-file-text-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "İçerik" : "Content")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Kampanyada kullanılacak iletişim içeriği ve uygun şablon, müşteriye ne söyleneceğini belirler." : "Communication content and the relevant template define what will be communicated to the customer.")
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="ph-trust-card h-100 p-4 d-flex flex-column">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-chat-3-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Kanal" : "Channel")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Email, SMS veya WhatsApp arasından kampanya için kullanılacak doğrulanmış iletişim kanalı seçilir." : "A confirmed communication channel is selected from Email, SMS or WhatsApp for the campaign.")
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="ph-trust-card h-100 p-4 d-flex flex-column">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-time-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Zamanlama" : "Timing")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Kampanyanın ne zaman gönderim sürecine alınacağı kampanya planının bir parçasıdır." : "When the campaign should enter the delivery process is part of the campaign plan.")
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="ph-trust-card h-100 p-4 d-flex flex-column">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-shield-check-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Gönderim Öncesi Kontroller" : "Pre-Send Controls")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "İzin, erişilebilirlik ve ilgili gönderim güvenliği kontrolleri kampanyanın icrasından önce değerlendirilir." : "Permission, reachability and relevant delivery-safety controls are evaluated before campaign execution.")
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="ph-trust-card h-100 p-4 d-flex flex-column">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-line-chart-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Ölçüm" : "Measurement")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Gönderim ve etkileşim sonuçları ile kampanyayla ilişkilendirilebilen ticari sonuçlar daha sonra ölçüm katmanında değerlendirilebilir." : "Delivery and engagement results, together with commercial outcomes that can be associated with the campaign, can later be evaluated in the measurement layer.")
                    </p>
                </div>
            </div>
        </div>

        <div class="p-3 rounded text-center mx-auto mt-4" style="background:#ffffff;border:1px dashed #dce5d3;max-width:760px">
            <strong style="color:#23413b">
                @(tr ? "Campaign Manager'ın görevi bu parçaları bağımsız görevler olarak bırakmak değil, tek kampanya bağlamında yönetmektir." : "Campaign Manager does not leave these as disconnected operational tasks. It manages them within one campaign context.")
            </strong>
        </div>
    </div>
</section>

@* ── 05 AUDIENCE MANAGER → CAMPAIGN MANAGER ──────────────────── *@
<section class="ph-section ph-section-plain">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "“KİM?”DEN KAMPANYAYA" : "FROM “WHO?” TO CAMPAIGN")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Audience Manager kitleyi tanımlar. Campaign Manager kampanyayı yürütür." : "Audience Manager defines the audience. Campaign Manager executes the campaign.")
            </h2>
        </div>

        <div class="p-4 rounded-4 bg-white border mb-4" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Audience Manager ile Campaign Manager aynı ürün rolünü taşımaz. Audience Manager, müşteri özellikleri ve davranış bağlamından hangi müşterilerin belirli bir karar için hedef kitleye dahil olduğunu kurallarla tanımlar." : "Audience Manager and Campaign Manager do not perform the same product role. Audience Manager defines through customer attributes and behavioral context which customers belong in the audience for a particular decision.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Campaign Manager ise seçilmiş hedef kitleyi kampanya içeriği, kanal, zamanlama ve gönderim kontrolleriyle bir araya getirir." : "Campaign Manager brings the selected audience together with campaign content, channel, timing and delivery controls.")
            </p>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 rounded-3 h-100" style="background:#f8faf4;border:1px solid #dce5d2">
                        <small class="text-uppercase fw-bold d-block mb-1" style="font-size:11px;letter-spacing:1px;color:#7c984c">
                            @(tr ? "AUDIENCE MANAGER SORUSU" : "AUDIENCE QUESTION")
                        </small>
                        <div class="fw-bold mb-1" style="color:#23413b">Audience Manager:</div>
                        <div class="small ph-muted">
                            @(tr ? "“Bu karar için hangi müşteriler hedef kitleye dahil olmalı?”" : "“Which customers should belong in this audience?”")
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-3 h-100" style="background:#f8faf4;border:1px solid #dce5d2">
                        <small class="text-uppercase fw-bold d-block mb-1" style="font-size:11px;letter-spacing:1px;color:#7c984c">
                            @(tr ? "CAMPAIGN MANAGER SORUSU" : "CAMPAIGN QUESTION")
                        </small>
                        <div class="fw-bold mb-1" style="color:#23413b">Campaign Manager:</div>
                        <div class="small ph-muted">
                            @(tr ? "“Bu hedef kitle için hangi kampanya ve kontrollü gönderim uygulanmalı?”" : "“Which campaign and controlled delivery should be executed for this audience?”")
                        </div>
                    </div>
                </div>
            </div>

            <p class="small ph-muted mb-3">
                @(tr ? "Hedef kitle tanımı kampanyanın kendisi değildir. Campaign Manager, “KİM?” kararını kampanya operasyonuna bağlayan sonraki katmandır." : "An audience definition is not the campaign itself. Campaign Manager is the next layer that connects the “WHO?” decision to campaign operations.")
            </p>

            <div class="text-end">
                <a href="@(tr ? "/cozumler/audience-manager" : "/en/solutions/audience-manager")" class="small fw-bold" style="color:var(--pika-primary)">
                    @(tr ? "Audience Manager'ı Keşfedin →" : "Explore Audience Manager →")
                </a>
            </div>
        </div>
    </div>
</section>

@* ── 06 CONTENT STUDIO → CAMPAIGN MANAGER ────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "İÇERİKTEN GÖNDERİME" : "FROM CONTENT TO DELIVERY")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "İçeriği hazırlamak ve kampanyayı yürütmek aynı görev değildir." : "Preparing content and executing the campaign are different jobs.")
            </h2>
        </div>

        <div class="p-4 rounded-4 bg-white border mb-4" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Content Studio, kampanyada kullanılacak iletişim içeriğinin ve şablonların hazırlanmasını destekler." : "Content Studio supports preparation of communication content and templates used in campaigns.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Campaign Manager ise seçilmiş içeriği hedef kitle, kanal ve kampanya zamanlamasıyla aynı operasyonel bağlamda kullanır." : "Campaign Manager uses selected content together with audience, channel and campaign timing within the same operational context.")
            </p>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 rounded-3 h-100" style="background:#f8faf4;border:1px solid #dce5d2">
                        <small class="text-uppercase fw-bold d-block mb-1" style="font-size:11px;letter-spacing:1px;color:#7c984c">
                            @(tr ? "CONTENT STUDIO SORUSU" : "CONTENT QUESTION")
                        </small>
                        <div class="fw-bold mb-1" style="color:#23413b">Content Studio:</div>
                        <div class="small ph-muted">

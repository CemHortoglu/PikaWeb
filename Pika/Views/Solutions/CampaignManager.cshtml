@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]="Campaign Manager | "+(tr?"Kampanya Yönetimi":"Campaign Management"); ViewData["MetaDescription"]=tr?"Hedef kitle, içerik, kanal ve zamanlamayı kontrollü bir kampanya akışında birleştirin; desteklenen sonuçları Analytics ile değerlendirin.":"Bring audience, content, channel and timing into a controlled campaign workflow and review supported outcomes through Analytics."; ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">Platform · Campaign Manager</span><h1>@(tr?"Tanımlı bir kampanyayı kontrollü biçimde yayına alın.":"Execute a defined campaign with control.")</h1><p>@(tr?"Campaign Manager; hedef kitle, içerik, iletişim kanalı ve zamanlama kararlarını tek kampanya operasyonunda birleştirir. Pika'nın tamamı değil, intelligence ve fırsat katmanlarından sonra gelen aksiyon motorlarından biridir.":"Campaign Manager combines audience, content, communication channel and timing in one campaign operation. It is an execution engine in Pika, not the entirety of the platform.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/kampanya-yonetimi">@(tr?"Kampanya Rehberi":"Campaign Guide")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_yayinlama-sablon-ve-yonetim_27.png" alt="@(tr?"Pika yayınlama ve kampanya operasyon ekranı":"Pika publishing and campaign operations screen")" width="1200" height="760" /><figcaption>@(tr?"Taslak, kontrol, yayınlama ve tekrar kullanım operasyonunu görünür tutun.":"Keep draft, review, publishing and reuse operations visible.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-flow"><div class="pk-flow-item"><small>01</small><strong>Audience</strong><span>@(tr?"Kime?":"Who?")</span></div><div class="pk-flow-item"><small>02</small><strong>Content</strong><span>@(tr?"Ne söyleyeceğiz?":"What will we say?")</span></div><div class="pk-flow-item"><small>03</small><strong>Channel</strong><span>@(tr?"Hangi uygun kanal?":"Which eligible channel?")</span></div><div class="pk-flow-item"><small>04</small><strong>Schedule</strong><span>@(tr?"Ne zaman?":"When?")</span></div><div class="pk-flow-item"><small>05</small><strong>Control</strong><span>@(tr?"İzin ve yayın kontrolü":"Consent and publish controls")</span></div><div class="pk-flow-item"><small>06</small><strong>Measure</strong><span>Analytics</span></div></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">Campaign vs Journey</span><h2>@(tr?"Kampanya ile müşteri akışı aynı şey değildir.":"A campaign and a customer flow are not the same thing.")</h2></div><div><p class="pk-lead">@(tr?"Campaign Manager belirli bir hedef kitle, içerik, kanal ve zamanlama ile tanımlı bir kampanya yürütmek için uygundur. Journey Manager ise tetikleyici, karar, bekleme ve aksiyon adımlarıyla müşterinin zaman içindeki akışını yönetir.":"Campaign Manager is suited to defined campaign execution with audience, content, channel and timing. Journey Manager manages customer progression over time with triggers, decisions, waits and actions.")</p><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/journey-manager":"/en/platform/journey-manager")">Journey Manager</a></div></div></section>
<section class="pk-section"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">Opportunity → Campaign</span><h2>@(tr?"Kampanyayı boş sayfadan değil, fırsat bağlamından başlatın.":"Start campaigns from opportunity context, not a blank page.")</h2></div><div><p class="pk-lead">@(tr?"Günün Fırsatları'nda anlamlı bir durum görüldüğünde kullanıcı bu bağlamdan hedef kitle ve kampanya hazırlığına geçebilir. Pika AI içerik veya yaklaşım taslağına yardımcı olabilir; yayınlama kararı kullanıcıdadır.":"When a meaningful situation appears in Daily Opportunities, the user can move from that context into audience and campaign preparation. Pika AI may assist with drafts while publishing remains under user control.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/gunun-firsatlari":"/en/platform/opportunities")">@(tr?"Günün Fırsatları":"Daily Opportunities")</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/ai-kampanya-asistani":"/en/platform/ai-campaign-assistant")">Pika AI</a></div></div></div></section>

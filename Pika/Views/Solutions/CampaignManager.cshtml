            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Hedef kitleye dahil olmak, gönderime uygun olmakla aynı şey değildir." : "Being in the audience is not the same as being eligible for delivery.")
            </h2>
        </div>

        <div class="p-4 rounded-4 bg-white border" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Bir müşterinin kampanya hedef kitlesine dahil olması, o müşteriye seçilen kanaldan ticari iletişim gönderilebileceği anlamına tek başına gelmez." : "A customer belonging in a campaign audience does not by itself mean that commercial communication can be sent through the selected channel.")
            </p>
            <p class="mb-3 ph-muted" style="line-height:1.65">
                @(tr ? "Pika'nın kontrollü gönderim sürecinde mevcut izin, opt-out, kanal erişilebilirliği ve ilgili gönderim uygunluğu kontrolleri gönderim öncesi değerlendirilir." : "Within Pika's controlled delivery process, available consent, opt-out, channel reachability and relevant delivery-eligibility controls are evaluated before execution.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "İYS ve diğer izin bağlamı, gerekli durumlarda bu gönderim güvenliği zincirinin bir parçasıdır." : "IYS and other permission context form part of this delivery-safety chain where applicable.")
            </p>

            <div class="p-3 rounded-3 mb-4 text-center" style="background:#f8faf4;border:1px dashed #c9dca9">
                <div class="row g-2 text-start">
                    <div class="col-sm-6 p-2 border-bottom border-sm-0">
                        <strong style="color:var(--pika-primary)">Campaign Manager:</strong>
                        <p class="small mb-0 mt-1" style="color:#23413b">
                            @(tr ? "kampanyayı ve kontrollü gönderim planını yönetir." : "manages the campaign and controlled delivery plan.")
                        </p>
                    </div>
                    <div class="col-sm-6 p-2">
                        <strong style="color:var(--pika-primary)">@(tr ? "Consent Management ve gönderim kontrolleri:" : "Consent Management and delivery controls:")</strong>
                        <p class="small mb-0 mt-1" style="color:#23413b">
                            @(tr ? "iletişimin uygulanabilirliğini ayrı kontrol bağlamında değerlendirir." : "evaluate whether communication can be executed within the relevant control context.")
                        </p>
                    </div>
                </div>
            </div>

            <p class="small ph-muted mb-3">
                @(tr ? "Bu yaklaşımın amacı hukuki sonuç garantisi vermek değil, kampanya icrasına izin ve gönderim kontrollerini dahil etmektir." : "The objective is not to guarantee a legal outcome. It is to include permission and delivery controls in campaign execution.")
            </p>

            <div class="text-end">
                <a href="@(tr ? "/cozumler/consent-management" : "/en/solutions/consent-management")" class="small fw-bold" style="color:var(--pika-primary)">
                    @(tr ? "Consent Management'i Keşfedin →" : "Explore Consent Management →")
                </a>
            </div>
        </div>
    </div>
</section>

@* ── 09 SCHEDULING & PACING ──────────────────────────────────── *@

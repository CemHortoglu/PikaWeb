@* ── CHAPTER 6: CONCRETE USE CASES ───────────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "Kullanım Senaryoları" : "Use Cases")</span>
            <h2 class="pika-h2 fw-bold">@(tr ? "Sık Kullanılan Kampanya Türleri" : "Popular Campaign Types")</h2>

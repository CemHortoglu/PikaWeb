@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr = culture == "tr";
    ViewData["Title"] = tr ? "Güvenlik ve Gizlilik | Pika" : "Security & Privacy | Pika";
    ViewData["MetaDescription"] = tr ? "Pika'nın doğrulanmış erişim, yetkilendirme, izin, opt-out, İYS, entegrasyon ve operasyon güvenliği yaklaşımını; Pika ile müşteri sorumluluk sınırlarını inceleyin." : "Review Pika's verified approach to access, authorization, consent, opt-out, IYS, integrations and operational safeguards, including responsibility boundaries.";
    ViewData["BodyClass"] = "pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">@(tr ? "Güvenlik ve Gizlilik" : "Security & Privacy")</span><h1>@(tr ? "Güven, iddiadan değil görünür kontrolden gelir." : "Trust comes from visible controls, not broad claims.")</h1><p>@(tr ? "Pika; erişim, kullanıcı yetkileri, iletişim izni, opt-out ve operasyonel uygunluk gibi kontrolleri ürün akışının parçası olarak ele alır. Bu sayfa yalnızca doğrulanmış ürün davranışını açıklar; sertifika veya mutlak hukuki uyum iddiası üretmez." : "Pika treats access, user authorization, communication consent, opt-out and operational eligibility as part of product workflows. This page describes verified product behavior and does not invent certifications or absolute legal-compliance claims.")</p><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="/wiki/izin-optout-iys">@(tr ? "İzin ve İYS Dokümantasyonu" : "Consent & IYS Documentation")</a><a class="pk-btn pk-btn-ghost" href="@(tr ? "/iletisim" : "/en/contact")">@(tr ? "Sorunuzu İletin" : "Contact Us")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_kullanici-roller-yetkiler_24.png" alt="@(tr ? "Pika kullanıcı, rol ve yetki ekranı" : "Pika users, roles and permissions screen")" width="1200" height="760" /><figcaption>@(tr ? "Ürün ekranlarında kullanıcı ve yetki ayrımı operasyonun bir parçası olarak ele alınır." : "User and permission separation is treated as part of product operations.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-chapter"><div><span class="pk-eyebrow">@(tr ? "Güven yaklaşımı" : "Trust approach")</span><h2>@(tr ? "Yetki, izin ve veri bağlamını birbirinden ayırın." : "Keep authorization, consent and data context distinct.")</h2></div><p class="pk-lead">@(tr ? "Bir kullanıcının ekrana erişebilmesi, bir müşteriye ileti gönderebilmesi ve bir verinin işlenmesinin hukuki dayanağı aynı kavram değildir. Pika bu ayrımları ürün kontrolleri içinde görünür tutmayı hedefler." : "A user's ability to access a screen, eligibility to message a customer and the legal basis for processing data are different concepts. Pika keeps these distinctions visible in product controls.")</p></div><div class="pk-trust-grid"><div class="pk-trust"><h3>@(tr ? "Kimlik doğrulama" : "Authentication")</h3><p>@(tr ? "Web uygulaması, oturum açmış kullanıcı kimliğini mevcut kimlik doğrulama altyapısıyla taşır. Korunan alanlar anonim isteklere açık olmamalıdır." : "The web application carries authenticated user identity through the existing authentication infrastructure. Protected areas are not intended for anonymous access.")</p></div><div class="pk-trust"><h3>@(tr ? "Rol ve yetki" : "Roles & authorization")</h3><p>@(tr ? "Farklı ekiplerin aynı ekran ve aksiyonlara erişmesi gerekmez. Pika kullanıcı/rol bağlamını operasyonel görünürlük ve işlem yetkisi için kullanabilir." : "Different teams do not need identical access. Pika can use user/role context for operational visibility and action permissions.")</p></div><div class="pk-trust"><h3>@(tr ? "İzin ve opt-out" : "Consent & opt-out")</h3><p>@(tr ? "Kişi kaydı ile ticari ileti izni aynı şey değildir. Kanal izni, opt-out ve ulaşılabilirlik gönderim kararından önce ayrıca değerlendirilir." : "A contact record is not the same as marketing consent. Channel consent, opt-out and reachability are evaluated separately before delivery.")</p></div><div class="pk-trust"><h3>@(tr ? "İYS bağlamı" : "IYS context")</h3><p>@(tr ? "Pika'da İYS entegrasyonuna yönelik istemci servis ve yönetim ekranı bulunur. İYS verisi, izin durumunun operasyonel karar zincirine taşınmasına yardımcı olur; hukuki sorumluluğu otomatik olarak Pika'ya devretmez." : "Pika includes client/service and management support for IYS integration. IYS data can inform operational consent decisions; it does not automatically transfer legal responsibility to Pika.")</p></div></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">@(tr ? "Gönderim güvenliği" : "Delivery safeguards")</span><h2>@(tr ? "Fırsat güçlü olsa bile uygun olmayan kanaldan gönderim yapılmamalı." : "A strong opportunity does not justify using an ineligible channel.")</h2></div><div><p class="pk-lead">@(tr ? "Gönderim öncesinde hedef kişi, kanal adresi, izin/opt-out ve ilgili operasyon kuralları ayrı kontrollerdir. Uygun kanal bulunmuyorsa güvenli davranış aksiyon üretmemek olabilir." : "Target identity, channel address, consent/opt-out and relevant operational rules are separate pre-delivery checks. If no channel is eligible, safe behavior may be to take no delivery action.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="/wiki/izin-kanal-zamanlama">@(tr ? "İzin, Kanal ve Zamanlama" : "Consent, Channel & Timing")</a><a class="pk-btn pk-btn-ghost" href="/wiki/izin-optout-iys">@(tr ? "Opt-out ve İYS" : "Opt-out & IYS")</a></div></div></div></section>
<section class="pk-section"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">@(tr ? "Veri ve entegrasyon" : "Data & integrations")</span><h2>@(tr ? "Veri kalitesini güvenlik iddiasına karıştırmayın; ikisini de görünür yönetin." : "Keep data quality and security distinct, and make both visible.")</h2></div><div><p class="pk-lead">@(tr ? "Excel/CSV veya API ile alınan veriler eşleştirme ve doğrulama adımlarından geçirilir. Eksik müşteri, ürün veya kanal bağlamı analitik çıktının kapsamını etkileyebilir; bu durum sessizce kesin sonuç gibi sunulmamalıdır." : "Data received through Excel/CSV or API passes through mapping and validation. Missing customer, product or channel context can affect analytical coverage and should not be silently presented as certainty.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr ? "/platform/integrations" : "/en/platform/integrations")">@(tr ? "Entegrasyonlar" : "Integrations")</a><a class="pk-btn pk-btn-ghost" href="/wiki/veri-entegrasyon-genel">@(tr ? "Veri ve Entegrasyon Rehberi" : "Data & Integration Guide")</a></div></div></div></section>
<section class="pk-section pk-section-deep"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow" style="color:#d1ea88">@(tr ? "Sorumluluk sınırı" : "Responsibility boundary")</span><h2>@(tr ? "Pika kontrol sağlar; hukuki danışmanlık vermez." : "Pika provides controls; it does not replace legal advice.")</h2></div><div><p class="pk-lead">@(tr ? "İşletmenin kişisel veriyi hangi hukuki dayanakla işlediği, gerekli aydınlatma süreçleri, ileti türü, veri kaynağı ve yürürlükteki mevzuata ilişkin sorumlulukları kendi süreçleri kapsamında değerlendirilmelidir. Pika'nın izin ve gönderim kontrolleri bu sorumluluğu ortadan kaldırmaz." : "The customer remains responsible for evaluating legal basis, notices, communication type, data source and applicable regulation within its own processes. Pika's consent and delivery controls do not remove that responsibility.")</p><p class="pk-lead">@(tr ? "Bu nedenle bu sitede ISO, SOC, penetrasyon testi, veri lokasyonu veya şifreleme sertifikasyonu gibi doğrulanmamış iddialar kullanılmaz." : "For that reason this site does not claim unverified ISO, SOC, penetration-test, hosting-location or encryption certifications.")</p></div></div></section>

@* ── 07 TENANT / AUTHORIZATION CONTEXT BOUNDARY ──────────────── *@
<section class="sec-section sec-section-alt">
    <div class="container">
        <div class="sec-section-header max-w-800">
            <span class="sec-badge-sub">@(tr ? "ERİŞİM BAĞLAMI" : "ACCESS CONTEXT")</span>

@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]=tr?"Güvenlik ve Gizlilik | Pika":"Security & Privacy | Pika";
    ViewData["MetaDescription"]=tr?"Pika'nın doğrulanmış kimlik doğrulama, rol/yetki, izin, opt-out, İYS, entegrasyon ve operasyon güvenliği yaklaşımını; Pika ile müşteri sorumluluk sınırlarını inceleyin.":"Review Pika's verified authentication, role/authorization, consent, opt-out, IYS, integration and operational safeguards, including responsibility boundaries.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">@(tr?"Güvenlik ve Gizlilik":"Security & Privacy")</span><h1>@(tr?"Güven, geniş iddialardan değil görünür kontrollerden gelir.":"Trust comes from visible controls, not broad claims.")</h1><p>@(tr?"Pika; erişim, kullanıcı yetkileri, iletişim izni, opt-out, kanal uygunluğu ve operasyonel kontrolleri ürün akışının ayrı parçaları olarak ele alır. Bu sayfa yalnızca doğrulanmış ürün davranışını açıklar; ISO, SOC, penetrasyon testi, hosting lokasyonu veya mutlak hukuki uyum gibi doğrulanmamış iddialar üretmez.":"Pika treats access, user authorization, communication consent, opt-out, channel eligibility and operational controls as distinct parts of product workflows. This page describes verified behavior and does not invent ISO, SOC, penetration-test, hosting-location or absolute legal-compliance claims.")</p><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="/wiki/izin-optout-iys">@(tr?"İzin ve İYS Dokümantasyonu":"Consent & IYS Documentation")</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/iletisim":"/en/contact")">@(tr?"Güvenlik Sorunuzu İletin":"Contact Us")</a></div><div class="pk-hero-note"><i class="ri-scales-3-line"></i><span>@(tr?"Pika ürün kontrolleri sunar; müşterinin hukuki değerlendirme ve süreç sorumluluğunu ortadan kaldırmaz." : "Pika provides product controls; it does not remove the customer's responsibility for legal assessment and process governance.")</span></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_kullanici-roller-yetkiler_24.png" alt="@(tr?"Pika kullanıcı rol ve yetki ekranı":"Pika users roles and permissions screen")" width="1200" height="760" /><div class="pk-stage-caption"><strong>@(tr?"Erişim ve yetki":"Access and authorization")</strong><span>@(tr?"Kullanıcı · Rol · Operasyon":"User · Role · Operation")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-shield-user-line"></i><div><strong>@(tr?"Rol ve yetki":"Roles & authorization")</strong><small>@(tr?"Erişimi ayır":"Separate access")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-user-unfollow-line"></i><div><strong>Opt-out</strong><small>@(tr?"Müşteri tercihi":"Customer preference")</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-lock-2-line"></i><div><strong>@(tr?"Kontrollü alanlar":"Protected areas")</strong><small>@(tr?"Anonim erişime kapalı":"Not anonymous")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Güven modeli":"Trust model")</span><h2>@(tr?"Kim sisteme girebilir, kim ne yapabilir, kime iletişim kurulabilir: üç ayrı soru.":"Who can sign in, who can do what, and who can be contacted are three separate questions.")</h2></div><p class="pk-lead">@(tr?"Kimlik doğrulama, uygulama yetkilendirmesi ve müşteri iletişim izni aynı kavram değildir. Pika bu ayrımları tek bir 'güvenli/güvensiz' etikete sıkıştırmak yerine ürünün farklı kontrol katmanlarında yönetir.":"Authentication, application authorization and customer communication consent are different concepts. Pika keeps them in distinct control layers instead of collapsing them into one generic security state.")</p></div><div class="pk-intel-grid"><article class="pk-intel-panel"><span class="pk-intel-number">01</span><div class="pk-intel-icon"><i class="ri-login-box-line"></i></div><h3>@(tr?"Kimlik doğrulama":"Authentication")</h3><p>@(tr?"Korunan ürün alanları mevcut kimlik doğrulama altyapısıyla oturum açmış kullanıcı kimliği üzerinden çalışır. Anonim erişime açık olmaması gereken alanlar server-side korumayla ayrılmalıdır." : "Protected product areas operate through authenticated user identity. Areas not intended for anonymous access should be protected server-side.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">02</span><div class="pk-intel-icon"><i class="ri-user-settings-line"></i></div><h3>@(tr?"Rol ve yetki":"Roles & authorization")</h3><p>@(tr?"Farklı ekiplerin aynı ekranlara veya operasyonlara erişmesi gerekmez. Kullanıcı/rol bağlamı erişim ve işlem yetkisini ayırmak için kullanılır." : "Different teams do not need identical access. User/role context separates visibility and operational permissions.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">03</span><div class="pk-intel-icon"><i class="ri-shield-check-line"></i></div><h3>@(tr?"İletişim uygunluğu":"Communication eligibility")</h3><p>@(tr?"Bir kullanıcının kampanya hazırlayabilmesi, hedef müşterinin email/SMS/WhatsApp gibi kanallarda iletişime uygun olduğu anlamına gelmez. İzin ve opt-out ayrı değerlendirilir." : "A user being able to prepare a campaign does not mean the target customer is eligible for Email/SMS/WhatsApp communication. Consent and opt-out remain separate.")</p></article></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Kullanıcı ve rol kontrolü":"User and role control")</span><h2>@(tr?"Her kullanıcıya her ekran ve operasyonu açmak zorunda değilsiniz.":"Not every user needs access to every screen and operation.")</h2></div><p class="pk-lead">@(tr?"Pika kullanıcı, rol ve yetki bağlamını operasyonu ayırmak için kullanır. Ürün içindeki gerçek yetki kapsamı mevcut uygulama davranışına bağlıdır; bu sayfa doğrulanmayan ayrıntılı RBAC iddiaları veya sertifikasyon dili kullanmaz.":"Pika uses users, roles and permissions to separate operations. Exact authorization scope depends on current application behavior; this page does not claim unverified RBAC detail or certification.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_kullanici-roller-yetkiler_24.png" alt="@(tr?"Pika kullanıcı rol ve yetki yönetimi":"Pika user role and permission management")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Kullanıcı ve yetki":"Users and permissions")</small><h3>@(tr?"Operasyon erişimini ürün içinde görünür yönetin":"Manage operational access visibly in the product")</h3><p>@(tr?"Kullanıcı ve rol ayrımı, ekiplerin ihtiyaç duydukları alan ve işlemlerle sınırlandırılmasına yardımcı olur." : "User and role separation helps limit teams to the areas and operations they need.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_izin-kanal-zamanlama_25.png" alt="@(tr?"Pika izin kanal ve zamanlama kontrolleri":"Pika consent channel and timing controls")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Consent Management</small><h3>@(tr?"Kullanıcı yetkisi ile müşteri iznini karıştırmayın":"Do not confuse user authorization with customer consent")</h3><p>@(tr?"Kampanya oluşturma yetkisi, hedef müşteriye her kanaldan iletişim kurulabileceği anlamına gelmez." : "Permission to create campaigns does not make every target customer eligible for every channel.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">@(tr?"İzin, opt-out ve İYS":"Consent, opt-out and IYS")</span><h2>@(tr?"Kişi kaydı ile iletişim iznini kesin olarak ayırın.":"Keep contact records and communication consent explicitly separate.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Excel, API, Gmail veya Outlook üzerinden Pika'ya kişi aktarılması yalnızca müşteri/iletişim verisini sisteme getirir. Ticari iletişim uygunluğu ilgili kanal izni, opt-out ve desteklenen İYS/operasyon süreçleriyle ayrıca değerlendirilmelidir.":"Importing contacts through Excel, API, Gmail or Outlook brings customer/contact data into Pika. Commercial communication eligibility still requires separate consent, opt-out and supported IYS/operational evaluation.")</p><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/consent-management":"/en/platform/consent-management")">Consent Management</a><a class="pk-btn pk-btn-ghost" href="/wiki/gmail-kisi-aktarimi">@(tr?"Kişi aktarımı rehberi":"Contact import guide")</a></div></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-user-add-line"></i><div><strong>@(tr?"Kişi kaydı":"Contact record")</strong><span>@(tr?"Ad, email, telefon veya diğer müşteri bilgisi." : "Name, email, phone or other customer data.")</span></div></div><div class="pk-control-step"><i class="ri-shield-check-line"></i><div><strong>@(tr?"Kanal izni":"Channel consent")</strong><span>@(tr?"İlgili iletişim kanalının kullanılabilirliğine ilişkin ayrı bağlam." : "Separate context for whether a communication channel may be used.")</span></div></div><div class="pk-control-step"><i class="ri-user-unfollow-line"></i><div><strong>Opt-out</strong><span>@(tr?"Müşterinin ilgili pazarlama iletişiminden çıkma tercihi." : "The customer's preference to stop relevant marketing communication.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-scales-3-line"></i><div><strong>@(tr?"Hukuki süreç":"Legal process")</strong><span>@(tr?"Pika ürün içi kontroller sunar; yasal dayanak ve süreç sorumluluğu müşterinin kendi değerlendirmesini gerektirir." : "Pika provides product controls; legal basis and process responsibilities still require customer assessment.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Gönderim güvenliği":"Delivery safeguards")</span><h2>@(tr?"Fırsat güçlü olsa bile uygun olmayan kanaldan gönderim yapılmamalı.":"A strong opportunity does not justify an ineligible channel.")</h2></div><p class="pk-lead">@(tr?"Gönderim öncesinde hedef kişi, iletişim adresi, izin/opt-out ve ilgili kanal/operasyon koşulları ayrı kontrollerdir. Uygun kanal bulunmuyorsa güvenli ve doğru sonuç hiç iletişim aksiyonu üretmemek olabilir.":"Target identity, contact address, consent/opt-out and relevant channel/operational conditions are separate pre-delivery controls. If no channel is eligible, the safe and correct outcome may be no communication action.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Fırsat":"Opportunity")</strong><span>@(tr?"Ticari neden var mı?":"Is there a business reason?")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-user-line"></i><strong>@(tr?"Kişi":"Customer")</strong><span>@(tr?"Doğru müşteri/kitle mi?":"Right customer/audience?")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-at-line"></i><strong>@(tr?"Adres":"Address")</strong><span>@(tr?"Kanal bilgisi mevcut mu?":"Is channel data available?")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-shield-check-line"></i><strong>@(tr?"İzin":"Consent")</strong><span>Opt-out · IYS</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-checkbox-circle-line"></i><strong>@(tr?"Uygunluk":"Eligibility")</strong><span>@(tr?"Kanal kullanılabilir mi?":"Can the channel be used?")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-send-plane-line"></i><strong>@(tr?"Aksiyon / yok":"Action / none")</strong><span>@(tr?"Uygunsa yürüt; değilse gönderme":"Execute if eligible; otherwise do not send")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Veri ve entegrasyon":"Data and integration")</span><h2>@(tr?"Veri kalitesi ile güvenliği karıştırmayın; ikisini de görünür yönetin.":"Do not confuse data quality with security; manage both visibly.")</h2></div><p class="pk-lead">@(tr?"Excel/CSV veya API ile alınan veriler eşleme ve doğrulama adımlarından geçer. Eksik müşteri, ürün veya kanal bağlamı analitik kapsamı etkileyebilir. Bu bir veri kalitesi problemidir; güvenlik/izin kontrolünün yerine geçmez. Aynı şekilde güvenli bağlantı, hatalı veriyi doğru analitik haline getirmez.":"Data received through Excel/CSV or API goes through mapping and validation. Missing customer, product or channel context can affect analytical coverage. That is a data-quality issue, not a replacement for security/consent controls. Likewise, secure transport does not make incorrect data analytically correct.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_excel-csv-aktarimi_1.png" alt="@(tr?"Pika Excel CSV veri aktarım ekranı":"Pika Excel CSV import screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Veri aktarımı":"Data ingestion")</small><h3>@(tr?"Veriyi eşleyin ve doğrulayın":"Map and validate data")</h3><p>@(tr?"Dosyanın sisteme gelmesi, satırların veya ilişkilerin analitik için doğru olduğu anlamına gelmez." : "A file arriving in the system does not prove that rows and relationships are analytically correct.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_review-resolution-readiness_14.png" alt="@(tr?"Pika veri review ve readiness ekranı":"Pika data review and readiness screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Kalite ve belirsizlik":"Quality and uncertainty")</small><h3>@(tr?"Belirsizliği gizlemeyin":"Do not hide uncertainty")</h3><p>@(tr?"Eşleşme ve sınıflandırma sorunları ilgili intelligence ve fırsat sonuçlarının güvenini etkileyebilir." : "Resolution and classification issues can affect confidence in intelligence and opportunity outputs.")</p></div></div></div><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/integrations":"/en/platform/integrations")">@(tr?"Entegrasyonları inceleyin":"Explore Integrations")</a></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-trust-band"><div><span class="pk-eyebrow">@(tr?"Doğrulanmış iddia politikası":"Verified-claims policy")</span><h2>@(tr?"Güvenlik sayfası satış sloganı değil, doğrulanabilir güven katmanı olmalı.":"A security page should be a verifiable trust layer, not a sales slogan.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Bu nedenle Pika'nın public sitesinde doğrulanmamış sertifika, bağımsız denetim, penetration test, veri lokasyonu, encryption standardı veya mutlak KVKK uyumu gibi iddialar kullanılmamalıdır. Gelecekte doğrulanmış bir güven belgesi olduğunda tarih ve kapsamıyla açıkça eklenebilir.":"That is why Pika's public site should not claim unverified certifications, independent audits, penetration tests, hosting location, encryption standards or absolute legal compliance. Verified trust evidence can be added later with clear date and scope.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="/wiki/izin-optout-iys">@(tr?"Public güven dokümantasyonu":"Public trust documentation")</a></div></div><div class="pk-trust-points"><div class="pk-trust-point"><strong>@(tr?"Sertifika":"Certifications")</strong><span>@(tr?"ISO/SOC vb. yalnız doğrulanmış ve güncel belge varsa yayınlanır." : "ISO/SOC and similar claims are published only with verified current evidence.")</span></div><div class="pk-trust-point"><strong>@(tr?"Hosting / veri lokasyonu":"Hosting / data location")</strong><span>@(tr?"Mevcut deploy altyapısı doğrulanmadan coğrafi garanti verilmez." : "No geographical guarantee is made without verified deployment evidence.")</span></div><div class="pk-trust-point"><strong>@(tr?"KVKK / mevzuat":"KVKK / regulation")</strong><span>@(tr?"Pika süreç ve ürün kontrolleri sağlar; '100% uyumlu' gibi mutlak hukuki garanti vermez." : "Pika provides product/process controls and does not claim absolute legal compliance.")</span></div><div class="pk-trust-point"><strong>@(tr?"Operasyon":"Operations")</strong><span>@(tr?"Internal mimari ve güvenlik ayrıntıları public Wiki'ye açılmaz; müşteri için gerekli güven bilgisi customer-safe düzeyde sunulur." : "Internal architecture and security detail stays private; customer-facing trust information is presented at a customer-safe level.")</span></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-cta-panel"><span class="pk-eyebrow" style="color:#d7ed87">@(tr?"Sorumluluk sınırı":"Responsibility boundary")</span><h2>@(tr?"Pika kontrol sağlar; hukuki danışmanlık vermez.":"Pika provides controls; it does not replace legal advice.")</h2><p>@(tr?"İşletmenin kişisel veriyi hangi hukuki dayanakla işlediği, gerekli aydınlatma süreçleri, ileti türü, veri kaynağı ve yürürlükteki mevzuata ilişkin sorumlulukları kendi hukuk ve operasyon süreçleri kapsamında değerlendirilmelidir. Pika'nın izin ve gönderim kontrolleri bu sorumluluğu ortadan kaldırmaz." : "Customers remain responsible for evaluating legal basis, notices, communication type, data source and applicable regulation within their own legal and operational processes. Pika's consent and delivery controls do not remove that responsibility.")</p><div class="pk-actions"><a class="pk-btn pk-btn-light" href="@(tr?"/iletisim":"/en/contact")">@(tr?"Güvenlik Sorunuzu İletin":"Contact Us")</a><a class="pk-btn pk-btn-ghost" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.25)" href="/wiki/">@(tr?"Bilgi Bankasını Aç":"Open Knowledge Base")</a></div></div></div></section>

@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]="Email | "+(tr?"Pika Kanalları":"Pika Channels");
    ViewData["MetaDescription"]=tr?"Pika'da Email kanalını hedef kitle, izin, içerik, Campaign/Journey ve ölçüm bağlamıyla yönetin; gönderim güvenliği, unsubscribe ve sonuçları ayrı kontroller olarak ele alın.":"Use Email in Pika with audience, consent, content, Campaign/Journey and measurement context, keeping delivery safeguards, unsubscribe and outcomes explicit.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">@(tr?"Kanallar · Email":"Channels · Email")</span><h1>@(tr?"Email'i tek başına ürün değil, doğru kararın iletişim kanalı olarak kullanın.":"Use Email as the communication channel for the right decision, not as the product itself.")</h1><p>@(tr?"Pika'da Email; Günün Fırsatları, Audience, Campaign veya Journey bağlamında hedef kitle ve içerik kararı oluştuktan sonra kullanılan aksiyon kanallarından biridir. Gönderim öncesinde izin, opt-out, ulaşılabilirlik ve ilgili operasyon kontrolleri ayrıca değerlendirilir.":"In Pika, Email is an execution channel used after opportunity, audience and Campaign/Journey context is established. Consent, opt-out, reachability and relevant operational controls are evaluated separately before delivery.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Email Akışını Canlı Görün":"See Email Flow Live")</button><a class="pk-btn pk-btn-ghost" href="/wiki/email-template-editor">@(tr?"Email rehberi":"Email guide")</a></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_email-template-editor_17.png" alt="@(tr?"Pika Email Template Editor ekranı":"Pika Email Template Editor screen")" width="1200" height="760" /><div class="pk-stage-caption"><strong>Email</strong><span>@(tr?"İçerik · Şablon · Campaign/Journey":"Content · Template · Campaign/Journey")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-layout-4-line"></i><div><strong>Content Studio</strong><small>@(tr?"İçeriği hazırlayın":"Prepare content")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-shield-check-line"></i><div><strong>@(tr?"İzin":"Consent")</strong><small>@(tr?"Opt-out ve uygunluk":"Opt-out and eligibility")</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-bar-chart-box-line"></i><div><strong>Analytics</strong><small>@(tr?"Gönderimden sonuca":"From delivery to outcome")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Email'in Pika'daki rolü":"Email's role in Pika")</span><h2>@(tr?"Önce neden ve kime; sonra içerik ve kanal.":"Reason and audience first; content and channel second.")</h2></div><p class="pk-lead">@(tr?"Pika Email'i geniş bir listeye mesaj atan bağımsız bir araç gibi konumlandırmaz. Müşteri/fırsat bağlamı hedef kitleyi, Content Studio mesajı, Campaign/Journey yürütme modelini, Consent Management ise kanal uygunluğunu belirlemeye yardımcı olur.":"Pika does not position Email as a standalone list-blasting tool. Customer/opportunity context informs the audience, Content Studio prepares the message, Campaign/Journey defines execution, and Consent Management supports channel eligibility.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Neden":"Reason")</strong><span>@(tr?"Fırsat veya kampanya amacı":"Opportunity or campaign purpose")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-group-line"></i><strong>Audience</strong><span>@(tr?"Kime?":"Who?")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-file-edit-line"></i><strong>Content</strong><span>@(tr?"Ne söyleyeceğiz?":"What will we say?")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-shield-check-line"></i><strong>@(tr?"Uygunluk":"Eligibility")</strong><span>@(tr?"İzin · Opt-out · Adres":"Consent · Opt-out · Address")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-mail-send-line"></i><strong>Email</strong><span>@(tr?"Campaign / Journey aksiyonu":"Campaign / Journey action")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>Analytics</strong><span>@(tr?"Ne oldu?":"What happened?")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"İçerik ve şablon":"Content and templates")</span><h2>@(tr?"Her kampanyada sıfırdan email tasarlamayın.":"Do not redesign email from scratch for every campaign.")</h2></div><p class="pk-lead">@(tr?"Content Studio ve Email Store yaklaşımı, tekrarlanabilir içerik yapılarının ekip içinde yeniden kullanılmasını sağlar. Şablon hazırlığı hızlandırır; hedef kitle, teklif, izin ve kampanya bağlamının her kullanımda yeniden değerlendirilmesi gerekir.":"Content Studio and Email Store support reusable content patterns across teams. Templates accelerate preparation, while audience, offer, consent and campaign context still need review for each use.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_email-template-editor_17.png" alt="@(tr?"Pika email içerik editörü":"Pika email content editor")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Email Template Editor</small><h3>@(tr?"İçeriği görsel olarak hazırlayın ve kontrol edin":"Prepare and review email content visually")</h3><p>@(tr?"Desteklenen içerik bileşenleriyle email'i düzenleyin ve Campaign/Journey öncesinde içerik hazırlığını görünür tutun." : "Edit email using supported components and keep content preparation visible before Campaign/Journey execution.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_email-store_20.png" alt="Pika Email Store" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Email Store</small><h3>@(tr?"Doğrulanmış içerik yapılarını yeniden kullanın":"Reuse validated content structures")</h3><p>@(tr?"Ekip standardını korurken yeni kampanya hazırlama süresini azaltın." : "Reduce preparation time while preserving team standards.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">@(tr?"Gönderim güvenliği":"Delivery safeguards")</span><h2>@(tr?"Teslim edilebilirlik tek bir 'gönder' düğmesinden ibaret değildir.":"Deliverability is more than a send button.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Email operasyonunda gönderici domaini/hesabı, unsubscribe davranışı, adres kalitesi, sağlayıcı yanıtları ve gönderim hacmi operasyonel güveni etkileyebilir. Pika bunları müşteri güvenliğini gözeten gönderim süreçlerinin parçaları olarak ele alır; belirli bir teslim oranı veya domain itibarı sonucu garanti etmez.":"Sender domain/account context, unsubscribe behavior, address quality, provider responses and sending volume can affect operational reliability. Pika treats these as delivery safeguards and does not guarantee a specific delivery rate or domain-reputation outcome.")</p></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-user-unfollow-line"></i><div><strong>Unsubscribe / Opt-out</strong><span>@(tr?"İletişimden çıkma tercihi gönderim kararının ön koşullarından biridir." : "Unsubscribe preference is a precondition in the delivery decision.")</span></div></div><div class="pk-control-step"><i class="ri-global-line"></i><div><strong>@(tr?"Gönderici bağlamı":"Sender context")</strong><span>@(tr?"Gönderici hesap/domain sağlığı ve doğru teknik yapı yüksek hacimde önem kazanır." : "Sender account/domain health and correct setup matter more as volume grows.")</span></div></div><div class="pk-control-step"><i class="ri-error-warning-line"></i><div><strong>@(tr?"Başarısız gönderim":"Delivery failure")</strong><span>@(tr?"Geçici teknik sorun ile kalıcı adres/izin engeli aynı şekilde ele alınmamalıdır." : "Temporary technical issues and permanent address/consent blocks should not be treated the same way.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-settings-4-line"></i><div><strong>@(tr?"Operasyon kararı":"Operational decision")</strong><span>@(tr?"Hacim, gönderici altyapısı ve provider seçimi müşteri kullanım senaryosuna göre yönetilmelidir." : "Volume, sender infrastructure and provider choices should be managed according to customer use case.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">Email + Journey</span><h2>@(tr?"Tek seferlik mailden davranışa bağlı müşteri akışına.":"From one-off email to behavior-aware customer flow.")</h2></div><p class="pk-lead">@(tr?"Email bir Campaign içinde planlı gönderim olabilir veya Journey içinde tetikleyici, koşul ve bekleme adımlarının ardından gelen iletişim aksiyonu olabilir. Kanalın kendisi müşteri yolculuğunu tanımlamaz; Journey mantığı email'in ne zaman anlamlı olduğunu belirler.":"Email can be a planned Campaign execution or a Journey action after triggers, conditions and waits. The channel itself does not define the customer journey; Journey logic determines when Email is appropriate.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_journey-tasarim-tuvali_18.png" alt="@(tr?"Pika Journey içinde email aksiyonu":"Pika Journey with email action")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Journey Manager</small><h3>Trigger → Condition → Wait → Email</h3><p>@(tr?"Email'i müşterinin durumuna ve zamanlamaya bağlı bir Journey adımı olarak kullanın." : "Use Email as a Journey step driven by customer context and timing.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_yayinlama-sablon-ve-yonetim_27.png" alt="@(tr?"Pika Campaign yayınlama ekranı":"Pika Campaign publishing screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Campaign Manager</small><h3>@(tr?"Tanımlı kampanya için kontrollü yayın":"Controlled publishing for a defined campaign")</h3><p>@(tr?"Hedef kitle, içerik, email kanalı ve zamanlamayı tek kampanya operasyonunda yönetin." : "Manage audience, content, email channel and timing within one campaign operation.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">Email → Measure</span><h2>@(tr?"Gönderildi, açıldı, tıklandı ve satın alındı aynı sonuç değildir.":"Sent, opened, clicked and purchased are not the same outcome.")</h2></div><p class="pk-lead">@(tr?"Email operasyonunda delivery ve desteklenen engagement sonuçları ile satış attribution bağlamını birbirinden ayırın. Bir mesajın teslim edilmesi etkileşim anlamına gelmez; bir etkileşimin ardından satış görülmesi de otomatik olarak kampanyanın satışı yarattığını kanıtlamaz.":"Keep delivery, supported engagement and sales-attribution context distinct. Delivery is not engagement, and a later purchase does not automatically prove that the campaign caused the sale.")</p></div><div class="pk-columns"><div class="pk-feature"><i class="ri-mail-check-line"></i><h3>@(tr?"Delivery":"Delivery")</h3><p>@(tr?"Mesajın gönderim akışındaki teknik durumunu değerlendirin." : "Review the message's technical delivery status.")</p></div><div class="pk-feature"><i class="ri-cursor-line"></i><h3>Engagement</h3><p>@(tr?"Kanalın desteklediği açılma, tıklama veya benzeri etkileşimleri ayrı sonuçlar olarak okuyun." : "Read supported opens, clicks and other engagement as separate outcomes.")</p></div><div class="pk-feature"><i class="ri-shopping-cart-line"></i><h3>Attribution</h3><p>@(tr?"Tanımlı ilişkilendirme penceresindeki satış davranışını değerlendirin; nedensellik olarak sunmayın." : "Review sales behavior within the attribution window without presenting it as causality.")</p></div></div><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/analytics":"/en/platform/analytics")">Analytics</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/consent-management":"/en/platform/consent-management")">Consent Management</a></div></div></section>

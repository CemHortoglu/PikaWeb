@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-solutions-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-email-page.css" asp-append-version="true" />
}

@* ── 01 HERO ─────────────────────────────────────────────────── *@
<section class="inner-hero inner-hero--content">
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span>/</span>
                <span>Email</span>
            </nav>
            <div class="inner-eyebrow"><span></span>EMAIL · Email Marketing</div>
            @if (tr)
            {
                <h1>
                    Zengin Email içeriğini,<br />
                    Pika'nın müşteri bağlamı ve<br />
                    kontrollü aksiyon zinciriyle buluşturun.
                </h1>
                <p>
                    Pika Email; Content Studio'da hazırlanan görsel ve kişiselleştirilebilir Email içeriğinin Audience Manager, Campaign Manager veya Journey Manager tarafından oluşturulan kontrollü iletişim bağlamında kullanılmasını sağlayan Email iletişim kanalıdır.
                </p>
                <p class="text-muted small">
                    Amaç daha fazla toplu mail göndermek değil; doğru hedef kitle, hazırlanmış içerik, izin kontrolü ve ölçülebilir gönderim sonucunu aynı Pika karar zincirinde buluşturmaktır.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">Demo Talep Et ↗</button>
                    <a class="inner-secondary" href="/cozumler/content-studio">Content Studio'yu Keşfedin →</a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="İçeriğe atla"><i class="ri-arrow-down-line" aria-hidden="true"></i></a>
                </div>
            }
            else
            {
                <h1>
                    Connect rich Email content<br />
                    to Pika's customer context<br />
                    and controlled action chain.
                </h1>
                <p>
                    Pika Email is the communication channel through which visual and personalizable Email content prepared in Content Studio can be used within controlled communication context created through Audience Manager, Campaign Manager or Journey Manager.
                </p>
                <p class="text-muted small">
                    The objective is not to send more bulk email, but to connect the right audience, prepared content, permission controls and measurable delivery outcomes within the same Pika decision chain.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">Request a Demo ↗</button>
                    <a class="inner-secondary" href="/en/solutions/content-studio">Explore Content Studio →</a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="Skip to content"><i class="ri-arrow-down-line" aria-hidden="true"></i></a>
                </div>
            }
        </div>

        <div class="inner-scene" aria-hidden="true">
            <div class="inner-scene-orbit"></div>
            <div class="inner-scene-window">
                <div class="inner-window-bar">
                    <strong>pika<span>✳</span></strong>
                    <span>Email</span>
                    <small>@(tr ? "Örnek görünüm" : "Illustration")</small>
                </div>
                <div class="email-hero-pills">
                    @if (tr)
                    {
                        <span class="email-hero-pill">İÇERİK <span>01</span></span>
                        <span class="email-hero-pill">HEDEF KİTLE <span>02</span></span>
                        <span class="email-hero-pill">İZİN <span>03</span></span>
                        <span class="email-hero-pill">EMAIL <span>04</span></span>
                        <span class="email-hero-pill">TESLİMAT <span>05</span></span>
                        <span class="email-hero-pill">ÖLÇÜM <span>06</span></span>
                    }
                    else
                    {
                        <span class="email-hero-pill">CONTENT <span>01</span></span>
                        <span class="email-hero-pill">AUDIENCE <span>02</span></span>
                        <span class="email-hero-pill">CONSENT <span>03</span></span>
                        <span class="email-hero-pill">EMAIL <span>04</span></span>
                        <span class="email-hero-pill">DELIVERY <span>05</span></span>
                        <span class="email-hero-pill">MEASUREMENT <span>06</span></span>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<div id="inner-content" class="inner-anchor"></div>

@* ── STICKY SUBNAV ────────────────────────────────────────────── *@
<div class="pika-sol-subnav-wrap">
    <div class="container">
        <nav class="pika-sol-subnav" aria-label="@(tr ? "Sayfa içi gezinti" : "In-page navigation")">
            <a href="#overview">@(tr ? "Genel Bakış" : "Overview")</a>
            <a href="#content">@(tr ? "İçerik" : "Content")</a>
            <a href="#audience">@(tr ? "Hedef Kitle" : "Audience")</a>
            <a href="#campaign">@(tr ? "Kampanya" : "Campaign")</a>
            <a href="#journey">Journey</a>
            <a href="#measurement">@(tr ? "Ölçüm" : "Measurement")</a>
            <a href="#faq">@(tr ? "SSS" : "FAQ")</a>
        </nav>
    </div>
</div>

@* ── TRUST / VALUE STRIP ──────────────────────────────────────── *@
<section class="pika-sol-section py-4">
    <div class="container">
        <div class="pika-sol-highlight-items justify-content-center">
            <span class="pika-sol-highlight-item"><i class="ri-check-line" aria-hidden="true"></i> @(tr ? "Görsel Email İçeriği" : "Visual Email Content")</span>
            <span class="pika-sol-highlight-item"><i class="ri-check-line" aria-hidden="true"></i> @(tr ? "Yeniden Kullanılabilir Şablonlar" : "Reusable Templates")</span>
            <span class="pika-sol-highlight-item"><i class="ri-check-line" aria-hidden="true"></i> @(tr ? "Kişiselleştirme" : "Personalization")</span>
            <span class="pika-sol-highlight-item"><i class="ri-check-line" aria-hidden="true"></i> @(tr ? "Kontrollü Gönderim" : "Controlled Delivery")</span>
            <span class="pika-sol-highlight-item"><i class="ri-check-line" aria-hidden="true"></i> @(tr ? "Teslimat & Etkileşim Ölçümü" : "Delivery & Engagement Measurement")</span>
        </div>
    </div>
</section>

@* ── 02 DIRECT ANSWER ─────────────────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="overview">
    <div class="container">
        <div class="max-w-800">
            <span class="pika-sol-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
            <h2 class="pika-sol-section-title">@(tr ? "Pika Email nedir?" : "What is Pika Email?")</h2>
            <p class="pika-sol-section-desc">
                @(tr ? "Pika Email, görsel ve daha zengin iletişim içeriğinin kampanya veya müşteri yolculuğu bağlamında gönderilebildiği doğrulanmış Pika iletişim kanallarından biridir." : "Pika Email is one of Pika's confirmed communication channels for delivering richer visual communication content within campaign or customer-journey context.")
            </p>
            <p class="mt-3">
                @(tr ? "Email'in kanal rolü içerik editörlüğü, hedef kitle seçimi veya journey kararını kendi başına yürütmek değildir. Bu görevler Pika'nın ilgili Content Studio, Audience Manager, Campaign Manager ve Journey Manager katmanlarında yönetilir." : "The role of the Email channel is not to independently edit content, choose the audience or make journey decisions. Those responsibilities are managed in Pika's Content Studio, Audience Manager, Campaign Manager and Journey Manager layers.")
            </p>
            <p class="mt-4 fw-medium text-dark">
                @(tr ? "Email'in temel sorusu şudur:" : "Email answers one central question:")
            </p>
            <div class="email-callout">
                <h3 class="h4 mb-0 text-dark">
                    @(tr ? "“Hazırlanmış bu Email iletişimi hangi kontrollü aksiyon bağlamında müşteriye ulaştırılacak?”" : "“Within which controlled action context will this prepared Email communication be delivered to the customer?”")
                </h3>
            </div>
            <p class="mt-3">
                @(tr ? "Gönderimden sonra oluşan delivery, bounce, open ve click gibi kullanılabilir sonuçlar Analytics & Reporting bağlamında değerlendirilebilir." : "Available outcomes such as delivery, bounce, open and click context after execution can be evaluated in Analytics & Reporting.")
            </p>
            <div class="p-3 bg-white rounded border border-light-subtle mt-4">
                <p class="mb-1"><strong>Email:</strong> @(tr ? "iletişim kanalıdır." : "is the communication channel.")</p>
                <p class="mb-0"><strong>Pika:</strong> @(tr ? "kanalın etrafındaki anlama, karar, kontrol ve ölçüm zinciridir." : "is the surrounding chain of understanding, decision, control and measurement.")</p>
            </div>
        </div>
    </div>
</section>

@* ── 03 EMAIL'S PLACE IN PIKA ─────────────────────────────────── *@
<section class="pika-sol-section" id="platform">
    <div class="container">
        <div class="max-w-800">
            <span class="pika-sol-eyebrow">@(tr ? "KANAL, PLATFORMUN TAMAMI DEĞİL" : "A CHANNEL, NOT THE WHOLE PLATFORM")</span>
            <h2 class="pika-sol-section-title">@(tr ? "Email'i, Pika'nın karar zincirindeki doğru yere koyun." : "Put Email in the right place inside Pika's decision chain.")</h2>
            <p class="pika-sol-section-desc">
                @(tr ? "Pika bir Email Marketing aracından ibaret değildir. Email, platformun müşteri zekâsı ve omnichannel aksiyon zincirindeki iletişim kanallarından biridir." : "Pika is more than an Email Marketing tool. Email is one communication channel within the platform's customer-intelligence and omnichannel-action chain.")
            </p>
            <p class="mt-3">
                @if (tr)
                {
                    <text>Müşterinin davranış ve değer bağlamı <a href="/platform/customer-intelligence">Customer Intelligence</a>'da, ürün bağlamı <a href="/platform/product-intelligence">Product Intelligence</a>'da ve değerlendirilebilir ticari fırsat <a href="/platform/gunun-firsatlari">Günün Fırsatları</a> gibi karar katmanlarında oluşur.</text>
                }
                else
                {
                    <text>Customer behavior and value context comes from <a href="/en/platform/customer-intelligence">Customer Intelligence</a>, product context comes from <a href="/en/platform/product-intelligence">Product Intelligence</a> and evaluable commercial opportunity context can come from decision layers such as <a href="/en/platform/opportunities">Daily Opportunities</a>.</text>
                }
            </p>
            <p class="mt-3">
                @(tr ? "Audience Manager kimin dahil olduğunu, Content Studio hangi içeriğin kullanılacağını, Campaign Manager veya Journey Manager ise aksiyonun nasıl yürütüleceğini belirleyen ayrı ürün katmanlarıdır." : "Audience Manager defines who belongs, Content Studio prepares what content will be used and Campaign Manager or Journey Manager manage how action is executed.")
            </p>

            <div class="email-flow-chain" aria-label="Pika Decision Chain">
                <span>DATA</span>
                <span class="email-flow-arrow">→</span>
                <span>@(tr ? "CUSTOMER & PRODUCT INTELLIGENCE" : "CUSTOMER & PRODUCT INTELLIGENCE")</span>
                <span class="email-flow-arrow">→</span>
                <span>@(tr ? "OPPORTUNITY / DECISION" : "OPPORTUNITY / DECISION")</span>
                <span class="email-flow-arrow">→</span>
                <span>AUDIENCE</span>
                <span class="email-flow-arrow">→</span>
                <span>CONTENT</span>
                <span class="email-flow-arrow">→</span>
                <span>CAMPAIGN / JOURNEY</span>
                <span class="email-flow-arrow">→</span>
                <span>CONSENT</span>
                <span class="email-flow-arrow">→</span>
                <span>EMAIL</span>
                <span class="email-flow-arrow">→</span>
                <span>MEASUREMENT</span>
            </div>

            <div class="p-3 bg-white rounded border border-light-subtle mt-4">
                @if (tr)
                {
                    <p class="mb-1"><strong>Email,</strong> Pika'nın başlangıç noktası değildir.</p>
                    <p class="mb-0">Kararın müşteriye ulaştığı kanal katmanıdır.</p>
                }
                else
                {
                    <p class="mb-1"><strong>Email</strong> is not Pika's starting point.</p>
                    <p class="mb-0">It is the channel layer through which a decision reaches the customer.</p>
                }
            </div>
        </div>

        <div class="pika-sol-value-grid mt-5">
            <div class="pika-sol-value-card">
                <div class="pika-sol-value-icon"><i class="ri-palette-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Görsel Email İçeriği" : "Visual Email Content")</h4>
                <p>@(tr ? "Content Studio'da hazırlanmış görsel ve modüler Email içeriğini kontrollü iletişim bağlamında kullanın." : "Use visual and modular Email content prepared in Content Studio within controlled communication context.")</p>
            </div>
            <div class="pika-sol-value-card">
                <div class="pika-sol-value-icon"><i class="ri-user-settings-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Kişiselleştirme Bağlamı" : "Personalization Context")</h4>
                <p>@(tr ? "Mevcut müşteri verisinden kullanılabilen kişiselleştirme alanlarını hazırlanmış Email içeriğinde kullanın." : "Use available personalization fields based on existing customer data within prepared Email content.")</p>
            </div>
            <div class="pika-sol-value-card">
                <div class="pika-sol-value-icon"><i class="ri-send-plane-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Kontrollü Kanal Aksiyonu" : "Controlled Channel Action")</h4>
                <p>@(tr ? "Email'i Campaign Manager veya Journey Manager içinde tanımlı iletişim kanallarından biri olarak kullanın." : "Use Email as one configured communication channel inside Campaign Manager or Journey Manager.")</p>
            </div>
            <div class="pika-sol-value-card">
                <div class="pika-sol-value-icon"><i class="ri-bar-chart-box-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Ölçülebilir Sonuçlar" : "Measurable Outcomes")</h4>
                <p>@(tr ? "Delivery, bounce, open, click ve unsubscribe gibi kullanılabilir Email sonuçlarını Analytics & Reporting bağlamında değerlendirin." : "Evaluate available Email outcomes such as delivery, bounce, open, click and unsubscribe within Analytics & Reporting context.")</p>
            </div>
        </div>
    </div>
</section>

@* ── 04 CONTENT STUDIO → EMAIL ────────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="content">
    <div class="container">
        <div class="max-w-800">
            <span class="pika-sol-eyebrow">@(tr ? "İÇERİKTEN KANALA" : "FROM CONTENT TO CHANNEL")</span>
            <h2 class="pika-sol-section-title">@(tr ? "Email içeriğini Content Studio'da hazırlayın. Email kanalında kullanın." : "Prepare Email content in Content Studio. Use it through the Email channel.")</h2>
            <p class="pika-sol-section-desc">
                @(tr ? "Content Studio, Email içeriğinin görsel olarak hazırlanabildiği ve düzenlenebildiği Pika içerik katmanıdır." : "Content Studio is Pika's content layer where Email content can be visually prepared and edited.")
            </p>
            <p class="mt-3">
                @(tr ? "Sürükle-bırak kompozisyon, modüler içerik blokları, şablonlar, kişiselleştirme alanları ve cihaz önizlemesi Content Studio'ın sorumluluğundadır." : "Drag-and-drop composition, modular content blocks, templates, personalization fields and device preview belong to Content Studio.")
            </p>
            <p class="mt-3">
                @(tr ? "Hazırlanan içerik daha sonra Campaign Manager veya Journey Manager içindeki uygun Email aksiyonunda kullanılabilir." : "Prepared content can then be used in an appropriate Email action through Campaign Manager or Journey Manager.")
            </p>

            <div class="email-callout">
                @if (tr)
                {
                    <p class="mb-1"><strong>Content Studio:</strong> “Email içeriğini nasıl hazırlıyoruz?”</p>
                    <p class="mb-0"><strong>Email:</strong> “Hazırlanan içeriği hangi kanalda iletiyoruz?”</p>
                }
                else
                {
                    <p class="mb-1"><strong>Content Studio asks:</strong> “How do we prepare the Email content?”</p>
                    <p class="mb-0"><strong>Email asks:</strong> “Through which channel do we deliver the prepared content?”</p>
                }
            </div>

            <div class="p-3 bg-white rounded border border-light-subtle mt-3">
                @if (tr)
                {
                    <p class="mb-0">Editör ve kanal aynı ürün rolü değildir.</p>
                }
                else
                {
                    <p class="mb-0">The editor and the channel do not perform the same product role.</p>
                }
            </div>

            <div class="mt-4">
                <a href="@(tr ? "/cozumler/content-studio" : "/en/solutions/content-studio")" class="btn pika-btn-outline">
                    @(tr ? "Content Studio'yu Keşfedin →" : "Explore Content Studio →")
                </a>
            </div>
        </div>
    </div>
</section>

@* ── 05 TEMPLATES & PERSONALIZATION ──────────────────────────── *@
<section class="pika-sol-section">
    <div class="container">
        <div class="max-w-800">
            <span class="pika-sol-eyebrow">@(tr ? "ŞABLON VE KİŞİSELLEŞTİRME" : "TEMPLATES & PERSONALIZATION")</span>
            <h2 class="pika-sol-section-title">@(tr ? "Tekrar kullanılabilir yapıyı koruyun. Mevcut müşteri bağlamını içeriğe taşıyın." : "Keep a reusable structure. Bring available customer context into the content.")</h2>
            <p class="pika-sol-section-desc">
                @(tr ? "Content Studio'da hazırlanmış Email şablonları tekrar eden kampanya çalışmalarında başlangıç yapısı olarak yeniden kullanılabilir." : "Email templates prepared in Content Studio can be reused as a starting structure for later campaign work.")
            </p>
            <p class="mt-3">
                @(tr ? "Mevcut müşteri verisinden kullanılabilen kişiselleştirme alanları Email içeriğine eklenebilir." : "Available personalization fields based on existing customer data can appear within Email content.")
            </p>
            <p class="mt-3">
                @(tr ? "Kişiselleştirme, Email kanalının müşteriye ait olmayan yeni bir gerçeği üretmesi anlamına gelmez." : "Personalization does not mean the Email channel invents new facts about the customer.")
            </p>

            <div class="email-callout">
                @if (tr)
                {
                    <p class="mb-1"><strong>Şablon:</strong> yeniden kullanılabilir içerik yapısıdır.</p>
                    <p class="mb-1"><strong>Kişiselleştirme:</strong> mevcut bağlamı içerikte kullanılabilir hale getirir.</p>
                    <p class="mb-0"><strong>Email:</strong> hazırlanan içeriğin iletişim kanalıdır.</p>
                }
                else
                {
                    <p class="mb-1"><strong>A template:</strong> is a reusable content structure.</p>
                    <p class="mb-1"><strong>Personalization:</strong> makes available context usable inside content.</p>
                    <p class="mb-0"><strong>Email:</strong> is the communication channel for the prepared content.</p>
                }
            </div>

            <div class="p-3 bg-white rounded border border-light-subtle mt-3">
                @if (tr)
                {
                    <p class="mb-0">İçerik, kanaldan önce hazırlanır.</p>
                }
                else
                {
                    <p class="mb-0">Content is prepared before channel execution.</p>
                }
            </div>
        </div>
    </div>
</section>

@* ── 06 AUDIENCE → EMAIL ─────────────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="audience">
    <div class="container">
        <div class="max-w-800">
            <span class="pika-sol-eyebrow">@(tr ? "“KİM?”DEN EMAIL'E" : "FROM “WHO?” TO EMAIL")</span>
            <h2 class="pika-sol-section-title">@(tr ? "Email hedef kitleyi seçmez. Audience bağlamını kullanır." : "Email does not choose the audience. It uses audience context.")</h2>
            <p class="pika-sol-section-desc">
                @(tr ? "Audience Manager müşteri verisi ve açık kurallar üzerinden gerçek hedef kitle tanımını yönetir." : "Audience Manager manages the actual audience definition through customer data and explicit rules.")
            </p>
            <p class="mt-3">
                @(tr ? "Email kanalının görevi müşterileri kendi başına segmente etmek veya “en uygun” alıcıları seçmek değildir." : "The role of the Email channel is not to independently segment customers or select the “best” recipients.")
            </p>
            <p class="mt-3">
                @(tr ? "Campaign Manager veya Journey Manager içindeki Email aksiyonu, ilgili audience bağlamını kontrollü iletişim sürecinde kullanabilir." : "An Email action inside Campaign Manager or Journey Manager can use the relevant audience context within controlled communication.")
            </p>

            <div class="email-callout">
                @if (tr)
                {
                    <p class="mb-1"><strong>Audience Manager:</strong> “Kim bu hedef kitleye dahil?”</p>
                    <p class="mb-0"><strong>Email:</strong> “Bu tanımlı kitleye Email iletişimi hangi aksiyon bağlamında ulaştırılacak?”</p>
                }
                else
                {
                    <p class="mb-1"><strong>Audience Manager:</strong> “Who belongs in this audience?”</p>
                    <p class="mb-0"><strong>Email:</strong> “Within which action context will Email communication reach this defined audience?”</p>
                }
            </div>

            <div class="p-3 bg-white rounded border border-light-subtle mt-3">
                @if (tr)
                {
                    <p class="mb-0">Audience gerçeği, kanal tarafından üretilmez.</p>
                }
                else
                {
                    <p class="mb-0">Audience truth is not created by the channel.</p>
                }
            </div>

            <div class="mt-4">
                <a href="@(tr ? "/cozumler/audience-manager" : "/en/solutions/audience-manager")" class="btn pika-btn-outline">
                    @(tr ? "Audience Manager'ı Keşfedin →" : "Explore Audience Manager →")
                </a>
            </div>
        </div>

        <div class="pika-sol-card-grid mt-5">
            <div class="pika-sol-card">
                <div class="pika-sol-card-icon"><i class="ri-megaphone-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Kampanya Email'i" : "Campaign Email")</h4>
                <p>@(tr ? "Tanımlı hedef kitle ve hazırlanmış içeriğin Campaign Manager üzerinden kontrollü Email iletişiminde kullanılabileceği aksiyon bağlamı." : "An action context where a defined audience and prepared content can be used for controlled Email communication through Campaign Manager.")</p>
            </div>
            <div class="pika-sol-card">
                <div class="pika-sol-card-icon"><i class="ri-route-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Journey Email Adımı" : "Journey Email Step")</h4>
                <p>@(tr ? "Hazırlanmış Email içeriğinin Journey Manager içindeki tanımlı sıra, koşul ve bekleme mantığının bir kanal adımı olarak kullanılabileceği journey bağlamı." : "A journey context where prepared Email content can be used as a channel action inside sequence, conditions and wait logic managed by Journey Manager.")</p>
            </div>
            <div class="pika-sol-card">
                <div class="pika-sol-card-icon"><i class="ri-lightbulb-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Fırsattan Email Aksiyonuna" : "From Opportunity to Email Action")</h4>

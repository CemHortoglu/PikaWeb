@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]="Email | "+(tr?"Pika Kanalları":"Pika Channels"); ViewData["MetaDescription"]=tr?"Pika'da Email kanalını hedef kitle, izin, içerik, Campaign/Journey ve ölçüm bağlamıyla yönetin; gönderim güvenliği ve opt-out kontrollerini aksiyondan ayırmayın.":"Use Email in Pika with audience, consent, content, Campaign/Journey and measurement context, keeping delivery safeguards and opt-out checks explicit."; ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">@(tr?"Kanallar · Email":"Channels · Email")</span><h1>@(tr?"Email'i tek başına bir ürün değil, doğru kararın iletişim kanalı olarak kullanın.":"Use Email as the communication channel for a sound decision, not as the product itself.")</h1><p>@(tr?"Pika'da Email; Günün Fırsatları, Audience, Campaign veya Journey bağlamında hedef kitle ve içerik kararı oluştuktan sonra kullanılabilen iletişim kanallarından biridir. Gönderim öncesinde izin, opt-out ve ulaşılabilirlik ayrıca değerlendirilir.":"In Pika, Email is an execution channel used after audience, content and Campaign/Journey context is established. Consent, opt-out and reachability are evaluated separately before delivery.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/email-template-editor">@(tr?"Email Rehberi":"Email Guide")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_email-template-editor_17.png" alt="@(tr?"Pika email template editörü":"Pika email template editor")" width="1200" height="760" /><figcaption>@(tr?"Gerçek ürün görünümü: içerik hazırlama, şablon ve Campaign/Journey kullanımına uygun email çalışma alanı.":"Product view: email content preparation and templates for Campaign/Journey use.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-columns"><div class="pk-feature"><i class="ri-draft-line"></i><h3>@(tr?"İçerik ve şablon":"Content & templates")</h3><p>@(tr?"Content Studio ve Email Store yaklaşımıyla tekrar kullanılabilir iletişim içerikleri hazırlayın.":"Prepare reusable communication content with Content Studio and Email Store workflows.")</p></div><div class="pk-feature"><i class="ri-group-line"></i><h3>@(tr?"Hedef kitle ve bağlam":"Audience & context")</h3><p>@(tr?"Email gönderimini geniş bir listeyle başlatmak yerine segment, fırsat veya Journey bağlamından hedef kitleye bağlayın.":"Connect email delivery to audience, opportunity or Journey context rather than starting from an undifferentiated list.")</p></div><div class="pk-feature"><i class="ri-shield-check-line"></i><h3>@(tr?"İzin ve opt-out":"Consent & opt-out")</h3><p>@(tr?"Kanal adresi, izin ve opt-out durumunu gönderim kararından önce ayrı kontroller olarak değerlendirin.":"Evaluate channel address, consent and opt-out as separate pre-delivery controls.")</p></div></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">@(tr?"Gönderim güvenliği":"Delivery safeguards")</span><h2>@(tr?"Teslim edilebilirlik tek bir 'gönder' düğmesinden ibaret değildir.":"Deliverability is more than a send button.")</h2></div><div><p class="pk-lead">@(tr?"Yüksek hacimli email operasyonlarında gönderici alan adı, unsubscribe davranışı, provider durumu ve başarısız gönderimler operasyonel güvenin parçalarıdır. Pika bu konuları müşteri güvenliğini gözeten gönderim kontrolleri olarak ele alır; belirli bir teslim oranını veya domain itibarı sonucunu garanti etmez.":"At higher email volumes, sender domain health, unsubscribe behavior, provider status and delivery failures all affect operational reliability. Pika treats these as delivery safeguards and does not guarantee a specific delivery rate or domain-reputation outcome.")</p><a class="pk-btn pk-btn-ghost" href="/wiki/izin-optout-iys">@(tr?"İzin ve Opt-out":"Consent & Opt-out")</a></div></div></section>
<section class="pk-section"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">Email → Measure</span><h2>@(tr?"Gönderildi, açıldı, tıklandı ve satın alındı aynı şey değildir.":"Sent, opened, clicked and purchased are different outcomes.")</h2></div><div><p class="pk-lead">@(tr?"Email operasyonunda delivery ve engagement sonuçları; desteklenen satış ilişkilendirmeleriyle birlikte ama ayrı anlamlarla okunmalıdır. Attribution tek başına nedensellik kanıtı değildir.":"Email delivery and engagement outcomes can be reviewed alongside supported sales attribution, but each has a different meaning. Attribution alone is not proof of causation.")</p><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/analytics":"/en/platform/analytics")">Analytics</a></div></div></section>

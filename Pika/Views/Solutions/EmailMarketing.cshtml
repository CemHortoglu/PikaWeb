@{
    var tr = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = tr ? "Email Marketing Yazılımı ile Kampanyalarınızı Yönetin - Pika" : "Email Marketing Software for Campaign Management - Pika";
    ViewData["MetaDescription"] = tr ? "Pika email marketing platformu ile e-posta tasarımını kolayca yapın, segmentasyon sağlayın ve kişiselleştirilmiş mail pazarlama otomasyonlarını yönetin." : "Easily design emails, gain segmentation, and manage personalized email marketing automations with the Pika email marketing platform.";
    ViewData["MetaKeywords"] = "email marketing, e-posta pazarlama, mail pazarlama, email kampanya, marketing otomasyonu, kişiselleştirilmiş email";
}

<!-- Hero -->
<section class="pika-sol-hero">
    <div class="container">
        <nav class="pika-sol-breadcrumb" data-aos="fade-down" data-aos-duration="500">
            <a href="@(tr ? "/" : "/en/")">@(tr ? "Ana Sayfa" : "Home")</a>
            <span class="sep">/</span>
            <a href="@(tr ? "/" : "/en/")">@(tr ? "Çözümler" : "Solutions")</a>
            <span class="sep">/</span>
            <span>Email Marketing</span>
        </nav>
        <div class="pika-sol-hero-grid">
            <div data-aos="fade-right" data-aos-duration="700">
                <h1>@(tr ? "Email Marketing kampanyalarınızı daha akıllı ve kişiselleştirilmiş hale getirin" : "Make your email marketing campaigns smarter and more personalized")</h1>
                <p class="pika-sol-hero-desc">@(tr ? "Pika Email Marketing sistemi; sürükle bırak tasarım, gelişmiş kişiselleştirme, davranışsal segmentasyon ve email otomasyon akışlarıyla e-posta kampanyalarınızı tek panelden ölçeklemenizi sağlar." : "The Pika Email Marketing system helps you scale email campaigns from a single panel through drag-and-drop design, advanced personalization, behavioral segmentation, and email automation flows.")</p>
                <div class="pika-sol-hero-actions">
                    <button type="button" class="btn pika-btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i></button>
                    <a href="#features" class="btn pika-btn-ghost px-4 py-2">@(tr ? "Email Çözümünü İncele" : "Explore Email Solution")</a>
                </div>
                <div class="pika-sol-hero-tags">
                    <span class="pika-sol-tag"><i class="ri-drag-move-line"></i> @(tr ? "Sürükle bırak e-posta tasarımı" : "Drag & drop email design")</span>
                    <span class="pika-sol-tag"><i class="ri-user-heart-line"></i> @(tr ? "Kişiselleştirilmiş gönderim" : "Personalized delivery")</span>
                    <span class="pika-sol-tag"><i class="ri-focus-3-line"></i> @(tr ? "Segment bazlı hedefleme" : "Segment-based targeting")</span>
                    <span class="pika-sol-tag"><i class="ri-loop-right-line"></i> @(tr ? "Otomatik email akışları" : "Automated email flows")</span>
                </div>
            </div>
            <div class="pika-sol-hero-visual" data-aos="fade-left" data-aos-duration="700" data-aos-delay="200">
                <div class="pika-sol-mock-row">
                    <div class="pika-sol-mock-block wide"><i class="ri-mail-line"></i> Email Editor</div>
                    <div class="pika-sol-mock-block"><i class="ri-text"></i> @(tr ? "Konu Satırı" : "Subject Line")</div>
                </div>
                <div class="pika-sol-mock-row">
                    <div class="pika-sol-mock-block"><i class="ri-group-line"></i> @(tr ? "Segment Seçimi" : "Segment Selection")</div>
                    <div class="pika-sol-mock-block"><i class="ri-calendar-schedule-line"></i> @(tr ? "Gönderim Ayarı" : "Send Settings")</div>
                </div>
                <div class="pika-sol-mock-row">
                    <div class="pika-sol-mock-block wide"><i class="ri-bar-chart-box-line"></i> @(tr ? "Performans Özeti" : "Performance Summary")</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Değer Kutuları -->
<section class="pika-sol-section">
    <div class="container">
        <div class="pika-sol-value-grid">
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500">
                <div class="pika-sol-value-icon"><i class="ri-palette-line"></i></div>
                <h4>@(tr ? "Kodsuz Kolay Tasarım" : "No-Code Design")</h4>
                <p>@(tr ? "Görsel e-posta editörü ile teknik bilgi gerektirmeden profesyonel mail içerikleri hazırlayın." : "Create professional email content without technical knowledge using the visual email editor.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="100">
                <div class="pika-sol-value-icon"><i class="ri-user-heart-line"></i></div>
                <h4>@(tr ? "Gelişmiş Kişiselleştirme" : "Advanced Personalization")</h4>
                <p>@(tr ? "Müşterilerinize özel teklifler ve doğrudan ilgi alanlarına hitap eden içerikler sunun." : "Offer customized deals and content directly appealing to your customers' interests.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="200">
                <div class="pika-sol-value-icon"><i class="ri-focus-3-line"></i></div>
                <h4>@(tr ? "Segmentasyon ve Hedefleme" : "Segmentation & Targeting")</h4>
                <p>@(tr ? "Doğru e-posta kampanyasını en uygun hedef kitleye, doğru segmente ulaştırın." : "Deliver the right email campaign to the most suitable target audience and correct segment.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="300">
                <div class="pika-sol-value-icon"><i class="ri-bar-chart-box-line"></i></div>
                <h4>@(tr ? "Ölçülebilir E-posta Raporları" : "Measurable Email Reports")</h4>
                <p>@(tr ? "Açılma oranları, tıklamalar ve etkileşim performansını detaylı analiz edin." : "Analyze open rates, clicks, and engagement performance in detail.")</p>
            </div>
        </div>
    </div>
</section>

<!-- Ne Yapabilirsiniz? -->
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "E-posta pazarlamasını operasyonel yük olmaktan çıkarın" : "Take email marketing beyond an operational burden")</h2>
        <p class="pika-sol-section-desc" data-aos="fade-up" data-aos-delay="100">@(tr ? "Pika platformu sayesinde mail listesi yönetme, kampanya tasarımı, segmentasyon ve pazarlama otomasyonu süreçlerinizi tek merkezde verimli kılın." : "With the Pika platform, efficiently centralize mailing list management, campaign design, segmentation, and marketing automation processes.")</p>
        <div class="pika-sol-card-grid">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-megaphone-line"></i></div>
                <h4>@(tr ? "Özel Kampanya E-postaları" : "Custom Campaign Emails")</h4>
                <p>@(tr ? "Duyurular, dönemsel indirimler ve lansmanlar için etkili toplu mail gönderimleri planlayın." : "Plan effective bulk mass mailings for announcements, seasonal discounts, and launches.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-loop-right-line"></i></div>
                <h4>@(tr ? "Otomatik Email Pazarlama" : "Automated Email Marketing")</h4>
                <p>@(tr ? "Hoş geldin mesajları, doğum günü teklifleri ve sepet hatırlatmaları gibi otomasyonlar kurun." : "Set up automations like welcome messages, birthday offers, and cart abandonment reminders.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-refresh-line"></i></div>
                <h4>@(tr ? "Yeniden Kazanım Stratejileri" : "Win-Back Strategies")</h4>
                <p>@(tr ? "Hareketsiz kullanıcıları hedefleyen stratejik etkileşim senaryolarıyla dönüşümü artırın." : "Increase conversions with strategic engagement scenarios targeting inactive users.")</p>
            </div>
        </div>
    </div>
</section>

<!-- Özellikler / Capability Grid -->
<section class="pika-sol-section" id="features">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Başarılı bir email marketing için gereken tüm yetenekler" : "All the capabilities needed for successful email marketing")</h2>
        <div class="pika-sol-card-grid">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-drag-move-line"></i></div>
                <h4>@(tr ? "Sürükle Bırak Editör (Drag & Drop)" : "Drag & Drop Editor")</h4>
                <p>@(tr ? "Tasarım ajansına veya teknik ekibe bağımlı olmadan saniyeler içinde şablonlar oluşturun." : "Create templates in seconds without depending on a design agency or tech team.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-user-settings-line"></i></div>
                <h4>@(tr ? "Dinamik İçerik Alanları" : "Dynamic Content Fields")</h4>
                <p>@(tr ? "Alıcının adına, işlem geçmişine veya satın alma alışkanlıklarına göre değişen bloklar kullanın." : "Use dynamic blocks changing based on recipient name, transaction history, or buying habits.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-focus-3-line"></i></div>
                <h4>@(tr ? "Aksiyon ve İşlem Bazlı Hedefleme" : "Action & Event-Based Targeting")</h4>
                <p>@(tr ? "Davranışsal müşteri segmentleri yaratarak dönüşüm oranları yüksek mail bültenleri atın." : "Send high-conversion newsletters by creating behavioral customer segments.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-time-line"></i></div>
                <h4>@(tr ? "Zamanlanmış ve Anlık Gönderim" : "Scheduled & Instant Delivery")</h4>
                <p>@(tr ? "Bültenlerinizi en yüksek açılma oranına ulaşacak saatlere planlayın veya anında tetikleyin." : "Schedule newsletters for highest open rate times or trigger them instantly.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-route-line"></i></div>
                <h4>@(tr ? "Customer Journey Entegrasyonu" : "Customer Journey Integration")</h4>
                <p>@(tr ? "Çok kanallı pazarlama; email bildirimlerini müşteri yolculuğunun ayrılmaz bir parçası yapın." : "Multichannel marketing; make email notifications an integral part of the customer journey.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-line-chart-line"></i></div>
                <h4>@(tr ? "Kapsamlı Karar Destek Raporlaması" : "Comprehensive Analytics Reporting")</h4>
                <p>@(tr ? "E-posta açılma (open rate), tıklanma (CTR) ve genel kampanya ROI analizlerini şeffaf şekilde izleyin." : "Transparently track email open rates, CTR, and overall campaign ROI analysis.")</p>
            </div>
        </div>
    </div>
</section>

<!-- Kullanım Senaryoları -->
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Pika Email Pazarlama aracı ile örnek kullanım senaryoları" : "Example use cases with the Pika Email Marketing tool")</h2>
        <div class="pika-sol-usecase-grid">
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="50"><i class="ri-check-line"></i> @(tr ? "E-ticaret sepet terk etme hatırlatmaları" : "E-commerce cart abandonment reminders")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="100"><i class="ri-check-line"></i> @(tr ? "Kişiye özel doğum günü kutlama ve hediye kuponları" : "Personalized birthday greeting & gift coupons")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="150"><i class="ri-check-line"></i> @(tr ? "Tüketim ürünleri için periyodik yeniden satın alma bildirimleri" : "Periodic repurchase notifications for consumer goods")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="200"><i class="ri-check-line"></i> @(tr ? "Önceki alışverişlere göre çapraz satış (cross-sell) mailleri" : "Cross-sell emails based on past purchases")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="250"><i class="ri-check-line"></i> @(tr ? "VIP müşteri segmentlerine özel öncelikli indirim duyuruları" : "Exclusive priority discount announcements for VIP segments")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="300"><i class="ri-check-line"></i> @(tr ? "Yeni aboneler için otomatik karşılama serileri (nurture)" : "Automated welcome series (nurture) for new subscribers")</div>
        </div>
    </div>
</section>

<!-- Nasıl Çalışır? -->
<section class="pika-sol-section">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Email kampanyalarınızı yapılandırmanın en hızlı yolu" : "The fastest way to configure your email campaigns")</h2>
        <div class="pika-sol-steps">
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="100"><div class="pika-sol-step-num"></div><p>@(tr ? "Kitlenizi ve hedef e-posta segmentinizi saniyeler içinde belirleyin" : "Determine your audience and target email segment in seconds")</p></div>
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="200"><div class="pika-sol-step-num"></div><p>@(tr ? "Pika email şablonlarıyla veya AI desteğiyle içeriğinizi oluşturun" : "Create your content with Pika email templates or AI support")</p></div>
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="300"><div class="pika-sol-step-num"></div><p>@(tr ? "İdeal gönderim tarihini ayarlayın ya da kullanıcı aksiyonuyla tetikleyin" : "Set the ideal delivery date or trigger by user action")</p></div>
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="400"><div class="pika-sol-step-num"></div><p>@(tr ? "Kampanya analizlerinde veri takibi yapın ve bir sonraki adıma hazırlanın" : "Track data in campaign analytics and prepare for the next step")</p></div>
        </div>
    </div>
</section>

<!-- Kişiselleştirme ve Veri -->
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container" data-aos="fade-up">
        <div class="pika-sol-highlight">
            <h3>@(tr ? "Gelen kutusunda dikkat çekin: E-postalarınızı doğru kişiye optimize edin" : "Stand out in the inbox: Optimize your emails for the right person")</h3>
            <p>@(tr ? "Pika, basit bülten gönderimlerinin ötesine geçer. Sadece bir 'mailing list' sistemi değil; işlem (transaction), alışkanlık ve profil verilerini analiz ederek en alakalı email kampanyalarını oluşturmanızı destekleyen bir iletişim orkestrasyonudur." : "Pika goes beyond simple newsletter mass sends. It is not just a 'mailing list' system; it's a communication orchestration that supports creating the most relevant email campaigns by analyzing transaction, habit, and profile data.")</p>
            <p class="mt-3"><strong>@(tr ? "Özensiz ve alakasız mailler yerine, kullanıcı beklentilerine hizalanan ve dönüşüm garantileyen e-posta pazarlama stratejilerine geçiş yapın." : "Switch to email marketing strategies aligned with user expectations ensuring conversions instead of careless and irrelevant emails.")</strong></p>
        </div>
    </div>
</section>

<!-- AI Alanı -->
<section class="pika-sol-section">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Yapay zeka asistanı ile e-posta metin üretimini hızlandırın" : "Accelerate email copywriting with AI assistant")</h2>
        <p class="pika-sol-section-desc" data-aos="fade-up" data-aos-delay="100">@(tr ? "Email konu satırından kampanya metnine uzanan geniş süreçte yapay zeka gücüyle üretkenliğinizi ikiye katlayın." : "Double your productivity with the power of artificial intelligence across the broad process from email subject line to campaign text.")</p>
        <div class="pika-sol-highlight-items" data-aos="fade-up" data-aos-delay="200">
            <span class="pika-sol-highlight-item"><i class="ri-lightbulb-flash-line"></i> @(tr ? "Yüksek açılma oranlı konu başlıkları" : "High open-rate subject lines")</span>
            <span class="pika-sol-highlight-item"><i class="ri-file-text-line"></i> @(tr ? "İkna edici pazarlama metni taslakları" : "Persuasive marketing copy drafts")</span>
            <span class="pika-sol-highlight-item"><i class="ri-gift-line"></i> @(tr ? "Kapsamlı özel gün kampanya fikirleri" : "Comprehensive special occasion campaign ideas")</span>
            <span class="pika-sol-highlight-item"><i class="ri-translate-2"></i> @(tr ? "Farklı segmentler için uygun ton ve dil seçenekleri" : "Appropriate tone and language options for different segments")</span>
        </div>
    </div>
</section>

<!-- Omnichannel -->
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container" data-aos="fade-up">
        <div class="pika-sol-omni">
            <h2 class="pika-sol-section-title">@(tr ? "E-posta pazarlamasını Omnichannel zincirine dahil edin" : "Integrate email marketing into the Omnichannel chain")</h2>
            <p class="pika-sol-section-desc" style="margin-left:auto;margin-right:auto">@(tr ? "SMS, WhatsApp ve Push Notifications ile koordine çalışan bütünleşik formüller kurgulayarak müşteri devamliliğini koruyun." : "Maintain customer retention by constructing integrated formulas that work coordinatedly with SMS, WhatsApp, and Push Notifications.")</p>
            <div class="pika-sol-omni-icons">
                <div class="pika-sol-omni-icon" style="background:#fff3e0;color:#f57c00"><i class="ri-mail-line"></i></div>
                <div class="pika-sol-omni-icon" style="background:#e3f2fd;color:#1976d2"><i class="ri-message-2-line"></i></div>
                <div class="pika-sol-omni-icon" style="background:#dcf8c6;color:#25d366"><i class="ri-whatsapp-line"></i></div>
                <div class="pika-sol-omni-icon" style="background:#fce4ec;color:#e91e63"><i class="ri-notification-3-line"></i></div>
            </div>
        </div>
    </div>
</section>

<!-- Kapanış CTA -->
<section class="pika-sol-cta-section">
    <div class="container" data-aos="fade-up">
        <h2>@(tr ? "Email Marketing süreçlerinizi maksimum potansiyele ulaştırın" : "Unlock the maximum potential of your Email Marketing processes")</h2>
        <p>@(tr ? "Pika Email Pazarlama yazılımı ile tasarım şablonlarından hedef kitle yönetimine ve performansa dayalı otomasyona kadar tüm döngüyü merkeze alın." : "Centralize the entire lifecycle from design templates to audience management and performance-based automation with Pika Email Marketing software.")</p>
        <div class="pika-sol-cta-actions">
            <button type="button" class="btn pika-btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i></button>
            <a href="@Url.Action("Contact", "Home")" class="btn pika-btn-ghost px-4 py-2">@(tr ? "Özel Danışmanlık İçin Bize Ulaşın" : "Contact Us for Consultation")</a>
        </div>
    </div>
</section>

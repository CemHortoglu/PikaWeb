@{
    var tr = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = tr ? "Content Studio | Pika ile Kampanya İçeriği ve Tasarım Yönetimi" : "Content Studio | Campaign Content & Design Management with Pika";
    ViewData["MetaDescription"] = tr ? "Pika Content Studio ile email içerikleri tasarlayın, kampanya metinleri üretin, AI desteğiyle içerik hazırlığını hızlandırın." : "Design email content, generate campaign copy and accelerate content preparation with AI support using Pika Content Studio.";
    ViewData["MetaKeywords"] = "content studio,içerik tasarım,email builder,AI içerik,kampanya içeriği,sürükle bırak tasarım,pika";
}

<!-- HERO: Creative Studio -->
<section class="pika-sol-hero" data-module="content">
    <div class="container">
        <nav class="pika-sol-breadcrumb" data-aos="fade-down" data-aos-duration="500">
            <a href="@(tr ? "/" : "/en/")">@(tr ? "Ana Sayfa" : "Home")</a>
            <span class="sep">/</span>
            <a href="@(tr ? "/" : "/en/")">@(tr ? "Çözümler" : "Solutions")</a>
            <span class="sep">/</span>
            <span>Content Studio</span>
        </nav>
        <div class="pika-sol-hero-grid">
            <div data-aos="fade-right" data-aos-duration="700">
                <h1>@(tr ? "Kampanya içeriğini daha hızlı ve daha etkili üretin" : "Create campaign content faster and more effectively")</h1>
                <p class="pika-sol-hero-desc">@(tr ? "Pika Content Studio; sürükle bırak tasarım, kampanya metni üretimi, kişiselleştirilmiş içerik alanları ve AI desteği ile içerik hazırlık süreçlerini hızlandırır." : "Pika Content Studio accelerates content preparation with drag-and-drop design, campaign copy generation, personalized content fields and AI support.")</p>
                <div class="pika-sol-hero-actions">
                    <button type="button" class="btn pika-btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i></button>
                    <a href="#features" class="btn pika-btn-ghost px-4 py-2">@(tr ? "Content Studio'yu İncele" : "Explore Content Studio")</a>
                </div>
                <div class="pika-sol-hero-tags">
                    <span class="pika-sol-tag"><i class="ri-drag-move-line"></i> @(tr ? "Sürükle bırak" : "Drag & drop")</span>
                    <span class="pika-sol-tag"><i class="ri-sparkling-line"></i> @(tr ? "AI destekli" : "AI-powered")</span>
                    <span class="pika-sol-tag"><i class="ri-user-heart-line"></i> @(tr ? "Kişiselleştirme" : "Personalization")</span>
                    <span class="pika-sol-tag"><i class="ri-rocket-line"></i> @(tr ? "Hızlı hazırlık" : "Fast preparation")</span>
                </div>
            </div>
            <div class="pika-sol-hero-scene" data-aos="fade-left" data-aos-duration="700" data-aos-delay="200">
                <div class="pika-sol-scene-main">
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block wide"><i class="ri-mail-line"></i> @(tr ? "Email Builder" : "Email Builder")</div>
                        <div class="pika-sol-scene-block"><i class="ri-edit-line"></i> @(tr ? "Metin" : "Text")</div>
                    </div>
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block"><i class="ri-sparkling-line"></i> AI Prompt</div>
                        <div class="pika-sol-scene-block"><i class="ri-eye-line"></i> @(tr ? "Önizleme" : "Preview")</div>
                    </div>
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block wide"><i class="ri-file-copy-2-line"></i> @(tr ? "Şablonlar" : "Templates")</div>
                    </div>
                </div>
                <div class="pika-sol-scene-back">
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block"><i class="ri-image-line"></i> @(tr ? "Medya" : "Media")</div>
                        <div class="pika-sol-scene-block"><i class="ri-layout-grid-line"></i> @(tr ? "Bloklar" : "Blocks")</div>
                    </div>
                </div>
                <div class="pika-sol-scene-float" style="bottom:18%;left:-10%"><i class="ri-sparkling-line"></i> @(tr ? "AI üretim aktif" : "AI generation active")</div>
                <div class="pika-sol-scene-float" style="top:8%;right:-6%"><i class="ri-drag-move-line"></i> @(tr ? "Sürükle bırak" : "Drag & drop")</div>
                <div class="pika-sol-scene-float" style="bottom:3%;right:8%"><i class="ri-user-heart-line"></i> {{isim}}</div>
            </div>
        </div>
    </div>
</section>

<!-- STICKY SUBNAV -->
<div class="pika-sol-subnav-wrap">
    <div class="container">
        <nav class="pika-sol-subnav">
            <a href="#overview">@(tr ? "Genel Bakış" : "Overview")</a>
            <a href="#features">@(tr ? "Özellikler" : "Features")</a>
            <a href="#showcase">@(tr ? "Editor Canvas" : "Editor Canvas")</a>
            <a href="#usecases">@(tr ? "Kullanım Senaryoları" : "Use Cases")</a>
            <a href="#platform">@(tr ? "Entegrasyon" : "Integration")</a>
            <a href="#faq">SSS / FAQ</a>
        </nav>
    </div>
</div>

<!-- TRUST STRIP -->
<section class="pika-sol-section" id="overview">
    <div class="container">
        <div class="pika-sol-trust-strip" data-aos="fade-up">
            <div class="pika-sol-trust-item"><i class="ri-drag-move-line"></i><span>@(tr ? "Sürükle bırak" : "Drag & drop")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-sparkling-line"></i><span>@(tr ? "AI içerik" : "AI content")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-file-copy-2-line"></i><span>@(tr ? "Şablonlar" : "Templates")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-user-heart-line"></i><span>@(tr ? "Kişiselleştirme" : "Personalization")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-eye-line"></i><span>@(tr ? "Canlı önizleme" : "Live preview")</span></div>
        </div>
    </div>
</section>

<!-- SHOWCASE: Editor Canvas + AI Panel -->
<section class="pika-sol-section pika-sol-section-alt" id="showcase">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "İçerik editörü: tasarlayın, üretin, yayınlayın" : "Content editor: design, generate, publish")</h2>
        <div class="pika-sol-showcase" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-showcase-screen">
                <div class="pika-sol-showcase-panel">
                    <div class="pika-sol-showcase-panel-title"><i class="ri-mail-line"></i> @(tr ? "Tasarım Alanı" : "Design Area")</div>
                    <div class="pika-sol-showcase-mock-bar w80"></div>
                    <div class="pika-sol-showcase-mock-bar w60"></div>
                    <div class="pika-sol-showcase-mock-bar w70"></div>
                    <div class="pika-sol-showcase-mock-bar w45"></div>
                </div>
                <div class="pika-sol-showcase-panel">
                    <div class="pika-sol-showcase-panel-title"><i class="ri-sparkling-line"></i> @(tr ? "AI Asistan" : "AI Assistant")</div>
                    <div class="pika-sol-showcase-mock-bar w70"></div>
                    <div class="pika-sol-showcase-mock-bar w80"></div>
                    <div class="pika-sol-showcase-mock-bar w60"></div>
                </div>
            </div>
            <div class="pika-sol-showcase-annotations">
                <div class="pika-sol-annotation"><i class="ri-layout-grid-line"></i> @(tr ? "Modüler bloklar" : "Modular blocks")</div>
                <div class="pika-sol-annotation"><i class="ri-sparkling-line"></i> @(tr ? "AI metin üretimi" : "AI text generation")</div>
                <div class="pika-sol-annotation"><i class="ri-user-heart-line"></i> @(tr ? "Kişiselleştirme alanı" : "Personalization field")</div>
                <div class="pika-sol-annotation"><i class="ri-eye-line"></i> @(tr ? "Canlı önizleme" : "Live preview")</div>
            </div>
        </div>
    </div>
</section>

<!-- PROBLEM/SOLUTION -->
<section class="pika-sol-section">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "İçerik süreçlerini hızlandırın" : "Accelerate content processes")</h2>
        <div class="pika-sol-problem-grid" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-problem-card pika-sol-problem-card--problem"><i class="ri-error-warning-line"></i> @(tr ? "İçerik hazırlığı çok uzun sürüyor" : "Content preparation takes too long")</div>
            <div class="pika-sol-problem-card pika-sol-problem-card--solution"><i class="ri-check-double-line"></i> @(tr ? "Şablon ve AI ile dakikalar içinde hazır" : "Ready in minutes with templates and AI")</div>
            <div class="pika-sol-problem-card pika-sol-problem-card--problem"><i class="ri-error-warning-line"></i> @(tr ? "Tasarım için dış araç bağımlılığı" : "Dependency on external tools for design")</div>
            <div class="pika-sol-problem-card pika-sol-problem-card--solution"><i class="ri-check-double-line"></i> @(tr ? "Entegre sürükle bırak editör" : "Integrated drag & drop editor")</div>
        </div>
    </div>
</section>

<!-- CORE CAPABILITIES -->
<section class="pika-sol-section pika-sol-section-alt" id="features">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "İçerik üretimi için temel yetenekler" : "Core capabilities for content creation")</h2>
        <div class="pika-sol-card-grid">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-drag-move-line"></i></div>
                <h4>@(tr ? "Sürükle bırak email builder" : "Drag & drop email builder")</h4>
                <p>@(tr ? "Kod yazmadan profesyonel email tasarlayın." : "Design professional emails without writing code.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-sparkling-line"></i></div>
                <h4>@(tr ? "AI destekli metin üretimi" : "AI-powered text generation")</h4>
                <p>@(tr ? "Kampanya metinlerini AI ile hızla oluşturun." : "Generate campaign copy quickly with AI.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-user-heart-line"></i></div>
                <h4>@(tr ? "Kişiselleştirme alanları" : "Personalization fields")</h4>
                <p>@(tr ? "Dinamik içerik alanlarıyla her alıcıya özel mesaj." : "Custom messages for each recipient with dynamic fields.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-file-copy-2-line"></i></div>
                <h4>@(tr ? "Hazır şablonlar" : "Ready-made templates")</h4>
                <p>@(tr ? "Şablonlarla içerik sürecini hızlandırın." : "Speed up content workflow with templates.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-eye-line"></i></div>
                <h4>@(tr ? "Canlı önizleme" : "Live preview")</h4>
                <p>@(tr ? "İçeriğinizi yayınlamadan önce farklı cihazlarda görün." : "Preview content on different devices before publishing.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-link"></i></div>
                <h4>@(tr ? "Kampanya entegrasyonu" : "Campaign integration")</h4>
                <p>@(tr ? "İçerikleri doğrudan kampanyalara bağlayın." : "Connect content directly to campaigns.")</p>
            </div>
        </div>
    </div>
</section>

<!-- WORKFLOW -->
<section class="pika-sol-section">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "İçerik üretim süreci" : "Content creation process")</h2>
        <div class="pika-sol-workflow-steps" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-workflow-step">
                <div class="pika-sol-workflow-num">1</div>
                <h5>@(tr ? "Şablon veya Boş Sayfa" : "Template or Blank")</h5>
                <p>@(tr ? "Hazır şablondan veya sıfırdan başlayın." : "Start from a template or from scratch.")</p>
            </div>
            <div class="pika-sol-workflow-step">
                <div class="pika-sol-workflow-num">2</div>
                <h5>@(tr ? "Tasarlayın" : "Design")</h5>
                <p>@(tr ? "Sürükle bırak ile blokları yerleştirin." : "Place blocks with drag and drop.")</p>
            </div>
            <div class="pika-sol-workflow-step">
                <div class="pika-sol-workflow-num">3</div>
                <h5>@(tr ? "AI ile Yazın" : "Write with AI")</h5>
                <p>@(tr ? "AI asistanla kampanya metnini üretin." : "Generate campaign copy with AI assistant.")</p>
            </div>
            <div class="pika-sol-workflow-step">
                <div class="pika-sol-workflow-num">4</div>
                <h5>@(tr ? "Önizleyin ve Kaydedin" : "Preview & Save")</h5>
                <p>@(tr ? "Farklı cihazlarda test edin ve kampanyaya bağlayın." : "Test on different devices and connect to campaign.")</p>
            </div>
        </div>
    </div>
</section>

<!-- USE CASES -->
<section class="pika-sol-section pika-sol-section-alt" id="usecases">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Content Studio ile neler yapabilirsiniz?" : "What can you do with Content Studio?")</h2>
        <div class="pika-sol-usecase-cards">
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="50">
                <div class="pika-sol-usecase-card-icon"><i class="ri-mail-line"></i></div>
                <span class="usecase-industry">@(tr ? "Tüm Sektörler" : "All Industries")</span>
                <h5>@(tr ? "Profesyonel Email Tasarımı" : "Professional Email Design")</h5>
                <p>@(tr ? "Sürükle bırak ile kurumsal email oluşturma." : "Create corporate emails with drag and drop.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-usecase-card-icon"><i class="ri-sparkling-line"></i></div>
                <span class="usecase-industry">@(tr ? "Pazarlama" : "Marketing")</span>
                <h5>@(tr ? "AI ile Hızlı Metin Üretimi" : "Quick Copy with AI")</h5>
                <p>@(tr ? "Kampanya metinlerini AI desteğiyle saniyeler içinde oluşturun." : "Generate campaign copy in seconds with AI support.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="150">
                <div class="pika-sol-usecase-card-icon"><i class="ri-user-heart-line"></i></div>
                <span class="usecase-industry">@(tr ? "E-ticaret" : "E-commerce")</span>
                <h5>@(tr ? "Kişiselleştirilmiş İçerik" : "Personalized Content")</h5>
                <p>@(tr ? "Dinamik alanlarla her müşteriye özel email." : "Personalized emails for each customer with dynamic fields.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-usecase-card-icon"><i class="ri-file-copy-2-line"></i></div>
                <span class="usecase-industry">@(tr ? "Kurumsal" : "Enterprise")</span>
                <h5>@(tr ? "Şablon Kütüphanesi" : "Template Library")</h5>
                <p>@(tr ? "Marka uyumlu şablonlarla hız kazanın." : "Speed up with brand-consistent templates.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="250">
                <div class="pika-sol-usecase-card-icon"><i class="ri-chat-1-line"></i></div>
                <span class="usecase-industry">@(tr ? "Tüm Sektörler" : "All Industries")</span>
                <h5>@(tr ? "SMS / WhatsApp Metin Hazırlığı" : "SMS / WhatsApp Copy")</h5>
                <p>@(tr ? "Kısa ve etkili kampanya metinleri oluşturun." : "Create short and effective campaign texts.")</p>
            </div>
            <div class="pika-sol-usecase-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-usecase-card-icon"><i class="ri-smartphone-line"></i></div>
                <span class="usecase-industry">@(tr ? "Pazarlama" : "Marketing")</span>
                <h5>@(tr ? "Çoklu Cihaz Önizleme" : "Multi-Device Preview")</h5>
                <p>@(tr ? "Masaüstü ve mobilde görünümü kontrol edin." : "Check appearance on desktop and mobile.")</p>
            </div>
        </div>
    </div>
</section>

<!-- BUSINESS IMPACT -->
<section class="pika-sol-section pika-sol-section-impact">
    <div class="container">
        <h2 class="pika-sol-section-title text-center" data-aos="fade-up">@(tr ? "İş etkisi" : "Business Impact")</h2>
        <div class="pika-sol-impact-grid pika-sol-impact-grid--light" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-impact-card pika-sol-impact-card--light">
                <div class="pika-sol-impact-icon"><i class="ri-speed-line"></i></div>
                <h5>@(tr ? "İçerik hazırlık süresini kısaltır" : "Shortens content preparation time")</h5>
                <p>@(tr ? "AI ve şablonlarla dakikalar içinde kampanya içeriği." : "Campaign content in minutes with AI and templates.")</p>
            </div>
            <div class="pika-sol-impact-card pika-sol-impact-card--light">
                <div class="pika-sol-impact-icon"><i class="ri-palette-line"></i></div>
                <h5>@(tr ? "Marka tutarlılığını korur" : "Maintains brand consistency")</h5>
                <p>@(tr ? "Şablonlar ve blok sistemiyle kurumsal uyum." : "Corporate consistency with templates and block system.")</p>
            </div>
            <div class="pika-sol-impact-card pika-sol-impact-card--light">
                <div class="pika-sol-impact-icon"><i class="ri-user-heart-line"></i></div>
                <h5>@(tr ? "Kişiselleştirme ile etkileşimi artırır" : "Increases engagement with personalization")</h5>
                <p>@(tr ? "Dinamik içeriklerle daha yüksek açılma oranı." : "Higher open rates with dynamic content.")</p>
            </div>
        </div>
    </div>
</section>

<!-- PLATFORM MAP -->
<section class="pika-sol-section" id="platform">
    <div class="container">
        <h2 class="pika-sol-section-title text-center" data-aos="fade-up">@(tr ? "Content Studio, Pika platformunda nasıl konumlanır?" : "How does Content Studio fit in the Pika platform?")</h2>
        <div class="pika-sol-platform-map" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-platform-satellites">
                <a class="pika-sol-platform-node" href="@Url.Action("CampaignManager", "Solutions")"><i class="ri-megaphone-line"></i> Campaign Manager</a>
                <a class="pika-sol-platform-node" href="@Url.Action("JourneyManager", "Solutions")"><i class="ri-route-line"></i> Journey Manager</a>
            </div>
            <div class="pika-sol-platform-connector"></div>
            <div class="pika-sol-platform-center"><i class="ri-edit-line"></i> Content Studio</div>
            <div class="pika-sol-platform-connector"></div>
            <div class="pika-sol-platform-satellites">
                <a class="pika-sol-platform-node" href="@Url.Action("AudienceManager", "Solutions")"><i class="ri-focus-3-line"></i> Audience Manager</a>
            </div>
        </div>
    </div>
</section>

<!-- FAQ -->
<section class="pika-sol-section pika-sol-section-alt" id="faq">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Content Studio hakkında sık sorulan sorular" : "Content Studio FAQs")</h2>
        <div class="accordion faq-pro-accordion" id="contentFaq">
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#contentFaq1" aria-expanded="true" aria-controls="contentFaq1">@(tr ? "Email tasarlamak için teknik bilgi gerekiyor mu?" : "Is technical knowledge required to design emails?")</button></h2>
                <div id="contentFaq1" class="accordion-collapse collapse show" data-bs-parent="#contentFaq"><div class="accordion-body">@(tr ? "Hayır. Sürükle bırak editör ile kod yazmadan profesyonel email tasarlayabilirsiniz." : "No. You can design professional emails without writing code using the drag & drop editor.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#contentFaq2" aria-expanded="false" aria-controls="contentFaq2">@(tr ? "AI hangi içerik türlerini destekliyor?" : "What content types does AI support?")</button></h2>
                <div id="contentFaq2" class="accordion-collapse collapse" data-bs-parent="#contentFaq"><div class="accordion-body">@(tr ? "Email başlığı, kampanya metni, SMS ve WhatsApp mesajları gibi içerik türlerini AI ile oluşturabilirsiniz." : "You can generate email subjects, campaign copy, SMS and WhatsApp messages with AI.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#contentFaq3" aria-expanded="false" aria-controls="contentFaq3">@(tr ? "Kişiselleştirme alanları nedir?" : "What are personalization fields?")</button></h2>
                <div id="contentFaq3" class="accordion-collapse collapse" data-bs-parent="#contentFaq"><div class="accordion-body">@(tr ? "Müşteri adı, şehir, son satın alma gibi bilgileri içeriğe dinamik olarak ekleyen alanlardır." : "Fields that dynamically insert customer name, city, last purchase and similar data into content.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#contentFaq4" aria-expanded="false" aria-controls="contentFaq4">@(tr ? "Şablonlar kullanılabilir mi?" : "Can templates be used?")</button></h2>
                <div id="contentFaq4" class="accordion-collapse collapse" data-bs-parent="#contentFaq"><div class="accordion-body">@(tr ? "Evet. Hazır şablonlardan başlayabilir veya kendi şablonlarınızı oluşturabilirsiniz." : "Yes. You can start from ready-made templates or create your own.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#contentFaq5" aria-expanded="false" aria-controls="contentFaq5">@(tr ? "İçerikler kampanyaya nasıl bağlanır?" : "How are contents connected to campaigns?")</button></h2>
                <div id="contentFaq5" class="accordion-collapse collapse" data-bs-parent="#contentFaq"><div class="accordion-body">@(tr ? "Content Studio'da hazırladığınız içerikleri doğrudan Campaign Manager kampanyalarına bağlayabilirsiniz." : "You can connect content prepared in Content Studio directly to Campaign Manager campaigns.")</div></div>
            </div>
        </div>
    </div>
</section>


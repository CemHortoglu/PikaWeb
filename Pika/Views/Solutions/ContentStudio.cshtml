@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]="Content Studio | "+(tr?"İçerik ve Şablonlar":"Content & Templates");
    ViewData["MetaDescription"]=tr?"Pika Content Studio ile Campaign ve Journey iletişim içeriklerini editör, yeniden kullanılabilir şablon ve Store yaklaşımıyla hazırlayın; Pika AI'yı kontrollü taslak desteği için kullanın.":"Use Pika Content Studio to prepare Campaign and Journey content with an editor, reusable templates and Store workflows, using Pika AI for controlled drafting assistance.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">Platform · Content Studio</span><h1>@(tr?"İçerik hazırlığını kampanya operasyonundan koparmayın.":"Keep content creation connected to campaign operations.")</h1><p>@(tr?"Content Studio; Campaign ve Journey içinde kullanılacak iletişim içeriklerini hazırlama, düzenleme, şablonlaştırma ve yeniden kullanma işini tek üretim alanında toplar. Amaç her kampanyada sıfırdan başlamak değil; marka dili, ekip standardı ve yayınlama bağlamını koruyan tekrarlanabilir bir içerik operasyonu kurmaktır.":"Content Studio brings content creation, editing, templating and reuse for Campaign and Journey into one production workspace. The goal is repeatable content operations that preserve brand language, team standards and publishing context.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Content Studio'yu Canlı Görün":"See Content Studio Live")</button><a class="pk-btn pk-btn-ghost" href="/wiki/icerik-studyosu-ve-gorsel-yonetimi">@(tr?"İçerik rehberi":"Content guide")</a></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_email-template-editor_17.png" alt="@(tr?"Pika içerik ve email template editörü":"Pika content and email template editor")" width="1200" height="760" /><div class="pk-stage-caption"><strong>Content Studio</strong><span>@(tr?"Düzenle · Önizle · Şablonlaştır · Yeniden kullan":"Edit · Preview · Template · Reuse")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-layout-4-line"></i><div><strong>@(tr?"Editör":"Editor")</strong><small>@(tr?"İçeriği görsel hazırlayın":"Build content visually")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-store-2-line"></i><div><strong>Store</strong><small>@(tr?"Tekrar kullanılabilir içerik":"Reusable content")</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-sparkling-line"></i><div><strong>Pika AI</strong><small>@(tr?"Kontrollü taslak desteği":"Controlled drafting support")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Tanım":"Definition")</span><h2>@(tr?"Content Studio nedir?":"What is Content Studio?")</h2></div><p class="pk-lead">@(tr?"Content Studio, Pika'daki kampanya ve Journey içeriklerinin hazırlanması, önizlenmesi, şablonlaştırılması ve tekrar kullanılmasına yönelik içerik çalışma alanıdır. Hedef kitle veya izin kararını vermez; hazırlanmış içeriği ilgili Campaign/Journey yürütme bağlamına taşır.":"Content Studio is Pika's workspace for preparing, previewing, templating and reusing Campaign and Journey content. It does not decide audience or consent; prepared content is used within the relevant Campaign/Journey execution context.")</p></div><div class="pk-intel-grid"><article class="pk-intel-panel"><span class="pk-intel-number">01</span><div class="pk-intel-icon"><i class="ri-layout-4-line"></i></div><h3>@(tr?"Editör":"Editor")</h3><p>@(tr?"Desteklenen içerik bileşenleriyle iletişim içeriğini hazırlayın, düzenleyin ve önizleyin. Tasarım ile kampanya operasyonunun aynı ürün bağlamında kalmasını sağlayın." : "Prepare, edit and preview communication content with supported components while keeping design connected to campaign operations.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">02</span><div class="pk-intel-icon"><i class="ri-file-copy-2-line"></i></div><h3>@(tr?"Şablonlar":"Templates")</h3><p>@(tr?"Tekrarlanan iyi içerik yapısını kişisel bilgi olarak bırakmayın; ekip içinde yeniden kullanılabilir şablonlara dönüştürün." : "Turn recurring good content patterns into reusable team templates instead of individual knowledge.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">03</span><div class="pk-intel-icon"><i class="ri-store-2-line"></i></div><h3>Store</h3><p>@(tr?"Email ve Journey Store gibi hazır yapılarla doğrulanmış üretim kalıplarını daha hızlı devreye alın; son hedef kitle ve yayınlama kararını yine ilgili operasyon bağlamında verin." : "Use reusable Email and Journey Store patterns to accelerate preparation while keeping final audience and publishing decisions in the relevant operation.")</p></article></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"İçerik üretimi":"Content production")</span><h2>@(tr?"Editör yalnız tasarım aracı değil, kampanya üretim zincirinin bir parçası.":"The editor is part of the campaign production chain, not just a design tool.")</h2></div><p class="pk-lead">@(tr?"İçerik, hedef kitleden ve kanaldan bağımsız bir dosya değildir. Email için hazırlanan zengin içerik, SMS'in kısa formatı veya WhatsApp'ın desteklenen mesaj/şablon bağlamı farklı üretim kararları gerektirir. Content Studio bu hazırlığı Campaign ve Journey'e bağlar.":"Content is not a file independent from audience and channel. Rich Email content, concise SMS and supported WhatsApp message/template context require different production decisions. Content Studio connects preparation to Campaign and Journey.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_email-template-editor_17.png" alt="@(tr?"Pika Email Template Editor ekranı":"Pika Email Template Editor screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Email Template Editor</small><h3>@(tr?"İçeriği hazırlayın ve önizleyin":"Prepare and preview content")</h3><p>@(tr?"Desteklenen bileşenlerle kampanya içeriğini düzenleyin; gönderim öncesinde içerik operasyonunu görünür tutun." : "Edit campaign content using supported components and keep content operations visible before execution.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_email-store_20.png" alt="Pika Email Store" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Email Store</small><h3>@(tr?"Doğrulanmış yapıları yeniden kullanın":"Reuse validated structures")</h3><p>@(tr?"Hazır yapılar kampanya hazırlığını hızlandırabilir; her kullanımda hedef kitle, teklif ve kanal bağlamı yine kontrol edilmelidir." : "Reusable structures can accelerate preparation, while audience, offer and channel context should still be reviewed for each use.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">Content + AI</span><h2>@(tr?"AI taslak üretir; marka gerçeğini ve onayı kullanıcı korur.":"AI can draft; users preserve brand truth and approval.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Pika AI müşteri/fırsat bağlamından mesaj yaklaşımı veya içerik taslağı hazırlamaya yardımcı olabilir. AI çıktısı editörde gözden geçirilebilir ve düzenlenebilir. Hesaplanmış müşteri/ürün verisi değişmemeli; marka iddiaları, teklif ve yayınlama kullanıcı kontrolünde kalmalıdır.":"Pika AI can assist with messaging approaches or content drafts from customer/opportunity context. AI output can be reviewed and edited in the content workflow. Calculated customer/product evidence should not be changed, while brand claims, offer and publishing remain under user control.")</p></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-sparkling-2-line"></i><div><strong>@(tr?"Bağlam":"Context")</strong><span>@(tr?"Müşteri, fırsat ve kampanya amacı AI'ya açıklama/taslak zemini sağlar." : "Customer, opportunity and campaign purpose provide context for AI assistance.")</span></div></div><div class="pk-control-step"><i class="ri-magic-line"></i><div><strong>@(tr?"AI taslağı":"AI draft")</strong><span>@(tr?"Mesaj çerçevesi veya içerik taslağı üretilebilir." : "A messaging frame or content draft can be generated.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-user-follow-line"></i><div><strong>@(tr?"Editör kontrolü":"Editor review")</strong><span>@(tr?"Kullanıcı metni, teklif ve marka dilini gözden geçirir; gerekiyorsa değiştirir." : "The user reviews copy, offer and brand language and edits where necessary.")</span></div></div><div class="pk-control-step"><i class="ri-route-line"></i><div><strong>Campaign / Journey</strong><span>@(tr?"Onaylanan içerik kontrollü yürütme bağlamına taşınır." : "Approved content moves into controlled execution.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Operasyon hafızası":"Operational memory")</span><h2>@(tr?"Şablon yalnız görsel tasarım değil, tekrar kullanılabilir çalışma standardıdır.":"A template is not just visual design; it is a reusable working standard.")</h2></div><p class="pk-lead">@(tr?"İyi çalışan içerik ve Journey kalıplarını Store/şablon yaklaşımıyla ekip içinde paylaşmak, operasyon kalitesini kişilere bağımlı olmaktan çıkarabilir. Ancak şablonun varlığı, her müşteriye veya her kampanyaya otomatik olarak uygun olduğu anlamına gelmez.":"Sharing effective content and Journey patterns through Store/template workflows can reduce dependence on individual knowledge. A template's existence does not mean it is automatically right for every customer or campaign.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-file-edit-line"></i><strong>@(tr?"Hazırla":"Create")</strong><span>@(tr?"İçerik veya akışı oluştur":"Build content or flow")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-eye-line"></i><strong>@(tr?"Kontrol et":"Review")</strong><span>@(tr?"İçerik ve iş bağlamını doğrula":"Validate content and business context")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-store-2-line"></i><strong>@(tr?"Şablonlaştır":"Template")</strong><span>@(tr?"Tekrar kullanılabilir yapıya dönüştür":"Turn into a reusable pattern")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-group-line"></i><strong>@(tr?"Paylaş":"Reuse")</strong><span>@(tr?"Ekip içinde yeniden kullan":"Reuse across the team")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-settings-4-line"></i><strong>@(tr?"Uyarlayın":"Adapt")</strong><span>@(tr?"Kitle ve kampanyaya göre düzenle":"Adjust for audience and campaign")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-send-plane-line"></i><strong>@(tr?"Yayınlayın":"Publish")</strong><span>@(tr?"İlgili Campaign/Journey kontrolünde":"Under Campaign/Journey control")</span></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Nereye bağlanır?":"Where does it connect?")</span><h2>@(tr?"İçerik üretimi, Pika'nın aksiyon zincirinin bir aşamasıdır.":"Content production is one step in Pika's action chain.")</h2></div><p class="pk-lead">@(tr?"Fırsat veya hedef kitle bağlamı içerik ihtiyacını doğurur; Content Studio mesajı hazırlar; Campaign veya Journey yürütür; kanallar teslimat katmanını sağlar; Analytics sonucu değerlendirir.":"Opportunity or audience context creates the need for communication; Content Studio prepares the message; Campaign or Journey executes it; channels deliver it; Analytics reviews the outcome.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Fırsat":"Opportunity")</strong><span>@(tr?"Neden iletişim?":"Why communicate?")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-group-line"></i><strong>Audience</strong><span>@(tr?"Kime?":"Who?")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-file-edit-line"></i><strong>Content Studio</strong><span>@(tr?"Ne söyleyeceğiz?":"What will we say?")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-shield-check-line"></i><strong>@(tr?"Uygunluk":"Eligibility")</strong><span>@(tr?"İzin ve kanal":"Consent and channel")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-route-line"></i><strong>Campaign / Journey</strong><span>@(tr?"Kontrollü yürütme":"Controlled execution")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>Analytics</strong><span>@(tr?"Sonuç":"Outcome")</span></div></div><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/campaign-manager":"/en/platform/campaign-manager")">Campaign Manager</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/ai-kampanya-asistani":"/en/platform/ai-campaign-assistant")">Pika AI</a></div></div></section>

@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-solutions-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-content-studio-page.css" asp-append-version="true" />
}

@* ── 01 HERO ─────────────────────────────────────────────────── *@
<section class="inner-hero inner-hero--content">
    <div class="inner-hero-grid-overlay" aria-hidden="true"></div>
    <div class="inner-hero-orbit" aria-hidden="true"></div>
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span>/</span>
                <span>Content Studio</span>
            </nav>
            <div class="inner-eyebrow"><span></span>CONTENT STUDIO</div>
            @if (tr)
            {
                <h1>
                    İçeriği koddan değil,<br />
                    iletişim amacından başlayarak hazırlayın.
                </h1>
                <p>
                    Pika Content Studio; sürükle-bırak email düzenini, modüler içerik bloklarını, şablonları, kişiselleştirme alanlarını ve önizlemeyi aynı içerik hazırlama ortamında bir araya getirir.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.72);font-size:15px;margin-bottom:30px">
                    Amaç tasarım aracını kampanya sürecinden ayırmak değil; hazırlanmış içeriği Campaign Manager ve Journey Manager gibi aksiyon katmanlarında yeniden kullanılabilir hale getirmektir.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Demo Talep Et ↗
                    </button>
                    <a class="inner-secondary" href="/cozumler/campaign-manager">
                        Campaign Manager'ı Keşfedin →
                    </a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="İçeriğe atla">
                        <i class="ri-arrow-down-line" aria-hidden="true"></i>
                    </a>
                </div>
            }
            else
            {
                <h1>
                    Start content preparation<br />
                    with the communication objective,<br />
                    not with code.
                </h1>
                <p>
                    Pika Content Studio brings drag-and-drop email composition, modular content blocks, templates, personalization fields and preview into the same content-preparation environment.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.72);font-size:15px;margin-bottom:30px">
                    The objective is not to separate design from campaign operations, but to make prepared content reusable across action layers such as Campaign Manager and Journey Manager.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Request a Demo ↗
                    </button>
                    <a class="inner-secondary" href="/en/solutions/campaign-manager">
                        Explore Campaign Manager →
                    </a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="Skip to content">
                        <i class="ri-arrow-down-line" aria-hidden="true"></i>
                    </a>
                </div>
            }
        </div>
        <div class="inner-scene" aria-label="@(tr ? "Content Studio içerik yapısını anlatan örnek görünüm" : "Illustrative view of Content Studio structure")">
            <div class="inner-scene-orbit" aria-hidden="true"></div>
            <div class="inner-scene-window">
                <div class="inner-window-bar">
                    <strong>pika<span>✳</span></strong>
                    <span>Content Studio</span>
                    <small>@(tr ? "Örnek görünüm" : "Illustration")</small>
                </div>
                <div class="inner-flow" style="padding:22px 18px" aria-hidden="true">
                    <div>
                        <i class="ri-file-copy-2-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "ŞABLON" : "TEMPLATE")</strong>
                        </span>
                        <b>01</b>
                    </div>
                    <span class="inner-flow-link" style="height:14px"></span>
                    <div>
                        <i class="ri-layout-grid-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "BLOKLAR" : "BLOCKS")</strong>
                        </span>
                        <b>02</b>
                    </div>
                    <span class="inner-flow-link" style="height:14px"></span>
                    <div>
                        <i class="ri-user-heart-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "KİŞİSELLEŞTİRME" : "PERSONALIZATION")</strong>
                        </span>
                        <b>03</b>
                    </div>
                    <span class="inner-flow-link" style="height:14px"></span>
                    <div>
                        <i class="ri-eye-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "ÖNİZLEME" : "PREVIEW")</strong>
                        </span>
                        <b>04</b>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="inner-trust-ribbon">
    <div class="container">
        <div class="inner-trust-ribbon__items">
            <div class="inner-trust-ribbon__item">
                <i class="ri-whatsapp-line" aria-hidden="true"></i>
                <div>
                    <strong>WhatsApp Business API</strong>
                    <span>@(tr ? "Resmi Meta API" : "Official Meta API")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-mail-send-line" aria-hidden="true"></i>
                <div>
                    <strong>Email &amp; SMS</strong>
                    <span>@(tr ? "Doğrulanmış Kanallar" : "Verified Channels")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-focus-3-line" aria-hidden="true"></i>
                <div>
                    <strong>Pika Opportunity Engine</strong>
                    <span>@(tr ? "Günlük Algoritmik Tespit" : "Daily Discovery")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-shield-check-line" aria-hidden="true"></i>
                <div>
                    <strong>İYS &amp; KVKK</strong>
                    <span>@(tr ? "İzin Denetimi" : "Consent Verification")</span>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="inner-content" class="inner-anchor"></div>

@* ── STICKY SUBNAV ───────────────────────────────────────────── *@
<div class="pika-sol-subnav-wrap">
    <div class="container">
        <nav class="pika-sol-subnav">
            <a href="#overview">@(tr ? "Genel Bakış" : "Overview")</a>
            <a href="#editor">@(tr ? "Editör" : "Editor")</a>
            <a href="#blocks">@(tr ? "Bloklar" : "Blocks")</a>
            <a href="#templates">@(tr ? "Şablonlar" : "Templates")</a>
            <a href="#personalization">@(tr ? "Kişiselleştirme" : "Personalization")</a>
            <a href="#platform">@(tr ? "Platform İlişkisi" : "Platform Relationships")</a>
            <a href="#faq">@(tr ? "SSS" : "FAQ")</a>
        </nav>
    </div>
</div>

@* ── TRUST STRIP ─────────────────────────────────────────────── *@
<section class="pika-sol-section py-4" id="overview">
    <div class="container">
        <div class="pika-sol-trust-strip" data-aos="fade-up">
            <div class="pika-sol-trust-item"><i class="ri-drag-move-line"></i><span>@(tr ? "Sürükle & Bırak" : "Drag & Drop")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-layout-grid-line"></i><span>@(tr ? "Modüler Bloklar" : "Modular Blocks")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-file-copy-2-line"></i><span>@(tr ? "Şablonlar" : "Templates")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-user-heart-line"></i><span>@(tr ? "Kişiselleştirme" : "Personalization")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-smartphone-line"></i><span>@(tr ? "Cihaz Önizlemesi" : "Device Preview")</span></div>
        </div>
    </div>
</section>

@* ── 02 DIRECT ANSWER ────────────────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
            <h2 class="pika-sol-section-title mb-3">
                @(tr ? "Content Studio nedir?" : "What is Content Studio?")
            </h2>
            <p class="lead ph-muted" style="line-height:1.65">
                @(tr ? "Content Studio, Pika'da kampanya ve müşteri yolculuklarında kullanılacak iletişim içeriğini görsel olarak hazırlamak, şablonlaştırmak, kişiselleştirmek ve yeniden kullanmak için kullanılan içerik hazırlama katmanıdır." : "Content Studio is Pika's content-preparation layer for visually preparing, templating, personalizing and reusing communication content used in campaigns and customer journeys.")
            </p>
        </div>

        <div class="p-4 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Email için görsel ve modüler tasarım yapısı sunarken, SMS ve WhatsApp gibi diğer iletişim kanallarında kullanılacak kanal-uygun içeriklerin hazırlanmasına da içerik bağlamı sağlar." : "It provides a visual and modular design structure for Email while also supporting preparation of channel-appropriate content for communication channels such as SMS and WhatsApp.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Content Studio'ın temel sorusu şudur:" : "Content Studio answers one central question:")
            </p>
            <div class="p-4 rounded-3 text-center my-4" style="background:#f4f8ec;border:1px solid #c8deb0">
                <div class="display-6 fw-bold" style="color:var(--pika-primary);letter-spacing:-0.5px">
                    @(tr ? "“Müşteriye hangi içerik sunulmalı?”" : "“What content should the customer receive?”")
                </div>
            </div>
            <p class="mb-0 ph-muted" style="line-height:1.65">
                @(tr ? "Content Studio hedef kitleyi seçmez, ticari fırsatı hesaplamaz ve gönderimi kendi başına başlatmaz. İçeriği, sonraki kampanya ve journey katmanlarının kullanabileceği şekilde hazırlar." : "Content Studio does not select the audience, calculate the commercial opportunity or independently start delivery. It prepares content for downstream campaign and journey layers.")
            </p>
        </div>
    </div>
</section>

@* ── 03 WHY CONTENT WORK BECOMES FRAGMENTED ──────────────────── *@
<section class="pika-sol-section">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "DAĞINIK ARAÇLARDAN TEK İÇERİK BAĞLAMINA" : "FROM DISCONNECTED TOOLS TO ONE CONTENT CONTEXT")</span>
            <h2 class="pika-sol-section-title mb-3">
                @(tr ? "İçerik hazırlamak, yalnızca metin yazmak değildir." : "Preparing content is more than writing copy.")
            </h2>
        </div>

        <div class="p-4 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Bir kampanya içeriğinin arkasında düzen, metin, görsel, buton, kişiselleştirme alanı, kanal yapısı ve farklı cihazlarda nasıl görüneceği gibi birden fazla karar bulunur." : "Campaign content involves multiple decisions: layout, text, image, button, personalization fields, channel structure and how content appears across different devices.")
            </p>
            <p class="mb-3 ph-muted" style="line-height:1.65">
                @(tr ? "Bu kararlar farklı tasarım araçlarında, HTML dosyalarında ve bağımsız metin belgelerinde tutulduğunda kampanyaya aktarım ayrı bir operasyonel sürece dönüşebilir." : "When those decisions live across separate design tools, HTML files and disconnected text documents, transferring content into a campaign can become another operational process.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Aynı içerik yaklaşımının farklı kampanya veya journey'lerde tekrar kullanılmak istenmesi de bu dağınıklığı büyütebilir." : "The fragmentation grows further when the same content approach needs to be reused across different campaigns or journeys.")
            </p>

            <div class="p-4 rounded-3 text-center my-4" style="background:#f4f8ec;border:1px solid #c8deb0">
                <div class="small fw-bold text-uppercase mb-2" style="color:#688151;letter-spacing:1px">
                    @(tr ? "Content Studio'ın amacı:" : "The purpose of Content Studio is not:")
                </div>
                <div class="fs-5 fw-bold mb-2 text-decoration-line-through text-muted">
                    @(tr ? "daha fazla içerik üretmek değil," : "To create more content.")
                </div>
                <div class="h4 fw-bold mb-0" style="color:var(--pika-primary)">
                    @(tr ? "iletişim içeriğini yeniden kullanılabilir ve yönetilebilir bir yapı içinde hazırlamaktır." : "To prepare communication content inside a reusable and manageable structure.")
                </div>
            </div>

            <p class="mb-0 ph-muted" style="line-height:1.65">
                @(tr ? "Böylece içerik tasarımı, kampanya operasyonundan tamamen kopuk bir iş olmaktan çıkar." : "This keeps content design from becoming completely disconnected from campaign operations.")
            </p>
        </div>
    </div>
</section>

@* ── 04 VISUAL EMAIL COMPOSITION ─────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="editor">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "GÖRSEL EMAIL DÜZENİ" : "VISUAL EMAIL COMPOSITION")</span>
            <h2 class="pika-sol-section-title mb-3">
                @(tr ? "Email yapısını ham kod yazmadan oluşturun." : "Build the email structure without working directly in raw code.")
            </h2>
            <p class="ph-muted mx-auto" style="max-width:760px;line-height:1.65">
                @(tr ? "Content Studio, email içeriğinin görsel bloklarla oluşturulabildiği sürükle-bırak düzenleme yaklaşımını destekler." : "Content Studio supports a drag-and-drop approach for composing email content through visual blocks.")
            </p>
        </div>

        <div class="pika-sol-showcase mb-5" data-aos="fade-up">
            <div class="cstudio-diagram-grid" aria-hidden="true">
                <div class="cstudio-diagram-card">
                    <i class="ri-file-copy-2-line"></i>
                    <div>
                        <strong>@(tr ? "ŞABLON" : "TEMPLATE")</strong>
                    </div>
                </div>
                <div class="cstudio-diagram-card">
                    <i class="ri-text"></i>
                    <div>
                        <strong>@(tr ? "METİN" : "TEXT")</strong>
                    </div>
                </div>
                <div class="cstudio-diagram-card">
                    <i class="ri-image-line"></i>
                    <div>
                        <strong>@(tr ? "GÖRSEL" : "IMAGE")</strong>
                    </div>
                </div>
                <div class="cstudio-diagram-card">
                    <i class="ri-cursor-line"></i>
                    <div>
                        <strong>@(tr ? "BUTON" : "BUTTON")</strong>
                    </div>
                </div>
                <div class="cstudio-diagram-card">
                    <i class="ri-user-heart-line"></i>
                    <div>
                        <strong>@(tr ? "KİŞİSELLEŞTİRME" : "PERSONALIZATION")</strong>
                    </div>
                </div>
                <div class="cstudio-diagram-card">
                    <i class="ri-eye-line"></i>
                    <div>
                        <strong>@(tr ? "ÖNİZLEME" : "PREVIEW")</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="p-4 rounded-4 bg-white border shadow-sm mx-auto" style="max-width:860px" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Metin, görsel, buton ve düzen blokları email kompozisyonunun farklı parçalarını oluşturabilir." : "Text, image, button and layout blocks can form different parts of the email composition.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Bu yaklaşım kullanıcının her kampanya için doğrudan HTML yapısı üzerinde çalışması gereksinimini azaltır." : "This reduces the need for users to work directly with HTML structure for every campaign.")
            </p>

            <div class="p-4 rounded-3 text-center my-4" style="background:#fffcf0;border:1px solid #ecd896">
                <div class="small fw-bold text-uppercase mb-2" style="color:#a87d18;letter-spacing:1px">
                    @(tr ? "Görsel editör:" : "The visual editor:")
                </div>
                <div class="fw-bold mb-3" style="color:#23413b">
                    @(tr ? "email içeriğinin yapısını hazırlamaya yardımcı olur." : "helps prepare the structure of email content.")
                </div>
                <div class="small fw-bold text-uppercase mb-2" style="color:#a87d18;letter-spacing:1px">
                    @(tr ? "Şunu garanti etmez:" : "It does not guarantee:")
                </div>
                <div class="h5 fw-bold mb-0" style="color:#721c24">
                    @(tr ? "“Her email istemcisinde piksel düzeyinde tamamen aynı görünüm.”" : "“Pixel-identical rendering in every email client.”")
                </div>
            </div>

            <p class="mb-0 ph-muted" style="line-height:1.65">
                @(tr ? "Email istemcileri ve cihazlar farklı rendering davranışlarına sahip olabilir; önizleme ve gönderim öncesi kontrol bu nedenle içerik sürecinin ayrı parçalarıdır." : "Email clients and devices can render content differently, so preview and pre-send review remain separate parts of the content process.")
            </p>
        </div>
    </div>
</section>

@* ── 05 MODULAR BLOCKS ───────────────────────────────────────── *@
<section class="pika-sol-section" id="blocks">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "MODÜLER BLOKLAR" : "MODULAR BLOCKS")</span>
            <h2 class="pika-sol-section-title mb-3">
                @(tr ? "İçeriği, yeniden kullanılabilir parçalardan oluşturun." : "Build content from reusable pieces.")
            </h2>
            <p class="ph-muted mx-auto" style="max-width:760px;line-height:1.65">
                @(tr ? "Bir email veya kampanya içeriği tek bir büyük tasarım olmak zorunda değildir. Content Studio içerik yapısını farklı görevleri olan bloklara ayırabilir." : "An email or campaign creative does not have to be one monolithic design. Content Studio can divide content structure into blocks with different responsibilities.")
            </p>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card h-100">
                    <div class="pika-sol-card-icon"><i class="ri-text"></i></div>
                    <h4>@(tr ? "Metin" : "Text")</h4>
                    <p class="ph-muted">
                        @(tr ? "İletişimin başlık, açıklama veya diğer metinsel bölümlerini oluşturur." : "Provides headings, descriptions and other textual parts of the communication.")
                    </p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="150">
                <div class="pika-sol-card h-100">
                    <div class="pika-sol-card-icon"><i class="ri-image-line"></i></div>
                    <h4>@(tr ? "Görsel" : "Image")</h4>
                    <p class="ph-muted">
                        @(tr ? "İçeriğin görsel iletişim bölümünü oluşturur." : "Provides the visual communication element of the content.")
                    </p>
                </div>
            </div>
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card h-100">
                    <div class="pika-sol-card-icon"><i class="ri-cursor-line"></i></div>
                    <h4>@(tr ? "Buton" : "Button")</h4>
                    <p class="ph-muted">
                        @(tr ? "Tanımlı bağlantı veya aksiyon yönlendirmesini içerik yapısına ekler." : "Adds a configured link or action direction to the content structure.")
                    </p>
                </div>
            </div>
            <div class="col-md-6" data-aos="fade-up" data-aos-delay="250">
                <div class="pika-sol-card h-100">
                    <div class="pika-sol-card-icon"><i class="ri-layout-grid-line"></i></div>
                    <h4>@(tr ? "Düzen" : "Layout")</h4>
                    <p class="ph-muted">
                        @(tr ? "İçerik öğelerinin sayfa içindeki yerleşimini organize eder." : "Organizes how content elements are positioned within the composition.")
                    </p>
                </div>
            </div>
            <div class="col-md-6" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card h-100">
                    <div class="pika-sol-card-icon"><i class="ri-user-heart-line"></i></div>
                    <h4>@(tr ? "Kişiselleştirme Alanı" : "Personalization Field")</h4>
                    <p class="ph-muted">
                        @(tr ? "Mevcut müşteri bağlamından kullanılabilen dinamik alanların içerikte yer almasına yardımcı olur." : "Helps available dynamic customer-context fields appear within the content.")
                    </p>
                </div>
            </div>
        </div>

        <div class="p-4 rounded-4 bg-white border text-center mx-auto" style="max-width:860px" data-aos="fade-up">
            <p class="mb-0 fw-bold" style="color:#23413b;line-height:1.65">
                @(tr ? "Modüler yapı yalnızca editörü kolaylaştırmaz. Aynı içerik yaklaşımının farklı şablon ve kampanyalarda daha tutarlı biçimde yeniden kullanılmasına da yardımcı olur." : "A modular structure does more than simplify editing. It also helps the same content approach be reused more consistently across templates and campaigns.")
            </p>
        </div>
    </div>
</section>

@* ── 06 TEMPLATES & REUSE ────────────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="templates">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "ŞABLONLAR" : "TEMPLATES")</span>
            <h2 class="pika-sol-section-title mb-3">
                @(tr ? "Her kampanyada aynı içeriği sıfırdan kurmayın." : "Do not rebuild the same content structure for every campaign.")
            </h2>
            <p class="ph-muted mx-auto" style="max-width:760px;line-height:1.65">

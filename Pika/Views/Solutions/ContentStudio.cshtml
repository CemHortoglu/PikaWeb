@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]="Content Studio | "+(tr?"İçerik ve Şablonlar":"Content & Templates"); ViewData["MetaDescription"]=tr?"Campaign ve Journey iletişim içeriklerini editör, yeniden kullanılabilir şablon ve Store yaklaşımıyla hazırlayın; Pika AI'yı taslak desteği için kullanın.":"Prepare Campaign and Journey communication content with editor, reusable templates and Store workflows, using Pika AI as drafting support."; ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">Platform · Content Studio</span><h1>@(tr?"İçerik hazırlığını kampanya operasyonundan koparmayın.":"Keep content creation connected to campaign operations.")</h1><p>@(tr?"Content Studio; Campaign ve Journey içinde kullanılacak iletişim içeriklerini hazırlama, şablonlaştırma ve yeniden kullanma işini tek içerik çalışma alanında toplar. Amaç her kampanyada sıfırdan başlamak yerine ekip içinde tutarlı bir üretim akışı kurmaktır.":"Content Studio brings content creation, templating and reuse for Campaign and Journey workflows into one workspace, helping teams avoid starting from scratch every time.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/email-template-editor">@(tr?"Editör Rehberi":"Editor Guide")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_email-template-editor_17.png" alt="@(tr?"Pika email template editörü":"Pika email template editor")" width="1200" height="760" /><figcaption>@(tr?"Gerçek ürün görünümü: içerik hazırlama ve şablon düzenleme çalışma alanı.":"Product view: content preparation and template editing workspace.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-columns"><div class="pk-feature"><h3>@(tr?"Editör":"Editor")</h3><p>@(tr?"Desteklenen içerik bileşenleriyle kampanya ve Journey mesajlarını hazırlayın ve önizleyin.":"Prepare and preview Campaign and Journey messages with supported content components.")</p></div><div class="pk-feature"><h3>@(tr?"Şablonlaştırma":"Templates")</h3><p>@(tr?"Tekrarlanan iyi pratikleri yalnız kişisel bilgi olarak bırakmayın; yeniden kullanılabilir içerik haline getirin.":"Turn recurring good practice into reusable content rather than leaving it as individual knowledge.")</p></div><div class="pk-feature"><h3>Store</h3><p>@(tr?"Email ve Journey Store yaklaşımıyla hazır yapıları ekip içinde daha hızlı devreye alın.":"Use Email and Journey Store workflows to bring reusable structures into team operations faster.")</p></div></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container pk-screen-band"><img src="/wiki/assets/images/img_email-store_20.png" alt="Pika Email Store" loading="lazy" width="1200" height="760" /><div><span class="pk-eyebrow">@(tr?"Tekrar kullanılabilir operasyon":"Reusable operations")</span><h2>@(tr?"Şablon yalnız tasarım değil, operasyon hafızasıdır.":"A template is operational memory, not just design.")</h2><p class="pk-lead">@(tr?"Hazır içerik ve akış yapıları kampanya hazırlığını hızlandırır; ancak son hedef kitle, kanal, izin ve yayınlama kararı yine ilgili Campaign/Journey bağlamında verilir.":"Reusable content and flow structures can speed preparation, while final audience, channel, consent and publishing decisions remain in the relevant Campaign/Journey context.")</p></div></div></section>
<section class="pk-section"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">Content + AI</span><h2>@(tr?"AI taslak üretir; ürün gerçeğini ve onayı kullanıcı korur.":"AI can draft; users preserve product truth and approval.")</h2></div><div><p class="pk-lead">@(tr?"Pika AI kampanya yaklaşımı veya içerik taslağı hazırlamada yardımcı olabilir. Hesaplanmış müşteri/ürün verisini değiştirmemeli ve kullanıcının yayınlama kontrolünü devralmamalıdır.":"Pika AI may help prepare campaign approaches or content drafts. It should not rewrite calculated customer/product evidence or take over publishing control.")</p><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/ai-kampanya-asistani":"/en/platform/ai-campaign-assistant")">Pika AI</a></div></div></section>

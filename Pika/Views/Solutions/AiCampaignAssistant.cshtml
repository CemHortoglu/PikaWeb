@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    var wikiBase = "/wiki/";
    ViewData["Title"] = tr ? "AI Kampanya Asistanı | Pika Pilot ile Akıllı Üretim" : "AI Campaign Assistant | Smart Generation with Pika Pilot";
    ViewData["MetaDescription"] = tr ? "Pika AI Kampanya Asistanı (Pika Pilot); tek bir fikirden hedef kitleyi, kanalı, metinleri ve HTML e-posta şablonunu saniyeler içinde oluşturan üretici zeka motorudur." : "Pika AI Campaign Assistant (Pika Pilot) drafts target cohorts, channel strategy, personalized copy, and HTML email templates from a single prompt.";
    ViewData["BodyClass"] = "pika-platform-page";
}

@* ── CHAPTER 1: HERO ────────────────────────────────────────── *@
<section class="ph-hero">
    <div class="container position-relative">
        <div class="row align-items-center g-5 ph-split-row">
            <div class="col-lg-6" data-aos="fade-right" data-aos-duration="700">
                <div class="ph-hero-eyebrow-pill">
                    <i class="ri-sparkling-2-line" style="color:var(--pika-color-brand-primary-dark)"></i>
                    <span>@(tr ? "Üretken Yapay Zekâ · Pika Pilot" : "Generative AI · Pika Pilot")</span>
                </div>
                <h1 class="ph-hero-title">
                    AI Kampanya Asistanı
                    <span class="ph-gradient-text d-block">@(tr ? "Fikirden Yayına 60 Saniye" : "From Concept to Dispatch in 60s")</span>
                </h1>
                <p class="ph-hero-desc">
                    @(tr ? "Pika Pilot; pazarlama hedefinizi dinler, hedef kitle segmentini belirler, doğru kanalı önerir, kişiselleştirilmiş metinleri ve HTML e-posta şablonunu hazırlar." : "Pika Pilot transforms your marketing goal into target audience cohorts, channel mix, multi-variant copy, and responsive email templates.")
                </p>
                <div class="ph-hero-actions">
                    <button type="button" class="ph-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">
                        @(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-line"></i>
                    </button>
                    <a href="@(wikiBase)pika-pilot-ai-kampanya-asistani" class="ph-btn-outline">
                        @(tr ? "Teknik Detay — Wiki" : "Technical Specs — Wiki") <i class="ri-external-link-line"></i>
                    </a>
                </div>
            </div>

            @* Right: Pika Pilot Copilot Card *@
            <div class="col-lg-6" data-aos="fade-left" data-aos-duration="700">
                <div class="ph-trust-card p-4 p-md-5">
                    <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <span class="ph-live-dot"></span>
                            <span class="fw-bold small text-dark">@(tr ? "Pika Pilot Canlı Taslak" : "Pika Pilot Draft Engine")</span>
                        </div>
                        <span class="badge bg-success-subtle text-success border small font-monospace">AI Destekli Taslak</span>
                    </div>

                    <div class="p-3 rounded-3 bg-light border mb-3">
                        <span class="small text-muted d-block mb-1"><i class="ri-chat-voice-line text-primary me-1"></i> Komut (Prompt):</span>
                        <div class="small fw-semibold text-dark">"Son 45 gündür alışveriş yapmamış ayakkabı alıcılarına özel hafta sonu %20 indirim WhatsApp kampanyası hazırla."</div>
                    </div>

                    <div class="d-flex flex-column gap-2 mb-3">
                        <div class="p-2 rounded-2 bg-white border d-flex align-items-center justify-content-between">
                            <span class="small text-muted"><i class="ri-group-line text-primary me-2"></i> Hedef Kitle:</span>
                            <span class="small font-monospace fw-bold text-dark">Riskli Ayakkabı Alıcıları (2.840 Kişi)</span>
                        </div>
                        <div class="p-2 rounded-2 bg-white border d-flex align-items-center justify-content-between">
                            <span class="small text-muted"><i class="ri-whatsapp-line text-success me-2"></i> Önerilen Kanal:</span>
                            <span class="small font-monospace fw-bold text-success">WhatsApp + Dinamik İndirim Kodu</span>
                        </div>
                        <div class="p-2 rounded-2 bg-white border d-flex align-items-center justify-content-between">
                            <span class="small text-muted"><i class="ri-shield-check-line text-info me-2"></i> İYS Doğrulaması:</span>
                            <span class="small font-monospace fw-bold text-success">İzinli GSM: %100 Uyumlu</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                        <span class="small text-muted"><i class="ri-user-follow-line text-warning me-1"></i> İnsan Onayı Bekliyor</span>
                        <a href="@(tr ? "/cozumler/campaign-manager" : "/en/solutions/campaign-manager")" class="btn btn-sm btn-dark px-3 fw-semibold">
                            @(tr ? "İncele & Onayla" : "Review & Approve")
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── CHAPTER 2: LLM DEFINITION & BUSINESS PROBLEM ───────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        @* Plain LLM Definition Box *@
        <div class="p-4 rounded-4 mb-5" style="background:#ffffff;border:1px solid #dcebc7" data-aos="fade-up">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="ri-information-line text-success fw-bold"></i>
                <span class="fw-bold text-dark text-uppercase small" style="letter-spacing:0.06em">@(tr ? "AI Kampanya Asistanı Nedir?" : "What is AI Campaign Assistant?")</span>
            </div>
            <p class="mb-0 text-secondary" style="font-size:1.02rem;line-height:1.6">
                @(tr ? "AI Kampanya Asistanı (Pika Pilot); pazarlama uzmanlarının doğal dilde yazdığı kampanya briflerini analiz ederek hedef kitle kuralını, en verimli iletişim kanalını, kişiselleştirilmiş mesaj varyantlarını ve HTML e-posta şablonunu otomatik olarak üreten Pika üretken yapay zekâ modülüdür. Asistan asla otonom gönderim yapmaz; tüm içerikleri insan denetimi ve onayına sunulur." : "AI Campaign Assistant (Pika Pilot) is Pika's generative AI co-pilot that transforms plain text marketing briefs into audience segmentation rules, channel recommendations, personalized multi-channel copy, and responsive HTML email templates, strictly adhering to human-in-the-loop governance.")
            </p>
        </div>

        <div class="row align-items-center g-5 ph-split-row">
            <div class="col-lg-6" data-aos="fade-right">
                <span class="ph-eyebrow">@(tr ? "İnsan Odaklı Yapay Zekâ" : "Human-in-the-Loop AI")</span>
                <h2 class="pika-h2 fw-bold mb-3">@(tr ? "AI Tasarlar, Son Kararı Siz Verirsiniz" : "AI Proposes, Your Team Decides")</h2>
                <p class="ph-muted mb-3" style="font-size:1.05rem">
                    @(tr ? "Yapay zekâ pazarlama ekiplerinin hızını 10 kat artırırken kurumsal marka güvenliğini korur:" : "Supercharge campaign agility while preserving brand safety and control:")
                </p>
                <div class="p-3 rounded-3 bg-white border mb-3">
                    <div class="fw-bold text-dark small mb-1"><i class="ri-shield-check-line text-success me-1"></i> <strong>Sıfır Otonom Hata Riski</strong></div>
                    <div class="small ph-muted">AI hiçbir koşulda kontrolsüz veya onaysız mesaj fırlatamaz. Her taslak kullanıcının onay kutusundan geçer.</div>
                </div>
                <div class="p-3 rounded-3 bg-white border">
                    <div class="fw-bold text-dark small mb-1"><i class="ri-magic-line text-primary me-1"></i> <strong>Hazır HTML & Çok Kanallı Varyantlar</strong></div>
                    <div class="small ph-muted">Metin yazma, görsel yerleşimi ve buton tasarımı saniyeler içinde tamamlanır.</div>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <div class="d-flex flex-column gap-3 p-4 rounded-4 bg-white border">
                    <div class="fw-bold small text-uppercase" style="color:var(--pika-color-brand-primary-dark);letter-spacing:0.06em">
                        @(tr ? "Pika Pilot 4 Aşamalı Üretim Akışı" : "Pika Pilot 4-Step Generation Flow")
                    </div>
                    <div class="d-flex align-items-start gap-3 p-2 rounded-2 bg-light">
                        <div class="ph-unboxed-icon flex-shrink-0" style="width:30px;height:30px;font-size:0.8rem;font-weight:800;margin-bottom:0">1</div>
                        <div>
                            <div class="fw-bold text-dark small">@(tr ? "Fikri / Amacı Yazın" : "Prompt Natural Language Goal")</div>
                            <div class="small ph-muted">Hedeflenen ürün, indirim oranı veya kampanya amacını bir cümleyle girin.</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3 p-2 rounded-2 bg-light">
                        <div class="ph-unboxed-icon flex-shrink-0" style="width:30px;height:30px;font-size:0.8rem;font-weight:800;margin-bottom:0">2</div>
                        <div>
                            <div class="fw-bold text-dark small">@(tr ? "Otomatik Segment & Kanal Tespiti" : "Auto Cohort & Channel Mapping")</div>
                            <div class="small ph-muted">AI, veritabanından en uygun müşteri kitlesini ve kanalı eşleştirir.</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3 p-2 rounded-2 bg-light">
                        <div class="ph-unboxed-icon flex-shrink-0" style="width:30px;height:30px;font-size:0.8rem;font-weight:800;margin-bottom:0">3</div>
                        <div>
                            <div class="fw-bold text-dark small">@(tr ? "İçerik & HTML Şablon Üretimi" : "Copy & HTML Template Generation")</div>
                            <div class="small ph-muted">Kişiselleştirilmiş başlıklar, CTA butonları ve e-posta tasarımı hazır taslağa dökülür.</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3 p-2 rounded-2" style="background:#f0fdf4;border:1px solid #bbf7d0">
                        <div class="ph-unboxed-icon flex-shrink-0" style="width:30px;height:30px;font-size:0.8rem;font-weight:800;margin-bottom:0"><i class="ri-check-line"></i></div>
                        <div>
                            <div class="fw-bold text-dark small">@(tr ? "4. İnceleme & Güvenli Yayın" : "4. Review & Governed Dispatch")</div>
                            <div class="small ph-muted">Ekip taslağı düzenler, test gönderimi yapar ve onaylayarak yayına alır.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── CHAPTER 3: PRODUCT PROOF (Real Software UI) ─────────────── *@

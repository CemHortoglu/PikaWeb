    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "Ürün Kanıtı" : "Product Proof")</span>
            <h2 class="pika-h2 fw-bold">@(tr ? "Gerçek Pika Pilot Arayüzü & Taslak Tuvali" : "Real Pika Pilot Interface & Draft Canvas")</h2>
            <p class="ph-muted mx-auto" style="max-width:620px">
                @(tr ? "Pika Pilot ekranında tek bir komuttan üretilen hedef kitle, içerik varyantları ve şablon önizlemesi." : "Live view of prompt parsing, cohort selection, and instant template rendering in Pika Pilot.")

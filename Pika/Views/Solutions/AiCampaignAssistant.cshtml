@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-platform-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-pilot-page.css" asp-append-version="true" />
}

@* ── 01 HERO ─────────────────────────────────────────────────── *@
<section class="inner-hero inner-hero--assistant">
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span>/</span>
                <span>Pika Pilot</span>
            </nav>
            <div class="inner-eyebrow"><span></span>PIKA PILOT</div>
            <div class="small fw-bold text-uppercase mb-2" style="color:rgba(255,255,255,0.85);letter-spacing:1px">
                @(tr ? "AI Kampanya Asistanı" : "AI Campaign Assistant")
            </div>
            @if (tr)
            {
                <h1>
                    Kampanya fikrini,<br />
                    hesaplanmış müşteri bağlamıyla<br />
                    taslağa dönüştürün.
                </h1>
                <p>
                    Pika Pilot; doğal dilde yazdığınız kampanya brifini Pika'nın hesapladığı müşteri, ürün ve fırsat bağlamıyla birlikte değerlendirerek hedef kitle kriterleri, kanal yaklaşımı ve kampanya içeriği taslaklarını hazırlamaya yardımcı olan AI kampanya asistanıdır.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.82);font-size:14px;line-height:1.6;margin-bottom:30px">
                    Pika AI, müşteriyi veya fırsatı hayal ederek oluşturmaz. Pika'nın hesapladığı müşteri, ürün ve fırsat bağlamını kullanarak kampanya hazırlığını ve içerik üretimini hızlandırır; son karar kullanıcıda kalır.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Demo Talep Et ↗
                    </button>
                    <a class="inner-secondary" href="/cozumler/content-studio">
                        Content Studio'yu Keşfedin →
                    </a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="İçeriğe atla">
                        <i class="ri-arrow-down-line" aria-hidden="true"></i>
                    </a>
                </div>
            }
            else
            {
                <h1>
                    Turn a campaign idea<br />
                    into a draft grounded in<br />
                    calculated customer context.
                </h1>
                <p>
                    Pika Pilot is an AI campaign assistant that evaluates your natural-language campaign brief together with customer, product and opportunity context calculated by Pika to help prepare draft audience criteria, channel approach and campaign content.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.82);font-size:14px;line-height:1.6;margin-bottom:30px">
                    Pika AI does not invent the customer or the opportunity. It uses customer, product and opportunity context calculated by Pika to accelerate campaign preparation and content creation, while the final decision remains with the user.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Request a Demo ↗
                    </button>
                    <a class="inner-secondary" href="/en/solutions/content-studio">
                        Explore Content Studio →
                    </a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="Skip to content">
                        <i class="ri-arrow-down-line" aria-hidden="true"></i>
                    </a>
                </div>
            }
        </div>
        <div class="inner-scene" aria-label="@(tr ? "Pika Pilot karar bağlamını anlatan kavramsal görünüm" : "Conceptual view of Pika Pilot decision context")">
            <div class="inner-scene-orbit" aria-hidden="true"></div>
            <div class="inner-scene-window">
                <div class="inner-window-bar">
                    <strong>pika<span>✳</span></strong>
                    <span>Pika Pilot</span>
                    <small>@(tr ? "Örnek görünüm" : "Illustration")</small>
                </div>
                <div class="inner-flow" style="padding:16px 18px" aria-hidden="true">
                    <div>
                        <i class="ri-edit-2-line" aria-hidden="true"></i>
                        <span><strong style="margin:0">@(tr ? "KAMPANYA BRİFİ" : "CAMPAIGN BRIEF")</strong></span>
                        <b>01</b>
                    </div>
                    <span class="inner-flow-link" style="height:10px"></span>
                    <div>
                        <i class="ri-user-heart-line" aria-hidden="true"></i>
                        <span><strong style="margin:0">@(tr ? "MÜŞTERİ BAĞLAMI" : "CUSTOMER CONTEXT")</strong></span>
                        <b>02</b>
                    </div>
                    <span class="inner-flow-link" style="height:10px"></span>
                    <div>
                        <i class="ri-shopping-bag-3-line" aria-hidden="true"></i>
                        <span><strong style="margin:0">@(tr ? "ÜRÜN BAĞLAMI" : "PRODUCT CONTEXT")</strong></span>
                        <b>03</b>
                    </div>
                    <span class="inner-flow-link" style="height:10px"></span>
                    <div>
                        <i class="ri-flashlight-line" aria-hidden="true"></i>
                        <span><strong style="margin:0">@(tr ? "FIRSAT BAĞLAMI" : "OPPORTUNITY CONTEXT")</strong></span>
                        <b>04</b>
                    </div>
                    <span class="inner-flow-link" style="height:10px"></span>
                    <div>
                        <i class="ri-file-text-line" aria-hidden="true"></i>
                        <span><strong style="margin:0">@(tr ? "TASLAK" : "DRAFT")</strong></span>
                        <b>05</b>
                    </div>
                    <span class="inner-flow-link" style="height:10px"></span>
                    <div>
                        <i class="ri-shield-check-line" aria-hidden="true"></i>
                        <span><strong style="margin:0">@(tr ? "İNSAN KARARI" : "HUMAN DECISION")</strong></span>
                        <b>06</b>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div id="inner-content" class="inner-anchor"></div>

@* ── 02 DIRECT ANSWER ────────────────────────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Pika Pilot nedir?" : "What is Pika Pilot?")
            </h2>
            <p class="lead ph-muted" style="line-height:1.65">
                @(tr ? "Pika Pilot, Pika'nın müşteri, ürün ve fırsat bağlamını kullanarak kampanya hazırlığında kullanıcıya taslak üretimi ve öneri desteği sağlayan yardımcı AI co-pilot'tur." : "Pika Pilot is an assistive AI co-pilot that uses Pika's customer, product and opportunity context to support campaign preparation with drafts and suggestions.")
            </p>
        </div>

        <div class="p-4 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Kullanıcının doğal dilde verdiği kampanya amacı; mevcut müşteri ve ürün bağlamıyla birlikte değerlendirilerek hedef kitle kriteri taslağı, kanal yaklaşımı, mesaj varyantları ve email içerik taslağı gibi hazırlık çıktılarının oluşturulmasına yardımcı olabilir." : "A campaign objective written in natural language can be evaluated together with available customer and product context to help prepare draft audience criteria, channel approach, message variants and Email content drafts.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Pika Pilot'ın temel sorusu şudur:" : "Pika Pilot answers one central question:")
            </p>
            <div class="p-4 rounded-3 text-center my-4" style="background:#f4f8ec;border:1px solid #c8deb0">
                <div class="h3 fw-bold" style="color:var(--pika-primary);letter-spacing:-0.5px">
                    @(tr ? "“Pika'nın zaten bildiği bağlamı kullanarak bu kampanya fikrini nasıl daha hızlı bir taslağa dönüştürebiliriz?”" : "“How can we use context Pika already knows to turn this campaign idea into a draft faster?”")
                </div>
            </div>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Pika Pilot müşteri davranışını hesaplayan analitik motor değildir, ticari fırsatı oluşturan kaynak değildir ve kampanyayı kendi başına gönderen bir sistem değildir." : "Pika Pilot is not the analytical engine that calculates customer behavior, it is not the source that creates the commercial opportunity, and it does not independently send the campaign.")
            </p>
            <div class="p-3 rounded-3 text-center" style="background:#fafdf7;border:1px solid #e2ebd8">
                <div class="small fw-bold text-uppercase" style="color:#23413b;letter-spacing:0.5px">
                    @(tr ? "Bağlam Pika'nın hesaplama katmanlarından gelir. AI bu bağlamla hazırlığı hızlandırır. Son karar kullanıcıda kalır." : "Context comes from Pika's calculation layers. AI accelerates preparation with that context. The final decision remains with the user.")
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 03 WHY GROUNDING MATTERS ────────────────────────────────── *@
<section class="ph-section ph-section-plain">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "ÖNCE BAĞLAM" : "CONTEXT FIRST")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "AI'ın kampanya fikri üretmesi kadar, hangi gerçek bağlama dayandığı da önemlidir." : "What AI can draft matters. What factual context it is grounded in matters too.")
            </h2>
        </div>

        <div class="p-4 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Pika'da kampanya hazırlığı yalnızca serbest metin bir komutla başlamaz. Kampanya fikri, platformda daha önce hesaplanmış müşteri, ürün ve fırsat bağlamıyla birlikte değerlendirilebilir." : "In Pika, campaign preparation does not begin with a free-text prompt alone. A campaign idea can be evaluated together with customer, product and opportunity context already calculated by the platform.")
            </p>
            <p class="mb-3 ph-muted" style="line-height:1.65">
                @(tr ? "Bu ayrım önemlidir; çünkü müşteri değeri, satın alma ritmi, ürün anlamı veya ticari fırsat gibi temel karar bağlamları üretken yapay zekânın hayal ederek oluşturması gereken bilgiler değildir." : "This distinction matters because customer value, purchase rhythm, product meaning and commercial opportunity are not facts that generative AI should invent.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Bu bağlamlar Pika'nın ilgili intelligence ve opportunity katmanlarından gelir. Pika Pilot'ın görevi bu hesaplanmış bağlamı kampanya hazırlığında kullanılabilir hale getirmeye yardımcı olmaktır." : "Those contexts come from Pika's relevant intelligence and opportunity layers. The role of Pika Pilot is to help make that calculated context usable during campaign preparation.")
            </p>

            <div class="p-4 rounded-3 text-center my-4" style="background:#f4f8ec;border:1px solid #c8deb0">
                <div class="d-flex align-items-center justify-content-center flex-wrap gap-3 fw-bold" style="font-size:15px;color:#23413b">
                    <div>
                        <small class="text-muted d-block text-uppercase" style="font-size:11px">@(tr ? "Önce" : "First")</small>
                        <span style="color:var(--pika-primary)">@(tr ? "HESAPLANMIŞ BAĞLAM" : "CALCULATED CONTEXT")</span>
                    </div>
                    <i class="ri-arrow-right-line" style="color:var(--pika-primary)"></i>
                    <div>
                        <small class="text-muted d-block text-uppercase" style="font-size:11px">@(tr ? "Sonra" : "Then")</small>
                        <span style="color:var(--pika-primary)">@(tr ? "AI DESTEKLİ TASLAK" : "AI-ASSISTED DRAFT")</span>
                    </div>
                    <i class="ri-arrow-right-line" style="color:var(--pika-primary)"></i>
                    <div>
                        <small class="text-muted d-block text-uppercase" style="font-size:11px">@(tr ? "En son" : "Finally")</small>
                        <span style="color:var(--pika-primary)">@(tr ? "İNSAN KARARI" : "HUMAN DECISION")</span>
                    </div>
                </div>
            </div>

            <p class="mb-0 text-center fw-bold" style="color:#23413b;line-height:1.65">
                @(tr ? "Pika Pilot'ın AI yaklaşımı, “AI ne önerirse doğrudur” anlayışına dayanmaz. “AI, mevcut bağlamı hazırlık için kullansın” anlayışına dayanır." : "Pika Pilot's AI approach is not: “Whatever AI suggests must be correct.” It is: “Let AI use existing context to assist preparation.”")
            </p>
        </div>
    </div>
</section>

@* ── 04 WHAT CONTEXT PIKA PILOT USES ─────────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "AI'IN BAĞLAMI" : "AI CONTEXT")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Pika Pilot boşlukta çalışmaz." : "Pika Pilot does not work in a vacuum.")
            </h2>
            <p class="ph-muted mx-auto" style="max-width:760px;line-height:1.65">
                @(tr ? "Pika Pilot, kampanya hazırlığında kullanıcı brifini Pika'nın mevcut hesaplanmış bağlamıyla birlikte değerlendirebilir." : "During campaign preparation, Pika Pilot can evaluate the user's brief together with calculated context already available in Pika.")
            </p>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="ph-trust-card h-100 p-4">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-edit-2-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Kampanya Brifi" : "Campaign Brief")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Kullanıcının kampanyanın amacı, iletişim fikri veya hazırlanmasını istediği çalışma hakkında doğal dilde verdiği yönlendirmedir." : "Natural-language direction from the user describing the campaign objective, communication idea or work they want to prepare.")
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="150">
                <div class="ph-trust-card h-100 p-4">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-user-heart-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Müşteri Bağlamı" : "Customer Context")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Customer Intelligence tarafından hesaplanan uygun müşteri davranışı ve değer bağlamı, kampanya hazırlığı için kullanılabilir temel girdilerden biridir." : "Relevant customer-behavior and value context calculated by Customer Intelligence can provide foundational input for campaign preparation.")
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                <div class="ph-trust-card h-100 p-4">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-shopping-bag-3-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Ürün Bağlamı" : "Product Context")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Product Intelligence tarafından oluşturulan ürün anlamı, müşteri ihtiyacı ve ürün ilişkisi bağlamları kampanya fikrini ürün gerçeğiyle ilişkilendirmeye yardımcı olabilir." : "Product meaning, customer-need and product-relationship context from Product Intelligence can help connect the campaign idea to product reality.")
                    </p>
                </div>
            </div>
            <div class="col-lg-6 col-md-6" data-aos="fade-up" data-aos-delay="250">
                <div class="ph-trust-card h-100 p-4">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-flashlight-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Fırsat Bağlamı" : "Opportunity Context")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Günün Fırsatları gibi karar katmanlarında görünür hale gelen değerlendirilebilir ticari fırsat bağlamı, kampanyanın neden oluşturulduğunu açıklayan girdilerden biri olabilir." : "Evaluable commercial opportunity context surfaced by decision layers such as Daily Opportunities can provide part of the reason why a campaign is being prepared.")
                    </p>
                </div>
            </div>
            <div class="col-lg-6 col-md-6" data-aos="fade-up" data-aos-delay="300">
                <div class="ph-trust-card h-100 p-4">
                    <div class="ph-unboxed-icon mb-3"><i class="ri-mail-send-line"></i></div>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Kanal Bağlamı" : "Channel Context")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Email, SMS ve WhatsApp'ın farklı içerik ve iletişim yapıları kampanya taslağının kanala uygun biçimde hazırlanmasında dikkate alınabilir." : "Different content and communication structures across Email, SMS and WhatsApp can be considered when preparing channel-appropriate campaign drafts.")
                    </p>
                </div>
            </div>
        </div>

        <div class="p-4 rounded-4 bg-white border text-center mx-auto" style="max-width:860px" data-aos="fade-up">
            <p class="mb-0 fw-bold" style="color:#23413b;line-height:1.65">
                @(tr ? "Pika Pilot bu bağlamları yeniden icat etmez. Kampanya hazırlığında kullanılabilecek şekilde bir araya getirmeye yardımcı olur." : "Pika Pilot does not reinvent these contexts. It helps bring them together for campaign preparation.")
            </p>
        </div>
    </div>
</section>

@* ── 05 FROM CAMPAIGN BRIEF TO DRAFT ─────────────────────────── *@
<section class="ph-section ph-section-plain">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "BRİFTEN TASLAĞA" : "FROM BRIEF TO DRAFT")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Doğal dildeki kampanya fikrini, inceleyebileceğiniz bir taslağa dönüştürün." : "Turn a natural-language campaign idea into a draft you can review.")
            </h2>
        </div>

        @* Conceptual Grounded-AI Showcase (replaces legacy screenshot) *@
        <div class="p-4 rounded-4 mb-5 shadow-sm mx-auto" style="max-width:960px;background:#f9fcf5;border:1px solid #dcebc7" data-aos="fade-up">
            <div class="pilot-diagram-grid" aria-hidden="true">
                <div class="pilot-diagram-card">
                    <i class="ri-edit-2-line"></i>
                    <div>
                        <strong>@(tr ? "BRİF" : "BRIEF")</strong>
                    </div>
                </div>
                <div class="pilot-diagram-card">
                    <i class="ri-database-2-line"></i>
                    <div>
                        <strong>@(tr ? "HESAPLANMIŞ BAĞLAM" : "CALCULATED CONTEXT")</strong>
                    </div>
                </div>
                <div class="pilot-diagram-card">
                    <i class="ri-filter-3-line"></i>
                    <div>
                        <strong>@(tr ? "TASLAK KRİTERLER" : "DRAFT CRITERIA")</strong>
                    </div>
                </div>
                <div class="pilot-diagram-card">
                    <i class="ri-file-text-line"></i>
                    <div>
                        <strong>@(tr ? "İÇERİK TASLAĞI" : "CONTENT DRAFT")</strong>
                    </div>
                </div>
                <div class="pilot-diagram-card">
                    <i class="ri-shield-check-line"></i>
                    <div>
                        <strong>@(tr ? "KULLANICI İNCELEMESİ" : "USER REVIEW")</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="50">
                <div class="p-4 rounded-4 bg-white border h-100">
                    <span class="badge mb-2 px-2 py-1" style="background:#e5efcf;color:#507228">01</span>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Brifi Tanımlayın" : "Define the Brief")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Kampanyanın amacını veya hazırlanmasını istediğiniz iletişim fikrini doğal dilde ifade edin." : "Describe the campaign objective or communication idea you want to prepare in natural language.")
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="p-4 rounded-4 bg-white border h-100">
                    <span class="badge mb-2 px-2 py-1" style="background:#e5efcf;color:#507228">02</span>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Mevcut Bağlamı Kullanın" : "Use Existing Context")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Pika Pilot, kampanya hazırlığında kullanılabilecek müşteri, ürün ve fırsat bağlamını brifle birlikte değerlendirebilir." : "Pika Pilot can evaluate relevant customer, product and opportunity context together with the brief during campaign preparation.")
                    </p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="150">
                <div class="p-4 rounded-4 bg-white border h-100">
                    <span class="badge mb-2 px-2 py-1" style="background:#e5efcf;color:#507228">03</span>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "Hazırlık Taslaklarını Oluşturun" : "Prepare Draft Components")</h5>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Hedef kitle kriterleri, kanal yaklaşımı ve iletişim içeriği için düzenlenebilir taslaklar hazırlanabilir." : "Editable drafts can be prepared for audience criteria, channel approach and communication content.")
                    </p>
                </div>
            </div>
            <div class="col-lg-6 col-md-6" data-aos="fade-up" data-aos-delay="200">
                <div class="p-4 rounded-4 bg-white border h-100">
                    <span class="badge mb-2 px-2 py-1" style="background:#e5efcf;color:#507228">04</span>
                    <h5 class="fw-bold mb-2 text-dark">@(tr ? "İçeriği Gözden Geçirin" : "Review the Content")</h5>
                    <p class="small ph-muted mb-0">

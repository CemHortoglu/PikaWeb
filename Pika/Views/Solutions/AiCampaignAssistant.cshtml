@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]="Pika AI "+(tr?"Kampanya Asistanı":"Campaign Assistant"); ViewData["MetaDescription"]=tr?"Pika AI ile sistem tarafından hesaplanmış müşteri ve ürün bağlamını açıklayın, kampanya yaklaşımı ve içerik taslakları hazırlayın; yürütme kontrolünü kullanıcıda tutun.":"Use Pika AI to explain system-calculated customer/product context and prepare campaign or content drafts while keeping execution under user control."; ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">Platform · Pika AI</span><h1>@(tr?"AI'yı kararın yerine değil, kararın yanında kullanın.":"Use AI beside the decision, not instead of it.")</h1><p>@(tr?"Pika AI; sistem tarafından hesaplanan müşteri ve ürün bağlamını açıklama, özetleme, kampanya yaklaşımı hazırlama ve içerik taslağı üretme gibi görevlerde kullanıcıya yardımcı olan destek katmanıdır. Temel analitik metriklerin veya kullanıcı yetkisinin yerine geçmez.":"Pika AI is an assistance layer for explaining and summarizing system-calculated customer/product context and preparing campaign approaches or content drafts. It does not replace core analytics or user authorization.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/pika-pilot-ai-kampanya-asistani">@(tr?"AI Rehberi":"AI Guide")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_pika-pilot-ai-kampanya-asistani_16.png" alt="@(tr?"Pika AI Kampanya Asistanı ekranı":"Pika AI Campaign Assistant screen")" width="1200" height="760" /><figcaption>@(tr?"Gerçek ürün görünümü: Pika AI açıklama ve kampanya hazırlığında yardımcı katmandır.":"Product view: Pika AI assists with explanation and campaign preparation.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-columns"><div class="pk-feature"><h3>@(tr?"Açıkla":"Explain")</h3><p>@(tr?"Hesaplanmış müşteri bağlamını daha okunabilir bir dille özetlemeye yardımcı olur.":"Helps summarize calculated customer context in more readable language.")</p></div><div class="pk-feature"><h3>@(tr?"Yaklaşım hazırla":"Prepare approach")</h3><p>@(tr?"Fırsat ve hedef kitle bağlamından kampanya yaklaşımı veya mesaj çerçevesi hazırlamaya yardımcı olabilir.":"Can help prepare a campaign approach or messaging frame from opportunity and audience context.")</p></div><div class="pk-feature"><h3>@(tr?"Taslak üret":"Draft")</h3><p>@(tr?"İçerik taslakları üretir; gerçek ürün verisi, izin ve yayınlama kontrolleri ayrı kalır.":"Produces content drafts while product evidence, consent and publishing controls remain separate.")</p></div></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">System calculated vs AI generated</span><h2>@(tr?"Kaynağı belli olmayan 'akıllı' sonuç üretmeyin.":"Do not blur evidence into unexplained 'smart' output.")</h2></div><p class="pk-lead">@(tr?"Müşteri değeri, alışveriş ritmi veya başka temel analitikler sistem hesaplaması olduğunda bu kaynak ayrı tutulmalıdır. AI bu bağlamı yorumlayabilir; ancak hesaplanmamış bir skoru veya nedensellik iddiasını gerçekmiş gibi eklememelidir.":"When customer value, purchase rhythm or other core analytics are system-calculated, that source should remain distinct. AI may interpret the context but should not invent an uncalculated score or causal claim.")</p></div></section>
<section class="pk-section"><div class="pk-container pk-screen-band"><img src="/wiki/assets/images/img_ai-musteri-ozeti_8.png" alt="@(tr?"Pika AI müşteri özeti":"Pika AI customer summary")" loading="lazy" width="1200" height="760" /><div><span class="pk-eyebrow">@(tr?"İnsan kontrolü":"Human control")</span><h2>@(tr?"Taslak hazırlanabilir; gönderim otomatik varsayılmaz.":"A draft can be prepared; execution is not assumed.")</h2><p class="pk-lead">@(tr?"AI çıktısı kullanıcı tarafından gözden geçirilir. Hedef kitle, izin, kanal, zamanlama ve yayınlama kararı Campaign/Journey ve ilgili ürün kontrollerinde kalır.":"AI output is reviewed by the user. Audience, consent, channel, timing and publishing remain under Campaign/Journey and related product controls.")</p><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/campaign-manager":"/en/platform/campaign-manager")">Campaign Manager</a></div></div></section>

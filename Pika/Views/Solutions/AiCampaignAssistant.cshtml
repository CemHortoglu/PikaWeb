@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]="Pika AI "+(tr?"Kampanya Asistanı":"Campaign Assistant");
    ViewData["MetaDescription"]=tr?"Pika AI ile sistem tarafından hesaplanmış müşteri, ürün ve fırsat bağlamını açıklayın; kampanya yaklaşımı ve içerik taslakları hazırlayın; yürütme kontrolünü kullanıcıda tutun.":"Use Pika AI to explain system-calculated customer, product and opportunity context and prepare campaign approaches or content drafts while keeping execution under user control.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">Platform · Pika AI</span><h1>@(tr?"AI'yı kararın yerine değil, kararın yanında kullanın.":"Use AI beside the decision, not instead of it.")</h1><p>@(tr?"Pika AI; sistem tarafından hesaplanan müşteri, ürün ve fırsat bağlamını açıklama, özetleme, kampanya yaklaşımı hazırlama ve içerik taslağı üretme gibi görevlerde kullanıcıya yardımcı olan destek katmanıdır. Müşteri değerini veya satın alma ritmini kendiliğinden icat etmez; izin ve yayınlama kontrolünü devralmaz.":"Pika AI is an assistance layer for explaining and summarizing system-calculated customer, product and opportunity context and preparing campaign approaches or content drafts. It does not invent core analytics or take over consent and publishing control.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Pika AI'ı Canlı Görün":"See Pika AI Live")</button><a class="pk-btn pk-btn-ghost" href="/wiki/pika-pilot-ai-kampanya-asistani">@(tr?"AI rehberi":"AI guide")</a></div><div class="pk-hero-note"><i class="ri-shield-check-line"></i><span>@(tr?"System calculated ve AI generated sonuçların kaynağı birbirinden ayrılmalıdır." : "System-calculated and AI-generated outputs should remain distinguishable by source.")</span></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_pika-pilot-ai-kampanya-asistani_16.png" alt="@(tr?"Pika AI Kampanya Asistanı ekranı":"Pika AI Campaign Assistant screen")" width="1200" height="760" /><div class="pk-stage-caption"><strong>Pika AI</strong><span>@(tr?"Açıkla · Özetle · Taslak hazırla":"Explain · Summarize · Draft")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-file-search-line"></i><div><strong>@(tr?"Açıklama":"Explanation")</strong><small>@(tr?"Kanıtı okunabilir hale getir":"Make evidence readable")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-quill-pen-line"></i><div><strong>@(tr?"Taslak":"Draft")</strong><small>@(tr?"İçerik hazırlığını hızlandır":"Accelerate content preparation")</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-user-follow-line"></i><div><strong>@(tr?"İnsan kontrolü":"Human control")</strong><small>@(tr?"Son karar kullanıcıda":"Final decision stays with the user")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Tanım":"Definition")</span><h2>@(tr?"Pika AI ne yapar?":"What does Pika AI do?")</h2></div><p class="pk-lead">@(tr?"Pika AI, Pika'nın deterministik hesaplama ve ürün verilerinin üstüne açıklama ve üretkenlik desteği ekler. Hesaplanan metriğin kaynağını değiştirmez; müşteri, ürün veya fırsat bağlamını kullanıcı için daha anlaşılır hale getirebilir ve bu bağlamdan iletişim taslağı oluşturabilir.":"Pika AI adds explanation and productivity support on top of Pika's deterministic calculations and product data. It does not change the source of calculated metrics; it can make customer, product or opportunity context easier to understand and draft communication from that context.")</p></div><div class="pk-intel-grid"><article class="pk-intel-panel"><span class="pk-intel-number">01</span><div class="pk-intel-icon"><i class="ri-file-search-line"></i></div><h3>@(tr?"Açıkla":"Explain")</h3><p>@(tr?"Müşteri, ürün veya fırsat ekranındaki hesaplanmış bağlamı daha okunabilir iş dilinde özetlemeye yardımcı olun." : "Help summarize calculated customer, product or opportunity context in more readable business language.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">02</span><div class="pk-intel-icon"><i class="ri-lightbulb-line"></i></div><h3>@(tr?"Yaklaşım hazırla":"Prepare an approach")</h3><p>@(tr?"Fırsatın türü ve hedef kitle bağlamından kampanya yaklaşımı, mesaj çerçevesi veya iletişim fikri hazırlamaya yardımcı olabilir." : "Can help prepare a campaign approach, messaging frame or communication idea from opportunity and audience context.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">03</span><div class="pk-intel-icon"><i class="ri-quill-pen-line"></i></div><h3>@(tr?"Taslak üret":"Draft")</h3><p>@(tr?"İçerik taslağı üretir; hedef kitle, izin, kanal, kampanya ayarı ve yayınlama kararı ayrı sistem/kullanıcı kontrollerinde kalır." : "Produces content drafts while audience, consent, channel, campaign settings and publishing decisions remain separate system/user controls.")</p></article></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">System calculated vs AI generated</span><h2>@(tr?"Kaynağı belli olmayan 'akıllı' sonuç üretmeyin.":"Do not blur evidence into unexplained 'smart' output.")</h2></div><p class="pk-lead">@(tr?"Pika'nın güvenilirliği, bir bilginin nereden geldiğinin anlaşılabilmesine bağlıdır. Satın alma ritmi, gerçekleşmiş satış, segment veya başka sistem hesaplamaları AI tarafından üretilmiş gibi görünmemelidir; AI yorumu da deterministik sonuç gibi sunulmamalıdır.":"Pika's trustworthiness depends on making information sources understandable. Purchase rhythm, observed sales, segments and other system calculations should not look AI-generated; AI interpretation should not be presented as deterministic fact.")</p></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-calculator-line"></i><div><strong>@(tr?"System calculated":"System calculated")</strong><span>@(tr?"Kurallar, analitik hesaplama ve kaynak veriden gelen deterministik sonuçlar." : "Deterministic outputs from rules, analytics calculations and source data.")</span></div></div><div class="pk-control-step"><i class="ri-database-2-line"></i><div><strong>@(tr?"Observed data":"Observed data")</strong><span>@(tr?"Gerçekleşmiş işlem, müşteri, ürün ve etkileşim kayıtları." : "Observed transaction, customer, product and engagement records.")</span></div></div><div class="pk-control-step"><i class="ri-sparkling-line"></i><div><strong>@(tr?"AI generated":"AI generated")</strong><span>@(tr?"Özet, açıklama, metin veya yaklaşım taslağı gibi üretken AI çıktıları." : "Generative outputs such as summaries, explanations, copy or approach drafts.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-user-follow-line"></i><div><strong>@(tr?"Human decision":"Human decision")</strong><span>@(tr?"Kullanıcının iş kuralı, marka dili ve müşteri ilişkisine göre verdiği son karar." : "The final decision made according to business rules, brand language and customer relationship context.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Müşteri bağlamı":"Customer context")</span><h2>@(tr?"Bir müşterinin verisini tekrar okumak yerine özetini anlayın.":"Understand the customer summary without rereading every field.")</h2></div><p class="pk-lead">@(tr?"Pika 360 ve Customer Intelligence gibi alanlarda çok sayıda sinyal aynı müşteriye ait olabilir. AI özet, bu sinyalleri daha okunabilir hale getirirken kaynak hesaplamaların yerini almamalıdır.":"Pika 360 and Customer Intelligence may expose multiple signals around one customer. AI summaries can make them easier to consume without replacing source calculations.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_ai-musteri-ozeti_8.png" alt="@(tr?"Pika AI müşteri özeti":"Pika AI customer summary")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"AI müşteri özeti":"AI customer summary")</small><h3>@(tr?"Dağınık sinyalleri iş dilinde özetleyin":"Summarize scattered signals in business language")</h3><p>@(tr?"Özet; hesaplanmış müşteri bağlamının okunmasını hızlandırır, fakat yeni bir gerçek veya doğrulanmamış skor yaratmamalıdır." : "The summary accelerates understanding of calculated context without creating new facts or unverified scores.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_pika-360_7.png" alt="@(tr?"Pika 360 müşteri görünümü":"Pika 360 customer view")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Pika 360</small><h3>@(tr?"AI'nın dayandığı bağlamı görün":"See the context AI is working from")</h3><p>@(tr?"Profil, işlem, segment ve fırsat bağlamının gerçek ürün ekranında görünür olması AI açıklamasının denetlenebilirliğini artırır." : "Keeping profile, transaction, segment and opportunity context visible improves the auditability of AI explanations.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Fırsattan taslağa":"From opportunity to draft")</span><h2>@(tr?"AI, fırsatın nedenini içerik hazırlığına taşısın; kampanyayı kendi başına yayınlamasın.":"Let AI carry the reason behind an opportunity into content preparation — not publish campaigns on its own.")</h2></div><p class="pk-lead">@(tr?"Günün Fırsatları'nda bir durum incelendikten sonra AI, fırsat ve müşteri bağlamından kampanya yaklaşımı veya metin taslağı hazırlamaya yardımcı olabilir. Hedef kitle, izin, kanal, zamanlama ve yayınlama kararı Campaign/Journey ve kullanıcı kontrollerinde kalır.":"After an opportunity is reviewed, AI can assist with a campaign approach or copy draft based on opportunity and customer context. Audience, consent, channel, timing and publishing remain under Campaign/Journey and user controls.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Fırsat":"Opportunity")</strong><span>@(tr?"Neden aksiyon düşünüyoruz?":"Why consider action?")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-user-search-line"></i><strong>@(tr?"Bağlam":"Context")</strong><span>@(tr?"Müşteri ve ürün kanıtı":"Customer and product evidence")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-magic-line"></i><strong>AI</strong><span>@(tr?"Özet ve yaklaşım":"Summary and approach")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-file-edit-line"></i><strong>@(tr?"Taslak":"Draft")</strong><span>@(tr?"İçerik önerisi":"Content suggestion")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-user-follow-line"></i><strong>@(tr?"Kullanıcı kontrolü":"User review")</strong><span>@(tr?"Düzenle · Onayla · Reddet":"Edit · Approve · Reject")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-route-line"></i><strong>Campaign / Journey</strong><span>@(tr?"Kontrollü yürütme":"Controlled execution")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"AI sınırları":"AI boundaries")</span><h2>@(tr?"İyi AI deneyimi, ne yapmadığını da açıkça anlatır.":"A good AI experience is clear about what it does not do.")</h2></div><p class="pk-lead">@(tr?"Pika AI destek katmanıdır. Kullanıcıların güvenilir karar verebilmesi için otomatik karar, deterministik hesaplama ve üretken metin arasında sınır açık kalmalıdır.":"Pika AI is an assistance layer. To support trustworthy decisions, boundaries between automated decisioning, deterministic calculation and generative text should remain clear.")</p></div><div class="pk-columns"><div class="pk-feature"><i class="ri-close-circle-line"></i><h3>@(tr?"Temel analitiği uydurmaz":"Does not invent core analytics")</h3><p>@(tr?"Müşteri değeri, ritim veya ürün kanıtı hesaplanmadıysa bunları gerçek veri gibi üretmemelidir." : "If customer value, rhythm or product evidence was not calculated, AI should not present it as real data.")</p></div><div class="pk-feature"><i class="ri-shield-user-line"></i><h3>@(tr?"Yetkiyi devralmaz":"Does not take over authorization")</h3><p>@(tr?"AI çıktısı kullanıcı/rol ve ürün yetkilendirme mekanizmalarının yerine geçmez." : "AI output does not replace user/role and product authorization mechanisms.")</p></div><div class="pk-feature"><i class="ri-send-plane-line"></i><h3>@(tr?"Kendi başına yayınlamaz":"Does not publish by itself")</h3><p>@(tr?"Kampanya ve Journey yayınlama, izin ve yürütme kontrolü ayrı operasyon adımlarında kalır." : "Campaign/Journey publishing, consent and execution controls remain separate operational steps.")</p></div></div><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/gunun-firsatlari":"/en/platform/opportunities")">@(tr?"Günün Fırsatları'ndan başlayın":"Start from Daily Opportunities")</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/campaign-manager":"/en/platform/campaign-manager")">Campaign Manager</a></div></div></section>

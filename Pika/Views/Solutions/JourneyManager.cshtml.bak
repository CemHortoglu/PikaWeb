@{
    var tr = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = tr ? "Journey Manager | Pika ile Otomasyon ve Müşteri Yolculuğu Yönetimi" : "Journey Manager | Automation & Customer Journey Management with Pika";
    ViewData["MetaDescription"] = tr ? "Pika Journey Manager ile davranış ve işlem bazlı otomatik akışlar kurun. Müşteri yolculuğunu SMS, WhatsApp, Email ve Push boyunca yönetin." : "Build automated flows based on behavior and transactions with Pika Journey Manager. Manage customer journeys across SMS, WhatsApp, Email and Push.";
    ViewData["MetaKeywords"] = "journey manager,müşteri yolculuğu,otomasyon,otomatik akış,trigger,marketing automation,pika";
}

<section class="pika-sol-hero">
    <div class="container">
        <nav class="pika-sol-breadcrumb" data-aos="fade-down" data-aos-duration="500">
            <a href="@Url.Action("Index", "Home")">@(tr ? "Ana Sayfa" : "Home")</a>
            <span class="sep">/</span>
            <a href="@Url.Action("Solutions", "Home")">@(tr ? "Çözümler" : "Solutions")</a>
            <span class="sep">/</span>
            <span>Journey Manager</span>
        </nav>
        <div class="pika-sol-hero-grid">
            <div data-aos="fade-right" data-aos-duration="700">
                <h1>@(tr ? "Journey Manager ile otomasyon akışlarını netleştirin" : "Clarify automation flows with Journey Manager")</h1>
                <p class="pika-sol-hero-desc">@(tr ? "Müşteri yolculuklarını görsel akışlarla planlayın, tetikleyicileri ve kanalları tek noktadan yönetin." : "Plan customer journeys visually and manage triggers and channels from a single point.")</p>
                <div class="pika-sol-hero-actions">
                    <button type="button" class="btn pika-btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i></button>
                    <a href="#features" class="btn pika-btn-ghost px-4 py-2">@(tr ? "Özellikleri İncele" : "Explore Features")</a>
                </div>
                <div class="pika-sol-hero-tags">
                    <span class="pika-sol-tag"><i class="ri-route-line"></i> @(tr ? "Görsel akış" : "Visual flow")</span>
                    <span class="pika-sol-tag"><i class="ri-flashlight-line"></i> @(tr ? "Event tetikleyici" : "Event triggers")</span>
                    <span class="pika-sol-tag"><i class="ri-loop-right-line"></i> @(tr ? "Otomasyon" : "Automation")</span>
                    <span class="pika-sol-tag"><i class="ri-share-forward-line"></i> @(tr ? "Çok kanallı" : "Multi-channel")</span>
                </div>
            </div>
            <div class="pika-sol-hero-visual" data-aos="fade-left" data-aos-duration="700" data-aos-delay="200">
                <div class="pika-sol-mock-row">
                    <div class="pika-sol-mock-block wide"><i class="ri-route-line"></i> Journey Builder</div>
                    <div class="pika-sol-mock-block"><i class="ri-flashlight-line"></i> Trigger</div>
                </div>
                <div class="pika-sol-mock-row">
                    <div class="pika-sol-mock-block"><i class="ri-mail-line"></i> Email</div>
                    <div class="pika-sol-mock-block"><i class="ri-message-2-line"></i> SMS</div>
                </div>
                <div class="pika-sol-mock-row">
                    <div class="pika-sol-mock-block wide"><i class="ri-bar-chart-line"></i> Journey Insights</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pika-sol-section">
    <div class="container">
        <div class="pika-sol-value-grid">
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500">
                <div class="pika-sol-value-icon"><i class="ri-flow-chart"></i></div>
                <h4>@(tr ? "Görsel akış tasarımı" : "Visual flow design")</h4>
                <p>@(tr ? "Journey adımlarını sürükle-bırak mantığıyla kurgulayın." : "Design journey steps with drag-and-drop clarity.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="100">
                <div class="pika-sol-value-icon"><i class="ri-flashlight-line"></i></div>
                <h4>@(tr ? "Event tetikleyiciler" : "Event triggers")</h4>
                <p>@(tr ? "Davranışa göre otomatik aksiyonlar başlatın." : "Trigger automated actions based on behavior.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="200">
                <div class="pika-sol-value-icon"><i class="ri-time-line"></i></div>
                <h4>@(tr ? "Zaman ve koşul kontrolü" : "Timing & conditions")</h4>
                <p>@(tr ? "Zamanlama, bekleme ve koşul bloklarını birlikte yönetin." : "Manage timing, delays, and conditional logic together.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="300">
                <div class="pika-sol-value-icon"><i class="ri-checkbox-circle-line"></i></div>
                <h4>@(tr ? "Performans görünürlüğü" : "Performance visibility")</h4>
                <p>@(tr ? "Journey adım bazında etkiyi ölçün." : "Measure impact step by step.")</p>
            </div>
        </div>
    </div>
</section>

<section class="pika-sol-section pika-sol-section-alt">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Tek seferlik kampanyadan sürekli otomasyona geçin" : "Move from one-off campaigns to always-on automation")</h2>
        <p class="pika-sol-section-desc" data-aos="fade-up" data-aos-delay="100">@(tr ? "Journey Manager, müşteriyi doğru zamanda doğru kanala yönlendiren sürekli akışlar oluşturur." : "Journey Manager creates continuous flows that guide customers to the right channel at the right time.")</p>
    </div>
</section>

<section class="pika-sol-section" id="features">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Journey yönetimi için temel yetenekler" : "Core capabilities for journey orchestration")</h2>
        <div class="pika-sol-card-grid">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-route-line"></i></div>
                <h4>@(tr ? "Akış tasarım stüdyosu" : "Flow builder")</h4>
                <p>@(tr ? "Journey adımlarını görsel olarak tasarlayın." : "Design journey steps visually.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-radar-line"></i></div>
                <h4>@(tr ? "Davranış tetikleri" : "Behavior triggers")</h4>
                <p>@(tr ? "Event, segment ve zaman tetikleri ile akış başlatın." : "Start flows with event, segment, or time triggers.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-share-forward-line"></i></div>
                <h4>@(tr ? "Çok kanallı adımlar" : "Multi-channel steps")</h4>
                <p>@(tr ? "Email, SMS, WhatsApp ve Push adımlarını aynı akışta kullanın." : "Use Email, SMS, WhatsApp, and Push in the same flow.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-git-branch-line"></i></div>
                <h4>@(tr ? "Koşullu dallar" : "Conditional branches")</h4>
                <p>@(tr ? "Farklı davranışlara göre akışı bölün." : "Split flows based on behavior.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-bar-chart-2-line"></i></div>
                <h4>@(tr ? "Journey analitiği" : "Journey analytics")</h4>
                <p>@(tr ? "Adım performansını ve dönüşümü izleyin." : "Track step performance and conversion.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-alert-line"></i></div>
                <h4>@(tr ? "Hata ve duraklama kontrolü" : "Error handling")</h4>
                <p>@(tr ? "Akışları güvenle durdurun veya yeniden başlatın." : "Pause or restart flows safely.")</p>
            </div>
        </div>
    </div>
</section>

<section class="pika-sol-section pika-sol-section-alt">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Journey Manager nasıl çalışır?" : "How does Journey Manager work?")</h2>
        <div class="pika-sol-steps">
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="100"><div class="pika-sol-step-num"></div><p>@(tr ? "Başlangıç eventini veya segmenti seçin." : "Select the starting event or segment.")</p></div>
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="200"><div class="pika-sol-step-num"></div><p>@(tr ? "Kanalları ve içerikleri Content Studio ile eşleyin." : "Map channels and content via Content Studio.")</p></div>
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="300"><div class="pika-sol-step-num"></div><p>@(tr ? "Koşulları ve bekleme sürelerini tanımlayın." : "Define conditions and wait times.")</p></div>
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="400"><div class="pika-sol-step-num"></div><p>@(tr ? "Analytics & Reporting ile iyileştirme yapın." : "Optimize with Analytics & Reporting.")</p></div>
        </div>
    </div>
</section>

<section class="pika-sol-section">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Örnek kullanım senaryoları" : "Example use cases")</h2>
        <div class="pika-sol-usecase-grid">
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="50"><i class="ri-check-line"></i> @(tr ? "Hoş geldin akışı" : "Welcome journeys")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="100"><i class="ri-check-line"></i> @(tr ? "Sepet terk akışı" : "Cart abandonment flows")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="150"><i class="ri-check-line"></i> @(tr ? "Sadakat puanı hatırlatmaları" : "Loyalty point reminders")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="200"><i class="ri-check-line"></i> @(tr ? "Riskli müşteri geri kazanımı" : "Churn win-back")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="250"><i class="ri-check-line"></i> @(tr ? "Doğum günü kutlamaları" : "Birthday moments")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="300"><i class="ri-check-line"></i> @(tr ? "Cross-sell yolculukları" : "Cross-sell journeys")</div>
        </div>
    </div>
</section>

<section class="pika-sol-section pika-sol-section-alt">
    <div class="container" data-aos="fade-up">
        <div class="pika-sol-highlight">
            <h3>@(tr ? "Journey Manager, Pika’nın otomasyon motorudur" : "Journey Manager is the automation engine of Pika")</h3>
            <p>@(tr ? "Audience Manager segmentlerini kullanır, Content Studio içeriklerini çalıştırır ve Campaign Manager planlarıyla hizalanır." : "It uses Audience Manager segments, activates Content Studio content, and aligns with Campaign Manager plans.")</p>
            <p class="mt-3"><strong>@(tr ? "İlgili modüller: " : "Related modules: ")</strong>
                <a href="@Url.Action("AudienceManager", "Solutions")">Audience Manager</a>,
                <a href="@Url.Action("ContentStudio", "Solutions")">Content Studio</a>,
                <a href="@Url.Action("CampaignManager", "Solutions")">Campaign Manager</a>,
                <a href="@Url.Action("Reporting", "Solutions")">Analytics & Reporting</a>.
            </p>
        </div>
    </div>
</section>

<section class="pika-sol-section">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Journey Manager hakkında sık sorulan sorular" : "Journey Manager FAQs")</h2>
        <div class="accordion faq-pro-accordion" id="journeyFaq">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#journeyFaq1" aria-expanded="true" aria-controls="journeyFaq1">@(tr ? "Akışlar gerçek zamanlı tetiklenir mi?" : "Are journeys triggered in real time?")</button>
                </h2>
                <div id="journeyFaq1" class="accordion-collapse collapse show" data-bs-parent="#journeyFaq">
                    <div class="accordion-body">@(tr ? "Evet, event tetikleyicileri ile anlık akışlar başlatılabilir." : "Yes, event triggers can start journeys instantly.")</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#journeyFaq2" aria-expanded="false" aria-controls="journeyFaq2">@(tr ? "Journey adımları durdurulabilir mi?" : "Can journey steps be paused?")</button>
                </h2>
                <div id="journeyFaq2" class="accordion-collapse collapse" data-bs-parent="#journeyFaq">
                    <div class="accordion-body">@(tr ? "Akışlar adım bazında durdurulabilir ve yeniden başlatılabilir." : "Flows can be paused and restarted at the step level.")</div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#journeyFaq3" aria-expanded="false" aria-controls="journeyFaq3">@(tr ? "Kampanya planlarıyla nasıl hizalanır?" : "How does it align with campaign plans?")</button>
                </h2>
                <div id="journeyFaq3" class="accordion-collapse collapse" data-bs-parent="#journeyFaq">
                    <div class="accordion-body">@(tr ? "Campaign Manager planları Journey Manager akışlarına bağlanabilir." : "Campaign Manager plans can be attached to Journey Manager flows.")</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pika-sol-cta-section">
    <div class="container" data-aos="fade-up">
        <h2>@(tr ? "Müşteri yolculuklarını tek panelde yönetin" : "Manage customer journeys in one panel")</h2>
        <p>@(tr ? "Journey Manager ile otomasyon akışlarını görünür ve ölçeklenebilir hale getirin." : "Make automation flows visible and scalable with Journey Manager.")</p>
        <div class="pika-sol-cta-actions">
            <button type="button" class="btn pika-btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i></button>
            <a href="@Url.Action("Contact", "Home")" class="btn pika-btn-ghost px-4 py-2">@(tr ? "Bizimle İletişime Geçin" : "Contact Us")</a>
        </div>
    </div>
</section>

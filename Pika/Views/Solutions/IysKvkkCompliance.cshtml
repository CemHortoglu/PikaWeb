@{
    var tr = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = tr ? "İYS ve KVKK Uyumlu Kampanya Yönetimi | Pika" : "Consent-Based Campaign Management | Pika";
    ViewData["MetaDescription"] = tr ? "Pika ile kampanya süreçlerinizi izin, onay ve uyumluluk kontrolleriyle birlikte yönetin. Email, SMS, WhatsApp ve push kampanyalarınızı daha kontrollü hale getirin." : "Manage your campaign processes with permission, approval and compliance controls with Pika. Make your email, SMS, WhatsApp and push campaigns more controlled.";
    ViewData["MetaKeywords"] = "iys uyumlu kampanya,kvkk kampanya yönetimi,izin yönetimi,uyumluluk,pika consent management";
}

<!-- HERO -->
<section class="pika-sol-hero" data-module="compliance">
    <div class="container">
        <nav class="pika-sol-breadcrumb" data-aos="fade-down" data-aos-duration="500">
            <a href="@(tr ? "/" : "/en/")">@(tr ? "Ana Sayfa" : "Home")</a>
            <span class="sep">/</span>
            <span>@(tr ? "İYS ve KVKK Uyumlu Kampanya Yönetimi" : "Consent-Based Campaign Management")</span>
        </nav>
        <div class="pika-sol-hero-grid">
            <div data-aos="fade-right" data-aos-duration="700">
                <h1>@(tr ? "İYS ve KVKK Uyumlu Kampanya Yönetimi" : "Consent-Based Campaign Management")</h1>
                <p class="pika-sol-hero-desc">@(tr ? "Pika ile kampanya süreçlerinizi izin, onay ve uyumluluk kontrolleriyle birlikte yönetin. Email, SMS, WhatsApp ve push kampanyalarınızı daha güvenli, takip edilebilir ve kontrollü hale getirin." : "Manage your campaign processes with permission, approval and compliance controls using Pika. Make your email, SMS, WhatsApp and push campaigns more secure, traceable and controlled.")</p>
                <div class="pika-sol-hero-actions">
                    <button type="button" class="btn pika-btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i></button>
                </div>
                <div class="pika-sol-hero-tags">
                    <span class="pika-sol-tag"><i class="ri-shield-check-line"></i> @(tr ? "İzin kontrolleri" : "Permission controls")</span>
                    <span class="pika-sol-tag"><i class="ri-lock-line"></i> @(tr ? "Uyumluluk desteği" : "Compliance support")</span>
                    <span class="pika-sol-tag"><i class="ri-file-list-line"></i> @(tr ? "Kayıt ve takip" : "Logging & tracking")</span>
                </div>
            </div>
            <div class="pika-sol-hero-scene" data-aos="fade-left" data-aos-duration="700" data-aos-delay="200">
                <div class="pika-sol-scene-main">
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block wide"><i class="ri-shield-check-line"></i> @(tr ? "İzin Kontrol" : "Permission Check")</div>
                    </div>
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block"><i class="ri-mail-line"></i> Email</div>
                        <div class="pika-sol-scene-block"><i class="ri-message-2-line"></i> SMS</div>
                        <div class="pika-sol-scene-block"><i class="ri-whatsapp-line"></i> WhatsApp</div>
                    </div>
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block wide"><i class="ri-checkbox-circle-line"></i> @(tr ? "Gönderim Onayı" : "Send Approval")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- PROBLEM -->
<section class="pika-sol-section" style="background:var(--pika-bg2)">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h2 class="pika-h2 fw-bold">@(tr ? "Kampanya üretmek kolay. Doğru kişiye izinli gönderim yapmak kritiktir." : "Creating campaigns is easy. Sending to the right person with consent is critical.")</h2>
            <p class="ph-muted mx-auto" style="max-width:700px">@(tr ? "Pazarlama kampanyalarında hız kadar izin yönetimi ve kayıt takibi de önemlidir. Pika, kampanya oluşturma, hedef kitle seçimi ve gönderim süreçlerini izin kontrolleriyle birlikte ele almanıza yardımcı olur." : "In marketing campaigns, permission management and record tracking are as important as speed. Pika helps you handle campaign creation, audience selection and delivery processes together with permission controls.")</p>
        </div>
    </div>
</section>

<!-- ÖZELLİKLER -->
<section class="pika-sol-section">
    <div class="container">
        <div class="row g-4" data-aos="fade-up">
            @{
                var cards = tr
                    ? new (string t, string d, string i)[] {
                        ("İzin bazlı hedefleme", "Kampanyalarınızı izin durumu uygun müşteri gruplarıyla planlayın.", "ri-shield-check-line"),
                        ("Kanal bazlı kontrol", "Email, SMS ve WhatsApp gibi farklı kanallar için izin durumlarını dikkate alın.", "ri-share-forward-line"),
                        ("Gönderim öncesi kontrol", "Kampanya yayına alınmadan önce hedef kitle ve kanal ayarlarını kontrol edin.", "ri-checkbox-circle-line"),
                        ("Kayıt ve takip", "Kampanya süreçlerinizi raporlanabilir ve geriye dönük incelenebilir hale getirin.", "ri-file-list-line"),
                        ("AI ile kontrollü üretim", "AI tarafından oluşturulan kampanya içeriklerini kullanıcı onayıyla yayına alın.", "ri-robot-line"),
                        ("Merkezi yönetim", "İzin, segment, kampanya ve raporlama süreçlerini tek platformda yönetin.", "ri-layout-grid-line")
                    }
                    : new (string t, string d, string i)[] {
                        ("Permission-based targeting", "Plan your campaigns with customer groups that have appropriate consent.", "ri-shield-check-line"),
                        ("Channel-based control", "Consider permission statuses for different channels like email, SMS and WhatsApp.", "ri-share-forward-line"),
                        ("Pre-send control", "Check audience and channel settings before launching a campaign.", "ri-checkbox-circle-line"),
                        ("Logging and tracking", "Make your campaign processes reportable and retrospectively reviewable.", "ri-file-list-line"),
                        ("AI with controlled production", "Publish AI-generated campaign content with user approval.", "ri-robot-line"),
                        ("Centralized management", "Manage permission, segment, campaign and reporting processes on a single platform.", "ri-layout-grid-line")
                    };
            }
            @foreach (var c in cards)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="ph-module-card">
                        <div class="ph-module-icon"><i class="@c.i"></i></div>
                        <h6 class="fw-bold mb-2">@c.t</h6>
                        <p class="small ph-muted mb-0">@c.d</p>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a href="@Url.RouteUrl("AiCampaignAssistant", new { culture = ViewContext.RouteData.Values["culture"] ?? "tr" })" class="btn pika-btn-primary px-4 py-2">@(tr ? "AI Kampanya Asistanını İncele" : "Explore AI Campaign Assistant") <i class="ri-arrow-right-line"></i></a>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="ph-cta-section">
    <div class="container text-center" data-aos="fade-up">
        <h2 class="ph-cta-title text-white mx-auto" style="max-width:680px">@(tr ? "Uyumlu Kampanya Yönetimini Keşfedin" : "Discover Compliant Campaign Management")</h2>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <button type="button" class="ph-btn-light" data-bs-toggle="modal" data-bs-target="#demoModal"><span>@(tr ? "Demo Talep Et" : "Request a Demo")</span> <i class="ri-arrow-right-up-line"></i></button>
        </div>
    </div>
</section>

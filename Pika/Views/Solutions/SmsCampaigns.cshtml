@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]="SMS | "+(tr?"Pika Kanalları":"Pika Channels");
    ViewData["MetaDescription"]=tr?"Pika'da SMS kanalını hedef kitle, izin, opt-out, zamanlama ve Campaign/Journey bağlamıyla kullanın; kısa ve zaman duyarlı iletişimi kontrollü yürütün ve ölçün.":"Use SMS in Pika with audience, consent, opt-out, timing and Campaign/Journey context for concise, time-sensitive communication and measurement.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">@(tr?"Kanallar · SMS":"Channels · SMS")</span><h1>@(tr?"Kısa ve zaman duyarlı iletişimi doğru müşteri bağlamıyla buluşturun.":"Use concise, time-sensitive communication with the right customer context.")</h1><p>@(tr?"SMS, Pika'nın Campaign ve Journey kararlarını uygulayabildiği iletişim kanallarından biridir. Kanal seçimi yalnız mesajın kısa olmasıyla değil; hedef kitle, ticari neden, izin/opt-out, ulaşılabilirlik ve zamanlama bağlamıyla birlikte değerlendirilir.":"SMS is one of Pika's Campaign and Journey execution channels. Channel choice is based on audience, business reason, consent/opt-out, reachability and timing context, not simply message length.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"SMS Akışını Canlı Görün":"See SMS Flow Live")</button><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/campaign-manager":"/en/platform/campaign-manager")">Campaign Manager</a></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_izin-kanal-zamanlama_25.png" alt="@(tr?"Pika SMS için izin kanal ve zamanlama ekranı":"Pika consent channel and timing screen for SMS")" width="1200" height="760" /><div class="pk-stage-caption"><strong>SMS</strong><span>@(tr?"Kitle · İzin · Zamanlama · Aksiyon":"Audience · Consent · Timing · Action")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-message-2-line"></i><div><strong>@(tr?"Kısa aksiyon":"Concise action")</strong><small>@(tr?"Zaman duyarlı kullanım":"Time-sensitive use")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-shield-check-line"></i><div><strong>@(tr?"Uygunluk":"Eligibility")</strong><small>Opt-out · IYS</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-timer-line"></i><div><strong>@(tr?"Zaman":"Timing")</strong><small>@(tr?"Doğru akış adımı":"Right flow step")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"SMS'in Pika'daki rolü":"SMS's role in Pika")</span><h2>@(tr?"Telefon numarası olması gönderim gerekçesi değildir.":"Having a phone number is not a reason to send.")</h2></div><p class="pk-lead">@(tr?"Pika'da SMS önce bir müşteri/fırsat veya kampanya kararına bağlanır. Ardından ilgili hedef kitlede telefon bilgisinin bulunması, izin/opt-out durumu ve zamanlama değerlendirilir. Uygun değilse kanalın seçilmemesi normal ve güvenli bir sonuçtur.":"In Pika, SMS first connects to a customer/opportunity or campaign decision. Phone availability, consent/opt-out and timing are then evaluated for the audience. If the channel is not eligible, not choosing SMS is a normal and safe outcome.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Neden":"Reason")</strong><span>@(tr?"Fırsat veya iş amacı":"Opportunity or business purpose")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-group-line"></i><strong>Audience</strong><span>@(tr?"Kime?":"Who?")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-phone-line"></i><strong>@(tr?"Telefon":"Phone")</strong><span>@(tr?"Kullanılabilir iletişim bilgisi":"Available contact data")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-shield-check-line"></i><strong>@(tr?"İzin":"Consent")</strong><span>Opt-out · IYS</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-timer-line"></i><strong>@(tr?"Zaman":"Timing")</strong><span>@(tr?"Campaign / Journey bağlamı":"Campaign / Journey context")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-message-2-line"></i><strong>SMS</strong><span>@(tr?"Uygunsa gönderim aksiyonu":"Delivery action if eligible")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Ne zaman SMS?":"When SMS?")</span><h2>@(tr?"Kısa, doğrudan ve zaman duyarlı olması gereken aksiyonlarda.":"When the action needs to be concise, direct and time-sensitive.")</h2></div><p class="pk-lead">@(tr?"SMS her mesaj türü için varsayılan kanal değildir. Uzun içerik, zengin görsel veya ayrıntılı açıklama gereken bir senaryoda Email daha uygun olabilir; sürekli müşteri akışında SMS yalnız Journey'nin uygun adımında kullanılabilir. Kanal seçimi müşteri ve mesaj bağlamıyla birlikte yapılmalıdır.":"SMS is not the default channel for every message. Email may be better for rich or detailed content, while in ongoing flows SMS should appear only at an appropriate Journey step. Channel choice should follow customer and message context.")</p></div><div class="pk-columns"><div class="pk-feature"><i class="ri-timer-flash-line"></i><h3>@(tr?"Zaman duyarlı":"Time-sensitive")</h3><p>@(tr?"Müşterinin hızlı görmesi gereken, kısa ve açık iletişim senaryolarında değerlendirin." : "Consider SMS for concise messages that should be noticed quickly.")</p></div><div class="pk-feature"><i class="ri-route-line"></i><h3>@(tr?"Akış adımı":"Flow step")</h3><p>@(tr?"Journey içindeki tetikleyici ve kararların sonucunda uygun zamanda SMS aksiyonu çalıştırın." : "Run SMS at the appropriate point after Journey triggers and decisions.")</p></div><div class="pk-feature"><i class="ri-filter-3-line"></i><h3>@(tr?"Bağlamlı hedefleme":"Contextual targeting")</h3><p>@(tr?"Kitleyi yalnız 'telefonu olanlar' diye değil; segment, fırsat ve iş kuralı bağlamıyla seçin." : "Select audiences through segment, opportunity and business-rule context, not merely 'has a phone number'.")</p></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">SMS + Journey</span><h2>@(tr?"Kanalı akışa bağlayın; akışı kanala göre kurmayın.":"Fit the channel into the journey, not the journey around the channel.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Journey içindeki SMS adımı, önceki tetikleyici, karar ve bekleme adımlarının sonucudur. Müşteri koşulu değiştiğinde, kanal uygun olmadığında veya iletişime gerek kalmadığında akış farklı bir yola ilerleyebilir.":"An SMS step in a Journey is the result of earlier triggers, decisions and waits. If customer context changes, the channel is ineligible or communication is no longer needed, the flow can follow a different path.")</p><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/journey-manager":"/en/platform/journey-manager")">Journey Manager</a></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_journey-karar-kurallari_19.png" alt="@(tr?"Pika Journey karar kuralları ve SMS kanal bağlamı":"Pika Journey decision rules and SMS context")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Journey Decision</small><h3>@(tr?"SMS'e gelmeden önce karar verin":"Make the decision before the SMS step")</h3><p>@(tr?"Müşteri segmenti, izin ve desteklenen davranış koşulları akışın SMS adımına ulaşıp ulaşmayacağını belirleyebilir." : "Segment, consent and supported behavior conditions can determine whether the customer reaches the SMS step.")</p></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Fırsattan SMS'e":"From opportunity to SMS")</span><h2>@(tr?"Önce fırsatın nedenini doğrulayın, sonra SMS'in uygun kanal olup olmadığına bakın.":"Validate why the opportunity matters, then decide whether SMS is the right channel.")</h2></div><p class="pk-lead">@(tr?"Tekrar satın alma veya geri kazanım gibi bir fırsat, SMS gönderme emri değildir. Kullanıcı fırsatın kanıtını ve müşteri bağlamını değerlendirir; iletişim gerekliyse Audience/Campaign/Journey ve Consent Management üzerinden SMS uygunluğu ayrıca ele alınır.":"A repeat-purchase or win-back opportunity is not an instruction to send SMS. The user reviews evidence and customer context; if communication is appropriate, SMS eligibility is considered through Audience/Campaign/Journey and Consent Management.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Fırsat":"Opportunity")</strong><span>@(tr?"Neden şimdi?":"Why now?")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-user-search-line"></i><strong>@(tr?"Müşteri":"Customer")</strong><span>@(tr?"Bağlamı incele":"Review context")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-user-follow-line"></i><strong>@(tr?"Karar":"Decision")</strong><span>@(tr?"İletişim gerekli mi?":"Is communication needed?")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-shield-check-line"></i><strong>@(tr?"Uygunluk":"Eligibility")</strong><span>@(tr?"İzin · Opt-out · Telefon":"Consent · Opt-out · Phone")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-message-2-line"></i><strong>SMS</strong><span>@(tr?"Uygunsa aksiyon":"Action if eligible")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>Analytics</strong><span>@(tr?"Sonucu değerlendir":"Review outcome")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">SMS → Measure</span><h2>@(tr?"Gönderim sayısını sonuç sanmayın.":"Do not confuse send count with outcome.")</h2></div><p class="pk-lead">@(tr?"SMS kanalında desteklenen delivery/engagement sonuçlarını Campaign veya Journey bağlamında değerlendirin. Satışla ilişkilendirme varsa attribution olarak yorumlayın; tek başına kampanyanın satışı yarattığını kanıtlamaz.":"Review supported SMS delivery/engagement outcomes within Campaign or Journey context. Where sales attribution exists, treat it as attribution rather than automatic proof that the campaign caused the sale.")</p></div><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/analytics":"/en/platform/analytics")">Analytics</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/consent-management":"/en/platform/consent-management")">Consent Management</a></div></div></section>

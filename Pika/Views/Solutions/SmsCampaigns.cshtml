                {
                    <p class="mb-0">Dispatch is not an outcome guarantee.</p>
                }
            </div>
        </div>
    </div>
</section>

@* ── 11 DELIVERY OUTCOME & MEASUREMENT ───────────────────────── *@
<section class="pika-sol-section">

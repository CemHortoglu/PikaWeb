@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]="SMS | "+(tr?"Pika Kanalları":"Pika Channels"); ViewData["MetaDescription"]=tr?"Pika'da SMS kanalını hedef kitle, izin, zamanlama ve Campaign/Journey bağlamıyla kullanın; kısa ve zaman duyarlı iletişimi kontrollü yürütün.":"Use SMS in Pika with audience, consent, timing and Campaign/Journey context for concise, time-sensitive communication."; ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">@(tr?"Kanallar · SMS":"Channels · SMS")</span><h1>@(tr?"Kısa ve zaman duyarlı iletişimi doğru hedef kitleyle buluşturun.":"Use concise, time-sensitive communication with the right audience.")</h1><p>@(tr?"SMS, Pika'nın Campaign ve Journey kararlarını uygulayabildiği iletişim kanallarından biridir. Kanal seçimi mesajın kısa olmasıyla değil; hedef kitle, izin/opt-out, ulaşılabilirlik ve zamanlama bağlamıyla birlikte değerlendirilir.":"SMS is one of Pika's Campaign and Journey execution channels. Channel choice depends on audience, consent/opt-out, reachability and timing context, not simply message length.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/campaign-manager":"/en/platform/campaign-manager")">Campaign Manager</a></div></div><div class="pk-proof" style="padding:30px"><span class="pk-eyebrow">SMS</span><h2 style="font-size:32px">@(tr?"Kanal kararı önce uygunlukla başlar.":"Channel decisions start with eligibility.")</h2><div class="pk-flow" style="grid-template-columns:repeat(3,1fr);margin-top:28px"><div class="pk-flow-item"><small>01</small><strong>@(tr?"Hedef kişi":"Recipient")</strong><span>@(tr?"Telefon bilgisi":"Phone data")</span></div><div class="pk-flow-item"><small>02</small><strong>@(tr?"İzin":"Consent")</strong><span>Opt-out · IYS</span></div><div class="pk-flow-item"><small>03</small><strong>@(tr?"Aksiyon":"Action")</strong><span>Campaign · Journey</span></div></div></div></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-columns"><div class="pk-feature"><h3>@(tr?"Zaman duyarlı kullanım":"Time-sensitive use")</h3><p>@(tr?"Kısa ve doğrudan iletişim gereken senaryolarda SMS'i uygun Campaign/Journey adımında kullanın.":"Use SMS at the appropriate Campaign/Journey step when communication needs to be concise and direct.")</p></div><div class="pk-feature"><h3>@(tr?"Segment ve fırsat bağlamı":"Audience & opportunity context")</h3><p>@(tr?"Kitleyi yalnız telefon numarası olanlar diye değil; segment, fırsat ve iş kuralı bağlamıyla seçin.":"Select audiences using segment, opportunity and business-rule context rather than simply 'has a phone number'.")</p></div><div class="pk-feature"><h3>@(tr?"İzin ve frekans":"Consent & frequency")</h3><p>@(tr?"Kanal uygunluğu ve müşteri iletişim tercihlerini gönderimden bağımsız ayrı kontroller olarak ele alın.":"Treat channel eligibility and customer communication preferences as separate pre-delivery controls.")</p></div></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">SMS + Journey</span><h2>@(tr?"Kanalı akışa bağlayın; akışı kanala göre kurmayın.":"Fit the channel into the journey, not the journey around the channel.")</h2></div><div><p class="pk-lead">@(tr?"Journey içindeki bir SMS adımı, önceki tetikleyici ve kararların sonucudur. Müşteri koşulu değiştiğinde veya kanal uygun değilse akışın farklı bir yol izlemesi gerekebilir.":"An SMS step in a Journey is the result of earlier triggers and decisions. If customer context changes or the channel is ineligible, the flow may need a different path.")</p><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/journey-manager":"/en/platform/journey-manager")">Journey Manager</a></div></div></section>

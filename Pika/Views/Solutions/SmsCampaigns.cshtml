@{
    var tr = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = tr ? "SMS Kampanya Yönetimi ve Otomasyon - Pika" : "SMS Campaign Management & Automation - Pika";
    ViewData["MetaDescription"] = tr ? "Pika SMS kampanya platformu ile segment bazlı hedefleme, kişiselleştirme ve zamanlı gönderim yaparak dönüşümü artırın." : "Increase conversions with segmented targeting, personalization, and scheduled delivery using the Pika SMS campaign platform.";
    ViewData["MetaKeywords"] = "sms kampanya, sms pazarlama, segmentasyon, otomasyon, kişiselleştirme, sms gönderim";
}

<!-- Hero -->
@await Html.PartialAsync("_MarketingHero")

<!-- Değer Kutuları -->
<section class="pika-sol-section">
    <div class="container">
        <div class="pika-sol-value-grid">
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500">
                <div class="pika-sol-value-icon"><i class="ri-flashlight-line"></i></div>
                <h4>@(tr ? "Hızlı Teslim" : "Fast Delivery")</h4>
                <p>@(tr ? "Zaman hassasiyeti olan iletişimlerde etkili kanal." : "Effective channel for time-sensitive communications.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="100">
                <div class="pika-sol-value-icon"><i class="ri-eye-line"></i></div>
                <h4>@(tr ? "Yüksek Görünürlük" : "High Visibility")</h4>
                <p>@(tr ? "Kullanıcıya doğrudan ulaşan net iletişim yapısı." : "Clear communication structure reaching users directly.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="200">
                <div class="pika-sol-value-icon"><i class="ri-focus-3-line"></i></div>
                <h4>@(tr ? "Segmentli Kullanım" : "Segmented Usage")</h4>
                <p>@(tr ? "Genel toplu gönderim yerine hedefli kullanım." : "Targeted usage instead of generic mass sends.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="300">
                <div class="pika-sol-value-icon"><i class="ri-loop-right-line"></i></div>
                <h4>@(tr ? "Otomasyonla Birlikte Çalışma" : "Works with Automation")</h4>
                <p>@(tr ? "SMS'i journey akışlarının parçası haline getirin." : "Make SMS part of journey flows.")</p>
            </div>
        </div>
    </div>
</section>

<!-- Ne Yapabilirsiniz? -->
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "SMS'i sadece toplu mesaj değil, stratejik aksiyon kanalı olarak kullanın" : "Use SMS as a strategic action channel, not just bulk messaging")</h2>
        <p class="pika-sol-section-desc" data-aos="fade-up" data-aos-delay="100">@(tr ? "Kampanyalar, hatırlatmalar, anlık duyurular ve davranış tetiklemeli aksiyonlar için SMS'i kontrollü ve ölçülebilir şekilde yönetin." : "Manage SMS in a controlled and measurable way for campaigns, reminders, instant announcements, and behavior-triggered actions.")</p>
        <div class="pika-sol-card-grid">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-megaphone-line"></i></div>
                <h4>@(tr ? "Kampanya SMS'leri" : "Campaign SMS")</h4>
                <p>@(tr ? "İndirim, özel gün ve promosyon iletişimleri." : "Discount, special occasion, and promotional communications.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-alarm-line"></i></div>
                <h4>@(tr ? "Hatırlatma SMS'leri" : "Reminder SMS")</h4>
                <p>@(tr ? "Davranış veya zaman bazlı hatırlatmalar." : "Behavior or time-based reminders.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-route-line"></i></div>
                <h4>@(tr ? "Journey İçi SMS Aksiyonları" : "In-Journey SMS Actions")</h4>
                <p>@(tr ? "Belirli kurallara göre tetiklenen süreçler." : "Processes triggered by specific rules.")</p>
            </div>
        </div>
    </div>
</section>

<!-- Özellikler / Capability Grid -->
<section class="pika-sol-section" id="features">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "SMS kampanyalarını daha kontrollü yönetin" : "Manage SMS campaigns with more control")</h2>
        <div class="pika-sol-card-grid">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-focus-3-line"></i></div>
                <h4>@(tr ? "Segment Bazlı Gönderim" : "Segment-Based Delivery")</h4>
                <p>@(tr ? "SMS'i doğru hedef kitleyle buluşturun." : "Match SMS with the right target audience.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-user-heart-line"></i></div>
                <h4>@(tr ? "Kişiselleştirilmiş Mesajlar" : "Personalized Messages")</h4>
                <p>@(tr ? "İsim, teklif veya kullanıcı bilgisine göre özelleştirin." : "Customize by name, offer, or user data.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-time-line"></i></div>
                <h4>@(tr ? "Zamanlı ve Anlık Gönderim" : "Scheduled & Instant Delivery")</h4>
                <p>@(tr ? "Planlı veya anlık aksiyon senaryoları oluşturun." : "Create scheduled or instant action scenarios.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-route-line"></i></div>
                <h4>@(tr ? "Journey Entegrasyonu" : "Journey Integration")</h4>
                <p>@(tr ? "SMS'i email, WhatsApp ve Push ile birlikte kullanın." : "Use SMS together with email, WhatsApp, and Push.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-shield-check-line"></i></div>
                <h4>@(tr ? "İzin ve Uyumluluk Yönetimi" : "Consent & Compliance")</h4>
                <p>@(tr ? "İletişim izinlerini ve süreç uyumunu yönetin." : "Manage communication consents and process compliance.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-line-chart-line"></i></div>
                <h4>@(tr ? "Raporlama" : "Reporting")</h4>
                <p>@(tr ? "Gönderim performansını izleyin." : "Monitor delivery performance.")</p>
            </div>
        </div>
    </div>
</section>

<!-- Kullanım Senaryoları -->
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Pika SMS Campaigns ile örnek kullanım alanları" : "Example use cases with Pika SMS Campaigns")</h2>
        <div class="pika-sol-usecase-grid">
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="50"><i class="ri-check-line"></i> @(tr ? "İndirim duyuruları" : "Discount announcements")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="100"><i class="ri-check-line"></i> @(tr ? "Sepet veya işlem hatırlatmaları" : "Cart or transaction reminders")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="150"><i class="ri-check-line"></i> @(tr ? "Sadakat kampanyaları" : "Loyalty campaigns")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="200"><i class="ri-check-line"></i> @(tr ? "Özel gün tebrikleri" : "Special occasion greetings")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="250"><i class="ri-check-line"></i> @(tr ? "Belirli segmentlere hızlı kampanyalar" : "Fast campaigns to specific segments")</div>
            <div class="pika-sol-usecase" data-aos="fade-up" data-aos-delay="300"><i class="ri-check-line"></i> @(tr ? "Zaman hassasiyetli bildirimler" : "Time-sensitive notifications")</div>
        </div>
    </div>
</section>

<!-- Nasıl Çalışır? -->
<section class="pika-sol-section">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "SMS kampanyanızı 4 adımda yönetin" : "Manage your SMS campaign in 4 steps")</h2>
        <div class="pika-sol-steps">
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="100"><div class="pika-sol-step-num"></div><p>@(tr ? "Hedef kitlenizi belirleyin" : "Define your target audience")</p></div>
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="200"><div class="pika-sol-step-num"></div><p>@(tr ? "Mesaj içeriğini oluşturun" : "Create the message content")</p></div>
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="300"><div class="pika-sol-step-num"></div><p>@(tr ? "Gönderimi planlayın veya tetikleyiciye bağlayın" : "Schedule the send or link to a trigger")</p></div>
            <div class="pika-sol-step" data-aos="fade-up" data-aos-delay="400"><div class="pika-sol-step-num"></div><p>@(tr ? "Sonuçları izleyin" : "Monitor results")</p></div>
        </div>
    </div>
</section>

<!-- Neden SMS? -->
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container" data-aos="fade-up">
        <div class="pika-sol-highlight">
            <h3>@(tr ? "Görünürlük gerektiren iletişimlerde güçlü kanal" : "A powerful channel for high-visibility communications")</h3>
            <p>@(tr ? "SMS; hızlı aksiyon, yüksek görünürlük ve kısa iletişim senaryolarında kritik rol oynar. Pika ile bu gücü daha akıllı hedefleme ve otomasyonla birleştirin." : "SMS plays a critical role in fast-action, high-visibility, and short-message scenarios. Combine this power with smarter targeting and automation through Pika.")</p>
        </div>
    </div>
</section>

<!-- Çok Kanallı Kullanım -->
<section class="pika-sol-section">
    <div class="container" data-aos="fade-up">
        <div class="pika-sol-omni">
            <h2 class="pika-sol-section-title">@(tr ? "SMS'i tek başına değil, journey'nin parçası olarak kullanın" : "Use SMS as part of the journey, not in isolation")</h2>
            <p class="pika-sol-section-desc" style="margin-left:auto;margin-right:auto">@(tr ? "Email, WhatsApp ve Push ile birlikte çalışan SMS aksiyonlarıyla daha tutarlı müşteri deneyimi oluşturun." : "Create a more consistent customer experience with SMS actions that work alongside Email, WhatsApp, and Push.")</p>
            <div class="pika-sol-omni-icons">
                <div class="pika-sol-omni-icon" style="background:#e3f2fd;color:#1976d2"><i class="ri-message-2-line"></i></div>
                <div class="pika-sol-omni-icon" style="background:#fff3e0;color:#f57c00"><i class="ri-mail-line"></i></div>
                <div class="pika-sol-omni-icon" style="background:#dcf8c6;color:#25d366"><i class="ri-whatsapp-line"></i></div>
                <div class="pika-sol-omni-icon" style="background:#fce4ec;color:#e91e63"><i class="ri-notification-3-line"></i></div>
            </div>
        </div>
    </div>
</section>

<!-- Kapanış CTA -->
<section class="pika-sol-cta-section">
    <div class="container" data-aos="fade-up">
        <h2>@(tr ? "SMS kampanyalarını daha hızlı, daha hedefli ve daha ölçülebilir yönetin" : "Manage SMS campaigns faster, more targeted, and more measurable")</h2>
        <p>@(tr ? "Pika SMS Campaigns ile görünürlüğü yüksek kampanyaları tek panelden yönetin." : "Manage high-visibility campaigns from a single panel with Pika SMS Campaigns.")</p>
        <div class="pika-sol-cta-actions">
            <button type="button" class="btn pika-btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i></button>
            <a href="@Url.Action("Contact", "Home")" class="btn pika-btn-ghost px-4 py-2">@(tr ? "Bizimle İletişime Geçin" : "Contact Us")</a>
        </div>
    </div>
</section>

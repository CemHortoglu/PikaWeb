@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-solutions-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-sms-page.css" asp-append-version="true" />
}

@* ── 01 HERO ─────────────────────────────────────────────────── *@
<section class="inner-hero inner-hero--content">
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span>/</span>
                <span>SMS</span>
            </nav>
            <div class="inner-eyebrow" aria-label="SMS Campaigns"><span></span>SMS · SMS Marketing</div>
            @if (tr)
            {
                <h1>
                    Kısa ve zaman hassasiyetli iletişimi,<br />
                    Pika'nın kontrollü aksiyon zincirinde<br />
                    SMS kanalına taşıyın.
                </h1>
                <p>
                    Pika SMS; Audience Manager'da tanımlanan hedef kitle bağlamının Campaign Manager veya Journey Manager içindeki kontrollü aksiyonlarda SMS iletişim kanalı üzerinden kullanılmasını sağlar.
                </p>
                <p class="text-muted small">
                    Gönderim öncesi IYS durumu, opt-out ve uygulanabilir iletişim zamanı kontrolleri SMS aksiyonunun izin ve gönderim uygunluğu bağlamında ayrıca değerlendirilir.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">Demo Talep Et ↗</button>
                    <a class="inner-secondary" href="/cozumler/campaign-manager">Campaign Manager'ı Keşfedin →</a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="İçeriğe atla"><i class="ri-arrow-down-line" aria-hidden="true"></i></a>
                </div>
            }
            else
            {
                <h1>
                    Bring concise, time-sensitive communication<br />
                    to the SMS channel<br />
                    inside Pika's controlled action chain.
                </h1>
                <p>
                    Pika SMS is the communication channel through which audience context defined in Audience Manager can be used within controlled actions managed by Campaign Manager or Journey Manager.
                </p>
                <p class="text-muted small">
                    Before delivery, IYS status, opt-out state and applicable communication-time controls are evaluated separately within SMS permission and delivery-eligibility context.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">Request a Demo ↗</button>
                    <a class="inner-secondary" href="/en/solutions/campaign-manager">Explore Campaign Manager →</a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="Skip to content"><i class="ri-arrow-down-line" aria-hidden="true"></i></a>
                </div>
            }
        </div>

        <div class="inner-scene" aria-hidden="true">
            <div class="inner-scene-orbit"></div>
            <div class="inner-scene-window">
                <div class="inner-window-bar">
                    <strong>pika<span>✳</span></strong>
                    <span>SMS</span>
                    <small>@(tr ? "Örnek görünüm" : "Illustration")</small>
                </div>
                <div class="sms-hero-pills">
                    @if (tr)
                    {
                        <span class="sms-hero-pill">HEDEF KİTLE <span>01</span></span>
                        <span class="sms-hero-pill">KAMPANYA / JOURNEY <span>02</span></span>
                        <span class="sms-hero-pill">İYS <span>03</span></span>
                        <span class="sms-hero-pill">OPT-OUT <span>04</span></span>
                        <span class="sms-hero-pill">SMS <span>05</span></span>
                        <span class="sms-hero-pill">TESLİMAT <span>06</span></span>
                    }
                    else
                    {
                        <span class="sms-hero-pill">AUDIENCE <span>01</span></span>
                        <span class="sms-hero-pill">CAMPAIGN / JOURNEY <span>02</span></span>
                        <span class="sms-hero-pill">IYS <span>03</span></span>
                        <span class="sms-hero-pill">OPT-OUT <span>04</span></span>
                        <span class="sms-hero-pill">SMS <span>05</span></span>
                        <span class="sms-hero-pill">DELIVERY <span>06</span></span>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<div id="inner-content" class="inner-anchor"></div>

@* ── STICKY SUBNAV ────────────────────────────────────────────── *@
<div class="pika-sol-subnav-wrap">
    <div class="container">
        <nav class="pika-sol-subnav" aria-label="@(tr ? "Sayfa içi gezinti" : "In-page navigation")">
            <a href="#overview">@(tr ? "Genel Bakış" : "Overview")</a>
            <a href="#context">@(tr ? "Kullanım Bağlamı" : "Use Context")</a>
            <a href="#audience">@(tr ? "Hedef Kitle" : "Audience")</a>
            <a href="#campaign">@(tr ? "Kampanya" : "Campaign")</a>
            <a href="#journey">Journey</a>
            <a href="#governance">@(tr ? "İzin & Ölçüm" : "Consent & Measurement")</a>
            <a href="#faq">@(tr ? "SSS" : "FAQ")</a>
        </nav>
    </div>
</div>

@* ── TRUST / VALUE STRIP ──────────────────────────────────────── *@
<section class="pika-sol-section py-4">
    <div class="container">
        <div class="pika-sol-highlight-items justify-content-center">
            <span class="pika-sol-highlight-item"><i class="ri-check-line" aria-hidden="true"></i> @(tr ? "Kısa Mesaj İletişimi" : "Concise Messaging")</span>
            <span class="pika-sol-highlight-item"><i class="ri-check-line" aria-hidden="true"></i> @(tr ? "Zaman Hassasiyetli Bağlam" : "Time-Sensitive Context")</span>
            <span class="pika-sol-highlight-item"><i class="ri-check-line" aria-hidden="true"></i> @(tr ? "Kontrollü Kampanya" : "Controlled Campaign")</span>
            <span class="pika-sol-highlight-item"><i class="ri-check-line" aria-hidden="true"></i> @(tr ? "Journey Kanal Aksiyonu" : "Journey Channel Action")</span>
            <span class="pika-sol-highlight-item"><i class="ri-check-line" aria-hidden="true"></i> @(tr ? "IYS & Opt-Out Kontrolü" : "IYS & Opt-Out Control")</span>
        </div>
    </div>
</section>

@* ── 02 DIRECT ANSWER ─────────────────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="overview">
    <div class="container">
        <div class="max-w-800">
            <span class="pika-sol-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
            <h2 class="pika-sol-section-title">@(tr ? "Pika SMS nedir?" : "What is Pika SMS?")</h2>
            <p class="pika-sol-section-desc">
                @(tr ? "Pika SMS, kısa ve zaman hassasiyetli metin iletişiminin kontrollü kampanya veya journey bağlamında kullanılabildiği doğrulanmış Pika iletişim kanallarından biridir." : "Pika SMS is one of Pika's confirmed communication channels for using concise, time-sensitive text communication within controlled campaign or journey context.")
            </p>
            <p class="mt-3">
                @(tr ? "SMS'in görevi müşteriyi analiz etmek, hedef kitleyi kendi başına seçmek veya journey akışını yönetmek değildir. Bu bağlamlar Pika'nın ilgili intelligence, Audience Manager, Campaign Manager ve Journey Manager katmanlarında oluşturulur." : "The role of SMS is not to analyze customers, independently select the audience or manage journey flow. Those contexts are created through Pika's relevant intelligence, Audience Manager, Campaign Manager and Journey Manager layers.")
            </p>
            <p class="mt-4 fw-medium text-dark">
                @(tr ? "SMS'in temel sorusu şudur:" : "SMS answers one central question:")
            </p>
            <div class="sms-callout">
                <h3 class="h4 mb-0 text-dark">
                    @(tr ? "“Tanımlanmış bu iletişim, izin ve aksiyon kontrollerinden sonra SMS kanalı üzerinden nasıl yürütülecek?”" : "“How is this defined communication executed through the SMS channel after permission and action controls?”")
                </h3>
            </div>
            <p class="mt-3">
                @(tr ? "İlgili ticari SMS iletişiminde gönderim öncesi IYS durumu, opt-out ve uygulanabilir iletişim zamanı kontrolleri gönderim uygunluğu değerlendirmesinin parçasıdır." : "For relevant commercial SMS communication, pre-dispatch IYS status, opt-out state and applicable communication-time controls form part of delivery-eligibility evaluation.")
            </p>
            <div class="p-3 bg-white rounded border border-light-subtle mt-4">
                <p class="mb-1"><strong>SMS:</strong> @(tr ? "iletişim kanalıdır." : "is the communication channel.")</p>
                <p class="mb-0"><strong>Pika:</strong> @(tr ? "kanalın etrafındaki anlama, karar, izin ve ölçüm zinciridir." : "is the surrounding chain of understanding, decision, permission and measurement.")</p>
            </div>
        </div>
    </div>
</section>

@* ── 03 SMS'S PLACE IN PIKA ───────────────────────────────────── *@
<section class="pika-sol-section">
    <div class="container">
        <div class="max-w-800">
            <span class="pika-sol-eyebrow">@(tr ? "KANAL, KARAR MOTORU DEĞİL" : "A CHANNEL, NOT THE DECISION ENGINE")</span>
            <h2 class="pika-sol-section-title">@(tr ? "SMS'i, Pika'nın karar zincirindeki doğru yere koyun." : "Put SMS in the right place inside Pika's decision chain.")</h2>
            <p class="pika-sol-section-desc">
                @if (tr)
                {
                    <text><a href="/pika">Pika</a> bir toplu SMS yazılımından ibaret değildir. SMS, platformun müşteri zekâsı ve omnichannel aksiyon zincirindeki doğrulanmış iletişim kanallarından biridir.</text>
                }
                else
                {
                    <text><a href="/en/pika">Pika</a> is more than bulk SMS software. SMS is one of the confirmed communication channels inside the platform's customer-intelligence and omnichannel-action chain.</text>
                }
            </p>
            <p class="mt-3">
                @if (tr)
                {
                    <text><a href="/platform/customer-intelligence">Customer Intelligence</a> müşteri davranışı ve değer bağlamını, <a href="/platform/product-intelligence">Product Intelligence</a> ürün bağlamını, <a href="/platform/gunun-firsatlari">Günün Fırsatları</a> ise değerlendirilebilir ticari fırsat bağlamını görünür hale getirir.</text>
                }
                else
                {
                    <text><a href="/en/platform/customer-intelligence">Customer Intelligence</a> calculates customer behavior and value context, <a href="/en/platform/product-intelligence">Product Intelligence</a> establishes product context and <a href="/en/platform/opportunities">Daily Opportunities</a> makes evaluable commercial opportunity context visible.</text>
                }
            </p>
            <p class="mt-3">
                @(tr ? "Audience Manager kimin dahil olduğunu, Campaign Manager veya Journey Manager aksiyonun nasıl yürütüleceğini yönetir. SMS ise uygun aksiyonun teknik iletişim kanallarından biridir." : "Audience Manager manages who belongs, while Campaign Manager or Journey Manager manage how the action is executed. SMS is one technical communication channel for that eligible action.")
            </p>

            <div class="sms-flow-chain" aria-label="Pika Decision Chain">
                <span>DATA</span>
                <span class="sms-flow-arrow">→</span>
                <span>@(tr ? "CUSTOMER & PRODUCT INTELLIGENCE" : "CUSTOMER & PRODUCT INTELLIGENCE")</span>
                <span class="sms-flow-arrow">→</span>
                <span>@(tr ? "OPPORTUNITY / DECISION" : "OPPORTUNITY / DECISION")</span>
                <span class="sms-flow-arrow">→</span>
                <span>AUDIENCE</span>
                <span class="sms-flow-arrow">→</span>
                <span>CAMPAIGN / JOURNEY</span>
                <span class="sms-flow-arrow">→</span>
                <span>CONSENT &amp; TIME CONTROLS</span>
                <span class="sms-flow-arrow">→</span>
                <span>SMS</span>
                <span class="sms-flow-arrow">→</span>
                <span>MEASUREMENT</span>
            </div>

            <div class="p-3 bg-white rounded border border-light-subtle mt-4">
                @if (tr)
                {
                    <p class="mb-1"><strong>SMS,</strong> kararı üretmez.</p>
                    <p class="mb-0">Tanımlanmış kararın iletişim kanalıdır.</p>
                }
                else
                {
                    <p class="mb-1"><strong>SMS</strong> does not create the decision.</p>
                    <p class="mb-0">It is the communication channel for a defined decision.</p>
                }
            </div>
        </div>

        <div class="pika-sol-value-grid mt-5">
            <div class="pika-sol-value-card">
                <div class="pika-sol-value-icon"><i class="ri-message-2-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Kısa Mesaj Kanalı" : "Concise Messaging Channel")</h4>
                <p>@(tr ? "Kısa ve doğrudan metin iletişimini kontrollü kampanya veya journey bağlamında SMS kanalı üzerinden yürütün." : "Execute concise, direct text communication through SMS within controlled campaign or journey context.")</p>
            </div>
            <div class="pika-sol-value-card">
                <div class="pika-sol-value-icon"><i class="ri-focus-3-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Audience Bağlamı" : "Audience Context")</h4>
                <p>@(tr ? "Audience Manager'da tanımlanan hedef kitleyi SMS aksiyonunun upstream müşteri bağlamı olarak kullanın." : "Use the audience defined in Audience Manager as upstream customer context for the SMS action.")</p>
            </div>
            <div class="pika-sol-value-card">
                <div class="pika-sol-value-icon"><i class="ri-shield-check-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "İzin ve Zaman Kontrolü" : "Permission & Time Control")</h4>
                <p>@(tr ? "İlgili SMS iletişiminde IYS, opt-out ve uygulanabilir quiet-hours kontrollerini gönderim uygunluğu bağlamında değerlendirin." : "Evaluate IYS, opt-out and applicable quiet-hours controls within SMS delivery-eligibility context.")</p>
            </div>
            <div class="pika-sol-value-card">
                <div class="pika-sol-value-icon"><i class="ri-bar-chart-box-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Ölçülebilir Delivery Sonucu" : "Measurable Delivery Outcome")</h4>
                <p>@(tr ? "Kullanılabilir SMS delivery outcome veya status verisini Analytics & Reporting bağlamında değerlendirin." : "Evaluate available SMS delivery-outcome or status data within Analytics & Reporting context.")</p>
            </div>
        </div>
    </div>
</section>

@* ── 04 WHEN SMS FITS THE COMMUNICATION CONTEXT ──────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="context">
    <div class="container">
        <div class="max-w-800">
            <span class="pika-sol-eyebrow">@(tr ? "SMS BAĞLAMI" : "SMS CONTEXT")</span>
            <h2 class="pika-sol-section-title">@(tr ? "Kısa ve zaman hassasiyetli iletişimde, kanalın yapısını doğru kullanın." : "Use the channel appropriately for concise, time-sensitive communication.")</h2>
            <p class="pika-sol-section-desc">
                @(tr ? "SMS zengin görsel içerik yerine kısa ve doğrudan metin iletişimi gereken bağlamlarda kullanılabilen kanaldır." : "SMS is a channel that can be used when communication requires concise, direct text rather than rich visual content.")
            </p>
            <p class="mt-3">
                @(tr ? "Zaman hassasiyetli kampanya iletişimi, kısa hatırlatma veya tanımlı journey adımı SMS kullanım bağlamlarından biri olabilir." : "Time-sensitive campaign communication, a short reminder or a defined journey step can be examples of SMS context.")
            </p>
            <p class="mt-3">
                @(tr ? "Bu, SMS'in bütün müşteri iletişimlerinde “en iyi” veya “en hızlı” kanal olduğu anlamına gelmez." : "This does not mean SMS is the “best” or “fastest” channel for every customer communication.")
            </p>

            <div class="sms-callout">
                @if (tr)
                {
                    <p class="mb-1"><strong>SMS:</strong> kısa metin kanalıdır.</p>
                    <p class="mb-1"><strong>Kullanım bağlamı:</strong> kampanya veya journey amacına göre belirlenir.</p>
                    <p class="mb-0"><strong>Kanal seçimi:</strong> evrensel performans sıralaması değildir.</p>
                }
                else
                {
                    <p class="mb-1"><strong>SMS:</strong> is a concise text channel.</p>
                    <p class="mb-1"><strong>Use context:</strong> depends on the campaign or journey objective.</p>
                    <p class="mb-0"><strong>Channel selection:</strong> is not a universal performance ranking.</p>
                }
            </div>

            <div class="p-3 bg-white rounded border border-light-subtle mt-3">
                @if (tr)
                {
                    <p class="mb-0">Doğru kanal, iletişimin bağlamına göre seçilir.</p>
                }
                else
                {
                    <p class="mb-0">The right channel depends on communication context.</p>
                }
            </div>
        </div>
    </div>
</section>

@* ── 05 AUDIENCE → SMS ───────────────────────────────────────── *@
<section class="pika-sol-section" id="audience">
    <div class="container">
        <div class="max-w-800">
            <span class="pika-sol-eyebrow">@(tr ? "“KİM?”DEN SMS'E" : "FROM “WHO?” TO SMS")</span>
            <h2 class="pika-sol-section-title">@(tr ? "SMS hedef kitleyi seçmez. Audience bağlamını kullanır." : "SMS does not choose the audience. It uses audience context.")</h2>
            <p class="pika-sol-section-desc">
                @(tr ? "Audience Manager gerçek hedef kitleyi müşteri verisi ve açık kurallar üzerinden tanımlar." : "Audience Manager defines the actual target audience through customer data and explicit rules.")
            </p>
            <p class="mt-3">
                @(tr ? "SMS kanalının görevi müşterileri kendi başına segmente etmek veya “en uygun” alıcı grubunu seçmek değildir." : "The role of the SMS channel is not to independently segment customers or choose the “best” recipient group.")
            </p>
            <p class="mt-3">
                @(tr ? "Campaign Manager veya Journey Manager içindeki SMS aksiyonu ilgili audience bağlamını kontrollü iletişim sürecinde kullanabilir." : "An SMS action inside Campaign Manager or Journey Manager can use the relevant audience context within controlled communication.")
            </p>

            <div class="sms-callout">
                @if (tr)
                {
                    <p class="mb-1"><strong>Audience Manager:</strong> “Kim bu hedef kitleye dahil?”</p>
                    <p class="mb-0"><strong>SMS:</strong> “Bu tanımlı kitleye uygun SMS iletişimi hangi aksiyon bağlamında yürütülecek?”</p>
                }
                else
                {
                    <p class="mb-1"><strong>Audience Manager:</strong> “Who belongs in this audience?”</p>
                    <p class="mb-0"><strong>SMS:</strong> “Within which action context will eligible SMS communication reach this defined audience?”</p>
                }
            </div>

            <div class="p-3 bg-white rounded border border-light-subtle mt-3">
                @if (tr)
                {
                    <p class="mb-0">Audience gerçeği, SMS kanalı tarafından üretilmez.</p>
                }
                else
                {
                    <p class="mb-0">Audience truth is not created by the SMS channel.</p>
                }
            </div>

            <div class="mt-4">
                <a href="@(tr ? "/cozumler/audience-manager" : "/en/solutions/audience-manager")" class="btn pika-btn-outline">
                    @(tr ? "Audience Manager'ı Keşfedin →" : "Explore Audience Manager →")
                </a>
            </div>
        </div>

        <div class="pika-sol-card-grid mt-5">
            <div class="pika-sol-card">
                <div class="pika-sol-card-icon"><i class="ri-megaphone-line" aria-hidden="true"></i></div>
                <h4>Campaign SMS</h4>
                <p>@(tr ? "Tanımlı audience ve hazırlanmış kısa mesaj içeriğinin Campaign Manager üzerinden kontrollü SMS aksiyonunda kullanılabileceği kampanya bağlamı." : "A campaign context where a defined audience and prepared short-message content can be used in a controlled SMS action through Campaign Manager.")</p>
            </div>
            <div class="pika-sol-card">
                <div class="pika-sol-card-icon"><i class="ri-route-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Journey SMS Adımı" : "Journey SMS Step")</h4>
                <p>@(tr ? "SMS'in Journey Manager içindeki tanımlı koşul, sıra ve bekleme mantığında bir kanal aksiyonu olarak kullanılabileceği journey bağlamı." : "A journey context where SMS can be used as a channel action inside conditions, sequence and wait logic managed by Journey Manager.")</p>
            </div>
            <div class="pika-sol-card">
                <div class="pika-sol-card-icon"><i class="ri-lightbulb-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Fırsattan SMS Aksiyonuna" : "From Opportunity to SMS Action")</h4>
                <p>@(tr ? "Günün Fırsatları'nda değerlendirilen ticari fırsatın kullanıcı kararı, gerçek audience tanımı ve izin kontrollerinden sonra SMS kanalında uygulanabileceği aksiyon bağlamı." : "An action context where a commercial opportunity evaluated in Daily Opportunities can reach the SMS channel after user decision, actual audience definition and permission controls.")</p>
            </div>
        </div>
    </div>
</section>

@* ── 06 CAMPAIGN MANAGER → SMS ───────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="campaign">
    <div class="container">
        <div class="max-w-800">
            <span class="pika-sol-eyebrow">@(tr ? "KAMPANYADAN SMS'E" : "FROM CAMPAIGN TO SMS")</span>
            <h2 class="pika-sol-section-title">@(tr ? "Campaign Manager kampanyayı yönetir. SMS iletişimi taşır." : "Campaign Manager manages the campaign. SMS carries the communication.")</h2>
            <p class="pika-sol-section-desc">
                @(tr ? "Campaign Manager tanımlı hedef kitle, içerik, kanal, zamanlama ve gönderim öncesi kontrolleri aynı kampanya bağlamında yönetir." : "Campaign Manager manages defined audience, content, channel, timing and pre-send controls within the same campaign context.")
            </p>
            <p class="mt-3">
                @(tr ? "SMS seçilen kanal olduğunda hazırlanmış kısa mesaj içeriği kontrollü campaign-execution sürecinde kullanılabilir." : "When SMS is the selected channel, prepared short-message content can be used within controlled campaign execution.")
            </p>
            <p class="mt-3">
                @(tr ? "SMS kanalının bulunması kampanyanın otomatik olarak başladığı anlamına gelmez." : "The availability of SMS does not mean a campaign starts automatically.")
            </p>

            <div class="sms-callout">
                @if (tr)
                {
                    <p class="mb-1"><strong>Campaign Manager:</strong> kampanya bağlamını, zamanlamayı ve kontrollü gönderimi yönetir.</p>
                    <p class="mb-0"><strong>SMS:</strong> seçilen iletişim kanalıdır.</p>
                }
                else
                {
                    <p class="mb-1"><strong>Campaign Manager:</strong> manages campaign context, timing and controlled delivery.</p>
                    <p class="mb-0"><strong>SMS:</strong> is the selected communication channel.</p>
                }
            </div>

            <div class="p-3 bg-white rounded border border-light-subtle mt-3">
                @if (tr)
                {
                    <p class="mb-0">Kampanya kararı ve SMS icrası aynı ürün rolü değildir.</p>
                }
                else
                {
                    <p class="mb-0">The campaign decision and SMS execution do not perform the same product role.</p>
                }
            </div>

            <div class="mt-4">

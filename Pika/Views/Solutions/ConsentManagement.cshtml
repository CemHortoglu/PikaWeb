            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-smartphone-line"></i></div>
                <h4>@(tr ? "Kanal bazlı tercih" : "Channel-based preference")</h4>
                <p>@(tr ? "Her kanal için ayrı izin ve tercih tanımlayın." : "Define separate permissions and preferences for each channel.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-link"></i></div>
                <h4>@(tr ? "Kampanya entegrasyonu" : "Campaign integration")</h4>

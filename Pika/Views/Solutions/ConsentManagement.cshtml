<!-- FAQ -->
<section class="pika-sol-section pika-sol-section-alt" id="faq">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "Consent Management hakkında sık sorulan sorular" : "Consent Management FAQs")</h2>
        <div class="accordion faq-pro-accordion" id="consentFaq">
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#consentFaq1" aria-expanded="true" aria-controls="consentFaq1">@(tr ? "İzinler kanal bazında yönetilebilir mi?" : "Can permissions be managed per channel?")</button></h2>
                <div id="consentFaq1" class="accordion-collapse collapse show" data-bs-parent="#consentFaq"><div class="accordion-body">@(tr ? "Evet. SMS, WhatsApp, Email ve Push için ayrı izin ve tercih tanımlayabilirsiniz." : "Yes. You can define separate permissions and preferences for SMS, WhatsApp, Email and Push.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#consentFaq2" aria-expanded="false" aria-controls="consentFaq2">@(tr ? "KVKK ve GDPR uyumu sağlanıyor mu?" : "Is KVKK and GDPR compliance supported?")</button></h2>
                <div id="consentFaq2" class="accordion-collapse collapse" data-bs-parent="#consentFaq"><div class="accordion-body">@(tr ? "Evet. İzin kayıtları ve tercih değişiklikleri düzenleyici gerekliliklere uygun şekilde saklanır." : "Yes. Permission records and preference changes are stored in compliance with regulatory requirements.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#consentFaq3" aria-expanded="false" aria-controls="consentFaq3">@(tr ? "Kampanyalara otomatik entegre oluyor mu?" : "Does it integrate automatically with campaigns?")</button></h2>
                <div id="consentFaq3" class="accordion-collapse collapse" data-bs-parent="#consentFaq"><div class="accordion-body">@(tr ? "Evet. İzin durumu kampanya gönderimlerinde ve journey akışlarında otomatik olarak kontrol edilir." : "Yes. Permission status is automatically checked in campaign sends and journey flows.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#consentFaq4" aria-expanded="false" aria-controls="consentFaq4">@(tr ? "İzin geçmişi görüntülenebilir mi?" : "Can consent history be viewed?")</button></h2>
                <div id="consentFaq4" class="accordion-collapse collapse" data-bs-parent="#consentFaq"><div class="accordion-body">@(tr ? "Evet. Her müşterinin izin alma, değiştirme ve iptal geçmişi detaylı olarak takip edilir." : "Yes. Each customer's consent acquisition, change and revocation history is tracked in detail.")</div></div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#consentFaq5" aria-expanded="false" aria-controls="consentFaq5">@(tr ? "Müşteriler tercihlerini kendileri güncelleyebilir mi?" : "Can customers update their preferences themselves?")</button></h2>
                <div id="consentFaq5" class="accordion-collapse collapse" data-bs-parent="#consentFaq"><div class="accordion-body">@(tr ? "Evet. Tercih merkezi aracılığıyla müşteriler iletişim tercihlerini kolayca yönetebilir." : "Yes. Customers can easily manage their communication preferences through the preference center.")</div></div>
            </div>
        </div>
    </div>
</section>


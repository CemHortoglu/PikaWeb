@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]="Consent Management | "+(tr?"İzin ve Kanal Uygunluğu":"Consent & Channel Eligibility");
    ViewData["MetaDescription"]=tr?"Pika Consent Management ile kanal izni, opt-out, ulaşılabilirlik ve İYS bağlamını iletişim kararından önce ayrı kontroller olarak değerlendirin; kişi kaydı ile iletişim iznini birbirinden ayırın.":"Use Pika Consent Management to evaluate channel consent, opt-out, reachability and IYS context as separate controls before communication, keeping contact records distinct from consent.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">Platform · Consent Management</span><h1>@(tr?"Kişi kaydı, iletişim izni değildir.":"A contact record is not communication consent.")</h1><p>@(tr?"Pika; kanal izni, opt-out, ulaşılabilirlik ve desteklenen İYS bağlamını gönderim kararından önce ayrı uygunluk sinyalleri olarak değerlendirir. Bir müşteride güçlü fırsat oluşması, o müşteriye her kanaldan iletişim kurulabileceği anlamına gelmez.":"Pika treats channel consent, opt-out, reachability and supported IYS context as separate eligibility signals before delivery. A strong opportunity does not make every channel eligible for communication.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"İzin Akışını Canlı Görün":"See Consent Flow Live")</button><a class="pk-btn pk-btn-ghost" href="/wiki/izin-optout-iys">@(tr?"İzin ve İYS rehberi":"Consent & IYS guide")</a></div><div class="pk-hero-note"><i class="ri-scales-3-line"></i><span>@(tr?"Pika ürün içi kontroller sunar; hukuki danışmanlık veya mutlak KVKK/İYS uyum garantisi vermez." : "Pika provides product controls; it does not replace legal advice or provide an absolute legal-compliance guarantee.")</span></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_izin-kanal-zamanlama_25.png" alt="@(tr?"Pika izin kanal ve zamanlama ekranı":"Pika consent channel and timing screen")" width="1200" height="760" /><div class="pk-stage-caption"><strong>Consent Management</strong><span>@(tr?"İzin · Opt-out · Kanal · Zamanlama":"Consent · Opt-out · Channel · Timing")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-shield-check-line"></i><div><strong>@(tr?"İzin":"Consent")</strong><small>@(tr?"Kanal bazlı uygunluk":"Channel-specific eligibility")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-user-unfollow-line"></i><div><strong>Opt-out</strong><small>@(tr?"Tercihe saygı":"Respect preference")</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-message-3-line"></i><div><strong>@(tr?"Kanal":"Channel")</strong><small>@(tr?"Ulaşılabilir ve uygun mu?":"Reachable and eligible?")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Tanım":"Definition")</span><h2>@(tr?"Consent Management neyi kontrol eder?":"What does Consent Management control?")</h2></div><p class="pk-lead">@(tr?"Consent Management, müşterinin Pika'da kayıtlı olması ile belirli bir iletişim kanalından pazarlama iletişimi almasının uygun olması arasındaki farkı yönetmeye yardımcı olan kontrol katmanıdır. İletişim adresinin bulunması, kanal izni ve opt-out durumu birbirinden ayrı gerçeklerdir.":"Consent Management helps manage the difference between a customer existing in Pika and being eligible for marketing communication through a specific channel. A contact address, channel consent and opt-out status are separate facts.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-user-line"></i><strong>@(tr?"Kişi":"Contact")</strong><span>@(tr?"Müşteri/iletişim kaydı var mı?":"Is customer/contact data available?")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-at-line"></i><strong>@(tr?"Adres":"Address")</strong><span>@(tr?"Email/telefon/WhatsApp adresi kullanılabilir mi?":"Is a channel address available?")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-shield-check-line"></i><strong>@(tr?"İzin":"Consent")</strong><span>@(tr?"İlgili kanal için izin bağlamı uygun mu?":"Is consent context appropriate for this channel?")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-user-unfollow-line"></i><strong>Opt-out</strong><span>@(tr?"Müşteri iletişimden çıktı mı?":"Has the customer opted out?")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-checkbox-circle-line"></i><strong>@(tr?"Uygunluk":"Eligibility")</strong><span>@(tr?"Bu iletişim aksiyonu yürütülebilir mi?":"Can this communication action proceed?")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-route-line"></i><strong>@(tr?"Aksiyon":"Action")</strong><span>@(tr?"Uygunsa Campaign/Journey":"Campaign/Journey if eligible")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Temel ayrım":"Core distinction")</span><h2>@(tr?"CRM kaydı var diye pazarlama mesajı gönderilmez.":"A CRM/contact record does not automatically authorize marketing communication.")</h2></div><p class="pk-lead">@(tr?"Gmail veya Outlook'tan kişi aktarılması, Excel'den müşteri yüklenmesi veya API üzerinden bir iletişim adresinin gelmesi yalnızca kişi/veri kaydını oluşturabilir. Ticari iletişim uygunluğu ilgili izin, opt-out ve diğer yasal/operasyonel süreçlerle ayrıca değerlendirilmelidir.":"Importing a contact from Gmail/Outlook, Excel or API may create customer/contact data. Commercial communication eligibility still needs separate consent, opt-out and other legal/operational evaluation.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_gmail-kisi-aktarimi_23.png" alt="@(tr?"Pika Gmail Outlook kişi aktarımı ekranı":"Pika Gmail Outlook contact import screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Kişi aktarımı":"Contact import")</small><h3>@(tr?"Kişi oluşturmak iletişim izni oluşturmaz":"Importing a contact does not create consent")</h3><p>@(tr?"Rehberden gelen ad, e-posta veya telefon bilgisi kişi verisidir; pazarlama iletişimi için izin kararı değildir." : "Name, email or phone data imported from a contact book is contact data, not a marketing-consent decision.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_izin-kanal-zamanlama_25.png" alt="@(tr?"Pika izin ve kanal uygunluğu görünümü":"Pika consent and channel eligibility view")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"İletişim uygunluğu":"Communication eligibility")</small><h3>@(tr?"Kanal kararını ayrı değerlendirin":"Evaluate channel eligibility separately")</h3><p>@(tr?"Email, SMS veya WhatsApp için adres ve izin bağlamı farklı olabilir; tek bir genel 'müşteri izinli' varsayımı yapılmamalıdır." : "Address and consent context may differ across Email, SMS and WhatsApp; avoid one universal 'customer is consented' assumption.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">İYS</span><h2>@(tr?"İYS bağlamını operasyonel karara taşıyın; hukuki sorumluluğu otomatik devretmeyin.":"Bring IYS context into operations without assuming legal responsibility is transferred.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Pika'da İYS entegrasyonuna yönelik destek ve yönetim ekranları bulunabilir. Bu entegrasyon, izin verisini operasyonel karara taşımaya yardımcı olur. Entegrasyon kapsamı, veri kaynağı, ileti türü ve yürürlükteki mevzuat müşterinin kendi hukuk ve operasyon süreçleriyle birlikte değerlendirilmelidir.":"Pika can provide IYS integration support and management views, helping bring consent information into operational decisions. Integration scope, data source, communication type and applicable law still need to be evaluated with the customer's own legal and operational processes.")</p></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-database-2-line"></i><div><strong>@(tr?"İzin kaynağı":"Consent source")</strong><span>@(tr?"İzin verisinin hangi sistem ve süreçten geldiğini bilin." : "Know which system and process the consent data comes from.")</span></div></div><div class="pk-control-step"><i class="ri-refresh-line"></i><div><strong>@(tr?"Senkronizasyon":"Synchronization")</strong><span>@(tr?"İzin verisinin Pika'ya nasıl ve ne sıklıkla taşındığını operasyonel olarak yönetin." : "Operationally manage how and when consent data reaches Pika.")</span></div></div><div class="pk-control-step"><i class="ri-message-3-line"></i><div><strong>@(tr?"İletişim türü":"Communication type")</strong><span>@(tr?"İlgili kanal ve iletişim senaryosunu ayrı değerlendirin." : "Evaluate the relevant channel and communication scenario separately.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-scales-3-line"></i><div><strong>@(tr?"Müşteri sorumluluğu":"Customer responsibility")</strong><span>@(tr?"Pika operasyonel kontrol sunar; hukuki uygunluk değerlendirmesi müşterinin kendi sorumluluklarını ortadan kaldırmaz." : "Pika provides operational controls; it does not remove the customer's own legal-compliance responsibilities.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Fırsat → uygunluk → aksiyon":"Opportunity → eligibility → action")</span><h2>@(tr?"Doğru müşteri bulunması, her kanaldan ulaşılabileceği anlamına gelmez.":"Finding the right customer does not make every channel eligible.")</h2></div><p class="pk-lead">@(tr?"Günün Fırsatları veya başka bir karar katmanı güçlü bir ticari sinyal oluşturabilir. İletişim aksiyonu ise ayrı bir uygunluk kontrolünden geçmelidir. Hiç uygun kanal yoksa doğru ve güvenli sonuç mesaj göndermemek olabilir.":"Daily Opportunities or another decision layer may surface a strong commercial signal. Communication still needs a separate eligibility check. If no channel is eligible, the correct and safe result may be not to send a message.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Fırsat":"Opportunity")</strong><span>@(tr?"Ticari neden var mı?":"Is there a commercial reason?")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-user-line"></i><strong>@(tr?"Müşteri":"Customer")</strong><span>@(tr?"Doğru kişi/kitle mi?":"Is this the right customer/audience?")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-shield-check-line"></i><strong>@(tr?"İzin":"Consent")</strong><span>@(tr?"Kanal için uygun mu?":"Is the channel permitted?")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-user-unfollow-line"></i><strong>Opt-out</strong><span>@(tr?"Çıkış tercihi var mı?":"Has the customer opted out?")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-message-3-line"></i><strong>@(tr?"Kanal":"Channel")</strong><span>@(tr?"Ulaşılabilir ve uygun mu?":"Reachable and eligible?")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-send-plane-line"></i><strong>@(tr?"Aksiyon / yok":"Action / no action")</strong><span>@(tr?"Uygunsa yürüt; değilse gönderme":"Execute if eligible; otherwise do not send")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Kanallar":"Channels")</span><h2>@(tr?"Kanal uygunluğunu kanalın doğasına göre değerlendirin.":"Evaluate eligibility according to each channel's context.")</h2></div><p class="pk-lead">@(tr?"Email, SMS, WhatsApp ve Push aynı izin/adres modeline sahipmiş gibi ele alınmamalıdır. Pika'nın kanal katmanı, ilgili kanalın kullanılabilirliği ve izin bağlamıyla birlikte değerlendirilir.":"Email, SMS, WhatsApp and Push should not be treated as if they share one universal consent/address model. Pika's channel layer evaluates each channel with its relevant availability and consent context.")</p></div><div class="pk-channel-grid"><a class="pk-channel" href="@(tr?"/kanallar/email":"/en/channels/email")"><i class="ri-mail-line"></i><h3>Email</h3><p>@(tr?"E-posta adresi, abonelik/opt-out ve ilgili izin bağlamıyla birlikte." : "With email address, subscription/opt-out and relevant consent context.")</p><span>@(tr?"Email'i inceleyin →":"Explore Email →")</span></a><a class="pk-channel" href="@(tr?"/kanallar/sms":"/en/channels/sms")"><i class="ri-message-2-line"></i><h3>SMS</h3><p>@(tr?"Telefon numarası ve ilgili ticari iletişim uygunluğuyla birlikte." : "With phone number and relevant commercial communication eligibility.")</p><span>@(tr?"SMS'i inceleyin →":"Explore SMS →")</span></a><a class="pk-channel" href="@(tr?"/kanallar/whatsapp":"/en/channels/whatsapp")"><i class="ri-whatsapp-line"></i><h3>WhatsApp</h3><p>@(tr?"Uygun hesap/şablon/izin bağlamı ve müşteri ulaşılabilirliğiyle birlikte." : "With appropriate account/template/consent context and customer reachability.")</p><span>@(tr?"WhatsApp'ı inceleyin →":"Explore WhatsApp →")</span></a><a class="pk-channel" href="@(tr?"/kanallar/push":"/en/channels/push")"><i class="ri-notification-3-line"></i><h3>Push</h3><p>@(tr?"Desteklenen uygulama/push kimliği ve ilgili izin bağlamıyla birlikte." : "With supported app/push identity and relevant permission context.")</p><span>@(tr?"Push'ı inceleyin →":"Explore Push →")</span></a></div></div></section>

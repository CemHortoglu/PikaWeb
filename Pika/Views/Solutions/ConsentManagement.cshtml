            <div class="pika-sol-channel-pill"><i class="ri-global-line"></i> GDPR</div>
            <div class="pika-sol-channel-pill"><i class="ri-history-line"></i> @(tr ? "Denetim Kaydı" : "Audit Trail")</div>
            <div class="pika-sol-channel-pill"><i class="ri-shield-check-line"></i> @(tr ? "İzin Doğrulama" : "Permission Check")</div>
        </div>
    </div>
</section>

<!-- TRUST STRIP -->
<section class="pika-sol-section">
    <div class="container">
        <div class="pika-sol-trust-strip" data-aos="fade-up">
            <div class="pika-sol-trust-item"><i class="ri-database-2-line"></i><span>@(tr ? "Merkezi kayıt" : "Central registry")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-toggle-line"></i><span>@(tr ? "Tercih yönetimi" : "Preference mgmt")</span></div>

@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-platform-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-consent-management-page.css" asp-append-version="true" />
}

@* ── 01 HERO ─────────────────────────────────────────────────── *@
<section class="inner-hero inner-hero--consent">
    <div class="inner-hero-grid-overlay" aria-hidden="true"></div>
    <div class="inner-hero-orbit" aria-hidden="true"></div>
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span>/</span>
                <span>Consent Management</span>
            </nav>
            <div class="inner-eyebrow"><span></span>CONSENT MANAGEMENT</div>
            @if (tr)
            {
                <h1>
                    İzin durumunu,<br />
                    gönderim kararının<br />
                    doğal parçası haline getirin.
                </h1>
                <p>
                    Pika Consent Management; gönderim öncesi IYS durum kontrolünü, merkezi opt-out kaydını ve Email/SMS tercih güncelleme akışını iletişim uygunluğu bağlamında bir araya getirir.
                </p>
                <p class="text-muted small">
                    Amaç yasal sonucu otomatik olarak garanti etmek değil; mevcut izin, opt-out ve kanal uygunluğu bağlamını iletişimden önce kontrol edilebilir hale getirmektir.
                </p>
            }
            else
            {
                <h1>
                    Make consent state<br />
                    a natural part<br />
                    of the delivery decision.
                </h1>
                <p>
                    Pika Consent Management brings pre-dispatch IYS status checks, centralized opt-out state and the Email/SMS preference-update flow into communication-eligibility context.
                </p>
                <p class="text-muted small">
                    The objective is not to automatically guarantee a legal outcome, but to make available consent, opt-out and channel-eligibility context controllable before communication.
                </p>
            }
            <div class="inner-actions">
                <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo") ↗</button>
                <a class="inner-secondary" href="@(tr ? "/cozumler/campaign-manager" : "/en/solutions/campaign-manager")">@(tr ? "Campaign Manager'ı Keşfedin" : "Explore Campaign Manager") →</a>
                <a class="inner-hero-anchor" href="#inner-content" aria-label="@(tr ? "İçeriğe atla" : "Skip to content")"><i class="ri-arrow-down-line" aria-hidden="true"></i></a>
            </div>
        </div>

        <div class="inner-scene" aria-hidden="true">
            <div class="inner-scene-orbit"></div>
            <div class="inner-scene-window">
                <div class="inner-window-bar">
                    <strong>pika<span>✳</span></strong>
                    <span>@(tr ? "İzin ve Tercih Yönetimi" : "Consent & Preference Management")</span>
                </div>
                <div class="inner-shield">
                    <i class="ri-shield-check-line" aria-hidden="true"></i>
                    <h3 class="mt-2 mb-0">@(tr ? "İzin ve Tercih Yönetimi" : "Consent & Preference Management")</h3>
                </div>
                <div class="inner-checks">
                    <span>@(tr ? "İZİN BAĞLAMI" : "CONSENT CONTEXT")</span>
                    <span>@(tr ? "IYS KONTROLÜ" : "IYS CHECK")</span>
                    <span>OPT-OUT</span>
                    <span>@(tr ? "KANAL UYGUNLUĞU" : "CHANNEL ELIGIBILITY")</span>
                    <span>@(tr ? "GÖNDERİM KARARI" : "DELIVERY DECISION")</span>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="inner-trust-ribbon">
    <div class="container">
        <div class="inner-trust-ribbon__items">
            <div class="inner-trust-ribbon__item">
                <i class="ri-whatsapp-line" aria-hidden="true"></i>
                <div>
                    <strong>WhatsApp Business API</strong>
                    <span>@(tr ? "Resmi Meta API" : "Official Meta API")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-mail-send-line" aria-hidden="true"></i>
                <div>
                    <strong>Email &amp; SMS</strong>
                    <span>@(tr ? "Doğrulanmış Kanallar" : "Verified Channels")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-focus-3-line" aria-hidden="true"></i>
                <div>
                    <strong>Pika Opportunity Engine</strong>
                    <span>@(tr ? "Günlük Algoritmik Tespit" : "Daily Discovery")</span>
                </div>
            </div>
            <div class="inner-trust-ribbon__item">
                <i class="ri-shield-check-line" aria-hidden="true"></i>
                <div>
                    <strong>İYS &amp; KVKK</strong>
                    <span>@(tr ? "İzin Denetimi" : "Consent Verification")</span>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="inner-content" class="inner-anchor"></div>

@* ── STICKY SUBNAV ────────────────────────────────────────────── *@
<div class="pika-sol-subnav-wrap">
    <div class="container">
        <nav class="pika-sol-subnav" aria-label="@(tr ? "Sayfa içi gezinti" : "In-page navigation")">
            <a href="#overview">@(tr ? "Genel Bakış" : "Overview")</a>
            <a href="#iys">İYS</a>
            <a href="#optout">Opt-Out</a>
            <a href="#preferences">@(tr ? "Tercihler" : "Preferences")</a>
            <a href="#channels">@(tr ? "Kanallar" : "Channels")</a>
            <a href="#platform">@(tr ? "Platform İlişkisi" : "Platform Relationships")</a>
            <a href="#faq">@(tr ? "SSS" : "FAQ")</a>
        </nav>
    </div>
</div>

@* ── TRUST STRIP ──────────────────────────────────────────────── *@
<section class="pika-sol-section py-4">
    <div class="container">
        <div class="pika-sol-trust-strip" data-aos="fade-up">
            <div class="pika-sol-trust-item"><i class="ri-shield-check-line"></i><span>@(tr ? "Gönderim Öncesi Kontrol" : "Pre-Send Check")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-search-eye-line"></i><span>@(tr ? "IYS Durum Kontrolü" : "IYS Status Check")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-forbid-2-line"></i><span>@(tr ? "Merkezi Opt-Out" : "Central Opt-Out")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-toggle-line"></i><span>@(tr ? "Email / SMS Tercihleri" : "Email / SMS Preferences")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-check-double-line"></i><span>@(tr ? "Kanal Uygunluğu" : "Channel Eligibility")</span></div>
        </div>
    </div>
</section>

@* ── 02 DIRECT ANSWER ─────────────────────────────────────────── *@
<section class="pika-sol-section" id="overview">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="pika-sol-eyebrow text-uppercase mb-2">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</div>
                <h2 class="pika-h2 fw-bold mb-4">@(tr ? "Consent Management nedir?" : "What is Consent Management?")</h2>

                <p class="lead mb-4">
                    @(tr
                        ? "Consent Management, Pika'da müşteri iletişimi uygulanmadan önce mevcut izin, IYS durumu ve opt-out bağlamının değerlendirilmesine yardımcı olan izin ve tercih yönetimi katmanıdır."
                        : "Consent Management is Pika's permission and preference-governance layer for helping evaluate available consent, IYS status and opt-out context before customer communication is executed.")
                </p>

                <p class="mb-4">
                    @(tr
                        ? "Hedef kitleye dahil olmak iletişim izni anlamına gelmez. Kampanya veya journey içinde bir kanal aksiyonuna ulaşmak da gönderimin hiçbir izin kontrolü olmadan yapılacağı anlamına gelmez."
                        : "Belonging to an audience does not mean permission to communicate. Reaching a channel action inside a campaign or journey also does not mean delivery occurs without consent checks.")
                </p>

                <p class="mb-2">
                    @(tr
                        ? "Consent Management'in temel sorusu şudur:"
                        : "Consent Management answers one central question:")
                </p>

                <div class="consent-question-box">
                    <h3 class="mb-0">
                        @(tr
                            ? "“Bu iletişim, mevcut izin bağlamında uygun mu?”"
                            : "“Is this communication eligible under the available consent context?”")
                    </h3>
                </div>

                <p class="mb-4">
                    @(tr
                        ? "Pika'nın ilgili gönderim akışları mevcut izin ve suppression bağlamını iletişim icrasından önce değerlendirebilir."
                        : "Relevant Pika delivery flows can evaluate available permission and suppression context before communication execution.")
                </p>

                <p class="fw-semibold mb-0">
                    @(tr
                        ? "Consent Management ticari fırsatı üretmez. İletişimin izin açısından uygulanabilir olup olmadığını kontrol sürecine taşır."
                        : "Consent Management does not create the commercial opportunity. It brings permission eligibility into the communication-control process.")
                </p>
            </div>
        </div>
    </div>
</section>

@* ── 03 WHY CONSENT BELONGS IN THE DELIVERY DECISION ──────────── *@
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="pika-sol-eyebrow text-uppercase mb-2">@(tr ? "HEDEF KİTLE ≠ İLETİŞİM İZNİ" : "AUDIENCE ≠ CONSENT")</div>
                <h2 class="pika-h2 fw-bold mb-4">
                    @(tr
                        ? "Doğru müşteri, izinli iletişim anlamına gelmez."
                        : "The right customer does not automatically mean permitted communication.")
                </h2>

                <p class="mb-4">
                    @(tr
                        ? "Customer Intelligence veya Audience Manager belirli bir müşteri bağlamını ticari açıdan anlamlı hale getirebilir. Bu müşterinin kampanya için uygun olması, seçilen iletişim kanalında güncel izin durumunun da uygun olduğu anlamına gelmez."
                        : "Customer Intelligence or Audience Manager can make a particular customer context commercially relevant. That customer being appropriate for a campaign does not mean current permission for the selected communication channel is also appropriate.")
                </p>

                <p class="mb-4">
                    @(tr
                        ? "İzin bağlamı aksiyondan ayrı tutulduğunda hedef kitle ile gerçekten iletişim kurulabilir müşteri kümesi birbirine karışabilir."
                        : "When consent context is separated from action, the target audience and customers who can actually be contacted can become confused.")
                </p>

                <p class="mb-4">
                    @(tr
                        ? "Consent Management bu ayrımı gönderim kararının içine taşır."
                        : "Consent Management brings that distinction into the delivery decision.")
                </p>

                <div class="row g-3 my-4">
                    <div class="col-md-4">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-dark mb-2">Audience</span>
                            <p class="fw-bold mb-0">@(tr ? "“Kiminle iletişim kurmak istiyoruz?”" : "“Who do we want to communicate with?”")</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-dark mb-2">Consent</span>
                            <p class="fw-bold mb-0">@(tr ? "“Bu müşteriyle bu iletişim bağlamında iletişim kurulabilir mi?”" : "“Can we communicate with this customer under this consent context?”")</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-dark mb-2">Delivery</span>
                            <p class="fw-bold mb-0">@(tr ? "“Uygun iletişimi hangi teknik sonuçla gönderdik?”" : "“What technical outcome did the eligible communication produce?”")</p>
                        </div>
                    </div>
                </div>

                <p class="fw-bold mb-0">
                    @(tr
                        ? "Doğru audience, izin kontrolünün yerine geçmez."
                        : "The right audience does not replace consent checks.")
                </p>
            </div>
        </div>
    </div>
</section>

@* ── 04 COMMUNICATION ELIGIBILITY CONTEXT ─────────────────────── *@
<section class="pika-sol-section">
    <div class="container">
        <div class="row justify-content-center mb-4">
            <div class="col-lg-10 text-center">
                <div class="pika-sol-eyebrow text-uppercase mb-2">@(tr ? "UYGUNLUK BAĞLAMI" : "ELIGIBILITY CONTEXT")</div>
                <h2 class="pika-h2 fw-bold mb-3">
                    @(tr
                        ? "İletişim kararını, tek bir izin alanına indirgemeyin."
                        : "Do not reduce the communication decision to one consent field.")
                </h2>
                <p class="pika-sol-section-desc">
                    @(tr
                        ? "Gönderim uygunluğu farklı kontrol sinyallerinin birlikte değerlendirilmesini gerektirebilir."
                        : "Delivery eligibility can require evaluation of multiple control signals.")
                </p>
            </div>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-md-4">
                <div class="pika-sol-card h-100">
                    <div class="pika-sol-card-icon"><i class="ri-search-eye-line"></i></div>
                    <h4>@(tr ? "IYS Durumu" : "IYS Status")</h4>
                    <p>
                        @(tr
                            ? "Uygulanabilir ticari iletişim bağlamında gönderim öncesi IYS durum kontrolü, izin değerlendirmesinin girdilerinden biri olabilir."
                            : "Where applicable to commercial communication, a pre-dispatch IYS status check can provide one input into consent evaluation.")
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="pika-sol-card h-100">
                    <div class="pika-sol-card-icon"><i class="ri-forbid-2-line"></i></div>
                    <h4>@(tr ? "Pika Opt-Out Kaydı" : "Pika Opt-Out State")</h4>
                    <p>
                        @(tr
                            ? "Pika'da bulunan merkezi opt-out durumu, iletişimin suppression kapsamında değerlendirilmesine yardımcı olur."
                            : "Central opt-out state held in Pika helps determine whether communication should be suppressed.")
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="pika-sol-card h-100">
                    <div class="pika-sol-card-icon"><i class="ri-toggle-line"></i></div>
                    <h4>@(tr ? "Email / SMS Tercihi" : "Email / SMS Preference")</h4>
                    <p>
                        @(tr
                            ? "Public preference-update akışında müşterinin Email ve SMS tercihleri güncellenebilir."
                            : "Customers can update Email and SMS preferences through the public preference-update flow.")
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="pika-sol-card h-100">
                    <div class="pika-sol-card-icon"><i class="ri-whatsapp-line"></i></div>
                    <h4>@(tr ? "WhatsApp Opt-In Bağlamı" : "WhatsApp Opt-In Context")</h4>
                    <p>
                        @(tr
                            ? "WhatsApp opt-in bilgisi aynı Email/SMS public formundan yönetilmez; ayrı webhook veya import akışlarından gelen bağlam kullanılır."
                            : "WhatsApp opt-in is not managed through the same Email/SMS public form; context comes through separate webhook or import flows.")
                    </p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="pika-sol-card h-100">
                    <div class="pika-sol-card-icon"><i class="ri-route-line"></i></div>
                    <h4>@(tr ? "Kanal ve Gönderim Bağlamı" : "Channel & Delivery Context")</h4>
                    <p>
                        @(tr
                            ? "İzin uygunluğu, gerçek gönderim ve provider sonucu ile aynı şey değildir; kanal icrası ayrıca değerlendirilir."
                            : "Consent eligibility is not the same thing as actual delivery or provider outcome; channel execution is evaluated separately.")
                    </p>
                </div>
            </div>
        </div>

        <div class="row justify-content-center mt-4">
            <div class="col-lg-10 text-center">
                <p class="fw-semibold text-muted mb-0">
                    @(tr
                        ? "Consent Management'in görevi tek bir “izin var/yok” etiketi üretmek değil, kullanılabilir izin bağlamını gönderim kararına taşımaktır."
                        : "The role of Consent Management is not to produce one universal “consent yes/no” label, but to bring available permission context into the delivery decision.")
                </p>
            </div>
        </div>
    </div>
</section>

@* ── 05 PRE-DISPATCH IYS CHECK ────────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="iys">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="pika-sol-eyebrow text-uppercase mb-2">@(tr ? "IYS KONTROLÜ" : "IYS CHECK")</div>
                <h2 class="pika-h2 fw-bold mb-4">
                    @(tr
                        ? "Uygulanabilir izin durumunu, gönderimden önce değerlendirin."
                        : "Evaluate applicable consent state before delivery.")
                </h2>

                <p class="mb-3">
                    @(tr
                        ? "Pika'nın gönderim sürecinde, ilgili ticari iletişim bağlamı için IYS durumu iletişim icrasından önce sorgulanabilir."
                        : "Within Pika's delivery process, IYS status for relevant commercial-communication context can be queried before communication execution.")
                </p>

                <p class="mb-3">
                    @(tr
                        ? "Bu kontrolün sonucu gönderimin uygunluk değerlendirmesinde kullanılabilir ve uygun olmayan iletişim suppression kapsamına alınabilir."
                        : "The result can participate in delivery-eligibility evaluation, and ineligible communication can be suppressed.")
                </p>

                <p class="mb-4">
                    @(tr
                        ? "IYS kontrolü Pika'nın müşterinin ticari veya hukuki gerçeğini kendi başına belirlediği anlamına gelmez."
                        : "An IYS check does not mean Pika independently defines the customer's commercial or legal truth.")
                </p>

                <div class="row g-3 my-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-dark mb-2">@(tr ? "IYS sorgusu" : "The IYS query")</span>
                            <p class="mb-0">
                                @(tr
                                    ? "mevcut izin durumuna ilişkin kontrol girdisi sağlar."
                                    : "provides a control input about available consent state.")
                            </p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-dark mb-2">Pika</span>
                            <p class="mb-0">
                                @(tr
                                    ? "bu bağlamı gönderim öncesi uygunluk değerlendirmesinde kullanır."
                                    : "uses that context during pre-dispatch eligibility evaluation.")
                            </p>
                        </div>
                    </div>
                </div>

                <p class="fw-bold mb-0">
                    @(tr
                        ? "Pika IYS'nin yerine geçmez. IYS bağlamını iletişim kontrol sürecine taşır."
                        : "Pika does not replace IYS. It brings IYS context into the communication-control process.")
                </p>
            </div>
        </div>
    </div>
</section>

@* ── 06 CENTRAL OPT-OUT & SUPPRESSION ─────────────────────────── *@
<section class="pika-sol-section" id="optout">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="pika-sol-eyebrow text-uppercase mb-2">OPT-OUT</div>
                <h2 class="pika-h2 fw-bold mb-4">
                    @(tr
                        ? "İletişim istemeyen müşteriyi, kampanya kuralıyla yeniden açmayın."
                        : "Do not reopen communication through a campaign rule after the customer has opted out.")
                </h2>

                <p class="mb-3">
                    @(tr
                        ? "Opt-out, müşterinin iletişim istemediğine ilişkin önemli bir suppression sinyalidir."
                        : "Opt-out is an important suppression signal indicating that the customer does not want communication.")
                </p>

                <p class="mb-3">
                    @(tr
                        ? "Pika'nın merkezi opt-out kaydı gönderim uygunluğu değerlendirmesinde kontrol edilebilir."
                        : "Pika's centralized opt-out state can be checked during delivery-eligibility evaluation.")
                </p>

                <p class="mb-4">
                    @(tr
                        ? "Müşterinin bir audience'a girmesi, bir fırsata sahip olması veya bir journey adımına ulaşması opt-out durumunu ortadan kaldırmaz."
                        : "A customer entering an audience, having an opportunity or reaching a journey step does not remove their opt-out state.")
                </p>

                <div class="row g-3 my-4">
                    <div class="col-md-4">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-dark mb-2">Audience membership</span>
                            <p class="mb-0">@(tr ? "iletişim nedeni oluşturabilir." : "can establish a reason for communication.")</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-dark mb-2">Opportunity</span>
                            <p class="mb-0">@(tr ? "ticari bağlam oluşturabilir." : "can establish commercial context.")</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-white border rounded-3 h-100">
                            <span class="badge bg-light text-dark mb-2">Opt-out</span>
                            <p class="mb-0">@(tr ? "iletişimin baskılanmasını gerektiren izin sinyali olabilir." : "can be a permission signal requiring suppression.")</p>
                        </div>
                    </div>
                </div>

                <p class="fw-bold mb-0">
                    @(tr
                        ? "Aksiyon mantığı, opt-out kontrolünün yerine geçmez."
                        : "Action logic does not replace opt-out control.")
                </p>
            </div>
        </div>
    </div>
</section>

@* ── 07 EMAIL / SMS PREFERENCE UPDATE FLOW ────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="preferences">
    <div class="container">
        <div class="row justify-content-center mb-4">
            <div class="col-lg-10">
                <div class="pika-sol-eyebrow text-uppercase mb-2">@(tr ? "MÜŞTERİ TERCİHİ" : "CUSTOMER PREFERENCE")</div>
                <h2 class="pika-h2 fw-bold mb-4">
                    @(tr
                        ? "Email ve SMS tercihlerini, müşterinin güncelleyebileceği bir akışta yönetin."
                        : "Manage Email and SMS preferences through a flow customers can update.")
                </h2>

                @* Conceptual Permission-Decision Map replacing fake dashboard metric bars *@
                <div class="consent-map-grid mb-4" aria-label="@(tr ? "İzin karar haritası" : "Permission decision map")">
                    <div class="consent-map-card">

            </div>
            <div class="pika-sol-workflow-step">
                <div class="pika-sol-workflow-num">4</div>
                <h5>@(tr ? "İzleyin" : "Monitor")</h5>
                <p>@(tr ? "Uyumluluk durumunu izleyin ve raporlayın." : "Monitor and report compliance status.")</p>
            </div>
        </div>
    </div>
</section>


                <div class="pika-sol-workflow-num">1</div>
                <h5>@(tr ? "İzinleri Kaydedin" : "Record Permissions")</h5>
                <p>@(tr ? "İzinleri merkezi olarak kayıt altına alın." : "Record permissions centrally.")</p>
            </div>
            <div class="pika-sol-workflow-step">
                <div class="pika-sol-workflow-num">2</div>
                <h5>@(tr ? "Tercihleri Tanımlayın" : "Define Preferences")</h5>
                <p>@(tr ? "Kanal ve içerik tercihlerini belirleyin." : "Set channel and content preferences.")</p>
            </div>
            <div class="pika-sol-workflow-step">
                <div class="pika-sol-workflow-num">3</div>
                <h5>@(tr ? "Entegre Edin" : "Integrate")</h5>

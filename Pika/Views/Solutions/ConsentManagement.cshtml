        <div class="pika-sol-card-grid">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-shield-check-line"></i></div>
                <h4>@(tr ? "İzin kaydı ve takibi" : "Permission recording & tracking")</h4>
                <p>@(tr ? "İzin alım ve değişiklik geçmişini kayıt altına alın." : "Record permission acquisition and change history.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-settings-3-line"></i></div>

@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]="Consent Management | "+(tr?"İzin ve Kanal Uygunluğu":"Consent & Channel Eligibility"); ViewData["MetaDescription"]=tr?"Kanal izni, opt-out, ulaşılabilirlik ve İYS bağlamını gönderim kararında birlikte değerlendirin; kişi kaydı ile iletişim iznini birbirinden ayırın.":"Evaluate channel consent, opt-out, reachability and IYS context before delivery, keeping contact records separate from communication consent."; ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">Platform · Consent Management</span><h1>@(tr?"Kişi kaydı, iletişim izni değildir.":"A contact record is not communication consent.")</h1><p>@(tr?"Pika, kanal izni, opt-out, ulaşılabilirlik ve İYS bağlamını gönderim kararından önce ayrı sinyaller olarak değerlendirir. Amaç sırf fırsat oluştu diye uygun olmayan bir kanaldan iletişim başlatmamaktır.":"Pika treats channel consent, opt-out, reachability and IYS context as separate pre-delivery signals, so an opportunity does not automatically justify communication through an ineligible channel.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/izin-optout-iys">@(tr?"İzin ve İYS Rehberi":"Consent & IYS Guide")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_izin-kanal-zamanlama_25.png" alt="@(tr?"Pika izin kanal ve zamanlama ekranı":"Pika consent channel and timing screen")" width="1200" height="760" /><figcaption>@(tr?"İzin, kanal uygunluğu ve zamanlama aynı kararın farklı kontrolleridir.":"Consent, channel eligibility and timing are separate controls in the same decision.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-flow"><div class="pk-flow-item"><small>01</small><strong>@(tr?"Kişi":"Contact")</strong><span>@(tr?"Müşteri/iletişim kaydı mevcut mu?":"Is contact data available?")</span></div><div class="pk-flow-item"><small>02</small><strong>@(tr?"Adres":"Address")</strong><span>@(tr?"Email/telefon/WhatsApp adresi kullanılabilir mi?":"Is the channel address reachable?")</span></div><div class="pk-flow-item"><small>03</small><strong>@(tr?"İzin":"Consent")</strong><span>@(tr?"İlgili kanalda izin var mı?":"Is the channel permitted?")</span></div><div class="pk-flow-item"><small>04</small><strong>Opt-out</strong><span>@(tr?"Müşteri iletişimden çıktı mı?":"Has the customer opted out?")</span></div><div class="pk-flow-item"><small>05</small><strong>@(tr?"Uygunluk":"Eligibility")</strong><span>@(tr?"Gönderim yapılabilir mi?":"Can delivery proceed?")</span></div><div class="pk-flow-item"><small>06</small><strong>@(tr?"Aksiyon":"Action")</strong><span>@(tr?"Uygunsa Campaign/Journey":"Campaign/Journey if eligible")</span></div></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">İYS</span><h2>@(tr?"İYS verisini operasyonel karara taşıyın; hukuki sorumluluğu otomatik varsaymayın.":"Use IYS context operationally without assuming it transfers legal responsibility.")</h2></div><p class="pk-lead">@(tr?"Pika'da İYS entegrasyonuna yönelik istemci servis ve yönetim ekranı bulunur. Entegrasyon kapsamı, veri kaynağı, ileti türü ve yürürlükteki mevzuat müşterinin kendi süreçlerinde ayrıca değerlendirilmelidir. Pika hukuki danışmanlık veya mutlak uyum garantisi sunmaz.":"Pika includes client/service and management support for IYS integration. Integration scope, data source, communication type and applicable law still require customer-side evaluation. Pika does not replace legal advice or provide an absolute compliance guarantee.")</p></div></section>
<section class="pk-section"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">@(tr?"Fırsat → uygunluk":"Opportunity → eligibility")</span><h2>@(tr?"Doğru müşteri bulunması, her kanaldan ulaşılabileceği anlamına gelmez.":"Finding the right customer does not make every channel eligible.")</h2></div><div><p class="pk-lead">@(tr?"Günün Fırsatları veya Next Best Channel bağlamında güçlü bir ticari sinyal oluşsa bile izin/opt-out kontrolü aksiyondan bağımsızdır. Hiç uygun kanal yoksa güvenli sonuç aksiyon üretmemek olabilir.":"Even when Daily Opportunities or channel-decision logic identifies a strong commercial signal, consent/opt-out remains independent. If no channel is eligible, safe behavior may be to take no delivery action.")</p><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/gunun-firsatlari":"/en/platform/opportunities")">@(tr?"Günün Fırsatları":"Daily Opportunities")</a></div></div></section>

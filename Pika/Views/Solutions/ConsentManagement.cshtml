            </div>
        </div>
    </div>
</section>

<!-- PROBLEM/SOLUTION -->
<section class="pika-sol-section">
    <div class="container">
        <h2 class="pika-sol-section-title" data-aos="fade-up">@(tr ? "İzin yönetimini operasyonun doğal parçası haline getirin" : "Make consent management a natural part of operations")</h2>
        <div class="pika-sol-problem-grid" data-aos="fade-up" data-aos-delay="100">
            <div class="pika-sol-problem-card pika-sol-problem-card--problem"><i class="ri-error-warning-line"></i> @(tr ? "İzinsiz iletişim riski" : "Risk of communication without consent")</div>
            <div class="pika-sol-problem-card pika-sol-problem-card--solution"><i class="ri-check-double-line"></i> @(tr ? "Otomatik izin doğrulama" : "Automatic permission verification")</div>
            <div class="pika-sol-problem-card pika-sol-problem-card--problem"><i class="ri-error-warning-line"></i> @(tr ? "Dağınık izin kayıtları" : "Scattered permission records")</div>
            <div class="pika-sol-problem-card pika-sol-problem-card--solution"><i class="ri-check-double-line"></i> @(tr ? "Merkezi izin ve denetim kaydı" : "Central permission and audit registry")</div>
        </div>
    </div>
</section>


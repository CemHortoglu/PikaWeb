@{
    var tr = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = tr ? "Email Marketing ve Template Studio | Pika" : "Email Marketing and Template Studio | Pika";
    ViewData["MetaDescription"] = tr ? "Pika ile email kampanyalarınızı oluşturun, AI destekli içerik taslakları hazırlayın ve email template tasarımlarınızı yönetin." : "Create your email campaigns with Pika, prepare AI-powered content drafts and manage your email template designs.";
    ViewData["MetaKeywords"] = "email marketing,email template,email kampanya,ai email içerik,pika email studio";
}

<!-- HERO -->
<section class="pika-sol-hero" data-module="email">
    <div class="container">
        <nav class="pika-sol-breadcrumb" data-aos="fade-down" data-aos-duration="500">
            <a href="@(tr ? "/" : "/en/")">@(tr ? "Ana Sayfa" : "Home")</a>
            <span class="sep">/</span>
            <span>@(tr ? "Email Marketing ve Template Studio" : "Email Marketing and Template Studio")</span>
        </nav>
        <div class="pika-sol-hero-grid">
            <div data-aos="fade-right" data-aos-duration="700">
                <h1>@(tr ? "Email Marketing ve Template Studio" : "Email Marketing and Template Studio")</h1>
                <p class="pika-sol-hero-desc">@(tr ? "Pika ile email kampanyalarınızı oluşturun, AI destekli içerik taslakları hazırlayın ve email template tasarımlarınızı kampanya süreçlerinizle birlikte yönetin." : "Create your email campaigns with Pika, prepare AI-powered content drafts and manage your email template designs alongside your campaign processes.")</p>
                <div class="pika-sol-hero-actions">
                    <button type="button" class="btn pika-btn-primary px-4 py-2" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i></button>
                </div>
                <div class="pika-sol-hero-tags">
                    <span class="pika-sol-tag"><i class="ri-mail-line"></i> @(tr ? "Email kampanyaları" : "Email campaigns")</span>
                    <span class="pika-sol-tag"><i class="ri-robot-line"></i> @(tr ? "AI içerik üretimi" : "AI content generation")</span>
                    <span class="pika-sol-tag"><i class="ri-palette-line"></i> @(tr ? "Template tasarımı" : "Template design")</span>
                </div>
            </div>
            <div class="pika-sol-hero-scene" data-aos="fade-left" data-aos-duration="700" data-aos-delay="200">
                <div class="pika-sol-scene-main">
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block wide"><i class="ri-mail-line"></i> @(tr ? "Email Kampanya Oluştur" : "Create Email Campaign")</div>
                    </div>
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block"><i class="ri-robot-line"></i> @(tr ? "AI İçerik" : "AI Content")</div>
                        <div class="pika-sol-scene-block"><i class="ri-palette-line"></i> Template</div>
                    </div>
                    <div class="pika-sol-scene-row">
                        <div class="pika-sol-scene-block wide"><i class="ri-bar-chart-box-line"></i> @(tr ? "Performans Takibi" : "Performance Tracking")</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- GENEL BAKIŞ -->
<section class="pika-sol-section" style="background:var(--pika-bg2)">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h2 class="pika-h2 fw-bold">@(tr ? "Email kampanyalarınızı tek platformda yönetin" : "Manage your email campaigns on a single platform")</h2>
            <p class="ph-muted mx-auto" style="max-width:700px">@(tr ? "Pika, email kampanyalarınızı hedef kitle, içerik, template, gönderim ve performans takibiyle birlikte yönetmenize yardımcı olur." : "Pika helps you manage your email campaigns together with audience, content, template, delivery and performance tracking.")</p>
        </div>
    </div>
</section>

<!-- AI -->
<section class="pika-sol-section">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">AI</span>
            <h2 class="pika-h2 fw-bold">@(tr ? "AI destekli email içeriği üretimi" : "AI-powered email content generation")</h2>
            <p class="ph-muted mx-auto" style="max-width:600px">@(tr ? "Kampanya fikrinize göre konu başlığı, preheader, gövde metni ve çağrı aksiyonu taslakları oluşturun." : "Generate subject line, preheader, body text and call to action drafts based on your campaign idea.")</p>
        </div>
        <div class="row g-4" data-aos="fade-up" data-aos-delay="100">
            @{
                var cards = tr
                    ? new (string t, string d, string i)[] {
                        ("Email subject üretimi", "Açılma oranını destekleyecek konu başlığı alternatifleri oluşturun.", "ri-text"),
                        ("Preheader önerileri", "Email'in ilk görünümünü güçlendirecek kısa açıklamalar hazırlayın.", "ri-file-text-line"),
                        ("Gövde metni", "Kampanya amacına uygun email içerik taslakları üretin.", "ri-quill-pen-line"),
                        ("Template tasarımı", "Kampanyaya uygun email template taslakları oluşturun ve düzenleyin.", "ri-palette-line"),
                        ("Test gönderimi", "Yayına almadan önce email görünümünü ve içeriğini kontrol edin.", "ri-send-plane-line"),
                        ("Performans takibi", "Açılma, tıklama ve dönüşüm metriklerini izleyin.", "ri-bar-chart-box-line")
                    }
                    : new (string t, string d, string i)[] {
                        ("Email subject generation", "Create subject line alternatives to support open rates.", "ri-text"),
                        ("Preheader suggestions", "Prepare short descriptions to strengthen the email's first impression.", "ri-file-text-line"),
                        ("Body text", "Generate email content drafts suitable for the campaign purpose.", "ri-quill-pen-line"),
                        ("Template design", "Create and edit email template drafts suitable for the campaign.", "ri-palette-line"),
                        ("Test sending", "Check email appearance and content before going live.", "ri-send-plane-line"),
                        ("Performance tracking", "Monitor open, click and conversion metrics.", "ri-bar-chart-box-line")
                    };
            }
            @foreach (var c in cards)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="ph-module-card">
                        <div class="ph-module-icon"><i class="@c.i"></i></div>
                        <h6 class="fw-bold mb-2">@c.t</h6>
                        <p class="small ph-muted mb-0">@c.d</p>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a href="@Url.RouteUrl("AiCampaignAssistant", new { culture = ViewContext.RouteData.Values["culture"] ?? "tr" })" class="btn pika-btn-primary px-4 py-2">@(tr ? "AI Kampanya Asistanını İncele" : "Explore AI Campaign Assistant") <i class="ri-arrow-right-line"></i></a>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="ph-cta-section">
    <div class="container text-center" data-aos="fade-up">
        <h2 class="ph-cta-title text-white mx-auto" style="max-width:680px">@(tr ? "Email Kampanyalarınızı Pika ile Oluşturun" : "Create Your Email Campaigns with Pika")</h2>
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <button type="button" class="ph-btn-light" data-bs-toggle="modal" data-bs-target="#demoModal"><span>@(tr ? "Demo Talep Et" : "Request a Demo")</span> <i class="ri-arrow-right-up-line"></i></button>
        </div>
    </div>
</section>

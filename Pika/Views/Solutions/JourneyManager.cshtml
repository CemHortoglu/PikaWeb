@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]="Journey Manager | "+(tr?"Müşteri Akışları":"Customer Flows");
    ViewData["MetaDescription"]=tr?"Pika Journey Manager ile tetikleyici, karar, bekleme ve aksiyon adımlarından oluşan çok aşamalı müşteri akışları tasarlayın; akışı kontrollü biçimde yayınlayın ve ölçün.":"Use Pika Journey Manager to design multi-step customer flows with triggers, decisions, waits and actions, then publish and measure them with control.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">Platform · Journey Manager</span><h1>@(tr?"Müşteri ilişkisinin zaman içinde nasıl ilerleyeceğini tasarlayın.":"Design how the customer relationship progresses over time.")</h1><p>@(tr?"Journey Manager, tek seferlik gönderimin ötesinde tetikleyici, karar, bekleme ve aksiyon adımlarını görsel bir müşteri akışında birleştirir. Amaç müşterinin hangi koşulda, ne zaman ve hangi sonraki adıma geçeceğini yönetilebilir hale getirmektir.":"Journey Manager goes beyond one-off sends by combining triggers, decisions, waits and actions in a visual customer flow. It makes the customer's next step manageable according to context and timing.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Journey Manager'ı Canlı Görün":"See Journey Manager Live")</button><a class="pk-btn pk-btn-ghost" href="/wiki/journey-tasarim-tuvali">@(tr?"Journey rehberi":"Journey guide")</a></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_journey-tasarim-tuvali_18.png" alt="@(tr?"Pika Journey tasarım tuvali":"Pika Journey design canvas")" width="1200" height="760" /><div class="pk-stage-caption"><strong>Journey Manager</strong><span>Trigger → Condition → Wait → Action</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-play-circle-line"></i><div><strong>Trigger</strong><small>@(tr?"Akışı başlat":"Start the flow")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-git-branch-line"></i><div><strong>Decision</strong><small>@(tr?"Koşula göre ayrıl":"Branch by condition")</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-timer-line"></i><div><strong>Wait + Action</strong><small>@(tr?"Doğru zamanda ilerle":"Progress at the right time")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Tanım":"Definition")</span><h2>@(tr?"Journey Manager nedir?":"What is Journey Manager?")</h2></div><p class="pk-lead">@(tr?"Journey Manager, müşterinin bir tetikleyiciyle akışa girdiği ve zaman, iş kuralı, segment, profil veya desteklenen davranış bağlamına göre farklı adımlardan ilerlediği sürekli otomasyon katmanıdır. Campaign'den farklı olarak tek bir yayın anına değil, müşteri yolculuğunun zaman içindeki ilerleyişine odaklanır.":"Journey Manager is the ongoing automation layer where customers enter through a trigger and progress through steps based on time, business rules, segments, profile or supported behavioral context. Unlike Campaign, it focuses on progression over time rather than one publishing moment.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-play-circle-line"></i><strong>Trigger</strong><span>@(tr?"Akışı başlatan olay veya koşul":"Event or condition starting the flow")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-git-branch-line"></i><strong>Decision</strong><span>@(tr?"Kural veya müşteri bağlamına göre yol seç":"Choose a path by rule or customer context")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-timer-line"></i><strong>Wait</strong><span>@(tr?"Zamanı ve beklemeyi yönet":"Control timing and delays")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-flashlight-line"></i><strong>Action</strong><span>@(tr?"İletişim veya desteklenen operasyon adımı":"Communication or supported operation")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-shield-check-line"></i><strong>Control</strong><span>@(tr?"Doğrula · yayınla · duraklat":"Validate · publish · pause")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>Measure</strong><span>@(tr?"Akış sonucunu değerlendir":"Review flow outcomes")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Görsel tasarım":"Visual orchestration")</span><h2>@(tr?"Müşteri akışını kod satırı gibi değil, karar haritası gibi yönetin.":"Manage customer flows as decision maps, not lines of code.")</h2></div><p class="pk-lead">@(tr?"Journey tuvali, akışın hangi adımlardan oluştuğunu ve müşterinin hangi koşullarda farklı yola gideceğini görünür kılar. Görsel tasarımın amacı dekorasyon değil; ekip içinde akış mantığını anlaşılır ve yönetilebilir hale getirmektir.":"The Journey canvas makes steps and branching conditions visible. The purpose of visual design is not decoration, but making flow logic understandable and manageable across teams.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_journey-tasarim-tuvali_18.png" alt="@(tr?"Pika Journey tasarım tuvali ürün ekranı":"Pika Journey design canvas product screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Journey Canvas</small><h3>@(tr?"Akışı uçtan uca görün":"See the flow end to end")</h3><p>@(tr?"Tetikleyici, karar, bekleme ve aksiyon adımlarını aynı görsel bağlamda düzenleyin." : "Arrange triggers, decisions, waits and actions in the same visual context.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_journey-karar-kurallari_19.png" alt="@(tr?"Pika Journey karar kuralları":"Pika Journey decision rules")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Karar kuralları":"Decision rules")</small><h3>@(tr?"Akış yalnız çizgilerden ibaret değildir":"A Journey is more than connected boxes")</h3><p>@(tr?"Segment, profil, izin veya desteklenen davranış bağlamıyla müşterinin hangi yola ilerleyeceğini tanımlayın." : "Use segment, profile, consent or supported behavior context to define the path a customer follows.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">@(tr?"Karar kuralları":"Decision rules")</span><h2>@(tr?"Aynı Journey içinde her müşteri aynı yolu izlemek zorunda değil.":"Not every customer has to follow the same path within a Journey.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Journey'nin değeri yalnız otomatik mesaj göndermesinde değil, müşterinin mevcut bağlamına göre farklı karar yolları uygulayabilmesindedir. Bir müşteri uygun iletişim iznine sahip olabilir, diğeri olmayabilir; biri fırsat koşulunu karşılayabilir, diğeri farklı bir adıma ilerleyebilir.":"Journey value is not merely automated messaging, but applying different paths according to customer context. One customer may be eligible for communication while another is not; one may meet an opportunity condition while another follows a different path.")</p></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-play-circle-line"></i><div><strong>@(tr?"Giriş koşulu":"Entry condition")</strong><span>@(tr?"Müşterinin Journey'e hangi olay veya kuralla dahil olacağını tanımlayın." : "Define which event or rule allows the customer to enter the Journey.")</span></div></div><div class="pk-control-step"><i class="ri-git-branch-line"></i><div><strong>@(tr?"Karar noktası":"Decision point")</strong><span>@(tr?"Segment, profil veya desteklenen davranış bağlamına göre yolları ayırın." : "Branch paths using segment, profile or supported behavior context.")</span></div></div><div class="pk-control-step"><i class="ri-shield-check-line"></i><div><strong>@(tr?"Uygunluk":"Eligibility")</strong><span>@(tr?"İletişim aksiyonunda izin, opt-out ve kanal uygunluğu bağlamını koruyun." : "Preserve consent, opt-out and channel eligibility context at communication actions.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-user-settings-line"></i><div><strong>@(tr?"Yayın ve yaşam döngüsü":"Publishing and lifecycle")</strong><span>@(tr?"Journey yayınlama, duraklatma ve güncelleme kontrollü operasyon adımlarıdır." : "Publishing, pausing and updating a Journey are controlled operational steps.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">Journey vs Campaign</span><h2>@(tr?"Bir kez gönder mi, ilişkiyi zaman içinde yönet mi?":"Execute once, or manage the relationship over time?")</h2></div><p class="pk-lead">@(tr?"Campaign Manager tanımlı bir hedef kitle, içerik, kanal ve zamanlama için uygundur. Journey Manager ise müşterinin bir olayla akışa girip koşul ve zaman boyunca ilerlediği sürekli senaryoları yönetir. İkisi de aynı intelligence ve fırsat ekosisteminden beslenebilir; biri diğerinin gelişmiş versiyonu değildir.":"Campaign Manager is suited to defined audience/content/channel/timing execution. Journey Manager handles ongoing scenarios where a customer enters through an event and progresses through conditions and time. Both can use the same intelligence and opportunity context; neither is simply an advanced version of the other.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>Campaign</small><i class="ri-megaphone-line"></i><strong>@(tr?"Tanımlı kampanya":"Defined campaign")</strong><span>@(tr?"Belirli kitle ve amaç":"Defined audience and purpose")</span></div><div class="pk-workflow-step"><small>Campaign</small><i class="ri-calendar-event-line"></i><strong>@(tr?"Planlı zaman":"Planned time")</strong><span>@(tr?"Belirli yayınlama operasyonu":"Defined publishing operation")</span></div><div class="pk-workflow-step"><small>Campaign</small><i class="ri-bar-chart-line"></i><strong>@(tr?"Kampanya sonucu":"Campaign outcome")</strong><span>@(tr?"Tek kampanya bağlamında ölçüm":"Measurement in campaign context")</span></div><div class="pk-workflow-step"><small>Journey</small><i class="ri-play-circle-line"></i><strong>Trigger</strong><span>@(tr?"Olayla başla":"Start with an event")</span></div><div class="pk-workflow-step"><small>Journey</small><i class="ri-git-branch-line"></i><strong>Condition + Wait</strong><span>@(tr?"Duruma ve zamana göre ilerle":"Progress by context and time")</span></div><div class="pk-workflow-step"><small>Journey</small><i class="ri-route-line"></i><strong>@(tr?"Sürekli akış":"Ongoing flow")</strong><span>@(tr?"Müşteri yolculuğunu yönet":"Manage customer progression")</span></div></div><div class="pk-decision-note"><p>@(tr?"Bir kampanyayı Journey yapmak için sırf daha gelişmiş göründüğü için taşımayın. Tek seferlik hedefli aksiyon Campaign; olay/koşul/zaman boyunca devam eden ilişki mantığı Journey için daha uygundur." : "Do not move a campaign into Journey simply because Journey looks more advanced. Defined one-time action fits Campaign; ongoing event/condition/time logic fits Journey.")</p><a class="pk-btn pk-btn-light" href="@(tr?"/platform/campaign-manager":"/en/platform/campaign-manager")">Campaign Manager</a></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Fırsattan Journey'e":"From opportunity to Journey")</span><h2>@(tr?"Tek bir fırsatı sürekli ilişki mantığına dönüştürün.":"Turn a single opportunity into ongoing relationship logic.")</h2></div><p class="pk-lead">@(tr?"Bir fırsat yalnız o an mesaj göndermek için kullanılmak zorunda değildir. Uygun senaryoda tekrar satın alma penceresi, pasifleşme, onboarding veya başka doğrulanmış durumlar Journey giriş/karar mantığına bağlanabilir. Böylece aksiyon belirli bir müşteri olayıyla başlayan kontrollü sürece dönüşür.":"An opportunity does not have to produce an immediate message. Where appropriate, repeat-purchase windows, inactivity, onboarding or other verified situations can feed Journey entry or decision logic, turning action into a controlled process triggered by customer context.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_aksiyon-calisma-alani_9.png" alt="@(tr?"Pika fırsattan aksiyona çalışma alanı":"Pika opportunity-to-action workspace")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Opportunity → Journey</small><h3>@(tr?"Neden aksiyon aldığınızı akışa taşıyın":"Carry the reason for action into the flow")</h3><p>@(tr?"Fırsatın müşteri ve ürün bağlamı, Journey senaryosunun giriş veya karar kurgusuna temel olabilir." : "Customer and product context behind an opportunity can inform Journey entry or decision logic.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_journey-store_21.png" alt="@(tr?"Pika Journey Store ekranı":"Pika Journey Store screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Journey Store</small><h3>@(tr?"Tekrarlanabilir akışları yeniden kullanın":"Reuse repeatable flows")</h3><p>@(tr?"Doğrulanmış Journey kurgularını ekip içinde yeniden kullanmak, aynı operasyon mantığını her seferinde baştan kurma ihtiyacını azaltabilir." : "Reusing validated Journey patterns can reduce the need to rebuild the same operational logic repeatedly.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Kanallar ve ölçüm":"Channels and measurement")</span><h2>@(tr?"Journey'nin amacı çok mesaj göndermek değil, doğru adımı doğru zamanda çalıştırmak.":"Journey is not about sending more messages; it is about running the right step at the right time.")</h2></div><p class="pk-lead">@(tr?"Email, SMS, WhatsApp ve Push gibi kanallar Journey içinde ancak ilgili aksiyon ve uygunluk bağlamında anlamlıdır. Sonuçlar desteklenen kanal ve Journey metrikleri üzerinden izlenebilir; attribution ile nedensellik birbirine karıştırılmamalıdır.":"Channels such as Email, SMS, WhatsApp and Push are useful inside Journey only within appropriate action and eligibility context. Outcomes can be reviewed through supported channel and Journey metrics; attribution should not be confused with causality.")</p></div><div class="pk-channel-grid"><a class="pk-channel" href="@(tr?"/kanallar/email":"/en/channels/email")"><i class="ri-mail-line"></i><h3>Email</h3><p>@(tr?"Zengin içerikli Journey adımları için." : "For rich-content Journey steps.")</p><span>@(tr?"Email'i inceleyin →":"Explore Email →")</span></a><a class="pk-channel" href="@(tr?"/kanallar/sms":"/en/channels/sms")"><i class="ri-message-2-line"></i><h3>SMS</h3><p>@(tr?"Kısa ve zaman duyarlı adımlar için." : "For concise, time-sensitive steps.")</p><span>@(tr?"SMS'i inceleyin →":"Explore SMS →")</span></a><a class="pk-channel" href="@(tr?"/kanallar/whatsapp":"/en/channels/whatsapp")"><i class="ri-whatsapp-line"></i><h3>WhatsApp</h3><p>@(tr?"Uygun izin ve şablon bağlamındaki mesajlaşma adımları için." : "For messaging steps within appropriate consent and template context.")</p><span>@(tr?"WhatsApp'ı inceleyin →":"Explore WhatsApp →")</span></a><a class="pk-channel" href="@(tr?"/kanallar/push":"/en/channels/push")"><i class="ri-notification-3-line"></i><h3>Push</h3><p>@(tr?"Desteklenen uygulama/push senaryolarında anlık adımlar için." : "For immediate steps in supported app/push scenarios.")</p><span>@(tr?"Push'ı inceleyin →":"Explore Push →")</span></a></div><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/analytics":"/en/platform/analytics")">@(tr?"Journey sonuçlarını ölçün":"Measure Journey outcomes")</a></div></div></section>

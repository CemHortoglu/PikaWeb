@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-solutions-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-journey-manager-page.css" asp-append-version="true" />
}

@* ── 01 HERO ─────────────────────────────────────────────────── *@
<section class="inner-hero inner-hero--journey">
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span>/</span>
                <span>Journey Manager</span>
            </nav>
            <div class="inner-eyebrow"><span></span>JOURNEY MANAGER</div>
            @if (tr)
            {
                <h1>
                    Tek bir mesajdan,<br />
                    kontrollü bir müşteri yolculuğuna geçin.
                </h1>
                <p>
                    Pika Journey Manager; başlangıç koşullarını, dallanmaları, bekleme adımlarını ve Email, SMS veya WhatsApp aksiyonlarını bir araya getirerek çok adımlı müşteri yolculukları oluşturmanızı sağlar.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.72);font-size:15px;margin-bottom:30px">
                    Amaç müşteriye art arda mesaj göndermek değil, önceden tanımlanmış koşul ve zamanlama mantığıyla her adımın ne zaman ve hangi bağlamda ilerleyeceğini yönetmektir.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Demo Talep Et ↗
                    </button>
                    <a class="inner-secondary" href="/cozumler/campaign-manager">
                        Campaign Manager'ı Keşfedin →
                    </a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="İçeriğe atla">
                        <i class="ri-arrow-down-line" aria-hidden="true"></i>
                    </a>
                </div>
            }
            else
            {
                <h1>
                    Move from one message<br />
                    to a controlled customer journey.
                </h1>
                <p>
                    Pika Journey Manager brings entry conditions, branching, wait steps and Email, SMS or WhatsApp actions together to help build multi-step customer journeys.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.72);font-size:15px;margin-bottom:30px">
                    The objective is not to send customers a sequence of messages without context. It is to manage when and under which predefined conditions each step should progress.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Request a Demo ↗
                    </button>
                    <a class="inner-secondary" href="/en/solutions/campaign-manager">
                        Explore Campaign Manager →
                    </a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="Skip to content">
                        <i class="ri-arrow-down-line" aria-hidden="true"></i>
                    </a>
                </div>
            }
        </div>
        <div class="inner-scene" aria-label="@(tr ? "Journey Manager akış yapısını anlatan örnek görünüm" : "Illustrative view of Journey Manager flow structure")">
            <div class="inner-scene-orbit" aria-hidden="true"></div>
            <div class="inner-scene-window">
                <div class="inner-window-bar">
                    <strong>pika<span>✳</span></strong>
                    <span>Journey Manager</span>
                    <small>@(tr ? "Örnek görünüm" : "Illustration")</small>
                </div>
                <div class="inner-flow" style="padding:22px 18px">
                    <div>
                        <i class="ri-flag-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "BAŞLANGIÇ" : "START")</strong>
                        </span>
                        <b>01</b>
                    </div>
                    <span class="inner-flow-link" style="height:14px"></span>
                    <div>
                        <i class="ri-git-branch-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "KOŞUL" : "CONDITION")</strong>
                        </span>
                        <b>02</b>
                    </div>
                    <span class="inner-flow-link" style="height:14px"></span>
                    <div>
                        <i class="ri-timer-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "BEKLE" : "WAIT")</strong>
                        </span>
                        <b>03</b>
                    </div>
                    <span class="inner-flow-link" style="height:14px"></span>
                    <div class="inner-flow-final">
                        <i class="ri-send-plane-line" aria-hidden="true"></i>
                        <span>
                            <strong style="margin:0">@(tr ? "AKSİYON" : "ACTION")</strong>
                        </span>
                        <b>04</b>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<div id="inner-content" class="inner-anchor"></div>

@* ── STICKY SUBNAV ───────────────────────────────────────────── *@
<div class="pika-sol-subnav-wrap">
    <div class="container">
        <nav class="pika-sol-subnav" aria-label="@(tr ? "Alt Gezinme" : "Sub Navigation")">
            <a href="#overview">@(tr ? "Genel Bakış" : "Overview")</a>
            <a href="#building-blocks">@(tr ? "Yapı Taşları" : "Building Blocks")</a>
            <a href="#conditions">@(tr ? "Koşullar" : "Conditions")</a>
            <a href="#timing">@(tr ? "Zamanlama" : "Timing")</a>
            <a href="#channels">@(tr ? "Kanallar" : "Channels")</a>
            <a href="#platform">@(tr ? "Platform İlişkisi" : "Platform Relationships")</a>
            <a href="#faq">@(tr ? "SSS" : "FAQ")</a>
        </nav>
    </div>
</div>

@* ── OPTIONAL TRUST STRIP ────────────────────────────────────── *@
<section class="pika-sol-section py-4 border-bottom">
    <div class="container">
        <div class="pika-sol-trust-strip" data-aos="fade-up">
            <div class="pika-sol-trust-item"><i class="ri-route-line"></i><span>@(tr ? "Çok Adımlı Akış" : "Multi-Step Flow")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-git-branch-line"></i><span>@(tr ? "Koşul & Dallanma" : "Conditions & Branching")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-timer-line"></i><span>@(tr ? "Bekleme Adımları" : "Wait Steps")</span></div>
            <div class="pika-sol-trust-item"><i class="ri-share-forward-line"></i><span>Email / SMS / WhatsApp</span></div>
            <div class="pika-sol-trust-item"><i class="ri-shield-check-line"></i><span>@(tr ? "Kontrollü Otomasyon" : "Controlled Automation")</span></div>
        </div>
    </div>
</section>

@* ── 02 DIRECT ANSWER ────────────────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="overview">
    <div class="container">
        <div class="p-4 rounded-4 mb-4 bg-white border" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
            <h2 class="pika-sol-section-title mb-3">@(tr ? "Journey Manager nedir?" : "What is Journey Manager?")</h2>
            <p class="mb-3" style="font-size:1.05rem;line-height:1.65;color:#23413b">
                @(tr ? "Journey Manager, Pika'da bir müşterinin veya hedef kitlenin önceden tanımlanmış başlangıç koşulları, karar noktaları, dallanmalar, bekleme adımları ve iletişim aksiyonları boyunca nasıl ilerleyeceğini yöneten çok adımlı journey orchestration katmanıdır." : "Journey Manager is Pika's multi-step journey-orchestration layer for managing how a customer or audience progresses through predefined entry conditions, decision points, branches, wait steps and communication actions.")
            </p>
            <p class="ph-muted mb-3" style="font-size:0.98rem;line-height:1.65">
                @(tr ? "Campaign Manager tanımlı bir kampanyanın kontrollü gönderim sürecine odaklanırken Journey Manager zaman içinde birden fazla adım ve karar noktasından oluşan akışı yönetir." : "Campaign Manager focuses on controlled delivery for a defined campaign, while Journey Manager manages a flow that can contain multiple steps and decision points over time.")
            </p>
            <p class="ph-muted mb-2" style="font-size:0.98rem;line-height:1.65">
                @(tr ? "Journey Manager'ın temel sorusu şudur:" : "Journey Manager answers one central question:")
            </p>
            <div class="p-4 rounded-3 text-center my-4" style="background:#f8faf4;border:1px dashed #c9dca9">
                <span class="d-block small text-uppercase fw-bold mb-1" style="letter-spacing:1px;color:#7c984c">
                    @(tr ? "TEMEL ODAK SORUSU" : "CENTRAL FOCUS QUESTION")
                </span>
                <div class="fw-bold" style="font-size:1.35rem;color:#23413b">
                    @(tr ? "“Bu müşteri bağlamında sıradaki adım ne olmalı ve hangi koşulda ilerlemeli?”" : "“In this customer context, what should the next step be, and under which condition should it progress?”")
                </div>
            </div>
            <p class="ph-muted mb-0" style="font-size:0.95rem;line-height:1.6">
                @(tr ? "Journey yapısı kullanıcı tarafından tanımlanır ve etkinleştirilir. Etkin journey içindeki ilerleme, yapılandırılmış koşul, bekleme ve aksiyon kurallarına göre yürütülebilir." : "The journey structure is defined and activated by the user. Progress inside an active journey can then follow configured condition, wait and action rules.")
            </p>
        </div>
    </div>
</section>

@* ── 03 WHY ONE-OFF CAMPAIGNS ARE NOT ALWAYS ENOUGH ───────────── *@
<section class="pika-sol-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6" data-aos="fade-right">
                <span class="ph-eyebrow">@(tr ? "TEK GÖNDERİMDEN AKIŞA" : "FROM ONE SEND TO A FLOW")</span>
                <h2 class="pika-sol-section-title mb-3">
                    @(tr ? "Bazı müşteri süreçleri tek bir kampanyayla tamamlanmaz." : "Some customer processes do not end with one campaign.")
                </h2>
                <p class="ph-muted mb-3" style="font-size:1.02rem;line-height:1.65">
                    @(tr ? "Bir kampanya belirli bir hedef kitleye belirli bir iletişimin kontrollü biçimde gönderilmesini yönetebilir. Ancak bazı müşteri süreçlerinde sonraki adım, müşterinin verdiği yanıta, geçen zamana veya yeni oluşan bir koşula bağlı olabilir." : "A campaign can manage controlled delivery of a particular communication to a defined audience. But in some customer processes, the next step may depend on a customer response, elapsed time or a newly satisfied condition.")
                </p>
                <p class="ph-muted mb-3" style="font-size:1.02rem;line-height:1.65">
                    @(tr ? "Örneğin müşteri bir adıma ulaştığında sonraki iletişim hemen gönderilmek yerine bekleyebilir. Başka bir durumda koşulun sonucuna göre farklı bir dala ilerleyebilir." : "For example, after reaching one step, the next communication may wait rather than being sent immediately. In another case, the journey may move into a different branch depending on a condition result.")
                </p>
                <p class="ph-muted mb-0" style="font-size:1.02rem;line-height:1.65">
                    @(tr ? "Journey Manager bu tür çok adımlı karar akışlarının önceden tanımlanabilmesini sağlar." : "Journey Manager allows these multi-step decision flows to be defined in advance.")
                </p>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <div class="p-4 rounded-4 bg-white border shadow-sm">
                    <div class="p-3 rounded-3 mb-3 text-center" style="background:#f8faf4;border:1px dashed #c9dca9">
                        <small class="text-uppercase fw-bold d-block mb-1" style="font-size:11px;letter-spacing:1px;color:#7c984c">
                            @(tr ? "TEK KAMPANYA" : "A CAMPAIGN")
                        </small>
                        <div class="fw-bold mb-3" style="font-size:1.1rem;color:#23413b">
                            @(tr ? "bir iletişim kararını yürütür." : "executes a communication decision.")
                        </div>
                        <small class="text-uppercase fw-bold d-block mb-1" style="font-size:11px;letter-spacing:1px;color:#7c984c">
                            @(tr ? "JOURNEY" : "A JOURNEY")
                        </small>
                        <div class="fw-bold" style="font-size:1.15rem;color:var(--pika-primary)">
                            @(tr ? "birden fazla adım arasındaki ilerleme mantığını yönetir." : "manages progression logic across multiple steps.")
                        </div>
                    </div>
                    <p class="small ph-muted mb-0 text-center">
                        @(tr ? "Bu nedenle Journey Manager'ın değeri daha fazla mesaj üretmek değil, zaman ve koşul içeren müşteri süreçlerini kontrollü bir akışa dönüştürmektir." : "The value of Journey Manager is therefore not to create more messages, but to turn customer processes involving time and conditions into controlled flows.")
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 04 THE BUILDING BLOCKS OF A JOURNEY ──────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="building-blocks">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "YAPI TAŞLARI" : "BUILDING BLOCKS")</span>
            <h2 class="pika-sol-section-title mb-3">
                @(tr ? "Journey'yi, adımları ve karar noktalarıyla tanımlayın." : "Define the journey through steps and decision points.")
            </h2>
            <p class="ph-muted mx-auto" style="max-width:720px">
                @(tr ? "Journey Manager çok adımlı bir akışı farklı görevleri olan yapı taşlarıyla oluşturur." : "Journey Manager builds a multi-step flow from building blocks with different responsibilities.")
            </p>
        </div>

        @* Conceptual Journey Sequence (replaces legacy fake canvas UI) *@
        <div class="p-4 bg-white rounded-4 border shadow-sm mb-5" aria-hidden="true" data-aos="fade-up">
            <div class="jny-sequence-flow">
                <div class="jny-step">
                    <i class="ri-flag-line"></i>
                    <span>@(tr ? "BAŞLANGIÇ" : "START")</span>
                </div>
                <div class="jny-connector"><i class="ri-arrow-right-line"></i></div>
                <div class="jny-step">
                    <i class="ri-shield-check-line"></i>
                    <span>@(tr ? "KOŞUL" : "CONDITION")</span>
                </div>
                <div class="jny-connector"><i class="ri-arrow-right-line"></i></div>
                <div class="jny-step">
                    <i class="ri-git-branch-line"></i>
                    <span>@(tr ? "DAL" : "BRANCH")</span>
                </div>
                <div class="jny-connector"><i class="ri-arrow-right-line"></i></div>
                <div class="jny-step">
                    <i class="ri-timer-line"></i>
                    <span>@(tr ? "BEKLE" : "WAIT")</span>
                </div>
                <div class="jny-connector"><i class="ri-arrow-right-line"></i></div>
                <div class="jny-step">
                    <i class="ri-send-plane-line"></i>
                    <span>@(tr ? "KANAL AKSİYONU" : "CHANNEL ACTION")</span>
                </div>
                <div class="jny-connector"><i class="ri-arrow-right-line"></i></div>
                <div class="jny-step jny-step-end">
                    <i class="ri-checkbox-circle-line"></i>
                    <span>@(tr ? "BİTİŞ" : "END")</span>
                </div>
            </div>
        </div>

        @* 6 Capability Blocks *@
        <div class="pika-sol-card-grid mb-4">
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="50">
                <div class="pika-sol-card-icon"><i class="ri-flag-line"></i></div>
                <h4>@(tr ? "Başlangıç" : "Start")</h4>
                <p>@(tr ? "Müşterinin veya hedef kitlenin journey'e hangi bağlam veya tanımlı giriş koşuluyla dahil olacağını belirler." : "Defines the context or configured entry condition through which a customer or audience enters the journey.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="100">
                <div class="pika-sol-card-icon"><i class="ri-shield-check-line"></i></div>
                <h4>@(tr ? "Koşul" : "Condition")</h4>
                <p>@(tr ? "Mevcut müşteri, davranış veya journey bağlamının tanımlanan kurala uyup uymadığını değerlendirir." : "Evaluates whether available customer, behavioral or journey context satisfies a defined rule.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="150">
                <div class="pika-sol-card-icon"><i class="ri-git-branch-line"></i></div>
                <h4>@(tr ? "Dallanma" : "Branch")</h4>
                <p>@(tr ? "Koşul sonucuna göre müşterinin farklı journey yollarından birine ilerlemesini sağlar." : "Allows the customer to progress into a different journey path based on the condition result.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="200">
                <div class="pika-sol-card-icon"><i class="ri-timer-line"></i></div>
                <h4>@(tr ? "Bekleme" : "Wait")</h4>
                <p>@(tr ? "Bir sonraki adımın hemen çalışması yerine tanımlanan zamanlama mantığına göre beklemesini sağlar." : "Allows the next step to wait according to defined timing logic rather than executing immediately.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="250">
                <div class="pika-sol-card-icon"><i class="ri-send-plane-line"></i></div>
                <h4>@(tr ? "Kanal Aksiyonu" : "Channel Action")</h4>
                <p>@(tr ? "Journey içindeki uygun iletişim adımını Email, SMS veya WhatsApp kanallarından biriyle ilişkilendirir." : "Associates an appropriate communication step in the journey with Email, SMS or WhatsApp.")</p>
            </div>
            <div class="pika-sol-card" data-aos="fade-up" data-aos-delay="300">
                <div class="pika-sol-card-icon"><i class="ri-checkbox-circle-line"></i></div>
                <h4>@(tr ? "Bitiş" : "End")</h4>
                <p>@(tr ? "Müşterinin journey içindeki tanımlı sürecinin tamamlandığı veya artık devam etmemesi gereken noktayı ifade eder." : "Represents the point where the customer's defined journey process is complete or should no longer continue.")</p>
            </div>
        </div>

        <div class="p-4 rounded-4 bg-white border text-center mx-auto" style="max-width:760px" data-aos="fade-up">
            <p class="ph-muted mb-0">
                @(tr ? "Journey'nin anlamı tek tek düğümlerde değil, bu düğümlerin hangi sırada ve hangi kurallarla birbirine bağlandığındadır." : "The meaning of a journey does not come from individual nodes alone, but from how those nodes are connected through sequence and rules.")
            </p>
        </div>
    </div>
</section>

@* ── 05 ENTRY CONTEXT & TRIGGERS ─────────────────────────────── *@
<section class="pika-sol-section">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "BAŞLANGIÇ BAĞLAMI" : "ENTRY CONTEXT")</span>
            <h2 class="pika-sol-section-title mb-3">
                @(tr ? "Journey'nin neden başladığını tanımlayın." : "Define why the journey begins.")
            </h2>
        </div>

        <div class="p-4 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Bir journey, müşterilerin rastgele içine alındığı bir mesaj dizisi değildir. Önce müşterinin hangi bağlamda veya tanımlı koşulla akışa dahil olacağı belirlenir." : "A journey is not a sequence of messages that customers enter at random. The context or configured condition through which a customer enters the flow is defined first.")
            </p>
            <p class="mb-3 ph-muted" style="line-height:1.65">
                @(tr ? "Başlangıç bağlamı müşteri veya audience üyeliği, uygun işlem bağlamı, davranışsal koşul ya da Pika'da mevcut başka bir tanımlı journey koşulundan gelebilir." : "Entry context can come from customer or audience membership, relevant transaction context, a behavioral condition or another configured journey condition available in Pika.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Buradaki trigger kavramı, journey'nin ilerlemeye başlayabilmesi için değerlendirdiği tanımlı giriş koşulunu ifade eder." : "Here, a trigger is the configured entry condition evaluated before journey progression begins.")
            </p>

            <div class="p-3 rounded-3 mb-4 text-center" style="background:#f8faf4;border:1px dashed #c9dca9">
                <div class="row g-2 text-start">
                    <div class="col-sm-6 p-2 border-bottom border-sm-0">
                        <strong style="color:var(--pika-primary)">Trigger:</strong>
                        <p class="small mb-0 mt-1" style="color:#23413b">
                            @(tr ? "“Journey ne zaman değerlendirmeye başlamalı?” sorusuna bağlam sağlar." : "provides context for: “When should this journey begin evaluation?”")
                        </p>
                    </div>
                    <div class="col-sm-6 p-2">
                        <strong style="color:#c0392b">Trigger:</strong>
                        <p class="small mb-0 mt-1" style="color:#23413b">
                            @(tr ? "“Pika ticari kararı kullanıcıdan bağımsız verdi” anlamına gelmez." : "does not mean: “Pika made the commercial decision independently of the user.”")
                        </p>
                    </div>
                </div>
            </div>

            <p class="small ph-muted mb-0">
                @(tr ? "Journey yapısının kendisi kullanıcı tarafından tanımlanır ve etkinleştirilir." : "The journey structure itself is defined and activated by the user.")
            </p>
        </div>
    </div>
</section>

@* ── 06 CONDITIONS & BRANCHING ───────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt" id="conditions">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "KOŞUL VE DALLANMA" : "CONDITIONS & BRANCHING")</span>
            <h2 class="pika-sol-section-title mb-3">
                @(tr ? "Her müşteri aynı yolu izlemek zorunda değildir." : "Not every customer has to follow the same path.")
            </h2>
        </div>

        <div class="p-4 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Çok adımlı bir journey'nin temel avantajlarından biri, bütün müşterileri tek bir doğrusal sıraya zorlamamasıdır." : "One of the key advantages of a multi-step journey is that it does not force every customer through one linear sequence.")
            </p>
            <p class="mb-3 ph-muted" style="line-height:1.65">
                @(tr ? "Bir karar noktasında tanımlı koşul değerlendirilebilir. Koşul karşılanıyorsa bir dala, karşılanmıyorsa başka bir dala ilerlenebilir." : "A configured condition can be evaluated at a decision point. If the condition is satisfied, the journey may progress into one branch; otherwise it may continue into another.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Bu koşullar mevcut customer, audience, transaction veya journey bağlamında kullanılabilen verilere dayanır." : "Those conditions rely on available customer, audience, transaction or journey context that can be used in the flow.")
            </p>

            <div class="p-3 rounded-3 mb-4 text-center" style="background:#f8faf4;border:1px dashed #c9dca9">
                <small class="text-uppercase fw-bold d-block mb-1" style="font-size:11px;letter-spacing:1px;color:#7c984c">
                    @(tr ? "DALLANMA MANTIĞI" : "BRANCHING LOGIC")
                </small>
                <div class="fw-bold" style="font-size:1.15rem;color:#23413b">
                    @(tr ? "KOŞUL → EVET / HAYIR → FARKLI JOURNEY YOLLARI" : "CONDITION → YES / NO → DIFFERENT JOURNEY PATHS")
                </div>
            </div>

            <p class="small ph-muted mb-0">
                @(tr ? "Dallanma, müşterinin ne yapacağını tahmin eden AI kararı değildir. Kullanıcının önceden tanımladığı karar mantığının journey içinde uygulanmasıdır." : "Branching is not an AI decision predicting what the customer will do. It is the application of decision logic defined by the user inside the journey.")
            </p>
        </div>
    </div>
</section>

@* ── 07 WAIT & TIMING ────────────────────────────────────────── *@
<section class="pika-sol-section" id="timing">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "BEKLEME VE ZAMANLAMA" : "WAIT & TIMING")</span>
            <h2 class="pika-sol-section-title mb-3">
                @(tr ? "Her doğru adım, hemen atılması gereken adım değildir." : "The right next step does not always belong immediately after the current one.")
            </h2>
        </div>

        <div class="p-4 rounded-4 bg-white border shadow-sm" data-aos="fade-up">
            <p class="mb-3" style="line-height:1.65;color:#23413b">
                @(tr ? "Journey içinde iki adım arasına bekleme mantığı eklenebilir." : "Wait logic can be placed between steps in a journey.")
            </p>
            <p class="mb-3 ph-muted" style="line-height:1.65">
                @(tr ? "Bekleme adımı müşterinin journey'de kalmasını ancak sonraki aksiyonun tanımlanan zamanlama koşuluna kadar ilerlememesini sağlar." : "A wait step keeps the customer within the journey while preventing the next action from progressing until the configured timing condition is reached.")
            </p>
            <p class="mb-4 ph-muted" style="line-height:1.65">
                @(tr ? "Bu sayede çok adımlı iletişimlerin tek bir anda arka arkaya çalışması yerine journey içinde kontrollü bir zaman akışı oluşturulabilir." : "This creates controlled timing across multi-step communication instead of allowing every action to execute one after another at the same moment.")
            </p>

            <div class="p-3 rounded-3 mb-4 text-center" style="background:#f8faf4;border:1px dashed #c9dca9">
                <div class="row g-2 text-start">
                    <div class="col-sm-6 p-2 border-bottom border-sm-0">
                        <strong style="color:#c0392b">@(tr ? "Bekleme:" : "A wait step:")</strong>
                        <p class="small mb-0 mt-1" style="color:#23413b">
                            @(tr ? "“Müşteriye şimdi ne gönderelim?” sorusunu cevaplamaz." : "does not answer: “What should we send the customer now?”")
                        </p>
                    </div>
                    <div class="col-sm-6 p-2">
                        <strong style="color:var(--pika-primary)">@(tr ? "Bekleme:" : "A wait step:")</strong>
                        <p class="small mb-0 mt-1" style="color:#23413b">
                            @(tr ? "“Tanımlanmış sonraki adım ne zaman ilerlemeli?” sorusunu yönetir." : "manages: “When should the configured next step progress?”")
                        </p>
                    </div>
                </div>
            </div>

            <p class="small ph-muted mb-0">
                @(tr ? "Zamanlama journey stratejisinin bir parçasıdır; müşteriye gereksiz sıklıkta iletişim kurulmasının yerine geçecek tek güvenlik kontrolü değildir." : "Timing is part of journey strategy; it is not the only safety control governing communication frequency.")
            </p>
        </div>
    </div>
</section>


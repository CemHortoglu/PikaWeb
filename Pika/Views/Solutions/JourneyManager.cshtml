@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]="Journey Manager | "+(tr?"Müşteri Akışları":"Customer Flows"); ViewData["MetaDescription"]=tr?"Tetikleyici, karar, bekleme ve aksiyon adımlarıyla çok aşamalı müşteri akışları tasarlayın; Campaign'den farklı olarak sürekli ilişki mantığını yönetin.":"Design multi-step customer flows using triggers, decisions, waits and actions, managing ongoing relationship logic distinct from Campaign execution."; ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">Platform · Journey Manager</span><h1>@(tr?"Müşteri ilişkisinin zaman içinde nasıl ilerleyeceğini tasarlayın.":"Design how the customer relationship progresses over time.")</h1><p>@(tr?"Journey Manager, tek seferlik gönderimin ötesinde tetikleyici, karar, bekleme ve aksiyon adımlarını görsel akışta birleştirir. Amaç müşterinin hangi koşulda hangi sonraki adıma geçeceğini yönetilebilir hale getirmektir.":"Journey Manager goes beyond one-off sends by combining triggers, decisions, waits and actions in a visual flow. It makes the customer's next step manageable based on conditions and timing.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/journey-tasarim-tuvali">@(tr?"Journey Rehberi":"Journey Guide")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_journey-tasarim-tuvali_18.png" alt="@(tr?"Pika Journey tasarım tuvali":"Pika Journey design canvas")" width="1200" height="760" /><figcaption>@(tr?"Gerçek ürün görünümü: adım paleti, akış kanvası ve yaşam döngüsü kontrolleri.":"Product view: step palette, flow canvas and lifecycle controls.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-flow"><div class="pk-flow-item"><small>01</small><strong>Trigger</strong><span>@(tr?"Akışı başlatan olay/koşul":"Event or condition starting the flow")</span></div><div class="pk-flow-item"><small>02</small><strong>Decision</strong><span>@(tr?"Kural veya müşteri bağlamı":"Rule or customer context")</span></div><div class="pk-flow-item"><small>03</small><strong>Wait</strong><span>@(tr?"Zamanı yönet":"Control timing")</span></div><div class="pk-flow-item"><small>04</small><strong>Action</strong><span>@(tr?"İletişim veya profil/segment adımı":"Communication or profile/audience step")</span></div><div class="pk-flow-item"><small>05</small><strong>Control</strong><span>@(tr?"Doğrula · yayınla · duraklat":"Validate · publish · pause")</span></div><div class="pk-flow-item"><small>06</small><strong>Measure</strong><span>@(tr?"Akış sonucunu değerlendir":"Review flow outcomes")</span></div></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container pk-screen-band"><div><span class="pk-eyebrow">@(tr?"Karar kuralları":"Decision rules")</span><h2>@(tr?"Akış yalnız görsel bağlantılardan ibaret değildir.":"A Journey is more than visual connections.")</h2><p class="pk-lead">@(tr?"Karar adımları müşterinin hangi koşullarda farklı yollara ayrılacağını belirler. Segment, profil, izin veya desteklenen davranış bağlamı akışın ilgili noktalarında kullanılabilir.":"Decision steps determine when a customer follows different paths. Segment, profile, consent or supported behavior context can be used where relevant in the flow.")</p></div><img src="/wiki/assets/images/img_journey-karar-kurallari_19.png" alt="@(tr?"Pika Journey karar kuralları ekranı":"Pika Journey decision rules screen")" loading="lazy" width="1200" height="760" /></div></section>
<section class="pk-section"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">Journey vs Campaign</span><h2>@(tr?"Bir kez gönder mi, ilişkiyi yönet mi?":"Execute once, or manage progression over time?")</h2></div><div><p class="pk-lead">@(tr?"Tanımlı bir kampanya için Campaign Manager; müşterinin davranışına göre zaman içinde devam eden bir süreç için Journey Manager daha doğru aksiyon katmanıdır. İkisi aynı intelligence ve fırsat ekosisteminden beslenebilir.":"Campaign Manager is suited to defined campaign execution; Journey Manager is suited to ongoing progression over time. Both can use the same intelligence and opportunity ecosystem.")</p><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/campaign-manager":"/en/platform/campaign-manager")">Campaign Manager</a></div></div></section>

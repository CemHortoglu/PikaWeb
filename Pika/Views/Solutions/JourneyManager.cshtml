    <div class="container" data-aos="fade-up">
        <span class="ph-eyebrow text-white opacity-75 mb-2 d-inline-block">@(tr ? "KONTROLLÜ YOLCULUKLAR" : "CONTROLLED JOURNEYS")</span>
        <h2>
            @(tr ? "Koşulu tanımlayın." : "Define the condition.")<br />
            @(tr ? "Sırayı kurun." : "Build the sequence.")<br />
            @(tr ? "Journey'nin kontrollü ilerlemesini sağlayın." : "Let the journey progress under control.")

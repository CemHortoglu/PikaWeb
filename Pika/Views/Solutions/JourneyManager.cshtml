            </button>
            <button type="button" class="btn pika-btn-ghost px-4 py-2" data-bs-toggle="modal" data-bs-target="#demoModal">
                @(tr ? "Teklif Al" : "Request a Quote")
            </button>
        </div>
    </div>
</section>

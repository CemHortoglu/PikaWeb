@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr = culture == "tr";
    ViewData["BodyClass"] = "pika-solutions-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-corporate-page.css" asp-append-version="true" />
}

@* ── 01 HERO ─────────────────────────────────────────────────────── *@
<section class="pika-sol-hero">
    <div class="container" data-aos="fade-up">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="pika-sol-eyebrow">@(tr ? "KURUMSAL" : "CORPORATE")</span>
                <span class="badge bg-light text-dark border px-2 py-1 mb-3 ms-2 fs-6">Pika</span>
                <h1 class="pika-sol-hero-title">
                    @(tr
                        ? "Müşteri zekâsını, açık ürün sınırları ve kontrollü aksiyon yaklaşımıyla değerlendirin."
                        : "Evaluate customer intelligence through clear product boundaries and controlled action.")
                </h1>
                <p class="lead pika-sol-lead mb-4">
                    @(tr
                        ? "Pika; müşteri, ürün ve satış verisini birlikte anlamlandırarak işletmenin bugün hangi müşteride hangi ticari fırsatın oluştuğunu görmesini ve bu fırsatı kontrollü, ölçülebilir çok kanallı aksiyona dönüştürmesini sağlayan müşteri zekâsı ve pazarlama platformudur."
                        : "Pika is a customer intelligence and marketing platform that brings customer, product and sales data together to identify commercial opportunities and turn them into controlled, measurable omnichannel actions.")
                </p>
                <p class="text-muted mb-4">
                    @(tr
                        ? "Kurumsal değerlendirmede yalnızca özellik listesine değil; verinin platforma nasıl girdiğine, kararın nasıl oluştuğuna, aksiyonun hangi kontrollerle yürütüldüğüne ve sonuçların nasıl ölçüldüğüne birlikte bakın."
                        : "For organizational evaluation, look beyond a feature list and consider how data enters the platform, how decisions are created, which controls govern action and how outcomes are measured.")
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <button type="button" class="btn pika-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">
                        @(tr ? "Demo Talep Et" : "Request a Demo")
                    </button>
                    <a href="@(tr ? "/pika" : "/en/pika")" class="btn pika-btn-outline">
                        @(tr ? "Pika'yı Keşfedin" : "Explore Pika")
                    </a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="corp-hero-diagram" aria-hidden="true">
                    <div class="corp-hero-step">
                        <span>@(tr ? "VERİ" : "DATA")</span>
                        <i class="ri-database-2-line" aria-hidden="true"></i>
                    </div>
                    <div class="corp-hero-arrow">↓</div>
                    <div class="corp-hero-step">
                        <span>@(tr ? "MÜŞTERİ & ÜRÜN ZEKÂSI" : "CUSTOMER & PRODUCT INTELLIGENCE")</span>
                        <i class="ri-brain-line" aria-hidden="true"></i>
                    </div>
                    <div class="corp-hero-arrow">↓</div>
                    <div class="corp-hero-step">
                        <span>@(tr ? "KARAR" : "DECISION")</span>
                        <i class="ri-lightbulb-line" aria-hidden="true"></i>
                    </div>
                    <div class="corp-hero-arrow">↓</div>
                    <div class="corp-hero-step">
                        <span>@(tr ? "KONTROL" : "CONTROL")</span>
                        <i class="ri-shield-check-line" aria-hidden="true"></i>
                    </div>
                    <div class="corp-hero-arrow">↓</div>
                    <div class="corp-hero-step">
                        <span>@(tr ? "AKSİYON" : "ACTION")</span>
                        <i class="ri-send-plane-line" aria-hidden="true"></i>
                    </div>
                    <div class="corp-hero-arrow">↓</div>
                    <div class="corp-hero-step">
                        <span>@(tr ? "ÖLÇÜM" : "MEASUREMENT")</span>
                        <i class="ri-line-chart-line" aria-hidden="true"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="inner-content" class="inner-anchor"></div>

@* ── 02 DIRECT ANSWER ─────────────────────────────────────────────── *@
<section class="pika-sol-section">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <span class="pika-sol-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
                <h2 class="pika-sol-section-title text-start mb-4">
                    @(tr ? "Pika'yı kurumsal olarak nasıl değerlendirmelisiniz?" : "How should an organization evaluate Pika?")
                </h2>
                <p class="lead">
                    @(tr
                        ? "Pika, müşteri zekâsı ile pazarlama aksiyonunu aynı karar zincirinde birleştiren B2B SaaS platformudur."
                        : "Pika is a B2B SaaS platform that connects customer intelligence and marketing action within the same decision chain.")
                </p>
                <p>
                    @(tr
                        ? "Platformun rolü yalnızca veri göstermek veya mesaj göndermek değildir."
                        : "The role of the platform is not merely to display data or send messages.")
                </p>
                <p>
                    @(tr
                        ? "Müşteri, ürün ve işlem bağlamı önce intelligence katmanlarında anlamlandırılır; ticari fırsat ve kullanıcı kararı daha sonra audience, campaign veya journey aksiyonlarına bağlanabilir."
                        : "Customer, product and transaction context is understood first in intelligence layers; commercial opportunity and user decision can then connect to audience, campaign or journey action.")
                </p>
                <p>
                    @(tr
                        ? "Kurumsal değerlendirmede temel soru şudur:"
                        : "The central evaluation question is:")
                </p>
                <div class="corp-callout my-4 text-center">
                    <p class="fs-4 fw-bold mb-0 text-dark">
                        @if (tr)
                        {
                            <text>“Veri, karar, kontrol ve aksiyon birbirine nasıl bağlanıyor?”</text>
                        }
                        else
                        {
                            <text>“How do data, decision, control and action connect?”</text>
                        }
                    </p>
                </div>
                <p>
                    @(tr
                        ? "Pika'nın ürün yaklaşımı bu dört alanı tek bir özellik altında eritmek yerine ayrı sorumluluk katmanlarıyla yönetir."
                        : "Pika's product approach keeps those responsibilities in explicit layers rather than collapsing every capability into one feature.")
                </p>
                <div class="p-3 bg-white rounded border border-light-subtle">
                    <p class="mb-0 fw-semibold text-center">
                        @if (tr)
                        {
                            <text>Doğru değerlendirme, yalnızca “hangi özellikler var?” sorusuyla değil, “hangi ürün katmanı hangi karardan sorumlu?” sorusuyla başlar.</text>
                        }
                        else
                        {
                            <text>A useful evaluation does not begin only with: “Which features exist?” It also asks: “Which product layer owns which decision?”</text>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 03 PIKA AS A B2B PLATFORM ────────────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <span class="pika-sol-eyebrow">@(tr ? "PLATFORM KİMLİĞİ" : "PLATFORM IDENTITY")</span>
                <h2 class="pika-sol-section-title text-start mb-4">
                    @(tr ? "Pika'nın merkezi, kanal değil müşteri ve ürün bağlamıdır." : "Pika is centered not on the channel, but on customer and product context.")
                </h2>
                <p class="lead">
                    @(tr
                        ? "Pika'nın başlangıç noktası mesaj göndermek değil, anlamaktır."
                        : "Pika does not begin with sending a message. It begins with understanding.")
                </p>
                <p>
                    @if (tr)
                    {
                        <text><a href="/platform/customer-intelligence">Customer Intelligence</a> müşteri davranışı, değer ve satın alma bağlamını; <a href="/platform/product-intelligence">Product Intelligence</a> ise ürünlerin ticari anlamı ve ilişkilerini görünür hale getiren ayrı platform katmanlarıdır.</text>
                    }
                    else
                    {
                        <text><a href="/en/platform/customer-intelligence">Customer Intelligence</a> establishes customer behavior, value and purchase context, while <a href="/en/platform/product-intelligence">Product Intelligence</a> establishes the commercial meaning and relationships of products.</text>
                    }
                </p>
                <p>
                    @if (tr)
                    {
                        <text>Bu bağlam <a href="/platform/pika-360">Pika 360</a> ve <a href="/platform/gunun-firsatlari">Günün Fırsatları</a> gibi karar görünümlerinde kullanılabilir; ardından kontrollü pazarlama aksiyonuna bağlanabilir.</text>
                    }
                    else
                    {
                        <text>That context can be used in decision views such as <a href="/en/platform/pika-360">Pika 360</a> and <a href="/en/platform/opportunities">Daily Opportunities</a> and can later connect to controlled marketing action.</text>
                    }
                </p>

                <div class="corp-callout my-4">
                    @if (tr)
                    {
                        <p class="mb-1"><strong>ÖNCE:</strong> ANLAMA</p>
                        <p class="mb-1"><strong>SONRA:</strong> FIRSAT / KARAR</p>
                        <p class="mb-0"><strong>ARDINDAN:</strong> KONTROLLÜ AKSİYON</p>
                    }
                    else
                    {
                        <p class="mb-1"><strong>FIRST:</strong> UNDERSTANDING</p>
                        <p class="mb-1"><strong>THEN:</strong> OPPORTUNITY / DECISION</p>
                        <p class="mb-0"><strong>THEN:</strong> CONTROLLED ACTION</p>
                    }
                </div>

                <div class="p-3 bg-white rounded border border-light-subtle mb-4">
                    <p class="mb-0 fw-semibold text-center">
                        @(tr ? "Daha çok mesaj değil, daha doğru ilişki." : "Not more messages. Better customer relationships.")
                    </p>
                </div>

                <div>
                    <a href="@(tr ? "/pika" : "/en/pika")" class="btn pika-btn-outline">
                        @(tr ? "Pika'yı Keşfedin →" : "Explore Pika →")
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 04 WHAT PIKA OPTIMIZES FOR ───────────────────────────────────── *@
<section class="pika-sol-section">
    <div class="container" data-aos="fade-up">
        <span class="pika-sol-eyebrow">@(tr ? "ÜRÜN YAKLAŞIMI" : "PRODUCT APPROACH")</span>
        <h2 class="pika-sol-section-title">
            @(tr ? "Daha fazla otomasyon değil. Daha açık karar bağlamı." : "Not more automation. Clearer decision context.")
        </h2>

        <div class="row justify-content-center mb-4">
            <div class="col-lg-10">
                <p class="lead">
                    @(tr
                        ? "Pika'nın amacı mümkün olan her aksiyonu otomatikleştirmek değildir."
                        : "Pika is not designed to automate every possible action.")
                </p>
                <p>
                    @(tr
                        ? "Platform müşteri ve ürün bağlamını görünür hale getirir, gerçek audience tanımını ayrı yönetir, içerik hazırlığını aksiyon kararından ayırır ve gönderim öncesi kontrolleri execution sürecinin parçası haline getirir."
                        : "The platform makes customer and product context visible, manages actual audience definition separately, separates content preparation from the action decision and makes pre-delivery controls part of execution.")
                </p>
            </div>
        </div>

        <div class="pika-sol-value-grid">
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500">
                <div class="pika-sol-value-icon"><i class="ri-compass-3-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Anlama" : "Understanding")</h4>
                <p>@(tr ? "Müşteri ve ürün bağlamı veriden hesaplanır." : "Customer and product context is calculated from data.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="100">
                <div class="pika-sol-value-icon"><i class="ri-focus-3-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Açık Karar" : "Explicit Decision")</h4>
                <p>@(tr ? "Fırsat, audience, campaign ve journey sorumlulukları birbirinden ayrılır." : "Opportunity, audience, campaign and journey responsibilities remain distinct.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="200">
                <div class="pika-sol-value-icon"><i class="ri-shield-check-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Kontrollü Aksiyon" : "Controlled Action")</h4>
                <p>@(tr ? "İzin ve gönderim kontrolleri iletişim icrasından önce değerlendirilir." : "Permission and delivery controls are evaluated before communication execution.")</p>
            </div>
            <div class="pika-sol-value-card" data-aos="fade-up" data-aos-duration="500" data-aos-delay="300">
                <div class="pika-sol-value-icon"><i class="ri-line-chart-line" aria-hidden="true"></i></div>
                <h4>@(tr ? "Ölçüm" : "Measurement")</h4>
                <p>@(tr ? "Gönderim ve etkileşim sonuçları Analytics & Reporting bağlamına taşınır." : "Delivery and engagement outcomes can feed Analytics & Reporting context.")</p>
            </div>
        </div>

        <div class="row justify-content-center mt-4">
            <div class="col-lg-10">
                <div class="p-3 bg-white rounded border border-light-subtle text-center">
                    <p class="mb-0 fw-semibold">
                        @(tr
                            ? "Pika'nın hedefi aksiyonu bağlamdan koparmak değil, aksiyonu bağlamın sonucu haline getirmektir."
                            : "Pika's objective is not to separate action from context, but to make action the result of context.")
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 05 PLATFORM EVALUATION MAP ──────────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <span class="pika-sol-eyebrow">@(tr ? "UÇTAN UCA DEĞERLENDİRME" : "END-TO-END EVALUATION")</span>
                <h2 class="pika-sol-section-title text-start mb-4">
                    @(tr ? "Pika'yı tek bir özellik üzerinden değil, karar zinciri üzerinden değerlendirin." : "Evaluate Pika through the decision chain, not through one feature.")
                </h2>

                <div class="corp-flow-chain my-4" aria-label="@(tr ? "Uçtan uca değerlendirme akışı" : "End-to-end evaluation flow")">
                    <span>DATA &amp; INGESTION</span>
                    <span class="corp-flow-arrow">→</span>
                    <span>CUSTOMER &amp; PRODUCT INTELLIGENCE</span>
                    <span class="corp-flow-arrow">→</span>
                    <span>OPPORTUNITY / DECISION</span>
                    <span class="corp-flow-arrow">→</span>
                    <span>AUDIENCE / CONTENT</span>
                    <span class="corp-flow-arrow">→</span>
                    <span>CAMPAIGN / JOURNEY</span>
                    <span class="corp-flow-arrow">→</span>
                    <span>CONSENT / SECURITY CONTROLS</span>
                    <span class="corp-flow-arrow">→</span>
                    <span>EMAIL / SMS / WHATSAPP</span>
                    <span class="corp-flow-arrow">→</span>
                    <span>ANALYTICS &amp; REPORTING</span>
                </div>

                <p class="lead">
                    @(tr
                        ? "Bu zincirde her katmanın görevi farklıdır."
                        : "Each layer has a different responsibility.")
                </p>

                <p>
                    @(tr
                        ? "Integrations veriyi platforma taşır. Customer Intelligence ve Product Intelligence anlam üretir. Audience Manager hedef kitleyi tanımlar. Content Studio içeriği hazırlar. Campaign Manager ve Journey Manager aksiyonu yönetir. Consent Management ve Security & Privacy ilgili kontrol sınırlarını sağlar. Email, SMS ve WhatsApp iletişim kanallarıdır. Analytics & Reporting sonuçları ölçüm bağlamında değerlendirir."
                        : "Integrations brings data into the platform. Customer Intelligence and Product Intelligence create meaning. Audience Manager defines the audience. Content Studio prepares content. Campaign Manager and Journey Manager manage action. Consent Management and Security & Privacy provide relevant control boundaries. Email, SMS and WhatsApp are communication channels. Analytics & Reporting evaluates outcomes in measurement context.")
                </p>

                <div class="p-3 bg-white rounded border border-light-subtle text-center mt-4">
                    <p class="mb-0 fw-semibold">
                        @(tr
                            ? "Kurumsal ürün mimarisi, her şeyi tek modüle yüklemek yerine sorumluluğu doğru katmana koyar."
                            : "A clear product architecture puts responsibility in the correct layer instead of assigning everything to one module.")
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 06 DATA & INTEGRATION APPROACH ──────────────────────────────── *@
<section class="pika-sol-section">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <span class="pika-sol-eyebrow">@(tr ? "VERİ TEMELİ" : "DATA FOUNDATION")</span>
                <h2 class="pika-sol-section-title text-start mb-4">
                    @(tr ? "Kurumsal değerlendirmeye, verinin Pika'ya nasıl girdiğinden başlayın." : "Begin organizational evaluation with how data enters Pika.")
                </h2>

                <p class="lead">
                    @(tr
                        ? "Pika'nın doğrulanmış veri giriş yolları müşteri, ürün ve işlem verisinin REST Ingestion API veya Excel/CSV import akışlarıyla platforma taşınmasını kapsar."
                        : "Pika's verified data-intake paths include customer, product and transaction data through the REST Ingestion API or Excel/CSV import flows.")
                </p>

                <p>
                    @(tr
                        ? "Bu veri daha sonra ilgili validation, normalization veya resolution süreçlerinden geçerek intelligence katmanlarının kullanabileceği bağlama dönüşebilir."
                        : "That data can later pass through relevant validation, normalization or resolution processes before becoming context used by intelligence layers.")
                </p>

                <p>
                    @(tr
                        ? "C19 her CRM, ERP veya e-ticaret ürünü için hazır native connector bulunduğu iddiasını yapmaz."
                        : "C19 does not claim that a ready-made native connector exists for every CRM, ERP or e-commerce product.")
                </p>

                <div class="corp-callout my-4">
                    @if (tr)
                    {
                        <p class="mb-1"><strong>Integrations:</strong> “Veri Pika'ya nasıl girer?”</p>
                        <p class="mb-1"><strong>Intelligence:</strong> “Bu veriden hangi ticari bağlam hesaplanır?”</p>
                        <p class="mb-0"><strong>Bunlar:</strong> aynı ürün görevi değildir.</p>
                    }
                    else
                    {
                        <p class="mb-1"><strong>Integrations asks:</strong> “How does data enter Pika?”</p>
                        <p class="mb-1"><strong>Intelligence asks:</strong> “Which commercial context is calculated from that data?”</p>
                        <p class="mb-0"><strong>These are:</strong> different product responsibilities.</p>
                    }
                </div>

                <div class="p-3 bg-white rounded border border-light-subtle mb-4">
                    <p class="mb-0 fw-semibold text-center">
                        @(tr ? "Entegrasyonun kapsamını, gerçek veri akışı üzerinden değerlendirin." : "Evaluate integration scope through the real data path.")
                    </p>
                </div>

                <div>
                    <a href="@(tr ? "/entegrasyonlar" : "/en/integrations")" class="btn pika-btn-outline">
                        @(tr ? "Entegrasyonları Keşfedin →" : "Explore Integrations →")
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 07 SECURITY & ACCESS APPROACH ───────────────────────────────── *@
<section class="pika-sol-section pika-sol-section-alt">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <span class="pika-sol-eyebrow">@(tr ? "ERİŞİM VE GİZLİLİK" : "ACCESS & PRIVACY")</span>
                <h2 class="pika-sol-section-title text-start mb-4">
                    @(tr ? "Güvenlik değerlendirmesini, genel sıfatlar yerine doğrulanmış kontrollerle yapın." : "Evaluate security through verified controls, not generic adjectives.")
                </h2>

                <p class="lead">
                    @(tr
                        ? "Pika'nın doğrulanmış güvenlik bağlamında rol bazlı erişim denetimi (RBAC), ilgili arayüzlerde maskelenmiş iletişim verisi görünümü ve dokümante edilmiş API akışlarında API-key erişim kontrolü bulunur."
                        : "Pika's verified security context includes role-based access control (RBAC), masked communication-data presentation in relevant interfaces and API-key access control in documented API flows.")
                </p>

                <p>
                    @(tr
                        ? "Bu kontroller kullanıcı erişimi ve veri görünürlüğünü yönetmeye yardımcı olur."
                        : "Those controls help manage user access and data exposure.")
                </p>

                <p>
                    @(tr
                        ? "C19 doğrulanmamış SOC 2, ISO 27001, SAML / SSO, belirli encryption standardı veya fiziksel tenant-isolation iddiası yapmaz."
                        : "C19 makes no unverified claim for SOC 2, ISO 27001, SAML / SSO, a specific encryption standard or physical tenant isolation.")
                </p>

                <div class="corp-callout my-4">
                    @if (tr)
                    {
                        <p class="mb-1"><strong>Doğrulanmış mekanizma:</strong> değerlendirilebilir.</p>
                        <p class="mb-0"><strong>Doğrulanmamış sertifika:</strong> ürün yeteneği gibi sunulmaz.</p>
                    }
                    else
                    {
                        <p class="mb-1"><strong>A verified mechanism:</strong> can be evaluated.</p>
                        <p class="mb-0"><strong>An unverified certification:</strong> is not presented as product capability.</p>
                    }
                </div>

                <div class="p-3 bg-white rounded border border-light-subtle mb-4">
                    <p class="mb-0 fw-semibold text-center">
                        @(tr ? "Güveni, kanıtlanabilir kontrol üzerinden değerlendirin." : "Evaluate trust through controls that can be verified.")
                    </p>
                </div>

                <div>
                    <a href="@(tr ? "/guvenlik-ve-gizlilik" : "/en/security-and-privacy")" class="btn pika-btn-outline">
                        @(tr ? "Security & Privacy'yi Keşfedin →" : "Explore Security & Privacy →")
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 08 CONSENT & COMMUNICATION GOVERNANCE ───────────────────────── *@
<section class="pika-sol-section">
    <div class="container" data-aos="fade-up">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <span class="pika-sol-eyebrow">@(tr ? "İZİNLİ İLETİŞİM" : "PERMISSIONED COMMUNICATION")</span>
                <h2 class="pika-sol-section-title text-start mb-4">
                    @(tr ? "Hedef kitle, iletişim izninin yerine geçmez." : "Audience membership does not replace communication permission.")
                </h2>

                <p class="lead">
                    @(tr
                        ? "Pika'da audience veya ticari fırsat bağlamı, müşteriye iletişim uygulanabilmesi için tek başına yeterli kabul edilmez."
                        : "In Pika, audience membership or commercial opportunity context is not treated as sufficient by itself for customer communication.")
                </p>

                <p>
                    @(tr

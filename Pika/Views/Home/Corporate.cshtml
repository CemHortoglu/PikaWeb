                            <i class="ri-arrow-down-s-line" aria-hidden="true"></i>
                        </summary>
                        <div class="corp-faq-body">
                            @(tr
                                ? "Pika sabit public paket fiyatı yayınlamaz. İhtiyacınıza ve kullanım kapsamınıza göre özel teklif hazırlanır."
                                : "Pika does not publish a fixed public package price. Pricing is tailored to your requirements and scope of use.")
                        </div>
                    </details>

                    <details class="corp-faq-details">
                        <summary class="corp-faq-summary">
                            <span>@(tr ? "Pika'yı değerlendirmek için nasıl demo veya teklif alabilirim?" : "How can I request a demo or quote for Pika?")</span>
                            <i class="ri-arrow-down-s-line" aria-hidden="true"></i>
                        </summary>
                        <div class="corp-faq-body">
                            @if (tr)
                            {
                                <text><a href="/demo-talebi">Demo Talebi</a> üzerinden kullanım senaryonuzu paylaşabilir veya <a href="/iletisim">İletişim</a> sayfasından Pika ekibine ulaşabilirsiniz. Ürün ve kullanım kapsamı birlikte değerlendirildikten sonra ihtiyaca göre teklif hazırlanabilir.</text>
                            }
                            else
                            {
                                <text>You can share your usage scenario through <a href="/en/demo-request">Demo Request</a> or contact the Pika team through the <a href="/en/contact">Contact</a> page. Product and usage scope can be evaluated together before a tailored quote is prepared.</text>
                            }
                        </div>
                    </details>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── 14 FINAL CTA ─────────────────────────────────────────────────── *@

@{
    var culture = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var isTr = culture != "en";
    string L(string tr, string en) => isTr ? tr : en;
    ViewData["Title"] = L("Kullanım Şartları", "Terms of Service");
    ViewData["MetaDescription"] = L(
        "ARCA hizmetlerinin kullanımına ilişkin yasal şartlar, hesap sorumluluğu, fikri mülkiyet, sorumluluk sınırlaması ve uygulanacak hukuk.",
        "Legal terms for using ARCA services: account responsibility, intellectual property, limitation of liability, and governing law.");
}

<section class="faq-pro-hero">
    <div class="container">
        <div class="faq-pro-hero-grid">
            <div>
                <span class="faq-chip">@L("Kurumsal", "Corporate")</span>
                <h1 class="faq-pro-title">@L("Kullanım Şartları", "Terms of Service")</h1>
                <p class="faq-pro-lead text-white-50 small mb-0"><span>@L("Yürürlük Tarihi:", "Effective Date:")</span> <span>@L("20 Ağustos 2020", "August 20, 2020")</span></p>
            </div>
        </div>
    </div>
</section>

<section class="pika-section pt-5">
    <div class="container">
        <div class="pika-card p-4 p-md-5">
            <article class="legal-content">

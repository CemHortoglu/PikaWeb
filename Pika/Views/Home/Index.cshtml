@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var isTr = culture == "tr";
    var tr = isTr;

    ViewData["Title"] = isTr 
        ? "Omnichannel Pazarlama Otomasyonu ve Müşteri Yolculuğu Platformu" 
        : "Omnichannel Marketing Automation & Customer Journey Platform";
    ViewData["MetaDescription"] = isTr 
        ? "Pika ile SMS, WhatsApp, Email ve Push kanallarında kişiselleştirilmiş kampanya yönetimi, segmentasyon ve journey otomasyonunu tek platformda yönetin. Hızlı kurulum, güvenli altyapı ve ölçülebilir sonuçlar." 
        : "Manage personalized campaigns, segmentation, and journey automation across SMS, WhatsApp, Email, and Push on a single platform with Pika. Fast deployment, secure architecture, and measurable growth.";
    ViewData["MetaKeywords"] = isTr
        ? "pazarlama otomasyonu, omnichannel pazarlama, müşteri yolculuğu, segmentasyon, kişiselleştirme, kampanya yönetimi, WhatsApp pazarlama, SMS pazarlama, email marketing, push bildirim"
        : "marketing automation, omnichannel marketing, customer journey, segmentation, personalization, campaign management, WhatsApp marketing, SMS marketing, email marketing, push notification";
    ViewData["BodyClass"] = "pika-home-modern";
}

@section JsonLd {
<script type="@Html.Raw("application/ld+json")">
{
  "@@context": "https://schema.org",
  "@@graph": [
    {
      "@@type": "WebSite",
      "@@id": "https://pika.tr/#website",
      "url": "https://pika.tr/",
      "name": "Pika",
      "description": "@(isTr ? "Omnichannel Pazarlama Otomasyonu ve Müşteri Yolculuğu Platformu" : "Omnichannel Marketing Automation & Customer Journey Platform")",
      "inLanguage": ["tr-TR", "en-US"]
    },
    {
      "@@type": "SoftwareApplication",
      "@@id": "https://pika.tr/#software",
      "name": "Pika Omnichannel Pazarlama Platformu",
      "alternateName": ["Pika Marketing Automation", "Pika Müşteri Yolculuğu Platformu"],
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "url": "https://pika.tr",
      "description": "@(isTr ? "SMS, WhatsApp, Email ve Push kanallarında kampanya yönetimi, segmentasyon, müşteri yolculuğu otomasyonu, izin yönetimi ve raporlamayı tek platformda birleştiren yapay zekâ destekli omnichannel pazarlama otomasyonu çözümü." : "AI-powered omnichannel marketing automation platform uniting campaign management, segmentation, journey flows, consent management, and analytics across SMS, WhatsApp, Email, and Push.")",
      "featureList": [
        "@(isTr ? "Omnichannel kampanya yönetimi" : "Omnichannel campaign management")",
        "@(isTr ? "Müşteri yolculuğu otomasyonu" : "Customer journey automation")",
        "@(isTr ? "Transaction bazlı segmentasyon" : "Transaction-based segmentation")",
        "@(isTr ? "AI destekli kampanya üretimi" : "AI-powered campaign generation")",
        "WhatsApp, SMS, Email, Push",
        "@(isTr ? "IYS uyumlu izin yönetimi" : "Consent & compliance management")",
        "@(isTr ? "Gerçek zamanlı tetikleyiciler" : "Real-time behavioral triggers")",
        "@(isTr ? "KVKK uyumlu veri yönetimi" : "Privacy & data protection compliance")"
      ],
      "offers": {
        "@@type": "Offer",
        "url": "@(isTr ? "https://pika.tr/demo-talebi" : "https://pika.tr/en/demo-request")"
      },
      "provider": {
        "@@id": "https://pika.tr/#organization"
      }
    },
    {
      "@@type": "FAQPage",
      "@@id": "https://pika.tr/#faq",
      "mainEntity": [
        {
          "@@type": "Question",
          "name": "@(isTr ? "Omnichannel pazarlama otomasyonu nedir?" : "What is omnichannel marketing automation?")",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "@(isTr ? "Omnichannel pazarlama otomasyonu, SMS, WhatsApp, Email ve Push gibi birden fazla iletişim kanalını tek bir platform üzerinden yöneterek müşterilere doğru anda, doğru mesajı otomatik olarak iletmeyi sağlayan teknoloji çözümüdür. Pika bu süreci; segmentasyon, journey otomasyonu, kişiselleştirme ve raporlama ile tek merkezde sunar." : "Omnichannel marketing automation is a unified solution that orchestrates customer communications across SMS, WhatsApp, Email, and Push to deliver the right message at the right moment. Pika brings segmentation, journey workflows, personalization, and analytics together under one roof.")"
          }
        },
        {
          "@@type": "Question",
          "name": "@(isTr ? "Müşteri yolculuğu platformu (Customer Journey Platform) ne işe yarar?" : "What is a Customer Journey Platform?")",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "@(isTr ? "Müşteri yolculuğu platformu, bir müşterinin farkındalık aşamasından satın alma ve sadakat aşamasına kadar geçirdiği her temas noktasında otomatik ve kişiselleştirilmiş iletişim kurulmasını sağlar. Sepet hatırlatma, doğum günü kampanyası, yeniden kazanım akışı gibi olay bazlı süreçler bu platform üzerinden yönetilir." : "A customer journey platform orchestrates automated, personalized touchpoints throughout the entire customer lifecycle—from awareness to purchase and retention. Event-driven flows like abandoned cart recovery, birthday offers, and win-back sequences run automatically.")"
          }
        },
        {
          "@@type": "Question",
          "name": "@(isTr ? "Pika hangi iletişim kanallarını destekliyor?" : "Which communication channels does Pika support?")",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "@(isTr ? "Pika; WhatsApp Business API, SMS, Email ve Push Notification kanallarını tek platformda desteklemektedir. Tüm kanallardaki kampanyalar aynı arayüzden oluşturulabilir, zamanlanabilir ve analiz edilebilir." : "Pika natively supports WhatsApp Business API, SMS, Email, and Push Notifications on a single platform. Campaigns across all channels can be created, scheduled, and analyzed in one dashboard.")"
          }
        },
        {
          "@@type": "Question",
          "name": "@(isTr ? "IYS uyumlu pazarlama platformu nedir?" : "How does Pika handle consent and compliance?")",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "@(isTr ? "IYS (İleti Yönetim Sistemi) uyumlu pazarlama platformu, Türkiye'deki ticari elektronik ileti mevzuatına göre müşteri izinlerini merkezi olarak yöneten, onaysız iletişimi engelleyen ve KVKK gerekliliklerini karşılayan bir yapıya sahip platformdur. Pika bu gereksinimleri Consent Management modülüyle karşılar." : "Pika's Consent Management module manages opt-ins, communication preferences, and regulatory compliance (KVKK / IYS / GDPR), preventing unauthorized messaging and securing customer trust.")"
          }
        },
        {
          "@@type": "Question",
          "name": "@(isTr ? "Transaction bazlı segmentasyon nasıl çalışır?" : "How does transaction-based segmentation work?")",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "@(isTr ? "Transaction bazlı segmentasyon; müşterilerin gerçek satın alma verilerini (hangi mağazadan, hangi ürünü, kaç kez aldığı gibi) kullanarak dinamik hedef kitle grupları oluşturmayı sağlar. Pika'nın Audience Manager modülü ile bu segmentler kaydedilebilir ve farklı kampanyalarda yeniden kullanılabilir." : "Transaction-based segmentation uses granular purchase history—such as store location, product categories, and purchase frequency—to build dynamic audiences. Pika's Audience Manager allows you to save and reuse these segments across multiple campaigns.")"
          }
        },
        {
          "@@type": "Question",
          "name": "@(isTr ? "Pika ile yapay zekâ destekli kampanya nasıl oluşturulur?" : "How does AI-assisted campaign creation work in Pika?")",
          "acceptedAnswer": {
            "@@type": "Answer",
            "text": "@(isTr ? "Pika AI Kampanya Asistanı sayesinde, bir kampanya fikri doğal dil ile yazıldığında sistem otomatik olarak kampanya taslağı, hedef kitle önerisi, email metni ve template oluşturur. Bu özellik kampanya hazırlık süresini önemli ölçüde kısaltır." : "With Pika's AI Campaign Assistant, entering a campaign concept in natural language instantly drafts copy, selects recommended audience segments, and generates ready-to-send email templates, dramatically reducing time to market.")"
          }
        }
      ]
    }
  ]
}
</script>
}

@* ══════════════════════════════════════════════════════════════════════════
   1. HERO — "Doğru Anda" Anchor
   ══════════════════════════════════════════════════════════════════════ *@
<section class="ph-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6" data-aos="fade-right" data-aos-duration="700">
                <span class="ph-eyebrow" data-i18n="home.heroEyebrow">@(isTr ? "Doğru Anda · Akıllı Pazarlama Platformu" : "At The Right Moment · Intelligent Marketing Platform")</span>
                <h1 class="ph-hero-title" data-i18n="home.heroTitle">@(isTr ? "Müşteriyi Doğru Anda Anla, Doğru Aksiyonu Al" : "Understand Customers at the Right Moment, Take the Right Action")</h1>
                <p class="ph-hero-desc" data-i18n="home.heroDesc">@(isTr ? "Pika; müşteri ve ürün verisinden anlam çıkarır, ticari fırsatları tespit eder ve SMS, WhatsApp, Email, Push kanallarında doğru aksiyonu doğru anda almanızı sağlar. Veriden karara, karardan çok kanallı iletişime tek platform." : "Pika extracts context from customer and product data, detects revenue opportunities, and enables you to execute the right action across SMS, WhatsApp, Email, and Push. One platform from data to decision, from decision to omnichannel dispatches.")</p>
                <div class="ph-hero-actions">
                    <button type="button" class="ph-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal"><span data-i18n="nav.demo">@(isTr ? "Demo Talep Et" : "Request a Demo")</span> <i class="ri-arrow-right-up-line"></i></button>
                    <a href="#ph-intelligence" class="ph-btn-outline" data-i18n="home.heroCta2">@(isTr ? "Platformu İncele" : "Explore Platform")</a>
                </div>
                <div class="ph-hero-tags">
                    <span class="ph-tag"><i class="ri-brain-line"></i> Customer &amp; Product Intelligence</span>
                    <span class="ph-tag"><i class="ri-focus-3-line"></i> @(isTr ? "Günün Fırsatları" : "Daily Opportunities")</span>
                    <span class="ph-tag"><i class="ri-pie-chart-line"></i> @(isTr ? "Transaction Segmentasyon" : "Transaction Segmentation")</span>
                    <span class="ph-tag"><i class="ri-route-line"></i> @(isTr ? "Journey Otomasyonu" : "Journey Automation")</span>
                    <span class="ph-tag"><i class="ri-message-2-line"></i> WhatsApp, SMS, Email, Push</span>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left" data-aos-duration="700">
                <div class="ph-mock">
                    <div class="ph-mock-header">
                        <span class="ph-mock-dot"></span>
                        <span class="ph-mock-dot"></span>
                        <span class="ph-mock-dot"></span>
                    </div>
                    <div class="ph-mock-body">
                        <div class="ph-mock-sidebar d-none d-md-block">
                            <div class="ph-mock-nav-item active"><i class="ri-dashboard-line"></i> Dashboard</div>
                            <div class="ph-mock-nav-item"><i class="ri-focus-3-line"></i> @(isTr ? "Fırsatlar" : "Opportunities")</div>
                            <div class="ph-mock-nav-item"><i class="ri-brain-line"></i> @(isTr ? "Müşteri Zekâsı" : "Customer Intel")</div>
                            <div class="ph-mock-nav-item"><i class="ri-megaphone-line"></i> Campaigns</div>
                            <div class="ph-mock-nav-item"><i class="ri-group-line"></i> Audiences</div>
                            <div class="ph-mock-nav-item"><i class="ri-route-line"></i> Journeys</div>
                            <div class="ph-mock-nav-item"><i class="ri-bar-chart-box-line"></i> Analytics</div>
                        </div>
                        <div class="ph-mock-main">
                            <div class="row g-2 mb-3">
                                <div class="col-4">
                                    <div class="ph-mock-stat">
                                        <div class="ph-mock-stat-val">12.4K</div>
                                        <div class="ph-mock-stat-lbl" data-i18n="home.mock.send">@(isTr ? "Gönderim" : "Dispatched")</div>
                                        <div class="ph-mock-bar"><div class="ph-mock-bar-fill" style="width:82%"></div></div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="ph-mock-stat">
                                        <div class="ph-mock-stat-val">%68</div>
                                        <div class="ph-mock-stat-lbl" data-i18n="home.mock.open">@(isTr ? "Açılma" : "Open Rate")</div>
                                        <div class="ph-mock-bar"><div class="ph-mock-bar-fill" style="width:68%"></div></div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="ph-mock-stat">
                                        <div class="ph-mock-stat-val">%24</div>
                                        <div class="ph-mock-stat-lbl" data-i18n="home.mock.conversion">@(isTr ? "Dönüşüm" : "Conversion")</div>
                                        <div class="ph-mock-bar"><div class="ph-mock-bar-fill" style="width:24%"></div></div>
                                    </div>
                                </div>
                            </div>
                            <div class="ph-mock-stat p-2" style="min-height:100px">
                                <div class="d-flex justify-content-between mb-2" style="font-size:.75rem;color:var(--pika-muted)">
                                    <span data-i18n="home.mock.campPerf">@(isTr ? "Kampanya Performansı" : "Campaign Performance")</span><span data-i18n="home.mock.last7">@(isTr ? "Son 7 gün" : "Last 7 days")</span>
                                </div>
                                <div class="d-flex align-items-end gap-1" style="height:60px">
                                    <div style="flex:1;background:#eaf4dd;border-radius:3px;height:40%"></div>
                                    <div style="flex:1;background:#eaf4dd;border-radius:3px;height:55%"></div>
                                    <div style="flex:1;background:#eaf4dd;border-radius:3px;height:45%"></div>
                                    <div style="flex:1;background:#84c225;border-radius:3px;height:80%"></div>
                                    <div style="flex:1;background:#eaf4dd;border-radius:3px;height:65%"></div>
                                    <div style="flex:1;background:#eaf4dd;border-radius:3px;height:72%"></div>
                                    <div style="flex:1;background:#9edd05;border-radius:3px;height:90%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="ph-mock-overlay ph-mock-overlay-1 d-none d-lg-block">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="ri-focus-3-line" style="color:var(--pika-primary2)"></i>
                            <span style="font-size:.8rem;font-weight:600">@(isTr ? "Günün Fırsatları" : "Daily Opportunities")</span>
                        </div>
                        <span style="font-size:.72rem;color:var(--pika-muted)">@(isTr ? "Tekrar satın alma & cross-sell hazır" : "Repeat purchase & cross-sell ready")</span>
                    </div>
                    <div class="ph-mock-overlay ph-mock-overlay-2 d-none d-lg-block">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <i class="ri-robot-line" style="color:var(--pika-primary2)"></i>
                            <span style="font-size:.8rem;font-weight:600" data-i18n="nav.aiAssistant">@(isTr ? "AI Kampanya Asistanı" : "AI Campaign Assistant")</span>
                        </div>
                        <span style="font-size:.72rem;color:var(--pika-muted)" data-i18n="home.mock.aiCampaignCreated">@(isTr ? "Kampanya oluşturuldu ✓" : "Campaign generated ✓")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ══════════════════════════════════════════════════════════════════════════
   2. GÜNÜN FIRSATLARI TEASER — "Pika bugün ne buldu?"
   ══════════════════════════════════════════════════════════════════════ *@
<section class="ph-section" style="background:linear-gradient(135deg,#f8fdf0 0%,#eef7e0 100%)">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6" data-aos="fade-right" data-aos-duration="700">
                <div class="d-inline-block mb-3">
                    <span class="badge rounded-pill" style="background:#c8f542;color:#12362c;font-weight:600;font-size:.8rem;padding:6px 14px"><i class="ri-focus-3-line me-1"></i> @(isTr ? "Fırsat & Karar Motoru" : "Opportunity & Decision Engine")</span>
                </div>
                <h2 class="pika-h2 fw-bold mb-3">@(isTr ? "Pika bugün hangi fırsatları buldu?" : "What opportunities did Pika discover today?")</h2>
                <p class="ph-muted mb-4">@(isTr ? "Geniş kitlelere rastgele kampanya göndermek yerine, müşteri ve ürün verisinden çıkan günlük öncelikli fırsatları keşfedin. Tekrar satın alma, cross-sell, upsell ve geri kazanım sinyalleri aksiyona hazır." : "Instead of blasting random campaigns to broad audiences, unlock daily prioritized opportunities derived from customer and product behavior. Repeat purchase, cross-sell, upsell, and retention signals primed for action.")</p>
                <div class="d-flex gap-3 flex-wrap">
                    <a href="@(isTr ? "/platform/firsatlar" : "/en/platform/opportunities")" class="ph-btn-primary">@(isTr ? "Günün Fırsatlarını İncele" : "Explore Daily Opportunities") <i class="ri-arrow-right-line"></i></a>
                    <a href="@(isTr ? "/urunler/ai-kampanya-asistani" : "/en/products/ai-campaign-assistant")" class="ph-btn-outline"><i class="ri-magic-line me-1"></i> <span data-i18n="nav.aiAssistant">@(isTr ? "AI Kampanya Asistanı" : "AI Campaign Assistant")</span></a>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left" data-aos-duration="700">
                <div class="ph-module-card p-4" style="border:1px solid #d4e8b0">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-bold" style="font-size:.85rem;color:var(--pika-primary)"><i class="ri-sun-line me-1" style="color:#f59e0b"></i> @(isTr ? "Günlük Fırsat Akışı" : "Daily Opportunity Feed")</span>
                        <span class="badge bg-light text-muted" style="font-size:.7rem">@(isTr ? "Öncelik Sıralı" : "Ranked by Priority")</span>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-items-center gap-3 p-2 rounded" style="background:#fff8e1">
                            <span class="badge" style="background:#f59e0b;color:#fff;font-size:.65rem">@(isTr ? "Tekrar Alım" : "Repurchase")</span>
                            <div class="flex-grow-1" style="font-size:.8rem">@(isTr ? "İhtiyaç döngüsü yaklaşan müşteriler" : "Customers approaching predicted repurchase window")</div>
                            <i class="ri-arrow-right-s-line text-muted"></i>
                        </div>
                        <div class="d-flex align-items-center gap-3 p-2 rounded" style="background:#f0fdf4">
                            <span class="badge" style="background:#22c55e;color:#fff;font-size:.65rem">Cross-sell</span>
                            <div class="flex-grow-1" style="font-size:.8rem">@(isTr ? "Tamamlayıcı ürün ihtiyacı oluşan kitle" : "Audience ready for complementary item recommendations")</div>
                            <i class="ri-arrow-right-s-line text-muted"></i>
                        </div>
                        <div class="d-flex align-items-center gap-3 p-2 rounded" style="background:#fef2f2">
                            <span class="badge" style="background:#ef4444;color:#fff;font-size:.65rem">@(isTr ? "Geri Kazanım" : "Win-back")</span>
                            <div class="flex-grow-1" style="font-size:.8rem">@(isTr ? "Pasifleşme riski taşıyan değerli müşteriler" : "High-value customers with early churn indicators")</div>
                            <i class="ri-arrow-right-s-line text-muted"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ══════════════════════════════════════════════════════════════════════════
   D. GÜVEN / KISA METRİK ALANI
   ══════════════════════════════════════════════════════════════════════ *@
<section class="ph-section-sm ph-section-alt">
    <div class="container">
        <div class="row g-4" data-aos="fade-up" data-aos-duration="600">
            <div class="col-lg-3 col-md-6">
                <div class="ph-trust-card">
                    <div class="ph-trust-icon"><i class="ri-send-plane-line"></i></div>
                    <h6 class="fw-bold mb-1" data-i18n="home.trust1Title">@(isTr ? "Çok kanallı kampanya yönetimi" : "Omnichannel campaign management")</h6>
                    <p class="mb-0 small ph-muted" data-i18n="home.trust1Desc">@(isTr ? "SMS, WhatsApp, Email ve Push tek merkezde" : "SMS, WhatsApp, Email, and Push in one place")</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="ph-trust-card">
                    <div class="ph-trust-icon"><i class="ri-timer-flash-line"></i></div>
                    <h6 class="fw-bold mb-1" data-i18n="home.trust2Title">@(isTr ? "Gerçek zamanlı tetikleyiciler" : "Real-time triggers")</h6>
                    <p class="mb-0 small ph-muted" data-i18n="home.trust2Desc">@(isTr ? "Davranış ve işlem bazlı otomasyon akışları" : "Behavioral and transactional automation flows")</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="ph-trust-card">
                    <div class="ph-trust-icon"><i class="ri-shield-check-line"></i></div>
                    <h6 class="fw-bold mb-1" data-i18n="home.trust3Title">@(isTr ? "İzin ve uyumluluk yönetimi" : "Consent & compliance management")</h6>
                    <p class="mb-0 small ph-muted" data-i18n="home.trust3Desc">@(isTr ? "IYS ve iletişim tercihleri kontrol altında" : "Compliance, opt-ins, and communication preferences")</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="ph-trust-card">
                    <div class="ph-trust-icon"><i class="ri-robot-line"></i></div>
                    <h6 class="fw-bold mb-1" data-i18n="home.trust4Title">@(isTr ? "AI destekli operasyon" : "AI-powered operations")</h6>
                    <p class="mb-0 small ph-muted" data-i18n="home.trust4Desc">@(isTr ? "Kampanya üretim süresini kısaltan akıllı yardımcı katman" : "Smart assistant layer speeding up campaign rollout")</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ══════════════════════════════════════════════════════════════════════════
   E. "NE ÇÖZÜYORUZ?" ALANI
   ══════════════════════════════════════════════════════════════════════ *@
<section class="ph-section">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow" data-i18n="home.problemEyebrow">@(isTr ? "Problem & Çözüm" : "Problem & Solution")</span>
            <h2 class="pika-h2 fw-bold" data-i18n="home.problemTitle">@(isTr ? "Dağınık kampanya süreçlerini tek merkezde toplayın" : "Unify fragmented campaign operations in one hub")</h2>

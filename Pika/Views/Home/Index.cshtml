@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr = culture == "tr";
    ViewData["Title"] = tr ? "Pika | Müşteri ve Ürün Zekâsından Doğru Aksiyona" : "Pika | From Customer & Product Intelligence to Action";
    ViewData["MetaDescription"] = tr
        ? "Pika; müşteri, ürün ve işlem verisini anlamlandırır, Günün Fırsatları'nı görünür kılar ve yöneticinin seçtiği aksiyonu Campaign, Journey ve iletişim kanallarıyla uygulamasına yardımcı olur."
        : "Pika turns customer, product and transaction data into intelligence, surfaces Daily Opportunities and helps teams execute controlled actions through Campaign, Journey and communication channels.";
    ViewData["BodyClass"] = "pk-page";
}
@section JsonLd {
<script type="@Html.Raw("application/ld+json")">
{"@@context":"https://schema.org","@@graph":[
 {"@@type":"WebSite","@@id":"https://pika.tr/#website","url":"https://pika.tr/","name":"Pika","inLanguage":["tr-TR","en-US"]},
 {"@@type":"SoftwareApplication","@@id":"https://pika.tr/#software","name":"Pika","applicationCategory":"BusinessApplication","operatingSystem":"Web","url":"https://pika.tr/","description":"@(tr ? "Müşteri ve ürün verisini anlamlandıran, fırsatları görünür kılan ve kontrollü pazarlama aksiyonlarına bağlayan B2B SaaS platformu." : "A B2B SaaS platform that turns customer and product context into opportunities and controlled marketing actions.")","provider":{"@@id":"https://pika.tr/#organization"}}
]}
</script>
}

<section class="pk-hero">
    <div class="pk-container pk-hero-grid">
        <div>
            <span class="pk-eyebrow">Doğru Anda</span>
            <h1>@(tr ? "Müşterinizi anlayın. Fırsatı görün. Doğru anda aksiyon alın." : "Understand customers. See the opportunity. Act at the right moment.")</h1>
            <p>@(tr ? "Pika, müşteri, ürün ve işlem verisini yalnız raporlamak için değil; bugün nerede anlamlı bir fırsat oluştuğunu görmek ve bu fırsatı kontrollü bir aksiyona dönüştürmek için bir araya getirir." : "Pika brings customer, product and transaction data together not just to report what happened, but to show where a meaningful opportunity exists today and turn it into controlled action.")</p>
            <div class="pk-actions">
                <button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo")</button>
                <a class="pk-btn pk-btn-ghost" href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika'yı Tanıyın" : "What is Pika?")</a>
            </div>
        </div>
        <figure class="pk-proof" data-aos="fade-left">
            <img src="/wiki/assets/images/img_gunun-firsatlari.png" alt="@(tr ? "Pika Günün Fırsatları ürün ekranı" : "Pika Daily Opportunities product screen")" width="1200" height="760" fetchpriority="high" />
            <figcaption>@(tr ? "Günün Fırsatları: hesaplanan müşteri ve ürün bağlamından aksiyona dönüştürülebilir durumları tek çalışma alanında değerlendirin." : "Daily Opportunities: review actionable situations derived from customer and product context in one workspace.")</figcaption>
        </figure>
    </div>
</section>

<section class="pk-section pk-section-lg" id="firsatlar">
    <div class="pk-container pk-opportunity">
        <div>
            <span class="pk-eyebrow">@(tr ? "Günün Fırsatları" : "Daily Opportunities")</span>
            <h2>@(tr ? "Bugün neye bakmanız gerektiğini görün." : "See what deserves attention today.")</h2>
            <p class="pk-lead">@(tr ? "Her müşteri için aynı mesajı üretmek yerine Pika; gerçekleşmiş davranış, alışveriş ritmi, ürün bağlamı ve uygunluk sinyallerini birlikte değerlendirerek aksiyona aday durumları görünür kılar." : "Instead of treating every customer the same, Pika combines observed behavior, purchase rhythm, product context and eligibility signals to surface situations that may justify action.")</p>
            <div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr ? "/platform/gunun-firsatlari" : "/en/platform/opportunities")">@(tr ? "Günün Fırsatları'nı İnceleyin" : "Explore Daily Opportunities")</a></div>
        </div>
        <div class="pk-opportunity-list" aria-label="@(tr ? "Örnek fırsat türleri" : "Example opportunity types")">
            <div class="pk-opportunity-row"><div class="pk-opportunity-icon"><i class="ri-refresh-line"></i></div><div><strong>@(tr ? "Tekrar satın alma" : "Repeat purchase")</strong><span>@(tr ? "Müşterinin kendi alışveriş ritmine göre yaklaşan ihtiyaç penceresi" : "An approaching need window based on the customer's own purchase rhythm")</span></div><span class="pk-status">@(tr ? "İncele" : "Review")</span></div>
            <div class="pk-opportunity-row"><div class="pk-opportunity-icon"><i class="ri-links-line"></i></div><div><strong>Cross-sell</strong><span>@(tr ? "Sepet birlikteliği ve ürün bağlamıyla desteklenen tamamlayıcı ilişki" : "A complementary relationship supported by basket evidence and product context")</span></div><span class="pk-status">@(tr ? "İncele" : "Review")</span></div>
            <div class="pk-opportunity-row"><div class="pk-opportunity-icon"><i class="ri-user-unfollow-line"></i></div><div><strong>@(tr ? "Geri kazanım" : "Win-back")</strong><span>@(tr ? "Beklenen davranış ritminden uzaklaşan müşteri sinyali" : "A signal that customer behavior is drifting from its expected rhythm")</span></div><span class="pk-status">@(tr ? "İncele" : "Review")</span></div>
        </div>
    </div>
</section>

<section class="pk-section pk-section-soft">
    <div class="pk-container">
        <div class="pk-chapter">
            <div><span class="pk-eyebrow">@(tr ? "Pika nasıl çalışır?" : "How Pika works")</span><h2>@(tr ? "Veriden sonuca tek karar zinciri." : "One decision chain from data to outcome.")</h2></div>
            <p class="pk-lead">@(tr ? "Pika'nın farkı tek bir modülde değil, birbirini besleyen katmanların birlikte çalışmasındadır. İletişim kanalı başlangıç noktası değil, karar zincirinin aksiyon aşamasıdır." : "Pika's value is not a single module but the way its layers work together. Communication channels are the action layer, not the starting point.")</p>
        </div>
        <div class="pk-flow" role="list">
            <div class="pk-flow-item" role="listitem"><small>01</small><strong>@(tr ? "Veri" : "Data")</strong><span>@(tr ? "Müşteri, ürün, satış ve etkileşim bağlamı" : "Customer, product, sales and engagement context")</span></div>
            <div class="pk-flow-item" role="listitem"><small>02</small><strong>@(tr ? "Zekâ" : "Intelligence")</strong><span>Customer Intelligence · Product Intelligence · Pika 360</span></div>
            <div class="pk-flow-item" role="listitem"><small>03</small><strong>@(tr ? "Fırsat" : "Opportunity")</strong><span>@(tr ? "Günün Fırsatları ve karar sinyalleri" : "Daily Opportunities and decision signals")</span></div>
            <div class="pk-flow-item" role="listitem"><small>04</small><strong>@(tr ? "Karar" : "Decision")</strong><span>@(tr ? "Kullanıcı kanıtı görür ve aksiyonu seçer" : "The user reviews evidence and chooses action")</span></div>
            <div class="pk-flow-item" role="listitem"><small>05</small><strong>@(tr ? "Aksiyon" : "Action")</strong><span>Audience · Campaign · Journey · Channels</span></div>
            <div class="pk-flow-item" role="listitem"><small>06</small><strong>@(tr ? "Ölçüm" : "Measure")</strong><span>@(tr ? "Desteklenen etkileşim ve satış sonuçları" : "Supported engagement and sales outcomes")</span></div>
        </div>
    </div>
</section>

<section class="pk-section pk-section-lg">
    <div class="pk-container">
        <span class="pk-eyebrow">@(tr ? "Müşteriyi ve ürünü anlayın" : "Understand customers and products")</span>
        <div class="pk-chapter"><h2>@(tr ? "Rapor görmekten karar bağlamına geçin." : "Move from reporting to decision context.")</h2><p class="pk-lead">@(tr ? "Customer Intelligence müşteriyi, Product Intelligence ürünü ve satın alma ilişkilerini anlamlandırır. Pika 360 bu bağlamı tek müşteri üzerinde birlikte okumayı kolaylaştırır." : "Customer Intelligence explains the customer, Product Intelligence explains products and purchase relationships, while Pika 360 brings that context together around an individual customer.")</p></div>
        <div class="pk-columns">
            <a class="pk-feature text-decoration-none" href="@(tr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")"><i class="ri-user-search-line"></i><h3>Customer Intelligence</h3><p>@(tr ? "Müşteri değeri, alışveriş davranışı, ritim ve risk/fırsat bağlamını birlikte değerlendirin." : "Review customer value, purchase behavior, rhythm and risk/opportunity context together.")</p></a>
            <a class="pk-feature text-decoration-none" href="@(tr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")"><i class="ri-shopping-bag-3-line"></i><h3>Product Intelligence</h3><p>@(tr ? "Ürünü yalnız kod olarak değil; kategori, ihtiyaç, Product Role ve satın alma ilişkileriyle okuyun." : "Understand products beyond codes through category, need, Product Role and purchase relationships.")</p></a>
            <a class="pk-feature text-decoration-none" href="@(tr ? "/platform/pika-360" : "/en/platform/pika-360")"><i class="ri-focus-2-line"></i><h3>Pika 360</h3><p>@(tr ? "Profil, davranış, işlem, segment, fırsat ve aksiyon bağlamını tek müşteri görünümünde değerlendirin." : "Review profile, behavior, transactions, segments, opportunities and action context in one customer view.")</p></a>
        </div>
    </div>
</section>

<section class="pk-section pk-section-soft">
    <div class="pk-container pk-screen-band">
        <div>
            <span class="pk-eyebrow">@(tr ? "Aksiyona dönüştürün" : "Turn insight into action")</span>
            <h2>@(tr ? "Kampanya mı, Journey mi? Kararı ihtiyaca göre verin." : "Campaign or Journey? Choose based on the job.")</h2>
            <p class="pk-lead">@(tr ? "Campaign Manager tanımlı bir hedef kitle ve gönderim için kontrollü yürütme sağlar. Journey Manager ise tetikleyici, karar, bekleme ve aksiyon adımlarından oluşan sürekli akışları yönetir." : "Campaign Manager provides controlled execution for defined audiences and sends. Journey Manager manages ongoing flows composed of triggers, decisions, waits and actions.")</p>
            <div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr ? "/platform/campaign-manager" : "/en/platform/campaign-manager")">Campaign Manager</a><a class="pk-btn pk-btn-ghost" href="@(tr ? "/platform/journey-manager" : "/en/platform/journey-manager")">Journey Manager</a></div>
        </div>
        <img src="/wiki/assets/images/img_journey-tasarim-tuvali_18.png" alt="@(tr ? "Pika Journey tasarım tuvali" : "Pika Journey design canvas")" loading="lazy" width="1200" height="760" />
    </div>
</section>

<section class="pk-section">
    <div class="pk-container">
        <div class="pk-chapter"><div><span class="pk-eyebrow">@(tr ? "Kanallar" : "Channels")</span><h2>@(tr ? "Kanalı ürünün kendisi değil, aksiyon aracı olarak düşünün." : "Treat channels as execution tools, not the product itself.")</h2></div><p class="pk-lead">@(tr ? "Email, SMS, WhatsApp ve Push; hedef kitle, izin, uygunluk, Campaign veya Journey kararı oluştuktan sonra kullanılan uygulama katmanıdır." : "Email, SMS, WhatsApp and Push are execution channels used after audience, consent, eligibility and Campaign/Journey context is established.")</p></div>
        <div class="pk-columns">
            <div class="pk-feature"><i class="ri-mail-line"></i><h3>Email</h3><p>@(tr ? "Zengin içerik ve uzun biçimli iletişim için." : "For rich content and longer communication.")</p></div>
            <div class="pk-feature"><i class="ri-message-2-line"></i><h3>SMS</h3><p>@(tr ? "Kısa ve zaman duyarlı iletişim için." : "For concise, time-sensitive communication.")</p></div>
            <div class="pk-feature"><i class="ri-whatsapp-line"></i><h3>WhatsApp</h3><p>@(tr ? "Uygun izin ve şablon bağlamında mesajlaşma için." : "For messaging within appropriate consent and template context.")</p></div>
        </div>
        <div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr ? "/kanallar/email" : "/en/channels/email")">@(tr ? "Kanalları inceleyin" : "Explore channels")</a></div>
    </div>
</section>

<section class="pk-section pk-section-deep">
    <div class="pk-container pk-screen-band">
        <div>
            <span class="pk-eyebrow" style="color:#d1ea88">@(tr ? "AI destekler, kullanıcı yönetir" : "AI assists, people stay in control")</span>
            <h2>@(tr ? "Hesaplanmış veri ile AI yorumunu birbirine karıştırmayın." : "Keep calculated evidence distinct from AI interpretation.")</h2>
            <p class="pk-lead">@(tr ? "Pika AI; sistemin hesapladığı müşteri ve ürün bağlamını açıklama, kampanya yaklaşımı hazırlama ve içerik taslağı üretme gibi görevlerde yardımcı olur. Gönderim ve aksiyon kontrolü kullanıcıdadır." : "Pika AI helps explain system-calculated customer and product context, prepare campaign approaches and draft content. Execution remains under user control.")</p>
            <div class="pk-actions"><a class="pk-btn pk-btn-light" href="@(tr ? "/platform/ai-kampanya-asistani" : "/en/platform/ai-campaign-assistant")">@(tr ? "Pika AI'yı İnceleyin" : "Explore Pika AI")</a></div>
        </div>
        <img src="/wiki/assets/images/img_ai-musteri-ozeti_8.png" alt="@(tr ? "Pika AI müşteri özeti ekranı" : "Pika AI customer summary screen")" loading="lazy" width="1200" height="760" />
    </div>
</section>

<section class="pk-section">
    <div class="pk-container pk-screen-band">
        <img src="/wiki/assets/images/img_bi-kokpit_5.png" alt="@(tr ? "Pika BI kokpit ekranı" : "Pika BI cockpit screen")" loading="lazy" width="1200" height="760" />
        <div><span class="pk-eyebrow">@(tr ? "Ölçün" : "Measure")</span><h2>@(tr ? "Aksiyonun sonunda yeniden veriye dönün." : "Return to evidence after action.")</h2><p class="pk-lead">@(tr ? "BI ve Analytics katmanı kampanya, kanal, müşteri ve satış bağlamını desteklenen metriklerle birlikte okumayı sağlar. İlişkilendirme, nedensellik iddiası değildir; sonuçları kanıtın izin verdiği ölçüde yorumlayın." : "BI and Analytics bring supported campaign, channel, customer and sales metrics together. Attribution is not the same as causation; interpret results only as far as the evidence supports.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr ? "/platform/analytics" : "/en/platform/analytics")">Analytics</a><a class="pk-btn pk-btn-ghost" href="/wiki/">@(tr ? "Bilgi Bankası" : "Knowledge Base")</a></div></div>
    </div>
</section>

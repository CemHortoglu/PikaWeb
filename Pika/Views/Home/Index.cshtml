@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var isTr = culture == "tr";
    ViewData["BodyClass"] = "pika-home-v2";
}

@* ══════════════════════════════════════════════════════════════════════════
   CHAPTER 1: HERO — Unified Commercial Intelligence Above the Fold
   ══════════════════════════════════════════════════════════════════════════ *@
<section class="pw2-section pw2-home-hero" id="hero">
    <div class="pw2-container pw2-container--stage">
        <div class="pw2-home-hero__content" data-aos="fade-up" data-aos-duration="600">
            <div class="pw2-eyebrow">
                <i class="ri-sparkling-fill" aria-hidden="true"></i>
                @(isTr ? "Müşteri Zekâsı ve Omnichannel Pazarlama Platformu" : "Customer Intelligence & Omnichannel Marketing Platform")
            </div>
            <h1 class="pw2-display">
                @(isTr ? "Müşteriyi ve ürünü anlayın. Doğru fırsatı bulun. Doğru anda aksiyona geçin." : "Understand your customers and products. Identify the right opportunity. Act at the right moment.")
            </h1>
            <p class="pw2-lead">
                @(isTr ? "Pika; müşteri, ürün ve satış verisini birlikte anlamlandırarak işletmenin bugün hangi müşteride hangi ticari fırsatın oluştuğunu görmesini ve bu fırsatı kontrollü, ölçülebilir çok kanallı aksiyona dönüştürmesini sağlayan müşteri zekâsı ve pazarlama platformudur." : "Pika is a customer intelligence and marketing platform that brings customer, product and sales data together to identify commercial opportunities and turn them into controlled, measurable omnichannel actions.")
            </p>
            <div class="pw2-home-hero__actions">
                <button type="button" class="pw2-btn pw2-btn--primary pw2-btn--lg" data-bs-toggle="modal" data-bs-target="#demoModal">
                    @(isTr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line" aria-hidden="true"></i>
                </button>
                <a href="#firsatlar" class="pw2-btn pw2-btn--secondary pw2-btn--lg">
                    @(isTr ? "Fırsat Motorunu İnceleyin" : "Explore Opportunity Engine") <i class="ri-arrow-down-line" aria-hidden="true"></i>
                </a>
                <a href="@(isTr ? "/demo-talebi" : "/en/demo-request")" class="pw2-btn pw2-btn--tertiary">
                    @(isTr ? "Teklif Al" : "Request a Quote") <i class="ri-arrow-right-line" aria-hidden="true"></i>
                </a>
            </div>
            <div class="pw2-home-hero__tags">
                <span class="pw2-home-tag"><i class="ri-brain-line" aria-hidden="true"></i> Customer &amp; Product Intelligence</span>
                <span class="pw2-home-tag"><i class="ri-focus-3-line" aria-hidden="true"></i> @(isTr ? "Günün Fırsatları (CCE)" : "Daily Opportunities (CCE)")</span>
                <span class="pw2-home-tag"><i class="ri-route-line" aria-hidden="true"></i> @(isTr ? "Audience &amp; Journey" : "Audience &amp; Journey")</span>
                <span class="pw2-home-tag"><i class="ri-message-3-line" aria-hidden="true"></i> Email · SMS · WhatsApp</span>
            </div>
        </div>

        @* Hero Asymmetric Dual-Stage Product Composition *@
        <div class="pw2-home-hero-stage" data-aos="fade-up" data-aos-duration="800" data-aos-delay="150">
            <div class="pw2-home-hero-stage__main">
                <div class="pw2-product-frame">
                    <div class="pw2-product-frame__header">
                        <div class="pw2-product-frame__dots">
                            <span class="pw2-product-frame__dot"></span>
                            <span class="pw2-product-frame__dot"></span>
                            <span class="pw2-product-frame__dot"></span>
                        </div>
                        <span class="pw2-product-frame__title">pika-360.decision-console</span>
                    </div>
                    <img src="~/wiki/assets/images/img_pika-360_7.png" 
                         alt="@(isTr ? "Pika 360 bütünleşik müşteri karar konsolu: Zaman tüneli, hesaplanan CVS skoru ve açık fırsatlar" : "Pika 360 unified customer decision console: Order timeline, calculated CVS score, and open opportunities")"
                         width="1672" 
                         height="941" 
                         loading="eager" />
                </div>
                <div class="pw2-product-caption">
                    <span class="pw2-badge pw2-badge--demo">@(isTr ? "Örnek Gösterim" : "Sample View")</span>
                    <span>@(isTr ? "Pika 360 Müşteri Karar Konsolu: Zaman tüneli, hesaplanan CVS skoru ve açık fırsatlar." : "Pika 360 Customer Decision Console: Timeline, calculated CVS score, and open opportunities.")</span>
                </div>
            </div>

            <div class="pw2-home-hero-stage__companion d-none d-lg-block">
                <div class="pw2-product-frame">
                    <div class="pw2-product-frame__header">
                        <div class="pw2-product-frame__dots">
                            <span class="pw2-product-frame__dot"></span>
                            <span class="pw2-product-frame__dot"></span>
                            <span class="pw2-product-frame__dot"></span>
                        </div>
                        <span class="pw2-product-frame__title">gunun-firsatlari.feed</span>
                    </div>
                    <img src="~/wiki/assets/images/img_gunun-firsatlari.png" 
                         alt="@(isTr ? "Günün Fırsatları öncelik sıralı aksiyon akışı" : "Daily Opportunities prioritized action feed")"
                         width="1024" 
                         height="832" 
                         loading="eager" />
                </div>
                <div class="pw2-product-caption">
                    <span class="pw2-badge pw2-badge--demo">@(isTr ? "Örnek Veri" : "Example Data")</span>
                    <span>@(isTr ? "Günün Fırsatları aksiyon akışı." : "Daily Opportunities action feed.")</span>
                </div>
            </div>
        </div>
    </div>
</section>

@* ══════════════════════════════════════════════════════════════════════════
   CHAPTER 2: GÜNÜN FIRSATLARI — "Pika Bugün Hangi Fırsatları Buldu?"
   ══════════════════════════════════════════════════════════════════════════ *@
<section class="pw2-section pw2-home-firsatlar" id="firsatlar">
    <div class="pw2-container">
        <div class="pw2-editorial-split align-items-center">
            <div data-aos="fade-right" data-aos-duration="700">
                <div class="pw2-eyebrow">
                    <i class="ri-focus-3-line" aria-hidden="true"></i>
                    @(isTr ? "Fırsat ve Karar Motoru" : "Opportunity & Decision Engine")
                </div>
                <h2 class="pw2-h2">
                    @(isTr ? "Pika bugün hangi fırsatları buldu?" : "What opportunities did Pika discover today?")
                </h2>
                <p class="pw2-lead">
                    @(isTr ? "Geniş kitlelere rastgele mesaj göndermek yerine, müşteri tüketim ritmi ve ürün dinamiklerinden çıkan günlük öncelikli fırsatları keşfedin. Her sabah aksiyona hazır, filtrelenmiş ve kontrollü ticari öneriler." : "Instead of broadcasting indiscriminate campaigns, unlock daily prioritized opportunities derived from customer consumption rhythms and catalog dynamics. Governed commercial recommendations ready for action every morning.")
                </p>

                <div class="pw2-home-opp-list">
                    <div class="pw2-home-opp-item">
                        <div class="pw2-home-opp-item__icon pw2-home-opp-item__icon--repurchase">
                            <i class="ri-refresh-line" aria-hidden="true"></i>
                        </div>
                        <div class="pw2-home-opp-item__body">
                            <div class="pw2-home-opp-item__title">
                                @(isTr ? "Tekrar Satın Alma (%80–%120 Tüketim Penceresi)" : "Repurchase Rhythm (80%–120% Cycle Window)")
                            </div>
                            <p class="pw2-home-opp-item__desc">
                                @(isTr ? "Müşterinin geçmiş işlem sıklığına göre hesaplanan bireysel tüketim penceresinde, ihtiyaç tükenmeden önce zamanında hatırlatma." : "Algorithmic calculation of individualized consumption windows, triggering engagement right before replenishment cycles lapse.")
                            </p>
                        </div>
                    </div>

                    <div class="pw2-home-opp-item">
                        <div class="pw2-home-opp-item__icon pw2-home-opp-item__icon--crosssell">
                            <i class="ri-shopping-basket-2-line" aria-hidden="true"></i>
                        </div>
                        <div class="pw2-home-opp-item__body">
                            <div class="pw2-home-opp-item__title">
                                @(isTr ? "Çapraz Satış ve Sepet Birlikteliği" : "Cross-Sell & Market Basket Affinity")
                            </div>
                            <p class="pw2-home-opp-item__desc">
                                @(isTr ? "Birlikte satın alma kuralları (Support, Confidence, Lift) ve Need Group eşleştirmesiyle sepeti tamamlayan doğru ürün önerisi." : "Basket association rules and Need Group alignments recommending complementary products with proven commercial affinity.")
                            </p>
                        </div>
                    </div>

                    <div class="pw2-home-opp-item">
                        <div class="pw2-home-opp-item__icon pw2-home-opp-item__icon--winback">
                            <i class="ri-user-unfollow-line" aria-hidden="true"></i>
                        </div>
                        <div class="pw2-home-opp-item__body">
                            <div class="pw2-home-opp-item__title">
                                @(isTr ? "Geri Kazanım ve Kayıp Riski Sinyalleri" : "Win-Back & Churn Prevention Signals")
                            </div>
                            <p class="pw2-home-opp-item__desc">
                                @(isTr ? "Alışveriş ritmi aksayan ve pasifleşme riski taşıyan değerli müşterilerin erken evrede tespiti ve hedeflenmesi." : "Early detection and targeted re-engagement of slipping high-value patrons before dormancy becomes permanent.")
                            </p>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 flex-wrap">
                    <a href="@(isTr ? "/platform/gunun-firsatlari" : "/en/platform/opportunities")" class="pw2-btn pw2-btn--secondary">
                        @(isTr ? "Günün Fırsatlarını Keşfedin" : "Explore Daily Opportunities") <i class="ri-arrow-right-line" aria-hidden="true"></i>
                    </a>
                    <button type="button" class="pw2-btn pw2-btn--primary" data-bs-toggle="modal" data-bs-target="#demoModal">
                        @(isTr ? "Demo Talep Et" : "Request a Demo")
                    </button>
                </div>
            </div>

            <div data-aos="fade-left" data-aos-duration="700">
                <div class="pw2-product-frame">
                    <div class="pw2-product-frame__header">
                        <div class="pw2-product-frame__dots">
                            <span class="pw2-product-frame__dot"></span>
                            <span class="pw2-product-frame__dot"></span>
                            <span class="pw2-product-frame__dot"></span>
                        </div>
                        <span class="pw2-product-frame__title">gunun-firsatlari.cockpit</span>
                    </div>
                    <img src="~/wiki/assets/images/img_gunun-firsatlari.png" 
                         alt="@(isTr ? "Günün Fırsatları modülü: Tekrar satın alma, cross-sell ve win-back listesi" : "Daily Opportunities module: Repurchase, cross-sell, and win-back action list")"
                         width="1024" 
                         height="832" 
                         loading="lazy" />
                </div>
                <div class="pw2-product-caption">
                    <span class="pw2-badge pw2-badge--demo">@(isTr ? "Örnek Gösterim" : "Sample View")</span>
                    <span>@(isTr ? "Günün Fırsatları günlük ticari karar ve öncelik sıralı aksiyon akışı." : "Daily Opportunities commercial decision feed ranked by priority.")</span>
                </div>
            </div>
        </div>
    </div>
</section>

@* ══════════════════════════════════════════════════════════════════════════
   CHAPTER 3: DATA → INTELLIGENCE → OPPORTUNITY (Operating Model)
   ══════════════════════════════════════════════════════════════════════════ *@
<section class="pw2-section pw2-section--subtle" id="calisma-modeli">
    <div class="pw2-container">
        <div class="pw2-text-center mb-5" data-aos="fade-up">
            <div class="pw2-eyebrow">
                <i class="ri-git-commit-line" aria-hidden="true"></i>
                @(isTr ? "Çalışma Modeli" : "Operating Model")
            </div>
            <h2 class="pw2-h2">
                @(isTr ? "Pika’nın başlangıç noktası mesaj göndermek değil, anlamaktır." : "Pika's starting point is not merely sending messages; it is understanding.")
            </h2>
            <p class="pw2-lead mx-auto" style="max-width:760px">
                @(isTr ? "Pika, veriyi depolamakla veya salt mesaj iletmekle yetinmez. Çevrimdışı fişler, e-ticaret siparişleri ve ürün özellikleri önce zekâ katmanında işlenir, ardından ticari fırsat ve karara dönüşür." : "Pika does not merely store records or blast dispatches. Offline receipts, e-commerce orders, and catalog attributes are first enriched in the intelligence layer, then translated into commercial opportunities and decisions.")
            </p>
        </div>

        @* Connected 3-Step Flow *@
        <div class="pw2-home-flow" data-aos="fade-up" data-aos-delay="100">
            <div class="pw2-home-flow__step">
                <div class="pw2-home-flow__step-num">01</div>
                <h3 class="pw2-h4">@(isTr ? "Veri ve Entegrasyon" : "Data & Ingestion")</h3>
                <p class="pw2-body-sm">
                    @(isTr ? "Asenkron Ingestion API, CSV/Excel kolay aktarımı ve POS/ERP bağlayıcıları. Müşteri kimlik tekilleştirmesi ve işlem geçmişinin konsolidasyonu." : "Asynchronous Ingestion API, CSV/Excel imports, and POS/ERP connectors. Identity resolution and consolidated transactional history.")
                </p>
            </div>

            <div class="pw2-home-flow__arrow" aria-hidden="true">
                <i class="ri-arrow-right-line" aria-hidden="true"></i>
            </div>

            <div class="pw2-home-flow__step">
                <div class="pw2-home-flow__step-num">02</div>
                <h3 class="pw2-h4">@(isTr ? "Müşteri ve Ürün Zekâsı" : "Customer & Product Intelligence")</h3>
                <p class="pw2-body-sm">
                    @(isTr ? "Hesaplanan Customer Value Score (CVS), tüketim ritmi döngüsü, Need Group ihtiyaç eşleştirmesi ve Product Role ticari konumlandırması." : "Calculated Customer Value Score (CVS), consumption rhythms, Need Group intent mapping, and Product Role merchandise classification.")
                </p>
            </div>

            <div class="pw2-home-flow__arrow" aria-hidden="true">
                <i class="ri-arrow-right-line" aria-hidden="true"></i>
            </div>

            <div class="pw2-home-flow__step">
                <div class="pw2-home-flow__step-num">03</div>
                <h3 class="pw2-h4">@(isTr ? "Fırsat ve Karar" : "Opportunity & Decision")</h3>
                <p class="pw2-body-sm">
                    @(isTr ? "CCE öncelik hiyerarşisi: Risk ve frekans filtreleri, tekrar satın alma, çapraz satış ve geri kazanım sinyalleri aksiyona hazır." : "CCE priority hierarchy: Risk and frequency gating, replenishment alerts, basket cross-sells, and win-back cohorts primed for action.")
                </p>
            </div>
        </div>

        @* Ingestion Workbench Real Screenshot (Clean Crop y:36 removes browser bar) *@
        <div class="pw2-product-stage" data-aos="fade-up" data-aos-delay="200">
            <div class="pw2-product-frame pw2-home-ingestion-crop">
                <div class="pw2-product-frame__header">
                    <div class="pw2-product-frame__dots">
                        <span class="pw2-product-frame__dot"></span>
                        <span class="pw2-product-frame__dot"></span>
                        <span class="pw2-product-frame__dot"></span>
                    </div>
                    <span class="pw2-product-frame__title">ingestion-workbench.import</span>
                </div>
                <img src="~/wiki/assets/images/img_excel-csv-aktarimi_1.png" 
                     alt="@(isTr ? "Pika veri entegrasyonu ve kolon eşleştirme çalışma alanı" : "Pika data ingestion and column mapping workspace")"
                     width="1885" 
                     height="974" 
                     loading="lazy" />
            </div>
            <div class="pw2-product-caption">
                <span>@(isTr ? "Asenkron veri aktarımı ve kolon eşleştirme ekranı." : "Asynchronous data ingestion and column mapping interface.")</span>
                <a href="@(isTr ? "/entegrasyonlar" : "/en/integrations")" class="pw2-btn pw2-btn--tertiary">
                    @(isTr ? "Entegrasyonları Görün" : "View Integrations") <i class="ri-arrow-right-line" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
</section>

@* ══════════════════════════════════════════════════════════════════════════
   CHAPTER 4: CUSTOMER + PRODUCT INTELLIGENCE (Twin Intelligence Domains)
   ══════════════════════════════════════════════════════════════════════════ *@
<section class="pw2-section" id="zeka-katmani">
    <div class="pw2-container">
        <div class="pw2-text-center mb-5" data-aos="fade-up">
            <div class="pw2-eyebrow">
                <i class="ri-brain-line" aria-hidden="true"></i>
                @(isTr ? "İkiz Zekâ Katmanı" : "Twin Intelligence Domains")
            </div>
            <h2 class="pw2-h2">
                @(isTr ? "Müşteri Zekâsı ve Ürün Zekâsı: İlişkili Ama İki Ayrı Uzmanlık" : "Customer & Product Intelligence: Distinct Yet Interconnected Domains")
            </h2>
            <p class="pw2-lead mx-auto" style="max-width:760px">
                @(isTr ? "Müşteriyi sadece demografiyle değil, işlem ritmi ve hesaplanan Customer Value Score (CVS) ile değerlendirin. Ürünleri sadece stok koduyla değil, tüketici ihtiyacı (Need Group) ve ticari rolüyle (Product Role) konumlandırın." : "Evaluate customers not by static demographics, but by transaction cadence and calculated Customer Value Score (CVS). Contextualize products beyond SKUs through consumer Need Groups and commercial Product Roles.")
            </p>
        </div>

        @* Domain A: Customer Intelligence *@
        <div class="pw2-editorial-split pw2-home-intel-block align-items-center">
            <div data-aos="fade-right" data-aos-duration="700">
                <span class="pw2-badge pw2-badge--status mb-2">Customer Intelligence</span>
                <h3 class="pw2-h3">
                    @(isTr ? "Kimin, Ne Zaman ve Hangi Değerle Satın Aldığını Anlayın" : "Understand Who Purchases, When, and at What Value")
                </h3>
                <p class="pw2-body">
                    @(isTr ? "Statik müşteri listelerinin ötesine geçin. Pika Customer Intelligence; işlem sıklığı, sepet tutarı, son alışveriş zamanı ve sadakat değişkenleriyle hesaplanan CVS skorunu (0-100) üretir. Müşterinin doğal tüketim döngüsünü (%80-%120 penceresi) izleyerek ihtiyaç anını yakalar, kayıp riskini pasifleşmeden önce haber verir." : "Move beyond static customer lists. Pika Customer Intelligence calculates a deterministic Customer Value Score (CVS 0-100) weighting recency, frequency, monetary value, and loyalty. It monitors individualized consumption windows (80%-120%) and alerts to churn risk before attrition becomes permanent.")
                </p>
                <div class="pw2-home-pill-list">
                    <span class="pw2-home-tag"><i class="ri-dashboard-3-line" aria-hidden="true"></i> @(isTr ? "Hesaplanan CVS Skoru (0-100)" : "Calculated CVS Score (0-100)")</span>
                    <span class="pw2-home-tag"><i class="ri-timer-line" aria-hidden="true"></i> @(isTr ? "%80–%120 Tüketim Ritmi" : "80%–120% Repurchase Cadence")</span>
                    <span class="pw2-home-tag"><i class="ri-shield-user-line" aria-hidden="true"></i> @(isTr ? "Kayıp Riski Erken Uyarısı" : "Early Churn Detection")</span>
                </div>
                <a href="@(isTr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")" class="pw2-btn pw2-btn--secondary">
                    @(isTr ? "Customer Intelligence İnceleyin" : "Explore Customer Intelligence") <i class="ri-arrow-right-line" aria-hidden="true"></i>
                </a>
            </div>
            <div data-aos="fade-left" data-aos-duration="700">
                <div class="pw2-product-frame">
                    <div class="pw2-product-frame__header">
                        <div class="pw2-product-frame__dots">
                            <span class="pw2-product-frame__dot"></span>
                            <span class="pw2-product-frame__dot"></span>
                            <span class="pw2-product-frame__dot"></span>
                        </div>
                        <span class="pw2-product-frame__title">customer-intel.repurchase-analysis</span>
                    </div>
                    <img src="~/wiki/assets/images/img_tekrar-satin-alma-analizi_6.png" 
                         alt="@(isTr ? "Tekrar satın alma analizi ve müşteri tüketim zamanlaması dağılımı" : "Repeat purchase analysis and customer consumption cadence distribution")"
                         width="1774" 
                         height="887" 
                         loading="lazy" />
                </div>
                <div class="pw2-product-caption">
                    <span class="pw2-badge pw2-badge--demo">@(isTr ? "Örnek Gösterim" : "Sample View")</span>
                    <span>@(isTr ? "Müşteri tüketim döngüsü ve tekrar satın alma zamanlama analizi." : "Customer consumption cycle and repeat purchase timing analysis.")</span>
                </div>
            </div>
        </div>

        @* Domain B: Product Intelligence (Reversed Split) *@
        <div class="pw2-editorial-split pw2-editorial-split--reversed pw2-home-intel-block align-items-center">
            <div data-aos="fade-left" data-aos-duration="700">
                <span class="pw2-badge pw2-badge--status mb-2">Product Intelligence</span>
                <h3 class="pw2-h3">
                    @(isTr ? "Ürünlerinizi Tüketici İhtiyacı ve Ticari Rolüyle Anlamlandırın" : "Contextualize Inventory by Consumer Need and Commercial Role")
                </h3>
                <p class="pw2-body">
                    @(isTr ? "Katalogdaki her ürün aynı ticari amaca hizmet etmez. Product Intelligence; ürünleri tüketici ihtiyacına göre Need Group (Kahvaltı, Cilt Bakımı vb.) ve ticari misyonuna göre Product Role (Trafik Çekici, Sepet Büyütücü, Kâr Odaklı, Prestij) olarak sınıflandırır. Çapraz satış kurgularında yüksek hacimli ürünlerle kârlı ürünlerin doğru eşleşmesini sağlar." : "Not every product serves the same commercial purpose. Product Intelligence classifies inventory by consumer Need Group (Breakfast, Skincare, etc.) and commercial Product Role (Traffic Driver, Basket Booster, Margin Generator, Prestige). It ensures high-traffic staples are systematically paired with high-margin companions in cross-sell campaigns.")
                </p>
                <div class="pw2-home-pill-list">
                    <span class="pw2-home-tag"><i class="ri-price-tag-3-line" aria-hidden="true"></i> Need Groups (İhtiyaç Grupları)</span>
                    <span class="pw2-home-tag"><i class="ri-store-2-line" aria-hidden="true"></i> Product Roles (Ticari Roller)</span>
                    <span class="pw2-home-tag"><i class="ri-git-merge-line" aria-hidden="true"></i> @(isTr ? "Sepet Birlikteliği Matrisi" : "Basket Association Matrix")</span>
                </div>
                <a href="@(isTr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")" class="pw2-btn pw2-btn--secondary">
                    @(isTr ? "Product Intelligence İnceleyin" : "Explore Product Intelligence") <i class="ri-arrow-right-line" aria-hidden="true"></i>
                </a>
            </div>
            <div data-aos="fade-right" data-aos-duration="700">
                <div class="pw2-product-frame">
                    <div class="pw2-product-frame__header">
                        <div class="pw2-product-frame__dots">
                            <span class="pw2-product-frame__dot"></span>
                            <span class="pw2-product-frame__dot"></span>
                            <span class="pw2-product-frame__dot"></span>
                        </div>
                        <span class="pw2-product-frame__title">product-intel.classification-workbench</span>
                    </div>
                    <img src="~/wiki/assets/images/img_urun-siniflandirma-workbench_13.png" 

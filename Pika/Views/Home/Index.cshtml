@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr = culture == "tr";
    ViewData["Title"] = tr ? "Pika | Müşteri ve Ürün Zekâsından Doğru Aksiyona" : "Pika | From Customer & Product Intelligence to Action";
    ViewData["MetaDescription"] = tr
        ? "Pika; müşteri, ürün ve işlem verisini Customer Intelligence ve Product Intelligence ile anlamlandırır, Günün Fırsatları'nı görünür kılar ve kontrollü Campaign, Journey ve kanal aksiyonlarına dönüştürür."
        : "Pika turns customer, product and transaction data into intelligence, surfaces Daily Opportunities and connects them to controlled Campaign, Journey and channel execution.";
    ViewData["BodyClass"] = "pk-page";
}
@section JsonLd {
<script type="@Html.Raw("application/ld+json")">
{"@@context":"https://schema.org","@@graph":[
 {"@@type":"WebSite","@@id":"https://pika.tr/#website","url":"https://pika.tr/","name":"Pika","inLanguage":["tr-TR","en-US"]},
 {"@@type":"SoftwareApplication","@@id":"https://pika.tr/#software","name":"Pika","applicationCategory":"BusinessApplication","operatingSystem":"Web","url":"https://pika.tr/","description":"@(tr ? "Müşteri ve ürün verisini anlamlandıran, fırsatları görünür kılan ve kontrollü pazarlama aksiyonlarına bağlayan B2B SaaS platformu." : "A B2B SaaS platform that turns customer and product context into opportunities and controlled marketing actions.")","provider":{"@@id":"https://pika.tr/#organization"}}
]}
</script>
}

<section class="pk-hero-v2">
    <div class="pk-container pk-hero-grid">
        <div class="pk-hero-copy">
            <span class="pk-eyebrow">Doğru Anda</span>
            <h1>@(tr ? "Müşterinizi anlayın. Fırsatı görün. Doğru anda aksiyon alın." : "Understand customers. See the opportunity. Act at the right moment.")</h1>
            <p>@(tr
                ? "Pika; müşteri, ürün, satış ve etkileşim verisini aynı karar bağlamında birleştirir. Ne olduğunu yalnız raporlamakla kalmaz; bugün hangi müşteride anlamlı bir fırsat oluştuğunu görünür kılar ve bu fırsatı sizin kontrolünüzde aksiyona dönüştürür."
                : "Pika brings customer, product, sales and engagement data into one decision context. It goes beyond reporting what happened by surfacing meaningful customer opportunities and connecting them to controlled action.")</p>
            <div class="pk-actions">
                <button class="pk-btn pk-btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal"><i class="ri-play-circle-line"></i>@(tr ? "Pika'yı Canlı Görün" : "See Pika Live")</button>
                <a class="pk-btn pk-btn-ghost" href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Tam Olarak Nedir?" : "What Exactly Is Pika?")</a>
            </div>
            <div class="pk-hero-note"><i class="ri-shield-check-line"></i><span>@(tr ? "AI yardımcıdır; hesaplanmış veri, izin ve kullanıcı kararı birbirinden ayrılır." : "AI assists; calculated data, consent and user decisions remain distinct.")</span></div>
        </div>

        <div class="pk-product-stage" aria-label="@(tr ? "Pika ürün görünümü" : "Pika product preview")">
            <div class="pk-stage-glow"></div>
            <div class="pk-stage-browser">
                <div class="pk-stage-bar" aria-hidden="true"><span></span><span></span><span></span></div>
                <img src="/wiki/assets/images/img_gunun-firsatlari.png" alt="@(tr ? "Pika Günün Fırsatları çalışma alanı" : "Pika Daily Opportunities workspace")" width="1200" height="760" fetchpriority="high" />
                <div class="pk-stage-caption"><strong>@(tr ? "Günün Fırsatları" : "Daily Opportunities")</strong><span>@(tr ? "Kanıtı inceleyin → aksiyonu seçin" : "Review evidence → choose action")</span></div>
            </div>
            <div class="pk-stage-float pk-float-one"><i class="ri-refresh-line"></i><div><strong>@(tr ? "Tekrar satın alma" : "Repeat purchase")</strong><small>@(tr ? "Kişisel satın alma ritmi" : "Individual purchase rhythm")</small></div></div>
            <div class="pk-stage-float pk-float-two"><i class="ri-links-line"></i><div><strong>Cross-sell</strong><small>@(tr ? "Ürün ilişkisi ve sepet kanıtı" : "Product relation and basket evidence")</small></div></div>
            <div class="pk-stage-float pk-float-three"><i class="ri-route-line"></i><div><strong>Campaign / Journey</strong><small>@(tr ? "Kontrollü yürütme" : "Controlled execution")</small></div></div>
        </div>
    </div>
</section>

<div class="pk-capability-strip" aria-label="Pika platform capabilities"><div class="pk-container">
    <span class="pk-capability-item">Customer Intelligence</span><span class="pk-capability-item">Product Intelligence</span><span class="pk-capability-item">Pika 360</span><span class="pk-capability-item">@(tr ? "Günün Fırsatları" : "Daily Opportunities")</span><span class="pk-capability-item">Campaign Manager</span><span class="pk-capability-item">Journey Manager</span><span class="pk-capability-item">Analytics</span>
</div></div>

<section class="pk-section pk-section-xl pk-decision-band">
    <div class="pk-container">
        <div class="pk-section-head">
            <div><span class="pk-eyebrow">@(tr ? "Pika nasıl çalışır?" : "How Pika works")</span><h2>@(tr ? "Mesajdan değil, veriden başlayan bir karar zinciri." : "A decision chain that starts with data, not messages.")</h2></div>
            <p class="pk-lead">@(tr ? "Pika'nın ürün mantığı modül listesi değildir. Müşteriyi ve ürünü anlamak, kanıtlanabilir fırsatı bulmak, kararı kullanıcıya açıklamak ve aksiyonu ölçülebilir biçimde yürütmek aynı zincirin parçalarıdır." : "Pika is not a list of modules. Understanding customers and products, finding evidence-backed opportunities, explaining decisions and executing measurable actions are parts of one chain.")</p>
        </div>
        <div class="pk-workflow" role="list">
            <div class="pk-workflow-step" role="listitem"><small>01 · @(tr ? "Kaynak" : "Source")</small><i class="ri-database-2-line"></i><strong>@(tr ? "Veri" : "Data")</strong><span>@(tr ? "Müşteri, ürün, satış, sipariş ve etkileşim bağlamı" : "Customer, product, sales, order and engagement context")</span></div>
            <div class="pk-workflow-step" role="listitem"><small>02 · Intelligence</small><i class="ri-radar-line"></i><strong>@(tr ? "Anlama" : "Understanding")</strong><span>Customer Intelligence · Product Intelligence · Pika 360</span></div>
            <div class="pk-workflow-step" role="listitem"><small>03 · Opportunity</small><i class="ri-sparkling-2-line"></i><strong>@(tr ? "Fırsat" : "Opportunity")</strong><span>@(tr ? "Tekrar satın alma, geri kazanım, cross-sell ve desteklenen diğer sinyaller" : "Repeat purchase, win-back, cross-sell and other supported signals")</span></div>
            <div class="pk-workflow-step" role="listitem"><small>04 · Decision</small><i class="ri-search-eye-line"></i><strong>@(tr ? "Karar" : "Decision")</strong><span>@(tr ? "Kullanıcı nedeni ve kanıtı görür; ne yapılacağına karar verir" : "The user sees evidence and decides what should happen")</span></div>
            <div class="pk-workflow-step" role="listitem"><small>05 · Execution</small><i class="ri-route-line"></i><strong>@(tr ? "Aksiyon" : "Action")</strong><span>Audience · Campaign · Journey · Email · SMS · WhatsApp · Push</span></div>
            <div class="pk-workflow-step" role="listitem"><small>06 · Measure</small><i class="ri-bar-chart-box-line"></i><strong>@(tr ? "Ölçüm" : "Measurement")</strong><span>@(tr ? "Gönderim, etkileşim ve desteklenen satış/attribution sonuçları" : "Delivery, engagement and supported sales/attribution outcomes")</span></div>
        </div>
        <div class="pk-decision-note"><p>@(tr ? "Bu yaklaşımın amacı daha fazla mesaj üretmek değildir. Pika'nın temel sorusu şudur: " : "The goal is not to produce more messages. Pika's core question is: ")<strong>@(tr ? "Bu müşteride şu anda gerçekten aksiyon almaya değer bir durum var mı?" : "Is there a situation worth acting on for this customer right now?")</strong></p><a class="pk-btn pk-btn-light" href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Platform mantığını görün" : "Explore the platform")</a></div>
    </div>
</section>

<section class="pk-section pk-section-xl" id="gunun-firsatlari">
    <div class="pk-container pk-opportunity-showcase">
        <div class="pk-opportunity-panel"><div class="pk-product-window"><div class="pk-product-window-header"><div><i></i><i></i><i></i></div><span>@(tr ? "Pika · Günün Fırsatları" : "Pika · Daily Opportunities")</span></div><img src="/wiki/assets/images/img_gunun-firsatlari.png" alt="@(tr ? "Günün Fırsatları ürün ekranı" : "Daily Opportunities product screen")" loading="lazy" width="1200" height="760" /></div></div>
        <div class="pk-opportunity-copy">
            <span class="pk-eyebrow">@(tr ? "Flagship çalışma alanı" : "Flagship workspace")</span><h2>@(tr ? "Bugün nerede fırsat var? Tek tek rapor aramayın." : "Where is the opportunity today? Stop hunting through separate reports.")</h2>
            <p class="pk-lead">@(tr ? "Günün Fırsatları; hesaplanmış müşteri ve ürün sinyallerini günlük aksiyon diline çeviren çalışma alanıdır. Her fırsatın türünü, bağlamını ve neden incelenmeye değer olduğunu görüp sonraki adımı siz seçersiniz." : "Daily Opportunities turns calculated customer and product signals into an actionable daily workspace. Review the type, context and reason behind an opportunity, then choose the next step yourself.")</p>
            <div class="pk-signal-list">
                <div class="pk-signal"><div class="pk-signal-icon"><i class="ri-refresh-line"></i></div><div><strong>@(tr ? "Tekrar satın alma" : "Repeat purchase")</strong><span>@(tr ? "Müşterinin kendi geçmiş ritmine göre yaklaşan ihtiyaç penceresini görün." : "See an approaching need window based on the customer's own history.")</span></div><span class="pk-signal-tag">@(tr ? "Ritim" : "Rhythm")</span></div>
                <div class="pk-signal"><div class="pk-signal-icon"><i class="ri-links-line"></i></div><div><strong>Cross-sell</strong><span>@(tr ? "Ürünlerin birlikte satın alınma kanıtını müşteri bağlamıyla birlikte değerlendirin." : "Review basket co-purchase evidence together with customer context.")</span></div><span class="pk-signal-tag">Product</span></div>
                <div class="pk-signal"><div class="pk-signal-icon"><i class="ri-user-unfollow-line"></i></div><div><strong>@(tr ? "Geri kazanım" : "Win-back")</strong><span>@(tr ? "Kendi normal davranışından uzaklaşan müşteriyi değer ve ilişki bağlamında inceleyin." : "Review customers drifting from their normal behavior in value and relationship context.")</span></div><span class="pk-signal-tag">Risk</span></div>
            </div>
            <div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr ? "/platform/gunun-firsatlari" : "/en/platform/opportunities")">@(tr ? "Günün Fırsatları'nı inceleyin" : "Explore Daily Opportunities")</a></div>
        </div>
    </div>
</section>

<section class="pk-section pk-section-xl pk-section-soft-2">
    <div class="pk-container">
        <div class="pk-section-head"><div><span class="pk-eyebrow">@(tr ? "Önce anlayın" : "Understand first")</span><h2>@(tr ? "Müşteri, ürün ve tekil ilişki bağlamını ayrı ayrı okuyun." : "Read customer, product and individual relationship context separately.")</h2></div><p class="pk-lead">@(tr ? "Pika'da Customer Intelligence, Product Intelligence ve Pika 360 aynı şey değildir. Biri müşteriyi, biri ürünü ve satın alma ilişkisini, diğeri ise tek müşteride karar vermek için gereken bağlamı görünür kılar." : "Customer Intelligence, Product Intelligence and Pika 360 are not the same thing. One explains the customer, one explains products and purchase relationships, and one brings decision context together for an individual customer.")</p></div>
        <div class="pk-intel-grid">
            <article class="pk-intel-panel"><span class="pk-intel-number">01</span><div class="pk-intel-icon"><i class="ri-user-search-line"></i></div><h3>Customer Intelligence</h3><p>@(tr ? "Gerçekleşmiş ticari değer, satın alma ritmi, davranış değişimi ve risk/fırsat sinyallerini tek müşteri anlayışında birleştirin." : "Combine observed commercial value, purchase rhythm, behavioral change and risk/opportunity signals into customer understanding.")</p><div class="pk-mini-list"><span>@(tr ? "Müşteri değeri ve davranış" : "Customer value and behavior")</span><span>@(tr ? "Tekrar satın alma ritmi" : "Repeat-purchase rhythm")</span><span>@(tr ? "Risk ve fırsat bağlamı" : "Risk and opportunity context")</span></div><a class="pk-text-link" href="@(tr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")">@(tr ? "Customer Intelligence'ı aç" : "Explore Customer Intelligence") <i class="ri-arrow-right-line"></i></a></article>
            <article class="pk-intel-panel"><span class="pk-intel-number">02</span><div class="pk-intel-icon"><i class="ri-shopping-bag-3-line"></i></div><h3>Product Intelligence</h3><p>@(tr ? "Ürünleri yalnız stok kodu olarak değil; kategori, ihtiyaç, Product Role, tekrar tüketim ve cross-sell ilişkileriyle anlamlandırın." : "Understand products beyond stock codes through category, need, Product Role, repeat consumption and cross-sell relationships.")</p><div class="pk-mini-list"><span>Need Group</span><span>Product Role</span><span>@(tr ? "Ürün ilişkisi ve sınıflandırma" : "Product relationships and classification")</span></div><a class="pk-text-link" href="@(tr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")">@(tr ? "Product Intelligence'ı aç" : "Explore Product Intelligence") <i class="ri-arrow-right-line"></i></a></article>
            <article class="pk-intel-panel"><span class="pk-intel-number">03</span><div class="pk-intel-icon"><i class="ri-focus-2-line"></i></div><h3>Pika 360</h3><p>@(tr ? "Profil, işlem geçmişi, segment, fırsat, iletişim ve strateji bağlamını tek müşteri üzerinde birlikte değerlendirin." : "Review profile, transaction history, segments, opportunities, communication and strategy context around one customer.")</p><div class="pk-mini-list"><span>@(tr ? "Tek müşteri görünümü" : "Single-customer view")</span><span>@(tr ? "Fırsat ve aksiyon bağlamı" : "Opportunity and action context")</span><span>@(tr ? "Açıklanabilir karar desteği" : "Explainable decision support")</span></div><a class="pk-text-link" href="@(tr ? "/platform/pika-360" : "/en/platform/pika-360")">@(tr ? "Pika 360'ı aç" : "Explore Pika 360") <i class="ri-arrow-right-line"></i></a></article>
        </div>
        <div class="pk-gallery" style="margin-top:28px">
            <div class="pk-gallery-main"><img src="/wiki/assets/images/img_pika-360_7.png" alt="@(tr ? "Pika 360 müşteri karar görünümü" : "Pika 360 customer decision view")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Pika 360</small><h3>@(tr ? "Tek müşteride bütün karar bağlamı" : "All decision context around one customer")</h3><p>@(tr ? "Müşteri profili tek başına değil; davranış, işlem, segment, fırsat ve iletişim geçmişiyle birlikte okunur." : "A customer profile is read together with behavior, transactions, segments, opportunities and communication history.")</p></div></div>
            <div class="pk-gallery-side"><img src="/wiki/assets/images/img_urun-siniflandirma-workbench_13.png" alt="@(tr ? "Pika Product Intelligence ürün çalışma alanı" : "Pika Product Intelligence workspace")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Product Intelligence</small><h3>@(tr ? "Ürüne ticari anlam kazandırın" : "Give products commercial meaning")</h3><p>@(tr ? "Sınıflandırma ve ürün bağlamı, fırsatın nedenini açıklamak için kullanılır." : "Classification and product context help explain why an opportunity exists.")</p></div></div>
        </div>
    </div>
</section>

<section class="pk-section pk-section-xl">
    <div class="pk-container pk-control-grid">
        <div><span class="pk-eyebrow">@(tr ? "Kontrol sizde" : "You stay in control")</span><h2>@(tr ? "Pika fırsatı bulur. Kararı kullanıcı verir." : "Pika finds the opportunity. The user makes the decision.")</h2><p class="pk-lead" style="margin-top:22px">@(tr ? "Pika'nın amacı yöneticinin yerine karar vermek değil, karar için gereken kanıtı ve bağlamı görünür kılmaktır. Uygun aksiyon seçildiğinde içerik hazırlanabilir, Campaign veya Journey kurulabilir; yayınlama yine kontrollü bir süreçtir." : "Pika does not aim to replace the manager. It surfaces the evidence and context needed for a decision. Once an action is chosen, content can be prepared and Campaign or Journey can be configured, while publishing remains controlled.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr ? "/kullanim-senaryolari" : "/en/use-cases")">@(tr ? "Gerçek kullanım senaryoları" : "Real use cases")</a></div></div>
        <div class="pk-control-flow">
            <div class="pk-control-step"><i class="ri-radar-line"></i><div><strong>1. @(tr ? "Pika sinyali bulur" : "Pika finds a signal")</strong><span>@(tr ? "Müşteri ve ürün verisinden açıklanabilir fırsat bağlamı oluşur." : "Explainable opportunity context emerges from customer and product data.")</span></div></div>
            <div class="pk-control-step"><i class="ri-file-search-line"></i><div><strong>2. @(tr ? "Kanıt görünür olur" : "Evidence becomes visible")</strong><span>@(tr ? "Fırsatın türü, ilişkili veri ve uygunluk bağlamı kullanıcıya gösterilir." : "The opportunity type, supporting data and eligibility context are shown to the user.")</span></div></div>
            <div class="pk-control-step pk-control-human"><i class="ri-user-follow-line"></i><div><strong>3. @(tr ? "Kullanıcı karar verir" : "The user decides")</strong><span>@(tr ? "Mesaj hazırlamak, Campaign oluşturmak, Journey başlatmak veya hiç aksiyon almamak kullanıcı tercihidir." : "Preparing a message, creating a Campaign, starting a Journey or taking no action remains a user choice.")</span></div></div>
            <div class="pk-control-step"><i class="ri-send-plane-2-line"></i><div><strong>4. @(tr ? "Pika kontrollü yürütür" : "Pika executes with control")</strong><span>@(tr ? "İzin, kanal uygunluğu, hedef kitle ve yayınlama kuralları aksiyon katmanında uygulanır." : "Consent, channel eligibility, audience and publishing rules are applied at execution.")</span></div></div>
        </div>
    </div>
</section>

<section class="pk-section pk-section-xl pk-section-soft">
    <div class="pk-container">
        <div class="pk-section-head"><div><span class="pk-eyebrow">Campaign + Journey</span><h2>@(tr ? "Tek seferlik aksiyondan sürekli müşteri akışına." : "From one-time action to ongoing customer flows.")</h2></div><p class="pk-lead">@(tr ? "Her fırsat aynı yürütme biçimini gerektirmez. Campaign Manager tanımlı bir hedef kitle ve zaman için; Journey Manager ise tetikleyici, koşul, bekleme ve aksiyonlardan oluşan sürekli senaryolar için kullanılır." : "Not every opportunity needs the same execution model. Campaign Manager handles defined audience-and-time execution, while Journey Manager handles ongoing trigger, condition, wait and action flows.")</p></div>
        <div class="pk-gallery">
            <div class="pk-gallery-main"><img src="/wiki/assets/images/img_journey-tasarim-tuvali_18.png" alt="@(tr ? "Pika Journey tasarım tuvali" : "Pika Journey design canvas")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Journey Manager</small><h3>Trigger → Condition → Wait → Action</h3><p>@(tr ? "Müşteri davranışına veya iş kuralına bağlı sürekli akışlar tasarlayın; uygun noktada Email, SMS, WhatsApp veya desteklenen diğer aksiyonları çalıştırın." : "Design ongoing flows based on customer behavior or business rules and execute supported channel actions at the right step.")</p></div></div>
            <div class="pk-gallery-side"><img src="/wiki/assets/images/img_yayinlama-sablon-ve-yonetim_27.png" alt="@(tr ? "Pika kampanya yayınlama ve yönetim ekranı" : "Pika campaign publishing and management screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Campaign Manager</small><h3>@(tr ? "Tanımlı hedef kitle, içerik ve zamanlama" : "Defined audience, content and schedule")</h3><p>@(tr ? "Fırsattan veya segmentten gelen hedef kitleyi kontrollü bir kampanyaya dönüştürün." : "Turn an opportunity or segment into a controlled campaign.")</p></div></div>
        </div>
        <div class="pk-channel-grid">
            <a class="pk-channel" href="@(tr ? "/kanallar/email" : "/en/channels/email")"><i class="ri-mail-line"></i><h3>Email</h3><p>@(tr ? "Zengin içerik, kişiselleştirilmiş mesaj ve ölçülebilir etkileşim için." : "For rich content, personalized messaging and measurable engagement.")</p><span>@(tr ? "Email'i inceleyin →" : "Explore Email →")</span></a>
            <a class="pk-channel" href="@(tr ? "/kanallar/sms" : "/en/channels/sms")"><i class="ri-message-2-line"></i><h3>SMS</h3><p>@(tr ? "Kısa, doğrudan ve zaman duyarlı iletişim için." : "For concise, direct and time-sensitive communication.")</p><span>@(tr ? "SMS'i inceleyin →" : "Explore SMS →")</span></a>
            <a class="pk-channel" href="@(tr ? "/kanallar/whatsapp" : "/en/channels/whatsapp")"><i class="ri-whatsapp-line"></i><h3>WhatsApp</h3><p>@(tr ? "Uygun izin ve şablon bağlamında yüksek görünürlüklü mesajlaşma için." : "For high-visibility messaging within appropriate consent and template context.")</p><span>@(tr ? "WhatsApp'ı inceleyin →" : "Explore WhatsApp →")</span></a>
            <a class="pk-channel" href="@(tr ? "/kanallar/push" : "/en/channels/push")"><i class="ri-notification-3-line"></i><h3>Push</h3><p>@(tr ? "Uygulama içi veya desteklenen push senaryolarında anlık aksiyon için." : "For immediate action in supported app and push scenarios.")</p><span>@(tr ? "Push'ı inceleyin →" : "Explore Push →")</span></a>
        </div>
    </div>
</section>

<section class="pk-section pk-section-xl">
    <div class="pk-container">
        <div class="pk-section-head"><div><span class="pk-eyebrow">@(tr ? "AI ve ölçüm" : "AI and measurement")</span><h2>@(tr ? "AI açıklamayı hızlandırır. Ölçüm gerçeği gösterir." : "AI speeds up explanation. Measurement shows reality.")</h2></div><p class="pk-lead">@(tr ? "Pika'da AI ile deterministik hesaplamalar birbirine karıştırılmaz. AI özet, açıklama ve içerik hazırlamada yardımcı olabilir; sonuç değerlendirmesi ise gerçek gönderim, etkileşim ve desteklenen satış/attribution verisine dayanır." : "Pika keeps AI and deterministic calculations distinct. AI can assist with summaries, explanations and content, while evaluation relies on observed delivery, engagement and supported sales/attribution data.")</p></div>
        <div class="pk-insight-split">

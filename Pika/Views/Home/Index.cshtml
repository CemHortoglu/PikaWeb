@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var isTr = culture == "tr";
    ViewData["BodyClass"] = "pika-home-v2 pika-orbit";
}
@section Styles {
    <link href="~/css/pika-orbit.css" rel="stylesheet" asp-append-version="true" />
}
<section class="pw2-hero-insider orbit-hero" id="hero">
    <div class="orbit-grid" aria-hidden="true"></div>
    <div class="orbit-shell">
        <div class="orbit-copy">
            <div class="orbit-kicker"><span></span> AI CUSTOMER ANALYTICS</div>
            <h1>@(isTr ? "Her müşterinin" : "Every customer")<br />@(isTr ? "bir sonraki" : "has a next")<br /><em>@(isTr ? "adımını keşfedin." : "move. Find it.")</em></h1>
            <p>@(isTr ? "Verinizin içindeki fırsatları görün. Müşterinizi anlayın, doğru anı yakalayın ve her etkileşimi anlamlı bir ilişkiye dönüştürün." : "Find the opportunities in your data. Understand your customers, meet the moment, and turn every interaction into a meaningful relationship.")</p>
            <div class="orbit-actions">
                <button class="orbit-button" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">@(isTr ? "Pika ile tanışın" : "Meet Pika") <span>↗</span></button>
                <a class="orbit-tour" href="#calisma-modeli"><span>↓</span> @(isTr ? "Nasıl çalışır?" : "How it works")</a>
            </div>
            <div class="orbit-caption">@(isTr ? "Müşteri zekâsı. Doğru zaman. Gerçek bağ." : "Customer intelligence. Right timing. Real connection.")</div>
        </div>
        <div class="orbit-scene is-intro" role="img" aria-label="@(isTr ? "Müşteri verisi, fırsat ve iletişim arasında dönen animasyonlu veri yörüngesi. Örnek senaryo." : "Animated data orbit connecting customer insight, opportunity and communication. Illustrative scenario.")">
            <canvas id="pika-orbit-canvas" aria-hidden="true"></canvas>
            <div class="orbit-core" aria-hidden="true"><span class="orbit-mark"></span><span>pika<span class="orbit-core-dot">.</span></span><small>INTELLIGENCE IN MOTION</small></div>
            <div class="orbit-label orbit-label-top">01 / @(isTr ? "ANLA" : "UNDERSTAND")</div>
            <div class="orbit-label orbit-label-bottom">02 / @(isTr ? "KEŞFET" : "DISCOVER")</div>
            <div class="pw2-hero-console-card orbit-card orbit-customer" data-opp-target="2"><span class="orbit-tether-socket" aria-hidden="true"></span><span class="orbit-avatar">D</span><div><small>PIKA 360</small><strong>@(isTr ? "Bir müşteriden fazlası." : "More than a customer.")</strong><span>@(isTr ? "Tercihler · Davranışlar · Potansiyel" : "Preferences · Behavior · Potential")</span></div><span class="orbit-card-status">↗</span><div class="orbit-card-progress" aria-hidden="true"><span class="orbit-card-progress-bar"></span></div></div>
            <div class="pw2-float-badge orbit-card orbit-opportunity" data-opp-target="1"><span class="orbit-tether-socket" aria-hidden="true"></span><div class="orbit-op-icon">✳</div><div><small>@(isTr ? "FIRSAT TESPİT EDİLDİ" : "OPPORTUNITY IDENTIFIED")</small><strong>@(isTr ? "Yeniden alışveriş zamanı." : "Time to shop again.")</strong><div class="orbit-meter"><span></span></div><span>@(isTr ? "İhtiyaç oluştuğunda, siz oradasınız." : "Be there when the need arises.")</span></div><div class="orbit-card-progress" aria-hidden="true"><span class="orbit-card-progress-bar"></span></div></div>
            <div class="orbit-card orbit-message" data-opp-target="0"><span class="orbit-tether-socket" aria-hidden="true"></span><i class="ri-whatsapp-line" aria-hidden="true"></i><div><small>@(isTr ? "DOĞRU KANAL, DOĞRU AN" : "RIGHT CHANNEL, RIGHT MOMENT")</small><strong>@(isTr ? "Merhaba Deniz 👋" : "Hello Deniz 👋")</strong><span>@(isTr ? "Sizin için seçtiğimiz öneriler var." : "We have some ideas just for you.")</span></div><div class="orbit-card-progress" aria-hidden="true"><span class="orbit-card-progress-bar"></span></div></div>
            <span class="orbit-example">@(isTr ? "Örnek müşteri senaryosu" : "Illustrative customer scenario")</span>
        </div>
    </div>
    <div class="orbit-bottom"><span>DATA INTO UNDERSTANDING. UNDERSTANDING INTO ACTION.</span><a href="#firsatlar">@(isTr ? "KEŞFETMEYE DEVAM EDİN" : "KEEP EXPLORING") ↓</a></div>
</section>


@* ── Channel & Capability Ribbon ── *@
<div class="pw2-trust-ribbon">
    <div class="pw2-container pw2-container--wide">
        <div class="pw2-trust-ribbon__items">
            <div class="pw2-trust-ribbon__item">
                <div class="pw2-trust-ribbon__icon"><i class="ri-whatsapp-line" aria-hidden="true"></i></div>
                <div>
                    <div class="fw-bold">WhatsApp Business API</div>
                    <div class="small text-white-50">@(isTr ? "Resmi Meta API Altyapısı" : "Official Meta API")</div>
                </div>
            </div>
            <div class="pw2-trust-ribbon__item">
                <div class="pw2-trust-ribbon__icon"><i class="ri-mail-send-line" aria-hidden="true"></i></div>
                <div>
                    <div class="fw-bold">Email &amp; SMS</div>
                    <div class="small text-white-50">@(isTr ? "Doğrulanmış İcra Kanalları" : "Verified Execution Channels")</div>
                </div>
            </div>
            <div class="pw2-trust-ribbon__item">
                <div class="pw2-trust-ribbon__icon"><i class="ri-focus-3-line" aria-hidden="true"></i></div>
                <div>
                    <div class="fw-bold">Pika Opportunity Engine</div>
                    <div class="small text-white-50">@(isTr ? "Günlük Algoritmik Tespit" : "Daily Algorithmic Discovery")</div>
                </div>
            </div>
            <div class="pw2-trust-ribbon__item">
                <div class="pw2-trust-ribbon__icon"><i class="ri-shield-check-line" aria-hidden="true"></i></div>
                <div>
                    <div class="fw-bold">İYS &amp; KVKK</div>
                    <div class="small text-white-50">@(isTr ? "Gönderim Öncesi İzin Denetimi" : "Pre-Dispatch Consent Verification")</div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ══════════════════════════════════════════════════════════════════════════
   CHAPTER 2: GÜNÜN FIRSATLARI (COMMERCIAL OPPORTUNITY ENGINE)
   ══════════════════════════════════════════════════════════════════════════ *@
<section class="pw2-section pw2-section--subtle" id="firsatlar">
    <div class="pw2-container">
        <div class="text-center mb-5" data-aos="fade-up">
            <div class="pw2-eyebrow">
                <i class="ri-focus-3-line" aria-hidden="true"></i>
                @(isTr ? "Günün Fırsatları (CCE)" : "Commercial Opportunity Engine")
            </div>
            <h2 class="pw2-h2">
                @(isTr ? "Veri çok. Doğru fırsat bir adım ötede." : "More data. Clearer opportunities.")
            </h2>
            <p class="pw2-lead mx-auto" style="max-width:760px">
                @(isTr ? "Pika'nın Commercial Opportunity Engine (CCE) algoritması; müşteri işlem geçmişi, ürün tüketim döngüleri ve sepet birlikteliklerini sürekli analiz ederek bugün kimin neye ihtiyacı olduğunu tespit eder." : "Pika's Commercial Opportunity Engine (CCE) continuously evaluates transaction logs, consumption rhythms, and basket affinities to pinpoint exactly who needs what today.")
            </p>
        </div>

        @* 4-Card Bento Grid *@
        <div class="pw2-cce-grid" data-aos="fade-up" data-aos-delay="100">
            @* 01. Repurchase Rhythm *@
            <div class="pw2-cce-card">
                <span class="pw2-cce-card__badge" style="background:#e0f2fe;color:#0369a1">01</span>
                <div class="pw2-cce-card__icon" style="background:#e0f2fe;color:#0284c7">
                    <i class="ri-repeat-line" aria-hidden="true"></i>
                </div>
                <h3 class="h5 fw-bold mb-2">@(isTr ? "Tekrar Satın Alma Ritmi" : "Repurchase Rhythm")</h3>
                <p class="small text-secondary mb-3">
                    @(isTr ? "Müşterinin geçmiş işlem sıklığına göre hesaplanan bireysel tüketim penceresinde (%80-%120), ihtiyaç tükenmeden önce zamanında hatırlatma." : "Individualized consumption windows (80%-120%) calculated algorithmically to trigger engagement before replenishment cycles lapse.")
                </p>
                <div class="pw2-cce-meter-bar">
                    <div class="pw2-cce-meter-fill" style="width:88%"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted">
                    <span>@(isTr ? "Tüketim İlerlemesi" : "Cycle Progress")</span>
                    <span class="fw-bold text-dark">%88</span>
                </div>
            </div>

            @* 02. Cross-Category Expansion *@
            <div class="pw2-cce-card">
                <span class="pw2-cce-card__badge" style="background:#fef3c7;color:#b45309">02</span>
                <div class="pw2-cce-card__icon" style="background:#fef3c7;color:#d97706">
                    <i class="ri-compass-3-line" aria-hidden="true"></i>
                </div>
                <h3 class="h5 fw-bold mb-2">@(isTr ? "Çapraz Kategori Genişleme" : "Cross-Category Expansion")</h3>
                <p class="small text-secondary mb-3">
                    @(isTr ? "Tek bir kategoriye bağlı kalan müşterilere, Need Group ve ürün rolü affinitesi yüksek tamamlayıcı kategorilerin önerilmesi." : "Introducing high-affinity complementary categories to single-category shoppers based on Need Group affinity matrices.")
                </p>
                <div class="pw2-cce-meter-bar">
                    <div class="pw2-cce-meter-fill" style="width:74%;background:linear-gradient(90deg,#d97706,#f59e0b)"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted">
                    <span>@(isTr ? "Need Group Uyumu" : "Need Group Affinity")</span>
                    <span class="fw-bold text-dark">%74</span>
                </div>
            </div>

            @* 03. Basket Complement *@
            <div class="pw2-cce-card">
                <span class="pw2-cce-card__badge" style="background:#f0fdf4;color:#15803d">03</span>
                <div class="pw2-cce-card__icon" style="background:#f0fdf4;color:#16a34a">
                    <i class="ri-shopping-basket-2-line" aria-hidden="true"></i>
                </div>
                <h3 class="h5 fw-bold mb-2">@(isTr ? "Sepet Tamamlama" : "Basket Association")</h3>
                <p class="small text-secondary mb-3">
                    @(isTr ? "Birlikte satın alma olasılığı kanıtlanmış ürün kombinasyonlarıyla ortalama sepet büyüklüğünü (AOV) artırma." : "Increasing average order value (AOV) with algorithmically proven co-purchase product associations.")
                </p>
                <div class="pw2-cce-meter-bar">
                    <div class="pw2-cce-meter-fill" style="width:95%;background:linear-gradient(90deg,#16a34a,#10b981)"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted">
                    <span>@(isTr ? "Sepet Birliktelik Gücü" : "Co-purchase Confidence")</span>
                    <span class="fw-bold text-dark">%95</span>
                </div>
            </div>

            @* 04. Churn Intervention *@
            <div class="pw2-cce-card">
                <span class="pw2-cce-card__badge" style="background:#fee2e2;color:#b91c1c">04</span>
                <div class="pw2-cce-card__icon" style="background:#fee2e2;color:#dc2626">
                    <i class="ri-alarm-warning-line" aria-hidden="true"></i>
                </div>
                <h3 class="h5 fw-bold mb-2">@(isTr ? "Kayıp Riski Müdahalesi" : "Churn Intervention")</h3>
                <p class="small text-secondary mb-3">
                    @(isTr ? "Alışveriş frekansı sapan ve kayıp eşiğine yaklaşan değerli müşterileri tespit edip, pasifleşmeden önce geri kazanma." : "Early detection of churn-risk customers when activity deviates from historical baselines before attrition becomes permanent.")
                </p>
                <div class="pw2-cce-meter-bar">
                    <div class="pw2-cce-meter-fill" style="width:82%;background:linear-gradient(90deg,#dc2626,#f43f5e)"></div>
                </div>
                <div class="d-flex justify-content-between small text-muted">
                    <span>@(isTr ? "Kurtarma Hassasiyeti" : "Retention Sensitivity")</span>
                    <span class="fw-bold text-dark">%82</span>
                </div>
            </div>
        </div>
    </div>
</section>

@* ══════════════════════════════════════════════════════════════════════════
   CHAPTER 3: OPERATING MODEL (DATA -> INTEL -> OPPORTUNITY)
   ══════════════════════════════════════════════════════════════════════════ *@
<section class="pw2-section scene-model" id="calisma-modeli">
 <div class="scene-halo" aria-hidden="true"></div>
 <div class="pw2-container scene-split">
  <div class="scene-story"><div class="pw2-eyebrow">01 — @(isTr ? "VERİDEN DEĞERE" : "DATA TO VALUE")</div>
   <h2>@(isTr ? "Her şey birbirine" : "Everything starts")<br/><em>@(isTr ? "bağlandığında." : "with connection.")</em></h2>
   <p>@(isTr ? "Mağazanız, e-ticaretiniz, müşteriniz. Pika tüm hikâyeyi bir araya getirir; sıradaki fırsatı görünür kılar." : "Your stores, your online business, your customers. Pika brings the whole story together to reveal the next opportunity.")</p>
   <div class="scene-steps">
    <button type="button" class="pw2-step-card active" data-scene-step="0" aria-pressed="true"><span>01</span><div><strong>@(isTr ? "Verinizi birleştirin" : "Connect your data")</strong><p>@(isTr ? "Her temas noktası, tek bir müşteri hikâyesi." : "Every touchpoint. One customer story.")</p></div><b>↗</b></button>
    <button type="button" class="pw2-step-card" data-scene-step="1" aria-pressed="false"><span>02</span><div><strong>@(isTr ? "Fırsatı keşfedin" : "Discover the opportunity")</strong><p>@(isTr ? "Kim, neye, ne zaman ihtiyaç duyuyor?" : "Who needs what, and when?")</p></div><b>↗</b></button>
    <button type="button" class="pw2-step-card" data-scene-step="2" aria-pressed="false"><span>03</span><div><strong>@(isTr ? "Doğru anda ulaşın" : "Meet the moment")</strong><p>@(isTr ? "İzinli kanallarda, kişiye özel bir deneyim." : "A personal experience, through consented channels.")</p></div><b>↗</b></button>
   </div>
  </div>
  <div class="pw2-pipeline-stage scene-network" data-network-step="0">
   <div class="network-orbit network-orbit-one" aria-hidden="true"></div><div class="network-orbit network-orbit-two" aria-hidden="true"></div>
   <div class="network-center"><span>pika<span>✳</span></span><small>INTELLIGENCE</small></div>
   <div class="network-node network-shop"><i class="ri-store-2-line" aria-hidden="true"></i><span>@(isTr ? "Mağaza" : "In-store")</span></div>
   <div class="network-node network-cart"><i class="ri-shopping-bag-3-line" aria-hidden="true"></i><span>E-commerce</span></div>
   <div class="network-node network-data"><i class="ri-database-2-line" aria-hidden="true"></i><span>CRM / ERP</span></div>
   <div class="network-node network-person"><i class="ri-user-heart-line" aria-hidden="true"></i><span>@(isTr ? "Müşteriniz" : "Your customer")</span></div>
   <div class="network-insight" aria-live="polite"><span class="network-spark">✳</span><div><small>@(isTr ? "BİRLEŞİK MÜŞTERİ GÖRÜNÜMÜ" : "UNIFIED CUSTOMER VIEW")</small><strong data-scene-title>@(isTr ? "Parçalar birleşir. Hikâye tamamlanır." : "The pieces connect. The story comes together.")</strong><p data-scene-description>@(isTr ? "Alışverişler, tercihler ve etkileşimler tek yerde." : "Purchases, preferences and interactions, together.")</p></div></div>
   <div class="scene-simulation">@(isTr ? "Platform çalışma modeli · Görsel anlatım" : "Platform workflow · Illustration")</div>
  </div>
 </div>
</section>


@* ══════════════════════════════════════════════════════════════════════════
   CHAPTER 4: TWIN INTELLIGENCE (CUSTOMER & PRODUCT)
   ══════════════════════════════════════════════════════════════════════════ *@
<section class="pw2-section intelligence-chapter" id="zeka-katmani">
 <div class="pw2-container"><div class="product-heading"><div><div class="pw2-eyebrow">@(isTr ? "Zekâ Katmanı" : "Intelligence Layer")</div><h2>@(isTr ? "Müşteriyi anlayın." : "Understand your customer.")<br/><em>@(isTr ? "Ürünle bağını keşfedin." : "Find the product connection.")</em></h2></div><p>@(isTr ? "Alışverişin iki tarafını birlikte görün. Müşterinin değişen ihtiyaçlarıyla ürünlerin taşıdığı potansiyeli buluşturun." : "See both sides of every purchase. Connect changing customer needs with the potential in your products.")</p></div>
 <div class="pw2-intel-grid intelligence-pair">
  <article class="pw2-intel-card intelligence-customer"><div class="intelligence-caption"><span>01 / CUSTOMER INTELLIGENCE</span><i class="ri-user-heart-line" aria-hidden="true"></i></div><h3>@(isTr ? "Her müşterinin" : "Every customer")<br/>@(isTr ? "kendine ait bir ritmi var." : "has their own rhythm.")</h3><p>@(isTr ? "Alışveriş alışkanlıklarını, müşteri değerini ve yeniden ihtiyaç duyulabilecek anı birlikte değerlendirin." : "Bring purchase habits, customer value and the next moment of need into focus.")</p>
   <div class="intelligence-visual rhythm-visual"><div class="rhythm-profile"><span>DK</span><div><strong>Deniz Kaya</strong><small>@(isTr ? "Örnek müşteri profili" : "Sample customer profile")</small></div><span class="rhythm-loyal">@(isTr ? "Sadık müşteri" : "Loyal customer")</span></div><div class="rhythm-overview"><div class="pw2-cvs-circle rhythm-score"><div><strong>84</strong><small>CVS / 100</small></div></div><div class="rhythm-value"><small>@(isTr ? "MÜŞTERİ DEĞERİ" : "CUSTOMER VALUE")</small><strong>@(isTr ? "İlişkinin gücünü görün." : "See the strength of the relationship.")</strong><span>@(isTr ? "Sıklık · Alışveriş tutarı · Sadakat" : "Frequency · Spend · Loyalty")</span></div></div><div class="rhythm-history"><div><small>@(isTr ? "ALIŞVERİŞ RİTMİ" : "PURCHASE RHYTHM")</small><span>@(isTr ? "Örnek zaman çizgisi" : "Illustrative timeline")</span></div><div class="rhythm-line" aria-hidden="true"><span></span><span></span><span></span><span class="rhythm-next"></span></div><div class="rhythm-dates"><span>01.04</span><span>01.05</span><span>31.05</span><span>@(isTr ? "Sıradaki an" : "Next moment")</span></div></div></div>
   <a class="intelligence-link" href="@(isTr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")">@(isTr ? "Müşteri zekâsını keşfedin" : "Explore customer intelligence") <span>↗</span></a>
  </article>
  <article class="pw2-intel-card intelligence-product"><div class="intelligence-caption"><span>02 / PRODUCT INTELLIGENCE</span><i class="ri-shopping-bag-3-line" aria-hidden="true"></i></div><h3>@(isTr ? "Bir ürünün ötesinde," : "Beyond one product,")<br/>@(isTr ? "yeni bir ihtiyaç var." : "there’s another need.")</h3><p>@(isTr ? "Birlikte tercih edilen ürünleri ve tamamlayıcı ihtiyaçları anlayın. Her öneriyi alışveriş bağlamıyla şekillendirin." : "Understand products purchased together and complementary needs. Shape every recommendation around purchase context.")</p>
   <div class="intelligence-visual affinity-visual"><div class="affinity-top"><span>@(isTr ? "ÜRÜN İLİŞKİLERİ" : "PRODUCT RELATIONSHIPS")</span><small>@(isTr ? "Örnek eşleştirme" : "Sample pairing")</small></div><div class="affinity-map"><div class="affinity-item"><div class="affinity-icon"><i class="ri-cup-line" aria-hidden="true"></i></div><small>@(isTr ? "ANA ÜRÜN" : "PRIMARY PRODUCT")</small><strong>@(isTr ? "Filtre kahve" : "Filter coffee")</strong></div><div class="affinity-connector" aria-hidden="true"><span></span><b>+</b><span></span></div><div class="affinity-item"><div class="affinity-icon affinity-icon-second"><i class="ri-filter-line" aria-hidden="true"></i></div><small>@(isTr ? "TAMAMLAYICI" : "COMPLEMENTARY")</small><strong>@(isTr ? "Kahve filtresi" : "Coffee filters")</strong></div></div><div class="affinity-insight"><span>✳</span><div><strong>@(isTr ? "Aynı ritüelin iki parçası." : "Two parts of the same ritual.")</strong><p>@(isTr ? "Ürün rolü ve birlikte alışveriş davranışı, ilgili öneriyi buluşturur." : "Product roles and co-purchase behavior inform a relevant suggestion.")</p></div></div></div>
   <a class="intelligence-link" href="@(isTr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")">@(isTr ? "Ürün zekâsını keşfedin" : "Explore product intelligence") <span>↗</span></a>
  </article>
 </div></div>
</section>


@* ══════════════════════════════════════════════════════════════════════════
   CHAPTER 5: PIKA 360 (UNIFIED CUSTOMER DECISION CONSOLE)
   ══════════════════════════════════════════════════════════════════════════ *@
<section class="pw2-section product-chapter" id="pika-360">
 <div class="pw2-container">
  <div class="product-heading"><div><div class="pw2-eyebrow">@(isTr ? "Bütünleşik Müşteri Konsolu" : "Unified Customer Console")</div><h2>@(isTr ? "Bir profilin arkasındaki" : "See the person")<br/><em>@(isTr ? "bütün hikâye." : "behind the profile.")</em></h2></div><p>@(isTr ? "Geçmiş alışverişler, bugünün ihtiyaçları ve bir sonraki fırsat. Müşterinizi anlamak için ihtiyacınız olan bağlam, tek bir görünümde." : "Past purchases, current needs and the next opportunity. The context you need to understand your customer, in one view.")</p></div>
  <div class="pw2-360-stage studio-console">
   <div class="studio-topbar"><span class="studio-brand">pika<span>✳</span></span><span>Workspace <b>/</b> Pika 360</span><small>@(isTr ? "Örnek ürün görünümü" : "Illustrative product view")</small></div>
   <div class="studio-body">
    <aside class="studio-profile"><div class="profile-portrait">CK</div><span class="studio-kicker">CUSTOMER PROFILE</span><h3>Caner Kaya</h3><span class="studio-status">@(isTr ? "Sadık müşteri" : "Loyal customer")</span><dl><dt>@(isTr ? "Müşteri olduğundan beri" : "Customer since")</dt><dd>2023</dd><dt>@(isTr ? "Tercih ettiği kanal" : "Preferred channel")</dt><dd><i class="ri-whatsapp-line" aria-hidden="true"></i> WhatsApp</dd><dt>@(isTr ? "İlgi alanı" : "Interest")</dt><dd>@(isTr ? "Kahve & yaşam" : "Coffee & lifestyle")</dd></dl><div class="profile-tags"><span>@(isTr ? "Mağaza" : "In-store")</span><span>E-commerce</span></div></aside>
    <div class="studio-detail"><div class="studio-detail-title"><h3>@(isTr ? "Müşteri özeti" : "Customer overview")</h3><span>@(isTr ? "Örnek veriler" : "Sample data")</span></div>
     <div class="studio-metrics"><div><small>@(isTr ? "Müşteri değer skoru" : "Customer value score")</small><strong>91<em>/100</em></strong><div class="score-track"><span></span></div></div><div><small>@(isTr ? "Toplam alışveriş" : "Total purchases")</small><strong>₺24.850</strong><span>@(isTr ? "Müşteri geçmişi" : "Customer history")</span></div><div><small>@(isTr ? "Son etkileşim" : "Last interaction")</small><strong>14 <em>@(isTr ? "gün" : "days")</em></strong><span>@(isTr ? "E-ticaret alışverişi" : "Online purchase")</span></div></div>
     <div class="studio-lower"><div class="studio-timeline"><h4>@(isTr ? "İlişkinin zaman çizgisi" : "Relationship timeline")</h4><div><i class="ri-shopping-bag-3-line" aria-hidden="true"></i><p><strong>@(isTr ? "Yeni bir favori" : "A new favorite")</strong><span>@(isTr ? "E-ticaret siparişi · ₺1.420" : "Online order · ₺1,420")</span></p><small>@(isTr ? "14 gün önce" : "14 days ago")</small></div><div><i class="ri-store-2-line" aria-hidden="true"></i><p><strong>@(isTr ? "Mağazada bir buluşma" : "An in-store visit")</strong><span>@(isTr ? "Bağdat Caddesi · ₺2.890" : "Bağdat Avenue · ₺2,890")</span></p><small>@(isTr ? "45 gün önce" : "45 days ago")</small></div></div>
     <div class="studio-opportunity"><span class="studio-kicker">✳ @(isTr ? "SIRADAKİ FIRSAT" : "NEXT OPPORTUNITY")</span><h4>@(isTr ? "Kahve ritmi devam etsin." : "Keep the coffee ritual going.")</h4><p>@(isTr ? "Alışveriş ritmine göre yeniden ihtiyaç duyabileceği zaman yaklaşıyor." : "Their purchase rhythm suggests the next replenishment window is approaching.")</p><a href="@(isTr ? "/platform/pika-360" : "/en/platform/pika-360")">@(isTr ? "Pika 360’ı keşfedin" : "Explore Pika 360") ↗</a></div></div>
    </div>
   </div>
  </div>
 </div>
</section>


@* ══════════════════════════════════════════════════════════════════════════
   CHAPTER 6: DECISION TO ACTION (OMNICHANNEL BENTO & PHONE FRAME)
   ══════════════════════════════════════════════════════════════════════════ *@
<section class="pw2-section scene-channels" id="aksiyon-ve-icra">
 <div class="channel-ribbon channel-ribbon-one" aria-hidden="true"></div><div class="channel-ribbon channel-ribbon-two" aria-hidden="true"></div>
 <div class="pw2-container">
  <div class="scene-channel-heading"><div class="pw2-eyebrow">02 — @(isTr ? "BAĞ KURUN" : "MAKE A CONNECTION")</div><h2>@(isTr ? "Doğru an." : "The right moment.")<br/><em>@(isTr ? "Size ait bir deneyim." : "An experience that’s yours.")</em></h2><p>@(isTr ? "WhatsApp, e-posta ve SMS. Tek bir yolculukta, müşterinizin tercih ettiği yerde buluşun." : "WhatsApp, email and SMS. One connected journey, wherever your customer prefers.")</p></div>
  <div class="pw2-omni-bento scene-channel-grid">
   <article class="channel-tile channel-whatsapp"><div class="channel-title"><i class="ri-whatsapp-line" aria-hidden="true"></i><span>WhatsApp</span><span>01</span></div><h3>@(isTr ? "Sohbet kadar doğal." : "As natural as a conversation.")</h3>
    <div class="pw2-phone-mockup"><div class="pw2-phone-speaker"></div><div class="pw2-phone-screen"><div class="pw2-wa-header"><span class="coffee-icon">☕</span><div><strong>PIKA COFFEE</strong><small>@(isTr ? "Örnek marka" : "Illustrative brand")</small></div></div><div class="coffee-art" aria-hidden="true"><div class="coffee-pack">pika<br/><small>DAILY BLEND</small><span>☕</span></div></div><div class="pw2-wa-bubble"><strong>@(isTr ? "Kahve molasına hazır mısın?" : "Ready for a coffee break?")</strong><p>@(isTr ? "Merhaba Deniz, favori kahvenle güne güzel bir başlangıç yap. ☀" : "Hi Deniz, start your day with your favorite coffee. ☀")</p></div><a class="pw2-wa-btn" href="@(isTr ? "/kanallar/whatsapp" : "/en/channels/whatsapp")">@(isTr ? "WhatsApp’ı keşfedin" : "Explore WhatsApp") ↗</a></div></div>
   </article>
   <article class="channel-tile channel-email"><div class="channel-title"><i class="ri-mail-line" aria-hidden="true"></i><span>E-mail</span><span>02</span></div><h3>@(isTr ? "Her açılışta ilham." : "Inspiration in every inbox.")</h3><div class="email-preview"><div class="email-chrome"><span>● ● ●</span><small>@(isTr ? "Sizin için seçtik" : "Picked for you")</small></div><div class="email-art"><span>THE EVERYDAY<br/>COLLECTION.</span><div class="product-sculpture" aria-hidden="true"></div></div><div class="email-copy"><small>PIKA STUDIO</small><h4>@(isTr ? "Tam sizin tarzınız." : "Just your style.")</h4><p>@(isTr ? "Sevdiğiniz detaylar. Yeni keşifler." : "The details you love. Something new.")</p><a href="@(isTr ? "/kanallar/email" : "/en/channels/email")">@(isTr ? "E-postayı keşfedin" : "Explore email") ↗</a></div></div></article>
   <article class="channel-tile channel-sms"><div class="channel-title"><i class="ri-message-2-line" aria-hidden="true"></i><span>SMS</span><span>03</span></div><h3>@(isTr ? "Az kelime. Güçlü bağ." : "A few words. A real connection.")</h3><div class="sms-preview"><div class="sms-clock">09:41</div><div class="sms-date">@(isTr ? "Güne güzel bir başlangıç" : "A good start to the day")</div><div class="sms-notification"><div><i class="ri-message-2-fill" aria-hidden="true"></i> MESSAGES <span>@(isTr ? "şimdi" : "now")</span></div><strong>PIKA</strong><p>@(isTr ? "Deniz, seni yeniden görmek güzel! Sana özel seçkimiz hazır. Yeni favorini birlikte keşfedelim." : "Deniz, it’s good to see you again! Your personal selection is ready. Find your next favorite.")</p></div></div><a class="sms-link" href="@(isTr ? "/kanallar/sms" : "/en/channels/sms")">@(isTr ? "SMS’i keşfedin" : "Explore SMS") ↗</a></article>
  </div>
  <div class="channel-journey"><span>✳</span><div><strong>@(isTr ? "Ayrı kanallar. Birlikte çalışan bir yolculuk." : "Individual channels. One connected journey.")</strong><p>@(isTr ? "İzin kontrolleri ve gönderim zaman pencereleriyle, her adım kontrolünüzde." : "Consent checks and quiet-hours dispatch windows keep every step under your control.")</p></div><a href="@(isTr ? "/cozumler/journey-manager" : "/en/solutions/journey-manager")">Journey Manager ↗</a></div>
 </div>
</section>


@* ══════════════════════════════════════════════════════════════════════════
   CHAPTER 7: PIKA PILOT AI (LUMINOUS GROUNDED AI COPILOT)
   ══════════════════════════════════════════════════════════════════════════ *@
<section class="pw2-section pilot-chapter" id="pika-pilot">
 <div class="pw2-container pilot-layout"><div class="pilot-story"><div class="pw2-eyebrow">@(isTr ? "Grounded AI Kampanya Asistanı" : "Grounded AI Campaign Assistant")</div><h2>@(isTr ? "Fikrinizden" : "From your idea")<br/><em>@(isTr ? "ilk taslağa." : "to the first draft.")</em></h2><p>@(isTr ? "Pika Pilot, müşterilerinizi ve ürünlerinizi tanıyan kampanya asistanınız. Hedefinizi söyleyin; kitle, içerik ve kanal önerisini birlikte değerlendirin." : "Pika Pilot is your campaign assistant, grounded in your customers and products. Start with your goal, then review audience, content and channel suggestions together.")</p><div class="pilot-principle"><span>01</span><div><strong>@(isTr ? "Sizin verinizle düşünür." : "Grounded in your data.")</strong><p>@(isTr ? "Ürün kataloğu ve müşteri geçmişinden bağlam alır." : "Uses your catalog and customer history as context.")</p></div></div><div class="pilot-principle"><span>02</span><div><strong>@(isTr ? "Son karar sizindir." : "You make the final call.")</strong><p>@(isTr ? "Öneriler incelemenize sunulur; onayınızla ilerler." : "Suggestions are prepared for your review and approval.")</p></div></div><a class="pilot-explore" href="@(isTr ? "/urunler/ai-kampanya-asistani" : "/en/products/ai-campaign-assistant")">@(isTr ? "Pika Pilot ile tanışın" : "Meet Pika Pilot") ↗</a></div>
  <div class="pw2-ai-terminal pilot-workspace"><div class="pilot-toolbar"><span>✳ <strong>Pika Pilot</strong></span><small>@(isTr ? "Örnek kampanya taslağı" : "Sample campaign draft")</small></div><div class="pilot-workspace-body"><div class="pw2-ai-prompt-box pilot-request"><span class="pilot-user">C</span><p>@(isTr ? "Bir süredir alışveriş yapmayan kahve müşterilerimiz için bir geri kazanım kampanyası hazırlayalım." : "Let’s prepare a win-back campaign for coffee customers who haven’t shopped recently.")</p></div><div class="pilot-context"><span>✓ @(isTr ? "Ürün kataloğu" : "Product catalog")</span><span>✓ @(isTr ? "Müşteri geçmişi" : "Customer history")</span></div><div class="pilot-answer"><div class="pilot-answer-label">✳ PIKA PILOT</div><h3>@(isTr ? "Bir fincanla yeniden başlayalım." : "Let’s reconnect over a cup.")</h3><p>@(isTr ? "Kahve kategorisinde alışveriş yapmış, tekrar alışveriş zamanı yaklaşan müşteriler için bir taslak." : "A draft for customers who have purchased coffee and may be approaching their next purchase.")</p><div class="pilot-draft-meta"><div><small>@(isTr ? "HEDEF KİTLE" : "AUDIENCE")</small><strong>@(isTr ? "Yeniden alışveriş fırsatı" : "Repeat purchase opportunity")</strong></div><div><small>@(isTr ? "KANAL ÖNERİSİ" : "CHANNEL SUGGESTION")</small><strong>WhatsApp · E-mail</strong></div></div><div class="pilot-message-draft"><small>@(isTr ? "MESAJ TASLAĞI" : "MESSAGE DRAFT")</small><p>@(isTr ? "Merhaba, kahve molalarını özledik. Sevdiğin lezzetler ve keşfetmeni istediğimiz yeni favoriler seni bekliyor. ☕" : "Hello, we’ve missed our coffee breaks. Your favorite flavors and a few new discoveries are waiting for you. ☕")</p></div><div class="pilot-review"><span><i class="ri-shield-check-line" aria-hidden="true"></i> @(isTr ? "İnceleme ve onay bekliyor" : "Awaiting review and approval")</span><span>@(isTr ? "Taslak" : "Draft")</span></div></div></div></div>
 </div>
</section>


@* ══════════════════════════════════════════════════════════════════════════
   CHAPTER 8: MEASUREMENT & GOVERNANCE (DARK PETROL TELEMETRY)
   ══════════════════════════════════════════════════════════════════════════ *@
<section class="pw2-section measurement-chapter" id="yonetisim-ve-olcumleme">
 <div class="pw2-container"><div class="measurement-heading"><div class="pw2-eyebrow">@(isTr ? "Ölçümleme ve Yönetişim" : "Measurement & Governance")</div><h2>@(isTr ? "Etkiyi görün." : "See the impact.")<br/><em>@(isTr ? "Kontrolü koruyun." : "Stay in control.")</em></h2><p>@(isTr ? "İletişiminiz nereye ulaşıyor, hangi alışverişlerle ilişkileniyor? Sonuçları açıkça izleyin; her adımı izinler ve erişim kurallarıyla yönetin." : "Where does your communication reach, and which purchases are associated with it? Follow the results clearly, with consent and access controls at every step.")</p></div>
 <div class="measurement-layout"><div class="pw2-telemetry-stage measurement-report"><div class="report-heading"><div><span class="studio-kicker">PIKA ANALYTICS</span><h3>@(isTr ? "İletişimden alışverişe" : "From communication to purchase")</h3></div><small>@(isTr ? "Örnek rapor · 30 gün" : "Sample report · 30 days")</small></div><div class="report-summary"><div><small>@(isTr ? "İlişkilendirilen ciro" : "Attributed revenue")</small><strong>₺84.250</strong></div><span>@(isTr ? "Temaslarla ilişkili siparişler" : "Orders associated with touchpoints")</span></div>
 <div class="report-chart" role="img" aria-label="@(isTr ? "Örnek ilişkilendirilen ciro grafiği, gün 1 ile gün 30 arası. Gerçek müşteri sonucu değildir." : "Sample attributed revenue chart for days 1 to 30. Not an actual customer result.")"><div class="chart-scale"><span>30k</span><span>20k</span><span>10k</span><span>0</span></div><svg viewBox="0 0 600 200" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="measurementFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#829e45" stop-opacity=".3"/><stop offset="100%" stop-color="#829e45" stop-opacity="0"/></linearGradient></defs><path d="M0 20H600 M0 75H600 M0 130H600 M0 185H600" stroke="#e3e8dc" stroke-width="1"/><path d="M0 164 C35 164 45 124 80 132 S135 170 170 118 S220 150 265 96 S320 125 355 78 S425 112 465 52 S550 82 600 25 V200 H0Z" fill="url(#measurementFill)"/><path d="M0 164 C35 164 45 124 80 132 S135 170 170 118 S220 150 265 96 S320 125 355 78 S425 112 465 52 S550 82 600 25" fill="none" stroke="#68863c" stroke-width="3"/></svg><div class="chart-days"><span>01</span><span>10</span><span>20</span><span>30</span></div></div>
 <div class="report-channels"><div><span class="channel-dot"></span>WhatsApp<strong>₺42.100</strong></div><div><span class="channel-dot dot-email"></span>E-mail<strong>₺28.750</strong></div><div><span class="channel-dot dot-sms"></span>SMS<strong>₺13.400</strong></div></div><p class="report-note">@(isTr ? "Gösterim amaçlı veriler. İlişkilendirme, satışın yalnızca kampanyadan kaynaklandığını göstermez." : "Illustrative data. Attribution does not establish that a campaign alone caused a sale.")</p></div>
 <div class="governance-panel"><span class="governance-symbol"><i class="ri-shield-check-line" aria-hidden="true"></i></span><span class="studio-kicker">@(isTr ? "GÜVEN, TASARIMIN BİR PARÇASI." : "TRUST, BUILT IN.")</span><h3>@(isTr ? "Her adımda" : "At every step,")<br/>@(isTr ? "sizin kurallarınız." : "your rules.")</h3><div class="governance-row"><span>01</span><div><h4>@(isTr ? "İzinli iletişim" : "Consented communication")</h4><p>@(isTr ? "Gönderim öncesi izin ve vazgeçme kontrolleri." : "Consent and opt-out checks before dispatch.")</p></div></div><div class="governance-row"><span>02</span><div><h4>@(isTr ? "Doğru zaman aralığı" : "The right time window")</h4><p>@(isTr ? "Gönderim zaman pencereleri ve iletişim sınırları." : "Quiet-hours dispatch window and communication limits.")</p></div></div><div class="governance-row"><span>03</span><div><h4>@(isTr ? "Görünür işlem geçmişi" : "A visible activity history")</h4><p>@(isTr ? "Rol bazlı erişim, veri ayrımı ve işlem kayıtları." : "Role-based access, data isolation and activity records.")</p></div></div><a href="@(isTr ? "/guvenlik-ve-gizlilik" : "/en/security-and-privacy")">@(isTr ? "Güvenlik yaklaşımımız" : "Our approach to security") ↗</a></div></div>
 </div>
</section>



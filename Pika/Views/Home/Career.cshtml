@using Microsoft.Extensions.Options
@using Pika.Configuration
@inject IOptions<SiteSettings> SiteOptions
@{
    var site = SiteOptions.Value;
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var isTr = culture == "tr";
}

<!-- ───── 01 HERO ───── -->
<section class="inner-hero inner-hero--team">
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(isTr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(isTr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <span>@(isTr ? "Kariyer" : "Careers")</span>
            </nav>
            <div class="inner-eyebrow"><span></span>@(isTr ? "KARİYER" : "CAREERS")</div>
            <h1>@(isTr ? "Pika'yı geliştiren işe katkı sunmak istiyorsanız, genel başvurunuzu paylaşın." : "If you want to contribute to the work behind Pika, submit a general application.")</h1>
            <p>@(isTr ? "Pika; müşteri, ürün ve satış verisini anlamlandırarak ticari fırsatları kontrollü omnichannel aksiyona bağlayan bir müşteri zekâsı ve pazarlama platformudur." : "Pika is a customer intelligence and marketing platform that connects customer, product and sales data to commercial opportunities and controlled omnichannel action.")</p>
            <p class="text-secondary" style="font-size:15px;line-height:1.75;margin-top:-10px;margin-bottom:28px;">@(isTr ? "Bu sayfa belirli bir açık pozisyon listesi yayınlamak yerine, Pika'nın ürün ve problem alanlarını anlamanız ve kariyer için genel başvurunuzu paylaşmanız amacıyla hazırlanmıştır." : "Instead of presenting an unverified list of open positions, this page explains Pika's product and problem context and provides a general career-application path.")</p>
            <div class="inner-actions">
                <a class="inner-primary" href="#career-application">@(isTr ? "Genel Başvuru Yap" : "Submit a General Application") ↗</a>
                <a class="inner-secondary" href="@(isTr ? "/pika" : "/en/pika")">@(isTr ? "Pika'yı Keşfedin" : "Explore Pika") →</a>
                <a class="inner-hero-anchor" href="#inner-content" aria-label="@(isTr ? "İçeriğe atla" : "Skip to content")">
                    <i class="ri-arrow-down-line" aria-hidden="true"></i>
                </a>
            </div>
        </div>
        <div class="inner-scene" aria-label="@(isTr ? "Platformun çalışma biçimini anlatan örnek görünüm" : "Illustrative view of how the platform works")">
            <div class="inner-scene-orbit" aria-hidden="true"></div>
            <div class="inner-scene-window">
                <div class="inner-window-bar">
                    <strong>pika<span>✳</span></strong>
                    <span>@(isTr ? "Pika'da Kariyer" : "Careers at Pika")</span>
                    <small>@(isTr ? "Örnek görünüm" : "Illustration")</small>
                </div>
                <div class="inner-knowledge" aria-hidden="true" style="padding:48px 29px;min-height:220px;display:flex;align-items:center;justify-content:center;gap:28px;">
                    <i class="ri-lightbulb-line" style="font-size:32px;color:#78955b;" aria-hidden="true"></i>
                    <i class="ri-code-s-slash-line" style="font-size:32px;color:#78955b;" aria-hidden="true"></i>
                    <i class="ri-team-line" style="font-size:32px;color:#78955b;" aria-hidden="true"></i>
                </div>
            </div>
        </div>
    </div>
</section>
<div id="inner-content" class="inner-anchor"></div>

<!-- ───── 02 DIRECT ANSWER ───── -->
<section class="pika-section" style="background:#f4f7ed;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="pika-corp-shell p-4 p-md-5">
                    <span class="pika-eyebrow">@(isTr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
                    <h2 class="pika-h2 mt-2 mb-3">@(isTr ? "Pika'ya kariyer için nasıl başvurabilirsiniz?" : "How can you apply to Pika?")</h2>
                    <p class="text-secondary mb-3" style="font-size:16px;line-height:1.8;">
                        @(isTr
                            ? "Aşağıdaki genel başvuru formunda temel iletişim bilgilerinizi paylaşabilir; CV veya LinkedIn bağlantınızı ekleyebilir ve katkı sunmak istediğiniz çalışma bağlamını kısa notunuzda anlatabilirsiniz."
                            : "Use the general application form below to share your basic contact information, add a CV or LinkedIn link and briefly explain the kind of work context in which you would like to contribute.")
                    </p>
                    <div class="p-3 mb-3" style="background:#edf4e0;border:1px solid rgba(128,148,139,.24);border-radius:4px;">
                        <strong class="d-block text-dark" style="font-size:14px;">
                            @(isTr ? "Bu form belirli bir açık pozisyona otomatik başvuru anlamına gelmez." : "Submitting this form does not mean applying automatically to a specific open position.")
                        </strong>
                    </div>
                    <p class="small text-muted mb-0">
                        @(isTr
                            ? "Genel başvuru, Pika ile kariyer bağlamında iletişim kurmanın başlangıç noktasıdır."
                            : "A general application is the starting point for career-related contact with Pika.")
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ───── 03 WHAT PIKA BUILDS ───── -->
<section class="pika-section" style="background:#fff;">
    <div class="container">
        <div class="text-center mb-5">
            <span class="pika-eyebrow">@(isTr ? "ÜRÜN BAĞLAMI" : "PRODUCT CONTEXT")</span>
            <h2 class="pika-h2 mx-auto" style="max-width:820px;">
                @(isTr
                    ? "Veriden anlayışa, anlayıştan kontrollü aksiyona uzanan bir ürün üzerinde çalışıyoruz."
                    : "We work on a product chain that moves from data to understanding and understanding to controlled action.")
            </h2>
            <p class="text-secondary mx-auto mt-3" style="max-width:720px;font-size:16px;line-height:1.8;">
                @(isTr
                    ? "Pika'nın ürün problemi yalnızca mesaj göndermek değildir."
                    : "Pika's product problem is not merely sending messages.")
            </p>
        </div>

        <div class="row g-4 justify-content-center mb-5">
            <div class="col-lg-6">
                <div class="pika-career-card h-100">
                    <div class="pika-career-card__icon mb-3"><i class="ri-brain-line"></i></div>
                    <p class="text-secondary mb-0">
                        @(isTr
                            ? "Platform müşteri, ürün ve işlem verisini intelligence katmanlarında anlamlandırır; fırsat, audience, içerik, campaign ve journey kararlarını ayrı ürün sorumluluklarıyla yönetir."
                            : "The platform interprets customer, product and transaction data through intelligence layers and keeps opportunity, audience, content, campaign and journey responsibilities explicit.")
                    </p>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="pika-career-card h-100">
                    <div class="pika-career-card__icon mb-3" style="background:#e8f5e9;color:#2e7d32;"><i class="ri-shield-check-line"></i></div>
                    <p class="text-secondary mb-0">
                        @(isTr
                            ? "Email, SMS ve WhatsApp kontrollü iletişimin execution kanallarıdır; consent, security ve measurement ise ayrı kontrol ve değerlendirme katmanlarıdır."
                            : "Email, SMS and WhatsApp are execution channels for controlled communication, while consent, security and measurement remain separate control and evaluation layers.")
                    </p>
                </div>
            </div>
        </div>

        <div class="p-4 p-md-5 rounded border" style="background:#f9fbf6;border-color:#dce5d3!important;">
            <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 text-center font-monospace" style="font-size:13px;font-weight:600;color:#253e20;">
                <span class="px-3 py-2 bg-white rounded border border-light-subtle shadow-sm">DATA</span>
                <span>→</span>
                <span class="px-3 py-2 bg-white rounded border border-light-subtle shadow-sm">INTELLIGENCE</span>
                <span>→</span>
                <span class="px-3 py-2 bg-white rounded border border-light-subtle shadow-sm">OPPORTUNITY / DECISION</span>
                <span>→</span>
                <span class="px-3 py-2 bg-white rounded border border-light-subtle shadow-sm">AUDIENCE / CONTENT</span>
                <span>→</span>
                <span class="px-3 py-2 bg-white rounded border border-light-subtle shadow-sm">CAMPAIGN / JOURNEY</span>
                <span>→</span>
                <span class="px-3 py-2 bg-white rounded border border-light-subtle shadow-sm">CONTROLLED CHANNEL ACTION</span>
                <span>→</span>
                <span class="px-3 py-2 bg-white rounded border border-light-subtle shadow-sm">MEASUREMENT</span>
            </div>
            <p class="text-center text-muted small mt-4 mb-0">
                @(isTr
                    ? "Ürün problemi, tek bir ekran değil, birbirine bağlı karar ve kontrol katmanlarıdır."
                    : "The product problem is not one screen. It is a connected set of decision and control layers.")
            </p>
        </div>
    </div>
</section>

<!-- ───── 04 WORKING PRINCIPLES ───── -->
<section class="pika-section" style="background:#f8faf4;">
    <div class="container">
        <div class="text-center mb-5">
            <span class="pika-eyebrow">@(isTr ? "ÇALIŞMA YAKLAŞIMI" : "WORKING PRINCIPLES")</span>
            <h2 class="pika-h2">@(isTr ? "Üründe değer verdiğimiz bazı temel ilkeler." : "Some of the principles we value in the product.")</h2>
            <p class="text-secondary mx-auto" style="max-width:620px;">
                @(isTr
                    ? "İyi ürün, yalnızca daha fazla özellik değil, daha açık sorumluluk ve daha güvenilir davranıştır."
                    : "Good product work is not only more features. It also means clearer responsibility and more reliable behavior.")
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="pika-career-card h-100">
                    <div class="pika-career-card__icon"><i class="ri-scales-3-line"></i></div>
                    <h3>@(isTr ? "Kanıt" : "Evidence")</h3>
                    <p>@(isTr ? "Ürün yeteneklerini ve sonuçlarını kanıtlanabilir bağlamdan ayırmamaya çalışıyoruz." : "We aim to keep product capability and outcome claims tied to evidence that can be supported.")</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="pika-career-card h-100">
                    <div class="pika-career-card__icon" style="background:#e8f5e9;color:#2e7d32;"><i class="ri-node-tree"></i></div>
                    <h3>@(isTr ? "Açık Sorumluluk" : "Explicit Responsibility")</h3>
                    <p>@(isTr ? "Intelligence, audience, campaign, journey, consent, channel ve measurement görevlerini tek bir belirsiz otomasyon katmanında eritmemeyi önemsiyoruz." : "We avoid collapsing intelligence, audience, campaign, journey, consent, channel and measurement responsibilities into one ambiguous automation layer.")</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="pika-career-card h-100">
                    <div class="pika-career-card__icon" style="background:#fff3e0;color:#ef6c00;"><i class="ri-user-settings-line"></i></div>
                    <h3>@(isTr ? "İnsan Kontrolü" : "Human Control")</h3>
                    <p>@(isTr ? "AI yardımını kullanıcı kararının veya kaynak gerçeğin yerine koymayan ürün yaklaşımını koruyoruz." : "We preserve a product approach where AI assistance does not replace user decisions or source truth.")</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="pika-career-card h-100">
                    <div class="pika-career-card__icon" style="background:#e3f2fd;color:#1565c0;"><i class="ri-shield-keyhole-line"></i></div>
                    <h3>@(isTr ? "Güvenilirlik" : "Reliability")</h3>
                    <p>@(isTr ? "Veri, izin, erişim ve iletişim execution sınırlarını ürün davranışının parçası olarak ele alıyoruz." : "We treat data, permission, access and communication-execution boundaries as part of product behavior.")</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ───── 05 GENERAL APPLICATION MODEL ───── -->
<section class="pika-section" style="background:#fff;">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="pika-eyebrow">@(isTr ? "GENEL BAŞVURU" : "GENERAL APPLICATION")</span>
                <h2 class="pika-h2 mt-2 mb-3">@(isTr ? "Açık pozisyon varsaymadan başvurunuzu paylaşın." : "Share your application without assuming an open position.")</h2>
                <p class="text-secondary mb-3" style="font-size:15px;line-height:1.8;">
                    @(isTr
                        ? "C23 doğrulanmamış açık pozisyon listesi yayınlamaz."
                        : "C23 does not publish an unverified list of open positions.")
                </p>
                <p class="text-secondary mb-3" style="font-size:15px;line-height:1.8;">
                    @(isTr
                        ? "Genel başvuru formu; yazılım, veri, ürün, tasarım, pazarlama veya başka bir çalışma bağlamında Pika'ya katkı sunmak istediğinizi paylaşmanız için kullanılabilir."
                        : "The general application form can be used to express interest in contributing to Pika through software, data, product, design, marketing or another work context.")
                </p>
                <p class="text-secondary mb-4" style="font-size:15px;line-height:1.8;">
                    @(isTr
                        ? "Başvurunun gönderilmesi görüşme, teklif veya işe alım garantisi oluşturmaz."
                        : "Submitting an application does not guarantee an interview, offer or employment.")
                </p>
                <p class="small text-muted mb-0">
                    @(isTr
                        ? "Gerçek pozisyon ihtiyacı ve aday eşleşmesi ayrı değerlendirme konusudur."
                        : "Actual role requirements and candidate fit are separate evaluation questions.")
                </p>
            </div>
            <div class="col-lg-6">
                <div class="p-4 rounded border" style="background:#f4f7ed;border-color:#dce5d3!important;">
                    <ul class="list-unstyled mb-0">
                        <li class="py-2 border-bottom d-flex gap-2">
                            <i class="ri-check-line text-success fs-5 flex-shrink-0" aria-hidden="true"></i>
                            <span class="text-secondary">@(isTr ? "CV / LinkedIn: opsiyonel destekleyici bilgi" : "CV / LinkedIn: optional supporting information")</span>
                        </li>
                        <li class="py-2 border-bottom d-flex gap-2">
                            <i class="ri-check-line text-success fs-5 flex-shrink-0" aria-hidden="true"></i>
                            <span class="text-secondary">@(isTr ? "PDF CV: en fazla 5 MB" : "PDF CV: maximum 5 MB")</span>
                        </li>
                        <li class="py-2 d-flex gap-2">
                            <i class="ri-check-line text-success fs-5 flex-shrink-0" aria-hidden="true"></i>
                            <span class="text-secondary">@(isTr ? "İletişim bilgileri: başvuru değerlendirmesi için kullanılır" : "Contact information: used for application evaluation")</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ───── 06 APPLICATION FORM ───── -->
<section class="pika-section pika-corp-section" id="career-application">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="pika-corp-shell">
                    <div class="text-center mb-4">
                        <span class="pika-eyebrow">@(isTr ? "KARİYER BAŞVURUSU" : "CAREER APPLICATION")</span>
                        <h2 class="pika-h2 mt-2">@(isTr ? "Genel başvurunuzu paylaşın." : "Submit your general application.")</h2>
                        <p class="text-secondary">
                            @(isTr
                                ? "Temel iletişim bilgilerinizi paylaşın. CV veya LinkedIn bağlantısı ekleyebilir ve kısa notunuzda katkı sunmak istediğiniz çalışma bağlamından bahsedebilirsiniz."
                                : "Share your basic contact information. You can add a CV or LinkedIn link and use the short note to explain the kind of work context in which you would like to contribute.")
                        </p>
                    </div>
                    <form id="careerForm" class="row g-3" enctype="multipart/form-data">
                        <input type="hidden" name="position" value="General Application" />
                        <div class="col-md-6">
                            <label class="form-label" for="career-full-name">@(isTr ? "Ad Soyad" : "Full Name") <span class="text-danger">*</span></label>
                            <input class="form-control pika-input" id="career-full-name" name="fullName" placeholder="@(isTr ? "Adınız ve soyadınız" : "Your full name")" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="career-email">@(isTr ? "E-posta" : "Email") <span class="text-danger">*</span></label>
                            <input type="email" class="form-control pika-input" id="career-email" name="email" placeholder="@(isTr ? "mail@adres.com" : "name@company.com")" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="career-phone">@(isTr ? "Telefon" : "Phone") <span class="text-danger">*</span></label>
                            <input class="form-control pika-input" id="career-phone" name="phone" placeholder="5XX XXX XX XX" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="career-cv-url">@(isTr ? "CV / LinkedIn Bağlantısı" : "CV / LinkedIn Link")</label>
                            <input class="form-control pika-input" id="career-cv-url" name="cvUrl" placeholder="https://linkedin.com/in/...">
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="career-cv-file">@(isTr ? "CV Yükle" : "Upload CV") <span class="text-muted small">(@(isTr ? "PDF, en fazla 5 MB" : "PDF, maximum 5 MB"))</span></label>
                            <input type="file" class="form-control pika-input" id="career-cv-file" name="cvFile" accept=".pdf">
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="career-message">@(isTr ? "Kısa Not" : "Short Note")</label>
                            <textarea class="form-control pika-input" id="career-message" rows="4" name="message" placeholder="@(isTr ? "Kendinizden ve katkı sunmak istediğiniz çalışma bağlamından kısaca bahsedin." : "Briefly introduce yourself and the kind of work context in which you would like to contribute.")"></textarea>
                        </div>
                        <div class="col-12">
                            <p class="small text-muted mb-3">
                                @if (isTr) {
                                    @:Gönderdiğiniz bilgiler kariyer başvurunuzu değerlendirmek ve sizinle bu başvuru hakkında iletişim kurmak amacıyla kullanılır. Detaylar için <a href="/gizlilik-politikasi">Gizlilik Politikası'nı</a> inceleyin.
                                } else {
                                    @:The information you submit is used to evaluate your career application and communicate with you about it. See the <a href="/en/privacy-policy">Privacy Policy</a> for details.
                                }
                            </p>
                            <button type="submit" class="btn pika-btn-primary w-100">
                                <i class="ri-send-plane-line me-2"></i>@(isTr ? "Genel Başvuruyu Gönder" : "Submit General Application")
                            </button>
                        </div>
                        <div id="careerResult" class="pika-alert d-none mt-2" role="status" aria-live="polite" aria-atomic="true"></div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ───── 07 FAQ ───── -->
<section class="pika-section" style="background:#f8faf4;">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="pika-h2">@(isTr ? "Sıkça Sorulan Sorular" : "Frequently Asked Questions")</h2>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="d-flex flex-column gap-3">
                    <details class="pika-career-faq-details p-3 bg-white rounded border" style="border-color:#dce5d3!important;">
                        <summary class="fw-semibold text-dark" style="cursor:pointer;">
                            @(isTr ? "Pika şu anda hangi açık pozisyonlar için işe alım yapıyor?" : "Which roles is Pika currently hiring for?")
                        </summary>
                        <p class="text-secondary mt-2 mb-0" style="font-size:15px;line-height:1.75;">
                            @(isTr
                                ? "C23 doğrulanmış bir açık pozisyon listesi yayınlamaz. Bu sayfadaki form genel kariyer başvurusu içindir. Belirli pozisyonlar public olarak yayınlanırsa ayrıca belirtilmelidir."
                                : "C23 does not publish a verified list of open positions. The form on this page is for general career applications. Any specific public vacancies should be identified separately if they are published.")
                        </p>
                    </details>
                    <details class="pika-career-faq-details p-3 bg-white rounded border" style="border-color:#dce5d3!important;">
                        <summary class="fw-semibold text-dark" style="cursor:pointer;">
                            @(isTr ? "Genel başvuru yapabilir miyim?" : "Can I submit a general application?")
                        </summary>
                        <p class="text-secondary mt-2 mb-0" style="font-size:15px;line-height:1.75;">
                            @(isTr
                                ? "Evet. Form, belirli bir pozisyon varsaymadan Pika ile kariyer bağlamında iletişim kurmanız için genel başvuru kanalıdır."
                                : "Yes. The form provides a general career-application path without assuming a specific open role.")
                        </p>
                    </details>
                    <details class="pika-career-faq-details p-3 bg-white rounded border" style="border-color:#dce5d3!important;">
                        <summary class="fw-semibold text-dark" style="cursor:pointer;">
                            @(isTr ? "CV yüklemek zorunlu mu?" : "Is uploading a CV required?")
                        </summary>
                        <p class="text-secondary mt-2 mb-0" style="font-size:15px;line-height:1.75;">
                            @(isTr
                                ? "Hayır. CV dosyası ve CV / LinkedIn bağlantısı opsiyoneldir. PDF dosyası yüklenecekse en fazla 5 MB olmalıdır."
                                : "No. The CV file and CV / LinkedIn link are optional. If a PDF CV is uploaded, it must be no larger than 5 MB.")
                        </p>
                    </details>
                    <details class="pika-career-faq-details p-3 bg-white rounded border" style="border-color:#dce5d3!important;">
                        <summary class="fw-semibold text-dark" style="cursor:pointer;">
                            @(isTr ? "Hangi bilgiler zorunludur?" : "Which information is required?")
                        </summary>
                        <p class="text-secondary mt-2 mb-0" style="font-size:15px;line-height:1.75;">
                            @(isTr
                                ? "Ad Soyad, E-posta ve Telefon alanları zorunludur. Form teknik olarak Genel Başvuru türüyle gönderilir."
                                : "Full Name, Email and Phone are required. The form is technically submitted as a General Application.")
                        </p>
                    </details>
                    <details class="pika-career-faq-details p-3 bg-white rounded border" style="border-color:#dce5d3!important;">
                        <summary class="fw-semibold text-dark" style="cursor:pointer;">
                            @(isTr ? "Başvuru yaptıktan sonra görüşme garantisi var mı?" : "Does submitting an application guarantee an interview?")
                        </summary>
                        <p class="text-secondary mt-2 mb-0" style="font-size:15px;line-height:1.75;">
                            @(isTr
                                ? "Hayır. Genel başvurunun gönderilmesi görüşme, teklif veya işe alım garantisi oluşturmaz."
                                : "No. Submitting a general application does not guarantee an interview, offer or employment.")
                        </p>
                    </details>
                    <details class="pika-career-faq-details p-3 bg-white rounded border" style="border-color:#dce5d3!important;">
                        <summary class="fw-semibold text-dark" style="cursor:pointer;">
                            @(isTr ? "Başvuru değerlendirmesi için sabit bir süre var mı?" : "Is there a fixed application-review timeline?")
                        </summary>
                        <p class="text-secondary mt-2 mb-0" style="font-size:15px;line-height:1.75;">
                            @(isTr
                                ? "C23 kamuya açık sayfası başvurular için sabit değerlendirme veya geri dönüş süresi taahhüt etmez."
                                : "The C23 public page does not promise a fixed review or response timeline for applications.")
                        </p>
                    </details>
                </div>
            </div>
        </div>
    </div>
</section>


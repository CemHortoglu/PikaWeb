@using Microsoft.Extensions.Options
@using Pika.Configuration
@inject IOptions<SiteSettings> SiteOptions
@{
    var site = SiteOptions.Value;
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var isTr = culture == "tr";
    ViewData["Title"] = isTr ? "İletişim | Pika" : "Contact Us | Pika";
    ViewData["MetaDescription"] = isTr ? "Pika ekibiyle iletişime geçin. Satış, destek ve iş birliği talepleriniz için bize ulaşın." : "Get in touch with the Pika team for sales, support, and partnership inquiries.";
}
@section Styles {
    <link href="~/css/pika-contact.css" rel="stylesheet" asp-append-version="true" />
}
<div class="contact-page">
 <section class="contact-opening">
  <div class="contact-aura" aria-hidden="true"></div>
  <div class="container contact-grid">
   <div class="contact-intro">
    <nav class="contact-breadcrumb" aria-label="@(isTr ? "Sayfa yolu" : "Breadcrumb")"><a href="@(isTr ? "/" : "/en/")">Pika</a><span>/</span><span>@(isTr ? "İletişim" : "Contact")</span></nav>
    <div class="contact-eyebrow"><span></span> @(isTr ? "TANIŞMAKLA BAŞLAYALIM" : "LET’S START WITH HELLO")</div>
    <h1>@(isTr ? "İyi bir ilişki," : "A good relationship")<br/><em>@(isTr ? "bir merhabayla başlar." : "starts with hello.")</em></h1>
    <p>@(isTr ? "Aklınızda bir soru, yeni bir fikir ya da birlikte büyütebileceğimiz bir iş var mı? Sizi dinlemek isteriz." : "Have a question, a new idea, or an opportunity to grow together? We’d love to hear from you.")</p>
    <div class="contact-direct">
     <a href="mailto:@site.Contact.SupportEmail"><span class="contact-icon"><i class="ri-mail-line" aria-hidden="true"></i></span><span><small>@(isTr ? "BİZE YAZIN" : "WRITE TO US")</small><strong>@site.Contact.SupportEmail</strong></span><b aria-hidden="true">↗</b></a>
     <a href="tel:@site.Contact.SupportPhone"><span class="contact-icon"><i class="ri-phone-line" aria-hidden="true"></i></span><span><small>@(isTr ? "BİZİ ARAYIN" : "GIVE US A CALL")</small><strong>@site.Contact.SupportPhoneDisplay</strong></span><b aria-hidden="true">↗</b></a>
    </div>
    <div class="contact-signature"><span aria-hidden="true">✳</span><span>@(isTr ? "Veriden içgörüye. Tanışmadan iş birliğine." : "From data to insight. From hello to collaboration.")</span></div>
   </div>
   <div class="contact-form-panel">
    <div class="contact-form-heading"><span>@(isTr ? "SÖZ SİZDE" : "OVER TO YOU")</span><h2>@(isTr ? "Nasıl yardımcı olabiliriz?" : "How can we help?")</h2><p>@(isTr ? "İhtiyacınızı kısaca paylaşın. Ekibimiz sizinle iletişime geçsin." : "Tell us a little about what you need. Our team will get in touch.")</p></div>
    <form id="contactForm" data-recipient-email="@site.Mail.ContactFormRecipientEmail" class="contact-form">
     <div class="contact-fields"><div><label for="contact-full-name">@(isTr ? "Ad soyad" : "Full name") <span>*</span></label><input id="contact-full-name" class="form-control" name="fullName" autocomplete="name" placeholder="@(isTr ? "Adınız ve soyadınız" : "Your full name")" required></div><div><label for="contact-email">@(isTr ? "E-posta adresi" : "Email address") <span>*</span></label><input id="contact-email" class="form-control" name="email" type="email" autocomplete="email" placeholder="@(isTr ? "siz@firmaniz.com" : "you@company.com")" required></div></div>
     <div><label for="contact-message">@(isTr ? "Mesajınız" : "Your message") <span>*</span></label><textarea id="contact-message" class="form-control" name="message" rows="8" style="min-height: 200px;" placeholder="@(isTr ? "Sorunuzdan, hedefinizden veya birlikte neler yapabileceğimizden bahsedin…" : "Tell us about your question, your goals, or what we could do together…")" required></textarea></div>
     <p class="contact-privacy"><i class="ri-lock-line" aria-hidden="true"></i><span>@(isTr ? "Bilgilerinizin işlenmesi hakkında " : "Learn how we handle your information in our ")<a href="@(isTr ? "/gizlilik-politikasi" : "/en/privacy-policy")">@(isTr ? "Gizlilik Politikası’nı" : "Privacy Policy")</a>@(isTr ? " inceleyebilirsiniz." : ".")</span></p>
     <button type="submit" class="contact-submit">@(isTr ? "Mesajı gönder" : "Send message") <span aria-hidden="true">↗</span></button>
     <div id="contactResult" class="pika-alert d-none" role="status" aria-live="polite" aria-atomic="true"></div>
    </form>
   </div>
  </div>
 </section>
 <section class="contact-next">
  <div class="container contact-next-grid">
   <div class="contact-location"><div class="contact-section-label">01 / @(isTr ? "İLETİŞİM NOKTAMIZ" : "WHERE TO FIND US")</div><h2>@(isTr ? "Dijital bağlar," : "Digital connections,")<br/>@(isTr ? "gerçek bir ekip." : "a real team.")</h2><address><i class="ri-map-pin-line" aria-hidden="true"></i><span>@site.Contact.Address</span></address>
    @if (!string.IsNullOrWhiteSpace(site.Contact.MapEmbedUrl)) {
     <div class="contact-map"><iframe title="@(isTr ? "Pika ofis konumu" : "Pika office location")" src="@site.Contact.MapEmbedUrl" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
    }
   </div>
   <aside class="contact-demo"><span class="contact-demo-symbol" aria-hidden="true">✳</span><div class="contact-section-label">02 / @(isTr ? "PIKA’YI YAKINDAN TANIYIN" : "GET TO KNOW PIKA")</div><h2>@(isTr ? "Sizin veriniz." : "Your data.")<br/><em>@(isTr ? "Sizin büyüme hikâyeniz." : "Your growth story.")</em></h2><p>@(isTr ? "Müşteri zekâsından kişiye özel iletişime, Pika’nın işletmeniz için neler yapabileceğini birlikte keşfedelim." : "From customer intelligence to personal communication, let’s explore what Pika can do for your business.")</p><button type="button" data-bs-toggle="modal" data-bs-target="#demoModal">@(isTr ? "Bir demo planlayalım" : "Let’s plan a demo") <span aria-hidden="true">↗</span></button></aside>
  </div>
 </section>
</div>

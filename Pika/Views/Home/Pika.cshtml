                        <div class="accordion-body">
                            @if (tr)
                            {
                                <text>Günün Fırsatları, müşteri ve ürün bağlamından tekrar satın alma, cross-sell ve win-back gibi değerlendirilebilir ticari fırsatları görünür hale getiren Pika karar katmanıdır.</text>
                            }
                            else
                            {
                                <text>Daily Opportunities is the Pika decision layer that makes evaluable commercial opportunities such as repeat purchase, cross-sell and win-back visible from customer and product context.</text>
                            }
                        </div>
                    </div>
                </div>

                @* FAQ 8 *@
                <div class="accordion-item pika-accordion-item">
                    <h3 class="accordion-header" id="faqHeading8">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faqCollapse8" aria-expanded="false" aria-controls="faqCollapse8">

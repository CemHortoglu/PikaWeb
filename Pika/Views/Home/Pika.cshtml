@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]=tr?"Pika Nedir? | Müşteri ve Ürün Zekâsından Doğru Aksiyona":"What is Pika? | From Intelligence to the Right Action";
    ViewData["MetaDescription"]=tr?"Pika'nın veri, Customer Intelligence, Product Intelligence, Pika 360, Günün Fırsatları, Audience, Campaign, Journey, kanallar ve Analytics katmanlarını tek karar zincirinde nasıl birleştirdiğini görün.":"See how Pika connects data, Customer Intelligence, Product Intelligence, Pika 360, Daily Opportunities, Audience, Campaign, Journey, channels and Analytics into one decision chain.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">Doğru Anda · @(tr?"Pika Nedir?":"What is Pika?")</span><h1>@(tr?"Pika, veriyi müşteriyi anlamaya; anlamı doğru aksiyona bağlar.":"Pika connects data to customer understanding, and understanding to the right action.")</h1><p>@(tr?"Pika; müşteri, ürün, satış ve etkileşim verisini aynı karar bağlamında birleştirerek hangi müşteride hangi fırsatın oluştuğunu görünür kılan ve bu fırsatı yönetilebilir Audience, Campaign, Journey ve kanal aksiyonlarına bağlayan müşteri ve ürün zekâsı platformudur.":"Pika is a customer and product intelligence platform that brings customer, product, sales and engagement data into one decision context, surfaces opportunities and connects them to manageable Audience, Campaign, Journey and channel actions.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Pika'yı Canlı Görün":"See Pika Live")</button><a class="pk-btn pk-btn-ghost" href="/wiki/pika-nedir">@(tr?"Bilgi Bankasında Okuyun":"Read in Knowledge Base")</a></div><div class="pk-hero-note"><i class="ri-compass-3-line"></i><span>@(tr?"Pika'nın başlangıç noktası mesaj göndermek değil; müşteriyi, ürünü ve fırsatın nedenini anlamaktır." : "Pika starts by understanding customers, products and the reason behind an opportunity — not by sending messages.")</span></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_gunun-firsatlari.png" alt="@(tr?"Pika Günün Fırsatları ekranı":"Pika Daily Opportunities screen")" width="1200" height="760" /><div class="pk-stage-caption"><strong>Pika</strong><span>@(tr?"Intelligence → Fırsat → Karar → Aksiyon":"Intelligence → Opportunity → Decision → Action")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-user-search-line"></i><div><strong>Customer Intelligence</strong><small>@(tr?"Müşteriyi anla":"Understand the customer")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-shopping-bag-3-line"></i><div><strong>Product Intelligence</strong><small>@(tr?"Ürünü anla":"Understand the product")</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-sparkling-2-line"></i><div><strong>@(tr?"Günün Fırsatları":"Daily Opportunities")</strong><small>@(tr?"Şimdi ne yapmalı?":"What should happen now?")</small></div></div></div></div></section>

<div class="pk-capability-strip"><div class="pk-container"><span class="pk-capability-item">Customer Intelligence</span><span class="pk-capability-item">Product Intelligence</span><span class="pk-capability-item">Pika 360</span><span class="pk-capability-item">@(tr?"Günün Fırsatları":"Daily Opportunities")</span><span class="pk-capability-item">Audience</span><span class="pk-capability-item">Campaign / Journey</span><span class="pk-capability-item">Analytics</span></div></div>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Doğru kategori":"The right category")</span><h2>@(tr?"Pika tek bir yazılım kategorisine sığmaz.":"Pika does not fit neatly into one software category.")</h2></div><p class="pk-lead">@(tr?"Pika yalnız CRM, yalnız BI, yalnız marketing automation, yalnız mesaj gönderim altyapısı veya yalnız AI değildir. Bu alanların belirli görevlerini müşteriyi ve ürünü anlamaktan başlayıp ölçülebilir aksiyona uzanan tek karar sisteminde birleştirir.":"Pika is not simply CRM, BI, marketing automation, messaging infrastructure or AI. It connects specific jobs from these areas into one decision system that starts with customer/product understanding and ends in measurable action.")</p></div><div class="pk-intel-grid"><article class="pk-intel-panel"><span class="pk-intel-number">01</span><div class="pk-intel-icon"><i class="ri-contacts-line"></i></div><h3>@(tr?"CRM'den farklı":"Beyond a classic CRM")</h3><p>@(tr?"'Bu müşteri kim?' sorusuyla yetinmez; gerçekleşmiş işlem ve davranıştan 'bu müşteri bize ne anlatıyor?' sorusuna yaklaşır." : "It goes beyond 'who is this customer?' toward 'what does observed behavior tell us?'")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">02</span><div class="pk-intel-icon"><i class="ri-bar-chart-2-line"></i></div><h3>@(tr?"BI'dan farklı":"Beyond reporting alone")</h3><p>@(tr?"Ne olduğunu göstermekle kalmaz; desteklenen sinyallerden hangi durumun aksiyon düşünmeye değer olduğunu görünür kılar." : "It goes beyond showing what happened by surfacing supported situations worth considering for action.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">03</span><div class="pk-intel-icon"><i class="ri-send-plane-line"></i></div><h3>@(tr?"Gönderimden önce":"Before delivery")</h3><p>@(tr?"Email, SMS, WhatsApp ve Push karar zincirinin sonundaki iletişim kanallarıdır. Pika'nın asıl değeri bu kanala gelmeden önce neden, kime ve ne zaman sorularını açıklamasındadır." : "Email, SMS, WhatsApp and Push are communication channels near the end of the decision chain. Pika's value begins earlier by explaining why, who and when.")</p></article></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Pika'nın ürün haritası":"Pika product map")</span><h2>@(tr?"Menüler değil, tek bir karar sistemi.":"Not a collection of menus — one decision system.")</h2></div><p class="pk-lead">@(tr?"Bir Pika senaryosu çoğu zaman birden fazla modülü kullanır. Veri gelir, müşteri ve ürün anlaşılır, fırsat görünür olur, kullanıcı karar verir, Campaign/Journey uygular ve Analytics sonucu ölçer.":"A Pika use case often spans multiple modules. Data arrives, customers and products are understood, an opportunity becomes visible, the user decides, Campaign/Journey executes and Analytics measures the outcome.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-database-2-line"></i><strong>@(tr?"Veri":"Data")</strong><span>@(tr?"Müşteri · Ürün · Satış · Etkileşim":"Customer · Product · Sales · Engagement")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-radar-line"></i><strong>@(tr?"Anlama":"Understanding")</strong><span>Customer Intelligence · Product Intelligence · Pika 360</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Fırsat":"Opportunity")</strong><span>@(tr?"Günün Fırsatları":"Daily Opportunities")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-user-follow-line"></i><strong>@(tr?"Karar":"Decision")</strong><span>@(tr?"Kullanıcı kanıtı değerlendirir":"User reviews evidence")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-route-line"></i><strong>@(tr?"Aksiyon":"Action")</strong><span>Audience · Content · Campaign · Journey · Channels</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>@(tr?"Ölçüm":"Measurement")</strong><span>Analytics · BI · @(tr?"sonuç":"outcome")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Pika neyi anlar?":"What does Pika understand?")</span><h2>@(tr?"Müşteri davranışını ürün bağlamından koparmayın.":"Do not separate customer behavior from product context.")</h2></div><p class="pk-lead">@(tr?"Müşterinin ne zaman tekrar alacağı sorusu yalnız müşteri tarihçesiyle; cross-sell sorusu yalnız ürün ilişkisiyle; geri kazanım sorusu yalnız geçen gün sayısıyla açıklanamaz. Pika farklı intelligence katmanlarını gerektiğinde aynı iş sorusunda birleştirir.":"Repeat purchase cannot be explained by customer history alone, cross-sell by product relationships alone or win-back by elapsed days alone. Pika combines relevant intelligence layers around the business question.")</p></div><div class="pk-intel-grid"><article class="pk-intel-panel"><span class="pk-intel-number">01</span><div class="pk-intel-icon"><i class="ri-user-search-line"></i></div><h3>Customer Intelligence</h3><p>@(tr?"Gerçekleşmiş alışveriş, müşteri değeri, satın alma ritmi, davranış değişimi ve risk/fırsat sinyallerini açıklanabilir müşteri bağlamına dönüştürür." : "Turns observed purchases, customer value, purchase rhythm, behavioral change and risk/opportunity signals into explainable customer context.")</p><a class="pk-text-link" href="@(tr?"/platform/customer-intelligence":"/en/platform/customer-intelligence")">@(tr?"İnceleyin":"Explore") <i class="ri-arrow-right-line"></i></a></article><article class="pk-intel-panel"><span class="pk-intel-number">02</span><div class="pk-intel-icon"><i class="ri-shopping-bag-3-line"></i></div><h3>Product Intelligence</h3><p>@(tr?"Kategori, Need Group, Product Role, tekrar tüketim ve satın alma ilişkilerini ürünün ticari anlamı haline getirir." : "Turns category, Need Group, Product Role, repeat consumption and purchase relationships into commercial product meaning.")</p><a class="pk-text-link" href="@(tr?"/platform/product-intelligence":"/en/platform/product-intelligence")">@(tr?"İnceleyin":"Explore") <i class="ri-arrow-right-line"></i></a></article><article class="pk-intel-panel"><span class="pk-intel-number">03</span><div class="pk-intel-icon"><i class="ri-focus-2-line"></i></div><h3>Pika 360</h3><p>@(tr?"Profil, işlem, segment, davranış, fırsat ve aksiyon bağlamını tek müşteri üzerinde birlikte okumayı kolaylaştırır." : "Makes profile, transaction, segment, behavior, opportunity and action context readable around one customer.")</p><a class="pk-text-link" href="@(tr?"/platform/pika-360":"/en/platform/pika-360")">@(tr?"İnceleyin":"Explore") <i class="ri-arrow-right-line"></i></a></article></div><div class="pk-gallery" style="margin-top:28px"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_pika-360_7.png" alt="@(tr?"Pika 360 müşteri karar ekranı":"Pika 360 customer decision screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Pika 360</small><h3>@(tr?"Tek müşteride bütün karar bağlamı":"Decision context around one customer")</h3><p>@(tr?"Müşteri profili tek başına değil; işlem, segment, fırsat ve iletişim geçmişiyle birlikte okunur." : "The profile is read together with transactions, segments, opportunities and communication history.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_urun-siniflandirma-workbench_13.png" alt="Product Intelligence" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Product Intelligence</small><h3>@(tr?"Ürüne ticari anlam kazandırın":"Give products commercial meaning")</h3><p>@(tr?"Ürün eşleme ve sınıflandırması fırsatın nedenini daha açıklanabilir hale getirir." : "Product resolution and classification make opportunity reasoning more explainable.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-opportunity-showcase"><div class="pk-opportunity-panel"><div class="pk-product-window"><div class="pk-product-window-header"><div><i></i><i></i><i></i></div><span>@(tr?"Pika · Günün Fırsatları":"Pika · Daily Opportunities")</span></div><img src="/wiki/assets/images/img_gunun-firsatlari.png" alt="@(tr?"Pika Günün Fırsatları ürün ekranı":"Pika Daily Opportunities product screen")" loading="lazy" width="1200" height="760" /></div></div><div class="pk-opportunity-copy"><span class="pk-eyebrow">@(tr?"Pika ne bulur?":"What does Pika surface?")</span><h2>@(tr?"Rapor değil, aksiyona aday durumlar.":"Not just reports — situations worth considering for action.")</h2><p class="pk-lead">@(tr?"Günün Fırsatları, hesaplanmış müşteri ve ürün sinyallerini yöneticinin günlük karar alanına taşır. Tekrar satın alma, geri kazanım ve desteklenen ürün ilişkileri gibi durumlar ancak yeterli bağlam ve veri olduğunda görünür olur; fırsatın oluşması otomatik mesaj gönderimi değildir.":"Daily Opportunities brings calculated customer and product signals into the manager's daily decision workspace. Repeat purchase, win-back and supported product-relationship situations surface only when relevant context exists; an opportunity is not automatic messaging.")</p><div class="pk-signal-list"><div class="pk-signal"><div class="pk-signal-icon"><i class="ri-refresh-line"></i></div><div><strong>@(tr?"Tekrar satın alma":"Repeat purchase")</strong><span>@(tr?"Müşterinin kendi alışveriş ritmi + ürün bağlamı." : "Customer purchase rhythm + product context.")</span></div><span class="pk-signal-tag">Rhythm</span></div><div class="pk-signal"><div class="pk-signal-icon"><i class="ri-user-unfollow-line"></i></div><div><strong>@(tr?"Geri kazanım":"Win-back")</strong><span>@(tr?"Normal davranıştan uzaklaşma + değer/risk bağlamı." : "Behavioral drift + value/risk context.")</span></div><span class="pk-signal-tag">Risk</span></div><div class="pk-signal"><div class="pk-signal-icon"><i class="ri-links-line"></i></div><div><strong>Cross-sell</strong><span>@(tr?"Ürün birlikteliği kanıtı + müşteri bağlamı." : "Product co-purchase evidence + customer context.")</span></div><span class="pk-signal-tag">Product</span></div></div><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/gunun-firsatlari":"/en/platform/opportunities")">@(tr?"Günün Fırsatları'nı inceleyin":"Explore Daily Opportunities")</a></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">@(tr?"Kararı kim verir?":"Who decides?")</span><h2>@(tr?"Pika öneriyi görünür kılar; kullanıcı kontrolü korur.":"Pika makes the option visible while preserving user control.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Bir sinyalin oluşması otomatik mesaj gönderilmesi anlamına gelmez. Kullanıcı fırsatın nedenini ve müşterinin bağlamını değerlendirir; uygun olduğunda hedef kitle, içerik, Campaign/Journey yaklaşımı ve kanal seçilir. Hiç aksiyon almamak da geçerli karardır.":"A signal does not automatically send a message. The user reviews the reason and customer context, then selects audience, content, Campaign/Journey approach and channel when appropriate. Taking no action is also a valid decision.")</p></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-radar-line"></i><div><strong>@(tr?"Pika hesaplar/bulur":"Pika calculates/surfaces")</strong><span>@(tr?"Gerçek veri ve desteklenen analitik bağlamından sinyal üretir." : "Produces signals from observed data and supported analytics.")</span></div></div><div class="pk-control-step"><i class="ri-file-search-line"></i><div><strong>@(tr?"Kanıt görünür olur":"Evidence is visible")</strong><span>@(tr?"Kullanıcı 'neden?' sorusunun cevabını mümkün olduğunca görür." : "The user can see the answer to 'why?' where supported.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-user-follow-line"></i><div><strong>@(tr?"Kullanıcı karar verir":"The user decides")</strong><span>@(tr?"Öncelik, marka ve müşteri ilişkisine göre aksiyon seçilir." : "Action is chosen according to priority, brand and customer relationship.")</span></div></div><div class="pk-control-step"><i class="ri-route-line"></i><div><strong>@(tr?"Pika yürütür":"Pika executes")</strong><span>@(tr?"Audience, Campaign, Journey ve kanallar kontrollü aksiyon katmanıdır." : "Audience, Campaign, Journey and channels form the controlled execution layer.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Aksiyona geçin":"Take action")</span><h2>@(tr?"Tek seferlik kampanyadan sürekli müşteri akışına.":"From one-off campaigns to continuous customer flows.")</h2></div><p class="pk-lead">@(tr?"Audience Manager hedef kitleyi seçer; Content Studio içeriği hazırlar; Campaign Manager tanımlı kampanyayı yürütür; Journey Manager tetikleyici, karar ve zaman adımlarıyla sürekli akışları yönetir. Email, SMS, WhatsApp ve Push bu kararların iletişim kanallarıdır.":"Audience Manager selects the audience; Content Studio prepares content; Campaign Manager executes defined campaigns; Journey Manager manages ongoing flows with triggers, decisions and timing. Email, SMS, WhatsApp and Push are communication channels for those decisions.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-filter-3-line"></i><strong>Audience</strong><span>@(tr?"Kime?":"Who?")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-file-edit-line"></i><strong>Content</strong><span>@(tr?"Ne söyleyeceğiz?":"What will we say?")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-megaphone-line"></i><strong>Campaign</strong><span>@(tr?"Tanımlı kampanya":"Defined campaign")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-route-line"></i><strong>Journey</strong><span>@(tr?"Sürekli müşteri akışı":"Ongoing customer flow")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-message-3-line"></i><strong>@(tr?"Kanallar":"Channels")</strong><span>Email · SMS · WhatsApp · Push</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>Analytics</strong><span>@(tr?"Sonucu değerlendir":"Review outcomes")</span></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">Pika AI</span><h2>@(tr?"AI hesaplamanın yerine geçmez; onu daha kullanılır hale getirir.":"AI does not replace calculation; it makes evidence easier to use.")</h2></div><p class="pk-lead">@(tr?"Temel müşteri ve ürün metrikleri sistem tarafından hesaplanır veya kaynak veriden gelir. AI bu bağlamı açıklama, özetleme ve içerik/kampanya taslağı hazırlama aşamasında yardımcı olabilir. İş kuralı, yetki, izin ve gönderim kararı kullanıcı ve ürün kontrollerinde kalır.":"Core customer/product metrics are system-calculated or source-derived. AI can assist with explanation, summarization and content/campaign drafting. Business rules, authorization, consent and execution remain under user and product controls.")</p></div><div class="pk-insight-split"><article class="pk-insight-card pk-ai"><div class="pk-insight-card-copy"><span class="pk-eyebrow" style="color:#cfc9ff">AI generated</span><h3>@(tr?"Özet, açıklama ve taslak":"Summary, explanation and drafting")</h3><p>@(tr?"Pika AI hesaplanmış bağlamı iş dilinde açıklayabilir ve kullanıcıya içerik hazırlığında zaman kazandırabilir." : "Pika AI can explain calculated context in business language and save time during content preparation.")</p><a class="pk-text-link" href="@(tr?"/platform/ai-kampanya-asistani":"/en/platform/ai-campaign-assistant")">@(tr?"Pika AI'ı inceleyin":"Explore Pika AI") <i class="ri-arrow-right-line"></i></a></div><div class="pk-insight-card-visual"><img src="/wiki/assets/images/img_pika-pilot-ai-kampanya-asistani_16.png" alt="Pika AI" loading="lazy" width="1200" height="760" /></div></article><article class="pk-insight-card"><div class="pk-insight-card-copy"><span class="pk-eyebrow">System calculated</span><h3>@(tr?"Kanıt ve hesaplama ayrı kalır":"Evidence and calculations remain distinct")</h3><p>@(tr?"Müşteri değeri, ritim, ürün ilişkisi ve gerçekleşmiş işlem gibi kaynaklar AI metniyle karıştırılmadan görünür tutulmalıdır." : "Customer value, rhythm, product relationships and observed transactions should remain distinguishable from AI-generated text.")</p></div><div class="pk-insight-card-visual"><img src="/wiki/assets/images/img_ai-musteri-ozeti_8.png" alt="@(tr?"Pika AI müşteri özeti ve kaynak bağlamı":"Pika AI customer summary and source context")" loading="lazy" width="1200" height="760" /></div></article></div></div></section>

<section class="pk-section pk-section-lg pk-section-soft-2"><div class="pk-container pk-trust-band"><div><span class="pk-eyebrow">@(tr?"Kimler için?":"Who is it for?")</span><h2>@(tr?"Verisi olan ama kararı hâlâ manuel ve dağınık kalan ekipler için.":"For teams with data whose decisions are still manual and fragmented.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Pika özellikle tekrar eden müşteri ilişkisi, anlamlı ürün/hizmet çeşitliliği ve kullanılabilir satış geçmişi bulunan yapılarda değer üretir. Başlangıç için kusursuz veri gerekmez; ancak kullanılacak kabiliyeti besleyecek minimum veri ve ilişki bağlamı gerekir.":"Pika is especially useful where customer relationships repeat, product/service variety carries meaning and usable sales history exists. Perfect data is not required, but each capability needs enough evidence and relationships to work reliably.")><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/kullanim-senaryolari":"/en/use-cases")">@(tr?"Kullanım Senaryoları":"Use Cases")</a><a class="pk-btn pk-btn-ghost" href="/wiki/ozellik-veri-gereksinimleri">@(tr?"Veri Gereksinimleri":"Data Requirements")</a></div></div><div class="pk-trust-points"><div class="pk-trust-point"><strong>@(tr?"Tekrar eden müşteri ilişkisi":"Repeat customer relationships")</strong><span>@(tr?"Ritim, pasifleşme ve geri kazanım gibi zaman içindeki davranış senaryolarını anlamlı hale getirir." : "Makes rhythm, inactivity and win-back use cases meaningful over time.")</span></div><div class="pk-trust-point"><strong>@(tr?"Ürün/hizmet bağlamı":"Product/service context")</strong><span>@(tr?"Need Group, Product Role, tekrar tüketim ve tamamlayıcı ilişki gibi ürün zekâsını besler." : "Supports Need Group, Product Role, repeat-consumption and complementary relationship context.")</span></div><div class="pk-trust-point"><strong>@(tr?"Gerçek satış geçmişi":"Observed sales history")</strong><span>@(tr?"Müşteri değeri, alışveriş ritmi ve ürün ilişkileri için açıklanabilir kanıt sağlar." : "Provides explainable evidence for customer value, purchase rhythm and product relationships.")</span></div><div class="pk-trust-point"><strong>@(tr?"Aksiyona ihtiyaç":"Need for action")</strong><span>@(tr?"Raporların ötesinde Campaign, Journey ve kanal operasyonuna bağlanacak gerçek iş süreçleri olduğunda Pika'nın zinciri tamamlanır." : "Pika's chain is most useful when real Campaign, Journey and channel operations need to follow analysis.")</span></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-cta-panel"><span class="pk-eyebrow" style="color:#d7ed87">Doğru Anda</span><h2>@(tr?"Pika'yı modül listesi olarak değil, karar zinciri olarak değerlendirin.":"Evaluate Pika as a decision chain, not a module checklist.")</h2><p>@(tr?"Kendi müşteri, ürün ve satış veriniz üzerinden hangi intelligence ve fırsat katmanlarının değer üretebileceğini; bu çıktının Campaign veya Journey'e nasıl bağlanacağını birlikte değerlendirelim." : "Let's assess which intelligence and opportunity layers can create value from your customer, product and sales data and how those outputs can connect to Campaign or Journey.")</p><div class="pk-actions"><button class="pk-btn pk-btn-light" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.25)" href="/wiki/">@(tr?"Bilgi Bankasını Aç":"Open Knowledge Base")</a></div></div></div></section>

@{
    var culture = (ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr = culture == "tr";
    ViewData["Title"] = tr ? "Pika Nedir? | Müşteri Zekâsı ve Omnichannel Pazarlama Platformu" : "What is Pika? | Customer Intelligence & Omnichannel Marketing Platform";
    ViewData["MetaDescription"] = tr
        ? "Pika; müşteri, ürün ve satış verilerini anlamlandırarak işletmelerin doğru fırsatları bulmasını ve kontrollü çok kanallı aksiyonlara dönüştürmesini sağlayan müşteri zekâsı platformudur."
        : "Pika is a customer intelligence and omnichannel marketing platform that unifies customer, product, and sales data to reveal actionable opportunities and drive controlled campaigns.";
    ViewData["CanonicalUrl"] = tr ? "https://pika.tr/pika" : "https://pika.tr/en/pika";
}

@section Styles {
    <link href="~/css/pika-product.css" rel="stylesheet" />
}

<!-- ═══════════════════════════ HERO ═══════════════════════════ -->
<section class="pk-hero-section">
    <div class="container">
        <nav class="pk-breadcrumb" aria-label="breadcrumb">
            <a href="@(tr ? "/" : "/en/")">Pika</a>
            <span class="sep">/</span>
            <span>@(tr ? "Pika Nedir?" : "What is Pika?")</span>
        </nav>

        <div class="row align-items-center g-5 pt-3">
            <div class="col-lg-7">
                <div class="pk-eyebrow">
                    <span class="pk-pulse-dot"></span>
                    <span>@(tr ? "DOĞRU ANDA MÜŞTERİ ZEKÂSI" : "CUSTOMER INTELLIGENCE AT THE RIGHT MOMENT")</span>
                </div>
                <h1 class="pk-hero-title">
                    @(tr ? "Veriyi anlayan, fırsatı bulan ve kontrollü aksiyona dönüştüren platform." : "The platform that understands data, finds opportunities, and drives controlled action.")
                </h1>
                <p class="pk-hero-lead">
                    @(tr 
                        ? "Pika; müşteri, ürün, satış ve etkileşim hareketlerini bir araya getirerek işletmenin hangi müşteride hangi fırsatın oluştuğunu görmesini ve bu fırsatı SMS, WhatsApp, E-posta ve Push kanallarında hedeflenen kampanyalara dönüştürmesini sağlar." 
                        : "Pika unifies customer, product, transaction, and engagement data so your business can identify the right opportunities and execute targeted campaigns across SMS, WhatsApp, Email, and Push.")
                </p>
                <div class="pk-hero-cta-group">
                    <button type="button" class="btn pika-btn-primary px-4 py-3" data-bs-toggle="modal" data-bs-target="#demoModal">
                        @(tr ? "Canlı Demoyu İnceleyin" : "Request a Live Demo") <i class="ri-arrow-right-line ms-2"></i>
                    </button>
                    <a href="/wiki/pika-nasil-calisir" class="btn pika-btn-ghost px-4 py-3">
                        @(tr ? "Nasıl Çalışır? (Wiki)" : "How It Works (Wiki)") <i class="ri-book-read-line ms-2"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="pk-hero-card-preview shadow-sm">
                    <div class="pk-preview-header">
                        <div class="pk-window-dots">
                            <span></span><span></span><span></span>
                        </div>
                        <span class="pk-preview-tag">@(tr ? "Pika Karar Mimarisi" : "Pika Decision Architecture")</span>
                    </div>
                    <div class="pk-chain-flow p-3">
                        <div class="pk-chain-step">
                            <div class="pk-chain-icon" style="background:#e8f5e9;color:#2e7d32"><i class="ri-database-2-line"></i></div>
                            <div class="pk-chain-body">
                                <div class="pk-chain-title">1. @(tr ? "Veri & Entegrasyon" : "Data & Sync")</div>
                                <div class="pk-chain-desc">@(tr ? "Müşteri, ürün ve satış verileri" : "Customer, product & sales sync")</div>
                            </div>
                        </div>
                        <div class="pk-chain-arrow"><i class="ri-arrow-down-s-line"></i></div>
                        <div class="pk-chain-step">
                            <div class="pk-chain-icon" style="background:#e0f2fe;color:#0284c7"><i class="ri-brain-line"></i></div>
                            <div class="pk-chain-body">
                                <div class="pk-chain-title">2. @(tr ? "Müşteri & Ürün Zekâsı" : "Customer & Product Intelligence")</div>
                                <div class="pk-chain-desc">@(tr ? "Pika 360, RFM, ürün rolleri ve segmentler" : "Pika 360, RFM & product roles")</div>
                            </div>
                        </div>
                        <div class="pk-chain-arrow"><i class="ri-arrow-down-s-line"></i></div>
                        <div class="pk-chain-step pk-chain-step--highlight">
                            <div class="pk-chain-icon" style="background:#fff3e0;color:#f57c00"><i class="ri-focus-3-line"></i></div>
                            <div class="pk-chain-body">
                                <div class="pk-chain-title">3. @(tr ? "Günün Fırsatları" : "Daily Opportunities")</div>
                                <div class="pk-chain-desc">@(tr ? "Tekrar satın alma, pasifleşme ve cross-sell" : "Repurchase, churn risk & cross-sell")</div>
                            </div>
                        </div>
                        <div class="pk-chain-arrow"><i class="ri-arrow-down-s-line"></i></div>
                        <div class="pk-chain-step">
                            <div class="pk-chain-icon" style="background:#f3e8ff;color:#7c3aed"><i class="ri-route-line"></i></div>
                            <div class="pk-chain-body">
                                <div class="pk-chain-title">4. @(tr ? "Kontrollü Kampanya & Journey" : "Controlled Campaign & Journey")</div>
                                <div class="pk-chain-desc">@(tr ? "Yönetici onayı, izin kontrolü ve kanallar" : "Manager control, consent & delivery")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ CHAPTER 1: PIKA IS NOT JUST A SENDING TOOL ═══════════════════════════ -->
<section class="pk-section pk-section-light">
    <div class="container">
        <div class="pk-section-header text-center mx-auto" style="max-width:820px">
            <span class="pk-badge-sub">@(tr ? "BÜTÜNLEŞİK YAKLAŞIM" : "UNIFIED APPROACH")</span>
            <h2 class="pk-section-h2">@(tr ? "Pika yalnızca mesaj gönderen bir araç değildir." : "Pika is not just a message sending tool.")</h2>
            <p class="pk-section-lead">
                @(tr 
                    ? "Geleneksel araçlar veri analitiği, kitle segmentasyonu, kampanya tasarımı ve kanal gönderimini birbirinden kopuk adımlarla yürütür. Pika, bu zinciri tek bir karar mimarisinde birleştirir."
                    : "Traditional tools treat data analytics, segmentation, campaign creation, and delivery as disconnected silos. Pika connects every step into a unified decision workflow.")
            </p>
        </div>

        <div class="row g-4 mt-4">
            <div class="col-lg-3 col-md-6">
                <div class="pk-compare-card pk-card-dim">
                    <div class="pk-card-status"><i class="ri-close-circle-fill text-danger"></i> @(tr ? "Yalnızca Mesajlaşma Değil" : "Not Just Messaging")</div>
                    <h4>@(tr ? "Gönderim Araçları" : "Standalone Senders")</h4>
                    <p>@(tr ? "Yalnızca listenizi yükleyip mesaj attığınız, müşterinin ne zaman neye ihtiyaç duyduğunu bilmeyen statik araçlar." : "Static delivery systems that blast lists without understanding customer timing or need.")</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="pk-compare-card pk-card-dim">
                    <div class="pk-card-status"><i class="ri-close-circle-fill text-danger"></i> @(tr ? "Yalnızca Rapor Değil" : "Not Just BI")</div>
                    <h4>@(tr ? "İzole BI Panoları" : "Isolated Dashboards")</h4>
                    <p>@(tr ? "Geçmiş veriyi grafiklere döken ancak aksiyona geçmek için tekrar dışa aktarım ve manuel iş gücü gerektiren paneller." : "Dashboards that display charts but require manual CSV exports and manual segmentation to act.")</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="pk-compare-card pk-card-dim">
                    <div class="pk-card-status"><i class="ri-close-circle-fill text-danger"></i> @(tr ? "Yalnızca Metin Üretimi Değil" : "Not Just AI Copy")</div>
                    <h4>@(tr ? "Bağlamsız AI Araçları" : "Unanchored AI Copy")</h4>
                    <p>@(tr ? "Müşteri verisi ve ürün bağlamı olmadan jenerik metin üreten, iş hedeflerine doğrudan bağlı olmayan yapılar." : "Generic text generators lacking customer history, product context, or verified business signals.")</p>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="pk-compare-card pk-card-active">
                    <div class="pk-card-status"><i class="ri-checkbox-circle-fill text-success"></i> @(tr ? "Pika Yaklaşımı" : "The Pika Approach")</div>
                    <h4>@(tr ? "Müşteri & Ürün Zekâsı" : "Intelligence to Action")</h4>
                    <p>@(tr ? "Veriyi işler, fırsatı yakalar, hedef kitleyi belirler, doğru kanaldan yönetici kontrolüyle aksiyona dönüştürür ve sonucu ölçer." : "Ingests data, detects verified opportunities, selects audiences, executes under manager control, and measures impact.")</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ CHAPTER 2: WHAT PIKA UNDERSTANDS ═══════════════════════════ -->
<section class="pk-section">
    <div class="container">
        <div class="pk-section-header">
            <span class="pk-badge-sub">@(tr ? "1. KATMAN: ANLAMA" : "LAYER 1: UNDERSTANDING")</span>
            <h2 class="pk-section-h2">@(tr ? "Pika veriyi nasıl anlamlandırır?" : "How Pika understands your data")</h2>
            <p class="pk-section-lead">
                @(tr 
                    ? "İşletmenizin satış hareketleri, ürün kataloğu ve müşteri etkileşimleri üç temel zekâ modülünde analiz edilir."
                    : "Your transactions, catalog, and interactions are contextualized across three core intelligence modules.")
            </p>
        </div>

        <div class="row g-4 mt-2">
            <div class="col-lg-4">
                <div class="pk-feature-box h-100">
                    <div class="pk-box-icon" style="background:#e0f2fe;color:#0284c7"><i class="ri-user-search-line"></i></div>
                    <h3>Customer Intelligence</h3>
                    <p class="text-muted">
                        @(tr 
                            ? "Müşteri satın alma sıklığı, harcama tutarları, son ziyaret aralıkları (RFM) ve müşteri yaşam boyu değeri (LTV) gibi davranışsal kalıpları hesaplar."
                            : "Analyzes purchase frequency, monetary value, recency (RFM), and customer lifetime value patterns to identify customer segments.")
                    </p>
                    <ul class="pk-feature-list">
                        <li><i class="ri-check-line"></i> @(tr ? "Aktif, riskli ve uyuyan müşteri segmentleri" : "Active, at-risk, and inactive segments")</li>
                        <li><i class="ri-check-line"></i> @(tr ? "Müşteri bazında ortalama sepet ve harcama trendi" : "Average basket value & spend trends")</li>
                    </ul>
                    <a href="@(tr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")" class="pk-learn-more">
                        @(tr ? "Customer Intelligence İncele" : "Explore Customer Intelligence") <i class="ri-arrow-right-s-line"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="pk-feature-box h-100">
                    <div class="pk-box-icon" style="background:#fef3c7;color:#d97706"><i class="ri-shopping-bag-3-line"></i></div>
                    <h3>Product Intelligence</h3>
                    <p class="text-muted">
                        @(tr 
                            ? "Ürünlerin portföydeki rollerini (Need Group, Giriş Ürünü, Çapraz Satış Tamamlayıcısı, Tekrar Tüketim) ve birlikte satın alma ilişkilerini haritalandırır."
                            : "Maps product roles across your catalog (Need Groups, Entry Products, Cross-sell Complements, Repurchase Cycles) and co-purchase dynamics.")
                    </p>
                    <ul class="pk-feature-list">
                        <li><i class="ri-check-line"></i> @(tr ? "Tekrar tüketim döngüleri (ör. 30/45 günlük ürünler)" : "Repurchase cycles (e.g. 30/45-day consumption)")</li>
                        <li><i class="ri-check-line"></i> @(tr ? "Birlikte satın alınan ürün korelasyonları" : "Affinity and co-purchase correlation")</li>
                    </ul>
                    <a href="@(tr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")" class="pk-learn-more">
                        @(tr ? "Product Intelligence İncele" : "Explore Product Intelligence") <i class="ri-arrow-right-s-line"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="pk-feature-box h-100">
                    <div class="pk-box-icon" style="background:#f3e8ff;color:#7c3aed"><i class="ri-user-heart-line"></i></div>
                    <h3>Pika 360</h3>
                    <p class="text-muted">
                        @(tr 
                            ? "Her bir müşteri için tekil bir karar kartı oluşturur. Müşterinin geçmiş siparişleri, ilgilendiği ürünler, izin durumu ve güncel fırsatları tek ekranda toplanır."
                            : "Constructs a unified decision profile for every customer: purchase history, product interests, consent status, and active opportunities.")
                    </p>
                    <ul class="pk-feature-list">
                        <li><i class="ri-check-line"></i> @(tr ? "Müşteri özet kartı ve Next Best Action önerisi" : "Unified summary card & Next Best Action signal")</li>
                        <li><i class="ri-check-line"></i> @(tr ? "Kanal tercihleri ve IYS izin durumu" : "Channel preferences & IYS consent status")</li>
                    </ul>
                    <a href="@(tr ? "/platform/pika-360" : "/en/platform/pika-360")" class="pk-learn-more">
                        @(tr ? "Pika 360 İncele" : "Explore Pika 360") <i class="ri-arrow-right-s-line"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ CHAPTER 3: WHAT PIKA FINDS (GÜNÜN FIRSATLARI) ═══════════════════════════ -->
<section class="pk-section pk-section-alt">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="pk-badge-sub">@(tr ? "2. KATMAN: FIRSAT TESPİTİ" : "LAYER 2: OPPORTUNITY DISCOVERY")</span>
                <h2 class="pk-section-h2">@(tr ? "Günün Fırsatları: Karar motoru ne bulur?" : "Daily Opportunities: What the engine discovers")</h2>
                <p class="pk-section-lead">
                    @(tr 
                        ? "Pika verinizi arka planda sürekli tarayarak işletmeniz için gelir potansiyeli taşıyan gerçek müşteri fırsatlarını gün yüzüne çıkarır."
                        : "Pika continuously analyzes transactions to surface concrete, high-potential revenue opportunities daily.")
                </p>

                <div class="pk-opp-item">
                    <div class="pk-opp-icon"><i class="ri-refresh-line"></i></div>
                    <div>
                        <h5>@(tr ? "Tekrar Satın Alma Fırsatları" : "Repurchase Timing Opportunities")</h5>
                        <p class="small text-muted mb-0">@(tr ? "Tüketim süresi dolmak üzere olan ve geçmiş alışveriş ritmine göre yeniden almaya hazır müşteriler." : "Customers nearing the end of product usage cycles based on historical frequency.")</p>
                    </div>
                </div>

                <div class="pk-opp-item">
                    <div class="pk-opp-icon"><i class="ri-link"></i></div>
                    <div>
                        <h5>@(tr ? "Çapraz Satış (Cross-sell) Sinyalleri" : "Cross-Sell Affinity Signals")</h5>
                        <p class="small text-muted mb-0">@(tr ? "Belirli bir ana ürünü almış ancak tamamlayıcı ürünü henüz satın almamış müşteri kitleleri." : "Customers who bought a primary product but have not yet purchased the complementary item.")</p>
                    </div>
                </div>

                <div class="pk-opp-item">
                    <div class="pk-opp-icon"><i class="ri-user-unfollow-line"></i></div>
                    <div>
                        <h5>@(tr ? "Pasifleşme Riski ve Geri Kazanım" : "Churn Risk & Win-back")</h5>
                        <p class="small text-muted mb-0">@(tr ? "Alışveriş aralığı normal rutininin dışına çıkan değerli müşterilerin erken tespiti." : "High-value customers whose purchasing rhythm has started drifting outside their regular pattern.")</p>
                    </div>
                </div>

                <div class="mt-4">
                    <a href="@(tr ? "/platform/firsatlar" : "/en/platform/opportunities")" class="btn pika-btn-primary px-4 py-2">
                        @(tr ? "Günün Fırsatları Motorunu İnceleyin" : "Explore Opportunity Engine") <i class="ri-arrow-right-line ms-1"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="pk-mockup-panel shadow-sm">
                    <div class="pk-panel-header">
                        <span class="fw-bold"><i class="ri-focus-3-line text-warning me-2"></i>@(tr ? "Günün Fırsatları Paneli" : "Daily Opportunities Feed")</span>
                        <span class="badge bg-success-subtle text-success">@(tr ? "Canlı Örnek" : "Live Sample")</span>
                    </div>
                    <div class="p-3">
                        <div class="pk-mock-card">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-primary-subtle text-primary">@(tr ? "Tekrar Satın Alma" : "Repurchase")</span>
                                <span class="small text-muted">142 @(tr ? "Müşteri" : "Customers")</span>
                            </div>
                            <h6 class="mb-1">@(tr ? "Kahve Çekirdeği Yenileme Zamanı" : "Coffee Beans Replenishment Cycle")</h6>
                            <p class="small text-muted mb-2">@(tr ? "Son siparişten bu yana 28 gün geçti. Ortalama tüketim ritmi 30 gün." : "28 days since last order. Average consumption rhythm is 30 days.")</p>
                            <div class="d-flex gap-2">
                                <span class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size:0.75rem">@(tr ? "Kampanya Başlat" : "Start Campaign")</span>
                                <span class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:0.75rem">@(tr ? "Kitleyi İncele" : "View Audience")</span>
                            </div>
                        </div>

                        <div class="pk-mock-card mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-warning-subtle text-warning">@(tr ? "Çapraz Satış" : "Cross-sell")</span>
                                <span class="small text-muted">89 @(tr ? "Müşteri" : "Customers")</span>
                            </div>
                            <h6 class="mb-1">@(tr ? "Filtre Kağıdı & Temizleme Kiti Önerisi" : "Filter Paper & Cleaning Kit Add-on")</h6>
                            <p class="small text-muted mb-2">@(tr ? "Espresso makinesi alan ve aksesuar almamış müşteriler." : "Purchased espresso machine without complementary accessories.")</p>
                            <div class="d-flex gap-2">
                                <span class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size:0.75rem">@(tr ? "Kampanya Başlat" : "Start Campaign")</span>
                                <span class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size:0.75rem">@(tr ? "Kitleyi İncele" : "View Audience")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════════════════ CHAPTER 4: HOW PIKA TURNS INTELLIGENCE INTO ACTION ═══════════════════════════ -->
<section class="pk-section">
    <div class="container">
        <div class="pk-section-header text-center mx-auto" style="max-width:820px">
            <span class="pk-badge-sub">@(tr ? "3. KATMAN: KONTROLLÜ AKSİYON" : "LAYER 3: CONTROLLED ACTION")</span>
            <h2 class="pk-section-h2">@(tr ? "Fırsattan kampanyaya: Yönetici kontrolünde aksiyon" : "From opportunity to action: Under manager control")</h2>
            <p class="pk-section-lead">
                @(tr 
                    ? "Pika kontrolsüz veya özerk kararlar vermez. Tüm kurgular, kitle seçimleri ve içerikler işletme yöneticisinin inceleme ve onay mekanizmasıyla çalışır."
                    : "Pika never executes uncontrolled or autonomous actions. All campaigns, segmentations, and content remain strictly under manager supervision and approval.")
            </p>
        </div>

        <div class="row g-4 mt-4">
            <div class="col-lg-3 col-md-6">
                <div class="pk-action-card">
                    <div class="pk-action-icon"><i class="ri-group-line"></i></div>
                    <h4>Audience Manager</h4>
                    <p>@(tr ? "Dinamik filtreler, RFM skorları ve alışveriş kriterlerine göre kesin hedef kitleler oluşturun." : "Build precise audiences using dynamic behavioral criteria, RFM scores, and purchase parameters.")</p>
                    <a href="@(tr ? "/cozumler/audience-manager" : "/en/solutions/audience-manager")" class="pk-link-sub">@(tr ? "Audience Manager →" : "Audience Manager →")</a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="pk-action-card">
                    <div class="pk-action-icon"><i class="ri-megaphone-line"></i></div>
                    <h4>Campaign Manager</h4>
                    <p>@(tr ? "Tek seferlik veya periyodik kampanyaları hızlıca tasarlayın, zamanlayın ve onaylayıp başlatın." : "Design, schedule, review, and trigger one-off or scheduled multi-channel campaigns.")</p>
                    <a href="@(tr ? "/cozumler/campaign-manager" : "/en/solutions/campaign-manager")" class="pk-link-sub">@(tr ? "Campaign Manager →" : "Campaign Manager →")</a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="pk-action-card">
                    <div class="pk-action-icon"><i class="ri-route-line"></i></div>
                    <h4>Journey Manager</h4>
                    <p>@(tr ? "Olay ve tetikleyici bazlı, çok adımlı müşteri yolculukları ve otomasyon akışları kurgulayın." : "Design event-driven, multi-step customer journeys and adaptive automation flows.")</p>
                    <a href="@(tr ? "/cozumler/journey-manager" : "/en/solutions/journey-manager")" class="pk-link-sub">@(tr ? "Journey Manager →" : "Journey Manager →")</a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="pk-action-card">
                    <div class="pk-action-icon"><i class="ri-magic-line"></i></div>
                    <h4>Content &amp; AI Asistanı</h4>
                    <p>@(tr ? "Hazır şablonlar ve AI destekli metin önerileri ile kampanya içeriklerinizi hızla hazırlayın." : "Draft high-converting copy and responsive email templates with AI-assisted creative tools.")</p>
                    <a href="@(tr ? "/urunler/ai-kampanya-asistani" : "/en/products/ai-campaign-assistant")" class="pk-link-sub">@(tr ? "AI Asistanı →" : "AI Assistant →")</a>
                </div>
            </div>
        </div>

        <!-- Channels Grid -->
        <div class="pk-channels-strip mt-5 p-4 rounded-4 bg-light border">
            <div class="row align-items-center g-3">
                <div class="col-lg-4">

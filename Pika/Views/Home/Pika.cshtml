                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ══════════════════════════════════════════════════════════════════════════
       14 — FINAL CTA
       Strong brand conclusion. Dark petrol or warm-neutral transition into footer.
       ══════════════════════════════════════════════════════════════════════════ *@
    <section class="pika-section pika-section--dark pika-final-cta" id="cta">
        <div class="container">
            <div class="pika-final-cta__box">
                <div class="pika-eyebrow pika-eyebrow--dark">
                    <span>@L("DOĞRU ANDA", "AT THE RIGHT MOMENT")</span>
                </div>

                <h2 class="pika-display-h2 pika-display-h2--light">
                    @if (tr)
                    {
                        <text>Müşterinizi anlayın.<br />Fırsatı görün.<br />Doğru anda aksiyona geçin.</text>
                    }
                    else
                    {
                        <text>Understand your customer.<br />See the opportunity.<br />Act at the right moment.</text>
                    }
                </h2>

                <p class="pika-final-cta__body">
                    @L("Pika'nın müşteri, ürün ve satış verinizden hangi ticari fırsatları görünür hale getirebileceğini birlikte değerlendirelim.",
                       "Let's explore which commercial opportunities Pika can make visible from your customer, product and sales data.")
                </p>

                <div class="pika-final-cta__commercial">
                    <span class="pika-commercial-badge">
                        @L("İhtiyacınıza ve kullanım kapsamınıza göre özel teklif.",
                           "Pricing is tailored to your requirements and scope of use.")
                    </span>
                </div>

                <div class="pika-final-cta__actions">
                    <button type="button" class="btn pika-btn pika-btn--lime" data-bs-toggle="modal" data-bs-target="#demoModal">
                        @L("Demo Talep Et", "Request a Demo")
                        <i class="ri-arrow-right-up-line" aria-hidden="true"></i>
                    </button>
                    <a href="@(tr ? "/demo-talebi" : "/en/demo-request")" class="btn pika-btn pika-btn--secondary-glass">
                        @L("Teklif Al", "Request a Quote")
                    </a>
                    <a href="@(tr ? "/iletisim" : "/en/contact")" class="btn pika-btn pika-btn--ghost-light">
                        @L("Satış Ekibiyle Görüşün", "Talk to Sales")
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>


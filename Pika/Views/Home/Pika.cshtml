@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr = culture == "tr";
    string L(string turkish, string english) => tr ? turkish : english;
    ViewData["Title"] = L("Pika Hakkında | Önce Anlamak, Sonra Ulaşmak", "About Pika | Understand First, Then Connect");
    ViewData["MetaDescription"] = L("Pika; müşteri, ürün ve satış verisini birlikte anlamlandırarak ticari fırsatları görünür kılan, kontrollü ve ölçülebilir iletişime dönüştüren müşteri zekâsı platformudur.", "Pika brings customer, product and sales data together to reveal commercial opportunities and turn them into controlled, measurable communication.");
    ViewData["CanonicalUrl"] = tr ? "https://pika.tr/pika" : "https://pika.tr/en/pika";
}
@section Styles {
    <link href="~/css/pika-about.css" rel="stylesheet" asp-append-version="true" />
}
<div class="about-pika">
 <section class="about-opening">
  <div class="about-orbits" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="container"><div class="about-kicker">@L("PIKA HAKKINDA", "ABOUT PIKA") <span>01 — 06</span></div>
   <h1>@L("Önce anlamak.", "Understand first.")<br/><em>@L("Sonra ulaşmak.", "Then connect.")</em></h1>
   <div class="about-opening-bottom"><p>@L("Pika; müşteri, ürün ve satış verisini birlikte anlamlandıran müşteri zekâsı ve pazarlama platformudur. Hangi müşteride, hangi ticari fırsatın oluştuğunu görün; bu fırsatı kontrollü ve ölçülebilir çok kanallı aksiyona dönüştürün.", "Pika is a customer intelligence and marketing platform that brings customer, product and sales data together. See which commercial opportunity is emerging for each customer, then turn it into controlled, measurable action across channels.")</p><div class="about-actions"><button type="button" data-bs-toggle="modal" data-bs-target="#demoModal">@L("Demo talep et", "Request a demo") ↗</button><a href="#inner-content">@L("Pika’yı keşfedin", "Discover Pika") ↓</a></div></div>
   <div class="about-opening-rule"><span>CUSTOMER INTELLIGENCE & MEANINGFUL CONNECTIONS</span><span>@L("BAKIŞ AÇIMIZ", "OUR PERSPECTIVE") ↓</span></div>
  </div>
 </section>
 <section class="about-question" id="inner-content"><div class="container about-editorial"><div class="about-side-label">01 / @L("BAŞLANGIÇ NOKTAMIZ", "OUR STARTING POINT")</div><div><p class="about-statement">@L("Bir müşteriye ulaşmak bugün zor değil.", "Reaching a customer today isn’t difficult.")</p><p class="about-body">@L("E-posta gönderebilir, SMS ile ulaşabilir, WhatsApp üzerinden iletişim kurabilirsiniz. Asıl mesele, bu iletişimin arkasındaki nedeni bilmektir.", "You can send an email, reach out by SMS or start a conversation on WhatsApp. The real question is understanding the reason behind that communication.")</p><div class="about-questions"><div><span>01</span><h2>@L("Kime ulaşmalıyım?", "Who should I reach?")</h2></div><div><span>02</span><h2>@L("Neden şimdi?", "Why now?")</h2></div><div><span>03</span><h2>@L("Hangi ürün gerçekten anlamlı?", "Which product is truly relevant?")</h2></div></div><p class="about-conclusion">@L("Pika tam burada başlar.", "This is where Pika begins.") <span>@L("Müşteriyi ve ürünü anlamaktan.", "With understanding the customer and the product.")</span></p></div></div></section>
 <section class="about-chain"><div class="container"><div class="about-chain-heading"><div><div class="about-side-label">02 / @L("KARAR ZİNCİRİ", "THE DECISION CHAIN")</div><h2>@L("Bir adım geriye.", "One step back.")<br/><em>@L("Daha doğru bir adım ileriye.", "A more considered step forward.")</em></h2></div><p>@L("Pika önce davranışı anlar, ürünlerin ticari anlamını ortaya çıkarır ve iki bağlamın kesiştiği fırsatı bulur. Aksiyon, bu anlayışın devamıdır.", "Pika starts with behavior, reveals the commercial meaning of products and finds opportunities where the two contexts meet. Action follows understanding.")</p></div>
 <ol class="about-chain-steps">
 <li><span>01</span><h3>@L("Veri", "Data")</h3><p>@L("Müşteri, ürün ve işlem bağlamı", "Customer, product and transaction context")</p></li>
 <li><span>02</span><h3>@L("Zekâ", "Intelligence")</h3><p>@L("Davranış, ritim, değer ve ürün ilişkileri", "Behavior, rhythm, value and product relationships")</p></li>
 <li><span>03</span><h3>@L("Fırsat & karar", "Opportunity & decision")</h3><p>@L("Bugün nerede anlamlı bir fırsat var?", "Where is a relevant opportunity today?")</p></li>
 <li><span>04</span><h3>@L("Orkestrasyon", "Orchestration")</h3><p>Audience · Campaign · Journey</p></li>
 <li><span>05</span><h3>@L("İletişim", "Communication")</h3><p>Email · SMS · WhatsApp</p></li>
 <li><span>06</span><h3>@L("Ölçüm & öğrenme", "Measure & learn")</h3><p>@L("Sonuçlar ve ilişkilendirilen etki", "Results and attributed outcomes")</p></li>
 </ol><small class="about-diagram-note">@L("Örnek görünüm · Pika’nın çalışma yaklaşımı", "Illustration · How Pika works")</small></div></section>
 <section class="about-intelligence"><div class="container"><div class="about-side-label">03 / @L("İKİ BAĞLAM, BİR ANLAYIŞ", "TWO CONTEXTS, ONE UNDERSTANDING")</div><div class="about-intelligence-grid"><article><div class="about-large-number">01<span>Customer Intelligence</span></div><h2>@L("Bir kaydın ötesinde,", "Beyond a record,")<br/><em>@L("bir davranış hikâyesi.", "a story of behavior.")</em></h2><p>@L("Bir müşteriyi yalnızca adı, telefonu veya son siparişiyle tanımlamak yeterli değildir. Pika, müşteriyi davranış bağlamıyla ele alır.", "A name, a phone number or the latest order cannot tell the whole story. Pika considers the customer in the context of their behavior.")</p><ul><li>@L("Ne sıklıkla alışveriş yapıyor; ritmi değişiyor mu?", "How often do they shop, and is that rhythm changing?")</li><li>@L("Müşteri değeri nasıl gelişiyor?", "How is their customer value evolving?")</li><li>@L("Hangi ürünlerle ilişkisi güçlü?", "Which products matter most to them?")</li><li>@L("Pasifleşme riski veya açık bir fırsat var mı?", "Is there a risk of inactivity or an open opportunity?")</li></ul><a href="@(tr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")">@L("Müşteri zekâsını keşfedin", "Explore customer intelligence") ↗</a></article><article><div class="about-large-number">02<span>Product Intelligence</span></div><h2>@L("Bir ürünün ötesinde,", "Beyond a product,")<br/><em>@L("bir ihtiyaç ilişkisi.", "a connection to a need.")</em></h2><p>@L("İki benzer ürün, pazarlama açısından aynı anlama gelmeyebilir. Pika ürünleri müşteri ihtiyacı ve ticari rol bağlamında değerlendirir.", "Two similar products may play very different commercial roles. Pika considers products in the context of customer needs and those roles.")</p><ul><li>@L("Müşteriyi mağazaya getiren ürün", "A product that brings a customer to the store")</li><li>@L("Sepeti büyüten veya başka bir ihtiyacı tamamlayan ürün", "A product that grows a basket or meets a complementary need")</li><li>@L("Belirli bir tüketim döngüsüne sahip ürün", "A product with a particular replenishment cycle")</li><li>@L("Birlikte satın alınan ürünler arasındaki ilişki", "Relationships between products purchased together")</li></ul><a href="@(tr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")">@L("Ürün zekâsını keşfedin", "Explore product intelligence") ↗</a></article></div></div></section>
 <section class="about-opportunity"><div class="container about-editorial"><div class="about-side-label">04 / @L("ANLAYIŞTAN FIRSATA", "FROM INSIGHT TO OPPORTUNITY")</div><div><h2>@L("Bugün, hangi müşteri için", "For which customer")<br/><em>@L("anlamlı bir adım atabiliriz?", "can we make a meaningful move today?")</em></h2><p class="about-body">@L("Günün Fırsatları, müşteri ve ürün zekâsını günlük ticari kararlara taşır. Analizin değeri, değerlendirilebilecek bir fırsata dönüştüğünde görünür olur.", "Daily Opportunities brings customer and product intelligence into everyday commercial decisions. Insight becomes useful when it reveals an opportunity worth considering.")</p><div class="about-opportunity-list"><span>@L("Tekrar satın alma zamanı yaklaşan müşteri", "A customer approaching their next purchase")</span><span>@L("Birlikte alınan ürünlerden doğan çapraz satış fırsatı", "A cross-sell opportunity informed by co-purchases")</span><span>@L("Alışveriş ritmi değişen değerli müşteri", "A valuable customer with a changing purchase rhythm")</span><span>@L("Yeniden kazanılabilecek pasif müşteri", "An inactive customer who may be ready to reconnect")</span></div><a class="about-text-link" href="@(tr ? "/platform/gunun-firsatlari" : "/en/platform/opportunities")">@L("Günün Fırsatları’nı keşfedin", "Explore Daily Opportunities") ↗</a></div></div>
 <div class="container about-perspective"><span>PIKA 360</span><blockquote><del>@L("Bu müşteriye ne gönderebilirim?", "What can I send this customer?")</del><p>@L("Bu müşteriyle şu anda neden iletişim kurmalıyım?", "Why should I communicate with this customer right now?")</p></blockquote><div><p>@L("İşlem geçmişi, müşteri değeri, davranış, iletişim erişilebilirliği ve açık fırsatlar tek görünümde. Pika 360, bu sorunun bağlamını bir araya getirir.", "Transaction history, customer value, behavior, communication reachability and open opportunities in one view. Pika 360 brings the context for that question together.")</p><a href="@(tr ? "/platform/pika-360" : "/en/platform/pika-360")">@L("Pika 360’ı keşfedin", "Explore Pika 360") ↗</a></div></div></section>
 <section class="about-action"><div class="container"><div class="about-chain-heading"><div><div class="about-side-label">05 / @L("AYNI ZİNCİRDE DEVAM", "KEEP THE CHAIN CONNECTED")</div><h2>@L("Anlamadan aksiyona,", "From understanding to action,")<br/><em>@L("bağlamı kaybetmeden.", "without losing context.")</em></h2></div><p>@L("Fırsat bulunduktan sonra süreç aynı platformda devam eder. Kitle, kampanya, yolculuk ve içerik aynı karar zincirinin parçalarıdır.", "Once an opportunity is identified, the process continues on the same platform. Audience, campaign, journey and content are parts of one decision chain.")</p></div><div class="about-managers"><a href="@(tr ? "/cozumler/audience-manager" : "/en/solutions/audience-manager")"><small>Audience Manager</small><strong>@L("Kime?", "Who?")</strong><span>↗</span></a><a href="@(tr ? "/cozumler/campaign-manager" : "/en/solutions/campaign-manager")"><small>Campaign Manager</small><strong>@L("Hangi kampanya?", "Which campaign?")</strong><span>↗</span></a><a href="@(tr ? "/cozumler/journey-manager" : "/en/solutions/journey-manager")"><small>Journey Manager</small><strong>@L("Hangi sıra, hangi zaman?", "Which sequence, which timing?")</strong><span>↗</span></a><a href="@(tr ? "/cozumler/content-studio" : "/en/solutions/content-studio")"><small>Content Studio</small><strong>@L("Hangi içerik?", "Which content?")</strong><span>↗</span></a></div><div class="about-channels"><span>@L("KONTROLLÜ KANAL İCRASI", "CONTROLLED CHANNEL DELIVERY")</span><strong>Email <i>·</i> SMS <i>·</i> WhatsApp</strong></div></div></section>
 <section class="about-ai"><div class="container about-editorial"><div class="about-side-label">06 / @L("YAPAY ZEKÂYA BAKIŞIMIZ", "OUR APPROACH TO AI")</div><div><h2>@L("Gerçeğe dayanan üretim.", "Creation grounded in reality.")<br/><em>@L("İnsanda kalan kontrol.", "Control that stays with people.")</em></h2><p class="about-body">@L("Pika AI, hesaplanan müşteri, ürün ve fırsat bağlamını kullanarak kampanya hazırlığını ve içerik üretimini hızlandırır. Önerileri kullanıcı değerlendirir; son karar kullanıcıda kalır.", "Pika AI uses calculated customer, product and opportunity context to accelerate campaign preparation and content creation. The user reviews the suggestions and retains the final decision.")</p><ol class="about-ai-flow"><li><span>01</span>@L("Hesaplanan ticari bağlam", "Calculated business context")</li><li><span>02</span>@L("AI açıklaması ve üretimi", "AI explanation and creation")</li><li><span>03</span>@L("İnsan kontrolü", "Human control")</li><li><span>04</span>@L("Uygulama", "Execution")</li></ol><p class="about-ai-note">@L("Üretken yapay zekâ güçlü içerikler üretebilir. Ticari gerçeğin kaynağı ise müşteri, ürün ve işlem verisidir.", "Generative AI can create compelling content. The source of business truth remains customer, product and transaction data.")</p><a class="about-text-link" href="@(tr ? "/urunler/ai-kampanya-asistani" : "/en/products/ai-campaign-assistant")">@L("Pika Pilot ile tanışın", "Meet Pika Pilot") ↗</a></div></div></section>
 <section class="about-belief"><div class="container"><span class="about-belief-symbol" aria-hidden="true">✳</span><div class="about-side-label">@L("BİZİM İÇİN İYİ PAZARLAMA", "WHAT GOOD MARKETING MEANS TO US")</div><h2>@L("Doğru kişi. Doğru ihtiyaç.", "The right person. The right need.")<br/><em>@L("Doğru zaman. Doğru bağlam.", "The right time. The right context.")</em></h2><p>@L("Teknoloji, bu anlayışı ölçeklendirmeli.", "Technology should scale this understanding.")</p><div class="about-principles"><span>@L("Veri, mesajdan önce gelir.", "Data comes before the message.")</span><span>@L("Karar, kanaldan önce gelir.", "The decision comes before the channel.")</span><span>@L("Müşteri bağlamı, kampanya takviminden önce gelir.", "Customer context comes before the campaign calendar.")</span><span>@L("Yapay zekâ, gerçeğin yerine geçmez.", "AI does not replace reality.")</span><span>@L("Kontrol kullanıcıda kalır.", "Control stays with the user.")</span></div></div></section>
 <section class="about-closing"><div class="container"><div><div class="about-side-label">@L("MÜŞTERİ ZEKÂSI VE PAZARLAMA PLATFORMU", "CUSTOMER INTELLIGENCE & MARKETING PLATFORM")</div><h2>@L("Sizin hikâyenizde", "Where does Pika fit")<br/>@L("Pika nerede başlar?", "in your story?")</h2><p>@L("Müşterinizi, ürünlerinizi ve satış verinizi birlikte değerlendirelim. İşletmeniz için hangi fırsatları görünür hale getirebileceğimizi keşfedelim.", "Let’s look at your customers, products and sales data together, and explore the opportunities we could bring into focus for your business.")</p></div><div class="about-closing-actions"><button type="button" data-bs-toggle="modal" data-bs-target="#demoModal">@L("Demo talep et", "Request a demo") ↗</button><a href="@(tr ? "/demo-talebi" : "/en/demo-request")">@L("Teklif al", "Request a quote") ↗</a><small>@L("İhtiyacınıza ve kullanım kapsamınıza göre özel teklif.", "Custom quote based on your specific needs and usage scope.")</small></div></div></section>
</div>

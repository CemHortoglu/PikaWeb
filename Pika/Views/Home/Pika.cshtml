                        </button>
                    </h3>
                    <div id="faqCollapse8" class="accordion-collapse collapse" aria-labelledby="faqHeading8" data-bs-parent="#pikaFaqAccordion">
                        <div class="accordion-body">
                            @L("İhtiyacınıza ve kullanım kapsamınıza göre özel teklif.",
                               "Pricing is tailored to your requirements and scope of use.")

@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr = culture == "tr";
    ViewData["Title"] = tr ? "Pika Nedir?" : "What is Pika?";
    ViewData["MetaDescription"] = tr ? "Pika'nın veri, Customer Intelligence, Product Intelligence, Pika 360, Günün Fırsatları, Campaign, Journey, kanallar ve ölçüm katmanlarını nasıl bir karar zincirinde birleştirdiğini keşfedin." : "Learn how Pika connects data, Customer Intelligence, Product Intelligence, Pika 360, Daily Opportunities, Campaign, Journey, channels and measurement.";
    ViewData["BodyClass"] = "pk-page";
}

<section class="pk-hero">
    <div class="pk-container pk-hero-grid">
        <div><span class="pk-eyebrow">Doğru Anda · @(tr ? "Pika Nedir?" : "What is Pika?")</span><h1>@(tr ? "Pika, veriyi müşteriyi anlamaya; anlamı doğru aksiyona bağlar." : "Pika connects data to customer understanding, and understanding to the right action.")</h1><p>@(tr ? "Pika; müşteri, ürün, satış ve etkileşim verisini anlamlandırarak hangi müşteride hangi fırsatın oluştuğunu görmeye ve bu fırsatı yönetilebilir Campaign, Journey ve kanal aksiyonlarına dönüştürmeye yardımcı olan müşteri zekâsı ve pazarlama platformudur." : "Pika is a customer intelligence and marketing platform that helps teams understand customer, product, sales and engagement data, identify where opportunities exist and convert them into manageable Campaign, Journey and channel actions.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Demo Talep Et" : "Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/pika-nedir">@(tr ? "Bilgi Bankasında Okuyun" : "Read in Knowledge Base")</a></div></div>
        <figure class="pk-proof"><img src="/wiki/assets/images/img_gunun-firsatlari.png" alt="@(tr ? "Pika Günün Fırsatları ekranı" : "Pika Daily Opportunities screen")" width="1200" height="760" /><figcaption>@(tr ? "Pika'nın başlangıç noktası mesaj göndermek değil; veriden anlam ve aksiyon bağlamı üretmektir." : "Pika starts with understanding data and action context, not simply sending messages.")</figcaption></figure>
    </div>
</section>

<section class="pk-section pk-section-lg">
    <div class="pk-container pk-chapter">
        <div><span class="pk-eyebrow">@(tr ? "Doğru kategori" : "The right category")</span><h2>@(tr ? "Tek bir yazılım kategorisine sığmaz." : "It does not fit neatly into a single software category.")</h2></div>
        <div><p class="pk-lead">@(tr ? "Pika yalnızca CRM, yalnızca BI, yalnızca bir mesaj gönderim aracı veya yalnızca AI değildir. Bu katmanların belirli işlerini, müşteriyi ve ürünü anlamaktan başlayan tek karar döngüsünde birleştirir." : "Pika is not simply a CRM, BI tool, messaging service or AI assistant. It connects relevant parts of those jobs into a decision loop that starts with understanding customers and products.")</p><div class="pk-columns"><div class="pk-feature"><h3>@(tr ? "CRM'in ötesinde" : "Beyond CRM")</h3><p>@(tr ? "Sadece 'bu müşteri kim?' değil, 'davranışı bize ne anlatıyor?' sorusuna yaklaşır." : "It goes beyond 'who is this customer?' toward 'what does their behavior tell us?'")</p></div><div class="pk-feature"><h3>@(tr ? "BI'ın ötesinde" : "Beyond BI")</h3><p>@(tr ? "Yalnız ne olduğunu göstermek yerine fırsat ve aksiyon bağlamını da görünür kılar." : "It links reporting to opportunity and action context.")</p></div><div class="pk-feature"><h3>@(tr ? "Gönderimin öncesinde" : "Before sending")</h3><p>@(tr ? "Email, SMS ve WhatsApp karardan sonra kullanılan kanallardır; Pika'nın başlangıç noktası değildir." : "Email, SMS and WhatsApp are channels used after a decision, not Pika's starting point.")</p></div></div></div>
    </div>
</section>

<section class="pk-section pk-section-soft">
    <div class="pk-container"><span class="pk-eyebrow">@(tr ? "Pika'nın ürün haritası" : "Pika product map")</span><h2>@(tr ? "Yedi menü değil, tek bir karar sistemi." : "Not a collection of menus — one decision system.")</h2><div class="pk-flow"><div class="pk-flow-item"><small>01</small><strong>@(tr ? "Veri" : "Data")</strong><span>@(tr ? "Müşteri · Ürün · Satış · Etkileşim" : "Customer · Product · Sales · Engagement")</span></div><div class="pk-flow-item"><small>02</small><strong>@(tr ? "Anlama" : "Understand")</strong><span>Customer Intelligence · Product Intelligence · Pika 360</span></div><div class="pk-flow-item"><small>03</small><strong>@(tr ? "Sinyal" : "Signal")</strong><span>@(tr ? "Değer · Ritim · Risk · Ürün ilişkisi" : "Value · Rhythm · Risk · Product relationships")</span></div><div class="pk-flow-item"><small>04</small><strong>@(tr ? "Fırsat" : "Opportunity")</strong><span>@(tr ? "Günün Fırsatları" : "Daily Opportunities")</span></div><div class="pk-flow-item"><small>05</small><strong>@(tr ? "Aksiyon" : "Action")</strong><span>Audience · Campaign · Journey · Channels</span></div><div class="pk-flow-item"><small>06</small><strong>@(tr ? "Ölçüm" : "Measure")</strong><span>Analytics · BI · @(tr ? "sonuç" : "outcomes")</span></div></div></div>
</section>

<section class="pk-section pk-section-lg">
    <div class="pk-container"><div class="pk-chapter"><div><span class="pk-eyebrow">@(tr ? "Pika neyi anlar?" : "What does Pika understand?")</span><h2>@(tr ? "Müşteri ve ürün bağlamını aynı iş sorusunda buluşturur." : "It brings customer and product context into the same business question.")</h2></div><p class="pk-lead">@(tr ? "Müşteri davranışını üründen, ürünü de müşterinin gerçek satın alma bağlamından koparmadan okumak; tekrar satın alma, cross-sell ve geri kazanım gibi fırsatların daha açıklanabilir kurulmasını sağlar." : "Reading customer behavior together with product and purchase context makes repeat-purchase, cross-sell and win-back opportunities more explainable.")</p></div><div class="pk-columns"><a class="pk-feature text-decoration-none" href="@(tr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")"><i class="ri-user-search-line"></i><h3>Customer Intelligence</h3><p>@(tr ? "Müşteri değerini, davranış değişimini, alışveriş ritmini ve risk/fırsat sinyallerini anlamlandırır." : "Adds context around customer value, behavioral change, purchase rhythm and risk/opportunity signals.")</p></a><a class="pk-feature text-decoration-none" href="@(tr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")"><i class="ri-shopping-bag-line"></i><h3>Product Intelligence</h3><p>@(tr ? "Kategori, Need Group, Product Role ve ürün ilişkilerini ticari bağlam haline getirir." : "Turns category, Need Group, Product Role and product relationships into commercial context.")</p></a><a class="pk-feature text-decoration-none" href="@(tr ? "/platform/pika-360" : "/en/platform/pika-360")"><i class="ri-focus-2-line"></i><h3>Pika 360</h3><p>@(tr ? "Bir müşterinin profil, işlem, segment, fırsat ve aksiyon bağlamını birlikte değerlendirmeyi kolaylaştırır." : "Brings profile, transactions, segments, opportunities and action context together around one customer.")</p></a></div></div>
</section>

<section class="pk-section pk-section-soft">
    <div class="pk-container pk-screen-band"><img src="/wiki/assets/images/img_aksiyon-calisma-alani_9.png" alt="@(tr ? "Pika aksiyon çalışma alanı" : "Pika action workspace")" loading="lazy" width="1200" height="760" /><div><span class="pk-eyebrow">@(tr ? "Fırsattan karara" : "From opportunity to decision")</span><h2>@(tr ? "Pika öneriyi görünür kılar; kullanıcı kontrolü korur." : "Pika makes the option visible while preserving user control.")</h2><p class="pk-lead">@(tr ? "Bir sinyalin oluşması otomatik olarak mesaj gönderilmesi anlamına gelmez. Kullanıcı fırsatın nedenini ve bağlamını değerlendirir; uygun olduğunda hedef kitleyi, Campaign veya Journey yaklaşımını ve kanalı seçer." : "A detected signal does not automatically mean a message is sent. The user reviews the reason and context, then chooses the audience, Campaign or Journey approach and channel when appropriate.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr ? "/platform/gunun-firsatlari" : "/en/platform/opportunities")">@(tr ? "Fırsat Motoru" : "Opportunity Engine")</a></div></div></div>
</section>

<section class="pk-section">
    <div class="pk-container"><div class="pk-chapter"><div><span class="pk-eyebrow">@(tr ? "Aksiyona geçin" : "Take action")</span><h2>@(tr ? "Tek seferlik kampanyadan sürekli müşteri akışına." : "From one-off campaigns to continuous customer flows.")</h2></div><p class="pk-lead">@(tr ? "Audience Manager hedef kitleyi seçer; Campaign Manager tanımlı kampanyayı yürütür; Journey Manager tetikleyici ve karar adımlarıyla sürekli akışları yönetir. Email, SMS, WhatsApp ve Push ise bu kararların iletişim kanallarıdır." : "Audience Manager selects the audience; Campaign Manager runs defined campaigns; Journey Manager handles ongoing trigger-and-decision flows. Email, SMS, WhatsApp and Push are execution channels for those decisions.")</p></div><div class="pk-columns"><a class="pk-feature text-decoration-none" href="@(tr ? "/platform/audience-manager" : "/en/platform/audience-manager")"><h3>Audience Manager</h3><p>@(tr ? "Anladığınız müşterilerden yönetilebilir hedef kitleler oluşturun." : "Turn customer understanding into manageable audiences.")</p></a><a class="pk-feature text-decoration-none" href="@(tr ? "/platform/campaign-manager" : "/en/platform/campaign-manager")"><h3>Campaign Manager</h3><p>@(tr ? "Hedef kitle, içerik, kanal ve zamanlamayı kontrollü yürütün." : "Control audience, content, channel and timing in a campaign workflow.")</p></a><a class="pk-feature text-decoration-none" href="@(tr ? "/platform/journey-manager" : "/en/platform/journey-manager")"><h3>Journey Manager</h3><p>@(tr ? "Trigger, decision, wait ve action adımlarıyla çok aşamalı akışlar kurun." : "Build multi-step flows with trigger, decision, wait and action steps.")</p></a></div></div>
</section>

<section class="pk-section pk-section-deep">
    <div class="pk-container pk-chapter"><div><span class="pk-eyebrow" style="color:#d1ea88">@(tr ? "Pika AI" : "Pika AI")</span><h2>@(tr ? "AI hesaplamanın yerine geçmez; onu kullanılır hale getirir." : "AI does not replace calculation; it helps make evidence usable.")</h2></div><div><p class="pk-lead">@(tr ? "Temel müşteri ve ürün metrikleri sistem tarafından hesaplanır. AI bu verileri açıklama, özetleme ve içerik/kampanya taslağı hazırlama aşamasında yardımcı olabilir. İş kuralı, yetki ve gönderim kararı kullanıcı ve ürün kontrollerinde kalır." : "Core customer and product metrics are system-calculated. AI can help explain, summarize and prepare content or campaign drafts. Business rules, authorization and execution remain under user and product controls.")</p><a class="pk-btn pk-btn-light" href="@(tr ? "/platform/ai-kampanya-asistani" : "/en/platform/ai-campaign-assistant")">@(tr ? "AI Kampanya Asistanı" : "AI Campaign Assistant")</a></div></div>
</section>

<section class="pk-section pk-section-lg">
    <div class="pk-container"><div class="pk-chapter"><div><span class="pk-eyebrow">@(tr ? "Kimler için?" : "Who is it for?")</span><h2>@(tr ? "Verisi olan ama kararı hâlâ manuel kalan ekipler için." : "For teams with data whose decisions are still too manual.")</h2></div><div><p class="pk-lead">@(tr ? "Pika özellikle tekrar eden müşteri ilişkisi, anlamlı ürün/hizmet çeşitliliği ve kullanılabilir satış geçmişi bulunan yapılarda değer üretir. Başlangıç için kusursuz veri gerekmez; ancak kullanılacak özelliği besleyecek minimum veri bağlamı gerekir." : "Pika is especially useful where customer relationships repeat, products or services carry meaningful variety, and usable sales history exists. Perfect data is not required, but each capability needs enough evidence to work reliably.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr ? "/kullanim-senaryolari" : "/en/use-cases")">@(tr ? "Kullanım Senaryoları" : "Use Cases")</a><a class="pk-btn pk-btn-ghost" href="/wiki/pika-hangi-verileri-kullanir">@(tr ? "Veri Gereksinimlerini Okuyun" : "Read Data Requirements")</a></div></div></div></div>
</section>

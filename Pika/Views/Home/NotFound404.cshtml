@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var isTr = culture == "tr";
    ViewData["Title"] = isTr ? "404 - Sayfa Bulunamadı" : "404 - Page Not Found";
    ViewData["MetaDescription"] = isTr ? "Aradığınız sayfa bulunamadı veya taşınmış olabilir." : "The page you are looking for could not be found or has been moved.";
    ViewData["RobotsMeta"] = "noindex, nofollow";
    ViewData["CanonicalUrl"] = "";
    var homeUrl = isTr ? "/" : "/en/";
}

<section class="pika-section" style="padding: 100px 0; min-height: 60vh; display: flex; align-items: center;">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8 col-md-10">
                <div style="font-size: 6rem; font-weight: 800; color: var(--pika-primary, #0c3a30); line-height: 1; margin-bottom: 20px;">
                    404
                </div>
                <h1 class="pika-h2 fw-bold mb-3">
                    @(isTr ? "Sayfa Bulunamadı" : "Page Not Found")
                </h1>
                <p class="text-secondary mx-auto mb-4" style="max-width: 540px; font-size: 1.1rem;">
                    @(isTr 
                        ? "Aradığınız sayfa kaldırılmış, adı değiştirilmiş veya geçici olarak kullanım dışı kalmış olabilir." 
                        : "The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.")
                </p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a href="@homeUrl" class="btn pika-btn-primary px-4 py-2">
                        <i class="ri-home-4-line me-1"></i> @(isTr ? "Ana Sayfaya Dön" : "Back to Home")
                    </a>
                    <a href="@(isTr ? "/iletisim" : "/en/contact")" class="btn pika-btn-outline px-4 py-2">
                        <i class="ri-mail-line me-1"></i> @(isTr ? "İletişime Geç" : "Contact Us")
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

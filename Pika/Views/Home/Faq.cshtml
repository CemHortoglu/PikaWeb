@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr = culture == "tr";
    ViewData["BodyClass"] = "pika-solutions-page";
}

@section Styles {
    <link href="~/css/faq.css" rel="stylesheet" asp-append-version="true" />
}

<!-- ═══════════════════════════ 01 HERO ═══════════════════════════ -->
<section class="inner-hero inner-hero--knowledge">
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <span>@(tr ? "Sıkça Sorulan Sorular" : "FAQ")</span>
            </nav>
            <div class="inner-eyebrow" aria-label="@(tr ? "Sıkça Sorulan Sorular" : "Frequently Asked Questions")">
                <span></span>@(tr ? "Sıkça Sorulan Sorular" : "Frequently Asked Questions")
            </div>
            <span class="badge bg-light text-dark border px-2 py-1 mb-3 fs-6">Pika FAQ</span>
            <h1>
                @(tr
                    ? "Pika'yı değerlendirirken temel soruların yanıtlarını tek yerde bulun."
                    : "Find clear answers to the core questions that come up when evaluating Pika.")
            </h1>
            <p>
                @(tr
                    ? "Pika'nın veri, müşteri ve ürün zekâsı, fırsat, audience, campaign, journey, iletişim kanalları, izin, güvenlik, AI ve ticari değerlendirme yaklaşımı hakkında temel soruları açık ürün sınırlarıyla yanıtlıyoruz."
                    : "Find clear answers about Pika's data, customer and product intelligence, opportunities, audiences, campaigns, journeys, communication channels, consent, security, AI and commercial-evaluation approach.")
            </p>
            <p class="text-muted small">
                @(tr
                    ? "Bu sayfa kamuya açık ürün değerlendirme sorularını yanıtlar; teknik kullanım adımları, operasyon dokümantasyonu veya hukuki danışmanlığın yerine geçmez."
                    : "This page answers public product-evaluation questions; it does not replace technical usage documentation, operational documentation or legal advice.")
            </p>
            <div class="inner-actions">
                <a class="inner-primary" href="@(tr ? "/demo-talebi" : "/en/demo-request")">
                    @(tr ? "Demo Talep Et ↗" : "Request a Demo ↗")
                </a>
                <a class="inner-secondary" href="@(tr ? "/pika" : "/en/pika")">
                    @(tr ? "Pika'yı Keşfedin →" : "Explore Pika →")
                </a>
                <a class="inner-hero-anchor" href="#inner-content" aria-label="@(tr ? "İçeriğe atla" : "Skip to content")">
                    <i class="ri-arrow-down-line" aria-hidden="true"></i>
                </a>
            </div>
        </div>

        <div class="inner-scene" aria-hidden="true">
            <div class="inner-scene-orbit"></div>
            <div class="inner-scene-window">
                <div class="inner-window-bar">
                    <strong>pika<span>✳</span></strong>
                    <span>Pika FAQ</span>
                    <small>@(tr ? "Örnek görünüm" : "Illustration")</small>
                </div>
                <div class="inner-knowledge">
                    <div><i class="ri-information-line" aria-hidden="true"></i>@(tr ? "Pika Hakkında" : "About Pika")<b>↗</b></div>
                    <div><i class="ri-database-2-line" aria-hidden="true"></i>@(tr ? "Veri & Entegrasyon" : "Data & Integrations")<b>↗</b></div>
                    <div><i class="ri-brain-line" aria-hidden="true"></i>@(tr ? "Intelligence & Fırsatlar" : "Intelligence & Opportunities")<b>↗</b></div>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="inner-content" class="inner-anchor"></div>

<!-- ═══════════════════════════ FAQ BODY ═══════════════════════════ -->
<section class="faq-section">
    <div class="container">
        <div class="row g-5">
            <!-- Navigation Sidebar -->
            <div class="col-lg-3">
                <div class="faq-nav-sidebar sticky-top" style="top:90px;z-index:10">
                    <h6 class="faq-nav-title">@(tr ? "KATEGORİLER" : "CATEGORIES")</h6>
                    <nav class="nav flex-column faq-nav-links">
                        <a class="nav-link active" href="#cat-about"><i class="ri-information-line"></i> @(tr ? "Pika Hakkında" : "About Pika")</a>
                        <a class="nav-link" href="#cat-data"><i class="ri-database-2-line"></i> @(tr ? "Veri & Entegrasyon" : "Data & Integrations")</a>
                        <a class="nav-link" href="#cat-intel"><i class="ri-brain-line"></i> @(tr ? "Intelligence & Fırsatlar" : "Intelligence & Opportunities")</a>
                        <a class="nav-link" href="#cat-audience"><i class="ri-route-line"></i> @(tr ? "Audience, İçerik & Aksiyon" : "Audience, Content & Action")</a>
                        <a class="nav-link" href="#cat-channels"><i class="ri-mail-send-line"></i> @(tr ? "Kanallar & Ölçüm" : "Channels & Measurement")</a>
                        <a class="nav-link" href="#cat-consent"><i class="ri-shield-check-line"></i> @(tr ? "İzin & Güvenlik" : "Consent & Security")</a>
                        <a class="nav-link" href="#cat-ai"><i class="ri-sparkling-2-line"></i> @(tr ? "AI & İnsan Kontrolü" : "AI & Human Control")</a>
                        <a class="nav-link" href="#cat-demo"><i class="ri-rocket-line"></i> @(tr ? "Demo & Ticari Değerlendirme" : "Demo & Commercial Evaluation")</a>
                    </nav>

                    <div class="faq-sidebar-box mt-4 p-3 rounded-3 bg-light border">
                        <div class="small fw-bold text-dark mb-1">
                            @(tr ? "Sorunuz kullanım senaryonuza mı bağlı?" : "Does your question depend on your usage scenario?")
                        </div>
                        <p class="small text-muted mb-2">
                            @(tr ? "Veri, entegrasyon ve ürün kapsamınızı gerçek kullanım bağlamınız üzerinden birlikte değerlendirebiliriz." : "We can evaluate your data, integration and product scope together within your actual usage context.")
                        </p>
                        <a href="@(tr ? "/demo-talebi" : "/en/demo-request")" class="small fw-bold text-success text-decoration-none">
                            @(tr ? "Demo Talep Et →" : "Request a Demo →")
                        </a>
                    </div>
                </div>
            </div>

            <!-- Content Area -->
            <div class="col-lg-9">

                <!-- 1. PİKA HAKKINDA / ABOUT PIKA -->
                <div id="cat-about" class="faq-group mb-5">
                    <div class="faq-group-header">
                        <div class="faq-group-badge"><i class="ri-information-line"></i></div>
                        <h2 class="faq-group-title">@(tr ? "Pika Hakkında" : "About Pika")</h2>
                    </div>

                    <div class="accordion faq-accordion" id="accAbout">
                        <!-- Q1 -->
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q1" aria-expanded="false" aria-controls="q1">
                                    @(tr ? "Pika nedir?" : "What is Pika?")
                                </button>
                            </h3>
                            <div id="q1" class="accordion-collapse collapse" data-bs-parent="#accAbout">
                                <div class="accordion-body">
                                    <p>
                                        @(tr
                                            ? "Pika; müşteri, ürün ve satış verisini birlikte anlamlandırarak işletmenin bugün hangi müşteride hangi ticari fırsatın oluştuğunu görmesini ve bu fırsatı kontrollü, ölçülebilir çok kanallı aksiyona dönüştürmesini sağlayan Müşteri Zekâsı ve Omnichannel Pazarlama Platformudur."
                                            : "Pika is a Customer Intelligence & Omnichannel Marketing Platform that brings customer, product and sales data together to identify commercial opportunities and turn them into controlled, measurable omnichannel actions.")
                                    </p>
                                    <a href="@(tr ? "/pika" : "/en/pika")" class="faq-inline-link">
                                        @(tr ? "Pika'yı Keşfedin →" : "Explore Pika →")
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Q2 -->
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q2" aria-expanded="false" aria-controls="q2">
                                    @(tr ? "Pika bir CRM midir?" : "Is Pika a CRM?")
                                </button>
                            </h3>
                            <div id="q2" class="accordion-collapse collapse" data-bs-parent="#accAbout">
                                <div class="accordion-body">
                                    <p>
                                        @(tr
                                            ? "Pika geleneksel satış fırsatı, müşteri görüşmesi veya satış temsilcisi aktivitesi takip CRM'i olarak konumlandırılmaz. Mevcut müşteri, ürün ve işlem verisini intelligence, fırsat, audience ve kontrollü pazarlama aksiyonu bağlamında kullanır."
                                            : "Pika is not positioned as a traditional CRM for tracking sales opportunities, customer conversations or sales-representative activity. It uses existing customer, product and transaction data within intelligence, opportunity, audience and controlled marketing-action context.")
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Q3 -->
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q3" aria-expanded="false" aria-controls="q3">
                                    @(tr ? "Pika yalnızca mesaj veya kampanya gönderim aracı mıdır?" : "Is Pika only a messaging or campaign-delivery tool?")
                                </button>
                            </h3>
                            <div id="q3" class="accordion-collapse collapse" data-bs-parent="#accAbout">
                                <div class="accordion-body">
                                    <p>
                                        @(tr
                                            ? "Hayır. Email, SMS ve WhatsApp Pika'nın iletişim execution kanallarıdır. Platformun başlangıç noktası müşteri ve ürün verisini anlamlandırmak, ticari fırsat ve karar bağlamı oluşturmak ve ardından kontrollü aksiyona geçmektir."
                                            : "No. Email, SMS and WhatsApp are Pika's communication execution channels. The platform begins with understanding customer and product data, creating commercial opportunity and decision context and then moving into controlled action.")
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Q4 -->
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q4" aria-expanded="false" aria-controls="q4">
                                    @(tr ? "Pika hangi işletmeler için anlamlıdır?" : "What kinds of organizations can evaluate Pika?")
                                </button>
                            </h3>
                            <div id="q4" class="accordion-collapse collapse" data-bs-parent="#accAbout">
                                <div class="accordion-body">
                                    <p>
                                        @(tr
                                            ? "Pika; müşteri, ürün ve işlem verisini pazarlama kararlarıyla ilişkilendirmek, ticari fırsatları görünür hale getirmek ve bu bağlamı kontrollü çok kanallı aksiyona taşımak isteyen işletmeler için değerlendirilir. C21 belirli şirket büyüklüğü, sektör veya müşteri sayısı şartı iddia etmez."
                                            : "Pika can be evaluated by organizations that want to connect customer, product and transaction data to marketing decisions, make commercial opportunities visible and turn that context into controlled omnichannel action. C21 does not claim a required company size, industry or customer count.")
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. VERİ & ENTEGRASYON / DATA & INTEGRATIONS -->
                <div id="cat-data" class="faq-group mb-5">
                    <div class="faq-group-header">
                        <div class="faq-group-badge"><i class="ri-database-2-line"></i></div>
                        <h2 class="faq-group-title">@(tr ? "Veri & Entegrasyon" : "Data & Integrations")</h2>
                    </div>

                    <div class="accordion faq-accordion" id="accData">
                        <!-- Q5 -->
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q5" aria-expanded="false" aria-controls="q5">
                                    @(tr ? "Pika hangi temel veri bağlamıyla çalışır?" : "What core data context does Pika use?")
                                </button>
                            </h3>
                            <div id="q5" class="accordion-collapse collapse" data-bs-parent="#accData">
                                <div class="accordion-body">
                                    <p>
                                        @(tr
                                            ? "Pika'nın çekirdek veri bağlamı müşteri, ürün ve işlem verisidir. Kullanım senaryosuna göre gerekli alanların ve veri kapsamının ayrıntısı entegrasyon değerlendirmesinde netleştirilir."
                                            : "Pika's core data context consists of customer, product and transaction data. The exact fields and data scope required depend on the usage scenario and are clarified during integration evaluation.")
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Q6 -->
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q6" aria-expanded="false" aria-controls="q6">
                                    @(tr ? "Excel veya CSV ile Pika'ya veri aktarılabilir mi?" : "Can data be imported into Pika with Excel or CSV?")
                                </button>
                            </h3>
                            <div id="q6" class="accordion-collapse collapse" data-bs-parent="#accData">
                                <div class="accordion-body">
                                    <p>
                                        @(tr
                                            ? "Evet. Excel ve CSV, Pika'nın doğrulanmış veri giriş yolları arasındadır. Müşteri, ürün ve işlem verisi uygun dosya yapısıyla aktarılabilir."
                                            : "Yes. Excel and CSV are among Pika's verified data-intake paths. Customer, product and transaction data can be imported using an appropriate file structure.")
                                    </p>
                                    <a href="@(tr ? "/entegrasyonlar" : "/en/integrations")" class="faq-inline-link">
                                        @(tr ? "Entegrasyonları Keşfedin →" : "Explore Integrations →")
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Q7 -->
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q7" aria-expanded="false" aria-controls="q7">
                                    @(tr ? "Pika'nın REST Ingestion API'si var mı?" : "Does Pika provide a REST Ingestion API?")
                                </button>
                            </h3>
                            <div id="q7" class="accordion-collapse collapse" data-bs-parent="#accData">
                                <div class="accordion-body">
                                    <p>
                                        @(tr
                                            ? "Evet. Pika'nın dokümante edilmiş REST Ingestion API'si programatik veri aktarımı için kullanılabilir. API erişiminde X-API-Key, tekrar eden request'lerin kontrolünde ise X-Idempotency-Key bağlamı bulunur."
                                            : "Yes. Pika's documented REST Ingestion API can be used for programmatic data ingestion. API access includes X-API-Key context, while X-Idempotency-Key is used in the context of controlling repeated requests.")
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Q8 -->
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q8" aria-expanded="false" aria-controls="q8">
                                    @(tr ? "Pika her CRM, ERP veya e-ticaret ürünü için hazır connector sunuyor mu?" : "Does Pika provide a ready-made connector for every CRM, ERP or e-commerce product?")
                                </button>
                            </h3>
                            <div id="q8" class="accordion-collapse collapse" data-bs-parent="#accData">
                                <div class="accordion-body">
                                    <p>
                                        @(tr
                                            ? "C21 böyle bir iddia yapmaz. CRM, ERP, POS, e-ticaret veya veri ambarı gibi sistemler veri kaynağı kategorileri olabilir; gerçek entegrasyon kapsamı kullanılacak API, dosya akışı ve veri kontratına göre değerlendirilir."
                                            : "C21 makes no such claim. Systems such as CRM, ERP, POS, e-commerce or data warehouses can be source-system categories; actual integration scope depends on the API, file flow and data contract being used.")
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. INTELLIGENCE & FIRSATLAR / INTELLIGENCE & OPPORTUNITIES -->
                <div id="cat-intel" class="faq-group mb-5">
                    <div class="faq-group-header">
                        <div class="faq-group-badge"><i class="ri-brain-line"></i></div>
                        <h2 class="faq-group-title">@(tr ? "Intelligence & Fırsatlar" : "Intelligence & Opportunities")</h2>
                    </div>

                    <div class="accordion faq-accordion" id="accIntel">
                        <!-- Q9 -->
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q9" aria-expanded="false" aria-controls="q9">
                                    @(tr ? "Customer Intelligence ne yapar?" : "What does Customer Intelligence do?")
                                </button>
                            </h3>
                            <div id="q9" class="accordion-collapse collapse" data-bs-parent="#accIntel">
                                <div class="accordion-body">
                                    <p>
                                        @(tr
                                            ? "Customer Intelligence müşteri davranışı, değer ve satın alma bağlamını veriden hesaplayarak müşteriyi daha anlamlı biçimde değerlendirmeye yardımcı olan Pika intelligence katmanıdır."
                                            : "Customer Intelligence is Pika's intelligence layer for calculating customer behavior, value and purchase context from data so customers can be evaluated more meaningfully.")
                                    </p>
                                    <a href="@(tr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")" class="faq-inline-link">
                                        @(tr ? "Customer Intelligence'ı Keşfedin →" : "Explore Customer Intelligence →")
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Q10 -->
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q10" aria-expanded="false" aria-controls="q10">
                                    @(tr ? "Product Intelligence ne yapar?" : "What does Product Intelligence do?")
                                </button>
                            </h3>
                            <div id="q10" class="accordion-collapse collapse" data-bs-parent="#accIntel">
                                <div class="accordion-body">
                                    <p>
                                        @(tr
                                            ? "Product Intelligence ürünlerin yalnızca katalog kaydı olarak değil, ticari anlamları, satın alma davranışları ve diğer ürünlerle ilişkileri bağlamında değerlendirilmesine yardımcı olan Pika intelligence katmanıdır."
                                            : "Product Intelligence is Pika's intelligence layer for evaluating products not only as catalog records, but through their commercial meaning, purchase behavior and relationships with other products.")
                                    </p>
                                    <a href="@(tr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")" class="faq-inline-link">
                                        @(tr ? "Product Intelligence'ı Keşfedin →" : "Explore Product Intelligence →")
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Q11 -->
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q11" aria-expanded="false" aria-controls="q11">
                                    @(tr ? "Pika 360 nedir?" : "What is Pika 360?")
                                </button>
                            </h3>
                            <div id="q11" class="accordion-collapse collapse" data-bs-parent="#accIntel">
                                <div class="accordion-body">
                                    <p>
                                        @(tr
                                            ? "Pika 360, müşteri bağlamını ilgili intelligence ve ticari değerlendirme sonuçlarıyla birlikte incelemeye yardımcı olan Pika görünümüdür. Tek başına kampanya veya iletişim kanalı değildir."
                                            : "Pika 360 is a Pika view for evaluating customer context together with relevant intelligence and commercial-evaluation outcomes. It is not itself a campaign or communication channel.")
                                    </p>
                                    <a href="@(tr ? "/platform/pika-360" : "/en/platform/pika-360")" class="faq-inline-link">
                                        @(tr ? "Pika 360'ı Keşfedin →" : "Explore Pika 360 →")
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Q12 -->
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q12" aria-expanded="false" aria-controls="q12">
                                    @(tr ? "Günün Fırsatları nedir?" : "What is Daily Opportunities?")
                                </button>
                            </h3>
                            <div id="q12" class="accordion-collapse collapse" data-bs-parent="#accIntel">
                                <div class="accordion-body">
                                    <p>
                                        @(tr
                                            ? "Günün Fırsatları, Pika'nın hesapladığı müşteri, ürün ve işlem bağlamından değerlendirilebilir ticari fırsatları kullanıcıya görünür hale getiren karar katmanıdır. Fırsatı kullanıcı değerlendirmesine sunar; kendi başına otonom iletişim göndermez."
                                            : "Daily Opportunities is Pika's decision layer for making evaluable commercial opportunities visible from calculated customer, product and transaction context. It presents opportunities for user evaluation and does not autonomously send communication.")
                                    </p>
                                    <a href="@(tr ? "/platform/gunun-firsatlari" : "/en/platform/opportunities")" class="faq-inline-link">
                                        @(tr ? "Günün Fırsatları'nı Keşfedin →" : "Explore Daily Opportunities →")
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. AUDIENCE, CONTENT & ACTION -->
                <div id="cat-audience" class="faq-group mb-5">
                    <div class="faq-group-header">
                        <div class="faq-group-badge"><i class="ri-route-line"></i></div>
                        <h2 class="faq-group-title">@(tr ? "Audience, İçerik & Aksiyon" : "Audience, Content & Action")</h2>
                    </div>

                    <div class="accordion faq-accordion" id="accAudience">
                        <!-- Q13 -->
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q13" aria-expanded="false" aria-controls="q13">
                                    @(tr ? "Audience Manager ne yapar?" : "What does Audience Manager do?")
                                </button>
                            </h3>
                            <div id="q13" class="accordion-collapse collapse" data-bs-parent="#accAudience">
                                <div class="accordion-body">
                                    <p>
                                        @(tr
                                            ? "Audience Manager müşteri verisi, işlem veya davranış bağlamı ve açık kurallar üzerinden gerçek hedef kitle tanımını yönetir. Bir fırsat listesi veya iletişim kanalı kendi başına audience gerçeği değildir."
                                            : "Audience Manager manages the actual audience definition through customer data, transaction or behavioral context and explicit rules. An opportunity list or communication channel is not itself audience truth.")
                                    </p>
                                    <a href="@(tr ? "/cozumler/audience-manager" : "/en/solutions/audience-manager")" class="faq-inline-link">
                                        @(tr ? "Audience Manager'ı Keşfedin →" : "Explore Audience Manager →")
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Q14 -->
                        <div class="accordion-item">
                            <h3 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#q14" aria-expanded="false" aria-controls="q14">

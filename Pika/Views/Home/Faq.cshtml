@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr = culture == "tr";
    ViewData["Title"] = tr ? "Sık Sorulan Sorular" : "Frequently Asked Questions";
    ViewData["MetaDescription"] = tr ? "Pika, veri, Customer Intelligence, Product Intelligence, Günün Fırsatları, Campaign, Journey, kanallar, AI, izin ve kurulum hakkında sık sorulan sorular." : "Frequently asked questions about Pika, data, intelligence, opportunities, Campaign, Journey, channels, AI, consent and onboarding.";
    ViewData["BodyClass"] = "pk-page pk-faq";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">@(tr ? "Kaynaklar · S.S.S." : "Resources · FAQ")</span><h1>@(tr ? "Pika hakkında doğru soruya kısa cevap." : "Short answers to the right questions about Pika.")</h1><p>@(tr ? "Burada ürünün ne olduğu, hangi veriye ihtiyaç duyduğu, intelligence katmanları, Günün Fırsatları, Campaign/Journey, AI, kanallar ve izin süreçleriyle ilgili temel soruları yanıtlıyoruz. Ayrıntı gerektiğinde ilgili ürün veya Bilgi Bankası sayfasına yönlendiriyoruz." : "This page answers core questions about the product, data requirements, intelligence layers, Daily Opportunities, Campaign/Journey, AI, channels and consent, with links to deeper product and Knowledge Base pages.")</p></div><div class="pk-proof" style="padding:30px"><span class="pk-eyebrow">@(tr ? "Aradığınız cevap daha ayrıntılı mı?" : "Need a deeper answer?")</span><h2 style="font-size:30px">@(tr ? "Public Bilgi Bankası ürünün ayrıntılı kaynağıdır." : "The public Knowledge Base is the detailed product source.")</h2><p class="pk-lead" style="font-size:15px">@(tr ? "Kullanım rehberleri, veri gereksinimleri, Product Intelligence, Pika 360, fırsatlar, izinler ve daha fazlası." : "Usage guides, data requirements, Product Intelligence, Pika 360, opportunities, consent and more.")</p><a class="pk-btn pk-btn-ghost" href="/wiki/">@(tr ? "Bilgi Bankasına Git" : "Open Knowledge Base")</a></div></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container pk-faq-layout"><nav class="pk-faq-nav" aria-label="FAQ groups"><a href="#pika">Pika</a><a href="#veri">@(tr ? "Veri ve kurulum" : "Data & onboarding")</a><a href="#zeka">Intelligence</a><a href="#firsatlar">@(tr ? "Fırsatlar" : "Opportunities")</a><a href="#aksiyon">Campaign & Journey</a><a href="#ai">AI</a><a href="#izin">@(tr ? "İzin ve güven" : "Consent & trust")</a></nav><div>
<div class="pk-faq-group" id="pika"><span class="pk-eyebrow">01</span><h2>@(tr ? "Pika hakkında" : "About Pika")</h2>
<details open><summary>@(tr ? "Pika nedir?" : "What is Pika?")</summary><p>@(tr ? "Pika; müşteri, ürün, satış ve etkileşim verisini anlamlandırarak fırsatları görünür kılan ve bu fırsatları yönetilebilir Campaign, Journey ve kanal aksiyonlarına bağlayan müşteri zekâsı ve pazarlama platformudur." : "Pika is a customer intelligence and marketing platform that turns customer, product, sales and engagement data into visible opportunities and manageable Campaign, Journey and channel actions.") <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika'yı ayrıntılı tanıyın." : "Learn more about Pika.")</a></p></details>
<details><summary>@(tr ? "Pika bir CRM midir?" : "Is Pika a CRM?")</summary><p>@(tr ? "Pika yalnızca müşteri kaydı tutan klasik bir CRM değildir. Odağı müşteri ve ürün davranışını, ticari sinyalleri, fırsatları ve aksiyon bağlamını anlamlandırmaktır." : "Pika is not simply a classic CRM for storing customer records. Its focus is understanding customer/product behavior, commercial signals, opportunities and action context.")</p></details>
<details><summary>@(tr ? "Pika yalnızca kampanya veya mesaj gönderim sistemi midir?" : "Is Pika only a campaign or messaging tool?")</summary><p>@(tr ? "Hayır. Email, SMS, WhatsApp ve Push karar zincirinin aksiyon kanallarıdır. Pika'nın ürün hikâyesi veri, intelligence ve fırsat katmanlarından başlar." : "No. Email, SMS, WhatsApp and Push are execution channels. Pika's product story starts with data, intelligence and opportunity context.")</p></details>
</div>
<div class="pk-faq-group" id="veri"><span class="pk-eyebrow">02</span><h2>@(tr ? "Veri ve kurulum" : "Data & onboarding")</h2>
<details><summary>@(tr ? "Pika hangi verilere ihtiyaç duyar?" : "What data does Pika need?")</summary><p>@(tr ? "Kullanılacak özelliğe göre değişir. Temel müşteri kimliği, ürün/hizmet kimliği ve satış/fatura/sipariş geçmişi birçok senaryo için başlangıç bağlamıdır. Her capability'nin minimum veri gereksinimi ayrıdır." : "It depends on the capability. Customer identity, product/service identity and sales/invoice/order history form the starting context for many scenarios; each capability has its own minimum evidence.") <a href="/wiki/ozellik-veri-gereksinimleri">@(tr ? "Veri gereksinimi matrisini görün." : "See the data-requirements matrix.")</a></p></details>
<details><summary>@(tr ? "Excel veya CSV ile başlayabilir miyim?" : "Can I start with Excel or CSV?")</summary><p>@(tr ? "Evet. Kontrollü pilot ve ilk veri keşfi için Excel/CSV kullanılabilir; düzenli ve ölçekli akış için API/entegrasyon tercih edilir." : "Yes. Excel/CSV can support controlled pilots and initial data discovery; regular scaled flows typically move to API/integration.") <a href="/wiki/excel-csv-aktarimi">@(tr ? "Aktarım rehberi." : "Import guide.")</a></p></details>
<details><summary>@(tr ? "Verimiz eksikse Pika çalışmaz mı?" : "Does Pika stop working if data is incomplete?")</summary><p>@(tr ? "Her özellik için mükemmel veri gerekmez; ancak ilgili analitiğin minimum kanıtı gerekir. Eksik müşteri, ürün, mağaza veya kanal bağlamı coverage ve karar değerini düşürebilir." : "Perfect data is not required for every capability, but each analytic needs minimum evidence. Missing customer, product, store or channel context can reduce coverage and decision value.")</p></details>
</div>
<div class="pk-faq-group" id="zeka"><span class="pk-eyebrow">03</span><h2>Customer & Product Intelligence</h2>
<details><summary>Customer Intelligence @(tr ? "nedir?" : "— what is it?")</summary><p>@(tr ? "Müşteri davranışı, gerçekleşmiş alışveriş, değer, ritim ve risk/fırsat sinyallerini aynı müşteri bağlamında değerlendiren anlama katmanıdır." : "It is the understanding layer that combines observed purchases, value, rhythm and risk/opportunity signals around customer behavior.") <a href="@(tr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")">Customer Intelligence →</a></p></details>
<details><summary>Product Intelligence @(tr ? "nedir?" : "— what is it?")</summary><p>@(tr ? "Ürünleri yalnızca kod/isim olarak değil; kategori, Need Group, Product Role ve satın alma ilişkileriyle anlamlandırır." : "It understands products beyond codes/names through category, Need Group, Product Role and purchase relationships.") <a href="@(tr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")">Product Intelligence →</a></p></details>
<details><summary>Pika 360 @(tr ? "nedir?" : "— what is it?")</summary><p>@(tr ? "Bir müşterinin profil, davranış, satın alma, segment, fırsat ve aksiyon bağlamını tek görünümde değerlendirmeyi kolaylaştıran karar ekranıdır." : "It is a decision view that brings profile, behavior, purchases, segments, opportunities and action context together around one customer.") <a href="@(tr ? "/platform/pika-360" : "/en/platform/pika-360")">Pika 360 →</a></p></details>
</div>
<div class="pk-faq-group" id="firsatlar"><span class="pk-eyebrow">04</span><h2>@(tr ? "Fırsatlar" : "Opportunities")</h2>
<details><summary>@(tr ? "Günün Fırsatları nedir?" : "What are Daily Opportunities?")</summary><p>@(tr ? "Pika'nın müşteri ve ürün verisinden aksiyona temel olabilecek ticari durumları kullanıcıya sunduğu çalışma alanıdır. Fırsatın oluşması otomatik gönderim anlamına gelmez; kullanıcı bağlamı değerlendirir ve aksiyonu seçer." : "It is the workspace where Pika surfaces commercial situations that may justify action. Detecting an opportunity does not automatically send a message; the user reviews context and chooses action.") <a href="@(tr ? "/platform/gunun-firsatlari" : "/en/platform/opportunities")">@(tr ? "Günün Fırsatları →" : "Daily Opportunities →")</a></p></details>
<details><summary>@(tr ? "Cross-sell müşteriye özel başarı olasılığı üretir mi?" : "Does cross-sell produce a customer-specific success probability?")</summary><p>@(tr ? "Standart Cross-sell BI önce ürün çiftlerinin sepet birlikteliğini support, confidence ve lift ile analiz eder. Müşteriye özel aksiyon bundan sonraki katmanda müşteri ve Product Intelligence bağlamıyla kurulabilir; ölçülmemiş bir olasılık varmış gibi sunulmaz." : "Standard Cross-sell BI first analyzes basket co-occurrence with support, confidence and lift. Customer-specific action can then add customer and Product Intelligence context; an unmeasured probability is not invented.")</p></details>
</div>
<div class="pk-faq-group" id="aksiyon"><span class="pk-eyebrow">05</span><h2>Campaign & Journey</h2>
<details><summary>@(tr ? "Campaign Manager ile Journey Manager arasındaki fark nedir?" : "What is the difference between Campaign Manager and Journey Manager?")</summary><p>@(tr ? "Campaign Manager tanımlı hedef kitle, içerik, kanal ve zamanlamayla kontrollü bir kampanya yürütür. Journey Manager tetikleyici, karar, bekleme ve aksiyon adımlarıyla çok aşamalı müşteri akışını yönetir." : "Campaign Manager runs a defined campaign with audience, content, channel and timing. Journey Manager manages multi-step customer flows with triggers, decisions, waits and actions.")</p></details>
<details><summary>@(tr ? "Hangi iletişim kanalları kullanılır?" : "Which communication channels are used?")</summary><p>@(tr ? "Pika'da Email, SMS, WhatsApp ve Push aksiyon kanalları bulunur. Kullanılabilir kanal müşteri iletişim bilgisi, izin/opt-out ve ilgili kanal uygunluğuna bağlıdır." : "Pika provides Email, SMS, WhatsApp and Push as action channels. Eligibility depends on customer contact data, consent/opt-out and channel context.")</p></details>
</div>
<div class="pk-faq-group" id="ai"><span class="pk-eyebrow">06</span><h2>Pika AI</h2>
<details><summary>@(tr ? "Pika AI ne yapar?" : "What does Pika AI do?")</summary><p>@(tr ? "Sistem tarafından hesaplanan bağlamı açıklama ve özetleme; kampanya yaklaşımı ve içerik taslağı hazırlama gibi yardımcı görevlerde kullanılır." : "It assists with explaining and summarizing system-calculated context and preparing campaign approaches or content drafts.")</p></details>
<details><summary>@(tr ? "AI kendi başına kampanya gönderir mi?" : "Does AI send campaigns autonomously?")</summary><p>@(tr ? "Pika'nın ürün yaklaşımında AI yorum ve üretim desteğidir; yetki, iş kuralı ve aksiyon kontrolü kullanıcı ve ürün kontrollerinde kalır." : "In Pika's product model AI supports interpretation and drafting; authorization, business rules and execution control stay with users and product controls.")</p></details>
</div>
<div class="pk-faq-group" id="izin"><span class="pk-eyebrow">07</span><h2>@(tr ? "İzin ve güven" : "Consent & trust")</h2>
<details><summary>@(tr ? "Kişiyi Pika'ya aktarmak iletişim izni anlamına gelir mi?" : "Does importing a contact mean marketing consent?")</summary><p>@(tr ? "Hayır. Kişi kaydı, iletişim izni ve kanal uygunluğu ayrı kavramlardır. Gerçek iletişim aksiyonu öncesinde ilgili kanalın izin, opt-out ve ulaşılabilirlik durumu değerlendirilmelidir." : "No. A contact record, communication consent and channel eligibility are separate concepts. Consent, opt-out and reachability should be evaluated before actual communication.") <a href="/wiki/gmail-kisi-aktarimi">@(tr ? "Gmail/Outlook kişi aktarımı." : "Gmail/Outlook contact import.")</a></p></details>
<details><summary>@(tr ? "İYS'nin rolü nedir?" : "What is the role of IYS?")</summary><p>@(tr ? "Pika'da İYS entegrasyonuna yönelik servis ve yönetim ekranı bulunur; izin durumunun operasyonel karar zincirine taşınmasına yardımcı olur. Bu, tüm hukuki sorumluluğun otomatik olarak Pika'ya geçtiği anlamına gelmez." : "Pika includes service and management support for IYS integration so consent status can inform operational decisions. This does not automatically transfer all legal responsibility to Pika.") <a href="@(tr ? "/guvenlik-ve-gizlilik" : "/en/security-and-privacy")">@(tr ? "Güvenlik ve Gizlilik →" : "Security & Privacy →")</a></p></details>
</div>
</div></div></section>

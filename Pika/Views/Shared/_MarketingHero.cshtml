@{
    var tr = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").Equals("tr", StringComparison.OrdinalIgnoreCase);
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var pages = new Dictionary<string, (string Label, string Tr, string En, string DescTr, string DescEn, string Scene)> {
        ["CustomerIntelligence"] = ("Customer Intelligence", "Her müşterinin arkasında bir hikâye var.", "Every customer has a story.", "Alışveriş ritmini, müşteri değerini ve değişen ihtiyaçları birlikte görün. Bir sonraki iletişiminize doğru bağlamla başlayın.", "See purchase rhythms, customer value and changing needs together. Bring the right context to your next conversation.", "customer"),
        ["ProductIntelligence"] = ("Product Intelligence", "Ürünlerinizi, müşterinizin gözünden görün.", "See your products through your customers’ eyes.", "Ürün rollerini ve birlikte satın alma davranışlarını keşfedin. Kataloğunuzu anlamlı önerilere dönüştürün.", "Discover product roles and co-purchase behavior. Turn your catalog into relevant recommendations.", "product"),
        ["Pika360"] = ("Pika 360", "Bir müşteri. Bütün hikâye.", "One customer. The whole story.", "Geçmiş alışverişler, etkileşimler ve açık fırsatlar tek görünümde. Müşteriniz için bir sonraki adımı daha net değerlendirin.", "Purchases, interactions and open opportunities in one view. Make a more informed next move for your customer.", "customer"),
        ["Opportunities"] = (tr ? "Günün Fırsatları" : "Daily Opportunities", "Bugünün verisi. Yarının fırsatı.", "Today’s insight. Tomorrow’s opportunity.", "Tekrar alışveriş, tamamlayıcı ürün ve geri kazanım fırsatlarını müşteri bağlamıyla keşfedin.", "Discover repeat purchase, complementary product and win-back opportunities in customer context.", "product"),
        ["CampaignManager"] = ("Campaign Manager", "Her kampanyanın arkasında doğru bir karar.", "A considered decision behind every campaign.", "Hedef kitle, içerik, izinler ve zamanlama. Kampanyanızın her adımını tek bir çalışma alanında yönetin.", "Audience, content, consent and timing. Manage every step of your campaign in one workspace.", "journey"),
        ["JourneyManager"] = ("Journey Manager", "Tek bir mesajdan, devam eden bir ilişkiye.", "From a single message to an ongoing relationship.", "Müşteri davranışına göre şekillenen yolculuklar kurun. Koşulları, bekleme adımlarını ve kanalları görsel olarak birleştirin.", "Build journeys shaped by customer behavior. Connect conditions, wait steps and channels visually.", "journey"),
        ["AudienceManager"] = ("Audience Manager", "Doğru insanlarla başlayın.", "Start with the right people.", "Müşteri verisini anlamlı kitlelere dönüştürün. Her iletişimi ilgili bir müşteri grubuyla buluşturun.", "Turn customer data into meaningful audiences. Connect each communication with a relevant customer group.", "audience"),
        ["ContentStudio"] = ("Content Studio", "Markanızın sesi. Her kanalda.", "Your brand’s voice. Across channels.", "İçeriklerinizi tek yerde hazırlayın. Şablon, kişiselleştirme ve kanal uyumunu birlikte yönetin.", "Prepare your content in one place. Manage templates, personalization and channel fit together.", "content"),
        ["Reporting"] = ("Analytics & Reporting", "Sonuçları görün. Sonraki adımı netleştirin.", "See the results. Clarify the next step.", "Teslimatları, etkileşimleri ve ilişkilendirilen ciroyu aynı bağlamda takip edin. Kararlarınızı görünür sonuçlarla destekleyin.", "Follow delivery, engagement and attributed revenue in context. Inform your decisions with visible outcomes.", "report"),
        ["Integrations"] = (tr ? "Entegrasyonlar" : "Integrations", "Veriniz nerede olursa olsun, hikâye bir bütün.", "Wherever your data lives, the story comes together.", "E-ticaret, mağaza ve kurumsal sistemlerdeki verilerinizi bağlayın. Müşteri zekâsının temelini birlikte oluşturun.", "Connect data from your online store, physical locations and business systems. Build the foundation for customer intelligence.", "data"),
        ["ConsentManagement"] = ("Consent Management", "İyi ilişkiler, izinle başlar.", "Good relationships begin with permission.", "Kanal izinlerini, tercihleri ve gönderim kontrollerini tek yerde görün. İletişiminizi müşterinizin tercihleriyle yönetin.", "See channel consent, preferences and dispatch checks in one place. Respect your customer’s communication choices.", "consent"),
        ["AiCampaignAssistant"] = ("Pika Pilot", "Fikrinizden ilk taslağa, birlikte.", "From your idea to the first draft, together.", "Müşteri ve ürün bağlamını bilen AI asistanınızla kampanya taslakları hazırlayın. Önerileri inceleyin; son karar sizde kalsın.", "Draft campaigns with an AI assistant grounded in your customers and products. Review the suggestions and keep the final decision.", "assistant"),
        ["WhatsAppMessaging"] = ("WhatsApp", "Sohbet kadar doğal. Müşterinize özel.", "As natural as a conversation. As personal as your customer.", "WhatsApp iletişiminizi müşteri bağlamıyla buluşturun. İzinli, kişiselleştirilmiş kampanyaları aynı çalışma alanından yönetin.", "Bring customer context to WhatsApp. Manage consented, personalized campaigns from one workspace.", "whatsapp"),
        ["EmailMarketing"] = ("E-mail", "Her açılışta, yeni bir bağ.", "A new connection in every inbox.", "Markanızın hikâyesini kişiye özel içerikle anlatın. Şablondan gönderime, e-posta deneyimini bir bütün olarak yönetin.", "Tell your brand’s story through personalized content. Manage the email experience from template to delivery.", "content"),
        ["SmsCampaigns"] = ("SMS", "Az kelimeyle, doğru anda.", "A few words. At the right moment.", "Önemli mesajlarınızı müşterinizin cebine taşıyın. Kitle, izin ve zamanlamayı tek akışta birleştirin.", "Put important messages in your customer’s pocket. Bring audience, consent and timing into one flow.", "sms"),
        ["SecurityPrivacy"] = (tr ? "Güvenlik ve Gizlilik" : "Security & Privacy", "Güven, tasarımın bir parçası.", "Trust, built into the design.", "Erişim yetkileri, veri ayrımı ve işlem kayıtları. Müşteri ilişkilerinizi kontrollü bir zeminde geliştirin.", "Access controls, data isolation and activity records. Build customer relationships on a governed foundation.", "consent"),
        ["Pika"] = (tr ? "Pika Hakkında" : "About Pika", "Veriyi anlamlı ilişkilere dönüştürüyoruz.", "We turn data into meaningful relationships.", "Müşteri zekâsını, ürün bilgisini ve iletişimi buluşturuyoruz. Markaların müşterileri için daha doğru adımlar atmasına yardımcı oluyoruz.", "We bring customer intelligence, product insight and communication together, helping brands make more relevant moves.", "data"),
        ["UseCases"] = (tr ? "Kullanım Senaryoları" : "Use Cases", "Gerçek bir ihtiyaç. Anlamlı bir sonraki adım.", "A real need. A meaningful next step.", "Müşteri kazanımından yeniden alışverişe, işletmenizin sorularını somut senaryolarla keşfedin.", "From customer acquisition to repeat purchases, explore your business questions through practical scenarios.", "journey"),
        ["Faq"] = (tr ? "Sıkça Sorulan Sorular" : "Frequently Asked Questions", "Aklınızdaki sorulara, açık yanıtlar.", "Clear answers to your questions.", "Platform, veri, kanallar ve çalışma yaklaşımı hakkında merak ettiklerinizi keşfedin.", "Explore answers about the platform, data, channels and how Pika works.", "knowledge"),
        ["Career"] = (tr ? "Pika’da Kariyer" : "Careers at Pika", "Bir sonraki fikri birlikte büyütelim.", "Let’s grow the next idea together.", "Müşteri deneyimini veriden başlayarak yeniden düşünün. Üretmeyi, öğrenmeyi ve birlikte gelişmeyi seven ekibimize katılın.", "Rethink customer experience, starting with data. Join a team that values creating, learning and growing together.", "team")
    };
    var presentation = pages[action];
    var title = tr ? presentation.Tr : presentation.En;
    var description = tr ? presentation.DescTr : presentation.DescEn;
}
<section class="inner-hero inner-hero--@presentation.Scene">
 <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
 <div class="container inner-hero-grid"><div class="inner-intro"><nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")"><a href="@(tr ? "/" : "/en/")">Pika</a><span>/</span><span>@presentation.Label</span></nav><div class="inner-eyebrow"><span></span>@presentation.Label</div><h1>@title</h1><p>@description</p><div class="inner-actions">@if(action == "Career") { <a class="inner-primary" href="#inner-content">@(tr ? "Ekibimizi tanıyın" : "Meet our team") ↗</a> } else if(action == "Faq") { <a class="inner-primary" href="#inner-content">@(tr ? "Yanıtları keşfedin" : "Explore the answers") ↓</a> } else { <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr ? "Birlikte keşfedelim" : "Let’s explore together") ↗</button> }<a class="inner-secondary" href="#inner-content">@(tr ? "Detayları inceleyin" : "Explore the details") ↓</a></div></div>
 <div class="inner-scene" aria-label="@(tr ? "Platformun çalışma biçimini anlatan örnek görünüm" : "Illustrative view of how the platform works")"><div class="inner-scene-orbit" aria-hidden="true"></div><div class="inner-scene-window"><div class="inner-window-bar"><strong>pika<span>✳</span></strong><span>@presentation.Label</span><small>@(tr ? "Örnek görünüm" : "Illustration")</small></div>
 @if(presentation.Scene == "customer" || presentation.Scene == "audience") {
 <div class="inner-person"><span>DK</span><div><small>@(tr ? "MÜŞTERİ BAĞLAMI" : "CUSTOMER CONTEXT")</small><h3>Deniz Kaya</h3><p>@(tr ? "Kahve · Yaşam · Yeni keşifler" : "Coffee · Lifestyle · Discovery")</p></div></div><div class="inner-scene-metrics"><div><small>@(tr ? "İlişkinin gücü" : "Relationship strength")</small><strong>84<em>/100</em></strong><span class="inner-mini-bar"></span></div><div><small>@(tr ? "Alışveriş ritmi" : "Purchase rhythm")</small><strong>30 <em>@(tr ? "gün" : "days")</em></strong><span>@(tr ? "Örnek müşteri verisi" : "Sample customer data")</span></div></div><div class="inner-insight"><span>✳</span><div><strong>@(tr ? "Bir sonraki ihtiyaç görünür olur." : "The next need comes into focus.")</strong><p>@(tr ? "Geçmişi anlayın. İlgili bir iletişim kurun." : "Understand the history. Make the connection relevant.")</p></div></div>
 } else if(presentation.Scene == "journey") {
 <div class="inner-flow"><div><i class="ri-user-heart-line" aria-hidden="true"></i><span><small>@(tr ? "BAŞLANGIÇ" : "START")</small><strong>@(tr ? "İlgili müşteri kitlesi" : "A relevant audience")</strong></span><b>01</b></div><span class="inner-flow-link"></span><div><i class="ri-shield-check-line" aria-hidden="true"></i><span><small>@(tr ? "KOŞUL" : "CONDITION")</small><strong>@(tr ? "İzin ve zaman kontrolü" : "Consent and timing check")</strong></span><b>02</b></div><span class="inner-flow-link"></span><div class="inner-flow-final"><i class="ri-send-plane-line" aria-hidden="true"></i><span><small>@(tr ? "İLETİŞİM" : "COMMUNICATION")</small><strong>@(tr ? "Kişiye özel bir buluşma" : "A personalized connection")</strong></span><b>03</b></div></div>
 } else if(presentation.Scene == "product") {
 <div class="inner-products"><div><i class="ri-cup-line" aria-hidden="true"></i><small>@(tr ? "ANA ÜRÜN" : "PRIMARY PRODUCT")</small><strong>@(tr ? "Filtre kahve" : "Filter coffee")</strong></div><span>+</span><div><i class="ri-filter-line" aria-hidden="true"></i><small>@(tr ? "TAMAMLAYICI" : "COMPLEMENTARY")</small><strong>@(tr ? "Kahve filtresi" : "Coffee filters")</strong></div></div><div class="inner-insight"><span>✳</span><div><strong>@(tr ? "Aynı ritüelin iki parçası." : "Two parts of the same ritual.")</strong><p>@(tr ? "Ürün ilişkilerinden anlamlı önerilere." : "From product relationships to relevant suggestions.")</p></div></div>
 } else if(presentation.Scene == "assistant") {
 <div class="inner-prompt">@(tr ? "Müşterilerimizle yeniden bağ kurmak istiyoruz." : "We want to reconnect with our customers.")</div><div class="inner-ai-answer"><small>✳ PIKA PILOT</small><h3>@(tr ? "Bir fikirle başlayalım." : "Let’s start with an idea.")</h3><p>@(tr ? "Müşteri bağlamı ve ürün bilgisi bir araya gelir. Öneriler incelemeniz için hazırlanır." : "Customer context meets product insight. Suggestions are prepared for your review.")</p><div><span>@(tr ? "Müşteri geçmişi" : "Customer history")</span><span>@(tr ? "Ürün kataloğu" : "Product catalog")</span></div></div><div class="inner-window-foot">@(tr ? "İnceleme ve onay sizde." : "Review and approval stay with you.")</div>
 } else if(presentation.Scene == "whatsapp" || presentation.Scene == "sms" || presentation.Scene == "content") {
 <div class="inner-message-scene"><div class="inner-message-brand"><i class="@(presentation.Scene == "whatsapp" ? "ri-whatsapp-line" : presentation.Scene == "sms" ? "ri-message-2-line" : "ri-mail-line")" aria-hidden="true"></i><span>PIKA COFFEE<small>@(tr ? "Örnek marka" : "Illustrative brand")</small></span></div><div class="inner-message-art" aria-hidden="true"><span>MAKE TIME<br/>FOR A GOOD<br/><em>connection.</em></span><i class="ri-cup-line"></i></div><div class="inner-message-copy"><strong>@(tr ? "Kahve molasına hazır mısın?" : "Ready for a coffee break?")</strong><p>@(tr ? "Merhaba Deniz, favori lezzetlerin ve yeni keşifler seni bekliyor." : "Hello Deniz, your favorite flavors and new discoveries are waiting.")</p></div></div>
 } else if(presentation.Scene == "report") {
 <div class="inner-report"><small>@(tr ? "İLİŞKİLENDİRİLEN CİRO" : "ATTRIBUTED REVENUE")</small><strong>₺84.250</strong><svg viewBox="0 0 400 150" role="img" aria-label="@(tr ? "Örnek ciro eğrisi" : "Illustrative revenue curve")"><path d="M0 125H400 M0 75H400 M0 25H400" stroke="#dce5d2" fill="none"/><path class="inner-chart-line" pathLength="1" d="M0 120 Q40 90 70 108 T150 70 T230 50 T320 40 T400 10" fill="none" stroke="#7c984c" stroke-width="3"/></svg><div><span>WhatsApp</span><span>E-mail</span><span>SMS</span></div><p>@(tr ? "Gösterim amaçlı veriler; nedensellik iddiası içermez." : "Illustrative data; no claim of causation.")</p></div>
 } else if(presentation.Scene == "knowledge") {
 <div class="inner-knowledge"><span>PIKA / @(tr ? "BİLGİ MERKEZİ" : "KNOWLEDGE CENTER")</span><h3>@(tr ? "Nereden başlamak istersiniz?" : "Where would you like to start?")</h3><div><i class="ri-database-2-line" aria-hidden="true"></i>@(tr ? "Veri ve kurulum" : "Data and setup")<b>↗</b></div><div><i class="ri-brain-line" aria-hidden="true"></i>@(tr ? "Müşteri ve ürün zekâsı" : "Customer and product intelligence")<b>↗</b></div><div><i class="ri-shield-check-line" aria-hidden="true"></i>@(tr ? "İzinler ve güvenlik" : "Consent and security")<b>↗</b></div></div>
 } else if(presentation.Scene == "team") {
 <div class="inner-knowledge"><span>PIKA / @(tr ? "BİRLİKTE ÜRETİYORUZ" : "BUILDING TOGETHER")</span><h3>@(tr ? "Merakla başlar." : "It starts with curiosity.")</h3><div><i class="ri-lightbulb-line" aria-hidden="true"></i>@(tr ? "Yeni fikirler" : "New ideas")<b>01</b></div><div><i class="ri-code-s-slash-line" aria-hidden="true"></i>@(tr ? "Anlamlı ürünler" : "Meaningful products")<b>02</b></div><div><i class="ri-team-line" aria-hidden="true"></i>@(tr ? "Birlikte gelişim" : "Shared growth")<b>03</b></div></div>
 } else if(presentation.Scene == "consent") {
 <div class="inner-shield"><i class="ri-shield-check-line" aria-hidden="true"></i><h3>@(tr ? "Her adımda kontrol." : "Control at every step.")</h3></div><div class="inner-checks"><span>✓ @(tr ? "Kanal tercihleri" : "Channel preferences")</span><span>✓ @(tr ? "Erişim yetkileri" : "Access permissions")</span><span>✓ @(tr ? "İşlem kayıtları" : "Activity records")</span></div>
 } else {
 <div class="inner-data-map"><span><i class="ri-store-2-line" aria-hidden="true"></i>@(tr ? "Mağaza" : "In-store")</span><span><i class="ri-shopping-bag-3-line" aria-hidden="true"></i>E-commerce</span><strong>pika<span>✳</span></strong><span><i class="ri-database-2-line" aria-hidden="true"></i>CRM / ERP</span><span><i class="ri-user-heart-line" aria-hidden="true"></i>@(tr ? "Müşteri" : "Customer")</span></div><div class="inner-window-foot">@(tr ? "Bağlantılar kurulur. Hikâye tamamlanır." : "Connections form. The story comes together.")</div>
 }
 </div><div class="inner-scene-caption">CUSTOMER INTELLIGENCE. MEANINGFUL CONNECTIONS.</div></div></div>
</section><div id="inner-content" class="inner-anchor"></div>

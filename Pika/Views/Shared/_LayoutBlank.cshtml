@using Microsoft.Extensions.Options
@using Pika.Configuration
@using Pika.Services
@inject IOptions<SiteSettings> SiteOptions
@{
    var site = SiteOptions.Value;
    var title = ViewData["Title"] as string ?? site.BrandName;
    var fullTitle = SeoHelper.FormatPageTitle(title, site.BrandName);
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var robotsMeta = ViewData["RobotsMeta"] as string ?? "noindex, nofollow";
}
<!doctype html>
<html lang="@culture" data-lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@fullTitle</title>
    <meta name="robots" content="@robotsMeta" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/web/css/remixicon.css" rel="stylesheet" />

    <link href="~/css/style.css" rel="stylesheet" />
    <link href="~/css/pika-components.css" rel="stylesheet" />

    @RenderSection("Styles", required: false)

    <link rel="icon" href="~/web/assets/images/favicon.ico" />
</head>
<body class="pika-body @bodyClass">
    <main>
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

@{
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var isTr = culture == "tr";
    var privacyUrl = Url.Action("PrivacyPolicy", "Home", new { culture });
}

<div id="cookieConsentContainer" role="region" aria-label="@(isTr ? "Çerez Kullanımı ve KVKK Aydınlatması" : "Cookie Usage and Privacy Notice")" class="cookie-consent-banner d-none p-4 rounded shadow bg-white border" style="position: fixed; bottom: 20px; left: 20px; right: 20px; z-index: 1060; max-width: 900px; margin: 0 auto; flex-direction: column; gap: 15px; border:1px solid rgba(128,148,139,.24);">
    <div class="d-flex align-items-start justify-content-between gap-3">
        <div class="mb-0">
            <h5 class="mb-2 fw-bold" style="color: #0c3a30;" data-i18n="cookie.title">@(isTr ? "Çerez (Cookie) Kullanımı ve KVKK Aydınlatması" : "Cookie Usage & Privacy Notice")</h5>
            <p class="mb-0 text-muted" style="font-size: 0.9rem; line-height: 1.6;" data-i18n="cookie.description">
                @(isTr ? "Sitemizin düzgün çalışabilmesi (zorunlu çerezler), kullanıcı deneyiminizin geliştirilmesi, site performansının analiz edilmesi ve analiz doğrultusunda ilgi alanlarınıza yönelik reklam/pazarlama faaliyetlerinin sürdürülebilmesi amacıyla çerezler (cookies) kullanmaktayız. Kişisel verilerinizin işlenmesine ilişkin detaylı bilgiye Çerez Politikası ve KVKK Aydınlatma Metni üzerinden ulaşabilirsiniz." : "We use cookies to ensure proper website functionality, enhance user experience, and analyze site performance. For detailed information regarding our data processing, please visit our Privacy Policy.")
                <br/><br/>
                @(isTr ? "Tüm çerezlerin kullanımına onay vermek için \"Tümünü Kabul Et\" seçeneğine, çerez ayarlarınızı yapılandırmak için \"Tercihleri Yönet\" seçeneğine, zorunlu çerezler dışındaki çerezleri reddetmek için ise \"Tümünü Reddet\" seçeneğine tıklayabilirsiniz." : "Click \"Accept All\" to consent to all cookies, \"Manage Preferences\" to configure settings, or \"Reject All\" to refuse non-essential cookies.")
            </p>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2 justify-content-end align-items-center mt-3 border-top pt-3">
        <a href="@privacyUrl" class="btn btn-link text-decoration-none text-muted btn-sm me-auto" id="btnCookieSettings" data-i18n="cookie.settings">@(isTr ? "Tercihleri Yönet" : "Manage Preferences")</a>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnCookieReject" data-i18n="cookie.reject">@(isTr ? "Tümünü Reddet" : "Reject All")</button>
        <button type="button" class="btn btn-sm px-4 text-white" style="background-color: #0c3a30; border-color: #0c3a30;" id="btnCookieAccept" data-i18n="cookie.accept">@(isTr ? "Tümünü Kabul Et" : "Accept All")</button>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var cookieName = "pika_cookie_consent";
        var consentContainer = document.getElementById("cookieConsentContainer");
        var btnAccept = document.getElementById("btnCookieAccept");
        var btnReject = document.getElementById("btnCookieReject");
        var btnSettings = document.getElementById("btnCookieSettings");

        function getCookie(name) {
            var v = document.cookie.match('(^|;) ?' + name + '=([^;]*)(;|$)');
            return v ? v[2] : null;
        }

        function setCookie(name, value, days) {
            var d = new Date;
            d.setTime(d.getTime() + 24*60*60*1000*days);
            document.cookie = name + "=" + value + ";path=/;expires=" + d.toGMTString();
        }

        function hideBanner() {
            consentContainer.classList.add("d-none");
            consentContainer.classList.remove("d-flex");
        }

        function showBanner() {
            consentContainer.classList.remove("d-none");
            consentContainer.classList.add("d-flex");
        }

        var currentConsent = getCookie(cookieName);
        if (!currentConsent) {
            setTimeout(function() {
                showBanner();
            }, 1000); // Sayfa yüklendikten 1 saniye sonra göster
        }

        btnAccept.addEventListener("click", function () {
            setCookie(cookieName, "accepted", 365); // 1 yıl geçerli
            hideBanner();
            if(window.gtag) {
                gtag('consent', 'update', {
                    'ad_storage': 'granted',
                    'analytics_storage': 'granted'
                });
            }
        });

        btnReject.addEventListener("click", function () {
            setCookie(cookieName, "rejected", 365); // 1 yıl geçerli
            hideBanner();
            if(window.gtag) {
                gtag('consent', 'update', {
                    'ad_storage': 'denied',
                    'analytics_storage': 'denied'
                });
            }
        });

        btnSettings.addEventListener("click", function () {
            window.location.href = '@privacyUrl';
        });
    });
</script>
    @if (recaptcha.IsEnabled)
    {
        <script src="https://www.google.com/recaptcha/api.js?render=@recaptcha.SiteKey"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var forms = document.querySelectorAll('form');
                var setFormLoading = function(form, isLoading) {
                    if (!form) return;
                    var button = form.querySelector('button[type="submit"], input[type="submit"]');
                    if (!button) return;

                    if (isLoading) {
                        if (!button.dataset.originalContent) {
                            button.dataset.originalContent = button.innerHTML;
                        }
                        button.disabled = true;
                        button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>' + (button.dataset.loadingText || 'Gönderiliyor');
                    } else {
                        if (button.dataset.originalContent) {
                            button.innerHTML = button.dataset.originalContent;
                            delete button.dataset.originalContent;
                        }
                        button.disabled = false;
                    }
                };
                forms.forEach(function(form) {
                    form.addEventListener('submit', function(e) {
                        if (!e.defaultPrevented && !form.dataset.recaptchaPassed) {
                            e.preventDefault();
                            e.stopImmediatePropagation();

                            if (typeof grecaptcha === 'undefined') {
                                form.dataset.recaptchaPassed = "true";
                                form.submit();
                                return;
                            }

                            setFormLoading(form, true);
                            grecaptcha.ready(function() {
                                grecaptcha.execute('@recaptcha.SiteKey', { action: 'submit' }).then(function(token) {
                                    var existing = form.querySelector('input[name="g-recaptcha-response"]');
                                    if (existing) { existing.remove(); }

                                    var input = document.createElement('input');
                                    input.type = 'hidden';
                                    input.name = 'g-recaptcha-response';
                                    input.value = token;
                                    form.appendChild(input);

                                    form.dataset.recaptchaPassed = "true";
                                    if (typeof form.requestSubmit === 'function') {
                                        form.requestSubmit();
                                    } else {
                                        form.submit();
                                    }
                                }).catch(function() {
                                    form.dataset.recaptchaPassed = "true";
                                    form.submit();
                                });
                            });
                        }
                    }, true);
                });
            });
        </script>
    }
    @RenderSection("Scripts", required: false)

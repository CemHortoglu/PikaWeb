@using Microsoft.Extensions.Options
@using Pika.Configuration
@using Pika.Services
@inject IOptions<SiteSettings> SiteOptions
@inject IOptions<RecaptchaSettings> RecaptchaOptions
@{
    var site = SiteOptions.Value;
    var recaptcha = RecaptchaOptions.Value;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var isTr = culture == "tr";
    var seoMeta = SeoHelper.GetMetadata(ctrl, act);
    
    var rawTitle = ViewData["Title"] as string ?? (isTr ? seoMeta?.TitleTr : seoMeta?.TitleEn) ?? site.BrandName;
    var fullTitle = SeoHelper.FormatPageTitle(rawTitle, site.BrandName);
    var titleKey = ViewData["TitleKey"] as string;
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
    var appVersion = System.Reflection.Assembly.GetEntryAssembly()?.GetName().Version?.ToString(3) ?? "1.0.0";
    var toast = TempData["Toast"] as string;
    var baseName = site.BrandName;
    var metaDescription = ViewData["MetaDescription"] as string ?? (isTr ? seoMeta?.DescriptionTr : seoMeta?.DescriptionEn) ?? site.MetaDescription;
    var metaKeywords = ViewData["MetaKeywords"] as string ?? site.MetaKeywords;
    var robotsMeta = ViewData["RobotsMeta"] as string ?? (seoMeta?.NoIndex == true ? "noindex, follow" : "index, follow");
    var isNoIndex = robotsMeta.Contains("noindex", StringComparison.OrdinalIgnoreCase);

    string? canonicalUrl = null;
    if (ViewData["CanonicalUrl"] is string explicitCanonical)
    {
        canonicalUrl = string.IsNullOrWhiteSpace(explicitCanonical) ? null : explicitCanonical;
    }
    else if (seoMeta != null)
    {
        var path = isTr ? seoMeta.AlternatePathTr : seoMeta.AlternatePathEn;
        canonicalUrl = $"{SeoHelper.BaseDomain}{path}";
    }
    else if (!isNoIndex && (ctrl.Equals("Home", StringComparison.OrdinalIgnoreCase) && (act.Equals("Index", StringComparison.OrdinalIgnoreCase) || act.Equals("EnglishIndex", StringComparison.OrdinalIgnoreCase))))
    {
        canonicalUrl = isTr ? $"{SeoHelper.BaseDomain}/" : $"{SeoHelper.BaseDomain}/en/";
    }

    var hreflangs = (!isNoIndex && !string.IsNullOrEmpty(canonicalUrl))
        ? SeoHelper.GetHreflangAlternates(ctrl, act)
        : [];

    var homeUrl = isTr ? "/" : "/en/";
    var ogImage = ViewData["OgImage"] as string ?? "https://pika.tr/logo.png";
    var ogLocale = isTr ? "tr_TR" : "en_US";
}
<!doctype html>
<html lang="@culture" data-lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@fullTitle</title>

    <meta name="description" content="@metaDescription" />
    <meta name="keywords" content="@metaKeywords" />
    <meta name="robots" content="@robotsMeta" />
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    @foreach (var entry in hreflangs)
    {
        <link rel="alternate" hreflang="@entry.Lang" href="@entry.Url" />
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@baseName" />
    <meta property="og:locale" content="@ogLocale" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@metaDescription" />
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <meta property="og:url" content="@canonicalUrl" />
    }
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:alt" content="@fullTitle" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@fullTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="@ogImage" />
    <meta name="twitter:image:alt" content="@fullTitle" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet">
    <link href="~/web/css/remixicon.css" rel="stylesheet" />

    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pika-components.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pika-home.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pika-design-system.css" rel="stylesheet" asp-append-version="true" />

    @RenderSection("Styles", required: false)

    <link rel="icon" href="~/web/assets/images/favicon.ico" />

    <!-- Organization JSON-LD -->
    <script type="@Html.Raw("application/ld+json")">
    {
      "@@context": "https://schema.org",
      "@@type": "Organization",
      "@@id": "https://pika.tr/#organization",
      "name": "Pika",
      "alternateName": "Pika Müşteri Zekâsı ve Omnichannel Pazarlama Platformu",
      "url": "https://pika.tr/",
      "logo": "https://pika.tr/logo.png",
      "description": "Pika; müşteri, ürün ve satış verisini birlikte anlamlandırarak işletmenin bugün hangi müşteride hangi ticari fırsatın oluştuğunu görmesini ve bu fırsatı kontrollü, ölçülebilir çok kanallı aksiyona dönüştürmesini sağlayan müşteri zekâsı ve pazarlama platformudur.",
      "contactPoint": [
        {
          "@@type": "ContactPoint",
          "telephone": "@site.Contact.SupportPhone",
          "contactType": "customer support",
          "availableLanguage": ["Turkish", "English"]
        },
        {
          "@@type": "ContactPoint",
          "email": "@site.Contact.SupportEmail",
          "contactType": "sales"
        }
      ],
      "sameAs": [
        "https://www.linkedin.com/company/pikatr"
      ]
    }
    </script>

    <!-- WebSite JSON-LD -->
    <script type="@Html.Raw("application/ld+json")">
    {
      "@@context": "https://schema.org",
      "@@type": "WebSite",
      "@@id": "https://pika.tr/#website",
      "url": "https://pika.tr/",
      "name": "Pika",
      "inLanguage": ["tr-TR", "en-US"],
      "publisher": {
        "@@id": "https://pika.tr/#organization"
      }
    }
    </script>
    @if (seoMeta != null && (ctrl != "Home" || (act != "Index" && act != "EnglishIndex")) && !string.IsNullOrWhiteSpace(canonicalUrl))
    {
        var breadcrumbTitle = isTr ? (seoMeta.BreadcrumbTitleTr ?? seoMeta.TitleTr) : (seoMeta.BreadcrumbTitleEn ?? seoMeta.TitleEn);
        <script type="@Html.Raw("application/ld+json")">
        {
          "@@context": "https://schema.org",
          "@@type": "BreadcrumbList",
          "itemListElement": [
            {
              "@@type": "ListItem",
              "position": 1,
              "name": "@(isTr ? "Ana Sayfa" : "Home")",
              "item": "@(isTr ? "https://pika.tr/" : "https://pika.tr/en/")"
            },
            {
              "@@type": "ListItem",
              "position": 2,
              "name": "@breadcrumbTitle",
              "item": "@canonicalUrl"
            }
          ]
        }
        </script>
    }
    @RenderSection("JsonLd", required: false)
    @if (recaptcha.IsEnabled)
    {
        <script src="https://www.google.com/recaptcha/api.js?render=@recaptcha.SiteKey" async defer></script>
    }
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6K7BWPHK5B"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      var consent = document.cookie.match('(^|;) ?pika_cookie_consent=([^;]*)(;|$)');
      var consentGranted = consent && consent[2] === 'accepted';

      gtag('consent', 'default', {
        'ad_storage': consentGranted ? 'granted' : 'denied',
        'analytics_storage': consentGranted ? 'granted' : 'denied'
      });

      gtag('config', 'G-6K7BWPHK5B');
    </script>
</head>

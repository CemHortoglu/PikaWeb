@using Microsoft.Extensions.Options
@using Pika.Configuration
@using Pika.Services
@inject IOptions<SiteSettings> SiteOptions
@inject IOptions<RecaptchaSettings> RecaptchaOptions
@{
    var site = SiteOptions.Value;
    var recaptcha = RecaptchaOptions.Value;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var culture = (ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var isTr = culture == "tr";
    var seoMeta = SeoHelper.GetMetadata(ctrl, act);
    var rawTitle = ViewData["Title"] as string ?? (isTr ? seoMeta?.TitleTr : seoMeta?.TitleEn) ?? site.BrandName;
    var fullTitle = SeoHelper.FormatPageTitle(rawTitle, site.BrandName);
    var metaDescription = ViewData["MetaDescription"] as string ?? (isTr ? seoMeta?.DescriptionTr : seoMeta?.DescriptionEn) ?? site.MetaDescription;
    var robotsMeta = ViewData["RobotsMeta"] as string ?? "index, follow";
    var isNoIndex = robotsMeta.Contains("noindex", StringComparison.OrdinalIgnoreCase);
    var bodyClass = ViewData["BodyClass"] as string ?? string.Empty;
    var canonicalUrl = ViewData["CanonicalUrl"] is string explicitCanonical
        ? (string.IsNullOrWhiteSpace(explicitCanonical) ? null : explicitCanonical)
        : (!isNoIndex ? SeoHelper.GetCanonicalUrl(ctrl, act, culture) : null);
    var hreflangs = !isNoIndex && canonicalUrl != null ? SeoHelper.GetHreflangAlternates(ctrl, act) : [];
    var homeUrl = isTr ? "/" : "/en/";
    var languageUrl = isTr ? (seoMeta?.AlternatePathEn ?? "/en/") : (seoMeta?.AlternatePathTr ?? "/");
    var languageLabel = isTr ? "EN" : "TR";
    var ogImage = ViewData["OgImage"] as string ?? "https://pika.tr/og-image.png";
}
<!doctype html>
<html lang="@culture" data-lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>
    <meta name="description" content="@metaDescription" />
    <meta name="robots" content="@robotsMeta" />
    @if (canonicalUrl != null)
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    @foreach (var entry in hreflangs)
    {
        <link rel="alternate" hreflang="@entry.Lang" href="@entry.Url" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pika" />
    <meta property="og:locale" content="@(isTr ? "tr_TR" : "en_US")" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@metaDescription" />
    @if (canonicalUrl != null) { <meta property="og:url" content="@canonicalUrl" /> }
    <meta property="og:image" content="@ogImage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@fullTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="@ogImage" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pika-components.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pika-home.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pika-shell.css" rel="stylesheet" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <link rel="icon" href="~/favicon.ico" />

    <script type="@Html.Raw("application/ld+json")">
    {
      "@@context":"https://schema.org",
      "@@type":"Organization",
      "@@id":"https://pika.tr/#organization",
      "name":"Pika",
      "url":"https://pika.tr/",
      "logo":"https://pika.tr/logo.png",
      "description":"Pika, müşteri ve ürün verisini anlamlandırarak fırsatları görünür kılan ve kontrollü pazarlama aksiyonlarına dönüştürmeye yardımcı olan B2B SaaS platformudur.",
      "contactPoint":{"@@type":"ContactPoint","email":"@site.Contact.SupportEmail","telephone":"@site.Contact.SupportPhone","contactType":"customer support"}
    }
    </script>
    @if (seoMeta != null && canonicalUrl != null && !(ctrl.Equals("Home", StringComparison.OrdinalIgnoreCase) && (act == "Index" || act == "EnglishIndex")))
    {
        var crumb = isTr ? (seoMeta.BreadcrumbTitleTr ?? seoMeta.TitleTr) : (seoMeta.BreadcrumbTitleEn ?? seoMeta.TitleEn);
        <script type="@Html.Raw("application/ld+json")">
        {"@@context":"https://schema.org","@@type":"BreadcrumbList","itemListElement":[
          {"@@type":"ListItem","position":1,"name":"@(isTr ? "Ana Sayfa" : "Home")","item":"@(isTr ? "https://pika.tr/" : "https://pika.tr/en/")"},
          {"@@type":"ListItem","position":2,"name":"@crumb","item":"@canonicalUrl"}
        ]}
        </script>
    }
    @RenderSection("JsonLd", required: false)
    @if (recaptcha.IsEnabled)
    {
        <script src="https://www.google.com/recaptcha/api.js?render=@recaptcha.SiteKey" async defer></script>
    }
</head>
<body class="pk-body @bodyClass">
    <a class="pk-skip" href="#main-content">@(isTr ? "İçeriğe geç" : "Skip to content")</a>
    <header class="pk-header">
        <nav class="pk-nav" aria-label="@(isTr ? "Ana gezinme" : "Primary navigation")">
            <div class="pk-container pk-nav-inner">
                <a class="pk-brand" href="@homeUrl" aria-label="Pika">
                    <img src="~/logo.png" alt="Pika" width="118" height="40" />
                </a>
                <div class="pk-nav-desktop">
                    <div class="dropdown">
                        <button class="pk-nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Platform</button>
                        <div class="dropdown-menu pk-mega">
                            <div class="pk-mega-grid">
                                <div>
                                    <div class="pk-mega-label">@(isTr ? "Anla" : "Understand")</div>
                                    <a href="@(isTr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")"><strong>Customer Intelligence</strong><span>@(isTr ? "Müşteri davranışı ve değer bağlamı" : "Customer behavior and value context")</span></a>
                                    <a href="@(isTr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")"><strong>Product Intelligence</strong><span>@(isTr ? "Ürün, ihtiyaç ve ticari rol bağlamı" : "Product, need and commercial-role context")</span></a>
                                    <a href="@(isTr ? "/platform/pika-360" : "/en/platform/pika-360")"><strong>Pika 360</strong><span>@(isTr ? "Tek müşteride bütünleşik karar görünümü" : "Unified customer decision view")</span></a>
                                </div>
                                <div>
                                    <div class="pk-mega-label">@(isTr ? "Fırsat ve aksiyon" : "Opportunity & action")</div>
                                    <a class="pk-mega-featured" href="@(isTr ? "/platform/gunun-firsatlari" : "/en/platform/opportunities")"><strong>@(isTr ? "Günün Fırsatları" : "Daily Opportunities")</strong><span>@(isTr ? "Bugün nerede aksiyon var?" : "Where is action useful today?")</span></a>
                                    <a href="@(isTr ? "/platform/audience-manager" : "/en/platform/audience-manager")"><strong>Audience Manager</strong><span>@(isTr ? "Hedef kitle ve segmentasyon" : "Audience and segmentation")</span></a>
                                    <a href="@(isTr ? "/platform/campaign-manager" : "/en/platform/campaign-manager")"><strong>Campaign Manager</strong><span>@(isTr ? "Kontrollü kampanya yürütme" : "Controlled campaign execution")</span></a>
                                    <a href="@(isTr ? "/platform/journey-manager" : "/en/platform/journey-manager")"><strong>Journey Manager</strong><span>@(isTr ? "Çok adımlı otomasyon" : "Multi-step automation")</span></a>
                                </div>
                                <div>
                                    <div class="pk-mega-label">@(isTr ? "Üret, ölç, yönet" : "Create, measure, govern")</div>
                                    <a href="@(isTr ? "/platform/content-studio" : "/en/platform/content-studio")"><strong>Content Studio</strong><span>@(isTr ? "İçerik ve şablonlar" : "Content and templates")</span></a>
                                    <a href="@(isTr ? "/platform/ai-kampanya-asistani" : "/en/platform/ai-campaign-assistant")"><strong>Pika AI</strong><span>@(isTr ? "Açıklama ve taslak desteği" : "Explanation and drafting support")</span></a>
                                    <a href="@(isTr ? "/platform/analytics" : "/en/platform/analytics")"><strong>Analytics</strong><span>@(isTr ? "Sonuç ve performans ölçümü" : "Outcome and performance measurement")</span></a>
                                    <a href="@(isTr ? "/platform/integrations" : "/en/platform/integrations")"><strong>@(isTr ? "Entegrasyonlar" : "Integrations")</strong><span>@(isTr ? "Veri bağlantıları" : "Data connectivity")</span></a>
                                    <a href="@(isTr ? "/platform/consent-management" : "/en/platform/consent-management")"><strong>Consent Management</strong><span>@(isTr ? "İzin ve kanal uygunluğu" : "Consent and channel eligibility")</span></a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <a class="pk-nav-link" href="@(isTr ? "/kullanim-senaryolari" : "/en/use-cases")">@(isTr ? "Kullanım Senaryoları" : "Use Cases")</a>
                    <div class="dropdown">
                        <button class="pk-nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">@(isTr ? "Kanallar" : "Channels")</button>
                        <div class="dropdown-menu pk-menu">
                            <a href="@(isTr ? "/kanallar/email" : "/en/channels/email")">Email</a>
                            <a href="@(isTr ? "/kanallar/sms" : "/en/channels/sms")">SMS</a>
                            <a href="@(isTr ? "/kanallar/whatsapp" : "/en/channels/whatsapp")">WhatsApp</a>
                            <a href="@(isTr ? "/kanallar/push" : "/en/channels/push")">Push</a>
                        </div>
                    </div>
                    <div class="dropdown">
                        <button class="pk-nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">@(isTr ? "Kaynaklar" : "Resources")</button>
                        <div class="dropdown-menu pk-menu">
                            <a href="/wiki/">@(isTr ? "Bilgi Bankası" : "Knowledge Base")</a>
                            <a href="@(isTr ? "/kaynaklar/sss" : "/en/resources/faq")">@(isTr ? "Sık Sorulan Sorular" : "FAQ")</a>
                            <a href="@(isTr ? "/guvenlik-ve-gizlilik" : "/en/security-and-privacy")">@(isTr ? "Güvenlik ve Gizlilik" : "Security & Privacy")</a>
                        </div>
                    </div>
                    <a class="pk-nav-link" href="@(isTr ? "/pika" : "/en/pika")">@(isTr ? "Pika Nedir?" : "What is Pika?")</a>
                </div>
                <div class="pk-nav-actions">
                    <a class="pk-language" href="@languageUrl" hreflang="@(isTr ? "en" : "tr")">@languageLabel</a>
                    <a class="pk-login" href="/giris">@(isTr ? "Giriş" : "Login")</a>
                    <button class="pk-btn pk-btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">@(isTr ? "Demo Talebi" : "Request Demo")</button>
                    <button class="pk-mobile-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#pkMobileNav" aria-controls="pkMobileNav" aria-label="@(isTr ? "Menüyü aç" : "Open menu")"><i class="ri-menu-3-line"></i></button>
                </div>
            </div>
        </nav>
    </header>

    <div class="offcanvas offcanvas-end pk-mobile" tabindex="-1" id="pkMobileNav">
        <div class="offcanvas-header">
            <a class="pk-brand" href="@homeUrl"><img src="~/logo.png" alt="Pika" width="108" /></a>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div class="pk-mobile-label">Platform</div>
            <a href="@(isTr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")">Customer Intelligence</a>
            <a href="@(isTr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")">Product Intelligence</a>
            <a href="@(isTr ? "/platform/pika-360" : "/en/platform/pika-360")">Pika 360</a>
            <a href="@(isTr ? "/platform/gunun-firsatlari" : "/en/platform/opportunities")">@(isTr ? "Günün Fırsatları" : "Daily Opportunities")</a>
            <a href="@(isTr ? "/platform/audience-manager" : "/en/platform/audience-manager")">Audience Manager</a>
            <a href="@(isTr ? "/platform/campaign-manager" : "/en/platform/campaign-manager")">Campaign Manager</a>
            <a href="@(isTr ? "/platform/journey-manager" : "/en/platform/journey-manager")">Journey Manager</a>
            <a href="@(isTr ? "/platform/analytics" : "/en/platform/analytics")">Analytics</a>
            <div class="pk-mobile-label">@(isTr ? "Kanallar" : "Channels")</div>
            <a href="@(isTr ? "/kanallar/email" : "/en/channels/email")">Email</a><a href="@(isTr ? "/kanallar/sms" : "/en/channels/sms")">SMS</a><a href="@(isTr ? "/kanallar/whatsapp" : "/en/channels/whatsapp")">WhatsApp</a><a href="@(isTr ? "/kanallar/push" : "/en/channels/push")">Push</a>
            <div class="pk-mobile-label">@(isTr ? "Kaynaklar" : "Resources")</div>
            <a href="@(isTr ? "/kullanim-senaryolari" : "/en/use-cases")">@(isTr ? "Kullanım Senaryoları" : "Use Cases")</a>
            <a href="/wiki/">@(isTr ? "Bilgi Bankası" : "Knowledge Base")</a>
            <a href="@(isTr ? "/kaynaklar/sss" : "/en/resources/faq")">@(isTr ? "Sık Sorulan Sorular" : "FAQ")</a>
            <a href="@(isTr ? "/guvenlik-ve-gizlilik" : "/en/security-and-privacy")">@(isTr ? "Güvenlik ve Gizlilik" : "Security & Privacy")</a>
            <a href="@(isTr ? "/pika" : "/en/pika")">@(isTr ? "Pika Nedir?" : "What is Pika?")</a>
            <a href="@(isTr ? "/iletisim" : "/en/contact")">@(isTr ? "İletişim" : "Contact")</a>
            <div class="pk-mobile-cta"><a class="pk-btn pk-btn-ghost" href="/giris">@(isTr ? "Giriş" : "Login")</a><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(isTr ? "Demo Talebi" : "Request Demo")</button></div>
        </div>
    </div>

    <main id="main-content">@RenderBody()</main>

    <footer class="pk-footer">
        <div class="pk-container">
            <div class="pk-footer-cta">
                <div><span class="pk-kicker">Doğru Anda</span><h2>@(isTr ? "Veriyi daha anlamlı kararlara dönüştürün." : "Turn data into more meaningful decisions.")</h2></div>
                <button class="pk-btn pk-btn-light" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">@(isTr ? "Pika'yı Görün" : "See Pika")</button>
            </div>
            <div class="pk-footer-grid">
                <div class="pk-footer-brand"><img src="~/web/assets/images/white-logo.png" alt="Pika" /><p>@(isTr ? "Müşteri ve ürün verisinden fırsatı görünür kılan, karardan aksiyona uzanan müşteri zekâsı ve pazarlama platformu." : "A customer intelligence and marketing platform connecting customer and product context to opportunities and controlled action.")</p></div>
                <div><h3>Platform</h3><a href="@(isTr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")">Customer Intelligence</a><a href="@(isTr ? "/platform/product-intelligence" : "/en/platform/product-intelligence")">Product Intelligence</a><a href="@(isTr ? "/platform/pika-360" : "/en/platform/pika-360")">Pika 360</a><a href="@(isTr ? "/platform/gunun-firsatlari" : "/en/platform/opportunities")">@(isTr ? "Günün Fırsatları" : "Daily Opportunities")</a></div>
                <div><h3>@(isTr ? "Aksiyon" : "Action")</h3><a href="@(isTr ? "/platform/audience-manager" : "/en/platform/audience-manager")">Audience Manager</a><a href="@(isTr ? "/platform/campaign-manager" : "/en/platform/campaign-manager")">Campaign Manager</a><a href="@(isTr ? "/platform/journey-manager" : "/en/platform/journey-manager")">Journey Manager</a><a href="@(isTr ? "/platform/analytics" : "/en/platform/analytics")">Analytics</a></div>
                <div><h3>@(isTr ? "Kaynaklar" : "Resources")</h3><a href="/wiki/">@(isTr ? "Bilgi Bankası" : "Knowledge Base")</a><a href="@(isTr ? "/kullanim-senaryolari" : "/en/use-cases")">@(isTr ? "Kullanım Senaryoları" : "Use Cases")</a><a href="@(isTr ? "/kaynaklar/sss" : "/en/resources/faq")">@(isTr ? "S.S.S." : "FAQ")</a><a href="@(isTr ? "/guvenlik-ve-gizlilik" : "/en/security-and-privacy")">@(isTr ? "Güvenlik ve Gizlilik" : "Security & Privacy")</a></div>
                <div><h3>@(isTr ? "İletişim" : "Contact")</h3><a href="mailto:@site.Contact.SupportEmail">@site.Contact.SupportEmail</a><a href="tel:@site.Contact.SupportPhone">@site.Contact.SupportPhoneDisplay</a><a href="@(isTr ? "/iletisim" : "/en/contact")">@(isTr ? "İletişim formu" : "Contact form")</a><a href="@(isTr ? "/kurumsal" : "/en/corporate")">@(isTr ? "Kurumsal" : "Company")</a></div>
            </div>
            <div class="pk-footer-bottom"><span>© @DateTime.UtcNow.Year Pika</span><div><a href="@(isTr ? "/gizlilik-politikasi" : "/en/privacy-policy")">@(isTr ? "Gizlilik" : "Privacy")</a><a href="@(isTr ? "/kullanim-sartlari" : "/en/terms-of-use")">@(isTr ? "Kullanım Şartları" : "Terms")</a></div></div>
        </div>
    </footer>

    @await Html.PartialAsync("_DemoRequestModal")
    @await Html.PartialAsync("_CookieConsent")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>if(window.AOS){AOS.init({once:true,duration:450,offset:32,disable:function(){return window.matchMedia('(prefers-reduced-motion: reduce)').matches;}});}</script>
    @RenderSection("Scripts", required: false)
</body>
</html>

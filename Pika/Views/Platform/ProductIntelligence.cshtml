@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]=tr?"Product Intelligence | Ürün Zekâsı":"Product Intelligence";
    ViewData["MetaDescription"]=tr?"Pika Product Intelligence; ürünleri kategori, Need Group, Product Role, tekrar tüketim ve satın alma ilişkileriyle anlamlandırarak açıklanabilir fırsat ve aksiyon bağlamı üretir.":"Pika Product Intelligence adds category, Need Group, Product Role, repeat-consumption and purchase-relationship context to products for explainable opportunities and actions.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid"><div class="pk-hero-copy"><span class="pk-eyebrow">Platform · Product Intelligence</span><h1>@(tr?"Ürünün yalnız ne olduğunu değil, ticari olarak ne ifade ettiğini anlayın.":"Understand not only what a product is, but what it means commercially.")</h1><p>@(tr?"Product Intelligence; ürünleri stok kodu ve isim düzeyinden çıkarıp kategori, ihtiyaç, Product Role, tekrar tüketim ve satın alma ilişkileriyle anlamlandırır. Böylece ürün bilgisi yalnız katalog verisi olmaktan çıkar, müşteri fırsatlarını açıklayan karar bağlamına dönüşür.":"Product Intelligence moves products beyond SKU and name by adding category, need, Product Role, repeat-consumption and purchase-relationship context. Product data becomes decision context rather than catalog metadata.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/product-intelligence-nedir">@(tr?"Detaylı bilgi":"Deep dive")</a></div></div><div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_urun-siniflandirma-workbench_13.png" alt="@(tr?"Pika Product Intelligence çalışma alanı":"Pika Product Intelligence workspace")" width="1200" height="760" /><div class="pk-stage-caption"><strong>Product Intelligence</strong><span>Need Group · Product Role · Review</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-stack-line"></i><div><strong>Need Group</strong><small>@(tr?"Ürünün hangi ihtiyaca bağlandığı":"The need a product serves")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-shuffle-line"></i><div><strong>Product Role</strong><small>@(tr?"Tekrar · Cross-sell · Upsell bağlamı":"Repeat · Cross-sell · Upsell context")</small></div></div></div></div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Tanım":"Definition")</span><h2>@(tr?"Product Intelligence nedir?":"What is Product Intelligence?")</h2></div><p class="pk-lead">@(tr?"Pika'da Product Intelligence; satış satırındaki ürün bilgisini gerçek/master ürün, kategori ve ticari anlamla eşleştirerek ürünün hangi ihtiyaca, tekrar davranışına veya tamamlayıcı ilişkiye bağlanabileceğini açıklayan ürün zekâsı katmanıdır. Müşteri zekâsından farklıdır; ikisi fırsat anında birleşebilir.":"In Pika, Product Intelligence resolves transaction-line product data into master product, category and commercial meaning, helping explain the need, repeat behavior or complementary relationship a product may represent. It is distinct from Customer Intelligence, but the two can meet at opportunity time.")</p></div><div class="pk-intel-grid"><article class="pk-intel-panel"><span class="pk-intel-number">01</span><div class="pk-intel-icon"><i class="ri-node-tree"></i></div><h3>@(tr?"Kategori ve ürün anlamı":"Category and product meaning")</h3><p>@(tr?"Ham ürün adını veya kodunu, analitikte kullanılabilecek kategori ve master ürün bağlamına taşıyın. Ürün eşleşmesi güvenilir değilse sonraki analiz de zayıflar.":"Move raw product names or codes into category and master-product context that analytics can use. Weak product resolution weakens downstream analysis.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">02</span><div class="pk-intel-icon"><i class="ri-function-line"></i></div><h3>Need Group + Product Role</h3><p>@(tr?"Ürünün hangi ihtiyaca hizmet ettiğini ve tekrar tüketim, ana ürün, cross-sell veya upsell gibi ticari rolde nasıl ele alınabileceğini tanımlayın.":"Describe the need a product serves and the commercial role it may play, such as repeat consumption, main product, cross-sell or upsell.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">03</span><div class="pk-intel-icon"><i class="ri-links-line"></i></div><h3>@(tr?"Satın alma ilişkileri":"Purchase relationships")</h3><p>@(tr?"Birlikte satın alınan ürünleri ve tekrar davranışını ayrı kanıtlar olarak değerlendirin. Cross-sell ilişkisi ürün düzeyinde kanıt üretir; müşteriye özel aksiyon için müşteri bağlamı ayrıca gerekir.":"Treat co-purchase and repeat behavior as distinct evidence. Product-level cross-sell evidence still needs customer context before becoming a customer action.")</p></article></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Ürünü anlamlandırma":"Product meaning")</span><h2>@(tr?"Katalog verisini ticari karar diline çevirin.":"Turn catalog data into commercial decision language.")</h2></div><p class="pk-lead">@(tr?"Bir ürünün yalnız adı, kodu veya fiyatı çoğu fırsatı açıklamaz. Ürünün hangi ihtiyaca ait olduğu, tekrar alınıp alınmadığı ve başka hangi ürünlerle ilişki kurduğu, fırsat motorunun anlamlı bağlama ihtiyaç duyduğu yerlerdir.":"A product name, code or price alone rarely explains an opportunity. Need, repeatability and relationships with other products are the context opportunity logic needs.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_need-group-product-role_11.png" alt="@(tr?"Need Group ve Product Role görünümü":"Need Group and Product Role view")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Need Group · Product Role</small><h3>@(tr?"Ürüne pazarlama bağlamı ekleyin":"Add marketing context to products")</h3><p>@(tr?"Ürünün ihtiyacını ve rolünü tanımlamak, aynı ürünü her senaryoda aynı şekilde kullanma hatasını azaltır." : "Defining need and role reduces the risk of treating the same product identically in every scenario.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_master-urun-anlamlandirmalari_15.png" alt="@(tr?"Master ürün anlamlandırmaları":"Master product semantics")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Master ürün":"Master product")</small><h3>@(tr?"Ham veriyi güvenilir ürün bağlamına taşıyın":"Resolve raw data into reliable product context")</h3><p>@(tr?"Eşleşme ve sınıflandırma kalitesi, Product Intelligence sonuçlarının açıklanabilirliğini doğrudan etkiler." : "Resolution and classification quality directly affect Product Intelligence explainability.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">Customer vs Product Intelligence</span><h2>@(tr?"Müşteri nasıl davranıyor? Ürün ne anlama geliyor? İki farklı soru.":"How is the customer behaving? What does the product mean? Two different questions.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Customer Intelligence müşterinin değerini, ritmini ve davranış değişimini açıklar. Product Intelligence ise ürünün kategori, ihtiyaç ve ticari rolünü açıklar. Örneğin tekrar satın alma fırsatında müşterinin ritmi ile ürünün tekrar tüketilebilirliği birlikte anlam kazanır.":"Customer Intelligence explains customer value, rhythm and behavioral change. Product Intelligence explains category, need and commercial role. In a repeat-purchase use case, customer rhythm and product repeatability become useful together.")</p></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-user-search-line"></i><div><strong>Customer Intelligence</strong><span>@(tr?"Müşterinin geçmiş davranışı, değer bağlamı ve normal ritmi." : "Customer history, value context and normal rhythm.")</span></div></div><div class="pk-control-step"><i class="ri-shopping-bag-3-line"></i><div><strong>Product Intelligence</strong><span>@(tr?"Ürünün ihtiyacı, kategorisi, rolü ve satın alma ilişkileri." : "Product need, category, role and purchase relationships.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-sparkling-line"></i><div><strong>@(tr?"Fırsat bağlamı":"Opportunity context")</strong><span>@(tr?"İki katmanın kanıtı, uygun olduğunda Günün Fırsatları içinde birleşir." : "Evidence from both layers can meet in Daily Opportunities where appropriate.")</span></div></div><div class="pk-control-step"><i class="ri-route-line"></i><div><strong>@(tr?"Aksiyon":"Action")</strong><span>@(tr?"Kullanıcı kararından sonra Campaign veya Journey üzerinden kontrollü uygulama." : "Controlled Campaign or Journey execution after the user decision.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Senaryolar":"Scenarios")</span><h2>@(tr?"Ürün zekâsı, fırsatın nedenini daha doğru anlatır.":"Product intelligence makes the reason behind an opportunity clearer.")</h2></div><p class="pk-lead">@(tr?"Product Intelligence'ın amacı ürünleri otomatik olarak herkese önermek değildir. Hangi ürün ilişkisinin neden anlamlı olabileceğini açıklayan kanıt ve sınıflandırma katmanıdır.":"Product Intelligence does not exist to automatically recommend every product to everyone. It is the evidence and classification layer explaining why a product relationship may matter.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-refresh-line"></i><strong>@(tr?"Tekrar tüketim":"Repeat consumption")</strong><span>@(tr?"Tekrar alınabilir ürün + müşteri ritmi":"Repeatable product + customer rhythm")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-links-line"></i><strong>Cross-sell</strong><span>@(tr?"Sepet birlikteliği + ürün ilişkisi":"Basket evidence + product relationship")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-arrow-up-circle-line"></i><strong>Upsell</strong><span>@(tr?"Product Role / Playbook bağlamı; genel başarı skoru varsayılmaz":"Product Role / Playbook context; no generic success score implied")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-price-tag-3-line"></i><strong>@(tr?"Kategori fırsatı":"Category opportunity")</strong><span>@(tr?"Ürün ve kategori davranışı":"Product and category behavior")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-user-search-line"></i><strong>@(tr?"Müşteri eşleşmesi":"Customer context")</strong><span>@(tr?"Kişiye özel karar için Customer Intelligence":"Customer Intelligence for customer-level decision")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-sparkling-line"></i><strong>@(tr?"Fırsat":"Opportunity")</strong><span>@(tr?"Günün Fırsatları'na taşınabilir":"Can feed Daily Opportunities")</span></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Güvenilirlik":"Reliability")</span><h2>@(tr?"Ürün zekâsı, veri kalitesi kadar güvenilirdir.":"Product intelligence is only as reliable as product data quality.")</h2></div><p class="pk-lead">@(tr?"Ürün eşleştirme, sınıflandırma ve review akışları Product Intelligence'ın arka plan işi değildir; sonucun ne kadar güvenilir olduğunun temelidir. Eşleşmeyen veya sınıflandırılmamış ürünler güvenilir fırsat kanıtı gibi ele alınmamalıdır.":"Product resolution, classification and review are not background chores; they define the reliability of Product Intelligence. Unresolved or unclassified products should not be treated as trusted opportunity evidence.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_review-resolution-readiness_14.png" alt="@(tr?"Pika ürün review ve readiness ekranı":"Pika product review and readiness screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Review · Resolution · Readiness</small><h3>@(tr?"Belirsizliği gizlemek yerine görünür kılın":"Make uncertainty visible instead of hiding it")</h3><p>@(tr?"Eşleştirme ve sınıflandırma kalitesi, ilgili analitik ve fırsatların hangi veri kapsamına dayandığını anlamaya yardımcı olur." : "Resolution and classification quality help explain the data coverage behind analytics and opportunities.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_kategori-yonetimi_4.png" alt="@(tr?"Pika kategori yönetimi ekranı":"Pika category management screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Kategori yönetimi":"Category management")</small><h3>@(tr?"Ürün evrenini düzenleyin":"Organize the product universe")</h3><p>@(tr?"Tutarlı kategori ve master ürün yapısı, analiz ve fırsat katmanının ortak dilidir." : "Consistent category and master-product structure is shared language for analytics and opportunity logic.")</p></div></div></div><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="/wiki/product-intelligence-nedir">@(tr?"Product Intelligence rehberi":"Product Intelligence guide")</a><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/gunun-firsatlari":"/en/platform/opportunities")">@(tr?"Günün Fırsatları'na geçin":"Go to Daily Opportunities")</a></div></div></section>

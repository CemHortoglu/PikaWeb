@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-platform-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-product-intelligence.css" asp-append-version="true" />
}

@* ── 01 HERO (Restored existing hero shell) ─────────────────── *@
<section class="inner-hero inner-hero--product">
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span>/</span>
                <span>@(tr ? "Ürün Zekâsı" : "Product Intelligence")</span>
            </nav>
            <div class="inner-eyebrow"><span></span>PRODUCT INTELLIGENCE</div>
            @if (tr)
            {
                <h1>
                    Ürünün ne olduğunu değil,<br />
                    ne ifade ettiğini anlayın.
                </h1>
                <p>
                    Pika Product Intelligence, ürünleri yalnızca stok kodu, kategori veya katalog adıyla değerlendirmez. Ürünün hangi müşteri ihtiyacına hizmet ettiğini, bu ihtiyaç içindeki rolünü, tekrar satın alma davranışını ve diğer ürünlerle ilişkisini anlamlandırarak ürünü ticari karar bağlamına taşır.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.72);font-size:15px;margin-bottom:30px">
                    Çünkü müşteri davranışını doğru yorumlamak için yalnızca ne satın alındığını değil, satın alınan ürünün müşteri açısından ne anlama geldiğini de bilmek gerekir.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Demo Talep Et ↗
                    </button>
                    <a class="inner-secondary" href="/platform/customer-intelligence">
                        Customer Intelligence'ı Keşfedin →
                    </a>
                    <a class="inner-secondary" href="#inner-content">
                        Detayları inceleyin ↓
                    </a>
                </div>
            }
            else
            {
                <h1>
                    Understand not only what<br />
                    a product is, but what it means.
                </h1>
                <p>
                    Pika Product Intelligence evaluates products beyond stock codes, categories and catalog names. It turns products into commercial decision context by interpreting the customer need they serve, their role within that need, repeat-purchase behavior and relationships with other products.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.72);font-size:15px;margin-bottom:30px">
                    Because understanding customer behavior requires knowing not only what was purchased, but what that product means from the customer's perspective.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Request a Demo ↗
                    </button>
                    <a class="inner-secondary" href="/en/platform/customer-intelligence">
                        Explore Customer Intelligence →
                    </a>
                    <a class="inner-secondary" href="#inner-content">
                        Explore the details ↓
                    </a>
                </div>
            }
        </div>
        <div class="inner-scene" aria-label="@(tr ? "Platformun çalışma biçimini anlatan örnek görünüm" : "Illustrative view of how the platform works")">
            <div class="inner-scene-orbit" aria-hidden="true"></div>
            <div class="inner-scene-window">
                <div class="inner-window-bar">
                    <strong>pika<span>✳</span></strong>
                    <span>Product Intelligence</span>
                    <small>@(tr ? "Örnek görünüm" : "Illustration")</small>
                </div>
                <div class="inner-products">
                    <div>
                        <i class="ri-cup-line" aria-hidden="true"></i>
                        <small>@(tr ? "ANA ÜRÜN" : "PRIMARY PRODUCT")</small>
                        <strong>@(tr ? "Filtre kahve" : "Filter coffee")</strong>
                    </div>
                    <span>+</span>
                    <div>
                        <i class="ri-filter-line" aria-hidden="true"></i>
                        <small>@(tr ? "TAMAMLAYICI" : "COMPLEMENTARY")</small>
                        <strong>@(tr ? "Kahve filtresi" : "Coffee filters")</strong>
                    </div>
                </div>
                <div class="inner-insight">
                    <span>✳</span>
                    <div>
                        <strong>@(tr ? "Aynı ritüelin iki parçası." : "Two parts of the same ritual.")</strong>
                        <p>@(tr ? "Ürün ilişkilerinden anlamlı önerilere." : "From product relationships to relevant suggestions.")</p>
                    </div>
                </div>
            </div>
            <div class="inner-scene-caption">PRODUCT INTELLIGENCE. MEANINGFUL CONNECTIONS.</div>
        </div>
    </div>
</section>
<div id="inner-content" class="inner-anchor"></div>

@* ── 02 & 03 DIRECT ANSWER + WHY A SKU IS NOT ENOUGH ────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-6">
                <span class="ph-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
                <h2 class="pika-h2 fw-bold mb-3">@(tr ? "Product Intelligence nedir?" : "What is Product Intelligence?")</h2>
                @if (tr)
                {
                    <p class="ph-muted">
                        Product Intelligence, ürün kayıtlarını müşteri ihtiyacı ve ticari bağlam açısından anlamlandıran ürün zekâsı katmanıdır.
                    </p>
                    <p class="ph-muted">
                        Pika'da Product Intelligence; bir ürünün yalnızca hangi kategoriye ait olduğunu değil, hangi ihtiyacı karşıladığını, bu ihtiyaç içindeki rolünü, tekrar satın alma davranışını ve diğer ürünlerle ilişkisini değerlendirmeye yardımcı olur.
                    </p>
                    <p class="ph-muted mb-2">
                        Bu sayede işlem verisindeki: “müşteri X ürününü satın aldı” bilgisi daha anlamlı bir soruya dönüşebilir:
                    </p>
                    <div class="p-3 my-3 rounded bg-white border" style="border:1px solid rgba(128,148,139,.24)">
                        <strong style="color:#23413b">“Müşteri hangi ihtiyacı karşılayan nasıl bir ürün satın aldı?”</strong>
                    </div>
                    <p class="ph-muted">
                        Bu ürün bağlamı daha sonra Customer Intelligence ile birleşerek Pika'nın fırsat ve karar katmanlarını besler.
                    </p>
                }
                else
                {
                    <p class="ph-muted">
                        Product Intelligence is the product-intelligence layer that gives product records meaning in terms of customer need and commercial context.
                    </p>
                    <p class="ph-muted">
                        In Pika, Product Intelligence helps evaluate not only which category a product belongs to, but which need it serves, its role within that need, repeat-purchase behavior and relationships with other products.
                    </p>
                    <p class="ph-muted mb-2">
                        This turns the transaction statement: “the customer purchased product X” into a more meaningful question:
                    </p>
                    <div class="p-3 my-3 rounded bg-white border" style="border:1px solid rgba(128,148,139,.24)">
                        <strong style="color:#23413b">“What kind of product did the customer buy, and which need did it serve?”</strong>
                    </div>
                    <p class="ph-muted">
                        That product context can then combine with Customer Intelligence to feed Pika's opportunity and decision layers.
                    </p>
                }
            </div>

            <div class="col-lg-6">
                <span class="ph-eyebrow">@(tr ? "KATALOGDAN ANLAMA" : "FROM CATALOG TO MEANING")</span>
                <h2 class="pika-h2 fw-bold mb-3">@(tr ? "Stok kodu, ticari anlam değildir." : "A stock code is not commercial meaning.")</h2>
                @if (tr)
                {
                    <p class="ph-muted">
                        Ürün kodları ve katalog kategorileri operasyon için gereklidir. Hangi ürünün satıldığını, hangi kategoride bulunduğunu veya hangi varyantın işlem gördüğünü tanımlarlar.
                    </p>
                    <p class="ph-muted">
                        Ancak müşteri davranışını anlamlandırmak için bu bilgi çoğu zaman yeterli değildir.
                    </p>
                    <p class="ph-muted">
                        Aynı katalog kategorisindeki iki ürün farklı müşteri ihtiyaçlarına hizmet edebilir.
                    </p>
                    <p class="ph-muted">
                        Farklı kategorilerdeki iki ürün ise müşterinin aynı ihtiyacını karşılıyor olabilir.
                    </p>
                    <div class="p-3 my-3 rounded bg-white border">
                        <p class="small mb-1"><strong>Katalog:</strong> “Bu ürün nedir?” sorusuna cevap verir.</p>
                        <p class="small mb-0"><strong>Product Intelligence:</strong> “Bu ürün müşteri ve ticari karar açısından ne ifade ediyor?” sorusuna yaklaşır.</p>
                    </div>
                    <p class="ph-muted">
                        Pika'nın ürün zekâsı yaklaşımı, operasyonel ürün kaydını değiştirmek yerine onun üzerine karar verilebilir bir anlam katmanı ekler.
                    </p>
                }
                else
                {
                    <p class="ph-muted">
                        Product codes and catalog categories are essential for operations. They identify which product was sold, where it belongs and which variant was transacted.
                    </p>
                    <p class="ph-muted">
                        But that information is often not enough to interpret customer behavior.
                    </p>
                    <p class="ph-muted">
                        Two products in the same catalog category may serve different customer needs.
                    </p>
                    <p class="ph-muted">
                        Two products in different categories may satisfy the same underlying need.
                    </p>
                    <div class="p-3 my-3 rounded bg-white border">
                        <p class="small mb-1"><strong>The catalog answers:</strong> “What is this product?”</p>
                        <p class="small mb-0"><strong>Product Intelligence approaches:</strong> “What does this product mean for the customer and the commercial decision?”</p>
                    </div>
                    <p class="ph-muted">
                        Pika's Product Intelligence approach does not replace the operational product record. It adds a decision-ready meaning layer on top of it.
                    </p>
                }
            </div>
        </div>
    </div>
</section>

@* ── 04 FROM PRODUCT RECORD TO PRODUCT MEANING ──────────────── *@
<section class="ph-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="ph-eyebrow">@(tr ? "ÜRÜN BAĞLAMI" : "PRODUCT CONTEXT")</span>
            <h2 class="pika-h2 fw-bold mb-3">@(tr ? "Ürün bilgisini katmanlar halinde anlamlandırın." : "Build product meaning in layers.")</h2>
            <p class="ph-muted" style="max-width:720px;margin-left:auto;margin-right:auto">
                @(tr ? "Product Intelligence, ürün anlamını tek bir etiketle açıklamaz. Farklı bağlam katmanları birlikte kullanıldığında ürün analitik olarak daha kullanılabilir hale gelir." : "Product Intelligence does not explain a product through one label. Product data becomes more useful analytically when multiple context layers are evaluated together.")
            </p>
        </div>

        @{
            var flowTr = new[]
            {
                ("01", "ÜRÜN KAYDI", "Ürün adı, kodu, kategori ve temel katalog bilgisi operasyonel başlangıç noktasıdır."),
                ("02", "SINIFLANDIRMA BAĞLAMI", "Ürünün hangi sınıflandırma çerçevesinde değerlendirilmesi gerektiği belirlenir."),
                ("03", "İHTİYAÇ", "Ürünün müşteri açısından hangi ihtiyaca hizmet ettiği anlamlandırılır."),
                ("04", "ÜRÜN ROLÜ", "Ürünün ihtiyaç ve ticari bağlam içindeki fonksiyonu değerlendirilir."),
                ("05", "DAVRANIŞ & İLİŞKİLER", "Tekrar satın alma davranışı ve diğer ürünlerle oluşan ilişkiler değerlendirme bağlamına eklenir."),
                ("06", "TİCARİ BAĞLAM", "Ürün, müşteri zekâsı ve fırsat katmanlarının kullanabileceği daha anlamlı bir veri varlığına dönüşür.")
            };
            var flowEn = new[]
            {
                ("01", "PRODUCT RECORD", "Product name, code, category and basic catalog data form the operational starting point."),
                ("02", "CLASSIFICATION CONTEXT", "The framework through which the product should be evaluated is established."),
                ("03", "NEED", "The customer need served by the product is interpreted."),
                ("04", "PRODUCT ROLE", "The product's function within need and commercial context is evaluated."),
                ("05", "BEHAVIOR & RELATIONSHIPS", "Repeat-purchase behavior and relationships with other products are added to the evaluation context."),
                ("06", "COMMERCIAL CONTEXT", "The product becomes a more meaningful data asset that customer-intelligence and opportunity layers can use.")
            };
            var flowSteps = tr ? flowTr : flowEn;
        }

        <div class="row g-3">
            @foreach (var (num, title, desc) in flowSteps)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-start gap-3 p-3 rounded h-100" style="background:#fff;border:1px solid #dce5d3">
                        <div class="fw-bold" style="font-size:.85rem;color:#7a9845;min-width:24px">@num</div>
                        <div>
                            <div class="fw-bold mb-1" style="font-size:.9rem;color:#23413b">@title</div>
                            <div style="font-size:.82rem;color:#62746d;line-height:1.6">@desc</div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-4 p-3 rounded text-center" style="background:#f8faf4;border:1px dashed #dce5d3;max-width:720px;margin-left:auto;margin-right:auto">
            <p class="small mb-0" style="color:#62746d">
                @(tr ? "Amaç ürüne daha fazla etiket eklemek değil, ürün bilgisini ticari karar için daha anlamlı hale getirmektir." : "The objective is not to attach more labels to a product. It is to make product data more meaningful for commercial decision making.")
            </p>
        </div>
    </div>
</section>

@* ── 05, 06, 07 NEED GROUP, PRODUCT ROLE, PLAYBOOK ──────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="ph-module-card h-100 p-4">
                    <div class="ph-module-icon mb-3"><i class="ri-list-check-3"></i></div>
                    <span class="ph-eyebrow">NEED GROUP</span>
                    <h2 class="pika-h2 fw-bold mb-3" style="font-size:1.35rem">
                        @(tr ? "Kategori, müşterinin ihtiyacıyla aynı şey değildir." : "A category is not the same thing as a customer need.")
                    </h2>
                    @if (tr)
                    {
                        <p class="ph-muted small">
                            Katalog kategorileri ürünleri operasyonel veya ticari hiyerarşi içinde düzenler.
                        </p>
                        <p class="ph-muted small mb-2">
                            Need Group ise ürüne başka bir açıdan bakar:
                        </p>
                        <div class="p-3 my-3 rounded bg-white border" style="border:1px solid rgba(128,148,139,.24)">
                            <strong style="color:#23413b">“Bu ürün müşterinin hangi ihtiyacına hizmet ediyor?”</strong>
                        </div>
                        <p class="ph-muted small">
                            Bu ayrım önemlidir; çünkü aynı ihtiyacı karşılayan ürünler her zaman aynı katalog kategorisinde bulunmayabilir.
                        </p>
                        <p class="ph-muted small">
                            Benzer şekilde aynı kategoride yer alan ürünler müşterinin farklı ihtiyaçlarını karşılıyor olabilir.
                        </p>
                        <div class="p-3 my-3 rounded bg-white border">
                            <p class="small mb-1"><strong>CATEGORY:</strong> Ürünün katalogdaki yeri.</p>
                            <p class="small mb-0"><strong>NEED GROUP:</strong> Ürünün müşteri ihtiyacı içindeki anlamı.</p>
                        </div>
                        <p class="ph-muted small mb-0">
                            Need Group bağlamı, ürün bilgisinin müşteri davranışıyla daha anlamlı biçimde ilişkilendirilmesine yardımcı olur.
                        </p>
                    }
                    else
                    {
                        <p class="ph-muted small">
                            Catalog categories organize products within an operational or commercial hierarchy.
                        </p>
                        <p class="ph-muted small mb-2">
                            A Need Group looks at the product from another perspective:
                        </p>
                        <div class="p-3 my-3 rounded bg-white border" style="border:1px solid rgba(128,148,139,.24)">
                            <strong style="color:#23413b">“Which customer need does this product serve?”</strong>
                        </div>
                        <p class="ph-muted small">
                            This distinction matters because products serving the same need do not always belong to the same catalog category.
                        </p>
                        <p class="ph-muted small">
                            Likewise, products in the same category may serve different customer needs.
                        </p>
                        <div class="p-3 my-3 rounded bg-white border">
                            <p class="small mb-1"><strong>CATEGORY:</strong> Where the product sits in the catalog.</p>
                            <p class="small mb-0"><strong>NEED GROUP:</strong> What the product means within customer need.</p>
                        </div>
                        <p class="ph-muted small mb-0">
                            Need Group context helps product data relate more meaningfully to customer behavior.
                        </p>
                    }
                </div>
            </div>

            <div class="col-lg-6">
                <div class="ph-module-card h-100 p-4">
                    <div class="ph-module-icon mb-3"><i class="ri-price-tag-3-line"></i></div>
                    <span class="ph-eyebrow">PRODUCT ROLE</span>
                    <h2 class="pika-h2 fw-bold mb-3" style="font-size:1.35rem">
                        @(tr ? "Aynı ihtiyaca hizmet eden her ürün aynı rolü taşımaz." : "Products serving the same need do not necessarily play the same role.")
                    </h2>
                    @if (tr)
                    {
                        <p class="ph-muted small">
                            Need Group, ürünün hangi ihtiyaca hizmet ettiğini açıklar.
                        </p>
                        <p class="ph-muted small">
                            Product Role ise ürünün bu ihtiyaç ve ticari bağlam içinde nasıl bir fonksiyon taşıdığını değerlendirmeye yardımcı olur.
                        </p>
                        <p class="ph-muted small">
                            Bir ürün müşteri için ihtiyacın merkezinde olabilir.
                        </p>
                        <p class="ph-muted small">
                            Başka bir ürün aynı ihtiyacı tamamlayabilir.
                        </p>
                        <p class="ph-muted small">
                            Bir başka ürün ise alternatif veya farklı bir ticari işlev taşıyabilir.
                        </p>
                        <p class="ph-muted small">
                            Bu rol bilgisi özellikle ürünlerin birbirleriyle ilişkisini, teklif yapısını ve fırsat bağlamını değerlendirirken önem kazanır.
                        </p>
                        <div class="p-3 my-3 rounded bg-white border">
                            <p class="small mb-1"><strong>Need Group:</strong> “Neden?”</p>
                            <p class="small mb-0"><strong>Product Role:</strong> “Bu ihtiyacın içinde nasıl bir rol?”</p>
                        </div>
                        <p class="ph-muted small mb-0">
                            Pika böylece ürünleri yalnızca aynı kategori altında toplamak yerine, müşteri ihtiyacı içindeki fonksiyonları açısından da değerlendirebilir.
                        </p>
                    }
                    else
                    {
                        <p class="ph-muted small">
                            A Need Group explains which need a product serves.
                        </p>
                        <p class="ph-muted small">
                            Product Role helps evaluate the function the product plays within that need and commercial context.
                        </p>
                        <p class="ph-muted small">
                            One product may sit at the center of the customer's need.
                        </p>
                        <p class="ph-muted small">
                            Another may complement that need.
                        </p>
                        <p class="ph-muted small">
                            Another may serve as an alternative or play a different commercial function.
                        </p>
                        <p class="ph-muted small">
                            Role context becomes especially useful when evaluating product relationships, offer structure and commercial opportunities.
                        </p>
                        <div class="p-3 my-3 rounded bg-white border">
                            <p class="small mb-1"><strong>Need Group:</strong> “Why?”</p>
                            <p class="small mb-0"><strong>Product Role:</strong> “What role does the product play within that need?”</p>
                        </div>
                        <p class="ph-muted small mb-0">
                            This allows Pika to evaluate products not only as members of the same category, but through their function within customer need.
                        </p>
                    }
                </div>
            </div>
        </div>

        @* Playbook Card *@
        <div class="ph-module-card p-4">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="ph-eyebrow">PLAYBOOK</span>
                    <h2 class="pika-h2 fw-bold mb-3" style="font-size:1.35rem">
                        @(tr ? "Ürün anlamı, sektör bağlamından bağımsız değildir." : "Product meaning depends on industry context.")
                    </h2>
                    @if (tr)
                    {
                        <p class="ph-muted small">
                            Aynı sınıflandırma mantığını her ürün dünyasına zorla uygulamak, ürünün ticari anlamını zayıflatabilir.
                        </p>
                        <p class="ph-muted small">
                            Pika Playbook yaklaşımı, ürünlerin hangi anlamlandırma boyutlarıyla değerlendirileceğini sektör ve kategori bağlamında düzenlemeye yardımcı olur.
                        </p>
                        <p class="ph-muted small">
                            Playbook; ürün kategorisi, Need Group, Product Role ve gerektiğinde ek sınıflandırma özellikleri arasında ortak bir çerçeve oluşturur.
                        </p>
                        <p class="ph-muted small">
                            Bu çerçevenin amacı ürünleri daha karmaşık hale getirmek değildir.
                        </p>
                        <div class="p-3 my-2 rounded bg-white border">
                            <p class="small mb-1"><strong>Amaç:</strong></p>
                            <p class="small mb-0">Farklı ürün dünyalarını aynı ticari karar dili içinde tutarlı biçimde anlamlandırabilmek.</p>
                        </div>
                        <p class="ph-muted small mb-0 mt-3">
                            Sınıflandırma sonuçları gerektiğinde insan incelemesi ve doğrulamasıyla kontrol edilebilir; ürün gerçeği yalnızca üretken yapay zekâ tarafından belirlenmiş bir etiket olarak ele alınmaz.
                        </p>
                    }
                    else
                    {
                        <p class="ph-muted small">
                            Forcing the same classification logic onto every product universe can weaken commercial meaning.
                        </p>
                        <p class="ph-muted small">
                            Pika's Playbook approach helps organize which dimensions should be used to interpret products within industry and category context.
                        </p>
                        <p class="ph-muted small">
                            A Playbook provides a common framework across product category, Need Group, Product Role and additional classification attributes where required.
                        </p>
                        <p class="ph-muted small">
                            The purpose of that framework is not to make products more complicated.
                        </p>
                        <div class="p-3 my-2 rounded bg-white border">
                            <p class="small mb-1"><strong>The purpose is:</strong></p>
                            <p class="small mb-0">To interpret different product universes consistently within the same commercial decision language.</p>
                        </div>
                        <p class="ph-muted small mb-0 mt-3">
                            Classification results can be reviewed and verified by people where needed; product truth is not treated merely as a label generated by generative AI.
                        </p>
                    }
                </div>
                <div class="col-lg-4 text-center mt-4 mt-lg-0">
                    <div class="p-4 rounded" style="background:#f8faf4;border:1px solid #dce5d3">

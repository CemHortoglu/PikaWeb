@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-platform-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-product-intelligence.css" asp-append-version="true" />
}

<div class="pika-pi-page">
    <a href="#inner-content" class="pika-pi-skip-anchor visually-hidden-focusable">@(tr ? "İçeriğe atla" : "Skip to content")</a>

    @* ── 01 HERO ────────────────────────────────────────────────── *@
    <section class="pika-pi-hero">
        <div class="pika-pi-container">
            <nav class="pika-pi-breadcrumb" aria-label="@(tr ? "Navigasyon" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">@(tr ? "Ana Sayfa" : "Home")</a>
                <span class="pika-pi-breadcrumb-sep" aria-hidden="true">/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span class="pika-pi-breadcrumb-sep" aria-hidden="true">/</span>
                <span class="pika-pi-breadcrumb-current">@(tr ? "Ürün Zekâsı" : "Product Intelligence")</span>
            </nav>

            <div class="pika-pi-hero-grid">
                <div class="pika-pi-hero-content">
                    <div class="pika-pi-eyebrow-row">
                        <span class="pika-pi-eyebrow">PRODUCT INTELLIGENCE</span>
                        <span class="pika-pi-entity-label">@(tr ? "Ürün Zekâsı" : "Product Intelligence")</span>
                    </div>

                    @if (tr)
                    {
                        <h1 class="pika-pi-hero-title">
                            Ürünün ne olduğunu değil,<br />
                            ne ifade ettiğini anlayın.
                        </h1>
                        <p class="pika-pi-hero-lead">
                            Pika Product Intelligence, ürünleri yalnızca stok kodu, kategori veya katalog adıyla değerlendirmez. Ürünün hangi müşteri ihtiyacına hizmet ettiğini, bu ihtiyaç içindeki rolünü, tekrar satın alma davranışını ve diğer ürünlerle ilişkisini anlamlandırarak ürünü ticari karar bağlamına taşır.
                        </p>
                        <p class="pika-pi-hero-supporting">
                            Çünkü müşteri davranışını doğru yorumlamak için yalnızca ne satın alındığını değil, satın alınan ürünün müşteri açısından ne anlama geldiğini de bilmek gerekir.
                        </p>
                        <div class="pika-pi-hero-actions">
                            <button type="button" class="pika-pi-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">
                                <span>Demo Talep Et</span>
                                <i class="ri-arrow-right-up-line" aria-hidden="true"></i>
                            </button>
                            <a href="/platform/customer-intelligence" class="pika-pi-btn-secondary">
                                <span>Customer Intelligence'ı Keşfedin</span>
                                <i class="ri-arrow-right-line" aria-hidden="true"></i>
                            </a>
                        </div>
                    }
                    else
                    {
                        <h1 class="pika-pi-hero-title">
                            Understand not only what<br />
                            a product is, but what it means.
                        </h1>
                        <p class="pika-pi-hero-lead">
                            Pika Product Intelligence evaluates products beyond stock codes, categories and catalog names. It turns products into commercial decision context by interpreting the customer need they serve, their role within that need, repeat-purchase behavior and relationships with other products.
                        </p>
                        <p class="pika-pi-hero-supporting">
                            Because understanding customer behavior requires knowing not only what was purchased, but what that product means from the customer's perspective.
                        </p>
                        <div class="pika-pi-hero-actions">
                            <button type="button" class="pika-pi-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">
                                <span>Request a Demo</span>
                                <i class="ri-arrow-right-up-line" aria-hidden="true"></i>
                            </button>
                            <a href="/en/platform/customer-intelligence" class="pika-pi-btn-secondary">
                                <span>Explore Customer Intelligence</span>
                                <i class="ri-arrow-right-line" aria-hidden="true"></i>
                            </a>
                        </div>
                    }
                </div>

                <div class="pika-pi-hero-diagram-wrap" aria-hidden="true">
                    <div class="pika-pi-concept-spine">
                        <div class="pika-pi-spine-node pika-pi-spine-node--start">
                            <span class="pika-pi-spine-tag">01</span>
                            <strong>PRODUCT</strong>
                        </div>
                        <div class="pika-pi-spine-connector">
                            <i class="ri-arrow-down-line"></i>
                        </div>
                        <div class="pika-pi-spine-node">
                            <span class="pika-pi-spine-tag">02</span>
                            <strong>NEED</strong>
                        </div>
                        <div class="pika-pi-spine-connector">
                            <i class="ri-arrow-down-line"></i>
                        </div>
                        <div class="pika-pi-spine-node">
                            <span class="pika-pi-spine-tag">03</span>
                            <strong>ROLE</strong>
                        </div>
                        <div class="pika-pi-spine-connector">
                            <i class="ri-arrow-down-line"></i>
                        </div>
                        <div class="pika-pi-spine-node">
                            <span class="pika-pi-spine-tag">04</span>
                            <strong>RELATIONSHIPS</strong>
                        </div>
                        <div class="pika-pi-spine-connector">
                            <i class="ri-arrow-down-line"></i>
                        </div>
                        <div class="pika-pi-spine-node pika-pi-spine-node--accent">
                            <span class="pika-pi-spine-tag">05</span>
                            <strong>COMMERCIAL CONTEXT</strong>
                        </div>
                        <div class="pika-pi-diagram-caption">
                            @(tr ? "Örnek görünüm · Ürün verisinden ticari bağlama akış" : "Illustration · Flow from product data to commercial context")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ── 02 DIRECT ANSWER ───────────────────────────────────────── *@
    <section class="pika-pi-section pika-pi-section--light" id="inner-content">
        <div class="pika-pi-container">
            <div class="pika-pi-direct-answer-card">
                <span class="pika-pi-section-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
                <h2 class="pika-pi-section-title">@(tr ? "Product Intelligence nedir?" : "What is Product Intelligence?")</h2>

                @if (tr)
                {
                    <p class="pika-pi-body-text">
                        Product Intelligence, ürün kayıtlarını müşteri ihtiyacı ve ticari bağlam açısından anlamlandıran ürün zekâsı katmanıdır.
                    </p>
                    <p class="pika-pi-body-text">
                        Pika'da Product Intelligence; bir ürünün yalnızca hangi kategoriye ait olduğunu değil, hangi ihtiyacı karşıladığını, bu ihtiyaç içindeki rolünü, tekrar satın alma davranışını ve diğer ürünlerle ilişkisini değerlendirmeye yardımcı olur.
                    </p>
                    <p class="pika-pi-body-text">
                        Bu sayede işlem verisindeki: “müşteri X ürününü satın aldı” bilgisi daha anlamlı bir soruya dönüşebilir:
                    </p>
                    <div class="pika-pi-large-question">
                        “Müşteri hangi ihtiyacı<br />
                        karşılayan nasıl bir ürün satın aldı?”
                    </div>
                    <p class="pika-pi-body-text mt-4">
                        Bu ürün bağlamı daha sonra Customer Intelligence ile birleşerek Pika'nın fırsat ve karar katmanlarını besler.
                    </p>
                }
                else
                {
                    <p class="pika-pi-body-text">
                        Product Intelligence is the product-intelligence layer that gives product records meaning in terms of customer need and commercial context.
                    </p>
                    <p class="pika-pi-body-text">
                        In Pika, Product Intelligence helps evaluate not only which category a product belongs to, but which need it serves, its role within that need, repeat-purchase behavior and relationships with other products.
                    </p>
                    <p class="pika-pi-body-text">
                        This turns the transaction statement: “the customer purchased product X” into a more meaningful question:
                    </p>
                    <div class="pika-pi-large-question">
                        “What kind of product did the customer buy,<br />
                        and which need did it serve?”
                    </div>
                    <p class="pika-pi-body-text mt-4">
                        That product context can then combine with Customer Intelligence to feed Pika's opportunity and decision layers.
                    </p>
                }
            </div>
        </div>
    </section>

    @* ── 03 WHY A SKU IS NOT ENOUGH ─────────────────────────────── *@
    <section class="pika-pi-section">
        <div class="pika-pi-container pika-pi-container--narrow">
            <span class="pika-pi-section-eyebrow">@(tr ? "KATALOGDAN ANLAMA" : "FROM CATALOG TO MEANING")</span>
            @if (tr)
            {
                <h2 class="pika-pi-section-title">
                    Stok kodu,<br />
                    ticari anlam değildir.
                </h2>
                <div class="pika-pi-prose">
                    <p class="pika-pi-body-text">
                        Ürün kodları ve katalog kategorileri operasyon için gereklidir. Hangi ürünün satıldığını, hangi kategoride bulunduğunu veya hangi varyantın işlem gördüğünü tanımlarlar.
                    </p>
                    <p class="pika-pi-body-text">
                        Ancak müşteri davranışını anlamlandırmak için bu bilgi çoğu zaman yeterli değildir.
                    </p>
                    <p class="pika-pi-body-text">
                        Aynı katalog kategorisindeki iki ürün farklı müşteri ihtiyaçlarına hizmet edebilir.
                    </p>
                    <p class="pika-pi-body-text">
                        Farklı kategorilerdeki iki ürün ise müşterinin aynı ihtiyacını karşılıyor olabilir.
                    </p>
                    <div class="pika-pi-emphasis-statement">
                        <p class="mb-2"><strong>Katalog:</strong></p>
                        <p class="mb-3">“Bu ürün nedir?” sorusuna cevap verir.</p>
                        <p class="mb-2"><strong>Product Intelligence:</strong></p>
                        <p class="mb-0">“Bu ürün müşteri ve ticari karar açısından ne ifade ediyor?” sorusuna yaklaşır.</p>
                    </div>
                    <p class="pika-pi-body-text">
                        Pika'nın ürün zekâsı yaklaşımı, operasyonel ürün kaydını değiştirmek yerine onun üzerine karar verilebilir bir anlam katmanı ekler.
                    </p>
                </div>
            }
            else
            {
                <h2 class="pika-pi-section-title">
                    A stock code<br />
                    is not commercial meaning.
                </h2>
                <div class="pika-pi-prose">
                    <p class="pika-pi-body-text">
                        Product codes and catalog categories are essential for operations. They identify which product was sold, where it belongs and which variant was transacted.
                    </p>
                    <p class="pika-pi-body-text">
                        But that information is often not enough to interpret customer behavior.
                    </p>
                    <p class="pika-pi-body-text">
                        Two products in the same catalog category may serve different customer needs.
                    </p>
                    <p class="pika-pi-body-text">
                        Two products in different categories may satisfy the same underlying need.
                    </p>
                    <div class="pika-pi-emphasis-statement">
                        <p class="mb-2"><strong>The catalog answers:</strong></p>
                        <p class="mb-3">“What is this product?”</p>
                        <p class="mb-2"><strong>Product Intelligence approaches:</strong></p>
                        <p class="mb-0">“What does this product mean for the customer and the commercial decision?”</p>
                    </div>
                    <p class="pika-pi-body-text">
                        Pika's Product Intelligence approach does not replace the operational product record. It adds a decision-ready meaning layer on top of it.
                    </p>
                </div>
            }
        </div>
    </section>

    @* ── 04 FROM PRODUCT RECORD TO PRODUCT MEANING ──────────────── *@
    <section class="pika-pi-section pika-pi-section--alt">
        <div class="pika-pi-container pika-pi-container--narrow">
            <span class="pika-pi-section-eyebrow">@(tr ? "ÜRÜN BAĞLAMI" : "PRODUCT CONTEXT")</span>
            @if (tr)
            {
                <h2 class="pika-pi-section-title">
                    Ürün bilgisini<br />
                    katmanlar halinde anlamlandırın.
                </h2>
                <p class="pika-pi-lead-paragraph">
                    Product Intelligence, ürün anlamını tek bir etiketle açıklamaz. Farklı bağlam katmanları birlikte kullanıldığında ürün analitik olarak daha kullanılabilir hale gelir.
                </p>

                <div class="pika-pi-editorial-list">
                    <div class="pika-pi-editorial-item">
                        <div class="pika-pi-editorial-meta">
                            <span class="pika-pi-editorial-num">01</span>
                            <h3 class="pika-pi-editorial-heading">ÜRÜN KAYDI</h3>
                        </div>
                        <p class="pika-pi-editorial-desc">
                            Ürün adı, kodu, kategori ve temel katalog bilgisi operasyonel başlangıç noktasıdır.
                        </p>
                    </div>

                    <div class="pika-pi-editorial-item">
                        <div class="pika-pi-editorial-meta">
                            <span class="pika-pi-editorial-num">02</span>
                            <h3 class="pika-pi-editorial-heading">SINIFLANDIRMA BAĞLAMI</h3>
                        </div>
                        <p class="pika-pi-editorial-desc">
                            Ürünün hangi sınıflandırma çerçevesinde değerlendirilmesi gerektiği belirlenir.
                        </p>
                    </div>

                    <div class="pika-pi-editorial-item">
                        <div class="pika-pi-editorial-meta">
                            <span class="pika-pi-editorial-num">03</span>
                            <h3 class="pika-pi-editorial-heading">İHTİYAÇ</h3>
                        </div>
                        <p class="pika-pi-editorial-desc">
                            Ürünün müşteri açısından hangi ihtiyaca hizmet ettiği anlamlandırılır.
                        </p>
                    </div>

                    <div class="pika-pi-editorial-item">
                        <div class="pika-pi-editorial-meta">
                            <span class="pika-pi-editorial-num">04</span>
                            <h3 class="pika-pi-editorial-heading">ÜRÜN ROLÜ</h3>
                        </div>
                        <p class="pika-pi-editorial-desc">
                            Ürünün ihtiyaç ve ticari bağlam içindeki fonksiyonu değerlendirilir.
                        </p>
                    </div>

                    <div class="pika-pi-editorial-item">
                        <div class="pika-pi-editorial-meta">
                            <span class="pika-pi-editorial-num">05</span>
                            <h3 class="pika-pi-editorial-heading">DAVRANIŞ &amp; İLİŞKİLER</h3>
                        </div>
                        <p class="pika-pi-editorial-desc">
                            Tekrar satın alma davranışı ve diğer ürünlerle oluşan ilişkiler değerlendirme bağlamına eklenir.
                        </p>
                    </div>

                    <div class="pika-pi-editorial-item">
                        <div class="pika-pi-editorial-meta">
                            <span class="pika-pi-editorial-num">06</span>
                            <h3 class="pika-pi-editorial-heading">TİCARİ BAĞLAM</h3>
                        </div>
                        <p class="pika-pi-editorial-desc">
                            Ürün, müşteri zekâsı ve fırsat katmanlarının kullanabileceği daha anlamlı bir veri varlığına dönüşür.
                        </p>
                    </div>
                </div>

                <div class="pika-pi-closing-box">
                    <p class="pika-pi-body-text mb-0">
                        Amaç ürüne daha fazla etiket eklemek değil, ürün bilgisini ticari karar için daha anlamlı hale getirmektir.
                    </p>
                </div>
            }
            else
            {
                <h2 class="pika-pi-section-title">
                    Build product meaning<br />
                    in layers.
                </h2>
                <p class="pika-pi-lead-paragraph">
                    Product Intelligence does not explain a product through one label. Product data becomes more useful analytically when multiple context layers are evaluated together.
                </p>

                <div class="pika-pi-editorial-list">
                    <div class="pika-pi-editorial-item">
                        <div class="pika-pi-editorial-meta">
                            <span class="pika-pi-editorial-num">01</span>
                            <h3 class="pika-pi-editorial-heading">PRODUCT RECORD</h3>
                        </div>
                        <p class="pika-pi-editorial-desc">
                            Product name, code, category and basic catalog data form the operational starting point.
                        </p>
                    </div>

                    <div class="pika-pi-editorial-item">
                        <div class="pika-pi-editorial-meta">
                            <span class="pika-pi-editorial-num">02</span>
                            <h3 class="pika-pi-editorial-heading">CLASSIFICATION CONTEXT</h3>
                        </div>
                        <p class="pika-pi-editorial-desc">
                            The framework through which the product should be evaluated is established.
                        </p>
                    </div>

                    <div class="pika-pi-editorial-item">
                        <div class="pika-pi-editorial-meta">
                            <span class="pika-pi-editorial-num">03</span>
                            <h3 class="pika-pi-editorial-heading">NEED</h3>
                        </div>
                        <p class="pika-pi-editorial-desc">
                            The customer need served by the product is interpreted.
                        </p>
                    </div>

                    <div class="pika-pi-editorial-item">
                        <div class="pika-pi-editorial-meta">
                            <span class="pika-pi-editorial-num">04</span>
                            <h3 class="pika-pi-editorial-heading">PRODUCT ROLE</h3>
                        </div>
                        <p class="pika-pi-editorial-desc">
                            The product's function within need and commercial context is evaluated.
                        </p>
                    </div>

                    <div class="pika-pi-editorial-item">
                        <div class="pika-pi-editorial-meta">
                            <span class="pika-pi-editorial-num">05</span>
                            <h3 class="pika-pi-editorial-heading">BEHAVIOR &amp; RELATIONSHIPS</h3>
                        </div>
                        <p class="pika-pi-editorial-desc">
                            Repeat-purchase behavior and relationships with other products are added to the evaluation context.
                        </p>
                    </div>

                    <div class="pika-pi-editorial-item">
                        <div class="pika-pi-editorial-meta">
                            <span class="pika-pi-editorial-num">06</span>
                            <h3 class="pika-pi-editorial-heading">COMMERCIAL CONTEXT</h3>
                        </div>
                        <p class="pika-pi-editorial-desc">
                            The product becomes a more meaningful data asset that customer-intelligence and opportunity layers can use.
                        </p>
                    </div>
                </div>

                <div class="pika-pi-closing-box">
                    <p class="pika-pi-body-text mb-0">
                        The objective is not to attach more labels to a product. It is to make product data more meaningful for commercial decision making.
                    </p>
                </div>
            }
        </div>
    </section>

    @* ── 05 NEED GROUP ──────────────────────────────────────────── *@
    <section class="pika-pi-section">
        <div class="pika-pi-container pika-pi-container--narrow">
            <span class="pika-pi-section-eyebrow">NEED GROUP</span>
            @if (tr)
            {
                <h2 class="pika-pi-section-title">
                    Kategori,<br />
                    müşterinin ihtiyacıyla<br />
                    aynı şey değildir.
                </h2>
                <div class="pika-pi-prose">
                    <p class="pika-pi-body-text">
                        Katalog kategorileri ürünleri operasyonel veya ticari hiyerarşi içinde düzenler.
                    </p>
                    <p class="pika-pi-body-text mb-2">
                        Need Group ise ürüne başka bir açıdan bakar:
                    </p>
                    <div class="pika-pi-large-question">
                        “Bu ürün müşterinin<br />
                        hangi ihtiyacına hizmet ediyor?”
                    </div>
                    <p class="pika-pi-body-text mt-4">
                        Bu ayrım önemlidir; çünkü aynı ihtiyacı karşılayan ürünler her zaman aynı katalog kategorisinde bulunmayabilir.
                    </p>
                    <p class="pika-pi-body-text">
                        Benzer şekilde aynı kategoride yer alan ürünler müşterinin farklı ihtiyaçlarını karşılıyor olabilir.
                    </p>
                    <div class="pika-pi-comparison-box">
                        <div class="pika-pi-comparison-item">
                            <span class="pika-pi-comparison-badge">CATEGORY</span>
                            <p class="mb-0">Ürünün katalogdaki yeri.</p>
                        </div>
                        <div class="pika-pi-comparison-item pika-pi-comparison-item--accent">
                            <span class="pika-pi-comparison-badge pika-pi-comparison-badge--accent">NEED GROUP</span>
                            <p class="mb-0">Ürünün müşteri ihtiyacı içindeki anlamı.</p>
                        </div>
                    </div>
                    <p class="pika-pi-body-text mt-4">
                        Need Group bağlamı, ürün bilgisinin müşteri davranışıyla daha anlamlı biçimde ilişkilendirilmesine yardımcı olur.
                    </p>
                </div>
            }
            else
            {
                <h2 class="pika-pi-section-title">
                    A category<br />
                    is not the same thing<br />
                    as a customer need.
                </h2>
                <div class="pika-pi-prose">
                    <p class="pika-pi-body-text">
                        Catalog categories organize products within an operational or commercial hierarchy.
                    </p>
                    <p class="pika-pi-body-text mb-2">
                        A Need Group looks at the product from another perspective:
                    </p>
                    <div class="pika-pi-large-question">
                        “Which customer need<br />
                        does this product serve?”
                    </div>
                    <p class="pika-pi-body-text mt-4">
                        This distinction matters because products serving the same need do not always belong to the same catalog category.
                    </p>
                    <p class="pika-pi-body-text">
                        Likewise, products in the same category may serve different customer needs.
                    </p>
                    <div class="pika-pi-comparison-box">
                        <div class="pika-pi-comparison-item">
                            <span class="pika-pi-comparison-badge">CATEGORY</span>
                            <p class="mb-0">Where the product sits in the catalog.</p>
                        </div>
                        <div class="pika-pi-comparison-item pika-pi-comparison-item--accent">
                            <span class="pika-pi-comparison-badge pika-pi-comparison-badge--accent">NEED GROUP</span>
                            <p class="mb-0">What the product means within customer need.</p>
                        </div>
                    </div>
                    <p class="pika-pi-body-text mt-4">
                        Need Group context helps product data relate more meaningfully to customer behavior.
                    </p>
                </div>
            }
        </div>
    </section>

    @* ── 06 PRODUCT ROLE ────────────────────────────────────────── *@
    <section class="pika-pi-section pika-pi-section--light">
        <div class="pika-pi-container pika-pi-container--narrow">
            <span class="pika-pi-section-eyebrow">PRODUCT ROLE</span>
            @if (tr)
            {
                <h2 class="pika-pi-section-title">
                    Aynı ihtiyaca hizmet eden<br />
                    her ürün aynı rolü taşımaz.
                </h2>
                <div class="pika-pi-prose">
                    <p class="pika-pi-body-text">
                        Need Group, ürünün hangi ihtiyaca hizmet ettiğini açıklar.
                    </p>
                    <p class="pika-pi-body-text">
                        Product Role ise ürünün bu ihtiyaç ve ticari bağlam içinde nasıl bir fonksiyon taşıdığını değerlendirmeye yardımcı olur.
                    </p>
                    <p class="pika-pi-body-text">
                        Bir ürün müşteri için ihtiyacın merkezinde olabilir.
                    </p>
                    <p class="pika-pi-body-text">
                        Başka bir ürün aynı ihtiyacı tamamlayabilir.
                    </p>
                    <p class="pika-pi-body-text">
                        Bir başka ürün ise alternatif veya farklı bir ticari işlev taşıyabilir.
                    </p>
                    <p class="pika-pi-body-text">
                        Bu rol bilgisi özellikle ürünlerin birbirleriyle ilişkisini, teklif yapısını ve fırsat bağlamını değerlendirirken önem kazanır.
                    </p>
                    <div class="pika-pi-closing-manifesto">
                        <p class="mb-1"><strong>Need Group:</strong> “Neden?”</p>
                        <p class="mb-0"><strong>Product Role:</strong> “Bu ihtiyacın içinde nasıl bir rol?”</p>
                    </div>
                    <p class="pika-pi-body-text mt-4">
                        Pika böylece ürünleri yalnızca aynı kategori altında toplamak yerine, müşteri ihtiyacı içindeki fonksiyonları açısından da değerlendirebilir.
                    </p>
                </div>
            }
            else
            {
                <h2 class="pika-pi-section-title">
                    Products serving the same need<br />
                    do not necessarily play the same role.
                </h2>
                <div class="pika-pi-prose">
                    <p class="pika-pi-body-text">
                        A Need Group explains which need a product serves.
                    </p>
                    <p class="pika-pi-body-text">
                        Product Role helps evaluate the function the product plays within that need and commercial context.
                    </p>
                    <p class="pika-pi-body-text">
                        One product may sit at the center of the customer's need.
                    </p>
                    <p class="pika-pi-body-text">
                        Another may complement that need.
                    </p>
                    <p class="pika-pi-body-text">
                        Another may serve as an alternative or play a different commercial function.
                    </p>
                    <p class="pika-pi-body-text">
                        Role context becomes especially useful when evaluating product relationships, offer structure and commercial opportunities.
                    </p>
                    <div class="pika-pi-closing-manifesto">
                        <p class="mb-1"><strong>Need Group:</strong> “Why?”</p>
                        <p class="mb-0"><strong>Product Role:</strong> “What role does the product play within that need?”</p>
                    </div>
                    <p class="pika-pi-body-text mt-4">
                        This allows Pika to evaluate products not only as members of the same category, but through their function within customer need.
                    </p>
                </div>
            }
        </div>
    </section>

    @* ── 07 PLAYBOOK & CLASSIFICATION CONTEXT ───────────────────── *@
    <section class="pika-pi-section">
        <div class="pika-pi-container pika-pi-container--narrow">
            <span class="pika-pi-section-eyebrow">PLAYBOOK</span>
            @if (tr)
            {
                <h2 class="pika-pi-section-title">
                    Ürün anlamı,<br />
                    sektör bağlamından bağımsız değildir.
                </h2>
                <div class="pika-pi-prose">
                    <p class="pika-pi-body-text">
                        Aynı sınıflandırma mantığını her ürün dünyasına zorla uygulamak, ürünün ticari anlamını zayıflatabilir.
                    </p>
                    <p class="pika-pi-body-text">
                        Pika Playbook yaklaşımı, ürünlerin hangi anlamlandırma boyutlarıyla değerlendirileceğini sektör ve kategori bağlamında düzenlemeye yardımcı olur.
                    </p>
                    <p class="pika-pi-body-text">
                        Playbook; ürün kategorisi, Need Group, Product Role ve gerektiğinde ek sınıflandırma özellikleri arasında ortak bir çerçeve oluşturur.
                    </p>
                    <p class="pika-pi-body-text">
                        Bu çerçevenin amacı ürünleri daha karmaşık hale getirmek değildir.
                    </p>
                    <div class="pika-pi-emphasis-statement">
                        <p class="mb-1"><strong>Amaç:</strong></p>
                        <p class="mb-0">Farklı ürün dünyalarını aynı ticari karar dili içinde tutarlı biçimde anlamlandırabilmek.</p>
                    </div>
                    <p class="pika-pi-body-text mt-4">
                        Sınıflandırma sonuçları gerektiğinde insan incelemesi ve doğrulamasıyla kontrol edilebilir; ürün gerçeği yalnızca üretken yapay zekâ tarafından belirlenmiş bir etiket olarak ele alınmaz.
                    </p>
                </div>
            }
            else
            {
                <h2 class="pika-pi-section-title">
                    Product meaning<br />
                    depends on industry context.
                </h2>
                <div class="pika-pi-prose">
                    <p class="pika-pi-body-text">
                        Forcing the same classification logic onto every product universe can weaken commercial meaning.
                    </p>
                    <p class="pika-pi-body-text">
                        Pika's Playbook approach helps organize which dimensions should be used to interpret products within industry and category context.
                    </p>
                    <p class="pika-pi-body-text">
                        A Playbook provides a common framework across product category, Need Group, Product Role and additional classification attributes where required.
                    </p>
                    <p class="pika-pi-body-text">
                        The purpose of that framework is not to make products more complicated.
                    </p>
                    <div class="pika-pi-emphasis-statement">
                        <p class="mb-1"><strong>The purpose is:</strong></p>
                        <p class="mb-0">To interpret different product universes consistently within the same commercial decision language.</p>
                    </div>
                    <p class="pika-pi-body-text mt-4">
                        Classification results can be reviewed and verified by people where needed; product truth is not treated merely as a label generated by generative AI.
                    </p>
                </div>
            }
        </div>
    </section>

    @* ── 08 REPEAT-PURCHASE CONTEXT ─────────────────────────────── *@
    <section class="pika-pi-section pika-pi-section--light">
        <div class="pika-pi-container pika-pi-container--narrow">
            <span class="pika-pi-section-eyebrow">@(tr ? "TEKRAR SATIN ALMA" : "REPEAT PURCHASE")</span>
            @if (tr)
            {
                <h2 class="pika-pi-section-title">
                    Bazı ürünlerin değeri,<br />
                    bir kez satın alındıkları anda bitmez.
                </h2>
                <div class="pika-pi-prose">
                    <p class="pika-pi-body-text">
                        Ürünler tekrar satın alma davranışı açısından birbirinden farklıdır.
                    </p>
                    <p class="pika-pi-body-text">
                        Bazı ürünlerde düzenli veya tekrar eden satın alma örüntüsü oluşabilirken bazı ürünlerde bu davranış anlamlı olmayabilir.
                    </p>
                    <p class="pika-pi-body-text">
                        Product Intelligence ürün bağlamının, geçmiş işlem davranışıyla birlikte değerlendirilmesine yardımcı olur.
                    </p>
                    <p class="pika-pi-body-text">
                        Bu sayede tekrar davranışı anlamlı olan ürünler için ürünün kendisi, müşteri ritmi ve geçmiş işlem aralıkları aynı fırsat bağlamında değerlendirilebilir.
                    </p>
                    <div class="pika-pi-boundary-card">
                        <p><strong>Product Intelligence:</strong><br />“Bu müşterinin bir sonraki alışverişini kesin olarak bilir” iddiasında bulunmaz.</p>
                        <p class="mb-0"><strong>Product Intelligence:</strong><br />Ürünün tekrar davranışı açısından değerlendirilebilir bağlamını sağlar.</p>
                    </div>
                    <p class="pika-pi-body-text mt-4">
                        Müşteri bazındaki kişisel satın alma ritmi Customer Intelligence tarafından değerlendirilir; ürün bağlamı ile müşteri bağlamı daha sonra Günün Fırsatları katmanında bir araya gelebilir.
                    </p>
                    <div class="mt-4">
                        <a href="/platform/gunun-firsatlari" class="pika-pi-text-link">
                            Günün Fırsatlarını Keşfedin &rarr;
                        </a>
                    </div>
                </div>
            }
            else
            {
                <h2 class="pika-pi-section-title">
                    The value of some products<br />
                    does not end with one purchase.
                </h2>
                <div class="pika-pi-prose">
                    <p class="pika-pi-body-text">
                        Products differ in repeat-purchase behavior.
                    </p>
                    <p class="pika-pi-body-text">
                        Some products may show recurring purchasing patterns, while repeat behavior may not be meaningful for others.
                    </p>
                    <p class="pika-pi-body-text">
                        Product Intelligence helps product context be evaluated together with historical transaction behavior.
                    </p>
                    <p class="pika-pi-body-text">
                        For products where repeat behavior is meaningful, the product itself, customer rhythm and historical transaction intervals can contribute to the same opportunity context.
                    </p>

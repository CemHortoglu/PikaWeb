@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]=tr?"Product Intelligence | Ürün Zekâsı":"Product Intelligence";
    ViewData["MetaDescription"]=tr?"Ürünleri kategori, Need Group, Product Role ve satın alma ilişkileriyle anlamlandırarak tekrar satın alma ve cross-sell gibi senaryolara daha açıklanabilir ürün bağlamı ekleyin.":"Understand products through category, Need Group, Product Role and purchase relationships to provide explainable context for repeat purchase and cross-sell use cases.";
    ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">Platform · Product Intelligence</span><h1>@(tr?"Ürünün ne olduğunu değil, ticari bağlamda ne ifade ettiğini anlayın.":"Understand not only what a product is, but what it means commercially.")</h1><p>@(tr?"Product Intelligence, ürünleri yalnız stok kodu veya isim olarak görmek yerine kategori, ihtiyaç, Product Role ve satın alma ilişkileriyle anlamlandırır. Böylece ürün bilgisi müşteri fırsatlarında kullanılabilir bir bağlama dönüşür.":"Product Intelligence moves beyond SKU/name by adding category, need, Product Role and purchase-relationship context so product knowledge can support customer opportunities.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/product-intelligence-nedir">@(tr?"Bilgi Bankası":"Knowledge Base")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_urun-siniflandirma-workbench_13.png" alt="@(tr?"Pika ürün sınıflandırma çalışma alanı":"Pika product classification workbench")" width="1200" height="760" /><figcaption>@(tr?"Ürün eşleştirme, sınıflandırma ve inceleme süreçleri analitik bağlamın güvenilirliğini artırır.":"Product resolution, classification and review help make analytical context more reliable.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">Customer vs Product Intelligence</span><h2>@(tr?"Müşteriyi anlamakla ürünü anlamak aynı şey değildir.":"Understanding the customer and understanding the product are different jobs.")</h2></div><p class="pk-lead">@(tr?"Customer Intelligence 'müşteri nasıl davranıyor?' sorusuna yaklaşırken Product Intelligence 'bu ürün hangi ihtiyacı ve ticari rolü temsil ediyor?' sorusuna bağlam ekler. Fırsat motoru gerektiğinde iki katmanı birlikte kullanabilir.":"Customer Intelligence asks how the customer behaves; Product Intelligence adds context around the need and commercial role a product represents. Opportunity logic can use both when relevant.")</p></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container"><span class="pk-eyebrow">@(tr?"Ürün dili":"Product language")</span><div class="pk-columns"><div class="pk-feature"><i class="ri-folder-tree-line"></i><h3>@(tr?"Kategori ve hiyerarşi":"Category & hierarchy")</h3><p>@(tr?"Ana/alt kategori ve entegrasyon kodları ürünün nerede konumlandığını daha tutarlı hale getirir.":"Category hierarchy and integration codes make product placement more consistent.")</p></div><div class="pk-feature"><i class="ri-focus-3-line"></i><h3>Need Group</h3><p>@(tr?"Ürünün müşterinin hangi ihtiyacını temsil ettiğini ayrı bir kavram olarak tanımlar.":"Describes which customer need the product represents as a separate concept.")</p></div><div class="pk-feature"><i class="ri-route-line"></i><h3>Product Role</h3><p>@(tr?"Ürünün ana ürün, tekrar tüketim, cross-sell veya upsell bağlamındaki ticari görevini tanımlamaya yardımcı olur.":"Helps describe a product's commercial role in core, repeat, cross-sell or upsell contexts.")</p></div></div></div></section>
<section class="pk-section"><div class="pk-container pk-screen-band"><div><span class="pk-eyebrow">@(tr?"Açıklanabilir ilişki":"Explainable relationships")</span><h2>@(tr?"Cross-sell önce ürün ilişkisini kanıtlar.":"Cross-sell starts by establishing product relationship evidence.")</h2><p class="pk-lead">@(tr?"Pika'nın Cross-sell BI katmanı uygun sepetlerdeki ürün çiftlerini support, confidence ve lift gibi birliktelik metrikleriyle değerlendirir. Bu ekran tek başına 'bu müşterinin dönüşüm olasılığı %X' diyen bir tahmin servisi değildir.":"Pika's Cross-sell BI evaluates product pairs in eligible baskets using co-occurrence metrics such as support, confidence and lift. It is not, by itself, a service claiming a customer-specific conversion probability.")</p><a class="pk-btn pk-btn-ghost" href="/wiki/cross-sell-analizi">@(tr?"Cross-sell ayrıntıları":"Cross-sell details")</a></div><img src="/wiki/assets/images/img_need-group-product-role_11.png" alt="Need Group ve Product Role ekranı" loading="lazy" width="1200" height="760" /></div></section>
<section class="pk-section pk-section-deep"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow" style="color:#d1ea88">@(tr?"Üründen fırsata":"From product to opportunity")</span><h2>@(tr?"Ürün kanıtını müşteri bağlamıyla birleştirin.":"Combine product evidence with customer context.")</h2></div><div><p class="pk-lead">@(tr?"Ürün ilişkisi doğrulandıktan sonra müşterinin gerçekten aldığı ürün, kategori, satın alma ritmi, izin ve diğer müşteri sinyalleri devreye girer. Product Intelligence önerinin bağlamını güçlendirir; müşterinin davranışını varsaymaz.":"Once a product relationship is established, actual customer purchases, category, purchase rhythm, consent and other customer signals can be added. Product Intelligence strengthens recommendation context; it does not assume customer intent.")</p><a class="pk-btn pk-btn-light" href="@(tr?"/platform/gunun-firsatlari":"/en/platform/opportunities")">@(tr?"Günün Fırsatları":"Daily Opportunities")</a></div></div></section>

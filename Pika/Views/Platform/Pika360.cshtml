@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]="Pika 360 | "+(tr?"Müşteri Karar Görünümü":"Customer Decision View");
    ViewData["MetaDescription"]=tr?"Bir müşterinin profil, işlem, segment, davranış, fırsat ve aksiyon bağlamını Pika 360 içinde birlikte değerlendirin.":"Review profile, transactions, segments, behavior, opportunities and action context together in Pika 360.";
    ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">Platform · Pika 360</span><h1>@(tr?"Bir müşteriyi tek satırdan değil, karar bağlamıyla görün.":"See a customer as decision context, not a single row.")</h1><p>@(tr?"Pika 360; Pika'nın müşteri hakkında hesapladığı ve topladığı profil, işlem, segment, davranış, fırsat ve aksiyon bağlamını tek görünümde değerlendirmeyi kolaylaştıran müşteri karar ekranıdır.":"Pika 360 is a customer decision view that brings together profile, transaction, segment, behavior, opportunity and action context calculated or held by Pika.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/pika-360">@(tr?"Bilgi Bankası":"Knowledge Base")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_pika-360_7.png" alt="Pika 360 müşteri görünümü" width="1200" height="760" /><figcaption>@(tr?"Profilin kapsamı kaynak veriye bağlıdır; eksik veri varsa görünüm de kısmi olabilir.":"Profile completeness depends on source data; incomplete evidence can result in a partial view.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">@(tr?"Tek ekran, farklı bağlamlar":"One view, multiple contexts")</span><h2>@(tr?"'Bu müşteri kim?' sorusundan 'şimdi ne anlatıyor?' sorusuna.":"Move from 'who is this customer?' to 'what does the context tell us now?'")</h2></div><p class="pk-lead">@(tr?"Pika 360'ın amacı tüm dünyadaki veriyi sihirli biçimde tekilleştirdiğini iddia etmek değil; Pika'ya güvenilir şekilde bağlı müşteri ve ticari bağlamı kullanıcı için birlikte okunabilir hale getirmektir.":"Pika 360 does not claim magical identity resolution across every possible source. Its role is to make reliably connected customer and commercial context readable together.")</p></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container"><div class="pk-columns"><div class="pk-feature"><i class="ri-profile-line"></i><h3>@(tr?"Profil ve ilişki":"Profile & relationship")</h3><p>@(tr?"Müşterinin temel kimlik/iletişim bağlamını ve ürün içindeki ilişki görünümünü bir arada değerlendirin.":"Review identity/contact context and the relationship view available in the product.")</p></div><div class="pk-feature"><i class="ri-shopping-cart-line"></i><h3>@(tr?"Satın alma ve davranış":"Purchases & behavior")</h3><p>@(tr?"İşlem geçmişi, alışveriş ritmi ve desteklenen müşteri davranışı sinyallerini birlikte okuyun.":"Read transaction history, purchase rhythm and supported customer-behavior signals together.")</p></div><div class="pk-feature"><i class="ri-lightbulb-flash-line"></i><h3>@(tr?"Segment, fırsat ve aksiyon":"Segment, opportunity & action")</h3><p>@(tr?"Müşterinin bulunduğu segmentleri ve oluşan fırsat/aksiyon bağlamını aynı karar ekranında değerlendirin.":"Review segments and available opportunity/action context in the same decision view.")</p></div></div></div></section>
<section class="pk-section"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">@(tr?"Nereden beslenir?":"What feeds it?")</span><h2>Customer Intelligence + Product Intelligence</h2></div><div><p class="pk-lead">@(tr?"Pika 360 tek başına bağımsız bir 'AI profil motoru' değildir. Customer Intelligence müşteri davranışını; Product Intelligence ürün bağlamını açıklar. Pika 360 bu çıktıları müşteri üzerinde değerlendirmeyi kolaylaştırır.":"Pika 360 is not a standalone AI profile engine. Customer Intelligence explains customer behavior; Product Intelligence adds product context. Pika 360 helps review those outputs around the customer.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/customer-intelligence":"/en/platform/customer-intelligence")">Customer Intelligence</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/product-intelligence":"/en/platform/product-intelligence")">Product Intelligence</a></div></div></div></section>
<section class="pk-section pk-section-deep"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow" style="color:#d1ea88">@(tr?"Karar görünümü":"Decision view")</span><h2>@(tr?"Müşteri hakkında daha çok veri göstermek değil, daha anlamlı karar vermek.":"The goal is not more customer data; it is more meaningful decisions.")</h2></div><div><p class="pk-lead">@(tr?"Bir fırsat veya öneri oluştuğunda Pika 360 kullanıcıya müşterinin ilgili bağlamını görme zemini sağlar. Gerçek aksiyon yine izin, kanal uygunluğu ve kullanıcı kontrolüyle Campaign/Journey tarafında uygulanır.":"When an opportunity is surfaced, Pika 360 provides customer context for review. Actual execution still happens through Campaign/Journey with consent, channel eligibility and user control.")</p><a class="pk-btn pk-btn-light" href="@(tr?"/platform/gunun-firsatlari":"/en/platform/opportunities")">@(tr?"Günün Fırsatları":"Daily Opportunities")</a></div></div></section>

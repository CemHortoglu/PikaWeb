@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]="Pika 360 | "+(tr?"Müşteri Karar Görünümü":"Customer Decision View");
    ViewData["MetaDescription"]=tr?"Pika 360 ile müşteri profilini, işlem geçmişini, segmentleri, davranış sinyallerini, fırsatları ve aksiyon bağlamını tek müşteri üzerinde birlikte değerlendirin.":"Use Pika 360 to review profile, transaction history, segments, behavioral signals, opportunities and action context around one customer.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid">
    <div class="pk-hero-copy"><span class="pk-eyebrow">Platform · Pika 360</span><h1>@(tr?"Bir müşteriyi tek satırdan değil, bütün karar bağlamıyla görün.":"See a customer as a complete decision context, not a single row.")</h1><p>@(tr?"Pika 360; Pika'ya bağlı müşteri verisini, gerçekleşmiş işlemleri, segmentleri, davranış sinyallerini, fırsatları ve aksiyon bağlamını tek müşteri görünümünde bir araya getirir. Amaç daha çok alan göstermek değil, 'bu müşteri için şimdi ne biliyorum?' sorusunu cevaplamaktır.":"Pika 360 brings connected customer data, observed transactions, segments, behavioral signals, opportunities and action context into one customer view. The goal is not more fields, but answering: what do I know about this customer now?")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Pika 360'ı Canlı Görün":"See Pika 360 Live")</button><a class="pk-btn pk-btn-ghost" href="/wiki/pika-360">@(tr?"Detaylı bilgi":"Deep dive")</a></div><div class="pk-hero-note"><i class="ri-information-line"></i><span>@(tr?"Görünüm, Pika'ya güvenilir biçimde ulaşan veri kadar kapsamlıdır; eksik kaynak veri sihirli biçimde tamamlanmaz.":"The view is only as complete as reliably connected data; missing source data is not magically inferred.")</span></div></div>
    <div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_pika-360_7.png" alt="@(tr?"Pika 360 müşteri karar görünümü":"Pika 360 customer decision view")" width="1200" height="760" /><div class="pk-stage-caption"><strong>Pika 360</strong><span>@(tr?"Profil · İşlem · Segment · Fırsat · Aksiyon":"Profile · Transaction · Segment · Opportunity · Action")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-shopping-bag-3-line"></i><div><strong>@(tr?"Satın alma bağlamı":"Purchase context")</strong><small>@(tr?"İşlem ve ritim":"Transactions and rhythm")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-sparkling-2-line"></i><div><strong>@(tr?"Fırsatlar":"Opportunities")</strong><small>@(tr?"Neden şimdi?":"Why now?")</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-message-3-line"></i><div><strong>@(tr?"İletişim geçmişi":"Communication context")</strong><small>@(tr?"İzin ve etkileşim":"Consent and engagement")</small></div></div></div>
</div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Tanım":"Definition")</span><h2>@(tr?"Pika 360 nedir?":"What is Pika 360?")</h2></div><p class="pk-lead">@(tr?"Pika 360, müşteri hakkında Pika'nın hesapladığı veya güvenilir kaynaklardan aldığı profil, işlem, segment, davranış, fırsat ve iletişim bağlamını tek müşteri etrafında okunabilir hale getiren karar görünümüdür. Bağımsız bir 'AI profil motoru' veya her kaynağı otomatik tekilleştiren sınırsız CDP iddiası değildir.":"Pika 360 is a decision view that makes profile, transaction, segment, behavioral, opportunity and communication context calculated by Pika or received from trusted sources readable around one customer. It is not a claim of unlimited automatic identity resolution across every possible source.")</p></div>
<div class="pk-intel-grid"><article class="pk-intel-panel"><span class="pk-intel-number">01</span><div class="pk-intel-icon"><i class="ri-profile-line"></i></div><h3>@(tr?"Profil ve ilişki":"Profile and relationship")</h3><p>@(tr?"Temel müşteri ve iletişim bilgilerini, hesabın Pika içindeki ilişki bağlamıyla birlikte görün. Profil alanlarının kapsamı bağlı veri kaynaklarına göre değişir.":"See core customer and contact information together with the relationship context available in Pika. Profile coverage depends on connected sources.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">02</span><div class="pk-intel-icon"><i class="ri-shopping-cart-2-line"></i></div><h3>@(tr?"İşlem ve davranış":"Transactions and behavior")</h3><p>@(tr?"Gerçekleşmiş satışları, ürün ilişkilerini, alışveriş ritmini ve desteklenen davranış sinyallerini müşterinin geçmişiyle birlikte değerlendirin.":"Review observed purchases, product relationships, purchase rhythm and supported behavioral signals together with customer history.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">03</span><div class="pk-intel-icon"><i class="ri-lightbulb-flash-line"></i></div><h3>@(tr?"Segment, fırsat ve aksiyon":"Segment, opportunity and action")</h3><p>@(tr?"Müşterinin dahil olduğu segmentleri, oluşan fırsatları ve bunların hangi kontrollü aksiyona bağlanabileceğini aynı karar bağlamında okuyun.":"Review segments, surfaced opportunities and the controlled actions they may connect to within one decision context.")</p></article></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Tek müşteride bağlam":"Context around one customer")</span><h2>@(tr?"'Kim?' sorusunu 'neden şimdi?' sorusuyla birleştirin.":"Connect 'who?' with 'why now?'")</h2></div><p class="pk-lead">@(tr?"Bir müşteri değerli olabilir ama normal satın alma ritminden uzaklaşıyor olabilir. Başka bir müşteri tekrar satın alma penceresine girmiş, ilgili bir ürün ilişkisi taşıyor ve uygun bir iletişim kanalına sahip olabilir. Pika 360 bu parçaları birbirinden kopuk ekranlar yerine aynı müşteri üzerinde okumayı kolaylaştırır.":"A customer may be valuable but drifting from normal purchase rhythm. Another may be entering a repeat-purchase window, have relevant product context and an eligible communication channel. Pika 360 makes these pieces easier to read together.")</p></div>
<div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_pika-360_7.png" alt="@(tr?"Pika 360 tek müşteri görünümü":"Pika 360 single-customer view")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Pika 360</small><h3>@(tr?"Karar için gereken bağlam tek yerde":"Decision context in one place")</h3><p>@(tr?"Profil, işlem, segment, davranış ve fırsat bilgileri müşterinin güncel durumunu anlamaya yardımcı olur." : "Profile, transactions, segments, behavior and opportunities help explain the customer's current situation.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_ai-musteri-ozeti_8.png" alt="@(tr?"Pika AI müşteri özeti ekranı":"Pika AI customer summary screen")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"AI destekli özet":"AI-assisted summary")</small><h3>@(tr?"Veriyi özetleyin; hesaplamayı AI sanmayın":"Summarize context without confusing AI with calculation")</h3><p>@(tr?"AI müşteri bağlamını açıklamaya yardımcı olabilir. Deterministik hesaplamalar ve kaynak veriler ayrı kalır; AI yorumu bunların yerine geçmez." : "AI can help explain customer context. Deterministic calculations and source data remain distinct; AI interpretation does not replace them.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">@(tr?"Nereden beslenir?":"What feeds it?")</span><h2>Customer Intelligence + Product Intelligence</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Pika 360 tek başına müşteriyi 'hesaplayan' bir modül değildir. Customer Intelligence müşteri davranışı, değer ve ritim bağlamını; Product Intelligence ürün, ihtiyaç ve satın alma ilişkisi bağlamını üretir. Pika 360 bu çıktıları tek müşteri üzerinde birlikte değerlendirmeyi kolaylaştırır.":"Pika 360 is not a standalone module that 'calculates the customer.' Customer Intelligence contributes behavior, value and rhythm context; Product Intelligence contributes product, need and purchase-relationship context. Pika 360 brings those outputs together around the customer.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/customer-intelligence":"/en/platform/customer-intelligence")">Customer Intelligence</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/product-intelligence":"/en/platform/product-intelligence")">Product Intelligence</a></div></div>
<div class="pk-control-flow"><div class="pk-control-step"><i class="ri-user-search-line"></i><div><strong>Customer Intelligence</strong><span>@(tr?"Değer, satın alma ritmi, davranış değişimi ve risk/fırsat sinyalleri." : "Value, purchase rhythm, behavioral change and risk/opportunity signals.")</span></div></div><div class="pk-control-step"><i class="ri-shopping-bag-3-line"></i><div><strong>Product Intelligence</strong><span>@(tr?"Kategori, Need Group, Product Role ve satın alma ilişkileri." : "Category, Need Group, Product Role and purchase relationships.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-focus-2-line"></i><div><strong>Pika 360</strong><span>@(tr?"Bu bağlamların tek müşteri üzerinde birlikte okunması." : "Reading those contexts together around one customer.")</span></div></div><div class="pk-control-step"><i class="ri-sparkling-2-line"></i><div><strong>@(tr?"Fırsat ve karar":"Opportunity and decision")</strong><span>@(tr?"Kullanıcının neden aksiyon düşünmesi gerektiğini görmesi." : "Helping the user see why action may be worth considering.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Karar görünümü":"Decision view")</span><h2>@(tr?"Daha çok veri göstermek değil, daha anlamlı karar vermek.":"The goal is not more data. It is a better decision.")</h2></div><p class="pk-lead">@(tr?"Pika 360'ın değeri bir müşteriye ait bütün alanları üst üste yığmasında değil; fırsat, segment, ürün ve iletişim bağlamını aynı karar zincirinde değerlendirebilmesindedir. Gerçek aksiyon yine izin, kanal uygunluğu ve kullanıcı kontrolüyle yürütülür.":"Pika 360's value is not piling up every customer field, but making opportunity, segment, product and communication context readable within the same decision chain. Execution still respects consent, channel eligibility and user control.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-user-line"></i><strong>@(tr?"Müşteri":"Customer")</strong><span>@(tr?"Kim? Hangi profil ve ilişki?":"Who? What profile and relationship?")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-shopping-cart-line"></i><strong>@(tr?"Davranış":"Behavior")</strong><span>@(tr?"Ne aldı, hangi ritimde?":"What did they buy and at what rhythm?")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-filter-3-line"></i><strong>@(tr?"Segment":"Segment")</strong><span>@(tr?"Hangi iş kuralı bağlamında?":"Under which business-rule context?")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Fırsat":"Opportunity")</strong><span>@(tr?"Neden şimdi?":"Why now?")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-shield-check-line"></i><strong>@(tr?"Uygunluk":"Eligibility")</strong><span>@(tr?"İzin, opt-out, kanal":"Consent, opt-out, channel")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-route-line"></i><strong>@(tr?"Aksiyon":"Action")</strong><span>Campaign · Journey · @(tr?"veya aksiyon alma":"or no action")</span></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Bir yönetici ne görür?":"What does a manager see?")</span><h2>@(tr?"Müşterinin geçmişini, bugünkü durumunu ve olası sonraki adımı birbirinden ayırın.":"Separate customer history, current state and possible next step.")</h2></div><p class="pk-lead">@(tr?"Pika 360 geçmiş veriyi gösterirken geleceği kesinmiş gibi sunmamalıdır. Gerçekleşmiş işlem ve segment bilgisi ile hesaplanmış fırsat/karar sinyali ve AI yorumu kaynaklarına göre ayrılabilir.":"Pika 360 should not present future outcomes as facts. Observed transactions and segments, calculated opportunity signals and AI interpretation can remain distinguishable by source.")</p></div><div class="pk-columns"><div class="pk-feature"><i class="ri-history-line"></i><h3>@(tr?"Geçmiş":"History")</h3><p>@(tr?"Gerçekleşmiş işlem, ürün ve iletişim geçmişini müşterinin davranış örüntüsünü anlamak için kullanın." : "Use observed transaction, product and communication history to understand customer patterns.")</p></div><div class="pk-feature"><i class="ri-pulse-line"></i><h3>@(tr?"Bugün":"Now")</h3><p>@(tr?"Segment, risk, ritim ve fırsat bağlamıyla müşterinin şu anki durumunu değerlendirin." : "Evaluate the customer's current state through segment, risk, rhythm and opportunity context.")</p></div><div class="pk-feature"><i class="ri-route-line"></i><h3>@(tr?"Sonraki adım":"Next step")</h3><p>@(tr?"Kullanıcı fırsatı inceler; gerekiyorsa Campaign veya Journey hazırlığını başlatır ya da hiçbir aksiyon almaz." : "The user reviews the opportunity and may start Campaign or Journey preparation — or choose no action.")</p></div></div><div class="pk-actions"><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/gunun-firsatlari":"/en/platform/opportunities")">@(tr?"Günün Fırsatları'na geçin":"Go to Daily Opportunities")</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/kullanim-senaryolari":"/en/use-cases")">@(tr?"Kullanım senaryolarını görün":"Explore use cases")</a></div></div></section>

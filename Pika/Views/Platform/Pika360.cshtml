@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-platform-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-360-page.css" asp-append-version="true" />
}

@* ── 01 HERO (Reproduced safely without fabricated customer metrics) ── *@
<section class="inner-hero inner-hero--customer">
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span>/</span>
                <span>Pika 360</span>
            </nav>
            <div class="inner-eyebrow"><span></span>PIKA 360</div>
            @if (tr)
            {
                <h1>
                    Müşteriyi yalnızca kimliğiyle değil,<br />
                    bütün karar bağlamıyla görün.
                </h1>
                <p>
                    Pika 360; müşterinin işlem geçmişini, hesaplanan değer göstergelerini, davranış bağlamını, iletişim erişilebilirliğini ve açık fırsatlarını tek müşteri perspektifinde bir araya getirir.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.72);font-size:15px;margin-bottom:30px">
                    Amaç yalnızca müşteriye ait daha fazla veri göstermek değil, farklı Pika bağlamlarını tek bir soruya cevap verecek şekilde birleştirmektir: Bu müşteri şu anda nasıl bir durumda?
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Demo Talep Et ↗
                    </button>
                    <a class="inner-secondary" href="/platform/customer-intelligence">
                        Customer Intelligence'ı Keşfedin →
                    </a>
                    <a class="inner-secondary" href="#inner-content">
                        Detayları inceleyin ↓
                    </a>
                </div>
            }
            else
            {
                <h1>
                    See more than customer identity.<br />
                    See the complete decision context.
                </h1>
                <p>
                    Pika 360 brings the customer's transaction history, calculated value indicators, behavioral context, communication reachability and open opportunities together within a single customer perspective.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.72);font-size:15px;margin-bottom:30px">
                    The objective is not simply to display more customer data. It is to bring different Pika contexts together around one question: What is the customer's current situation?
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Request a Demo ↗
                    </button>
                    <a class="inner-secondary" href="/en/platform/customer-intelligence">
                        Explore Customer Intelligence →
                    </a>
                    <a class="inner-secondary" href="#inner-content">
                        Explore the details ↓
                    </a>
                </div>
            }
        </div>
        <div class="inner-scene" aria-label="@(tr ? "Platformun çalışma biçimini anlatan örnek görünüm" : "Illustrative view of how the platform works")">
            <div class="inner-scene-orbit" aria-hidden="true"></div>
            <div class="inner-scene-window">
                <div class="inner-window-bar">
                    <strong>pika<span>✳</span></strong>
                    <span>Pika 360</span>
                    <small>@(tr ? "Örnek görünüm" : "Illustration")</small>
                </div>
                <div class="p-3 d-flex flex-column gap-2" style="background:#f6f9f0">
                    <div class="d-flex align-items-center gap-2 p-2 rounded bg-white border" style="font-size:12px;color:#23413b">
                        <i class="ri-history-line" style="color:#7a9845"></i>
                        <strong>@(tr ? "İŞLEM GEÇMİŞİ" : "TRANSACTION HISTORY")</strong>
                    </div>
                    <div class="d-flex align-items-center gap-2 p-2 rounded bg-white border" style="font-size:12px;color:#23413b">
                        <i class="ri-shield-star-line" style="color:#7a9845"></i>
                        <strong>@(tr ? "MÜŞTERİ DEĞERİ" : "CUSTOMER VALUE")</strong>
                    </div>
                    <div class="d-flex align-items-center gap-2 p-2 rounded bg-white border" style="font-size:12px;color:#23413b">
                        <i class="ri-user-follow-line" style="color:#7a9845"></i>
                        <strong>@(tr ? "DAVRANIŞ" : "BEHAVIOR")</strong>
                    </div>
                    <div class="d-flex align-items-center gap-2 p-2 rounded bg-white border" style="font-size:12px;color:#23413b">
                        <i class="ri-chat-check-line" style="color:#7a9845"></i>
                        <strong>@(tr ? "ERİŞİLEBİLİRLİK" : "REACHABILITY")</strong>
                    </div>
                    <div class="d-flex align-items-center gap-2 p-2 rounded bg-white border" style="font-size:12px;color:#23413b">
                        <i class="ri-focus-3-line" style="color:#7a9845"></i>
                        <strong>@(tr ? "AÇIK FIRSATLAR" : "OPEN OPPORTUNITIES")</strong>
                    </div>
                </div>
                <div class="inner-insight m-3">
                    <span>✳</span>
                    <div>
                        <strong>@(tr ? "Bütünleşik karar bağlamı." : "Unified decision context.")</strong>
                        <p>@(tr ? "Tek bir müşteri perspektifinde tüm sinyaller." : "All signals within a single customer perspective.")</p>
                    </div>
                </div>
            </div>
            <div class="inner-scene-caption">PIKA 360. MEANINGFUL CONNECTIONS.</div>
        </div>
    </div>
</section>
<div id="inner-content" class="inner-anchor"></div>

@* ── 02 & 03 DIRECT ANSWER + WHY A CUSTOMER RECORD IS NOT ENOUGH ── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-6">
                <span class="ph-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
                <h2 class="pika-h2 fw-bold mb-3">@(tr ? "Pika 360 nedir?" : "What is Pika 360?")</h2>
                @if (tr)
                {
                    <p class="ph-muted">
                        Pika 360, tek bir müşteriye ait işlem geçmişini, hesaplanan müşteri değerini, davranış bağlamını, iletişim erişilebilirliğini ve açık fırsatları aynı karar perspektifinde bir araya getiren Pika katmanıdır.
                    </p>
                    <p class="ph-muted">
                        Pika 360'ın görevi yeni bir müşteri gerçeği üretmek değildir. Customer Intelligence gibi analitik katmanlarda hesaplanan bağlamı, müşteri işlemlerini ve fırsat bilgisini kullanıcı için değerlendirilebilir bir müşteri görünümünde buluşturur.
                    </p>
                    <p class="ph-muted mb-2">
                        Bu nedenle Pika 360 yalnızca: “Bu müşteri kim?” sorusunu cevaplamaya çalışmaz.
                    </p>
                    <div class="p-3 my-3 rounded bg-white border" style="border-left:4px solid #b5ee19 !important">
                        <strong style="color:#23413b">
                            “Bu müşteri şu anda<br />
                            nasıl bir durumda<br />
                            ve hangi bağlam dikkate alınmalı?”
                        </strong>
                    </div>
                    <p class="ph-muted">
                        Pika 360'ın ürün rolü, müşteri verisini bir profil olmaktan çıkarıp karar vermeyi destekleyen bütünleşik bir bağlama dönüştürmektir.
                    </p>
                }
                else
                {
                    <p class="ph-muted">
                        Pika 360 is the Pika layer that brings a single customer's transaction history, calculated customer value, behavioral context, communication reachability and open opportunities into the same decision perspective.
                    </p>
                    <p class="ph-muted">
                        Pika 360 does not create a new version of customer truth. It brings context calculated by analytical layers such as Customer Intelligence together with customer transactions and opportunity information in a customer view that users can evaluate.
                    </p>
                    <p class="ph-muted mb-2">
                        That means Pika 360 goes beyond answering: “Who is this customer?”
                    </p>
                    <div class="p-3 my-3 rounded bg-white border" style="border-left:4px solid #b5ee19 !important">
                        <strong style="color:#23413b">
                            “What is this customer's current situation,<br />
                            and which context should be considered?”
                        </strong>
                    </div>
                    <p class="ph-muted">
                        The product role of Pika 360 is to turn customer data from a profile into unified context that supports decision making.
                    </p>
                }
            </div>

            <div class="col-lg-6">
                <span class="ph-eyebrow">@(tr ? "KAYITTAN BAĞLAMA" : "FROM RECORD TO CONTEXT")</span>
                <h2 class="pika-h2 fw-bold mb-3">
                    @(tr ? "Bir müşteriyi tanımlamak, onu anlamak değildir." : "Identifying a customer is not the same as understanding them.")
                </h2>
                @if (tr)
                {
                    <p class="ph-muted">
                        Ad, telefon, e-posta ve temel profil bilgileri müşterinin kim olduğunu söyler.
                    </p>
                    <p class="ph-muted">
                        Ancak müşterinin bugünkü ticari durumunu tek başına açıklamaz.
                    </p>
                    <p class="ph-muted">
                        Müşterinin geçmiş işlemleri başka bir bağlamdır.
                    </p>
                    <p class="ph-muted">
                        Satın alma ritmi ve davranış değişimi başka bir bağlamdır.
                    </p>
                    <p class="ph-muted">
                        Müşteri değeri başka bir bağlamdır.
                    </p>
                    <p class="ph-muted">
                        İletişim erişilebilirliği ve açık fırsatlar ise kararın başka parçalarıdır.
                    </p>
                    <p class="ph-muted">
                        Bu bilgiler birbirinden kopuk kaldığında kullanıcı karar vermeden önce bağlamı farklı yerlerden zihinsel olarak birleştirmek zorunda kalır.
                    </p>
                    <div class="p-3 my-3 rounded bg-white border">
                        <p class="small mb-1"><strong>Pika 360'ın amacı:</strong></p>
                        <p class="small mb-1">Daha fazla müşteri verisi göstermek değil,</p>
                        <p class="small mb-0 fw-bold" style="color:#23413b">karar için gerekli müşteri bağlamını aynı perspektifte buluşturmaktır.</p>
                    </div>
                }
                else
                {
                    <p class="ph-muted">
                        A name, phone number, email address and basic profile details tell you who the customer is.
                    </p>
                    <p class="ph-muted">
                        They do not explain the customer's current commercial situation by themselves.
                    </p>
                    <p class="ph-muted">
                        Transaction history is one context.
                    </p>
                    <p class="ph-muted">
                        Purchase rhythm and behavioral change are another.
                    </p>
                    <p class="ph-muted">
                        Customer value is another.
                    </p>
                    <p class="ph-muted">
                        Communication reachability and open opportunities are additional parts of the decision.
                    </p>
                    <p class="ph-muted">
                        When those signals remain fragmented, users must mentally reconstruct customer context before making a decision.
                    </p>
                    <div class="p-3 my-3 rounded bg-white border">
                        <p class="small mb-1"><strong>The purpose of Pika 360 is not:</strong></p>
                        <p class="small mb-1">To display more customer data.</p>
                        <p class="small mb-0 fw-bold" style="color:#23413b">It is: To bring the customer context required for a decision into the same perspective.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@* ── 04 WHAT PIKA 360 BRINGS TOGETHER ───────────────────────── *@
<section class="ph-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="ph-eyebrow">@(tr ? "TEK MÜŞTERİ PERSPEKTİFİ" : "ONE CUSTOMER PERSPECTIVE")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Karar verirken gereken temel bağlamları birlikte görün." : "Bring the key contexts needed for a decision together.")
            </h2>
            <p class="ph-muted" style="max-width:720px;margin-left:auto;margin-right:auto">
                @(tr ? "Pika 360 farklı bilgi türlerini aynı müşteri perspektifinde bir araya getirir. Her bağlam farklı bir soruya cevap verir." : "Pika 360 brings different types of information into the same customer perspective. Each context answers a different question.")
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100 p-4">
                    <div class="ph-module-icon mb-3"><i class="ri-history-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1.05rem">@(tr ? "İşlem Geçmişi" : "Transaction History")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Müşterinin geçmiş alışverişleri ve ticari hareketleri, bugünkü davranışı değerlendirirken temel tarihsel bağlamı oluşturur." : "Past purchases and commercial activity provide the historical foundation for evaluating current customer behavior.")
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100 p-4">
                    <div class="ph-module-icon mb-3"><i class="ri-shield-star-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1.05rem">@(tr ? "Hesaplanan Müşteri Değeri" : "Calculated Customer Value")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Customer Intelligence tarafından üretilen değer göstergeleri, müşterinin ticari önemini yalnızca tek bir işlem üzerinden değil, geçmiş davranışıyla birlikte değerlendirmeye yardımcı olur." : "Value indicators produced by Customer Intelligence help evaluate the customer's commercial importance through historical behavior rather than one isolated transaction.")
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100 p-4">
                    <div class="ph-module-icon mb-3"><i class="ri-user-follow-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1.05rem">@(tr ? "Davranış Bağlamı" : "Behavioral Context")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Satın alma sıklığı, ritim ve davranış değişimi gibi hesaplanan sinyaller müşterinin kendi geçmişine göre nasıl değiştiğini anlamaya yardımcı olur." : "Calculated signals such as purchase frequency, rhythm and behavioral change help reveal how the customer is changing relative to their own history.")
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100 p-4">
                    <div class="ph-module-icon mb-3"><i class="ri-chat-check-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1.05rem">@(tr ? "İletişim Erişilebilirliği" : "Communication Reachability")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Müşteriyle hangi iletişim kanallarında aksiyon alınabileceğine ilişkin mevcut erişilebilirlik ve izin bağlamı, karar perspektifinin bir parçası olarak değerlendirilebilir." : "Available reachability and permission context for communication channels can form part of the decision perspective when evaluating possible action.")
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100 p-4">
                    <div class="ph-module-icon mb-3"><i class="ri-focus-3-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1.05rem">@(tr ? "Açık Fırsatlar" : "Open Opportunities")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Müşteri için oluşmuş değerlendirilebilir ticari fırsatlar, geçmiş ve davranış bağlamıyla birlikte aynı müşteri perspektifinde görülebilir." : "Evaluable commercial opportunities associated with the customer can be considered alongside historical and behavioral context within the same customer perspective.")
                    </p>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <div class="p-3 rounded d-inline-block text-start" style="background:#f8faf4;border:1px dashed #dce5d3;max-width:720px">
                <p class="small mb-1" style="color:#62746d">
                    @(tr ? "Bu bilgiler tek başına karar değildir." : "None of these elements is the decision by itself.")
                </p>
                <p class="small mb-0 fw-bold" style="color:#23413b">
                    @(tr ? "Pika 360'ın değeri, bu parçaları kullanıcının birlikte değerlendirebileceği bir müşteri bağlamında toplamaktır." : "The value of Pika 360 is bringing these pieces into customer context that a user can evaluate together.")
                </p>
            </div>
        </div>
    </div>
</section>

@* ── 05 FROM PROFILE TO DECISION CONTEXT ─────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container" style="max-width:860px">
        <div class="text-center mb-5">
            <span class="ph-eyebrow">@(tr ? "SORUYU DEĞİŞTİRİN" : "CHANGE THE QUESTION")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Profil ekranından karar perspektifine." : "From customer profile to decision perspective.")
            </h2>
            <p class="ph-muted">
                @(tr ? "Geleneksel müşteri görünümü çoğu zaman müşterinin kimlik bilgilerini ve geçmiş kayıtlarını sunar. Bu bilgi önemlidir; ancak ticari karar için yeterli bağlamı her zaman sağlamaz." : "A traditional customer view often presents identity information and historical records. That information matters, but it does not always provide enough context for a commercial decision.")
            </p>
        </div>

        <div class="d-flex flex-column gap-3 mb-4">
            <div class="p-3 rounded bg-white border d-flex justify-content-between align-items-center">
                <span class="text-muted small">1.</span>
                <strong style="color:#62746d">@(tr ? "“Bu müşteri kim?”" : "“Who is this customer?”")</strong>
            </div>
            <div class="p-3 rounded bg-white border d-flex justify-content-between align-items-center">
                <span class="text-muted small">2.</span>
                <strong style="color:#62746d">@(tr ? "“Daha önce ne yaptı?”" : "“What have they done before?”")</strong>
            </div>
            <div class="p-4 rounded bg-white border" style="border-left:4px solid #b5ee19 !important">
                <span class="ph-eyebrow mb-1 d-block">PIKA 360</span>
                <strong class="d-block" style="font-size:1.15rem;color:#23413b">
                    @(tr ? "“Şu anda hangi durumda ve neden dikkat gerektiriyor olabilir?”" : "“What is their current situation, and why might they require attention?”")
                </strong>
            </div>
        </div>

        @if (tr)
        {
            <p class="ph-muted">
                Pika 360'ın farkı, geçmiş kayıtları bugünkü hesaplanan müşteri bağlamı ve açık fırsatlarla aynı perspektifte değerlendirmeye yardımcı olmasıdır.
            </p>
            <p class="ph-muted mb-0">
                Böylece kullanıcı yalnızca geçmişe bakmaz; geçmişin bugün ne ifade ettiğini de değerlendirebilir.
            </p>
        }
        else
        {
            <p class="ph-muted">
                The distinction of Pika 360 is that it helps users evaluate historical records together with current calculated customer context and open opportunities.
            </p>
            <p class="ph-muted mb-0">
                The user does not only look at the past. They can also evaluate what that past means now.
            </p>
        }
    </div>
</section>

@* ── 06 CUSTOMER INTELLIGENCE + PIKA 360 ────────────────────── *@
<section class="ph-section">
    <div class="container">
        <div class="text-center mb-5">
            <span class="ph-eyebrow">@(tr ? "ANALİZ VE GÖRÜNÜM" : "ANALYSIS AND PERSPECTIVE")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Customer Intelligence hesaplar. Pika 360 bağlamı bir araya getirir." : "Customer Intelligence calculates. Pika 360 brings context together.")
            </h2>
            <p class="ph-muted small" style="max-width:680px;margin-left:auto;margin-right:auto">
                @(tr ? "Customer Intelligence ile Pika 360 aynı ürün rolünü taşımaz. Customer Intelligence müşterinin işlem ve davranış geçmişinden müşteri değeri, satın alma ritmi ve davranış değişimi gibi hesaplanabilir sinyaller üretir." : "Customer Intelligence and Pika 360 do not play the same product role. Customer Intelligence produces calculable signals such as customer value, purchase rhythm and behavioral change from transaction and behavioral history.")
            </p>
            <p class="ph-muted small" style="max-width:680px;margin-left:auto;margin-right:auto">
                @(tr ? "Pika 360 ise bu hesaplanan müşteri bağlamını işlem geçmişi, iletişim erişilebilirliği ve açık fırsatlar gibi diğer müşteri bilgileriyle aynı karar perspektifinde bir araya getirir." : "Pika 360 brings that calculated customer context together with other customer information such as transaction history, communication reachability and open opportunities within the same decision perspective.")
            </p>
        </div>

        <div class="row g-4 justify-content-center mb-4">
            <div class="col-lg-5">
                <div class="ph-module-card h-100 p-4" style="border-top:3px solid var(--pika-primary)">
                    <div class="ph-module-icon mb-3"><i class="ri-user-heart-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1.05rem">Customer Intelligence</h3>
                    <div class="p-3 my-3 rounded bg-white border">
                        <strong style="color:#23413b">
                            @(tr ? "“Bu müşterinin davranışında ne oluyor?”" : "“What is happening in this customer's behavior?”")
                        </strong>
                    </div>
                    <a href="@(tr ? "/platform/customer-intelligence" : "/en/platform/customer-intelligence")" class="small fw-bold" style="color:var(--pika-primary)">
                        @(tr ? "Customer Intelligence'ı Keşfedin →" : "Explore Customer Intelligence →")
                    </a>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="ph-module-card h-100 p-4" style="border-top:3px solid #c8f542">
                    <div class="ph-module-icon mb-3"><i class="ri-user-search-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1.05rem">Pika 360</h3>
                    <div class="p-3 my-3 rounded bg-white border">
                        <strong style="color:#23413b">
                            @(tr ? "“Bu müşteri hakkında karar verirken hangi bağlamları birlikte görmeliyim?”" : "“Which contexts should I consider together when making a decision about this customer?”")
                        </strong>
                    </div>
                    <span class="small fw-bold" style="color:#666">@(tr ? "Şu an burada" : "Current location")</span>
                </div>
            </div>
        </div>

        <div class="text-center">
            <div class="p-3 rounded d-inline-block text-start" style="background:#f8faf4;border:1px dashed #dce5d3;max-width:720px">
                <p class="small mb-1" style="color:#62746d">
                    @(tr ? "Customer Intelligence analitik bağlam üretir." : "Customer Intelligence produces analytical context.")
                </p>
                <p class="small mb-0 fw-bold" style="color:#23413b">

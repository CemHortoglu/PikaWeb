@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]=tr?"Customer Intelligence | Müşteri Zekâsı":"Customer Intelligence";
    ViewData["MetaDescription"]=tr?"Pika Customer Intelligence ile gerçekleşmiş alışveriş, müşteri değeri, satın alma ritmi ve risk/fırsat sinyallerini aynı karar bağlamında değerlendirin.":"Use Pika Customer Intelligence to bring observed purchases, customer value, purchase rhythm and risk/opportunity signals into one decision context.";
    ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">Platform · Customer Intelligence</span><h1>@(tr?"Müşteriyi yalnız profiliyle değil, davranışıyla anlayın.":"Understand customers through behavior, not just profile fields.")</h1><p>@(tr?"Customer Intelligence; gerçekleşmiş alışverişları, müşteri değerini, satın alma ritmini ve davranış değişimini tek müşteri bağlamında okuyarak segment, fırsat ve aksiyon kararlarını besleyen anlama katmanıdır.":"Customer Intelligence combines observed purchases, customer value, purchase rhythm and behavioral change to support audience, opportunity and action decisions.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/customer-intelligence-nedir">@(tr?"Bilgi Bankası":"Knowledge Base")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_tekrar-satin-alma-analizi_6.png" alt="@(tr?"Pika tekrar satın alma analizi ekranı":"Pika repeat purchase analysis screen")" width="1200" height="760" /><figcaption>@(tr?"Müşteri davranışını kişisel satın alma ritmi ve gerçekleşmiş işlem kanıtıyla okuyun.":"Read customer behavior using individual purchase rhythm and observed transaction evidence.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow">@(tr?"Ne değildir?":"What it is not")</span><h2>@(tr?"Segmentasyonun yeni adı değildir.":"It is not segmentation with a new name.")</h2></div><div><p class="pk-lead">@(tr?"Customer Intelligence müşteriyi anlamaya çalışır; Audience Manager ise bu anlayışı seçilebilir hedef kitlelere dönüştürür. Aynı şey değillerdir ve birbirini tamamlarlar.":"Customer Intelligence is about understanding the customer; Audience Manager turns that understanding into selectable audiences. They are complementary, not interchangeable.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/audience-manager":"/en/platform/audience-manager")">Audience Manager</a></div></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container"><span class="pk-eyebrow">@(tr?"Hangi sinyalleri birlikte okur?":"Which signals come together?")</span><div class="pk-columns"><div class="pk-feature"><i class="ri-line-chart-line"></i><h3>@(tr?"Gerçekleşmiş ticari değer":"Observed commercial value")</h3><p>@(tr?"Gelecek LTV veya kârlılık iddiası yerine gerçekleşmiş satış ve satın alma sıklığı gibi açıklanabilir bağlamı kullanır.":"Uses explainable observed sales and purchase-frequency context rather than presenting future LTV or profitability as fact.")</p></div><div class="pk-feature"><i class="ri-time-line"></i><h3>@(tr?"Satın alma ritmi":"Purchase rhythm")</h3><p>@(tr?"Müşterinin kendi geçmişindeki tekrar davranışını değerlendirerek yaklaşan ihtiyaç veya pasifleşme sinyallerine bağlam sağlar.":"Uses the customer's own repeat behavior to provide context for approaching need or inactivity signals.")</p></div><div class="pk-feature"><i class="ri-pulse-line"></i><h3>@(tr?"Davranış değişimi":"Behavioral change")</h3><p>@(tr?"Tek bir toplam skora her şeyi sıkıştırmak yerine değer, ritim, risk ve ürün ilgisini ayrı sinyaller olarak okuyabilir.":"Keeps value, rhythm, risk and product interest as distinct signals instead of forcing everything into one score.")</p></div></div></div></section>
<section class="pk-section"><div class="pk-container pk-screen-band"><img src="/wiki/assets/images/img_pika-360_7.png" alt="@(tr?"Pika 360 müşteri karar görünümü":"Pika 360 customer decision view")" loading="lazy" width="1200" height="760" /><div><span class="pk-eyebrow">Customer Intelligence → Pika 360</span><h2>@(tr?"Hesaplamayı tek müşteride karar bağlamına taşıyın.":"Bring calculations into a customer-level decision context.")</h2><p class="pk-lead">@(tr?"Pika 360; profil, işlem, segment, fırsat ve iletişim bağlamını tek müşteri etrafında değerlendirmeyi kolaylaştırır. Customer Intelligence bu görünümü besleyen temel anlama katmanlarından biridir.":"Pika 360 makes it easier to review profile, transaction, segment, opportunity and communication context around one customer. Customer Intelligence is one of the layers that feeds that view.")</p><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/pika-360":"/en/platform/pika-360")">Pika 360</a></div></div></section>
<section class="pk-section pk-section-deep"><div class="pk-container pk-chapter"><div><span class="pk-eyebrow" style="color:#d1ea88">@(tr?"Karara bağlayın":"Connect to action")</span><h2>@(tr?"Anlamak tek başına hedef değil; doğru fırsatı seçmenin zemini.":"Understanding is the foundation for choosing the right opportunity.")</h2></div><div><p class="pk-lead">@(tr?"Customer Intelligence çıktıları Günün Fırsatları, Pika 360 ve segmentasyon kararlarını besleyebilir. Gerçek iletişim aksiyonu ise izin, kanal uygunluğu ve kullanıcı kontrolünden sonra Campaign veya Journey katmanında uygulanır.":"Customer Intelligence can inform Daily Opportunities, Pika 360 and segmentation decisions. Actual communication is executed later through Campaign or Journey after consent, eligibility and user control.")</p><div class="pk-actions"><a class="pk-btn pk-btn-light" href="@(tr?"/platform/gunun-firsatlari":"/en/platform/opportunities")">@(tr?"Günün Fırsatları":"Daily Opportunities")</a></div></div></div></section>

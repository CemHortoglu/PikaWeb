@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]=tr?"Customer Intelligence | Müşteri Zekâsı":"Customer Intelligence";
    ViewData["MetaDescription"]=tr?"Pika Customer Intelligence; gerçekleşmiş alışveriş, müşteri değeri, satın alma ritmi, davranış değişimi ve risk/fırsat sinyallerini açıklanabilir karar bağlamında bir araya getirir.":"Pika Customer Intelligence brings observed purchases, customer value, purchase rhythm, behavioral change and risk/opportunity signals into an explainable decision context.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2">
    <div class="pk-container pk-hero-grid">
        <div class="pk-hero-copy"><span class="pk-eyebrow">Platform · Customer Intelligence</span><h1>@(tr?"Müşteriyi yalnız profiliyle değil, davranışıyla anlayın.":"Understand customers through behavior, not just profile fields.")</h1><p>@(tr?"Customer Intelligence, Pika'nın müşteriyi gerçekleşmiş alışveriş, ticari değer, satın alma ritmi, davranış değişimi ve risk/fırsat sinyalleriyle anlamlandırdığı katmandır. Amaç tek bir skor üretmek değil; sonraki kararın nedenini açıklayacak müşteri bağlamını oluşturmaktır.":"Customer Intelligence is the layer where Pika interprets customers through observed purchases, commercial value, purchase rhythm, behavioral change and risk/opportunity signals. The goal is not one magic score, but customer context that explains the next decision.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/customer-intelligence-nedir">@(tr?"Detaylı bilgi":"Deep dive")</a></div></div>
        <div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_tekrar-satin-alma-analizi_6.png" alt="@(tr?"Pika tekrar satın alma analizi":"Pika repeat purchase analysis")" width="1200" height="760" /><div class="pk-stage-caption"><strong>Customer Intelligence</strong><span>@(tr?"Ritim · Değer · Davranış · Risk":"Rhythm · Value · Behavior · Risk")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-time-line"></i><div><strong>@(tr?"Satın alma ritmi":"Purchase rhythm")</strong><small>@(tr?"Kişinin kendi geçmişine göre":"Based on individual history")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-user-heart-line"></i><div><strong>@(tr?"Müşteri değeri":"Customer value")</strong><small>@(tr?"Gerçekleşmiş ticari bağlam":"Observed commercial context")</small></div></div></div>
    </div>
</section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Tanım":"Definition")</span><h2>@(tr?"Customer Intelligence nedir?":"What is Customer Intelligence?")</h2></div><p class="pk-lead">@(tr?"Pika'da Customer Intelligence; müşteri profilini geçmiş işlem ve davranış verisiyle birlikte okuyarak, müşterinin ticari değerini, normal satın alma ritmini ve bu ritimdeki değişimi karar desteğine dönüştüren anlama katmanıdır. Segment oluşturmaz; segmentasyonun kullanabileceği anlamı üretir.":"In Pika, Customer Intelligence combines profile, transaction and behavioral history to interpret commercial value, normal purchase rhythm and changes in that rhythm. It does not replace segmentation; it produces the understanding segmentation can use.")</p></div><div class="pk-intel-grid"><article class="pk-intel-panel"><span class="pk-intel-number">01</span><div class="pk-intel-icon"><i class="ri-line-chart-line"></i></div><h3>@(tr?"Gerçekleşmiş ticari değer":"Observed commercial value")</h3><p>@(tr?"Müşterinin bugüne kadar yarattığı ticari bağlamı, satın alma sıklığı ve diğer açıklanabilir göstergelerle birlikte okuyun. Bu alan gelecekteki LTV veya kârlılık garantisi değildir.":"Read the commercial context the customer has created so far together with purchase frequency and other explainable indicators. This is not a promise of future LTV or profitability.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">02</span><div class="pk-intel-icon"><i class="ri-refresh-line"></i></div><h3>@(tr?"Kişisel satın alma ritmi":"Individual purchase rhythm")</h3><p>@(tr?"Müşteriyi tüm müşteri tabanının ortalamasına göre değil, mümkün olduğunda kendi geçmiş tekrar davranışına göre değerlendirin. Yaklaşan ihtiyaç ve pasifleşme sinyalleri böyle daha anlamlı hale gelir.":"Evaluate customers against their own repeat behavior where possible, rather than only population averages. Approaching need and inactivity signals become more meaningful.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">03</span><div class="pk-intel-icon"><i class="ri-pulse-line"></i></div><h3>@(tr?"Davranış değişimi":"Behavioral change")</h3><p>@(tr?"Değer, ritim, risk, ürün ilgisi ve iletişim bağlamını tek toplam skora sıkıştırmadan ayrı sinyaller olarak okuyun. Böylece kararın hangi kanıta dayandığı kaybolmaz.":"Keep value, rhythm, risk, product interest and communication context as distinct signals instead of collapsing everything into one score, preserving the evidence behind decisions.")</p></article></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_pika-360_7.png" alt="@(tr?"Pika 360 müşteri görünümü":"Pika 360 customer view")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Customer Intelligence → Pika 360</small><h3>@(tr?"Hesaplamayı tek müşteride anlaşılır hale getirin":"Make calculations understandable at customer level")</h3><p>@(tr?"Profil, işlem, segment, fırsat ve iletişim bağlamı aynı müşteri üzerinde görüldüğünde Customer Intelligence bir rapor olmaktan çıkar, karar desteğine dönüşür.":"When profile, transaction, segment, opportunity and communication context are visible around one customer, Customer Intelligence becomes decision support rather than another report.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_kisi-listesi-ve-segmentler_3.png" alt="@(tr?"Pika kişi listesi ve segmentler":"Pika customer list and segments")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>Audience Manager</small><h3>@(tr?"Anlamak başka, hedef kitle seçmek başka":"Understanding is different from audience selection")</h3><p>@(tr?"Customer Intelligence müşteriyi açıklar; Audience Manager bu bağlamı filtre ve kurallarla seçilebilir kitleye dönüştürür.":"Customer Intelligence explains the customer; Audience Manager turns that context into selectable audiences through rules and filters.")</p></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">@(tr?"Karar bağlamı":"Decision context")</span><h2>@(tr?"Aynı müşteriye her zaman aynı şekilde bakmayın.":"Do not treat the same customer the same way forever.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Yüksek değerli bir müşteri pasifleşiyor olabilir. Orta değerli bir müşteri ise aktif, sık ve tekrar satın alma penceresine yaklaşıyor olabilir. Customer Intelligence bu sinyalleri birbirinden ayırır; kullanıcıya yalnızca 'iyi/kötü müşteri' etiketi vermez.":"A high-value customer may be becoming inactive. A mid-value customer may be active, frequent and approaching a repeat-purchase window. Customer Intelligence keeps these signals separate instead of reducing customers to a simple good/bad label.")</p></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-wallet-3-line"></i><div><strong>@(tr?"Değer":"Value")</strong><span>@(tr?"Gerçekleşmiş ticari ilişkinin büyüklüğünü ve sıklığını açıklayan bağlam." : "Context explaining the scale and frequency of the observed commercial relationship.")</span></div></div><div class="pk-control-step"><i class="ri-timer-line"></i><div><strong>@(tr?"Ritim":"Rhythm")</strong><span>@(tr?"Müşterinin normal tekrar davranışına göre zamanlama sinyali." : "Timing signal based on the customer's normal repeat behavior.")</span></div></div><div class="pk-control-step"><i class="ri-alarm-warning-line"></i><div><strong>@(tr?"Risk":"Risk")</strong><span>@(tr?"Normal davranıştan uzaklaşma veya ilişkinin zayıflama işaretleri." : "Signs of drift from normal behavior or weakening relationship.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-sparkling-line"></i><div><strong>@(tr?"Fırsat":"Opportunity")</strong><span>@(tr?"Bu sinyaller uygun ürün ve izin bağlamıyla birlikte Günün Fırsatları'na dönüşebilir." : "These signals can become Daily Opportunities when combined with appropriate product and eligibility context.")</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Platform ilişkisi":"Platform relationship")</span><h2>@(tr?"Customer Intelligence tek başına son ürün değildir; karar zincirinin anlama katmanıdır.":"Customer Intelligence is not the endpoint; it is the understanding layer of the decision chain.")</h2></div><p class="pk-lead">@(tr?"Müşteri bağlamı Pika 360 ve Günün Fırsatları'nda görünür hale gelir; Audience Manager hedef kitle seçimine, Campaign ve Journey ise kontrollü aksiyona taşır. İletişim gerekiyorsa izin ve kanal uygunluğu ayrıca değerlendirilir.":"Customer context becomes visible in Pika 360 and Daily Opportunities; Audience Manager supports audience selection, while Campaign and Journey provide controlled execution. Consent and channel eligibility are evaluated separately when communication is involved.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-user-search-line"></i><strong>Customer Intelligence</strong><span>@(tr?"Müşteriyi anla":"Understand the customer")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-focus-2-line"></i><strong>Pika 360</strong><span>@(tr?"Tek müşteride bağlam":"Context around one customer")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Günün Fırsatları":"Daily Opportunities")</strong><span>@(tr?"Aksiyon adayını gör":"See actionable situations")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-filter-3-line"></i><strong>Audience</strong><span>@(tr?"Kitleyi seç":"Select the audience")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-route-line"></i><strong>Campaign / Journey</strong><span>@(tr?"Kontrollü uygula":"Execute with control")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>Analytics</strong><span>@(tr?"Sonucu ölç":"Measure outcomes")</span></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Kullanım senaryoları":"Use cases")</span><h2>@(tr?"Müşteri zekâsını gerçek iş sorularına bağlayın.":"Connect customer intelligence to real business questions.")</h2></div><p class="pk-lead">@(tr?"Customer Intelligence'ın değeri bir dashboard daha üretmesinde değil, yöneticinin hangi müşteriye neden bakması gerektiğini açıklamasındadır." : "The value of Customer Intelligence is not another dashboard, but explaining which customer deserves attention and why.")</p></div><div class="pk-columns"><div class="pk-feature"><i class="ri-refresh-line"></i><h3>@(tr?"Kim tekrar satın almaya yaklaşıyor?":"Who is approaching repeat purchase?")</h3><p>@(tr?"Müşterinin kendi satın alma ritmini ve ürün bağlamını birlikte değerlendirin." : "Review individual purchase rhythm together with product context.")</p></div><div class="pk-feature"><i class="ri-user-unfollow-line"></i><h3>@(tr?"Kim normal ritminden uzaklaşıyor?":"Who is drifting from normal behavior?")</h3><p>@(tr?"Pasifleşme sinyalini müşterinin geçmiş değeri ve mevcut ilişki bağlamıyla birlikte okuyun." : "Read inactivity signals together with historical value and current relationship context.")</p></div><div class="pk-feature"><i class="ri-user-star-line"></i><h3>@(tr?"Hangi müşteriye öncelik vermeliyim?":"Which customer deserves priority?")</h3><p>@(tr?"Değer, ritim, risk ve fırsat sinyallerini birbirine karıştırmadan değerlendirin." : "Evaluate value, rhythm, risk and opportunity signals without conflating them.")</p></div></div><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr?"/kullanim-senaryolari":"/en/use-cases")">@(tr?"Kullanım senaryolarını inceleyin":"Explore use cases")</a><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/gunun-firsatlari":"/en/platform/opportunities")">@(tr?"Günün Fırsatları'na geçin":"Go to Daily Opportunities")</a></div></div></section>

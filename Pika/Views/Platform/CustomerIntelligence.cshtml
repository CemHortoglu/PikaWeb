@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-platform-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-customer-intelligence.css" asp-append-version="true" />
}

<div class="pika-ci-page">
    <a href="#inner-content" class="pika-ci-skip-anchor visually-hidden-focusable">@(tr ? "İçeriğe atla" : "Skip to content")</a>

    @* ── 01 HERO ────────────────────────────────────────────────── *@
    <section class="pika-ci-hero">
        <div class="pika-ci-container">
            <nav class="pika-ci-breadcrumb" aria-label="@(tr ? "Navigasyon" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">@(tr ? "Ana Sayfa" : "Home")</a>
                <span class="pika-ci-breadcrumb-sep" aria-hidden="true">/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span class="pika-ci-breadcrumb-sep" aria-hidden="true">/</span>
                <span class="pika-ci-breadcrumb-current">@(tr ? "Müşteri Zekâsı" : "Customer Intelligence")</span>
            </nav>

            <div class="pika-ci-hero-grid">
                <div class="pika-ci-hero-content">
                    <div class="pika-ci-eyebrow-row">
                        <span class="pika-ci-eyebrow">CUSTOMER INTELLIGENCE</span>
                        <span class="pika-ci-entity-label">@(tr ? "Müşteri Zekâsı" : "Customer Intelligence")</span>
                    </div>

                    @if (tr)
                    {
                        <h1 class="pika-ci-hero-title">
                            Müşterinizin kim olduğunu değil,<br />
                            nasıl değiştiğini anlayın.
                        </h1>
                        <p class="pika-ci-hero-lead">
                            Pika Customer Intelligence, müşterinin işlem geçmişini tek tek kayıtlar olarak bırakmaz. Satın alma sıklığını, alışveriş ritmini, hesaplanan müşteri değerini ve davranış değişimlerini birlikte değerlendirerek müşterinin bugünkü ticari bağlamını görünür hale getirir.
                        </p>
                        <p class="pika-ci-hero-supporting">
                            Çünkü doğru karar, yalnızca müşterinin geçmişte ne yaptığını değil, davranışının bugün nereye doğru değiştiğini anlamakla başlar.
                        </p>
                        <div class="pika-ci-hero-actions">
                            <button type="button" class="pika-ci-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">
                                <span>Demo Talep Et</span>
                                <i class="ri-arrow-right-up-line" aria-hidden="true"></i>
                            </button>
                            <a href="/platform/pika-360" class="pika-ci-btn-secondary">
                                <span>Pika 360'ı Keşfedin</span>
                                <i class="ri-arrow-right-line" aria-hidden="true"></i>
                            </a>
                        </div>
                    }
                    else
                    {
                        <h1 class="pika-ci-hero-title">
                            Understand not only who<br />
                            your customer is, but how they are changing.
                        </h1>
                        <p class="pika-ci-hero-lead">
                            Pika Customer Intelligence does not leave customer transaction history as a collection of isolated records. It evaluates purchase frequency, purchase rhythm, calculated customer value and behavioral change together to make the customer's current commercial context visible.
                        </p>
                        <p class="pika-ci-hero-supporting">
                            Because a better decision begins not only with knowing what the customer did before, but with understanding how their behavior is changing now.
                        </p>
                        <div class="pika-ci-hero-actions">
                            <button type="button" class="pika-ci-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">
                                <span>Request a Demo</span>
                                <i class="ri-arrow-right-up-line" aria-hidden="true"></i>
                            </button>
                            <a href="/en/platform/pika-360" class="pika-ci-btn-secondary">
                                <span>Explore Pika 360</span>
                                <i class="ri-arrow-right-line" aria-hidden="true"></i>
                            </a>
                        </div>
                    }
                </div>

                <div class="pika-ci-hero-diagram-wrap" aria-hidden="true">
                    <div class="ci-observatory">
                        <div class="ci-observatory-head"><span class="ci-wordmark">pika<span>.</span></span><span>CUSTOMER INTELLIGENCE</span><span class="ci-status-dot"></span></div>
                        <div class="ci-profile"><div class="ci-profile-avatar"><i class="ri-user-3-line"></i></div><div><small>01 / CUSTOMER</small><strong>@(tr ? "Her müşterinin kendine özgü ritmi." : "A distinct rhythm for every customer.")</strong></div></div>
                        <div class="ci-timeline">
                            <div class="ci-chart-label"><small>02 / TRANSACTIONS OVER TIME</small><span>@(tr ? "İşlem geçmişi" : "Purchase history")</span></div>
                            <svg viewBox="0 0 440 140" fill="none" aria-hidden="true">
                                <defs><linearGradient id="ci-area" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#b5ee19" stop-opacity=".19"/><stop offset="1" stop-color="#b5ee19" stop-opacity="0"/></linearGradient></defs>
                                <path d="M0 30H440M0 75H440M0 120H440" stroke="#dce8d5" stroke-opacity=".1"/>
                                <path d="M10 110C40 110 44 66 76 66S116 100 144 92S173 39 208 44S246 89 276 69S320 19 349 30S390 57 430 15V140H10Z" fill="url(#ci-area)"/>
                                <path d="M10 110C40 110 44 66 76 66S116 100 144 92S173 39 208 44S246 89 276 69S320 19 349 30S390 57 430 15" stroke="#b5ee19" stroke-width="2.5"/>
                                <g fill="#0f292e" stroke="#c7ee74" stroke-width="2"><circle cx="76" cy="66" r="4"/><circle cx="208" cy="44" r="4"/><circle cx="349" cy="30" r="4"/><circle cx="430" cy="15" r="4"/></g>
                            </svg>
                            <div class="ci-chart-axis"><span>@(tr ? "Geçmiş" : "Past")</span><span>@(tr ? "Zaman içindeki değişim" : "Change over time")</span><span>@(tr ? "Bugün" : "Today")</span></div>
                        </div>
                        <div class="ci-context-label"><span>03 / BEHAVIORAL CONTEXT</span><span>04 / VALUE · RHYTHM · CHANGE</span></div>
                        <div class="ci-context-grid">
                            <div><i class="ri-vip-diamond-line"></i><strong>@(tr ? "Müşteri değeri" : "Customer value")</strong><span>@(tr ? "Ticari katkı" : "Commercial contribution")</span></div>
                            <div><i class="ri-pulse-line"></i><strong>@(tr ? "Alışveriş ritmi" : "Purchase rhythm")</strong><span>@(tr ? "Kişisel düzen" : "Individual pattern")</span></div>
                            <div><i class="ri-line-chart-line"></i><strong>@(tr ? "Davranış değişimi" : "Behavioral change")</strong><span>@(tr ? "Yeni sinyaller" : "Emerging signals")</span></div>
                        </div>
                        <div class="ci-signal"><span class="ci-signal-icon">✳</span><div><small>05 / OPPORTUNITY SIGNAL</small><strong>@(tr ? "Veriden, anlamlı bir sonraki adıma." : "From data to a meaningful next step.")</strong></div><i class="ri-arrow-right-up-line"></i></div>
                        <div class="ci-observatory-caption">@(tr ? "Örnek görünüm · Müşteri verisinden ticari sinyale akış" : "Illustration · Flow from customer data to commercial signal")</div>
                    </div>                </div>
            </div>
        </div>
    </section>

    @* ── 02 DIRECT ANSWER ───────────────────────────────────────── *@
    <section class="pika-ci-section pika-ci-section--light" id="inner-content">
        <div class="pika-ci-container">
            <div class="pika-ci-direct-answer-card">
                <span class="pika-ci-section-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
                <h2 class="pika-ci-section-title">@(tr ? "Customer Intelligence nedir?" : "What is Customer Intelligence?")</h2>

                @if (tr)
                {
                    <p class="pika-ci-body-text">
                        Customer Intelligence, müşteri işlemlerini ve davranışsal veriyi analiz ederek müşterinin değerini, satın alma sıklığını, alışveriş ritmini ve davranış değişimlerini anlamlandıran analitik katmandır.
                    </p>
                    <p class="pika-ci-body-text">
                        Pika'da Customer Intelligence; müşteri kaydının kendisi değildir. Müşterinin zaman içindeki ticari davranışını hesaplanabilir bağlama dönüştürür. Bu bağlam Pika 360'ı, Günün Fırsatları'nı ve hedef kitle kararlarını besler.
                    </p>
                    <p class="pika-ci-body-text">
                        Bu nedenle Customer Intelligence'ın görevi mesaj göndermek değildir. Gönderimden önce cevaplanması gereken daha temel bir soruya odaklanır:
                    </p>
                    <div class="pika-ci-large-question">
                        Bu müşteri şu anda<br />
                        nasıl bir ticari durumda?
                    </div>
                }
                else
                {
                    <p class="pika-ci-body-text">
                        Customer Intelligence is the analytical layer that interprets customer transactions and behavioral data to understand customer value, purchase frequency, purchase rhythm and behavioral change.
                    </p>
                    <p class="pika-ci-body-text">
                        In Pika, Customer Intelligence is not the customer record itself. It turns the customer's commercial behavior over time into calculated context. That context feeds Pika 360, Daily Opportunities and audience decisions.
                    </p>
                    <p class="pika-ci-body-text">
                        That means Customer Intelligence is not responsible for sending messages. It focuses on a more fundamental question that should be answered before execution:
                    </p>
                    <div class="pika-ci-large-question">
                        What is this customer's<br />
                        commercial state right now?
                    </div>
                }
            </div>
        </div>
    </section>

    @* ── 03 THE PROBLEM ─────────────────────────────────────────── *@
    <section class="pika-ci-section">
        <div class="pika-ci-container pika-ci-container--narrow">
            <span class="pika-ci-section-eyebrow">@(tr ? "VERİDEN BAĞLAMA" : "FROM DATA TO CONTEXT")</span>
            @if (tr)
            {
                <h2 class="pika-ci-section-title">
                    Bir müşteri kaydı,<br />
                    müşteriyi anlamak için yeterli değildir.
                </h2>
                <div class="pika-ci-prose">
                    <p class="pika-ci-body-text">
                        Ad, e-posta, telefon ve son sipariş tarihi müşteriyi tanımlar; fakat müşterinin davranışını açıklamaz.
                    </p>
                    <p class="pika-ci-body-text">
                        Aynı toplam harcamaya sahip iki müşteriden biri düzenli alışveriş yapıyor olabilirken diğeri tek seferlik yüksek tutarlı bir alışveriş yapmış olabilir.
                    </p>
                    <p class="pika-ci-body-text">
                        Son alışverişi 30 gün önce olan iki müşteri de aynı durumda olmayabilir. Biri normalde haftada bir alışveriş yaparken diğeri üç ayda bir alışveriş yapıyor olabilir.
                    </p>
                    <div class="pika-ci-emphasis-statement">
                        Tek bir değer,<br />
                        tek bir tarih<br />
                        ve tek bir segment<br />
                        müşterinin bütün hikâyesini anlatmaz.
                    </div>
                    <p class="pika-ci-body-text">
                        Customer Intelligence bu nedenle müşteriyi yalnızca statik özellikleriyle değil, zaman içindeki davranış örüntüsüyle değerlendirir.
                    </p>
                </div>
            }
            else
            {
                <h2 class="pika-ci-section-title">
                    A customer record<br />
                    is not enough to understand the customer.
                </h2>
                <div class="pika-ci-prose">
                    <p class="pika-ci-body-text">
                        A name, email address, phone number and last-order date identify a customer, but they do not explain customer behavior.
                    </p>
                    <p class="pika-ci-body-text">
                        Two customers with the same total spend may be fundamentally different: one may purchase consistently, while the other may have made a single high-value purchase.
                    </p>
                    <p class="pika-ci-body-text">
                        Two customers whose last purchase was 30 days ago may not be in the same state either. One may normally purchase every week, while the other purchases once every three months.
                    </p>
                    <div class="pika-ci-emphasis-statement">
                        One value,<br />
                        one date<br />
                        and one segment<br />
                        cannot tell the whole customer story.
                    </div>
                    <p class="pika-ci-body-text">
                        That is why Customer Intelligence evaluates customers not only through static attributes, but through behavioral patterns over time.
                    </p>
                </div>
            }
        </div>
    </section>

    @* ── 04 WHAT CUSTOMER INTELLIGENCE UNDERSTANDS ──────────────── *@
    <section class="pika-ci-section pika-ci-section--alt">
        <div class="pika-ci-container pika-ci-container--narrow">
            <span class="pika-ci-section-eyebrow">@(tr ? "MÜŞTERİ BAĞLAMI" : "CUSTOMER CONTEXT")</span>
            @if (tr)
            {
                <h2 class="pika-ci-section-title">
                    Pika müşteri davranışını<br />
                    birden fazla sinyali birlikte okuyarak anlamlandırır.
                </h2>
                <p class="pika-ci-lead-paragraph">
                    Customer Intelligence, tek bir metriği kararın kendisi olarak kullanmaz. Müşteri bağlamı farklı davranış sinyallerinin birlikte değerlendirilmesiyle oluşur.
                </p>

                <div class="pika-ci-editorial-list">
                    <div class="pika-ci-editorial-item">
                        <div class="pika-ci-editorial-meta">
                            <span class="pika-ci-editorial-num">01</span>
                            <h3 class="pika-ci-editorial-heading">Güncellik</h3>
                        </div>
                        <p class="pika-ci-editorial-desc">
                            Müşterinin en son ne zaman alışveriş yaptığını ve son etkileşimin geçmiş davranış içindeki yerini değerlendirir.
                        </p>
                    </div>

                    <div class="pika-ci-editorial-item">
                        <div class="pika-ci-editorial-meta">
                            <span class="pika-ci-editorial-num">02</span>
                            <h3 class="pika-ci-editorial-heading">Sıklık</h3>
                        </div>
                        <p class="pika-ci-editorial-desc">
                            Müşterinin belirli dönemlerde ne kadar düzenli veya seyrek alışveriş yaptığını anlamaya yardımcı olur.
                        </p>
                    </div>

                    <div class="pika-ci-editorial-item">
                        <div class="pika-ci-editorial-meta">
                            <span class="pika-ci-editorial-num">03</span>
                            <h3 class="pika-ci-editorial-heading">Parasal katkı</h3>
                        </div>
                        <p class="pika-ci-editorial-desc">
                            Müşterinin işlem geçmişindeki ticari katkısını yalnızca tek bir sipariş üzerinden değil, zaman içindeki davranışıyla birlikte ele alır.
                        </p>
                    </div>

                    <div class="pika-ci-editorial-item">
                        <div class="pika-ci-editorial-meta">
                            <span class="pika-ci-editorial-num">04</span>
                            <h3 class="pika-ci-editorial-heading">Satın alma ritmi</h3>
                        </div>
                        <p class="pika-ci-editorial-desc">
                            Müşterinin alışverişleri arasındaki süreleri değerlendirerek kişisel satın alma düzeninin oluşup oluşmadığını görünür hale getirir.
                        </p>
                    </div>

                    <div class="pika-ci-editorial-item">
                        <div class="pika-ci-editorial-meta">
                            <span class="pika-ci-editorial-num">05</span>
                            <h3 class="pika-ci-editorial-heading">Davranış değişimi</h3>
                        </div>
                        <p class="pika-ci-editorial-desc">
                            Müşterinin kendi geçmiş ritmine göre hızlanma, yavaşlama veya pasifleşme sinyali gösterip göstermediğini anlamaya yardımcı olur.
                        </p>
                    </div>

                    <div class="pika-ci-editorial-item">
                        <div class="pika-ci-editorial-meta">
                            <span class="pika-ci-editorial-num">06</span>
                            <h3 class="pika-ci-editorial-heading">Müşteri değeri</h3>
                        </div>
                        <p class="pika-ci-editorial-desc">
                            Müşterinin göreli ticari değerini davranış ve işlem geçmişinden hesaplanan göstergelerle değerlendirmek için ortak bir bağlam üretir.
                        </p>
                    </div>
                </div>

                <div class="pika-ci-closing-box">
                    <p class="pika-ci-body-text mb-0">
                        Bu sinyaller tek başına bir kampanya kararı değildir. Birlikte, sonraki karar katmanlarının kullanabileceği müşteri bağlamını oluştururlar.
                    </p>
                </div>
            }
            else
            {
                <h2 class="pika-ci-section-title">
                    Pika interprets customer behavior<br />
                    by reading multiple signals together.
                </h2>
                <p class="pika-ci-lead-paragraph">
                    Customer Intelligence does not treat a single metric as the decision itself. Customer context emerges from evaluating different behavioral signals together.
                </p>

                <div class="pika-ci-editorial-list">
                    <div class="pika-ci-editorial-item">
                        <div class="pika-ci-editorial-meta">
                            <span class="pika-ci-editorial-num">01</span>
                            <h3 class="pika-ci-editorial-heading">Recency</h3>
                        </div>
                        <p class="pika-ci-editorial-desc">
                            Evaluates when the customer last purchased and how that recent activity fits within their historical behavior.
                        </p>
                    </div>

                    <div class="pika-ci-editorial-item">
                        <div class="pika-ci-editorial-meta">
                            <span class="pika-ci-editorial-num">02</span>
                            <h3 class="pika-ci-editorial-heading">Frequency</h3>
                        </div>
                        <p class="pika-ci-editorial-desc">
                            Helps reveal how consistently or infrequently the customer purchases across different periods.
                        </p>
                    </div>

                    <div class="pika-ci-editorial-item">
                        <div class="pika-ci-editorial-meta">
                            <span class="pika-ci-editorial-num">03</span>
                            <h3 class="pika-ci-editorial-heading">Monetary contribution</h3>
                        </div>
                        <p class="pika-ci-editorial-desc">
                            Evaluates the customer's commercial contribution through transaction history rather than through one isolated order.
                        </p>
                    </div>

                    <div class="pika-ci-editorial-item">
                        <div class="pika-ci-editorial-meta">
                            <span class="pika-ci-editorial-num">04</span>
                            <h3 class="pika-ci-editorial-heading">Purchase rhythm</h3>
                        </div>
                        <p class="pika-ci-editorial-desc">
                            Evaluates the intervals between purchases to make an individual purchasing pattern visible when one exists.
                        </p>
                    </div>

                    <div class="pika-ci-editorial-item">
                        <div class="pika-ci-editorial-meta">
                            <span class="pika-ci-editorial-num">05</span>
                            <h3 class="pika-ci-editorial-heading">Behavioral change</h3>
                        </div>
                        <p class="pika-ci-editorial-desc">
                            Helps identify whether the customer is accelerating, slowing down or showing inactivity relative to their own historical rhythm.
                        </p>
                    </div>

                    <div class="pika-ci-editorial-item">
                        <div class="pika-ci-editorial-meta">
                            <span class="pika-ci-editorial-num">06</span>
                            <h3 class="pika-ci-editorial-heading">Customer value</h3>
                        </div>
                        <p class="pika-ci-editorial-desc">
                            Creates a common context for evaluating relative commercial value through indicators calculated from behavioral and transaction history.
                        </p>
                    </div>
                </div>

                <div class="pika-ci-closing-box">
                    <p class="pika-ci-body-text mb-0">
                        None of these signals is a campaign decision by itself. Together, they create customer context that downstream decision layers can use.
                    </p>
                </div>
            }
        </div>
    </section>

    @* ── 05 PURCHASE RHYTHM ─────────────────────────────────────── *@
    <section class="pika-ci-section">
        <div class="pika-ci-container">
            <div class="pika-ci-split-grid">
                <div>
                    <span class="pika-ci-section-eyebrow">@(tr ? "SATIN ALMA RİTMİ" : "PURCHASE RHYTHM")</span>
                    @if (tr)
                    {
                        <h2 class="pika-ci-section-title">
                            Her müşteri aynı takvimle yaşamaz.
                        </h2>
                        <p class="pika-ci-body-text">
                            Sabit bir “30 gündür alışveriş yapmadı” kuralı her müşteriyi aynı davranış modeline zorlar.
                        </p>
                        <p class="pika-ci-body-text">
                            Oysa müşterilerin alışveriş ritimleri farklıdır. Bazı müşteriler sık, bazıları seyrek; bazıları ise belirli ürün veya ihtiyaçlarda düzenli tekrar davranışı gösterebilir.
                        </p>
                        <p class="pika-ci-body-text">
                            Pika Customer Intelligence, müşterinin işlem geçmişindeki satın alma aralıklarını değerlendirerek kişisel ritmin görünür hale gelmesine yardımcı olur.
                        </p>
                    }
                    else
                    {
                        <h2 class="pika-ci-section-title">
                            Not every customer<br />
                            lives on the same calendar.
                        </h2>
                        <p class="pika-ci-body-text">
                            A fixed rule such as “no purchase for 30 days” forces every customer into the same behavioral model.
                        </p>
                        <p class="pika-ci-body-text">
                            In reality, purchase rhythms differ. Some customers buy frequently, some infrequently, while others may show recurring behavior around specific products or needs.
                        </p>
                        <p class="pika-ci-body-text">
                            Pika Customer Intelligence evaluates the intervals within transaction history to help make an individual purchasing rhythm visible.
                        </p>
                    }
                </div>

                <div>
                    <div class="pika-ci-rhythm-visual" aria-hidden="true">
                        <div class="pika-ci-timeline-stream">
                            <div class="pika-ci-timeline-event">
                                <span class="pika-ci-timeline-dot"></span>
                                <span class="pika-ci-timeline-lbl">T1</span>
                            </div>
                            <div class="pika-ci-timeline-line"></div>
                            <div class="pika-ci-timeline-event">
                                <span class="pika-ci-timeline-dot"></span>
                                <span class="pika-ci-timeline-lbl">T2</span>
                            </div>
                            <div class="pika-ci-timeline-line"></div>
                            <div class="pika-ci-timeline-event">
                                <span class="pika-ci-timeline-dot"></span>
                                <span class="pika-ci-timeline-lbl">T3</span>
                            </div>
                            <div class="pika-ci-timeline-line pika-ci-timeline-line--current"></div>
                            <div class="pika-ci-timeline-event pika-ci-timeline-event--now">
                                <span class="pika-ci-timeline-pulse"></span>
                                <span class="pika-ci-timeline-lbl">NOW</span>
                            </div>
                        </div>
                        <div class="pika-ci-timeline-caption">
                            @(tr ? "Müşterinin geçmiş işlem aralıkları &rarr; Kişisel ritim bağlamı" : "Historical transaction intervals &rarr; Individual rhythm context")
                        </div>
                    </div>

                    @if (tr)
                    {
                        <div class="pika-ci-rhythm-emphasis">
                            <p class="mb-2">Önemli olan yalnızca<br />“kaç gün geçti?”<br />değildir.</p>
                            <p class="mb-1 text-muted">Önemli olan:</p>
                            <p class="pika-ci-rhythm-lead mb-0">“Bu müşterinin kendi normaline göre<br />ne değişti?”</p>
                        </div>
                        <p class="pika-ci-body-text mt-3">

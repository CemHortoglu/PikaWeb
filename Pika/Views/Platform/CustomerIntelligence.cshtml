@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    var wikiBase = "/wiki/";
    ViewData["Title"] = tr ? "Customer Intelligence | Müşteri Zekâsı" : "Customer Intelligence | Customer Analytics & Intelligence";
    ViewData["MetaDescription"] = tr ? "Pika Customer Intelligence, müşteri davranışı ve transaction verisinden anlam çıkararak segmentasyon, değer analizi ve fırsat tespitine zemin hazırlar." : "Pika Customer Intelligence extracts deep insights from customer behavior and transaction data to power segmentation, value analysis, and opportunity discovery.";
    ViewData["BodyClass"] = "pika-platform-page";
}

@await Html.PartialAsync("_MarketingHero")

@* ── PROBLEM & YAKLAŞIM ─────────────────────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5" data-aos="fade-right">
                <span class="ph-eyebrow">Problem</span>
                <h2 class="pika-h2 fw-bold">@(tr ? "Veri var, ama anlam yok" : "Data exists, but context is missing")</h2>
                <p class="ph-muted">
                    @(tr ? "Müşteri kaydı tabloda bulunur; satış geçmişi sistemde vardır. Ancak \"bu müşteri şu anda nasıl bir durumda?\" sorusunun cevabı dağınık ekranlar arasında kaybolur." : "Customer records sit in database tables; transaction histories live in ERPs. But answering \"what is this customer's current state and momentum?\" gets lost across fragmented dashboards.")
                </p>
                <p class="ph-muted">
                    @(tr ? "Daha çok müşteriye mesaj atmak değil, doğru müşteriyi doğru bağlamla seçmek pazarlama verimliliğinin temelidir." : "Marketing efficiency is not about messaging more customers; it is about selecting the right customer in the exact right context.")
                </p>
            </div>
            <div class="col-lg-7" data-aos="fade-left">
                <span class="ph-eyebrow">@(tr ? "Pika'nın Yaklaşımı" : "Pika's Approach")</span>
                <h2 class="pika-h2 fw-bold">@(tr ? "Müşteriyi üç katmanda anla" : "Understand customers across three layers")</h2>
                <div class="row g-3 mt-2">
                    <div class="col-md-4">
                        <div class="ph-module-card h-100 p-3">
                            <div class="ph-module-icon mb-2"><span class="fw-bold" style="font-size:1.1rem">1</span></div>
                            <div class="fw-bold mb-1" style="font-size:.9rem">@(tr ? "Müşteri Kim?" : "Who is the customer?")</div>
                            <p class="small ph-muted mb-0">@(tr ? "Temel kayıt, iletişim bilgisi ve müşteri kanıtı" : "Core record, contact details, and evidence profile")</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="ph-module-card h-100 p-3">
                            <div class="ph-module-icon mb-2"><span class="fw-bold" style="font-size:1.1rem">2</span></div>
                            <div class="fw-bold mb-1" style="font-size:.9rem">@(tr ? "Hangi Kümeye Ait?" : "Which cohort?")</div>
                            <p class="small ph-muted mb-0">@(tr ? "Segment, müşteri grubu ve davranış sınıflandırması" : "Segment, customer group, and behavioral cluster")</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="ph-module-card h-100 p-3">
                            <div class="ph-module-icon mb-2"><span class="fw-bold" style="font-size:1.1rem">3</span></div>
                            <div class="fw-bold mb-1" style="font-size:.9rem">@(tr ? "Nasıl Ulaşılır?" : "How to reach?")</div>
                            <p class="small ph-muted mb-0">@(tr ? "Kanal uygunluğu, izin durumu ve tercih bilgisi" : "Channel reachability, consent status, and preferences")</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── TEMEL YETENEKLER ──────────────────────────────────────── *@
<section class="ph-section">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "Yetenekler" : "Capabilities")</span>
            <h2 class="pika-h2 fw-bold">@(tr ? "Customer Intelligence neler sağlar?" : "What does Customer Intelligence deliver?")</h2>
            <p class="ph-muted mx-auto" style="max-width:600px">
                @(tr ? "Müşteri zekâsı katmanı; segmentasyon, değer analizi, risk tespiti ve fırsat üretimine zemin hazırlayan yapıyı kurar." : "The customer intelligence layer establishes the foundation for segmentation, value analysis, risk identification, and opportunity generation.")
            </p>
        </div>
        <div class="row g-4" data-aos="fade-up" data-aos-delay="100">
            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100">
                    <div class="ph-module-icon"><i class="ri-group-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1rem">@(tr ? "Kişi Listesi & Segmentler" : "Contact List & Segments")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Müşteri kaydı, segment üyeliği ve iletişim kanalı uygunluğunu birleştirir. Kampanya hedef kitlesi bu zeminden oluşturulur." : "Combines customer records, segment memberships, and channel availability to build reliable campaign audiences.")
                    </p>
                    <div class="mt-3">
                        <a href="@(wikiBase)kisi-listesi-ve-segmentler" class="small" style="color:var(--pika-primary)">
                            @(tr ? "Wiki'de oku" : "Read in Wiki") <i class="ri-arrow-right-line"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100">
                    <div class="ph-module-icon"><i class="ri-dashboard-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1rem">BI Kokpit</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Satış kanalı performansı, tekrar satın alma analizi ve müşteri segment dağılımını tek görünümde sunan analitik paneli." : "Analytics cockpit providing channel performance, repeat purchase intervals, and cohort distributions in one view.")
                    </p>
                    <div class="mt-3">
                        <a href="@(wikiBase)bi-kokpit" class="small" style="color:var(--pika-primary)">
                            @(tr ? "Wiki'de oku" : "Read in Wiki") <i class="ri-arrow-right-line"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100">
                    <div class="ph-module-icon"><i class="ri-heart-pulse-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1rem">@(tr ? "Müşteri Değeri & Sadakat" : "Customer Value & Loyalty")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Müşterinin göreli önemi, ticari katkısı, sadakat pozisyonu ve hedefe yakınlığını analiz eden değer modeli." : "Value scoring model analyzing relative contribution, loyalty stance, and proximity to higher tiers.")
                    </p>
                    <div class="mt-3">
                        <a href="@(wikiBase)musteri-degeri-sadakat" class="small" style="color:var(--pika-primary)">
                            @(tr ? "Wiki'de oku" : "Read in Wiki") <i class="ri-arrow-right-line"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100">
                    <div class="ph-module-icon"><i class="ri-alert-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1rem">@(tr ? "Müşteri Değer Skoru" : "Customer Value & Risk Score")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Pasifleşme ve kayıp riskini veriyle görünür kılan skor sistemi. Hisle değil, kanıtla konuşmak için." : "Scoring framework making churn and dormancy risks visible through empirical data rather than gut feel.")
                    </p>
                    <div class="mt-3">
                        <a href="@(wikiBase)musteri-deger-skoru" class="small" style="color:var(--pika-primary)">
                            @(tr ? "Wiki'de oku" : "Read in Wiki") <i class="ri-arrow-right-line"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100">
                    <div class="ph-module-icon"><i class="ri-robot-2-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1rem">@(tr ? "AI Müşteri Özeti" : "AI Customer Summary")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Tek müşteri için değer, risk, iletişim erişimi ve açık fırsat bilgisini hızla özetleyen AI destekli karar ekranı." : "AI-driven single customer summary highlighting value tier, churn risk, channel access, and open opportunity signals.")
                    </p>
                    <div class="mt-3">
                        <a href="@(wikiBase)ai-musteri-ozeti" class="small" style="color:var(--pika-primary)">
                            @(tr ? "Wiki'de oku" : "Read in Wiki") <i class="ri-arrow-right-line"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100">
                    <div class="ph-module-icon"><i class="ri-tools-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1rem">@(tr ? "Aksiyon Çalışma Alanı" : "Action Workspace")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Müşteri zekâsından elde edilen bulguları kampanya veya journey aksiyonuna dönüştürmek için çalışma alanı." : "Dedicated workspace to convert intelligence insights into campaign dispatches or automated journey workflows.")
                    </p>
                    <div class="mt-3">
                        <a href="@(wikiBase)aksiyon-calisma-alani" class="small" style="color:var(--pika-primary)">
                            @(tr ? "Wiki'de oku" : "Read in Wiki") <i class="ri-arrow-right-line"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── ZİNCİR POZİSYONU ───────────────────────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "Platform Bütünü" : "Platform Context")</span>
            <h2 class="pika-h2 fw-bold">@(tr ? "Customer Intelligence, platformun zekâ zeminidir" : "Customer Intelligence is the intelligence foundation")</h2>
            <p class="ph-muted mx-auto" style="max-width:580px">
                @(tr ? "Müşteri zekâsı tek başına bir hedef değil; doğru kararı ve doğru aksiyonu mümkün kılan temel katmandır." : "Customer intelligence is not an isolated endpoint; it is the foundational layer enabling sound decisions and timely actions.")
            </p>
        </div>
        <div class="row g-3 justify-content-center" data-aos="fade-up" data-aos-delay="100">
            <div class="col-auto">
                <div class="ph-module-card p-3 text-center" style="min-width:160px;border:2px solid var(--pika-primary)">
                    <i class="ri-brain-line mb-1" style="font-size:1.3rem;color:var(--pika-primary)"></i>
                    <div class="fw-bold small">Customer Intelligence</div>
                    <div style="font-size:.7rem;color:var(--pika-muted)">@(tr ? "Şu an burada" : "Current location")</div>
                </div>
            </div>
            <div class="col-auto d-flex align-items-center"><i class="ri-arrow-right-line" style="font-size:1.2rem;color:var(--pika-muted)"></i></div>
            <div class="col-auto">
                <a href="@(tr ? "/platform/firsatlar" : "/en/platform/opportunities")" class="text-decoration-none">
                    <div class="ph-module-card p-3 text-center" style="min-width:160px">
                        <i class="ri-focus-3-line mb-1" style="font-size:1.3rem;color:var(--pika-primary)"></i>
                        <div class="fw-bold small">@(tr ? "Günün Fırsatları" : "Opportunities")</div>
                        <div style="font-size:.7rem;color:var(--pika-muted)">@(tr ? "Fırsata dönüştür" : "Detect opportunities")</div>
                    </div>
                </a>
            </div>
            <div class="col-auto d-flex align-items-center"><i class="ri-arrow-right-line" style="font-size:1.2rem;color:var(--pika-muted)"></i></div>
            <div class="col-auto">
                <a href="@Url.Action("CampaignManager", "Solutions", new { culture })" class="text-decoration-none">
                    <div class="ph-module-card p-3 text-center" style="min-width:160px">
                        <i class="ri-megaphone-line mb-1" style="font-size:1.3rem;color:var(--pika-primary)"></i>
                        <div class="fw-bold small">Campaign Manager</div>
                        <div style="font-size:.7rem;color:var(--pika-muted)">@(tr ? "Aksiyona geç" : "Execute campaign")</div>
                    </div>
                </a>
            </div>
            <div class="col-auto d-flex align-items-center"><i class="ri-arrow-right-line" style="font-size:1.2rem;color:var(--pika-muted)"></i></div>
            <div class="col-auto">
                <a href="@Url.Action("Reporting", "Solutions", new { culture })" class="text-decoration-none">
                    <div class="ph-module-card p-3 text-center" style="min-width:160px">
                        <i class="ri-bar-chart-box-line mb-1" style="font-size:1.3rem;color:var(--pika-primary)"></i>
                        <div class="fw-bold small">Analytics</div>
                        <div style="font-size:.7rem;color:var(--pika-muted)">@(tr ? "Ölç & öğren" : "Measure & learn")</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

@* ── İLGİLİ SAYFALAR ────────────────────────────────────────── *@
<section class="ph-section">
    <div class="container">
        <div class="text-center mb-4" data-aos="fade-up">
            <h2 class="pika-h2 fw-bold">@(tr ? "İlgili Platform Sayfaları" : "Related Platform Pages")</h2>
        </div>
        <div class="row g-4" data-aos="fade-up" data-aos-delay="100">
            <div class="col-lg-4 col-md-6">
                <a href="@Url.Action("ProductIntelligence", "Platform", new { culture })" class="text-decoration-none">
                    <div class="ph-module-card h-100 p-4">
                        <div class="ph-module-icon mb-3"><i class="ri-shopping-bag-line"></i></div>
                        <div class="fw-bold mb-2">Product Intelligence</div>
                        <p class="small ph-muted mb-0">@(tr ? "Ürünün müşteri ihtiyacı ve ticari rolüyle anlamlandırıldığı katman" : "The layer giving meaning to products through roles, need groups, and playbooks")</p>
                    </div>
                </a>
            </div>
            <div class="col-lg-4 col-md-6">
                <a href="@Url.Action("Pika360", "Platform", new { culture })" class="text-decoration-none">
                    <div class="ph-module-card h-100 p-4">
                        <div class="ph-module-icon mb-3"><i class="ri-user-heart-line"></i></div>
                        <div class="fw-bold mb-2">Pika 360</div>
                        <p class="small ph-muted mb-0">@(tr ? "Tek müşteriyi değer, risk ve fırsat bağlamıyla gösteren karar özeti" : "Unified single-customer decision view across value, risk, and open opportunities")</p>
                    </div>
                </a>
            </div>
            <div class="col-lg-4 col-md-6">
                <a href="@(tr ? "/platform/firsatlar" : "/en/platform/opportunities")" class="text-decoration-none">
                    <div class="ph-module-card h-100 p-4">
                        <div class="ph-module-icon mb-3"><i class="ri-focus-3-line"></i></div>
                        <div class="fw-bold mb-2" data-i18n="nav.mega.opportunities">@(tr ? "Günün Fırsatları" : "Daily Opportunities")</div>
                        <p class="small ph-muted mb-0">@(tr ? "Müşteri ve ürün verisinden çıkarılan öncelikli ticari fırsatlar" : "Prioritized commercial opportunities computed daily from customer and product signals")</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

@* ── CTA ───────────────────────────────────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <h2 class="pika-h2 fw-bold mb-3">@(tr ? "Müşterinizi gerçekten anlamak ister misiniz?" : "Ready to truly understand your customer data?")</h2>
            <p class="ph-muted mb-4">@(tr ? "Pika'nın Customer Intelligence katmanını canlı görün." : "Experience Pika's Customer Intelligence in a live demo.")</p>
            <button type="button" class="ph-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">
                @(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i>
            </button>
        </div>
    </div>
</section>

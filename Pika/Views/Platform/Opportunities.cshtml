@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    var wikiBase = "/wiki/";
    ViewData["Title"] = tr ? "Günün Fırsatları | Fırsat ve Karar Motoru" : "Daily Opportunities | Opportunity & Decision Engine";
    ViewData["MetaDescription"] = tr ? "Pika'nın fırsat motoru, müşteri ve ürün verisinden tekrar satın alma, cross-sell, upsell ve geri kazanım fırsatlarını tespit ederek günlük aksiyon öncelikleri oluşturur." : "Pika's opportunity engine identifies repeat purchase, cross-sell, upsell, and win-back opportunities from customer and product data to create prioritized daily actions.";
    ViewData["BodyClass"] = "pika-platform-page";
}

<section class="ph-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7" data-aos="fade-right" data-aos-duration="700">
                <span class="ph-eyebrow">@(tr ? "Platform — Fırsat & Karar" : "Platform — Opportunity & Decision")</span>
                <h1 class="ph-hero-title">@(tr ? "Günün Fırsatları" : "Daily Opportunities")</h1>
                <p class="ph-hero-desc">
                    @(tr ? "Her müşteri aynı değildir. Bazı müşteride tekrar satın alma zamanı yaklaşır, bazısında yeni ürün ilişkisi doğar, bazısında pasifleşme riski artar." : "Not all customers are the same. For some, a repurchase window approaches; for others, new product affinities emerge or dormancy risks increase.")
                </p>
                <p class="ph-hero-desc" style="font-size:.95rem">
                    @(tr ? "Pika'nın fırsat motoru, bu sinyalleri müşteri ve ürün verisinden okuyarak öncelikli aksiyon listesi oluşturur. Geniş kitlelere aynı mesajı göndermek yerine, doğru müşteriyle doğru bağlamda ilgilenmek." : "Pika's opportunity engine analyzes these signals from customer and product data to produce a prioritized action list. Rather than broadcasting generic messages, engage the right customer in the right context.")
                </p>
                <div class="ph-hero-actions">
                    <button type="button" class="ph-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">
                        @(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i>
                    </button>
                    <a href="@(wikiBase)firsat-turleri" class="ph-btn-outline">
                        @(tr ? "Teknik Detay — Wiki" : "Technical Specs — Wiki") <i class="ri-external-link-line"></i>
                    </a>
                </div>
                <div class="ph-hero-tags mt-3">
                    <span class="ph-tag"><i class="ri-refresh-line"></i> @(tr ? "Tekrar Satın Alma" : "Repeat Purchase")</span>
                    <span class="ph-tag"><i class="ri-store-2-line"></i> Cross-sell</span>
                    <span class="ph-tag"><i class="ri-arrow-up-circle-line"></i> Upsell</span>
                    <span class="ph-tag"><i class="ri-user-received-line"></i> @(tr ? "Geri Kazanım" : "Win-back")</span>
                    <span class="ph-tag"><i class="ri-heart-2-line"></i> @(tr ? "Sadakat" : "Loyalty")</span>
                </div>
            </div>
            <div class="col-lg-5" data-aos="fade-left" data-aos-duration="700">
                <div class="ph-module-card p-4" style="border:1px solid #d4e8b0">
                    <div class="mb-3 d-flex align-items-center gap-2">
                        <i class="ri-sun-line" style="color:#f59e0b;font-size:1.1rem"></i>
                        <span style="font-size:.78rem;color:var(--pika-muted);font-weight:600;text-transform:uppercase;letter-spacing:.05em">@(tr ? "Günün Fırsatları — Örnek" : "Daily Opportunities — Example")</span>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-items-start gap-3 p-2 rounded" style="background:#fff8e1">
                            <div style="width:8px;height:8px;border-radius:50%;background:#f59e0b;flex-shrink:0;margin-top:4px"></div>
                            <div>
                                <div class="fw-bold" style="font-size:.82rem">@(tr ? "Tekrar satın alma" : "Repeat purchase")</div>
                                <div style="font-size:.73rem;color:var(--pika-muted)">@(tr ? "Geçmiş ritme göre ihtiyaç penceresi yaklaşıyor" : "Need window approaching based on past rhythm")</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-start gap-3 p-2 rounded" style="background:#f0fdf4">
                            <div style="width:8px;height:8px;border-radius:50%;background:#22c55e;flex-shrink:0;margin-top:4px"></div>
                            <div>
                                <div class="fw-bold" style="font-size:.82rem">Cross-sell</div>
                                <div style="font-size:.73rem;color:var(--pika-muted)">@(tr ? "Sepet birlikteliği tamamlayıcı ürün adayı destekliyor" : "Basket co-occurrence supports complementary candidate")</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-start gap-3 p-2 rounded" style="background:#fef2f2">
                            <div style="width:8px;height:8px;border-radius:50%;background:#ef4444;flex-shrink:0;margin-top:4px"></div>
                            <div>
                                <div class="fw-bold" style="font-size:.82rem">@(tr ? "Geri kazanım" : "Win-back")</div>
                                <div style="font-size:.73rem;color:var(--pika-muted)">@(tr ? "Beklenen davranıştan uzun süre pasif kalma sinyali" : "Dormancy signal exceeding expected interval")</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-start gap-3 p-2 rounded" style="background:#f0f9e4">
                            <div style="width:8px;height:8px;border-radius:50%;background:#84c225;flex-shrink:0;margin-top:4px"></div>
                            <div>
                                <div class="fw-bold" style="font-size:.82rem">@(tr ? "Sadakat / değer koruma" : "Loyalty / value protection")</div>
                                <div style="font-size:.73rem;color:var(--pika-muted)">@(tr ? "Yüksek değerli müşteri ilişki kalitesi takibi" : "Relationship quality tracking for high-value customers")</div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 pt-2" style="border-top:1px solid #eee;font-size:.7rem;color:var(--pika-muted)">
                        @(tr ? "Demo görünüm — gerçek veriler üretimde hesaplanır" : "Demo preview — live data computed in production")
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── PROBLEM ────────────────────────────────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5" data-aos="fade-right">
                <span class="ph-eyebrow">Problem</span>
                <h2 class="pika-h2 fw-bold">@(tr ? "Veri var, fırsat görünmüyor" : "Data exists, but opportunities stay invisible")</h2>
                <p class="ph-muted">
                    @(tr ? "Müşteri veri tabanı büyür; ancak hangi müşteriye ne zaman, hangi teklifle yaklaşılacağı çoğunlukla sezgiye veya geniş kampanya segmentlerine bırakılır." : "Customer databases grow, but deciding which customer to engage, when, and with what offer is often left to intuition or broad campaign batches.")
                </p>
                <p class="ph-muted">
                    @(tr ? "Sonuç: gereksiz iletişim yükü, azalan açılma oranları ve kullanılmayan ticari potansiyel." : "The result: message fatigue, declining open rates, and untapped revenue potential.")
                </p>
            </div>
            <div class="col-lg-7" data-aos="fade-left">
                <span class="ph-eyebrow">@(tr ? "Pika'nın Yaklaşımı" : "Pika's Approach")</span>
                <h2 class="pika-h2 fw-bold">@(tr ? "Fırsat motoru nasıl çalışır?" : "How does the opportunity engine work?")</h2>
                <div class="d-flex flex-column gap-2 mt-3">
                    <div class="d-flex align-items-start gap-3 p-3 rounded" style="background:#f8fdf0;border:1px solid #d4e8b0">
                        <div class="ph-trust-icon flex-shrink-0" style="width:32px;height:32px;font-size:.75rem">1</div>
                        <div>
                            <div class="fw-bold" style="font-size:.88rem">@(tr ? "Müşteri & ürün verisi okunur" : "Customer & product data is ingested")</div>
                            <div style="font-size:.75rem;color:var(--pika-muted)">@(tr ? "Transaction geçmişi, segment, değer skoru ve ürün bağlamı" : "Transaction history, segment, value score, and product context")</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3 p-3 rounded" style="background:#f8fdf0;border:1px solid #d4e8b0">
                        <div class="ph-trust-icon flex-shrink-0" style="width:32px;height:32px;font-size:.75rem">2</div>
                        <div>
                            <div class="fw-bold" style="font-size:.88rem">@(tr ? "Fırsat tipi tanımlanır" : "Opportunity type is identified")</div>
                            <div style="font-size:.75rem;color:var(--pika-muted)">@(tr ? "Tekrar satın alma, cross-sell, upsell, geri kazanım, sadakat" : "Repeat purchase, cross-sell, upsell, win-back, loyalty")</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3 p-3 rounded" style="background:#f8fdf0;border:1px solid #d4e8b0">
                        <div class="ph-trust-icon flex-shrink-0" style="width:32px;height:32px;font-size:.75rem">3</div>
                        <div>
                            <div class="fw-bold" style="font-size:.88rem">@(tr ? "Evidence & veri kalitesi kontrol edilir" : "Evidence & data quality verified")</div>
                            <div style="font-size:.75rem;color:var(--pika-muted)">@(tr ? "Fırsat kaydının işaretlenmesi aksiyonun hemen gönderileceği anlamına gelmez" : "Flagging an opportunity does not mean an action is dispatched immediately")</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-start gap-3 p-3 rounded" style="background:#f0f9e4;border:1px solid var(--pika-primary)">
                        <div class="ph-trust-icon flex-shrink-0" style="width:32px;height:32px;font-size:.75rem">4</div>
                        <div>
                            <div class="fw-bold" style="font-size:.88rem">@(tr ? "Aksiyona geçiş" : "Transition to action")</div>
                            <div style="font-size:.75rem;color:var(--pika-muted)">@(tr ? "İzin durumu, kanal uygunluğu ve orkestrasyon kuralları değerlendirildikten sonra kampanya veya journey başlatılır" : "Campaign or journey triggers only after verifying consent, channel fit, and orchestration rules")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── FIRSAT TÜRLERİ ─────────────────────────────────────────── *@
<section class="ph-section">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "Fırsat Türleri" : "Opportunity Types")</span>
            <h2 class="pika-h2 fw-bold">@(tr ? "Her fırsat aynı değildir" : "Every opportunity has distinct dynamics")</h2>
            <p class="ph-muted mx-auto" style="max-width:580px">
                @(tr ? "Pika'nın fırsat motoru farklı ticari sinyalleri ayrı kategorilerde değerlendirir. Her tür, farklı aksiyon ve iletişim yaklaşımı gerektirir." : "Pika's opportunity engine categorizes commercial signals separately. Each type demands a tailored action and communication strategy.")
            </p>
        </div>
        <div class="row g-4" data-aos="fade-up" data-aos-delay="100">
            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100">
                    <div class="ph-module-icon"><i class="ri-refresh-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1rem">@(tr ? "Tekrar Satın Alma" : "Repeat Purchase")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Müşterinin geçmiş ritmine göre tekrar ihtiyaç penceresi yaklaşır. Zamanında ulaşmak, müşteri deneyimini güçlendirir." : "A customer's repurchase window nears based on historical rhythms. Timely engagement strengthens customer trust.")
                    </p>
                    <div class="mt-3">
                        <a href="@(wikiBase)tekrar-satin-alma-analizi" class="small" style="color:var(--pika-primary)">
                            @(tr ? "Wiki'de oku" : "Read in Wiki") <i class="ri-arrow-right-line"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100">
                    <div class="ph-module-icon"><i class="ri-store-2-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1rem">Cross-sell</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Sepet birlikteliği ve ürün ilişkileri tamamlayıcı ürün/kategori adaylarını destekler. Müşteri bazlı aksiyon ayrıca bağlamlandırılır." : "Basket affinity and product associations identify logical accessories and categories, personalized to the individual.")
                    </p>
                    <div class="mt-3">
                        <a href="@(wikiBase)cross-sell-firsatlari" class="small" style="color:var(--pika-primary)">
                            @(tr ? "Wiki'de oku" : "Read in Wiki") <i class="ri-arrow-right-line"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100">
                    <div class="ph-module-icon"><i class="ri-arrow-up-circle-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1rem">Upsell</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Product Intelligence ürün rolleriyle mevcut ürünün mantıklı yükseltme adayları tanımlanır; iş kuralı ve orkestrasyon katmanında değerlendirilir." : "Product Intelligence defines sensible upgrade candidates based on product roles, evaluated in the orchestration layer.")
                    </p>
                    <div class="mt-3">
                        <a href="@(wikiBase)upsell-firsatlari" class="small" style="color:var(--pika-primary)">
                            @(tr ? "Wiki'de oku" : "Read in Wiki") <i class="ri-arrow-right-line"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100">
                    <div class="ph-module-icon"><i class="ri-user-received-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1rem">@(tr ? "Geri Kazanım" : "Win-back")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Normal davranışına göre beklenenden uzun süre pasif kalan müşteri yeniden ilişkilendirme adayı olur." : "Customers dormant beyond their normal activity cadence become prime candidates for relationship revival.")
                    </p>
                    <div class="mt-3">
                        <a href="@(wikiBase)firsat-turleri" class="small" style="color:var(--pika-primary)">
                            @(tr ? "Wiki'de oku" : "Read in Wiki") <i class="ri-arrow-right-line"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100">
                    <div class="ph-module-icon"><i class="ri-heart-2-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1rem">@(tr ? "Sadakat / Değer Koruma" : "Loyalty / Value Retention")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Yüksek değerli müşterinin ilişki kalitesini korumaya yönelik aksiyonlar öncelik kazanır." : "High-value customer relationship preservation actions receive elevated priority.")
                    </p>
                    <div class="mt-3">
                        <a href="@(wikiBase)musteri-degeri-sadakat" class="small" style="color:var(--pika-primary)">
                            @(tr ? "Wiki'de oku" : "Read in Wiki") <i class="ri-arrow-right-line"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="ph-module-card h-100">
                    <div class="ph-module-icon"><i class="ri-shield-check-line"></i></div>
                    <h3 class="fw-bold mb-2" style="font-size:1rem">@(tr ? "Fırsat Güveni & Kanıt" : "Opportunity Confidence & Evidence")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Bir kaydın fırsat olarak işaretlenmesi aksiyonun hemen gönderileceği anlamına gelmez. Evidence, veri kalitesi ve izin durumu ayrıca kontrol edilir." : "Tagging a record as an opportunity does not guarantee immediate delivery. Evidence, data freshness, and consent compliance are validated.")
                    </p>
                    <div class="mt-3">
                        <a href="@(wikiBase)firsat-guveni-kanit" class="small" style="color:var(--pika-primary)">
                            @(tr ? "Wiki'de oku" : "Read in Wiki") <i class="ri-arrow-right-line"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ── AKSIYONA GEÇİŞ ─────────────────────────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="ph-eyebrow">@(tr ? "Zincir" : "The Value Chain")</span>
            <h2 class="pika-h2 fw-bold">@(tr ? "Fırsattan aksiyona: Pika platformunun tam zinciri" : "From opportunity to action: The full Pika chain")</h2>
        </div>
        <div class="row g-3 justify-content-center" data-aos="fade-up" data-aos-delay="100">
            <div class="col-auto">
                <a href="@Url.Action("CustomerIntelligence", "Platform", new { culture })" class="text-decoration-none">
                    <div class="ph-module-card p-3 text-center" style="min-width:150px">
                        <i class="ri-brain-line mb-1" style="font-size:1.2rem;color:var(--pika-primary)"></i>
                        <div class="fw-bold small">Customer Intelligence</div>
                        <div style="font-size:.7rem;color:var(--pika-muted)">@(tr ? "Müşteriyi anla" : "Understand customer")</div>
                    </div>
                </a>
            </div>
            <div class="col-auto d-flex align-items-center"><i class="ri-arrow-right-line" style="color:var(--pika-muted)"></i></div>
            <div class="col-auto">
                <a href="@Url.Action("ProductIntelligence", "Platform", new { culture })" class="text-decoration-none">
                    <div class="ph-module-card p-3 text-center" style="min-width:150px">
                        <i class="ri-shopping-bag-line mb-1" style="font-size:1.2rem;color:var(--pika-primary)"></i>
                        <div class="fw-bold small">Product Intelligence</div>
                        <div style="font-size:.7rem;color:var(--pika-muted)">@(tr ? "Ürünü anla" : "Contextualize products")</div>
                    </div>
                </a>
            </div>
            <div class="col-auto d-flex align-items-center"><i class="ri-arrow-right-line" style="color:var(--pika-muted)"></i></div>
            <div class="col-auto">
                <div class="ph-module-card p-3 text-center" style="min-width:150px;border:2px solid var(--pika-primary)">
                    <i class="ri-focus-3-line mb-1" style="font-size:1.2rem;color:var(--pika-primary)"></i>
                    <div class="fw-bold small">@(tr ? "Günün Fırsatları" : "Opportunities")</div>
                    <div style="font-size:.7rem;color:var(--pika-muted)">@(tr ? "Şu an burada" : "Current location")</div>
                </div>
            </div>
            <div class="col-auto d-flex align-items-center"><i class="ri-arrow-right-line" style="color:var(--pika-muted)"></i></div>
            <div class="col-auto">
                <a href="@Url.Action("CampaignManager", "Solutions", new { culture })" class="text-decoration-none">
                    <div class="ph-module-card p-3 text-center" style="min-width:150px">
                        <i class="ri-megaphone-line mb-1" style="font-size:1.2rem;color:var(--pika-primary)"></i>
                        <div class="fw-bold small">Campaign / Journey</div>
                        <div style="font-size:.7rem;color:var(--pika-muted)">@(tr ? "Aksiyona geç" : "Trigger action")</div>
                    </div>
                </a>
            </div>
            <div class="col-auto d-flex align-items-center"><i class="ri-arrow-right-line" style="color:var(--pika-muted)"></i></div>
            <div class="col-auto">
                <a href="@Url.Action("Reporting", "Solutions", new { culture })" class="text-decoration-none">
                    <div class="ph-module-card p-3 text-center" style="min-width:150px">
                        <i class="ri-bar-chart-box-line mb-1" style="font-size:1.2rem;color:var(--pika-primary)"></i>
                        <div class="fw-bold small">Analytics</div>
                        <div style="font-size:.7rem;color:var(--pika-muted)">@(tr ? "Ölç & öğren" : "Measure & learn")</div>
                    </div>
                </a>
            </div>
        </div>
        <div class="text-center mt-4">
            <a href="@(wikiBase)firsattan-aksiyona-gecis" class="small" style="color:var(--pika-primary)">
                @(tr ? "Fırsattan aksiyona geçiş — Wiki'de detaylar" : "From opportunity to action — Wiki details") <i class="ri-arrow-right-line"></i>
            </a>
        </div>
    </div>
</section>

@* ── CTA ───────────────────────────────────────────────────── *@
<section class="ph-section">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <h2 class="pika-h2 fw-bold mb-3">@(tr ? "Müşteri verinizde bugün hangi fırsatlar var?" : "What opportunities exist in your customer data today?")</h2>
            <p class="ph-muted mb-4">@(tr ? "Pika'nın fırsat motorunu canlı demo ile görün." : "See Pika's opportunity engine in a live demo.")</p>
            <button type="button" class="ph-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">
                @(tr ? "Demo Talep Et" : "Request a Demo") <i class="ri-arrow-right-up-line"></i>
            </button>
        </div>
    </div>
</section>

@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant();
    var tr=culture=="tr";
    ViewData["Title"]=tr?"Günün Fırsatları | Pika":"Daily Opportunities | Pika";
    ViewData["MetaDescription"]=tr?"Pika Günün Fırsatları; tekrar satın alma, geri kazanım ve desteklenen ürün ilişkilerinden doğan aksiyona aday durumları müşteri, ürün, kanıt ve uygunluk bağlamıyla görünür kılar.":"Pika Daily Opportunities surfaces actionable repeat-purchase, win-back and supported product-relationship situations with customer, product, evidence and eligibility context.";
    ViewData["BodyClass"]="pk-page";
}

<section class="pk-hero-v2"><div class="pk-container pk-hero-grid">
    <div class="pk-hero-copy"><span class="pk-eyebrow">Platform · @(tr?"Fırsat ve Karar":"Opportunity & Decision")</span><h1>@(tr?"Pika bugün sizin için ne buldu?":"What did Pika find for you today?")</h1><p>@(tr?"Günün Fırsatları, Pika'nın müşteri ve ürün verisinde aksiyona temel olabilecek ticari durumları tek çalışma alanında görünür kıldığı karar ekranıdır. Her fırsatın neden oluştuğunu, hangi kanıta dayandığını ve hangi aksiyonlara bağlanabileceğini inceleyin; kararı siz verin.":"Daily Opportunities is Pika's decision workspace for commercial situations that may justify action. Review why an opportunity exists, what evidence supports it and which actions it may connect to — then make the decision yourself.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Günün Fırsatları'nı Canlı Görün":"See Daily Opportunities Live")</button><a class="pk-btn pk-btn-ghost" href="/wiki/gunun-firsatlari-ve-karar-motoru">@(tr?"Nasıl çalıştığını okuyun":"Read how it works")</a></div><div class="pk-hero-note"><i class="ri-user-follow-line"></i><span>@(tr?"Fırsat bulundu demek mesaj gönderildi demek değildir. Kullanıcı kanıtı görür, aksiyonu seçer." : "An opportunity does not mean a message was sent. The user sees evidence and chooses the action.")</span></div></div>
    <div class="pk-product-stage"><div class="pk-stage-glow"></div><div class="pk-stage-browser"><div class="pk-stage-bar"><span></span><span></span><span></span></div><img src="/wiki/assets/images/img_gunun-firsatlari.png" alt="@(tr?"Pika Günün Fırsatları ekranı":"Pika Daily Opportunities screen")" width="1200" height="760" /><div class="pk-stage-caption"><strong>@(tr?"Günün Fırsatları":"Daily Opportunities")</strong><span>@(tr?"Bul → Açıkla → İncele → Aksiyona bağla":"Find → Explain → Review → Connect to action")</span></div></div><div class="pk-stage-float pk-float-one"><i class="ri-refresh-line"></i><div><strong>@(tr?"Tekrar satın alma":"Repeat purchase")</strong><small>@(tr?"Yaklaşan ihtiyaç penceresi":"Approaching need window")</small></div></div><div class="pk-stage-float pk-float-two"><i class="ri-user-unfollow-line"></i><div><strong>@(tr?"Geri kazanım":"Win-back")</strong><small>@(tr?"Ritimden uzaklaşma":"Behavioral drift")</small></div></div><div class="pk-stage-float pk-float-three"><i class="ri-links-line"></i><div><strong>Cross-sell</strong><small>@(tr?"Ürün ilişkisi kanıtı":"Product relationship evidence")</small></div></div></div>
</div></section>

<section class="pk-section pk-section-lg"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Tanım":"Definition")</span><h2>@(tr?"Günün Fırsatları nedir?":"What are Daily Opportunities?")</h2></div><p class="pk-lead">@(tr?"Günün Fırsatları, Pika'nın hesaplanmış müşteri ve ürün sinyallerini kullanıcı açısından günlük karar diline çevirdiği çalışma alanıdır. Bir fırsat; müşteride gerçekleşen veya hesaplanan belirli bir durumun, yeterli bağlam ve uygunlukla birlikte aksiyona aday hale gelmesidir. Fırsatın kendisi otomatik gönderim değildir.":"Daily Opportunities is the workspace where Pika translates calculated customer and product signals into daily decision language. An opportunity is a situation that may justify action when sufficient context and eligibility exist. The opportunity itself is not automatic sending.")</p></div>
<div class="pk-intel-grid"><article class="pk-intel-panel"><span class="pk-intel-number">01</span><div class="pk-intel-icon"><i class="ri-radar-line"></i></div><h3>@(tr?"Sinyali bulur":"Find the signal")</h3><p>@(tr?"Müşteri ritmi, değer/risk bağlamı, ürün ilişkisi ve desteklenen diğer hesaplanmış sinyaller fırsat adaylarının temelini oluşturabilir." : "Customer rhythm, value/risk context, product relationships and other supported calculated signals may form the basis of opportunity candidates.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">02</span><div class="pk-intel-icon"><i class="ri-file-search-line"></i></div><h3>@(tr?"Nedeni görünür kılar":"Make the reason visible")</h3><p>@(tr?"Kullanıcı yalnızca 'öneri' görmez; mümkün olduğunda fırsatın türünü, ilişkili müşteri/ürün bağlamını ve neden şimdi incelenmesi gerektiğini görür." : "The user sees more than a recommendation: the opportunity type, related customer/product context and why it deserves attention now, where supported.")</p></article><article class="pk-intel-panel"><span class="pk-intel-number">03</span><div class="pk-intel-icon"><i class="ri-route-line"></i></div><h3>@(tr?"Aksiyona bağlar":"Connect to action")</h3><p>@(tr?"Kullanıcı uygun görürse hedef kitle, içerik, Campaign veya Journey hazırlığına geçebilir. İzin ve kanal uygunluğu aksiyon katmanında ayrıca değerlendirilir." : "If the user decides to proceed, the opportunity can connect to audience, content, Campaign or Journey preparation. Consent and channel eligibility are evaluated separately.")</p></article></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft-2"><div class="pk-container pk-opportunity-showcase"><div class="pk-opportunity-copy"><span class="pk-eyebrow">@(tr?"Fırsat türleri":"Opportunity types")</span><h2>@(tr?"Her sinyal aynı aksiyonu gerektirmez.":"Different signals call for different decisions.")</h2><p class="pk-lead">@(tr?"Pika fırsatı yalnız bir etiket olarak değil, neden/kanıt bağlamıyla ele alır. Hangi fırsat türlerinin kullanılabileceği müşterideki veri kapsamına ve etkin ürün kabiliyetlerine bağlıdır.":"Pika treats an opportunity as evidence and context, not merely a label. Available opportunity types depend on customer data coverage and enabled capabilities.")</p><div class="pk-signal-list"><div class="pk-signal"><div class="pk-signal-icon"><i class="ri-refresh-line"></i></div><div><strong>@(tr?"Tekrar satın alma":"Repeat purchase")</strong><span>@(tr?"Müşterinin kendi geçmiş alışveriş ritmi ve ürünün tekrar tüketim bağlamı yaklaşan ihtiyaç sinyali oluşturabilir." : "The customer's own purchase rhythm and the product's repeat-consumption context may create an approaching-need signal.")</span></div><span class="pk-signal-tag">@(tr?"Ritim":"Rhythm")</span></div><div class="pk-signal"><div class="pk-signal-icon"><i class="ri-user-unfollow-line"></i></div><div><strong>@(tr?"Geri kazanım":"Win-back")</strong><span>@(tr?"Müşteri kendi normal davranışından uzaklaştığında risk ve geçmiş değer bağlamıyla birlikte değerlendirilir." : "When a customer drifts from normal behavior, the signal is reviewed together with risk and historical value context.")</span></div><span class="pk-signal-tag">Risk</span></div><div class="pk-signal"><div class="pk-signal-icon"><i class="ri-links-line"></i></div><div><strong>Cross-sell</strong><span>@(tr?"Ürünlerin aynı sepetlerde birlikte görülmesi gibi kanıtlar Product Intelligence ve müşteri bağlamıyla birlikte değerlendirilebilir." : "Evidence such as products appearing together in baskets can be reviewed with Product Intelligence and customer context.")</span></div><span class="pk-signal-tag">Product</span></div></div></div><div class="pk-opportunity-panel"><div class="pk-product-window"><div class="pk-product-window-header"><div><i></i><i></i><i></i></div><span>@(tr?"Canlı ürün akışı":"Product workflow")</span></div><img src="/wiki/assets/images/img_segmentasyon-ve-firsatlar_26.png" alt="@(tr?"Pika fırsat ve segment görünümü":"Pika opportunity and segment view")" loading="lazy" width="1200" height="760" /></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container pk-control-grid"><div><span class="pk-eyebrow">@(tr?"Kullanıcı kontrolü":"User control")</span><h2>@(tr?"Fırsat bulundu ≠ kampanya yayınlandı.":"Opportunity found ≠ campaign published.")</h2><p class="pk-lead" style="margin-top:22px">@(tr?"Günün Fırsatları karar desteğidir. Kullanıcı müşteriyi, fırsatın nedenini ve mevcut uygunluk bağlamını inceler. Mesaj hazırlamak, hedef kitle oluşturmak, Campaign açmak, Journey başlatmak veya hiçbir aksiyon almamak kullanıcının iş kararıdır.":"Daily Opportunities is decision support. The user reviews the customer, the reason behind the opportunity and available eligibility context. Preparing a message, building an audience, creating a Campaign, starting a Journey or taking no action remains a business decision.")</p></div><div class="pk-control-flow"><div class="pk-control-step"><i class="ri-radar-line"></i><div><strong>1. @(tr?"Pika fırsat adayını bulur":"Pika finds an opportunity candidate")</strong><span>@(tr?"Hesaplanmış müşteri veya ürün sinyalinden karar bağlamı oluşur." : "Decision context is formed from a calculated customer or product signal.")</span></div></div><div class="pk-control-step"><i class="ri-file-search-line"></i><div><strong>2. @(tr?"Kanıt ve neden gösterilir":"Evidence and reason are shown")</strong><span>@(tr?"Kullanıcı önerinin nereden geldiğini ve hangi bağlama dayandığını görür." : "The user can see where the opportunity came from and which context supports it.")</span></div></div><div class="pk-control-step pk-control-human"><i class="ri-user-follow-line"></i><div><strong>3. @(tr?"Kullanıcı karar verir":"The user decides")</strong><span>@(tr?"Öncelik, iş kuralı ve müşteri ilişkisine göre uygun aksiyon seçilir." : "The action is chosen according to priority, business rules and customer relationship context.")</span></div></div><div class="pk-control-step"><i class="ri-shield-check-line"></i><div><strong>4. @(tr?"Uygunluk kontrol edilir":"Eligibility is checked")</strong><span>@(tr?"İletişim gerekiyorsa izin, opt-out, kanal adresi ve ilgili uygunluk koşulları değerlendirilir." : "If communication is needed, consent, opt-out, channel address and relevant eligibility conditions are evaluated.")</span></div></div><div class="pk-control-step"><i class="ri-route-line"></i><div><strong>5. @(tr?"Aksiyon hazırlanır":"Action is prepared")</strong><span>Audience · Campaign · Journey · Content</span></div></div></div></div></section>

<section class="pk-section pk-section-xl pk-decision-band"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Fırsattan aksiyona":"From opportunity to action")</span><h2>@(tr?"Fırsat bağlamını kaybetmeden Campaign veya Journey'e taşıyın.":"Carry opportunity context into Campaign or Journey without losing the reason behind it.")</h2></div><p class="pk-lead">@(tr?"Bir fırsatın değeri yalnızca doğru müşteriyi bulmasında değil, sonraki ekip veya modülün neden bu müşteriye aksiyon alındığını anlayabilmesindedir. Pika bu nedenle fırsat, hedef kitle, içerik ve yürütme katmanlarını aynı karar zincirine bağlar.":"An opportunity is valuable not only because it identifies a customer, but because downstream execution can preserve why action was considered. Pika connects opportunity, audience, content and execution within one decision chain.")</p></div><div class="pk-workflow"><div class="pk-workflow-step"><small>01</small><i class="ri-sparkling-2-line"></i><strong>@(tr?"Fırsat":"Opportunity")</strong><span>@(tr?"Neden şimdi?":"Why now?")</span></div><div class="pk-workflow-step"><small>02</small><i class="ri-user-search-line"></i><strong>Pika 360</strong><span>@(tr?"Müşteri bağlamını incele":"Review customer context")</span></div><div class="pk-workflow-step"><small>03</small><i class="ri-filter-3-line"></i><strong>Audience</strong><span>@(tr?"İlgili kitleyi belirle":"Define the relevant audience")</span></div><div class="pk-workflow-step"><small>04</small><i class="ri-magic-line"></i><strong>Content / AI</strong><span>@(tr?"İçerik hazırlığını hızlandır":"Accelerate content preparation")</span></div><div class="pk-workflow-step"><small>05</small><i class="ri-route-line"></i><strong>Campaign / Journey</strong><span>@(tr?"Kontrollü yürüt":"Execute with control")</span></div><div class="pk-workflow-step"><small>06</small><i class="ri-bar-chart-box-line"></i><strong>Analytics</strong><span>@(tr?"Sonucu ölç":"Measure outcomes")</span></div></div></div></section>

<section class="pk-section pk-section-xl pk-section-soft"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Gerçek ürün kanıtı":"Real product proof")</span><h2>@(tr?"Fırsatı gördükten sonra bağlamdan kopmadan ilerleyin.":"Move forward without losing context after seeing the opportunity.")</h2></div><p class="pk-lead">@(tr?"Fırsat müşteriye özel incelenebilir, aksiyon çalışma alanına taşınabilir ve uygun olduğunda Campaign/Journey hazırlığına bağlanabilir. AI burada açıklama ve taslak desteği verebilir; yürütme kontrolünü devralmaz.":"An opportunity can be reviewed at customer level, carried into an action workspace and connected to Campaign/Journey preparation where appropriate. AI may assist with explanations and drafts without taking over execution control.")</p></div><div class="pk-gallery"><div class="pk-gallery-main"><img src="/wiki/assets/images/img_aksiyon-calisma-alani_9.png" alt="@(tr?"Pika aksiyon çalışma alanı":"Pika action workspace")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Aksiyon çalışma alanı":"Action workspace")</small><h3>@(tr?"Fırsatın nedenini aksiyona taşırken koruyun":"Preserve the reason behind the opportunity when moving to action")</h3><p>@(tr?"Müşteri ve fırsat bağlamı, sonraki aksiyon hazırlığında kararın nedenini görünür tutmaya yardımcı olur." : "Customer and opportunity context helps preserve the reason behind the decision during action preparation.")</p></div></div><div class="pk-gallery-side"><img src="/wiki/assets/images/img_izin-kanal-zamanlama_25.png" alt="@(tr?"Pika izin kanal zamanlama görünümü":"Pika consent channel timing view")" loading="lazy" width="1200" height="760" /><div class="pk-gallery-copy"><small>@(tr?"Uygunluk":"Eligibility")</small><h3>@(tr?"Her fırsat her kanaldan gönderilmez":"Not every opportunity should use every channel")</h3><p>@(tr?"İzin, opt-out ve kanal uygunluğu iletişim kararının ayrı bir parçasıdır." : "Consent, opt-out and channel eligibility are separate parts of communication decisions.")</p></div></div></div></div></section>

<section class="pk-section pk-section-xl"><div class="pk-container"><div class="pk-section-head"><div><span class="pk-eyebrow">@(tr?"Kullanım senaryoları":"Use cases")</span><h2>@(tr?"Bir yöneticinin günlük sorularından başlayın.":"Start from a manager's daily questions.")</h2></div><p class="pk-lead">@(tr?"Günün Fırsatları modül isimlerinden önce iş sorusunu görünür kılmalıdır. Kullanıcı önce 'hangi müşteriye neden bakmalıyım?' sorusunun cevabını alır; sonra uygun Pika katmanına geçer.":"Daily Opportunities should surface the business question before module names. The user first understands which customer deserves attention and why, then moves into the appropriate Pika layer.")</p></div><div class="pk-columns"><div class="pk-feature"><i class="ri-refresh-line"></i><h3>@(tr?"Kim tekrar satın almaya yaklaşıyor?":"Who is approaching repeat purchase?")</h3><p>@(tr?"Müşterinin kendi satın alma ritmi ve ürünün tekrar tüketim bağlamı birlikte değerlendirilir." : "Individual purchase rhythm and product repeat-consumption context are reviewed together.")</p></div><div class="pk-feature"><i class="ri-user-unfollow-line"></i><h3>@(tr?"Hangi değerli müşteri pasifleşiyor?":"Which valuable customer is becoming inactive?")</h3><p>@(tr?"Davranıştaki uzaklaşmayı geçmiş değer ve ilişki bağlamıyla birlikte değerlendirin." : "Review behavioral drift together with historical value and relationship context.")</p></div><div class="pk-feature"><i class="ri-links-line"></i><h3>@(tr?"Bu müşteriye hangi tamamlayıcı ürün anlamlı?":"Which complementary product may be relevant?")</h3><p>@(tr?"Ürün ilişkisi kanıtını müşteriye özel bağlamla birleştirmeden otomatik öneri gibi sunmayın." : "Do not present product-relationship evidence as a customer recommendation without customer-level context.")</p></div></div><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr?"/kullanim-senaryolari":"/en/use-cases")">@(tr?"Tüm kullanım senaryolarını görün":"Explore all use cases")</a><a class="pk-btn pk-btn-primary" href="@(tr?"/platform/campaign-manager":"/en/platform/campaign-manager")">Campaign Manager</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/journey-manager":"/en/platform/journey-manager")">Journey Manager</a></div></div></section>

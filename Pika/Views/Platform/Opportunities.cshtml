@{
    var culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr";
    var tr = culture.Equals("tr", StringComparison.OrdinalIgnoreCase);
    ViewData["BodyClass"] = "pika-platform-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pika-opportunities-page.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pika-inner.js" asp-append-version="true"></script>
}

@* ── 01 HERO ─────────────────────────────────────────────────── *@
<section class="inner-hero inner-hero--product">
    <div class="inner-atmosphere" aria-hidden="true"><span></span><span></span></div>
    <div class="container inner-hero-grid">
        <div class="inner-intro">
            <nav class="inner-breadcrumb" aria-label="@(tr ? "Sayfa yolu" : "Breadcrumb")">
                <a href="@(tr ? "/" : "/en/")">Pika</a>
                <span>/</span>
                <a href="@(tr ? "/pika" : "/en/pika")">@(tr ? "Pika Nedir?" : "What Is Pika?")</a>
                <span>/</span>
                <span>@(tr ? "Günün Fırsatları" : "Daily Opportunities")</span>
            </nav>
            <div class="inner-eyebrow"><span></span>@(tr ? "GÜNÜN FIRSATLARI" : "DAILY OPPORTUNITIES")</div>
            @if (tr)
            {
                <h1>
                    Bugün hangi müşteride<br />
                    hangi fırsat var?
                </h1>
                <p>
                    Günün Fırsatları, Pika'nın müşteri ve ürün zekâsından oluşan bağlamı tekrar satın alma, cross-sell ve geri kazanım gibi değerlendirilebilir günlük ticari fırsatlara dönüştüren karar katmanıdır.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.72);font-size:15px;margin-bottom:30px">
                    Amaç daha fazla kampanya üretmek değil, bugün gerçekten değerlendirmeye değer müşteri ve ürün fırsatlarını görünür hale getirmektir.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Demo Talep Et ↗
                    </button>
                    <a class="inner-secondary" href="/platform/pika-360">
                        Pika 360'ı Keşfedin →
                    </a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="İçeriğe atla">
                        <i class="ri-arrow-down-line" aria-hidden="true"></i>
                    </a>
                </div>
            }
            else
            {
                <h1>
                    Which customer has<br />
                    which opportunity today?
                </h1>
                <p>
                    Daily Opportunities is Pika's decision layer that turns customer and product intelligence context into evaluable daily commercial opportunities such as repeat purchase, cross-sell and win-back.
                </p>
                <p class="ph-muted" style="color:rgba(255,255,255,0.72);font-size:15px;margin-bottom:30px">
                    The objective is not to produce more campaigns. It is to make the customer and product opportunities worth evaluating today visible.
                </p>
                <div class="inner-actions">
                    <button class="inner-primary" type="button" data-bs-toggle="modal" data-bs-target="#demoModal">
                        Request a Demo ↗
                    </button>
                    <a class="inner-secondary" href="/en/platform/pika-360">
                        Explore Pika 360 →
                    </a>
                    <a class="inner-hero-anchor" href="#inner-content" aria-label="Skip to content">
                        <i class="ri-arrow-down-line" aria-hidden="true"></i>
                    </a>
                </div>
            }
        </div>
        <div class="inner-scene" aria-label="@(tr ? "Platformun çalışma biçimini anlatan örnek görünüm" : "Illustrative view of how the platform works")">
            <div class="inner-scene-orbit" aria-hidden="true"></div>
            <div class="inner-scene-window">
                <div class="inner-window-bar">
                    <strong>pika<span>✳</span></strong>
                    <span>@(tr ? "Günün Fırsatları" : "Daily Opportunities")</span>
                    <small>@(tr ? "Örnek görünüm" : "Illustration")</small>
                </div>
                <div class="inner-products">
                    <div>
                        <i class="ri-refresh-line" aria-hidden="true"></i>
                        <small>@(tr ? "TEKRAR SATIN ALMA" : "REPEAT PURCHASE")</small>
                        <strong>@(tr ? "Satın Alma Ritmi" : "Purchase Rhythm")</strong>
                    </div>
                    <span>+</span>
                    <div>
                        <i class="ri-store-2-line" aria-hidden="true"></i>
                        <small>@(tr ? "CROSS-SELL" : "CROSS-SELL")</small>
                        <strong>@(tr ? "Ürün Anlamı" : "Product Meaning")</strong>
                    </div>
                </div>
                <div class="inner-insight">
                    <span>✳</span>
                    <div>
                        <strong>@(tr ? "Müşteri ve ürün bağlamı buluşur." : "Customer and product context connect.")</strong>
                        <p>@(tr ? "Değerlendirilebilir günlük ticari fırsatlar." : "Evaluable daily commercial opportunities.")</p>
                    </div>
                </div>
            </div>
            <div class="inner-scene-caption">DAILY OPPORTUNITIES. DECISION CONTEXT.</div>
        </div>
    </div>
</section>
<div id="inner-content" class="inner-anchor"></div>

@* ── 02 DIRECT ANSWER ────────────────────────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container" style="max-width:860px">
        <span class="ph-eyebrow">@(tr ? "KISA CEVAP" : "THE SHORT ANSWER")</span>
        <h2 class="pika-h2 fw-bold mb-3">@(tr ? "Günün Fırsatları nedir?" : "What are Daily Opportunities?")</h2>
        @if (tr)
        {
            <p class="ph-lead mb-3">
                Günün Fırsatları, Customer Intelligence ve Product Intelligence tarafından oluşturulan müşteri ve ürün bağlamını günlük ticari fırsat adaylarına dönüştüren Pika karar katmanıdır.
            </p>
            <p class="ph-muted">
                Bu katman üç temel fırsat türünü görünür hale getirir:
            </p>
            <ul class="list-unstyled d-flex flex-column gap-2 my-3 ps-3 border-start border-2" style="border-color:var(--pika-primary) !important">
                <li class="fw-bold" style="color:#23413b">• Tekrar Satın Alma</li>
                <li class="fw-bold" style="color:#23413b">• Cross-sell</li>
                <li class="fw-bold" style="color:#23413b">• Geri Kazanım</li>
            </ul>
            <p class="ph-muted">
                Günün Fırsatları'nın görevi kampanyayı otomatik olarak göndermek değildir.
            </p>
            <p class="ph-muted">
                Önce cevaplanması gereken soruyu görünür hale getirir:
            </p>
            <div class="p-4 rounded my-4 text-center bg-white border" style="border-left:4px solid var(--pika-primary) !important">
                <div class="fw-bold" style="font-size:1.25rem;color:#23413b;line-height:1.5">
                    “Bugün hangi müşteride,<br />
                    hangi ticari fırsat<br />
                    değerlendirilmeli?”
                </div>
            </div>
            <p class="ph-muted mb-0">
                Fırsat görünür hale geldikten sonra kullanıcı müşteri bağlamını değerlendirebilir ve uygun olduğunda Pika'nın hedef kitle, kampanya veya journey katmanlarında kontrollü aksiyona geçebilir.
            </p>
        }
        else
        {
            <p class="ph-lead mb-3">
                Daily Opportunities is the Pika decision layer that turns customer and product context created by Customer Intelligence and Product Intelligence into daily commercial opportunity candidates.
            </p>
            <p class="ph-muted">
                This layer makes three core opportunity types visible:
            </p>
            <ul class="list-unstyled d-flex flex-column gap-2 my-3 ps-3 border-start border-2" style="border-color:var(--pika-primary) !important">
                <li class="fw-bold" style="color:#23413b">• Repeat Purchase</li>
                <li class="fw-bold" style="color:#23413b">• Cross-sell</li>
                <li class="fw-bold" style="color:#23413b">• Win-back</li>
            </ul>
            <p class="ph-muted">
                The role of Daily Opportunities is not to send a campaign automatically.
            </p>
            <p class="ph-muted">
                It makes the question that should be answered first visible:
            </p>
            <div class="p-4 rounded my-4 text-center bg-white border" style="border-left:4px solid var(--pika-primary) !important">
                <div class="fw-bold" style="font-size:1.25rem;color:#23413b;line-height:1.5">
                    “Which customer,<br />
                    and which commercial opportunity,<br />
                    should be evaluated today?”
                </div>
            </div>
            <p class="ph-muted mb-0">
                Once an opportunity is visible, the user can evaluate customer context and, where appropriate, move into controlled action through Pika's audience, campaign or journey layers.
            </p>
        }
    </div>
</section>

@* ── 03 WHY OPPORTUNITIES MATTER ─────────────────────────────── *@
<section class="ph-section">
    <div class="container" style="max-width:860px">
        <span class="ph-eyebrow">@(tr ? "TAKVİMDEN BAĞLAMA" : "FROM CALENDAR TO CONTEXT")</span>
        <h2 class="pika-h2 fw-bold mb-3">
            @(tr ? "Pazarlama takvimindeki boşluk, kampanya sebebi değildir." : "An empty slot in the marketing calendar is not a reason to run a campaign.")
        </h2>
        @if (tr)
        {
            <p class="ph-muted">
                Pazarlama ekipleri her gün benzer bir soruyla karşılaşır:
            </p>
            <div class="p-3 my-3 rounded bg-white border">
                <strong style="color:#23413b;font-size:1.05rem">“Bugün kime ulaşmalıyız?”</strong>
            </div>
            <p class="ph-muted">
                Bu sorunun cevabı yalnızca kampanya takviminden, geniş müşteri segmentlerinden veya genel indirim planından geldiğinde iletişim müşterinin gerçek davranışından kopabilir.
            </p>
            <p class="ph-muted">
                Oysa müşteri işlemleri ve ürün ilişkileri her gün değerlendirilebilecek farklı ticari sinyaller üretir.
            </p>
            <div class="d-flex flex-column gap-2 my-4">
                <div class="p-3 rounded bg-white border">
                    <span style="color:#23413b">Bir müşteri yeniden satın alma ritmine yaklaşabilir.</span>
                </div>
                <div class="p-3 rounded bg-white border">
                    <span style="color:#23413b">Başka bir müşteride anlamlı bir tamamlayıcı ürün ilişkisi oluşabilir.</span>
                </div>
                <div class="p-3 rounded bg-white border">
                    <span style="color:#23413b">Bir başka müşterinin davranışı kendi geçmişine göre zayıflıyor olabilir.</span>
                </div>
            </div>
            <p class="ph-muted">
                Günün Fırsatları bu sinyalleri günlük karar bağlamına taşır.
            </p>
            <div class="p-3 rounded mt-3 text-center" style="background:#f8faf4;border:1px dashed #dce5d3">
                <strong style="color:#23413b">
                    Kampanya fikri takvimden değil,<br />
                    müşteri ve ürün bağlamından doğabilir.
                </strong>
            </div>
        }
        else
        {
            <p class="ph-muted">
                Marketing teams face a familiar question every day:
            </p>
            <div class="p-3 my-3 rounded bg-white border">
                <strong style="color:#23413b;font-size:1.05rem">“Who should we reach today?”</strong>
            </div>
            <p class="ph-muted">
                When that answer comes only from the campaign calendar, broad segments or a generic discount plan, communication can become disconnected from actual customer behavior.
            </p>
            <p class="ph-muted">
                Customer transactions and product relationships, however, produce different commercial signals that may be worth evaluating each day.
            </p>
            <div class="d-flex flex-column gap-2 my-4">
                <div class="p-3 rounded bg-white border">
                    <span style="color:#23413b">One customer may be approaching a repeat-purchase rhythm.</span>
                </div>
                <div class="p-3 rounded bg-white border">
                    <span style="color:#23413b">Another may have a meaningful complementary-product relationship.</span>
                </div>
                <div class="p-3 rounded bg-white border">
                    <span style="color:#23413b">Another may be weakening relative to their own historical behavior.</span>
                </div>
            </div>
            <p class="ph-muted">
                Daily Opportunities turns those signals into daily decision context.
            </p>
            <div class="p-3 rounded mt-3 text-center" style="background:#f8faf4;border:1px dashed #dce5d3">
                <strong style="color:#23413b">
                    The campaign idea can begin<br />
                    with customer and product context,<br />
                    not with an empty calendar slot.
                </strong>
            </div>
        }
    </div>
</section>

@* ── 04 HOW AN OPPORTUNITY IS FORMED ────────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container">
        <div class="text-center mb-5">
            <span class="ph-eyebrow">@(tr ? "FIRSATIN KAYNAĞI" : "WHERE OPPORTUNITIES COME FROM")</span>
            <h2 class="pika-h2 fw-bold mb-3">
                @(tr ? "Fırsat, tek bir sinyalden doğmaz." : "An opportunity does not come from one signal alone.")
            </h2>
            <p class="ph-muted mx-auto" style="max-width:680px">
                @(tr ? "Günün Fırsatları, müşteri ve ürün bağlamının kesiştiği noktaları değerlendirir." : "Daily Opportunities evaluates points where customer and product context intersect.")
            </p>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="ph-module-card h-100 p-4">
                    <div class="fw-bold mb-2" style="font-size:0.75rem;letter-spacing:1px;color:var(--pika-primary)">STEP 01</div>
                    <h3 class="fw-bold mb-2" style="font-size:1.05rem">@(tr ? "MÜŞTERİ BAĞLAMI" : "CUSTOMER CONTEXT")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Customer Intelligence müşterinin işlem geçmişini, satın alma ritmini, değerini ve davranış değişimini anlamlandırır." : "Customer Intelligence interprets transaction history, purchase rhythm, customer value and behavioral change.")
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="ph-module-card h-100 p-4">
                    <div class="fw-bold mb-2" style="font-size:0.75rem;letter-spacing:1px;color:var(--pika-primary)">STEP 02</div>
                    <h3 class="fw-bold mb-2" style="font-size:1.05rem">@(tr ? "ÜRÜN BAĞLAMI" : "PRODUCT CONTEXT")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Product Intelligence ürünün hizmet ettiği ihtiyacı, ürün rolünü, tekrar davranışını ve diğer ürünlerle ilişkisini anlamlandırır." : "Product Intelligence interprets customer need, product role, repeat behavior and relationships with other products.")
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="ph-module-card h-100 p-4">
                    <div class="fw-bold mb-2" style="font-size:0.75rem;letter-spacing:1px;color:var(--pika-primary)">STEP 03</div>
                    <h3 class="fw-bold mb-2" style="font-size:1.05rem">@(tr ? "KESİŞİM" : "INTERSECTION")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Müşteri davranışı ile ürün bağlamı birlikte değerlendirildiğinde ticari olarak anlamlı olabilecek bir fırsat adayı oluşabilir." : "When customer behavior and product context are evaluated together, a commercially meaningful opportunity candidate may emerge.")
                    </p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="ph-module-card h-100 p-4" style="border:2px solid var(--pika-primary)">
                    <div class="fw-bold mb-2" style="font-size:0.75rem;letter-spacing:1px;color:var(--pika-primary)">STEP 04</div>
                    <h3 class="fw-bold mb-2" style="font-size:1.05rem">@(tr ? "GÜNLÜK KARAR ADAYI" : "DAILY DECISION CANDIDATE")</h3>
                    <p class="small ph-muted mb-0">
                        @(tr ? "Uygun fırsat, kullanıcının değerlendirebileceği günlük fırsat bağlamında görünür hale gelir." : "A relevant opportunity becomes visible within daily opportunity context for user evaluation.")
                    </p>
                </div>
            </div>
        </div>

        <div class="p-3 rounded text-center my-4" style="background:#fff;border:1px solid #dce5d3">
            <span class="small fw-bold" style="color:#23413b">
                CUSTOMER CONTEXT + PRODUCT CONTEXT → OPPORTUNITY CONTEXT → DAILY OPPORTUNITY
            </span>
        </div>

        <div class="p-4 rounded text-center mx-auto" style="background:#f8faf4;border:1px dashed #dce5d3;max-width:760px">
            @if (tr)
            {
                <p class="ph-muted mb-1">Fırsat müşteriden bağımsız bir ürün önerisi değildir.</p>
                <p class="ph-muted mb-2">Üründen bağımsız bir müşteri skoru da değildir.</p>
                <p class="fw-bold mb-0" style="color:#23413b">İki bağlamın ticari olarak anlamlı kesişimidir.</p>
            }
            else
            {
                <p class="ph-muted mb-1">An opportunity is not a product recommendation without the customer.</p>
                <p class="ph-muted mb-2">And it is not a customer score without the product.</p>
                <p class="fw-bold mb-0" style="color:#23413b">It is the commercially meaningful intersection of both contexts.</p>
            }
        </div>
    </div>
</section>

@* ── 05 REPEAT PURCHASE ──────────────────────────────────────── *@
<section class="ph-section">
    <div class="container" style="max-width:860px">
        <span class="ph-eyebrow">@(tr ? "TEKRAR SATIN ALMA" : "REPEAT PURCHASE")</span>
        <h2 class="pika-h2 fw-bold mb-3">
            @(tr ? "Doğru ürün, doğru müşteride yeniden ihtiyaç haline gelebilir." : "The right product can become a need again for the right customer.")
        </h2>
        @if (tr)
        {
            <p class="ph-muted">
                Bazı ürünlerde müşterinin geçmiş işlemleri belirli bir tekrar satın alma ritmi gösterebilir.
            </p>
            <p class="ph-muted">
                Customer Intelligence müşterinin kişisel satın alma aralıklarını değerlendirir. Product Intelligence ise ürünün tekrar satın alma davranışı açısından anlamlı olup olmadığını ürün bağlamına ekler.
            </p>
            <p class="ph-muted">
                Bu iki bağlam birleştiğinde müşterinin yeniden ihtiyaç oluşabilecek bir döneme yaklaşıp yaklaşmadığı değerlendirilebilir.
            </p>
            <div class="p-4 rounded my-4 bg-white border" style="border-left:4px solid var(--pika-primary) !important">
                <p class="small mb-1 text-uppercase fw-bold" style="color:#62746d">Günün Fırsatları:</p>
                <p class="mb-3" style="color:#c0392b">“Müşterinin kesin satın alma tarihini bilir” iddiasında bulunmaz.</p>
                <p class="small mb-1 text-uppercase fw-bold" style="color:#62746d">Günün Fırsatları:</p>
                <p class="fw-bold mb-0" style="color:#23413b">Geçmiş ritim ve ürün bağlamından değerlendirilebilir bir tekrar satın alma fırsatı üretir.</p>
            </div>
            <p class="ph-muted mb-3">
                Amaç müşteriye sabit bir “30 gün geçti” kuralı uygulamak değil, müşterinin kendi geçmiş ritmini dikkate almaktır.
            </p>
            <div>
                <a href="/platform/customer-intelligence" class="small fw-bold" style="color:var(--pika-primary)">
                    Customer Intelligence'ı Keşfedin →
                </a>
            </div>
        }
        else
        {
            <p class="ph-muted">
                For some products, historical transactions may reveal an individual repeat-purchase rhythm.
            </p>
            <p class="ph-muted">
                Customer Intelligence evaluates the customer's own purchase intervals. Product Intelligence adds context about whether repeat-purchase behavior is meaningful for the product.
            </p>
            <p class="ph-muted">
                When these contexts come together, Pika can evaluate whether the customer may be approaching another relevant need window.
            </p>
            <div class="p-4 rounded my-4 bg-white border" style="border-left:4px solid var(--pika-primary) !important">
                <p class="small mb-1 text-uppercase fw-bold" style="color:#62746d">Daily Opportunities does not claim:</p>
                <p class="mb-3" style="color:#c0392b">“We know the exact date this customer will purchase again.”</p>
                <p class="small mb-1 text-uppercase fw-bold" style="color:#62746d">Daily Opportunities provides:</p>
                <p class="fw-bold mb-0" style="color:#23413b">An evaluable repeat-purchase opportunity from historical rhythm and product context.</p>
            </div>
            <p class="ph-muted mb-3">
                The objective is not to apply a fixed “30 days have passed” rule to every customer, but to consider the customer's own historical rhythm.
            </p>
            <div>
                <a href="/en/platform/customer-intelligence" class="small fw-bold" style="color:var(--pika-primary)">
                    Explore Customer Intelligence →
                </a>
            </div>
        }
    </div>
</section>

@* ── 06 CROSS-SELL ───────────────────────────────────────────── *@
<section class="ph-section ph-section-alt">
    <div class="container" style="max-width:860px">
        <span class="ph-eyebrow">CROSS-SELL</span>
        <h2 class="pika-h2 fw-bold mb-3">
            @(tr ? "Birlikte satın alınan ürünleri değil, birlikte neden anlamlı olduklarını görün." : "See more than which products are bought together. Understand why they make sense together.")
        </h2>
        @if (tr)
        {
            <p class="ph-muted">
                İşlem geçmişi hangi ürünlerin aynı sepetlerde veya müşteri davranışında birlikte görüldüğüne ilişkin kanıt oluşturabilir.
            </p>
            <p class="ph-muted">
                Ancak yalnızca birlikte satın alınmış olmak her ürün çiftini anlamlı bir cross-sell fırsatına dönüştürmez.
            </p>
            <p class="ph-muted">
                Product Intelligence ürün ilişkisini Need Group, Product Role ve diğer ürün anlamı bağlamlarıyla değerlendirmeye yardımcı olur.
            </p>
            <p class="ph-muted">
                Bu ürün bağlamı müşteri davranışıyla birleştiğinde belirli bir müşteri için değerlendirilebilir bir tamamlayıcı ürün fırsatı oluşabilir.
            </p>
            <div class="p-4 rounded my-4 bg-white border" style="border-left:4px solid var(--pika-primary) !important">
                <p class="text-muted mb-2">“Bunu alan şunu da aldı” tek başına yeterli değildir.</p>
                <p class="fw-bold mb-0" style="color:#23413b;font-size:1.05rem">
                    Asıl soru: “Bu iki ürün neden bu müşteri için birlikte anlamlı olabilir?”
                </p>
            </div>
            <p class="fw-bold mb-3" style="color:#23413b">
                Cross-sell fırsatı, ürün ilişkisi ile müşteri bağlamının kesişimidir.
            </p>
            <div>
                <a href="/platform/product-intelligence" class="small fw-bold" style="color:var(--pika-primary)">
                    Product Intelligence'ı Keşfedin →
                </a>
            </div>
        }
        else
        {
            <p class="ph-muted">

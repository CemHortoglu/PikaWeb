@{
    var culture=(ViewData["culture"] as string ?? ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr").ToLowerInvariant(); var tr=culture=="tr";
    ViewData["Title"]=tr?"Günün Fırsatları | Pika":"Daily Opportunities | Pika";
    ViewData["MetaDescription"]=tr?"Pika Günün Fırsatları ile tekrar satın alma, geri kazanım ve desteklenen ürün ilişkilerinden doğan aksiyona aday durumları kanıt ve müşteri bağlamıyla değerlendirin.":"Use Pika Daily Opportunities to review actionable repeat-purchase, win-back and supported product-relationship situations with evidence and customer context.";
    ViewData["BodyClass"]="pk-page";
}
<section class="pk-hero"><div class="pk-container pk-hero-grid"><div><span class="pk-eyebrow">Platform · @(tr?"Fırsat ve Karar":"Opportunity & Decision")</span><h1>@(tr?"Pika bugün sizin için ne buldu?":"What did Pika find for you today?")</h1><p>@(tr?"Günün Fırsatları, Pika'nın müşteri ve ürün verisinde aksiyona temel olabilecek ticari durumları görünür kıldığı çalışma alanıdır. Amaç daha fazla mesaj üretmek değil, neden şimdi aksiyon düşünülmesi gerektiğini açıklanabilir hale getirmektir.":"Daily Opportunities is the workspace where Pika surfaces commercial situations that may justify action. The goal is not more messages, but clearer reasons for why action may be useful now.")</p><div class="pk-actions"><button class="pk-btn pk-btn-primary" data-bs-toggle="modal" data-bs-target="#demoModal">@(tr?"Demo Talep Et":"Request a Demo")</button><a class="pk-btn pk-btn-ghost" href="/wiki/firsat-turleri">@(tr?"Fırsat Türlerini Okuyun":"Read Opportunity Types")</a></div></div><figure class="pk-proof"><img src="/wiki/assets/images/img_gunun-firsatlari.png" alt="@(tr?"Pika Günün Fırsatları ekranı":"Pika Daily Opportunities screen")" width="1200" height="760" /><figcaption>@(tr?"Gerçek ürün görünümü: fırsatları müşteri ve ticari bağlamla değerlendirin.":"Product view: review opportunities with customer and commercial context.")</figcaption></figure></div></section>
<section class="pk-section pk-section-lg"><div class="pk-container pk-opportunity"><div><span class="pk-eyebrow">@(tr?"Fırsat türleri":"Opportunity types")</span><h2>@(tr?"Her sinyal aynı aksiyonu gerektirmez.":"Different signals call for different decisions.")</h2><p class="pk-lead">@(tr?"Pika fırsatı bir etiket olarak değil, neden/kanıt bağlamıyla ele alır. Kullanılabilecek fırsat türü müşterideki veri ve etkin ürün kabiliyetlerine bağlıdır.":"Pika treats an opportunity as evidence and context, not merely a label. Available opportunity types depend on customer data and enabled product capabilities.")</p></div><div class="pk-opportunity-list"><div class="pk-opportunity-row"><div class="pk-opportunity-icon"><i class="ri-refresh-line"></i></div><div><strong>@(tr?"Tekrar satın alma":"Repeat purchase")</strong><span>@(tr?"Müşterinin kendi geçmiş ritmi ve ürün bağlamıyla yaklaşan ihtiyaç":"Approaching need based on personal rhythm and product context")</span></div><span class="pk-status">@(tr?"Kanıtı gör":"Evidence")</span></div><div class="pk-opportunity-row"><div class="pk-opportunity-icon"><i class="ri-user-unfollow-line"></i></div><div><strong>@(tr?"Geri kazanım":"Win-back")</strong><span>@(tr?"Beklenen davranış ritminden uzaklaşma sinyali":"Drift from expected behavioral rhythm")</span></div><span class="pk-status">@(tr?"Kanıtı gör":"Evidence")</span></div><div class="pk-opportunity-row"><div class="pk-opportunity-icon"><i class="ri-links-line"></i></div><div><strong>Cross-sell</strong><span>@(tr?"Sepet birlikteliği ve Product Intelligence ile desteklenen ürün ilişkisi":"Product relationship supported by basket evidence and Product Intelligence")</span></div><span class="pk-status">@(tr?"Kanıtı gör":"Evidence")</span></div></div></div></section>
<section class="pk-section pk-section-soft"><div class="pk-container"><div class="pk-chapter"><div><span class="pk-eyebrow">@(tr?"Kullanıcı kontrolü":"User control")</span><h2>@(tr?"Fırsat bulundu ≠ mesaj gönderildi.":"Opportunity found ≠ message sent.")</h2></div><p class="pk-lead">@(tr?"Günün Fırsatları karar desteğidir. Kullanıcı müşteriyi ve fırsatın nedenini inceler; uygun aksiyonu seçer. İletişim gerekiyorsa izin, opt-out ve kanal uygunluğu ayrıca değerlendirilir.":"Daily Opportunities is decision support. The user reviews the customer and why the opportunity exists, then chooses the appropriate action. If communication is needed, consent, opt-out and channel eligibility are evaluated separately.")</p></div><div class="pk-flow"><div class="pk-flow-item"><small>01</small><strong>@(tr?"Pika bulur":"Pika finds")</strong><span>@(tr?"Sinyal ve ticari bağlam":"Signal and commercial context")</span></div><div class="pk-flow-item"><small>02</small><strong>@(tr?"Nedeni gösterir":"Shows why")</strong><span>@(tr?"Kanıt, veri ve müşteri bağlamı":"Evidence, data and customer context")</span></div><div class="pk-flow-item"><small>03</small><strong>@(tr?"Kullanıcı inceler":"User reviews")</strong><span>@(tr?"İş kuralı ve öncelik":"Business rule and priority")</span></div><div class="pk-flow-item"><small>04</small><strong>@(tr?"Aksiyon seçilir":"Action chosen")</strong><span>Audience · Campaign · Journey</span></div><div class="pk-flow-item"><small>05</small><strong>@(tr?"Uygunluk kontrolü":"Eligibility")</strong><span>@(tr?"İzin · Opt-out · Kanal":"Consent · Opt-out · Channel")</span></div><div class="pk-flow-item"><small>06</small><strong>@(tr?"Sonuç ölçülür":"Measure")</strong><span>Analytics</span></div></div></div></section>
<section class="pk-section"><div class="pk-container pk-screen-band"><img src="/wiki/assets/images/img_aksiyon-calisma-alani_9.png" alt="@(tr?"Pika aksiyon çalışma alanı":"Pika action workspace")" loading="lazy" width="1200" height="760" /><div><span class="pk-eyebrow">@(tr?"Fırsattan aksiyona":"From opportunity to action")</span><h2>@(tr?"Kampanya veya Journey hazırlığını fırsat bağlamından başlatın.":"Start Campaign or Journey preparation from opportunity context.")</h2><p class="pk-lead">@(tr?"Fırsat karar verildiğinde ilgili hedef kitle, içerik ve akış hazırlığı Campaign veya Journey katmanına taşınabilir. AI burada açıklama ve taslak desteği verebilir; yürütme kontrolünü devralmaz.":"After a decision, relevant audience, content and flow preparation can move into Campaign or Journey. AI may assist with explanation and drafts without taking over execution control.")</p><div class="pk-actions"><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/campaign-manager":"/en/platform/campaign-manager")">Campaign Manager</a><a class="pk-btn pk-btn-ghost" href="@(tr?"/platform/journey-manager":"/en/platform/journey-manager")">Journey Manager</a></div></div></div></section>

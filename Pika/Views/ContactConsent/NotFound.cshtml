@{
    ViewData["Title"] = "Link Geçersiz";
    Layout = "_LayoutBlank";
}

@section Styles {
    <link rel="stylesheet" href="~/css/contact-consent.css" asp-append-version="true" />
}

<section class="pika-section contact-consent-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-11 col-md-9 col-lg-7 col-xl-6">
                <div class="consent-wrapper consent-wrapper--message">
                    <h1 class="consent-title">Link Geçersiz</h1>
                    <p class="consent-subtitle">
                        Ulaşmak istediğiniz izin güncelleme linki geçersiz veya süresi dolmuş. Lütfen en güncel e-postanızdaki linki kullanın.
                    </p>
                    <a class="consent-submit consent-submit--link" href="/">Ana Sayfaya Dön</a>
                </div>
            </div>
        </div>
    </div>
</section>
